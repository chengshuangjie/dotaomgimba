function CO9 takes unit u,unit CJ9,integer level,real TA9 returns nothing
	local real x = GetUnitX(CJ9)-50*Cos(TA9)
	local real y = GetUnitY(CJ9)-50*Sin(TA9)
	local real length
    local integer ZZMF_level=GetUnitAbilityLevel(u,'A4DJ')+GetUnitAbilityLevel(u,'A4DZ')
    local integer ZZMF=0
    if ZZMF_level>0 then
        set ZZMF=50*ZZMF_level
    endif
    if GetUnitAbilityLevel(u,'A2YK')>0 then
    set length=1750+ZZMF
    elseif GetUnitAbilityLevel(u,'A2YJ')>0 then
    set length=1700+ZZMF
    else
    set length=1550+ZZMF
    endif
    // if ((MV7(u,ZU[FT4])!=null)or(MV7(u,ZU[R1K])!=null)or(CHIA[GetPlayerId(GetOwningPlayer(u))]==1)) then
	    // call Wave(u,'h0HJ', 50 * level, length, 375, 375, x, y, GetUnitX(CJ9), GetUnitY(CJ9), 1050, 1, false, "QM_TRI", level)
    // else
    // if ((MV7(u,ZU[FT4])!=null)or(MV7(u,ZU[R1K])!=null)or(CHIA[GetPlayerId(GetOwningPlayer(u))]==1)) then
	    // call Wave(u,'h0HJ', 50 * level, length, 375, 375, x, y, GetUnitX(CJ9), GetUnitY(CJ9), 1050, 1, false, "QM_TRI", level)
    // else
        call Wave(u,'h0HJ', 50 * level, length, 375, 375, x, y, GetUnitX(CJ9), GetUnitY(CJ9), 1050, 1, false, "QM_AI_USE_RENJIA", level)
    // endif
    call KillUnit(CJ9)
endfunction
function CP9 takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local integer iX=OM7(OB7,"Count")
local integer CQ9=iX-1
local real RK=ON7(OB7,"Angle")
local unit oA=O77(OB7,"Caster")
local unit WI7=O77(OB7,"Hero")
local integer V77=OM7(OB7,"Level")
local integer CR9=2+V77*2
local boolean CS9=OO7(OB7,"SpiritCast")
local unit CT9
local player cp9Owner=GetOwningPlayer(oA)
local real cp9X=GetUnitX(oA)
local real cp9Y=GetUnitY(oA)
if GetTriggerEventId()!=EVENT_UNIT_SPELL_ENDCAST and GetTriggerEventId()!=EVENT_UNIT_DEATH then
call NP7(OB7,"Count",iX+1)
endif
call SetUnitScale(oA,I2R(100+20*CQ9)/ 100,I2R(100+20*CQ9)/ 100,I2R(100+20*CQ9)/ 100)
if (GetTriggerEventId()==EVENT_UNIT_SPELL_ENDCAST and CS9==false) or (GetTriggerEventId()==EVENT_UNIT_SPELL_ENDCAST and B287_GetSpellAbilityId()=='A121') or CQ9==CR9 or GetTriggerEventId()==EVENT_UNIT_DEATH then
if CS9 then
set CT9=O77(OB7,"Dummy")
call ShowUnit(CT9,false)
call UnitApplyTimedLife(CT9,'BTLF',1)
endif
call NM7(OB7)
call OZ7(t)
//if(LoadInteger(L7,(GetHandleId(WI7)),(704)))==0 or(LoadInteger(L7,(GetHandleId(WI7)),(704)))==1093679157 then
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(WI7),'A085',true)
call SetPlayerAbilityAvailable(GetOwningPlayer(WI7),'A121',false)
call UnitRemoveAbility(WI7,'A121')
call CO9(WI7,oA,CQ9,RK)
endif
set oA=CreateUnit(cp9Owner,'h06M',cp9X+150*CQ9*Cos(RK),cp9Y+150*CQ9*Sin(RK),0)
call UnitApplyTimedLife(oA,'BTLF',7)
set t=null
set oA=null
set WI7=null
set CT9=null
set cp9Owner=null
return false
endfunction
function CU9 takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit WI7=O77(OB7,"Hero")
call IssueImmediateOrderById(WI7,$D0004)
call NM7(OB7)
call OZ7(t)
set t=null
set WI7=null
return false
endfunction
function CV9 takes nothing returns nothing
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local unit WI7=GetTriggerUnit()
local location l=GetSpellTargetLoc()
local real RK=Atan2(GetLocationY(l)-GetUnitY(WI7),GetLocationX(l)-GetUnitX(WI7))
local real x
local real y
local unit oA
local unit CT9
local boolean CS9=false
if GetLocationY(l)==GetUnitY(WI7)and GetLocationX(l)==GetUnitX(WI7)then
set RK=GetUnitFacing(WI7)*bj_DEGTORAD
endif
set x=GetUnitX(WI7)+$96*Cos(RK)
set y=GetUnitY(WI7)+$96*Sin(RK)
set oA=CreateUnit(GetOwningPlayer(WI7),'u00J',x,y,RK*bj_RADTODEG)
call RemoveLocation(l)
if GetUnitTypeId(WI7)=='H06X' or GetUnitTypeId(WI7)=='H06Y' or GetUnitTypeId(WI7)=='H06W' then
set CS9=true
endif
call NS7(OB7,"SpiritCast",CS9)
call NT7(OB7,"Hero",WI7)
call NT7(OB7,"Caster",oA)
call NP7(OB7,"Count",1)
call NP7(OB7,"Level",B287_GetUnitAbilityLevel(WI7,'A085'))
call NQ7(OB7,"Angle",RK)
call TriggerRegisterTimerEvent(t,.5,true)
call TriggerRegisterUnitEvent(t,WI7,EVENT_UNIT_SPELL_ENDCAST)
call TriggerRegisterUnitEvent(t,WI7,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function CP9))
if CS9 then
set CT9=CreateUnit(GetOwningPlayer(WI7),'h06Z',GetUnitX(WI7),GetUnitY(WI7),RK*bj_RADTODEG)
call SetUnitX(CT9,GetUnitX(WI7))
call SetUnitY(CT9,GetUnitY(WI7))
call SetUnitAnimation(CT9,"spell")
call QueueUnitAnimation(CT9,"spell")
call QueueUnitAnimation(CT9,"spell")
call SetUnitVertexColor(CT9,$FF,$FF,$FF,75)
call NT7(OB7,"Dummy",CT9)
set t=CreateTrigger()
set OB7=GetHandleId(t)
call TriggerRegisterTimerEvent(t,0,false)
call TriggerAddCondition(t,Condition(function CU9))
call NT7(OB7,"Hero",WI7)
endif
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(WI7),'A085',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(WI7),'A121',true)
call XF7(WI7,'A121')
set t=null
set WI7=null
set oA=null
set CT9=null
set l=null
endfunction
function CW9 takes nothing returns boolean
if B287_GetSpellAbilityId()=='A085' then
call CV9()
endif
return false
endfunction
function FN8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function CW9))
set t=null
