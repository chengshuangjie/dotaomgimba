//使用次数会减1次
function MGO takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit WI7=(LoadUnitHandle(L7,(OB7),(2)))
local real mana=GetUnitState(WI7,UNIT_STATE_MANA)
// local integer BC7=LoadInteger(TABLE_VV,'I0BK',GetPlayerId(GetOwningPlayer(WI7)))
local integer BC7=GetItemCharges(MV7(WI7,ZU[DI4]))
local real d=DGH_BUFF(WI7)
local real recover=mana*.4*d
call SetUnitState(WI7,UNIT_STATE_MANA,GetUnitState(WI7,UNIT_STATE_MANA)-recover)
call SetUnitState(WI7,UNIT_STATE_LIFE,GetUnitState(WI7,UNIT_STATE_LIFE)+recover)
call SetItemCharges(MV7(WI7,ZU[DI4]),BC7+1)
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodstoneHealTarget.mdx",WI7,"origin"))
call FlushChildHashtable(L7,(OB7))
call OZ7(t)
//if GetUnitTypeId(WI7)==1315988077 then
//set YM4=WI7
//endif
//call KillUnit(WI7)
//if GetUnitTypeId(WI7)==1315988077 then
//set YM4=WI7
//endif
//call KillUnit(WI7)
//if GetUnitTypeId(WI7)==1315988077 then
//set YM4=WI7
//endif
//call KillUnit(WI7)
set WI7=null
set t=null
return false
endfunction
function MHO takes nothing returns nothing
local unit WI7=GetTriggerUnit()
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
call SaveUnitHandle(L7,(OB7),(2),(WI7))
call TriggerAddCondition(t,Condition(function MGO))
call TriggerRegisterTimerEvent(t,0.01,false)
set t=null
set WI7=null
endfunction
//血精技能
function MZO takes nothing returns nothing
if B287_GetSpellAbilityId()=='A2R8' then
call MHO()
endif
endfunction
function kUU takes unit u returns boolean
local integer id=GetUnitTypeId(u)
return id=='o018' or id=='o002' or id=='o00B' or id=='o01B'
endfunction
function KUU takes unit u returns boolean
local integer id=GetUnitTypeId(u)
return id=='n00Q' or id=='n00O' or id=='n00P' or id=='n00N'
endfunction
function lUU takes unit u returns boolean
local integer id=GetUnitTypeId(u)
return kUU(u)or KUU(u)or id=='otot'
endfunction
function Aov takes nothing returns nothing
if IsUnitAlly(GetSpellTargetUnit(),GetOwningPlayer(GetTriggerUnit()))==false then
call B67(GetTriggerUnit(),GetSpellTargetUnit(),10,999999)
endif
endfunction
function Arv takes nothing returns nothing
local integer skill=B287_GetSpellAbilityId()
local integer id=GetUnitTypeId(GetSpellTargetUnit())
local integer d=0
if GetUnitAbilityLevel(GetTriggerUnit(),'A2VW')>0 then
set d=2
endif
call B287_SetUnitAbilityLevel(GetTriggerUnit(),skill,1+d)
if id=='o004' or id=='oeye' or lUU(GetSpellTargetUnit()) then
call DestroyEffect(AddSpecialEffectTarget("tx\\dog\\N'aix_W.mdl",GetSpellTargetUnit(),"chest"))
call Aov()
call B287_SetUnitAbilityLevel(GetTriggerUnit(),skill,2+d)
elseif id==0 then
call B287_SetUnitAbilityLevel(GetTriggerUnit(),skill,2+d)
else
call DestroyEffect(AddSpecialEffectTarget("tx\\dog\\N'aix_W.mdl",GetSpellTargetUnit(),"chest"))
call B67(GetTriggerUnit(),GetSpellTargetUnit(),3,400)
call B287_SetUnitAbilityLevel(GetTriggerUnit(),skill,1+d)
endif
endfunction
function ARv takes nothing returns nothing
local integer id=GetUnitTypeId(GetSpellTargetUnit())
if id=='o004' or id=='oeye' or lUU(GetSpellTargetUnit())then
	call DestroyEffect(AddSpecialEffectTarget("tx\\dog\\N'aix_W.mdl",GetSpellTargetUnit(),"chest"))
	call Aov()
endif
endfunction
function MaO takes nothing returns nothing
//打野爪
if B287_GetSpellAbilityId()=='A2S0' then
call Arv()
//补刀斧
elseif B287_GetSpellAbilityId()=='A1FD' then
call ARv()
endif
endfunction
function EFG takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local unit IH7=(LoadUnitHandle(L7,(I97),(17)))
local integer BC7=(LoadInteger(L7,(I97),(34)))
if SuijiMode_IsSacrificeProtectedTarget(IH7) then
call FlushChildHashtable(L7,(I97))
call OZ7(t)
set t=null
set ZX7=null
set IH7=null
return false
endif
if GetTriggerEventId()==EVENT_UNIT_DEATH or (GetTriggerEventId()==EVENT_UNIT_DAMAGED and GetUnitAbilityLevel(IH7,'B0ES')>0) then
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Transmute\\PileofGold.mdl",GetUnitX(IH7),GetUnitY(IH7)))
if GetUnitTypeId(ZX7)=='N0MM' then
call AddHeroXP(M7[GetPlayerId(GetOwningPlayer(ZX7))],R2I(EEG(BC7)*2.5),true)
else
call AddHeroXP(ZX7,R2I(EEG(BC7)*2.5),true)
endif
call ZQ7(GetOwningPlayer(ZX7),IH7,$BE)
set VH4[GetPlayerId(GetOwningPlayer(ZX7))]=VH4[GetPlayerId(GetOwningPlayer(ZX7))]+$BE
set EV0[GetPlayerId(GetOwningPlayer(ZX7))]=EV0[GetPlayerId(GetOwningPlayer(ZX7))]+$BE
set DJS[GetPlayerId(GetOwningPlayer(ZX7))]=DJS[GetPlayerId(GetOwningPlayer(ZX7))]+$BE
call FlushChildHashtable(L7,(I97))
call OZ7(t)
//call KillUnit(IH7)
call SetUnitLifeBJ(IH7,20)
call B67_DPS(ZX7,IH7,20,50)
endif
set t=null
set ZX7=null
set IH7=null
return false
endfunction
function EGG takes nothing returns nothing
local trigger t=CreateTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=GetTriggerUnit()
local unit IH7=GetSpellTargetUnit()
local integer BC7=GetUnitLevel(IH7)
if SuijiMode_IsSacrificeProtectedTarget(IH7) then
call OZ7(t)
set t=null
set ZX7=null
set IH7=null
return
endif
call SaveUnitHandle(L7,(I97),(2),(ZX7))
call SaveUnitHandle(L7,(I97),(17),(IH7))
call SaveInteger(L7,(I97),(34),(BC7))
call TriggerRegisterUnitEvent(t,IH7,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(t,IH7,EVENT_UNIT_DAMAGED)
call TriggerAddCondition(t,Condition(function EFG))
set t=null
set ZX7=null
set IH7=null
endfunction
function EFGG takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local unit IH7=(LoadUnitHandle(L7,(I97),(17)))
local integer BC7=(LoadInteger(L7,(I97),(34)))
local integer E1D=OM7(I97,"Iterations")
if SuijiMode_IsSacrificeProtectedTarget(IH7) then
call FlushChildHashtable(L7,(I97))
call OZ7(t)
set t=null
set ZX7=null
set IH7=null
return false
endif
if GetTriggerEvalCount(t)>E1D then
call AddHeroXP(ZX7,R2I(EEG(BC7)*2.5),true)
//call KillUnit(IH7)
call SetUnitLifeBJ(IH7,20)
call B67_DPS(ZX7,IH7,20,50)
call NM7(I97)
call OZ7(t)
else
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Transmute\\PileofGold.mdl",GetUnitX(IH7),GetUnitY(IH7)))
call ZQ7(GetOwningPlayer(ZX7),IH7,$BE)
set VH4[GetPlayerId(GetOwningPlayer(ZX7))]=VH4[GetPlayerId(GetOwningPlayer(ZX7))]+$BE
set EV0[GetPlayerId(GetOwningPlayer(ZX7))]=EV0[GetPlayerId(GetOwningPlayer(ZX7))]+$BE
set DJS[GetPlayerId(GetOwningPlayer(ZX7))]=DJS[GetPlayerId(GetOwningPlayer(ZX7))]+$BE
endif
set t=null
set ZX7=null
set IH7=null
return false
endfunction
function EGGG takes integer r returns nothing
local trigger t=CreateTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=GetTriggerUnit()
local unit IH7=GetSpellTargetUnit()
local integer BC7=GetUnitLevel(IH7)
if SuijiMode_IsSacrificeProtectedTarget(IH7) then
call OZ7(t)
set t=null
set ZX7=null
set IH7=null
return
endif
if r==2 then
call YW7(GetObjectName('n0K7'),5,GetTriggerUnit(),.03,255,0,0,255)
elseif r==3 then
call YW7(GetObjectName('n0JT'),5,GetTriggerUnit(),.03,255,0,0,255)
elseif r==4 then
call YW7(GetObjectName('n0K8'),5,GetTriggerUnit(),.03,255,0,0,255)
elseif r==5 then
call YW7(GetObjectName('n0JO'),5,GetTriggerUnit(),.03,255,0,0,255)
endif
call SaveUnitHandle(L7,(I97),(2),(ZX7))
call SaveUnitHandle(L7,(I97),(17),(IH7))
call SaveInteger(L7,(I97),(34),(BC7))
call NP7(I97,"Iterations",r)
//call TriggerRegisterUnitEvent(t,IH7,EVENT_UNIT_DEATH)
//call TriggerRegisterUnitEvent(t,IH7,EVENT_UNIT_DAMAGED)
//call TriggerRegisterUnitEvent(t,IH7,EVENT_UNIT_DEATH)
//call TriggerRegisterUnitEvent(t,IH7,EVENT_UNIT_DAMAGED)
//call TriggerRegisterUnitEvent(t,IH7,EVENT_UNIT_DEATH)
//call TriggerRegisterUnitEvent(t,IH7,EVENT_UNIT_DAMAGED)
call TriggerRegisterTimerEvent(t,.2,true)
call TriggerAddCondition(t,Condition(function EFGG))
set t=null
set ZX7=null
set IH7=null
endfunction
function SuijiMulticastTemplate_IsRandomCaster takes unit suijiMulticastUnit returns boolean
local integer suijiMulticastHandle=0
if SUIJI_MODE==false or suijiMulticastUnit==null then
return false
endif
set suijiMulticastHandle=GetHandleId(suijiMulticastUnit)
return OO7(suijiMulticastHandle,"SuijiDone") and OO7(suijiMulticastHandle,"SuijiMulticast") and B287_GetUnitAbilityLevel(suijiMulticastUnit,'A088')>0
endfunction
function SuijiMulticastTemplate_IsOgreLikeCaster takes unit suijiMulticastUnit returns boolean
if suijiMulticastUnit==null then
return false
endif
return GetUnitTypeId(suijiMulticastUnit)=='Hmkg' or SuijiMulticastTemplate_IsRandomCaster(suijiMulticastUnit)
endfunction
function SuijiMulticastTemplate_IsFireblastSkill takes integer suijiMulticastSkill returns boolean
return suijiMulticastSkill=='A04W' or suijiMulticastSkill=='A08D' or suijiMulticastSkill=='A08A' or suijiMulticastSkill=='A089' or suijiMulticastSkill=='A2KQ'
endfunction
function SuijiMulticastTemplate_IsItemSkill takes integer suijiMulticastSkill returns boolean
return suijiMulticastSkill=='A02O' or suijiMulticastSkill=='A08Y' or suijiMulticastSkill=='A08Z' or suijiMulticastSkill=='A090' or suijiMulticastSkill=='A092' or suijiMulticastSkill=='AChx' or suijiMulticastSkill=='A0FD' or suijiMulticastSkill=='A32X' or suijiMulticastSkill=='A1QD' or suijiMulticastSkill=='A2EA' or suijiMulticastSkill=='A4DN' or suijiMulticastSkill=='AIpg' or suijiMulticastSkill=='A4DT'
endfunction
function EHG takes nothing returns nothing
local integer r
if B287_GetSpellAbilityId()=='A28Y' then
if SuijiMulticastTemplate_IsOgreLikeCaster(GetTriggerUnit()) and B287_GetUnitAbilityLevel(GetTriggerUnit(),'A088')>0 and ISPH(GetTriggerUnit())==false then
set r=EUD(GetTriggerUnit())
if r>1 then
call EGGG(r)
else
call EGG()
endif
else
call EGG()
endif
endif
endfunction
function EIG takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer V07=GetHandleId(t)
local unit Z69=(LoadUnitHandle(L7,(V07),(2)))
local real EJG=(LoadReal(L7,(V07),($F2)))
local real EKG=(LoadReal(L7,(V07),(529)))
local real EMG=(LoadReal(L7,(V07),(530)))
local real ENG=GetUnitState(Z69,UNIT_STATE_MANA)
local real EOG=GetUnitState(Z69,UNIT_STATE_MAX_MANA)
local real EPG=EJG-ENG
if GetTriggerEventId()==EVENT_UNIT_DEATH then
call FlushChildHashtable(L7,(V07))
call OZ7(t)
elseif GetTriggerEvalCount(t)==20*$A then
call FlushChildHashtable(L7,(V07))
call OZ7(t)
if EKG<$96 then
call SetUnitState(Z69,UNIT_STATE_MANA,ENG-($96-EKG-EMG))
endif
else
if EPG>0 then
set EKG=EKG+(EJG-ENG)
if EMG>0 then
if EPG>EMG then
call SetUnitState(Z69,UNIT_STATE_MANA,ENG+EMG)
set EMG=0
else
if EMG>(EOG-ENG)then
set EMG=EMG-(EOG-ENG)
call SetUnitState(Z69,UNIT_STATE_MANA,ENG+EOG-ENG)
else
set EMG=EMG-EPG
call SetUnitState(Z69,UNIT_STATE_MANA,ENG+EPG)
endif
endif
endif
endif
set EJG=ENG
call SaveReal(L7,(V07),($F2),((EJG)*1.))
call SaveReal(L7,(V07),(529),((EKG)*1.))
call SaveReal(L7,(V07),(530),((EMG)*1.))
endif
set t=null
set Z69=null
return false
endfunction
function EQG takes nothing returns nothing
local unit Z69=GetTriggerUnit()
local real C7D=GetUnitState(Z69,UNIT_STATE_LIFE)
local trigger t=CreateTrigger()
local integer V07=GetHandleId(t)
local real ENG=GetUnitState(Z69,UNIT_STATE_MANA)
if C7D>$97 then
call SetUnitState(Z69,UNIT_STATE_LIFE,C7D-$96)
else
call SetUnitState(Z69,UNIT_STATE_LIFE,1)
endif
call YS7("Abilities\\Spells\\Orc\\SpiritLink\\SpiritLinkZapTarget.mdl",Z69,"origin",2)
call SetUnitState(Z69,UNIT_STATE_MANA,ENG+$96)
call TriggerRegisterTimerEvent(t,.05,true)
call TriggerRegisterUnitEvent(t,Z69,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function EIG))
call SaveUnitHandle(L7,(V07),(2),(Z69))
call SaveReal(L7,(V07),($F2),((GetUnitState(Z69,UNIT_STATE_MANA))*1.))
call SaveReal(L7,(V07),(529),((0)*1.))
if(ENG+$96)>GetUnitState(Z69,UNIT_STATE_MAX_MANA)then
call SaveReal(L7,(V07),(530),(((ENG+$96)-GetUnitState(Z69,UNIT_STATE_MAX_MANA))*1.))
endif
set Z69=null
set t=null
endfunction
function ERG takes nothing returns nothing
if B287_GetSpellAbilityId()=='A1Q8' then
call EQG()
endif
endfunction
function ESG takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
if GetTriggerEvalCount(t)>30 or GetTriggerEventId()==EVENT_UNIT_DEATH then
call UnitRemoveAbility(ZX7,'A1QC')
call UnitRemoveAbility(ZX7,'B0CY')
call FlushChildHashtable(L7,(I97))
call OZ7(t)
endif
set ZX7=null
set t=null
return false
endfunction
function ETG takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
if GetTriggerEvalCount(t)>30 or GetTriggerEventId()==EVENT_UNIT_DEATH or((LoadInteger(L7,(GetHandleId((ZX7))),((4256))))==1)then
call UnitRemoveAbility(ZX7,'Aetl')
call FlushChildHashtable(L7,(I97))
call OZ7(t)
endif
set ZX7=null
set t=null
return false
endfunction
function EUG takes unit u returns nothing
local unit ZX7=u
local trigger t=CreateTrigger()
local integer I97=GetHandleId(t)
call UnitAddAbility(ZX7,'Aetl')
call UnitMakeAbilityPermanent(ZX7,true,'Aetl')
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'Aetl',false)
call TriggerRegisterTimerEvent(t,.1,true)
call TriggerRegisterUnitEvent(t,ZX7,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function ETG))
call SaveUnitHandle(L7,(I97),(2),(ZX7))
set ZX7=null
set t=null
endfunction
function EVG takes nothing returns nothing
	local unit ZX7 = U22
	local unit IH7 = W22
	local integer h = GetHandleId(GetTriggeringTrigger())
	local real d = LoadReal(TABLE_HY, h, 11)
    local trigger t
    if IsPlayerAlly(GetOwningPlayer(IH7),GetOwningPlayer(ZX7)) and ZX7!=IH7 then
        call EUG(IH7)
    elseif ZX7!=IH7 then
        set t=CreateTrigger()
        set h=GetHandleId(t)
call SetPlayerAbilityAvailable(GetOwningPlayer(IH7),'A1QC',false)
call UnitAddAbility(IH7,'A1QC')
call UnitMakeAbilityPermanent(IH7,true,'A1QC')
        call TriggerRegisterTimerEvent(t,.1,true)
        call TriggerRegisterUnitEvent(t,IH7,EVENT_UNIT_DEATH)
        call TriggerAddCondition(t,Condition(function ESG))
        call SaveUnitHandle(L7,(h),(2),(IH7))
        call EUG(IH7)
        call YW7("+"+I2S(R2I(d)),2,IH7,.027,3,$D8,120,$D8)
        set E97=true
        call B67(ZX7,IH7,1,d)
        set E97=false
    endif
    call EUG(ZX7)
    set ZX7=null
    set IH7=null
    set t=null
endfunction
function EWG takes unit ZX7,unit IH7 returns nothing
local trigger t=NHX(ZX7, IH7,'h0BS', "EVG",1200, true, "")
local integer ZN9=WH7(ZX7)
local real EXG
if ZN9==2 then
set EXG=GetHeroAgi(ZX7,true)
elseif ZN9==3 then
set EXG=GetHeroStr(ZX7,true)
elseif ZN9==1 then
set EXG=GetHeroInt(ZX7,true)
endif
call SaveReal(TABLE_HY, GetHandleId(t), 11, (EXG*2.+75))
set t=null
endfunction
function EYG takes nothing returns nothing
