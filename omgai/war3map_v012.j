call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,30,"本图默认开启 |cFF00FF00-omg|r 随机OMG模式（-1 基础模式 + 随机技能）。\n输入 |cFF00FF00-neng|r 可关闭默认 OMG 中的 XM 难度，改为普通 OMG 难度。\n|cFFFFCC00-1/-2/-3/-4/-5 快捷模式已关闭，避免重复触发默认模式。|r\n\n\n")
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_ENDCAST)
call YB7(t,EVENT_PLAYER_UNIT_SPELL_CAST)
call YB7(t,EVENT_PLAYER_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function SWF))
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_PICKUP_ITEM)
call TriggerAddCondition(t,Condition(function NAG))
call ExecuteFunc("L77")
set t=null
call ExecuteFunc("IP7")
call R1W()
//泉水附近区域
set WAA = Rect(-7680,-7760,-6000,-6100)
set YAA = Rect(5347, 4400, 7470, 7147)
//隐藏泉水
call ShowUnit(J444,false)
call ShowUnit(eSS,false)
if IS11 then
call ShowUnit(PFDEMO[1],false)
