	call DzFrameSetPoint(GlyphFrame, 4, DzFrameGetMinimap(), 4, 0.087, -0.061)
	call SetFrameToolTip( GlyphFrame, "激活 防御符文", "在5秒内，使你方阵营所有的建筑物对物理攻击免疫，高地塔和门牙塔获得四重攻击的能力。|n|n|cff99ccff团队冷却时间：|r5分钟" )
