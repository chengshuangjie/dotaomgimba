call XF7(p5,'A4KS')
endif
call NM7(OB7)
call OZ7(t)
call NS7(GetHandleId(p5),"FSING",false)
set t=null
set p5=null
return false
endfunction
function NJFS3 takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local trigger t
local integer I97
local integer level=NagaSirenAghMirror_GetLevel(ZX7)
set t=CreateTrigger()
set I97=GetHandleId(t)
call TriggerRegisterTimerEvent(t,0.5,false)
call TriggerAddCondition(t,Condition(function NJFS4))
call SaveUnitHandle(L7,(I97),(2),(ZX7))
call SaveInteger(L7,(I97),(10),(level))


if OO7(GetHandleId(ZX7),"FSING") then
set t=CreateTrigger()
call TriggerRegisterTimerEvent(t,.55,false)
call TriggerAddCondition(t,Condition(function ADD_LK))
call NT7(GetHandleId(t),"Source",ZX7)
endif
set t=null
set ZX7=null
endfunction
function NJFS2 takes nothing returns boolean
if B287_GetSpellAbilityId()=='A063' or B287_GetSpellAbilityId()=='A4NS' then
    if WQ7(GetTriggerUnit()) then
        call NS7(GetHandleId(GetTriggerUnit()),"FSING",true)
endif
if B287_GetSpellAbilityId()=='A063' and NagaSirenAghMirror_HasScepter(GetTriggerUnit()) then
call NagaSirenAghMirror_StartCooldownFix(GetTriggerUnit())
    endif
call NJFS3()
endif
return false
endfunction
function NJFS takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function NJFS2))
set t=null
endfunction
function EUD takes unit ZX7 returns integer
local integer V77=B287_GetUnitAbilityLevel(ZX7,'A088')
local boolean HaveA
local integer r=0
local integer id=GetPlayerId(GetOwningPlayer(ZX7))
if ISLABIKE(ZX7) then
    if GetUnitLevel(ZX7)>=16 then
        set V77=3
    elseif GetUnitLevel(ZX7)>=11 then
        set V77=2
    elseif GetUnitLevel(ZX7)>=6 then
        set V77=1
    endif
endif
if SuijiMode_HasAghanimState(ZX7) then
set HaveA=true
else
set HaveA=false
endif
if V77==1 then
    set TI4[id]=TI4[id]+1
    if HaveA then
        if GetPrdRandom(ZX7,'A088'+5,5) then
            set r=5
            set N4[id]=N4[id]+1
        elseif GetPrdRandom(ZX7,'A088'+2,50) then
            set r=2
            set TF4[id]=TF4[id]+1
        endif
    else
        if GetPrdRandom(ZX7,'A088'+2,40) then
            set r=2
            set TF4[id]=TF4[id]+1
        endif
    endif
elseif V77==2 then
    set TI4[id]=TI4[id]+1
    if HaveA then
        if GetPrdRandom(ZX7,'A088'+5,5) then
            set r=5
            set N4[id]=N4[id]+1
        elseif GetPrdRandom(ZX7,'A088'+3,30) then
            set r=3
            set TG4[id]=TG4[id]+1
        elseif GetPrdRandom(ZX7,'A088'+2,60) then
            set r=2
            set TF4[id]=TF4[id]+1
        endif
    else
        if GetPrdRandom(ZX7,'A088'+3,25) then
            set r=3
            set TG4[id]=TG4[id]+1
        elseif GetPrdRandom(ZX7,'A088'+2,50) then
            set r=2
            set TF4[id]=TF4[id]+1
        endif
        endif
elseif V77==3 then
    set TI4[id]=TI4[id]+1
    if HaveA then
        if GetPrdRandom(ZX7,'A088'+5,5) then
            set r=5
            set N4[id]=N4[id]+1
        elseif GetPrdRandom(ZX7,'A088'+4,20) then
            set r=4
            set TH4[id]=TH4[id]+1
        elseif GetPrdRandom(ZX7,'A088'+3,40) then
            set r=3
            set TG4[id]=TG4[id]+1
        elseif GetPrdRandom(ZX7,'A088'+2,80) then
            set r=2
            set TF4[id]=TF4[id]+1
        endif
    else
        if GetPrdRandom(ZX7,'A088'+4,15) then
            set r=4
            set TH4[id]=TH4[id]+1
        elseif GetPrdRandom(ZX7,'A088'+3,30) then
            set r=3
            set TG4[id]=TG4[id]+1
        elseif GetPrdRandom(ZX7,'A088'+2,60) then
            set r=2
            set TF4[id]=TF4[id]+1
        endif
    endif
endif
return r
endfunction
function EYD takes nothing returns boolean
local unit m5=GetFilterUnit()
local unit WI7=GetTriggerUnit()
if IsUnitAlly(m5,GetOwningPlayer(WI7)) and GetUnitState(m5,UNIT_STATE_LIFE)>0 and GetUnitAbilityLevel(m5,'Bblo')==0 then
if(GetOwningPlayer(m5)==Z7[0]or GetOwningPlayer(m5)==A7[0])then
if GetUnitTypeId(m5)=='ugho' or GetUnitTypeId(m5)=='u001' or GetUnitTypeId(m5)=='unec' or GetUnitTypeId(m5)=='u002' then
set m5=null
set WI7=null
return true
endif
if GetUnitTypeId(m5)=='esen' or GetUnitTypeId(m5)=='e00V' or GetUnitTypeId(m5)=='edry' or GetUnitTypeId(m5)=='e00W' then
set m5=null
set WI7=null
return true
endif
return false
elseif IsUnitType(m5,UNIT_TYPE_HERO) then
set m5=null
set WI7=null
return true
elseif GetOwningPlayer(m5)==GetOwningPlayer(WI7) and KW7(m5)==false then
set m5=null
set WI7=null
return true
endif
endif
set m5=null
set WI7=null
return false
endfunction
function EZD takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local unit IH7=GetSpellTargetUnit()
local integer skill=B287_GetSpellAbilityId()
local integer skillbuff
local integer level=B287_GetUnitAbilityLevel(ZX7,skill)
local real duration=30.*SuijiMode_GetDurationMulticastCount(ZX7,skill)
if level==1 then
    set skillbuff='A4I6'
elseif level==2 then
    set skillbuff='A4I7'
elseif level==3 then
    set skillbuff='A4I8'
elseif level==4 then
    set skillbuff='A4I9'
endif
call ADD_SX_BUFF(IH7,skillbuff,duration)
set ZX7=null
set IH7=null
endfunction
//嗜血
function EBD takes nothing returns boolean
local integer skill=B287_GetSpellAbilityId()
if skill=='A083' or skill=='A08F' or skill=='A08G' or skill=='A08I' then
    call EZD()
endif
return false
endfunction
function FB8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function EBD))
set t=null
endfunction
function YINRAN_TRI takes nothing returns nothing
	local unit ZX7 = U22
	local unit IH7 = W22
    local integer h = GetHandleId(GetTriggeringTrigger())
    local integer level = LoadInteger(TABLE_HY, h, 10)
    local integer skillmj = LoadInteger(TABLE_HY, h, 11)
    local integer durationCount = LoadInteger(TABLE_HY, h, 12)
    local unit BB7=CreateUnit(GetOwningPlayer(ZX7),'e00E',GetUnitX(IH7),GetUnitY(IH7),0)
    call XF7(BB7,skillmj)
    call SetUnitAbilityLevel(BB7,skillmj,level)
    call IssueTargetOrderById(BB7,$D02B6,IH7)
    call SuijiMode_ScheduleDurationBuff(IH7,'B03J',0,(3.+level)*durationCount)
    call LINGXIA(ZX7,IH7)
	set ZX7 = null
	set IH7 = null
    set BB7 = null
endfunction
function YINRAN3 takes nothing returns nothing
    local unit ZX7=GetTriggerUnit()
    local unit IH7=GetSpellTargetUnit()
    local integer skill=B287_GetSpellAbilityId()
    local integer level=B287_GetUnitAbilityLevel(ZX7,skill)
    local integer skillmj
    local trigger t
    if skill=='A011' then
        set skillmj='A4J6'
    elseif skill=='A007' then
        set skillmj='A4J7'
    elseif skill=='A01T' then
        set skillmj='A4J8'
    elseif skill=='A00F' then
        set skillmj='A4J9'
    endif
    set t=NHX(ZX7, IH7,'h0HL', "YINRAN_TRI",1000, true, "")
    call SaveInteger(TABLE_HY, GetHandleId(t), 10, level)
    call SaveInteger(TABLE_HY, GetHandleId(t), 11, skillmj)
    call SaveInteger(TABLE_HY, GetHandleId(t), 12, SuijiMode_GetDurationMulticastCount(ZX7,skill))
    set ZX7=null
    set IH7=null
    set t=null
endfunction
function YINRAN2 takes nothing returns boolean
local integer skill=B287_GetSpellAbilityId()
if (skill=='A011' or skill=='A007' or skill=='A01T' or skill=='A00F') and WQ7(GetSpellTargetUnit())==false then
    call YINRAN3()
endif
return false
endfunction
function YINRAN takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function YINRAN2))
set t=null
endfunction
