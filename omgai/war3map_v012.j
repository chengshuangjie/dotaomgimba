//AI使用物品后
function MOF takes nothing returns nothing
local unit x6=GetTriggerUnit()
local integer Iz=GetItemTypeId(GetManipulatedItem())
local integer i1=GetUnitTypeId(x6)
local integer O5=GetPlayerId(GetOwningPlayer(x6))
local unit m5=null
local boolean J4=false
if(Iz==ZU[TC])then
set hq[256+O5]=Bz+25.
call jW(x6,$D0012,h9[O5])
if(ME7(x6))then
set G0[32+O5]=true
loop
exitwhen((GetUnitLifePercent(x6)>50.)or(Bz>hq[256+O5]))
if(MP7(1000.,x6,Condition(function QN7))>0)then
call jW(x6,$D0012,h9[O5])
else
call IssueImmediateOrderById(x6,$D0019)
endif
call J_7(1.)
endloop
set G0[32+O5]=false
call J3(x6,true)
endif
elseif(Iz==ZU[QC])then
call J_7(.5)
set G0[32+O5]=true
loop
exitwhen((GetUnitAbilityLevel(x6,'B0HV')==0)or(GetUnitLifePercent(x6)>95.))
if(not K57(x6))then
elseif(MP7(1500.,x6,Condition(function k2))>0)then
call jW(x6,$D0012,h9[O5])
else
call IssueImmediateOrderById(x6,$D0019)
endif
call J_7(.5)
endloop
set G0[32+O5]=false
call J3(x6,true)
elseif(Iz==ZU[it_shuaxin])then
set hq[O5]=Bz
set hq[48+O5]=Bz+160.
elseif(Iz==ZU[P1])then
set hq[64+O5]=Bz+30.
call J_7(.1)
set m5=h4[O5]
set J4=(m5!=null)and(not ME7(x6))and(IssueTargetOrderById(x6,$D000F,m5))
elseif(Iz==ZU[FC])or(Iz==ZU[it_fls])then
set m5=h4[O5]
if i1=='H0DO' then
set J4=(m5!=null)and(IssuePointOrderById(x6,$D02B6,GetUnitX(m5),GetUnitY(m5)))
// elseif(i1==1211117646)then
// //set J4=(m5!=null)and(IssuePointOrderById(x6,$D00DE,GetUnitX(m5),GetUnitY(m5)))
// set J4=(m5!=null)and(N47(x6,$D00DE,1093808465,1093808465,GetUnitX(m5),GetUnitY(m5)))
// elseif(i1==1211117646)then
// //set J4=(m5!=null)and(IssuePointOrderById(x6,$D00DE,GetUnitX(m5),GetUnitY(m5)))
// set J4=(m5!=null)and(N47(x6,$D00DE,1093808465,1093808465,GetUnitX(m5),GetUnitY(m5)))
endif
elseif(Iz==ZU[it_zhzg])then
if i1=='H00Q' then
        if aitarget[O5]!=null and IsUnitInRange(x6,aitarget[O5],750) then
            if GetUnitAbilityLevel(aitarget[O5],'B0HP')>0 then
                set J4=IssueTargetOrderById(x6,$D0107,aitarget[O5])
            else
                call J_7(.1)
                if GetUnitAbilityLevel(aitarget[O5],'B0HP')>0 then
                    set J4=IssueTargetOrderById(x6,$D0107,aitarget[O5])
                else
                    set J4=UnitUseItemTarget(x6,MV7(x6,ZU[it_xueji]),aitarget[O5])
                endif
            endif
        endif
    endif
elseif(Iz==ZU[it_xh])then
    set m5=null
    call J_7(.1)
if i1=='Opgh' then
    set m5=S17(250.,x6)
    set J4=(m5!=null)and(IssueImmediateOrderById(x6,$D0278))
elseif i1=='UC91' then
    set m5=S17(300.,x6)
set J4=m5!=null and N977(x6,852164,'A29K','A2YG')
elseif i1=='Nbbc' then
    set m5=S17(400.,x6)
set J4=m5!=null and WQ7(m5)==false and M_7(x6,852063,'A0M1','A1AX',m5)
elseif i1=='U00C' then
    set m5=S17(350.,x6)
set J4=m5!=null and WQ7(m5)==false and M_7(x6,852600,'A0SW','A4FR',m5)
    endif
elseif(Iz==ZU[it_yangdao])then
set hq[96+O5]=Bz+13.
elseif(Iz==ZU[DR4])then
set T34[$F0+O5]=Bz+18.  
elseif(Iz==ZU[it_xueji])then  //血棘
set T34[$F0+O5]=Bz+13.
if i1=='H00Q' then
        if aitarget[O5]!=null and IsUnitInRange(x6,aitarget[O5],750) then
            if GetUnitAbilityLevel(aitarget[O5],'B1EQ')>0 then
                set J4=IssueTargetOrderById(x6,$D0107,aitarget[O5])
            else
                call J_7(.1)
                if GetUnitAbilityLevel(aitarget[O5],'B1EQ')>0 then
                    set J4=IssueTargetOrderById(x6,$D0107,aitarget[O5])
                else
                    set J4=AI_ITEM_POINT(x6,aitarget[O5],ZU[it_zhzg])
                endif
            endif
        endif
    endif
elseif(Iz==ZU[it_bingjia])then
set T34[$B0+O5]=Bz+30.
elseif(Iz==ZU[DY4])or(Iz==ZU[it_dgh])then
set T34[$E0+O5]=Bz+10.
elseif(Iz==ZU[VB])then
set T34[256+O5]=Bz+30.
elseif(Iz==ZU[DT4])or(Iz==ZU[ZA])then
set T34[$C0+O5]=Bz+17.
//虚灵刀
elseif(Iz==ZU[E24])then
set T34[$D0+O5]=Bz+30.
set m5=h4[O5]
if i1=='O00P' then
call J_7(.6)
set J4=(m5!=null)and(IssueTargetOrderById(x6,$D02B6,m5))
endif
elseif(Iz==ZU[AL])or(Iz==ZU[it_jjj])then
set TB4=false
elseif(Iz==ZU[T1])then
set hq[80+O5]=Bz+45.
elseif(Iz==ZU[R06])then
set hq[80+O5]=Bz+45.
elseif(Iz==ZU[F74])then
set hq[$80+O5]=Bz+30.
elseif(Iz==ZU[S6])then
set hq[$90+O5]=Bz+100.
elseif((Iz==ZU[YC])or(Iz==ZU[XC])or(Iz==ZU[F6])or(Iz==ZU[FF6]))then
set Iz=GetUnitCurrentOrder(x6)
// call SetPlayerController(GetOwningPlayer(x6),MAP_CONTROL_NONE)
call MHUnit_DisableControl(x6)
loop
exitwhen(Iz!=GetUnitCurrentOrder(x6))
call J_7(.1)
endloop
call J_7(.1)
// call SetPlayerController(GetOwningPlayer(x6),MAP_CONTROL_COMPUTER)
call MHUnit_EnableControl(x6)
call J_7(.5)
call J3(x6,true)
if(KE7(x6,NF7(x6))<1500.)then
set h9[O5]=NF7(x6)
call PW7(x6,true)
else
call UQ7(x6)
endif
elseif(Iz==ZU[C0])or(Iz==ZU[RLL])then
if(GZ[272+O5])then
call J_7(.01)
if i1=='Nfir' or i1=='EC57' then
call ExecuteFunc("JGF")
elseif i1=='Nbrn' or i1=='EC77' then
call ExecuteFunc("JHF")
endif
endif
elseif(Iz==ZU[N5])then
	call J_7(.01)
if i1=='Ntin' then
if AI_SKILL_OK(x6,'A05E') or AI_SKILL_OK(x6,'A2US') then
set J4=N977(x6,852526,'A05E','A2US')
		else
			set J4=IssueImmediateOrderById(x6,$D0278)
		endif
	endif


elseif((Iz==ZU[Y0])or(Iz==ZU[it_xyf]))then
if(not ME7(x6))then
if i1=='Ntin' then
		call TriggerSleepAction(1.)
	else
		call TriggerSleepAction(1.5)
	endif
if i1=='HC49' then
set m5=S17(400.,x6)
set J4=m5!=null and M57(x6,852095,'A24D',m5)
elseif i1=='Ntin' then
	set J4=IssueImmediateOrderById(x6,$D0278)
elseif i1=='U00A' then
set m5=S17(400.,x6)
set J4=m5!=null and M57(x6,852231,'A055',m5)
elseif i1=='H00U' then
set m5=S17(400.,x6)
set J4=m5!=null and (Bz>T34[64+O5] and UG7(x6,A_4,A_4,A54,'A0VO') and IssueImmediateOrderById(x6,852132))
if((not J4)and(m5!=null)and(Bz>T34[64+O5]))then
call SetPlayerAbilityAvailable(GetOwningPlayer(x6),BS[7],true)
set J4=IssueImmediateOrderById(x6,$D00A4)
call SetPlayerAbilityAvailable(GetOwningPlayer(x6),BS[7],false)
endif
elseif i1=='E01B' then
set m5=S17(400.,x6)
set J4=(m5!=null)and(IssueTargetOrderById(x6,$D02B6,m5))
elseif i1=='Oshd' then
set m5=S17(400.,x6)
set J4=m5!=null and GetUnitState(x6,UNIT_STATE_MANA)>hq[272+O5] and M_7(x6,852480,'A02Q','A1D9',m5)
elseif i1=='U000' then
set m5=S17(400.,x6)
set J4=m5!=null and M57(x6,852555,'A0X7',m5)
endif
endif
endif
set x6=null
set m5=null
endfunction
//使用跳刀
function AI_TIAODAO takes nothing returns nothing
local unit x6=GetTriggerUnit()
local integer skill=B287_GetSpellAbilityId()
local integer i1=GetUnitTypeId(x6)
local integer O5=GetPlayerId(GetOwningPlayer(x6))
local unit m5=null
local boolean J4=false
if skill=='Abbk' or skill=='A2YR'  or skill=='A4HR' or skill=='A4HS' then
    set m5=null
    set hq[512+O5]=Bz+3.
    set hq[112+O5]=Bz+25.
    call TriggerSleepAction(.01)
    if(not ME7(x6))then
if i1=='UC11' then
            if FUCK and GetUnitState(x6,UNIT_STATE_MANA)>230+B287_GetUnitAbilityLevel(x6,'A29L')*50 and GZ[O5] and AI_SKILL_OK(x6,'A29L') and CHUIFENG(aitarget[O5])==false then
                call SetUnitFacing(x6,AngleBetweenUnit(x6,GetQSMJ(x6)))
set J4=N97(x6,852164,'A29L')
            endif
        if not J4 and GZ[O5] then
            set GZ[O5]=false
            set J4=IssueTargetOrderById(x6,$D00E4,GetQSMJ(x6))
            if not J4 then
                call J_7(.2)
                set J4=IssueTargetOrderById(x6,$D00E4,GetQSMJ(x6))
            endif
        endif
        if not J4 then
            set m5=S17(350.,x6)
set J4=m5!=null and ((MP7(400.,x6,Condition(function k6))>1 and GZ[208+O5]) or ME7(m5) and N97(x6,852164,'A29L')) or M_7(x6,852218,'A02S','A4FJ',m5)
        endif
elseif i1=='H00Q' then
            if aitarget[O5]!=null and IsUnitInRange(x6,aitarget[O5],750) and IsUnitVisible(aitarget[O5],GetOwningPlayer(x6)) then
                if GetUnitAbilityLevel(aitarget[O5],'B0HP')>0 and GetUnitAbilityLevel(aitarget[O5],'B1EQ')>0 then
                    set J4=IssueTargetOrderById(x6,$D0107,aitarget[O5])
                elseif GetUnitAbilityLevel(aitarget[O5],'B1EQ')>0 then
                    set J4=UnitUseItemTarget(x6,MV7(x6,ZU[it_xueji]),aitarget[O5])
                elseif GetUnitAbilityLevel(aitarget[O5],'B0HP')>0 then
                    set J4=AI_ITEM_POINT(x6,aitarget[O5],ZU[it_zhzg])
                else
                set J4=UnitUseItemTarget(x6,MV7(x6,ZU[it_xueji]),aitarget[O5])     
