function X1D takes nothing returns nothing
local unit p5=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local integer V77=B287_GetUnitAbilityLevel(p5,'A094')
local integer X0D
local real VW9=GetUnitState(m5,UNIT_STATE_MAX_LIFE)*.2
local real d=75+V77*50
local integer id=GetUnitTypeId(p5)
local string tx
local string tx2
if id=='ZC42' then
    set tx="model\\Hero_DoomBringer_N6S_V_target.mdl"
    set tx2="model\\Hero_DoomBringer_N6S_V_mega.mdl"
elseif id=='ZC43' then
    set tx="model\\Hero_DoomBringer_N5S_V_target.mdl"
    set tx2="model\\Hero_DoomBringer_N5S_V_mega.mdl"
else
    set tx="Abilities\\Spells\\Human\\MarkOfChaos\\MarkOfChaosDone.mdl"
    set tx2="Abilities\\Spells\\Demon\\DemonBoltImpact\\DemonBoltImpact.mdl"
endif
call CommonUnitAddStun(m5, .01, false)
call B67(p5,m5,1,d)
call DestroyEffect(AddSpecialEffectTarget(tx,m5,"chest"))
if IsUnitType(m5, UNIT_TYPE_HERO) then
set X0D=GetHeroLevel(m5)
if ModuloInteger(X0D,7-V77)==0 or X0D==25 then
call B67(p5,m5,1,VW9)
call DestroyEffect(AddSpecialEffectTarget(tx2,m5,"chest"))
endif
endif
call LINGXIA(p5,m5)
set p5=null
set m5=null
endfunction
