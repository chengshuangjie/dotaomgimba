function SuijiMode_StartChaosPhantasmImages takes unit ZX7,integer castSkill,boolean originalCast returns nothing
local trigger t
local integer I97
local integer number=0
if ZX7==null or GetUnitTypeId(ZX7)==0 then
set ZX7=null
return
endif
if originalCast and SuijiMode_ShouldBlockScepterPairReentry(ZX7,castSkill,'A03O','A3K8',"SuijiChaosPhantasmPair",.20) then
set ZX7=null
return
endif
set number=SuijiMode_GetPairCastLevel(ZX7,castSkill,'A03O','A3K8')
if number<=0 and SUIJI_MODE and OO7(GetHandleId(ZX7),"SuijiDone") and (OM7(GetHandleId(ZX7),"SuijiUltSkill")=='A03O' or OM7(GetHandleId(ZX7),"SuijiUltSkill")=='A3K8') then
set number=R2I(I2R(GetHeroLevel(ZX7))/6.)
endif
if number<1 then
set number=1
endif
if number>3 then
set number=3
endif
if GetRandomInt(0,1)==0 or SuijiMode_HasAghanimState(ZX7) then
set number=number+1
endif
set t=CreateTrigger()
set I97=GetHandleId(t)
call TriggerRegisterTimerEvent(t,0.7,false)
call TriggerAddCondition(t,Condition(function CA4))
call SaveUnitHandle(L7,(I97),(2),(ZX7))
call SaveInteger(L7,(I97),(10),(number))


if originalCast and OO7(GetHandleId(ZX7),"FSING") then
set t=CreateTrigger()
call TriggerRegisterTimerEvent(t,.75,false)
call TriggerAddCondition(t,Condition(function ADD_LK))
call NT7(GetHandleId(t),"Source",ZX7)
endif
set t=null
set ZX7=null
endfunction
