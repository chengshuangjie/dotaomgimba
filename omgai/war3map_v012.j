call P6(T4,15,row,SuijiT4_PlayerSkillIcon(p,2))
call P6(T4,16,row,SuijiT4_PlayerSkillIcon(p,3))
call P6(T4,17,row,SuijiT4_PlayerSkillIcon(p,4))
call P6(T4,18,row,SuijiT4_PlayerSkillIcon(p,5))
call P6(T4,19,row,SuijiT4_PlayerSkillIcon(p,6))
