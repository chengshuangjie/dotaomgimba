call DestroyEffect(AddSpecialEffectTarget(tx,hn,"origin"))
if WGE==1 then
set WEE='A104'
set WFE='A107'
elseif WGE==2 then
set WEE='A101'
set WFE='A106'
elseif WGE==3 then
set WEE='A102'
set WFE='A105'
elseif WGE==4 then
set WEE='A103'
set WFE='A108'
