function SWA takes nothing returns nothing
	if WXX==null or YXX==null or GetUnitTypeId(WXX)==0 or GetUnitTypeId(YXX)==0 then
		return
	endif
	if UnitAlive(WXX)==false or UnitAlive(YXX)==false then
		return
	endif
	if ISPH(WXX)==false and B287_GetUnitAbilityLevel(WXX,'A2UE')> 0 then
		call BFI(WXX, YXX)
	endif
endfunction
function O91 takes nothing returns boolean 
local trigger t=GetTriggeringTrigger() 
local integer I97=GetHandleId(t) 
local unit p5=(LoadUnitHandle(L7,(I97),(2))) 
call FlushChildHashtable(L7,(I97)) 
call OZ7(t) 
call SetUnitPathing(p5,true) 
set t=null 
set p5=null 
return false 
endfunction 
