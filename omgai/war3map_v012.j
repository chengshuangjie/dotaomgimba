function C_7 takes nothing returns boolean
local unit u=GetTriggerUnit()
if IsUnitIllusion(u)==false and GetUnitTypeId(u)!='H00J' then
call C27("Learn"+I2S(GetPlayerId(GetTriggerPlayer())),B287_GetLearnedSkill())
endif
//智慧之光和以太效果不能叠加
if GetUnitAbilityLevel(u,'A2YK')>0 then
call Change_Hero_Skill_Range(u,200.)
//call Change_Item_Skill_Range(u,200.)
elseif GetUnitAbilityLevel(u,'A2YJ')>0 then
call Change_Hero_Skill_Range(u,150.)
//call Change_Item_Skill_Range(u,150.)
elseif GetUnitAbilityLevel(u,'A4DJ')>0 or GetUnitAbilityLevel(u,'A4DZ')>0 then
call Change_Hero_Skill_Range(u,0.)
//call Change_Item_Skill_Range(u,0.)
endif
set u=null
return false
endfunction
function L47 takes nothing returns boolean
if IsUnitType(GetTriggerUnit(),UNIT_TYPE_HERO) and IsUnitIllusion(GetTriggerUnit())==false and GetUnitTypeId(GetTriggerUnit())!='H00J' then
call C27("Cast"+I2S(GetPlayerId(GetTriggerPlayer())),B287_GetSpellAbilityId())
endif
return false
endfunction
