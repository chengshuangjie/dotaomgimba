// endif
// if KZ7(GetManipulatedItem())==it_sadan then
// call UnitRemoveAbility(WI7,1093747287)
// endif
if KZ7(GetManipulatedItem())==DK4 then
call UnitRemoveAbility(WI7,'A0PU')
call UnitRemoveAbility(WI7,'A0TC')
call UnitRemoveAbility(WI7,'A0UK')
endif
if KZ7(GetManipulatedItem())==EZB then
call UnitRemoveAbility(WI7,'A4AB')
call UnitRemoveAbility(WI7,'A2QS')
call UnitRemoveAbility(WI7,'A2T9')
endif
if (KZ7(GetManipulatedItem())==R16 or KZ7(GetManipulatedItem())==R1K) and CHIA[GetPlayerId(GetOwningPlayer(WI7))]==0 then
call SetPlayerAbilityAvailable(GetOwningPlayer(WI7),'A2SI',false)
call UnitRemoveAbility(WI7,'A2SI')
endif
if KZ7(GetManipulatedItem())==WL or KZ7(GetManipulatedItem())==U3 or KZ7(GetManipulatedItem())==ZL then
call UnitRemoveAbility(WI7,'A174')
call UnitRemoveAbility(WI7,'A175')
endif
