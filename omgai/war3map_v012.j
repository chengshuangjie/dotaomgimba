		call B67_DPS(WXX,YXX,6,ZXX*.5)
	endif
endfunction
function M3D takes unit ZX7,unit IH7 returns nothing
local integer I97=GetHandleId(ZX7)
local integer R50=(LoadInteger(L7,(I97),(237)))
local unit M6D=TQ7(R50)
local integer Y_9=YH7((LoadInteger(L7,(I97),(236))),0)
local integer BC7=B287_GetUnitAbilityLevel(ZX7,'A0O0')
local integer R46=1
if M6D!=IH7 then
set Y_9=R2I(Y_9/2)
set Y_9=IMaxBJ(Y_9,1)
else
set Y_9=YG7(Y_9+1,8)
endif
if Y_9>1 then
set R46=Y_9+7*(BC7-1)
endif
if ISPH(ZX7) then
set R46=1
endif
call YF7(ZX7,'A0NZ',R46)
call SaveInteger(L7,(I97),(236),(Y_9))
if M6D!=IH7 then
call TP7(R50)
set R50=TS7(IH7)
call SaveInteger(L7,(I97),(237),(R50))
endif
set M6D=null
endfunction
function G68 takes nothing returns nothing
if B287_GetUnitAbilityLevel(WXX,'A0O0')>0 and ISPH(WXX)==false then
    call M3D(WXX,YXX)
endif
endfunction
