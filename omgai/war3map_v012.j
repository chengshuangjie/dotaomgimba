set IQ4=A5G
call GroupEnumUnitsInRange(g,GetUnitX(WX7),GetUnitY(WX7),250,Condition(function AO7_gai))
call ForGroup(g,function A6G)
call WR7(g)
endif
if WF8==(A1G)then
call FMJ_Y67(GetUnitX(WX7),GetUnitY(WX7),90)
    if TR7(LoadInteger(L7,(I97),(88)))!=null then
        call Remove_Tree(LoadInteger(L7,(I97),(88)))
        call KillDestructable(TR7(LoadInteger(L7,(I97),(88))))
    endif
