function SetDynamicBar takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit HKI=(LoadUnitHandle(TABLE_XJ,(OB7),(14)))
local integer L2I=(LoadInteger(TABLE_XJ,(OB7),(230)))
local real N2I=(LoadReal(TABLE_XJ,(OB7),(232)))
local unit u=(LoadUnitHandle(TABLE_XJ,(OB7),(231)))
local integer H5I=GetTriggerEvalCount(t)
local real r=YK7(N2I-H5I*0.05,0)
local integer i=YH7(R2I((r/N2I)*50),2)
local real x=GetUnitX(HKI)
local real y=GetUnitY(HKI)
call SetUnitX(u,x)
call SetUnitY(u,y)
call SetUnitFlyHeight(u,200,0)
call SetUnitAnimationByIndex(u,i)
if r==0 or GetTriggerEventId()==EVENT_UNIT_DEATH or(GetTriggerEventId()==EVENT_UNIT_SPELL_ENDCAST and B287_GetSpellAbilityId()==L2I) or ISDODGE(HKI) then
call FlushChildHashtable(TABLE_XJ,(OB7))
call OZ7(t)
call ShowUnit(u,false)
call RemoveUnit(u)
endif
set t=null
set u=null
set HKI=null
return false
endfunction
function SetSpellChannelingBar takes unit HKI,real N2I returns nothing
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local unit u=CreateUnit(GetOwningPlayer(HKI),'h0HP',GetUnitX(HKI),GetUnitY(HKI),bj_UNIT_FACING)
local integer r=KA4[GetPlayerId(GetOwningPlayer(HKI))]
local integer g=KB4[GetPlayerId(GetOwningPlayer(HKI))]
local integer b=KC4[GetPlayerId(GetOwningPlayer(HKI))]
local integer a=0
if GetOwningPlayer(HKI)==GetLocalPlayer()or WG7(GetLocalPlayer())then
call SetUnitVertexColor(u,r,g,b,255)
else
call SetUnitVertexColor(u,r,g,b,a)
endif
call UnitAddAbility(u,'Amrf')
call UnitRemoveAbility(u,'Amrf')
call SetUnitFlyHeight(u,200,0)
call SetUnitAnimationByIndex(u,52)
call PauseUnit(u,true)
call SaveUnitHandle(TABLE_XJ,(OB7),(14),(HKI))
call SaveInteger(TABLE_XJ,(OB7),(230),(B287_GetSpellAbilityId()))
call SaveUnitHandle(TABLE_XJ,(OB7),(231),(u))
call SaveReal(TABLE_XJ,(OB7),(232),((N2I)*1.0))
call TriggerRegisterTimerEvent(t,0.05,true)
call TriggerRegisterUnitEvent(t,HKI,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(t,HKI,EVENT_UNIT_SPELL_ENDCAST)
call TriggerAddCondition(t,Condition(function SetDynamicBar))
set u=null
set t=null
endfunction
function SuijiTradeTricks_RandomBonusLevel takes unit suijiTradeTricksCaster returns integer
local integer suijiTradeTricksCasterHandle=0
local integer suijiTradeTricksBonusLevel=0
if suijiTradeTricksCaster==null or SUIJI_MODE==false then
return 0
endif
set suijiTradeTricksCasterHandle=GetHandleId(suijiTradeTricksCaster)
if OO7(suijiTradeTricksCasterHandle,"SuijiDone")==false then
return 0
endif
if OM7(suijiTradeTricksCasterHandle,"SuijiSmallSkill")=='A00J' or OM7(suijiTradeTricksCasterHandle,"SuijiUltSkill")=='A00J' then
set suijiTradeTricksBonusLevel=B287_GetUnitAbilityLevel(suijiTradeTricksCaster,'A00J')
endif
if OM7(suijiTradeTricksCasterHandle,"SuijiSmallSkill")=='A4K2' or OM7(suijiTradeTricksCasterHandle,"SuijiUltSkill")=='A4K2' then
if B287_GetUnitAbilityLevel(suijiTradeTricksCaster,'A4K2')>suijiTradeTricksBonusLevel then
set suijiTradeTricksBonusLevel=B287_GetUnitAbilityLevel(suijiTradeTricksCaster,'A4K2')
endif
endif
return suijiTradeTricksBonusLevel
endfunction
function TradeTricks_Attack takes unit ZX7,real x,real y returns nothing
local real r=500
local group g
local unit u
local integer suijiTradeTricksBonusLevel=0
set g=WS7()
set IN4=ZX7
call GroupEnumUnitsInRange(g,x,y,r,Condition(function AJ7_Visible))
set u=GroupPickRandomUnit(g)
call WR7(g)
if u !=null then
	set ZX7_tmp=ZX7
	set IH7_tmp=u
	call ExecuteFunc("Func_MNGJ")
	call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BlinkStrike.mdx",u,"chest"))
    set suijiTradeTricksBonusLevel=B287_GetUnitAbilityLevel(ZX7,'A0DZ')
    if suijiTradeTricksBonusLevel<=0 then
        set suijiTradeTricksBonusLevel=SuijiTradeTricks_RandomBonusLevel(ZX7)
    endif
    if UnitAlive(u) and suijiTradeTricksBonusLevel>0 then
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",u,"chest"))
        call B67(ZX7,u,2,GetHeroAgi(ZX7,true)*(.25*suijiTradeTricksBonusLevel+.25))
    endif
endif
set g=null
set u=null
endfunction
function TradeTricks_Actions takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(TABLE_XJ,(OB7),(2)))
local unit IH7=(LoadUnitHandle(TABLE_XJ,(OB7),(19)))
local unit N4I=(LoadUnitHandle(TABLE_XJ,(OB7),(17)))
local integer level=(LoadInteger(TABLE_XJ,(OB7),(5)))
local integer level_ys=(LoadInteger(TABLE_XJ,(OB7),(34)))
local real x=(LoadReal(TABLE_XJ,(OB7),(6)))
local real y=(LoadReal(TABLE_XJ,(OB7),(7)))
local integer H5I=GetTriggerEvalCount(t)
local integer W9I=50
if GetTriggerEventId()==EVENT_UNIT_SPELL_ENDCAST and(B287_GetSpellAbilityId()=='A00J' or B287_GetSpellAbilityId()=='A4K2') or ISDODGE(ZX7) then
	call DestroyEffect((LoadEffectHandle(TABLE_XJ,(OB7),(32))))
	call RemoveUnit(N4I)
	call SetUnitInvulnerable(ZX7,false)
    call UnitCancelHide(ZX7)
    call OX7(ZX7,"HideUnit")
	call UnitRemoveAbility(ZX7,'Aeth')
	call SetUnitPathing(ZX7,true)
    if IsUnitSelected(ZX7,GetOwningPlayer(ZX7)) then
        call SelectUnitForPlayerSingle(ZX7,GetOwningPlayer(ZX7))
    endif
	call FlushChildHashtable(TABLE_XJ,(OB7))
	call OZ7(t)
	if level_ys>0 then
		call XF7(ZX7,'A0MB')
		call SetUnitAbilityLevel(ZX7,'A0MB',level_ys)
	endif
	if TZ7(GetOwningPlayer(ZX7)) and (GetUnitLifePercent(ZX7)<25 or GetRandomInt(1,2)==1) and (AI_ITEM_OK(ZX7,"tiaodao") or AI_ITEM_OK(ZX7,"datiaodao2")) then
		call MHUnit_EnableControl(ZX7)
		call IssueImmediateOrder(ZX7,"stop")
		if AI_ITEM_OK(ZX7,"tiaodao") then
			call UnitUseItemPoint(ZX7,MV7(ZX7,ZU[RW]),GetUnitX(GetQSMJ(ZX7)),GetUnitY(GetQSMJ(ZX7)))
		else
			call UnitUseItemPoint(ZX7,MV7(ZX7,ZU[it_xjsg]),GetUnitX(GetQSMJ(ZX7)),GetUnitY(GetQSMJ(ZX7)))
		endif
	endif
else
	if IH7!=null and UnitAlive(IH7) then
		set x=GetUnitX(IH7)
		set y=GetUnitY(IH7)
		call SaveReal(TABLE_XJ,(OB7),(6),((x)*1.0))
		call SaveReal(TABLE_XJ,(OB7),(7),((y)*1.0))
		call SetUnitX(N4I,x)
		call SetUnitY(N4I,y)
		call SetUnitX(ZX7,x)
		call SetUnitY(ZX7,y)
	endif
	if ModuloInteger(H5I,W9I)==0 then
		call TradeTricks_Attack(ZX7,x,y)
	endif
endif
set t=null
set ZX7=null
set IH7=null
set N4I=null
return false
endfunction
function TradeTricks_Main takes unit ZX7,unit IH7 returns nothing
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local real x=GetUnitX(ZX7)
local real y=GetUnitY(ZX7)
local unit N4I
local integer level_ys=GetUnitAbilityLevel(ZX7,'A0MB')
local integer skill=B287_GetSpellAbilityId()
local integer level=B287_GetUnitAbilityLevel(ZX7,skill)
local real DUR
if skill=='A4K2' then
    set DUR=5.0+level
else
    set DUR=2.0+level
endif
if skill=='A4K2' and IH7 !=null then
if B287_MHAbility_GetCastpoint(ZX7,'A4K2')!=.01 then
call B287_MHAbility_SetCastpoint(ZX7,'A4K2',.01)
    endif
    call SetSpellChannelingBar(ZX7,DUR)
    set x=GetUnitX(IH7)
    set y=GetUnitY(IH7)
    call SaveEffectHandle(TABLE_XJ,(OB7),(32),(AddSpecialEffectTarget("abilities\\spells\\nightelf\\faeriedragoninvis\\faeriedragon_invis.mdx",IH7,"overhead")))
    call XF7(ZX7,'Aeth')
    call SetUnitPathing(ZX7,false)
else
    call SetSpellChannelingBar(ZX7,DUR)
    call SaveEffectHandle(TABLE_XJ,(OB7),(32),(AddSpecialEffectTarget("abilities\\spells\\nightelf\\faeriedragoninvis\\faeriedragon_invis.mdx",ZX7,"overhead")))
endif
if level_ys>0 then
    call UnitRemoveAbility(ZX7,'A0MB')
endif
set N4I=CreateUnit(GetOwningPlayer(ZX7),'h0HQ',x,y,0)
call SetUnitInvulnerable(ZX7,true)
call UnitEnterHide(ZX7)
call OV7(ZX7,"HideUnit")
call SaveUnitHandle(TABLE_XJ,(OB7),(2),(ZX7))
call SaveUnitHandle(TABLE_XJ,(OB7),(19),(IH7))
call SaveUnitHandle(TABLE_XJ,(OB7),(17),(N4I))
call SaveInteger(TABLE_XJ,(OB7),(5),(level))
call SaveReal(TABLE_XJ,(OB7),(6),((x)*1.0))
call SaveReal(TABLE_XJ,(OB7),(7),((y)*1.0))
call SaveInteger(TABLE_XJ,(OB7),(34),(level_ys))
call TriggerRegisterTimerEvent(t,0.01,true)
call TriggerRegisterUnitEvent(t,ZX7,EVENT_UNIT_SPELL_ENDCAST)
call TriggerAddCondition(t,Condition(function TradeTricks_Actions))
call TradeTricks_Attack(ZX7,x,y)
set t=null
set N4I=null
endfunction
//绝杀秘技
function TradeTricks_Cast takes nothing returns boolean
if B287_GetSpellAbilityId()=='A00J' then
call TradeTricks_Main(GetTriggerUnit(),null)
elseif B287_GetSpellAbilityId()=='A4K2' then
call TradeTricks_Main(GetTriggerUnit(),GetSpellTargetUnit())
endif
return false
endfunction
