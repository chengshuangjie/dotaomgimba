function Group_Condition takes unit u returns boolean
	return IsUnitType(u, UNIT_TYPE_STRUCTURE)== false and UnitAlive(u) and GetUnitAbilityLevel(u,'A04R')== 0
endfunction
function Enum_Unit1 takes nothing returns boolean
	return Group_Condition(GetFilterUnit())
endfunction
function Enum_Unit2 takes nothing returns boolean
	return IsUnitEnemy(U22, GetOwningPlayer(GetFilterUnit())) and Group_Condition(GetFilterUnit())
endfunction
function Enum_Unit3 takes nothing returns boolean
	return IsUnitAlly(U22, GetOwningPlayer(GetFilterUnit())) and Group_Condition(GetFilterUnit())
endfunction
function WavedamageUnit_Condition takes unit u, unit source, boolean b returns boolean
	return(b or IsUnitEnemy(source, GetOwningPlayer(u)) and(Group_Condition(u) ) )
endfunction
function WaveDamageEnumUnit takes unit u, unit du, integer dt, real damage, string s, integer level, boolean b returns nothing
	if WavedamageUnit_Condition(du, u, b) then
		if(not b or IsUnitEnemy(u, GetOwningPlayer(du)) ) then
            if s=="QM_AI_USE_RENJIA" and GetRandomInt(1,2)==1 then
                call AI_ITEM_RENJIA(du)
            endif
			call B67(u, du, dt, damage)
		endif
		if s != null and s!="QM_AI_USE_RENJIA" then
			set Wave_U = du
            set Wave_LV = level
			set Wave_Sou = u
			call ExecuteFunc(s)
		endif
	endif
endfunction
function MM_WAVE_END_PD takes integer id returns nothing
    if id=='h0H4' or id=='h0H5' or id=='h0H3' then
        set MM_WAVE_END = true
    endif
endfunction
function QM_Restore_LIFE_Condition takes unit u, unit source, boolean b returns boolean
	return(b or IsUnitAlly(source, GetOwningPlayer(u)) and(Group_Condition(u) ) )
endfunction
function QM_Restore_LIFE takes unit u, unit du, integer dt, real damage, string s, integer level, boolean b returns nothing
	if QM_Restore_LIFE_Condition(du, u, b) then
		if(not b or IsUnitAlly(u, GetOwningPlayer(du)) ) and XH7(u)==false then
            call SetWidgetLife(du,GetWidgetLife(du)+damage)
            call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\SpellFizzle.mdx",du,"overhead"))
		endif
	endif
endfunction
function WaveRunningActions_QM takes nothing returns nothing
	local trigger t = GetTriggeringTrigger()
	local integer h = GetHandleId(t)
	local unit u = LoadUnitHandle(TABLE_HY, h, 0)
	local real damage = LoadReal(TABLE_HY, h, 0)
	local real radian = LoadReal(TABLE_HY, h, 3)* bj_DEGTORAD
	local real speed = LoadReal(TABLE_HY, h, 4)
	local real area = LoadReal(TABLE_HY, h, 8)
	local unit spu
	local unit du
	local group g
	local group g2
    local group g3
    local group g4
	local boolean b = LoadBoolean(TABLE_HY, h, 10)
	local boolean funcend = false
	local integer dt = LoadInteger(TABLE_HY, h, 1)
	local string funcstr = LoadStr(TABLE_HY, h, 0)
	local integer level = LoadInteger(TABLE_HY, h, 5)
    local integer id = LoadInteger(TABLE_HY, h, 20)
	local boolean time_event = GetTriggerEventId()== EVENT_GAME_TIMER_EXPIRED
	local boolean b2 = LoadBoolean(TABLE_HY, h,'ally')
	local real x
	local real y
	local real inrange
	local real angle_between
	local real angle
	local real a
	if time_event then
		call SetUnitX(u, CoordinateX50(GetUnitX(u)+ speed * Cos(radian)))
		call SetUnitY(u, CoordinateY50(GetUnitY(u)+ speed * Sin(radian)))
		call SaveInteger(TABLE_HY, h, 12, LoadInteger(TABLE_HY, h, 12)+ 1)
        if BlockUnitPass(u) then
            set funcend = true
            call MM_WAVE_END_PD(id)
		elseif LoadInteger(TABLE_HY, h, 12)> LoadInteger(TABLE_HY, h, 13) then
			set funcend = true
			call SetUnitX(u, LoadReal(TABLE_HY, h, 5))
			call SetUnitY(u, LoadReal(TABLE_HY, h, 6))
		endif
	else
		set du = GetTriggerUnit()
	endif
	if b then
		set g = LoadGroupHandle(TABLE_HY, h, 2)
		set g2 = WS7()
		set U22 = u
		set x = GetUnitX(u)
		set y = GetUnitY(u)
		set inrange = area + LoadReal(TABLE_HY, h, 9) *(GetTriggerEvalCount(t)-1) + 100
		if b2 then
			call GroupEnumUnitsInRange(g2, x, y, inrange, Condition(function Enum_Unit1))
		else
			call GroupEnumUnitsInRange(g2, x, y, inrange, Condition(function Enum_Unit2))
		endif
		call GroupRemoveGroup(g, g2)
		set spu = LoadUnitHandle(TABLE_HY, h, 5)
		set inrange = inrange - 100
		loop
			set du = FirstOfGroup(g2)
		exitwhen du == null
			call GroupRemoveUnit(g2, du)
			if IsUnitInRangeXY(du, x, y, inrange) then
				if GetTriggerEvalCount(t)< 3 then
					set angle = LoadReal(TABLE_HY, h, 3)
					set angle_between = AngleBetweenUnit(u, du)
					if(angle -angle_between <-180.00) then
						set a =(angle -angle_between + 360)
					else
						if(angle -angle_between > 180.00) then
							set a = angle -angle_between -360
						else
							set a = angle -angle_between
						endif
					endif
					set a = RAbsBJ(a)
					if a <= 120 then
						call GroupAddUnit(g, du)
						call WaveDamageEnumUnit(spu, du, dt, damage, funcstr, level, b2)
					endif
				else
					call GroupAddUnit(g, du)
					call WaveDamageEnumUnit(spu, du, dt, damage, funcstr, level, b2)
				endif
			endif
		endloop
		call WR7(g2)
		if funcend then
			call WR7(g)
		endif



		set g3 = LoadGroupHandle(TABLE_HY, h, 'A085')
		set g4 = WS7()
		set U22 = u
		set x = GetUnitX(u)
		set y = GetUnitY(u)
		set inrange = area + LoadReal(TABLE_HY, h, 9) *(GetTriggerEvalCount(t)-1) + 100
		call GroupEnumUnitsInRange(g4, x, y, inrange, Condition(function Enum_Unit3))
		call GroupRemoveGroup(g3, g4)
		set spu = LoadUnitHandle(TABLE_HY, h, 5)
		set inrange = inrange - 100
		loop
			set du = FirstOfGroup(g4)
		exitwhen du == null
			call GroupRemoveUnit(g4, du)
			if IsUnitInRangeXY(du, x, y, inrange) then
				if GetTriggerEvalCount(t)< 3 then
					set angle = LoadReal(TABLE_HY, h, 3)
					set angle_between = AngleBetweenUnit(u, du)
					if(angle -angle_between <-180.00) then
						set a =(angle -angle_between + 360)
					else
						if(angle -angle_between > 180.00) then
							set a = angle -angle_between -360
						else
							set a = angle -angle_between
						endif
					endif
					set a = RAbsBJ(a)
					if a <= 120 then
						call GroupAddUnit(g3, du)
						call QM_Restore_LIFE(spu, du, dt, damage, funcstr, level, b2)
					endif
				else
					call GroupAddUnit(g3, du)
					call QM_Restore_LIFE(spu, du, dt, damage, funcstr, level, b2)
				endif
			endif
		endloop
		call WR7(g4)
		if funcend then
			call WR7(g3)
		endif
	elseif not time_event then
		call WaveDamageEnumUnit(LoadUnitHandle(TABLE_HY, h, 5), du, dt, damage, funcstr, level, b2)
	endif
	if funcend then
		call FlushChildHashtable(TABLE_HY, h)
		call OZ7(t)
		call KillUnit(u)
	endif
	set du = null
	set u = null
	set t = null
	set g = null
	set g2 = null
    set g3 = null
    set g4 = null
	set spu = null
endfunction
function WaveRunningActions takes nothing returns nothing
	local trigger t = GetTriggeringTrigger()
	local integer h = GetHandleId(t)
	local unit u = LoadUnitHandle(TABLE_HY, h, 0)
	local real damage = LoadReal(TABLE_HY, h, 0)
	local real radian = LoadReal(TABLE_HY, h, 3)* bj_DEGTORAD
	local real speed = LoadReal(TABLE_HY, h, 4)
	local real area = LoadReal(TABLE_HY, h, 8)
	local unit spu
	local unit du
	local group g
	local group g2
	local boolean b = LoadBoolean(TABLE_HY, h, 10)
	local boolean funcend = false
	local integer dt = LoadInteger(TABLE_HY, h, 1)
	local string funcstr = LoadStr(TABLE_HY, h, 0)
	local integer level = LoadInteger(TABLE_HY, h, 5)
    local integer id = LoadInteger(TABLE_HY, h, 20)
	local boolean time_event = GetTriggerEventId()== EVENT_GAME_TIMER_EXPIRED
	local boolean b2 = LoadBoolean(TABLE_HY, h,'ally')
	local real x
	local real y
	local real inrange
	local real angle_between
	local real angle
	local real a
	if time_event then
		call SetUnitX(u, CoordinateX50(GetUnitX(u)+ speed * Cos(radian)))
		call SetUnitY(u, CoordinateY50(GetUnitY(u)+ speed * Sin(radian)))
		call SaveInteger(TABLE_HY, h, 12, LoadInteger(TABLE_HY, h, 12)+ 1)
        if BlockUnitPass(u) then
            set funcend = true
            call MM_WAVE_END_PD(id)
		elseif LoadInteger(TABLE_HY, h, 12)> LoadInteger(TABLE_HY, h, 13) then
			set funcend = true
			call SetUnitX(u, LoadReal(TABLE_HY, h, 5))
			call SetUnitY(u, LoadReal(TABLE_HY, h, 6))
		endif
	else
		set du = GetTriggerUnit()
	endif
	if b then
		set g = LoadGroupHandle(TABLE_HY, h, 2)
		set g2 = WS7()
		set U22 = u
		set x = GetUnitX(u)
		set y = GetUnitY(u)
		set inrange = area + LoadReal(TABLE_HY, h, 9) *(GetTriggerEvalCount(t)-1) + 100
		if b2 then
			call GroupEnumUnitsInRange(g2, x, y, inrange, Condition(function Enum_Unit1))
		else
			call GroupEnumUnitsInRange(g2, x, y, inrange, Condition(function Enum_Unit2))
		endif
		call GroupRemoveGroup(g, g2)
		set spu = LoadUnitHandle(TABLE_HY, h, 5)
		set inrange = inrange - 100
		loop
			set du = FirstOfGroup(g2)
		exitwhen du == null
			call GroupRemoveUnit(g2, du)
			if IsUnitInRangeXY(du, x, y, inrange) then
				if GetTriggerEvalCount(t)< 3 then
					set angle = LoadReal(TABLE_HY, h, 3)
					set angle_between = AngleBetweenUnit(u, du)
					if(angle -angle_between <-180.00) then
						set a =(angle -angle_between + 360)
					else
						if(angle -angle_between > 180.00) then
							set a = angle -angle_between -360
						else
							set a = angle -angle_between
						endif
					endif
					set a = RAbsBJ(a)
					if a <= 120 then
						call GroupAddUnit(g, du)
						call WaveDamageEnumUnit(spu, du, dt, damage, funcstr, level, b2)
					endif
				else
					call GroupAddUnit(g, du)
					call WaveDamageEnumUnit(spu, du, dt, damage, funcstr, level, b2)
				endif
			endif
		endloop
		call WR7(g2)
		if funcend then
			call WR7(g)
		endif
	elseif not time_event then
		call WaveDamageEnumUnit(LoadUnitHandle(TABLE_HY, h, 5), du, dt, damage, funcstr, level, b2)
	endif
	if funcend then
		call FlushChildHashtable(TABLE_HY, h)
		call OZ7(t)
		call KillUnit(u)
	endif
	set du = null
	set u = null
	set t = null
	set g = null
	set g2 = null
	set spu = null
endfunction
function Wave takes unit u1, integer id, real damage, real max_distance, real area, real range, real x, real y, real spx, real spy, real missiespeed, integer dt, boolean b, string func, integer level returns nothing
	local trigger t = CreateTrigger()
	local integer h = GetHandleId(t)
	local real angle = AngleBetweenXY(x, y, spx, spy)
	local unit u = CreateUnit(GetOwningPlayer(u1), id, x, y, angle)
	local real interval = 0.02
	local real speed = missiespeed * interval
	local integer max_evalcount = R2I(max_distance / speed)+ 1
    local integer i1=GetUnitTypeId(u1)
    if id=='h0HI' then
        if i1=='Z004' then
            call MHUnit_SetModel(u,"model\\Hero_Slayer_N8S_D_Misslie.mdl",false)
            call DestroyEffect(AddSpecialEffectTarget("model\\Hero_Slayer_N8S_D_MagicMatrix.mdl",u1,"origin"))
        endif
        call SetUnitAnimation(u,"birth")
    endif
    if id=='h0HN' then
        if i1=='Zfir' or i1=='Zgir' then
            call MHUnit_SetModel(u,"model\\Hero_ShadowFiend_N8S_R_Missile_2.mdl",false)
        elseif i1=='Zhir' then
            call MHUnit_SetModel(u,"model\\Hero_ShadowFiend_N4S_R_Missile_2.mdl",false)
        endif
    endif
	//call SetUnitColor(u, PLAYER_COLOR_ORANGE)
	// if LoadBoolean(VV,'wave','ally') then
	// 	call RemoveSavedBoolean(VV,'wave','ally')
	// 	call SaveBoolean(TABLE_HY, h,'ally', true)
	// endif
	//call SetUnitColor(u, PLAYER_COLOR_ORANGE)
	// if LoadBoolean(VV,'wave','ally') then
	// 	call RemoveSavedBoolean(VV,'wave','ally')
	// 	call SaveBoolean(TABLE_HY, h,'ally', true)
	// endif
	//call SetUnitColor(u, PLAYER_COLOR_ORANGE)
	// if LoadBoolean(VV,'wave','ally') then
	// 	call RemoveSavedBoolean(VV,'wave','ally')
	// 	call SaveBoolean(TABLE_HY, h,'ally', true)
	// endif
	call SaveUnitHandle(TABLE_HY, h, 0, u)
	call SaveReal(TABLE_HY, h, 0, damage)
	call SaveUnitHandle(TABLE_HY, h, 5, u1)
	call SaveReal(TABLE_HY, h, 1, max_distance)
	call SaveReal(TABLE_HY, h, 2, range)
	call SaveReal(TABLE_HY, h, 3, angle)
	call SaveReal(TABLE_HY, h, 4, speed)
	call SaveInteger(TABLE_HY, h, 12, 0)
	call SaveInteger(TABLE_HY, h, 13, max_evalcount)
    call SaveInteger(TABLE_HY, h, 20, id)
	call TriggerRegisterTimerEvent(t, interval, true)
	call TriggerRegisterTimerEvent(t, 0, false)
    if id=='h0HJ' and SuijiMode_HasAghanimState(u1) then
        call SaveGroupHandle(TABLE_HY, h, 'A085', WS7())
	    call TriggerAddCondition(t, Condition(function WaveRunningActions_QM))
    else
        call TriggerAddCondition(t, Condition(function WaveRunningActions))
    endif
	call SaveReal(TABLE_HY, h, 8, area)
	call SaveReal(TABLE_HY, h, 9,(range -area)/ I2R(max_evalcount))
	call SaveGroupHandle(TABLE_HY, h, 2, WS7())
	call SaveBoolean(TABLE_HY, h, 10, true)
	call SetUnitX(u, CoordinateX50(x + area / 2. * Cos(angle * bj_DEGTORAD)))
	call SetUnitY(u, CoordinateY50(y + area / 2. * Sin(angle * bj_DEGTORAD)))
	call SaveReal(TABLE_HY, h, 5, CoordinateX50(GetUnitX(u)+ max_distance * Cos(angle * bj_DEGTORAD)))
	call SaveReal(TABLE_HY, h, 6, CoordinateY50(GetUnitY(u)+ max_distance * Sin(angle * bj_DEGTORAD)))
	call SaveInteger(TABLE_HY, h, 1, dt)
	call SaveBoolean(TABLE_HY, h, 0, b)
	if func != null then
		call SaveStr(TABLE_HY, h, 0, func)
		call SaveInteger(TABLE_HY, h, 5, level)
	endif
	set IRR = u
	set u = null
	set t = null
endfunction
function R1R takes nothing returns nothing
	local unit u = Wave_U
	local integer level = Wave_LV
    call Z57(u,'A2VY',1,8,'B0H8')
    call SetUnitAbilityLevel(u,'A2VZ',level)
    call UnitMakeAbilityPermanent(u,true,'A2VZ')
	set u = null
endfunction
function R1S takes nothing returns nothing
    local unit u=GetTriggerUnit()
    local integer level = B287_GetUnitAbilityLevel(u, 'A03F')
    local real x = GetUnitX(u)
    local real y = GetUnitY(u)
    local real length=550
    local real d=level*80+10.
    call Wave(u,'h0HR', d, length, 150, 275, x, y, GetSpellTargetX(), GetSpellTargetY(), 1050, 1, false, "R1R", level)
    set u=null
endfunction
function HYHX2 takes nothing returns boolean
if B287_GetSpellAbilityId()=='A03F' then
    call R1S()
endif
return false
endfunction
function HYHX takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function HYHX2))
set t=null
endfunction
