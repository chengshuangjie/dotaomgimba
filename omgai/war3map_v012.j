function Refresh_Tiaodao takes unit u returns nothing
local integer T8=0
local integer U8=5
local integer Y68
local integer skill
local item it=null
local integer newitem
local player p
loop
exitwhen T8>U8
set it=UnitItemInSlot(u,T8)
set Y68=KZ7(it)
if Y68==TW or Y68==it_sgban or Y68==it_xjsgban or Y68==it_sssgban then
    if Y68==TW then
        set newitem=RW
    elseif Y68==it_sgban then
        set newitem=it_sg
    elseif Y68==it_xjsgban then
        set newitem=it_xjsg
    elseif Y68==it_sssgban then
        set newitem=it_sssg
    endif
    set p=GetItemPlayer(it)
    call RemoveItem(it)
    set HA4=AY8(u,ZU[newitem],T8)
    call SetItemPlayer(HA4,p,false)
    call SetItemUserData(HA4,1)
    set it=UnitItemInSlot(u,T8)
    set skill=MHItem_GetAbilityId(it,1)
    if MHAbility_GetCooldown(u,skill)>0 then
        call MHAbility_SetCooldown(u, skill, 0)
    endif
endif
set T8=T8+1
endloop
set it=null
set p=null
endfunction
function Refresh_Item takes unit u returns nothing
local integer T8=0
local integer U8=5
local integer Y68
local integer skill
local item it=null
loop
exitwhen T8>U8
set it=UnitItemInSlot(u,T8)
set Y68=KZ7(it)
if Y68==D0 or Y68==E0 or Y68==J0 or Y68==N0 or Y68==O0 or Y68==R0 or Y68==J1 or Y68==R5 or Y68==S5 or Y68==it_silingshu3 or Y68==S6 or Y68==it_shuaxin or Y68==DD4 or Y68==F74 then
elseif Y68!=null then
    set skill=MHItem_GetAbilityId(it,1)
    if MHAbility_GetCooldown(u,skill)>0 then
        call MHAbility_SetCooldown(u, skill, 0)
    endif
endif
set T8=T8+1
endloop
call SaveInteger(TABLE_HY, GetHandleId(u), 'echs', 0)
call SaveInteger(TABLE_HY, GetHandleId(u), 'LXCD', 0)
call SaveReal(TABLE_HY, GetHandleId(u), 'link', 0)
call SaveReal(L7,(GetHandleId(u)),(785),(((TimerGetElapsed(W)-10.))*1.))
set it=null
endfunction
function HAG takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local integer skill=(LoadInteger(L7,(I97),(10)))
local integer n=LoadInteger(TABLE_HY, GetHandleId(ZX7), 'CSJY')
call SelectUnitForPlayerSingle(ZX7,GetOwningPlayer(ZX7))
call PanCameraToTimedForPlayer(GetOwningPlayer(ZX7),GetUnitX(ZX7),GetUnitY(ZX7),0)
call OX7(ZX7,"chongsheng")
call AddHeroXP(ZX7,n,true)
call SaveInteger(TABLE_HY, GetHandleId(ZX7), 'CSJY', 0) 
if D9 then
    call XF7(ZX7,'Abun')
    call UnitRemoveAbility(ZX7,'Amov')
    call MJ_USE_SKILL(ZX7,ZX7,'A2Z2',$D0267)
elseif skill=='A4KM' then
    call Refresh_Tiaodao(ZX7)
endif
if GetPlayerController(GetOwningPlayer(ZX7))==MAP_CONTROL_COMPUTER and GetRandomInt(1,2)==1 then
    call AI_ITEM_RENJIA(ZX7)
endif
call FlushChildHashtable(L7,(I97))
call OZ7(t)
set t=null
set ZX7=null
return false
