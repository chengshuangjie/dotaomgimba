call NP7(OB7,"Invoker|OrbThird",WOF)
call NP7(OB7,"Invoker|Wex",VVF)
call NP7(OB7,"Invoker|Quas",VWF)
call NP7(OB7,"Invoker|Exort",VXF)
call VLF(hn,VVF,VWF,VXF)
call VUF(hn)
call VZF(hn)
endfunction
