//---------------------------------------------------------------------------
// 1. 日志级别
//---------------------------------------------------------------------------

    function OMGAILog___LOG_Init takes nothing returns nothing
        // 无操作（时间源由 OMGAICore 提供）
    endfunction

    function OMGAILog___LOG_Now takes nothing returns real
        return OMGAICore_OMGAI_GetGameTime()
    endfunction

    // 供外部初始化（地图初始化时调用一次）
    function OMGAILog_OMGAILog_Init takes nothing returns nothing
        call OMGAILog___LOG_Init()
    endfunction

//---------------------------------------------------------------------------
// 3. 环形缓冲写入
//---------------------------------------------------------------------------

    function OMGAILog___LOG_WriteRaw takes integer lv, string msg returns nothing
        if lv < LOG_LEVEL_PROD then
            return
        endif
        set LOG_MSG[LOG_HEAD] = msg
        set LOG_LV[LOG_HEAD]  = lv
        set LOG_TIME[LOG_HEAD] = OMGAILog___LOG_Now()
        set LOG_HEAD = LOG_HEAD + 1
        if LOG_HEAD >= LOG_RING_SIZE then
            set LOG_HEAD = 0
        endif
        if LOG_COUNT < LOG_RING_SIZE then
            set LOG_COUNT = LOG_COUNT + 1
        else
            set LOG_TAIL = LOG_TAIL + 1
            if LOG_TAIL >= LOG_RING_SIZE then
                set LOG_TAIL = 0
            endif
        endif
    endfunction

//---------------------------------------------------------------------------
// 4. 对外日志 API（分级）
//---------------------------------------------------------------------------

    function OMGAILog_LOG_DEBUG takes string tag, string msg returns nothing
        call OMGAILog___LOG_WriteRaw(LOG_LV_DEBUG, "[" + tag + "] " + msg)
    endfunction

    function OMGAILog_LOG_INFO takes string tag, string msg returns nothing
        call OMGAILog___LOG_WriteRaw(LOG_LV_INFO, "[" + tag + "] " + msg)
    endfunction

    function OMGAILog_LOG_WARN takes string tag, string msg returns nothing
        call OMGAILog___LOG_WriteRaw(LOG_LV_WARN, "[" + tag + "] " + msg)
    endfunction

    function OMGAILog_LOG_ERROR takes string tag, string msg returns nothing
        call OMGAILog___LOG_WriteRaw(LOG_LV_ERROR, "[" + tag + "] " + msg)
        // ERROR 计数（供崩溃转储判断）
        // TODO: 接入 OMGAIGuard 的 ERROR 计数器
    endfunction


//---------------------------------------------------------------------------
// 5. 本地写盘通道
//   5.1 Preload 通道（最通用，无需平台）
//       注意：Preload 写盘需地图允许；文件落在 war3 目录 PreloadData 相关文件
//   5.2 gamecache 通道（跨局保留，崩溃后可回读）
//---------------------------------------------------------------------------

    function OMGAILog_OMGAILog_InitCache takes nothing returns nothing
        if LOG_CACHE == null then
            set LOG_CACHE = InitGameCache("OMGAILogCache")
        endif
    endfunction

    // 把最近 N 条日志转储到 gamecache（崩溃后可回读）
    function OMGAILog_OMGAILog_DumpToCache takes integer count returns nothing
        local integer i = 0
        local integer idx = 0
        local string  line = ""
        if LOG_CACHE == null then
            return
        endif
        // 从最旧读起（TAIL 指向最旧）
        set idx = LOG_TAIL
        loop
            exitwhen i >= count or i >= LOG_COUNT
            set line = R2S(LOG_TIME[idx]) + "|L" + I2S(LOG_LV[idx]) + "|" + LOG_MSG[idx]
            call StoreString(LOG_CACHE, "crash", "log" + I2S(i), line)
            set idx = idx + 1
            if idx >= LOG_RING_SIZE then
                set idx = 0
            endif
            set i = i + 1
        endloop
        call StoreInteger(LOG_CACHE, "crash", "count", i)
    endfunction

//---------------------------------------------------------------------------
// 5.3 V2.1: KK 平台事件上报（DzAPI_Map_SaveServerString，common.j 已声明）
//    仅 KK 平台有效；非 KK 平台调用返回 false 不产生副作用
//---------------------------------------------------------------------------

    function OMGAILog_OMGAILog_ReportToKK takes string key, string evt returns nothing
        call DzAPI_Map_SaveServerString(Player(0), key, evt)
    endfunction

//---------------------------------------------------------------------------
// 6.0 查询（开发期 -log 指令用；须在 DumpCrash 之前定义）
//---------------------------------------------------------------------------

    function OMGAILog_OMGAILog_GetRecent takes integer count returns string
        local integer i = 0
        local integer idx = 0
        local string  out = ""
        set idx = LOG_TAIL
        loop
            exitwhen i >= count or i >= LOG_COUNT
            set out = out + R2S(LOG_TIME[idx]) + "|L" + I2S(LOG_LV[idx]) + "|" + LOG_MSG[idx] + "|"
            set idx = idx + 1
            if idx >= LOG_RING_SIZE then
                set idx = 0
            endif
            set i = i + 1
        endloop
        return out
    endfunction

//---------------------------------------------------------------------------
// 6. 崩溃现场转储（§11.2）
//    1) 最近 32 条日志 → gamecache
//    2) AI 状态快照 → gamecache（由 OMGAIDispatcher/OMGAIEnemyState 填充）
//    3) 关键信息 → KK 存档（OMGAILearn 提供，此处留钩子）
//---------------------------------------------------------------------------

    function OMGAILog_OMGAILog_DumpCrash takes nothing returns nothing
        // 1) 日志转储（gamecache，跨局保留）
        call OMGAILog_OMGAILog_DumpToCache(32)
        // 2) 状态快照钩子
        // TODO: call OMGAIEnemyState_DumpSnapshot()
        // 3) KK 平台崩溃上报（V2.1：key=omgai_crash，value=时间+最近 16 条日志）
        call OMGAILog_OMGAILog_ReportToKK("omgai_crash", "t=" + R2S(OMGAILog___LOG_Now()) + "|" + OMGAILog_OMGAILog_GetRecent(16))
        // 4) 标记全局崩溃标志（OMGAICore GSLOT_CRASH_FLAG）
        call OMGAICore_OMGAI_SaveGlobalInt(GSLOT_CRASH_FLAG, 1)
    endfunction

//---------------------------------------------------------------------------
// 8. 与 OMGAICore 的越界告警钩子对接
//    OMGAICore.OMGAI_ArrGuardWarn 的 TODO 由本库实现：WARN 日志
//    （注意：OMGAICore 与 OMGAILog 互相 require 会成环，故 OMGAICore
//      里保留空实现 + 注释；此处提供可手动接入的桥）
//---------------------------------------------------------------------------

    function OMGAILog_OMGAILog_BridgeArrWarn takes integer idx, string op returns nothing
        call OMGAILog_LOG_WARN("ARRAY", "越界 idx=" + I2S(idx) + " op=" + op)
    endfunction


    function OMGAILog_LOG_FATAL takes string tag, string msg returns nothing
        call OMGAILog___LOG_WriteRaw(LOG_LV_FATAL, "[" + tag + "] " + msg)
        // 触发崩溃转储（§11.2）
        call OMGAILog_OMGAILog_DumpCrash()
    endfunction

//---------------------------------------------------------------------------
// 9. V2.2: 游戏内查日志指令（-omgai_log；不冲突基图 -log/-suiji 指令）
//---------------------------------------------------------------------------

    function OMGAILog___OMGAI_ChatCmdLog takes nothing returns nothing
        local player p = GetTriggerPlayer()
        local string s = StringCase(GetEventPlayerChatString(), false)
        local string out = ""
        if s != "-omgai_log" and s != "-omgai_log " then
            return
        endif
        set out = OMGAILog_OMGAILog_GetRecent(8)
        call DisplayTextToPlayer(p, 0, 0, "OMGAI 最近日志: " + out)
        call DisplayTextToPlayer(p, 0, 0, "OMGAI 崩溃标志: " + I2S(OMGAICore_OMGAI_LoadGlobalInt(GSLOT_CRASH_FLAG)))
    endfunction

    function OMGAILog_OMGAILog_ChatCommandInit takes nothing returns nothing
        local integer i = 0
        local trigger trg = null
        loop
            exitwhen i >= 12
            set trg = CreateTrigger()
            call TriggerRegisterPlayerChatEvent(trg, Player(i), "-omgai_log", true)
            call TriggerAddAction(trg, function OMGAILog___OMGAI_ChatCmdLog)
            set trg = null
            set i = i + 1
        endloop
    endfunction


//library OMGAILog ends
//library OMGAISkillTag:


    // 工具函数：测试 SkillDef.tags 是否包含某标签
    function OMGAISkillTag_HasTag takes integer tags, integer testTag returns boolean
        return not (tags - (tags / testTag) * testTag == 0) // 等价于 (tags & testTag) != 0，vJASS 位运算写法
    endfunction


//library OMGAISkillTag ends
//library OMGAIActionMask:

    function OMGAIActionMask___DistanceBetweenUnits takes unit a, unit b returns real
        local real dx = GetUnitX(a) - GetUnitX(b)
        local real dy = GetUnitY(a) - GetUnitY(b)
        return SquareRoot(dx * dx + dy * dy)
    endfunction

//---------------------------------------------------------------------------
// 1. 技能配表读取（SkillPool schema 槽位，见方案 §4.4）
//    槽 0 targetType / 1 range / 2 orderId / 3 softCD / 4 minMana% / 5 minHp%
//    6 minEnemies / 7 eventMask / 8 skillLevel / 9 isPassive / 10 优先级
//---------------------------------------------------------------------------

    // 从 SkillPool 读技能等级（既有库对接点）
    function OMGAIActionMask_OMGAI_GetSkillLevel takes unit u, integer abilityId returns integer
        // TODO: 对接既有 SkillPool（GetUnitAbilityLevel）
        return GetUnitAbilityLevel(u, abilityId)
    endfunction

    // 从 SkillPool 读 targetType
    function OMGAIActionMask_OMGAI_GetTargetType takes integer abilityId returns integer
        // TODO: 对接既有 SkillPool 注册表
        return TT_UNIT
    endfunction

    // 从 SkillPool 读施法距离
    function OMGAIActionMask_OMGAI_GetCastRange takes integer abilityId returns real
        // TODO: 对接既有 SkillPool 注册表
        return 600.0
    endfunction

    // 从 SkillPool 读软冷却（秒）
    function OMGAIActionMask_OMGAI_GetSoftCD takes integer abilityId returns real
        // TODO: 对接既有 SkillPool 注册表
        return 5.0
    endfunction

    // 从 SkillPool 读最低蓝量百分比（-1 = 不限）
    function OMGAIActionMask_OMGAI_GetMinManaPct takes integer abilityId returns integer
        // TODO: 对接既有 SkillPool 注册表
        return 15
    endfunction

    // 从 SkillPool 读最低血量百分比（-1 = 不限）
    function OMGAIActionMask_OMGAI_GetMinHpPct takes integer abilityId returns integer
        // TODO: 对接既有 SkillPool 注册表
        return -1
    endfunction

    // 从 SkillPool 读最小命中敌人数
    function OMGAIActionMask_OMGAI_GetMinEnemies takes integer abilityId returns integer
        // TODO: 对接既有 SkillPool 注册表
        return -1
    endfunction

//---------------------------------------------------------------------------
// 2. 自维护冷却表（1.27 无 BlzGetUnitAbilityCooldownRemaining，必须自管）
//    结构：主键=单位 hid，二级槽=1000+abilityId 存"冷却就绪时间"
//    注：abilityId 是整数四字符码，槽位用 1000 + Modulo(abilityId, 8000)
//        避免与 AI 状态槽（0..99）冲突
//---------------------------------------------------------------------------

    function OMGAIActionMask___OMGAI_CDSlot takes integer abilityId returns integer
        return 1000 + ModuloInteger(abilityId, 8000)
    endfunction

    function OMGAIActionMask_OMGAI_MarkCooldown takes unit u, integer abilityId, real cd returns nothing
        local integer hid = GetHandleId(u)
        local real now = OMGAICore_OMGAI_GetGameTime()
        call OMGAICore_OMGAI_SaveReal(hid, OMGAIActionMask___OMGAI_CDSlot(abilityId), now + cd)
    endfunction

    function OMGAIActionMask_OMGAI_IsCooldownReady takes unit u, integer abilityId returns boolean
        local integer hid = GetHandleId(u)
        local real now = OMGAICore_OMGAI_GetGameTime()
        return OMGAICore_OMGAI_LoadReal(hid, OMGAIActionMask___OMGAI_CDSlot(abilityId)) <= now
    endfunction

//---------------------------------------------------------------------------
// 3. 动作掩码总入口（坑#13：CD/蓝量不足直接 mask，不参与目标搜索）
//    返回 true = 技能当前可评估/可施放
//---------------------------------------------------------------------------

    function OMGAIActionMask_OMGAI_ActionMaskValid takes unit u, integer abilityId, unit target returns boolean
        local integer hid = GetHandleId(u)
        local integer level = 0
        local integer minMana = 0
        local integer minHp = 0
        local real maxMana = 0.0
        local real maxHp = 0.0

        if u == null then
            return false
        endif
        // 1) 技能等级 > 0（已学习）
        set level = OMGAIActionMask_OMGAI_GetSkillLevel(u, abilityId)
        if level <= 0 then
            return false
        endif
        // 2) CD 检查（自维护冷却表）
        if not OMGAIActionMask_OMGAI_IsCooldownReady(u, abilityId) then
            return false
        endif
        // 3) 蓝量阈值
        set minMana = OMGAIActionMask_OMGAI_GetMinManaPct(abilityId)
        if minMana >= 0 then
            set maxMana = GetUnitState(u, UNIT_STATE_MAX_MANA)
            if maxMana > 0.0 and GetUnitState(u, UNIT_STATE_MANA) < maxMana * I2R(minMana) * 0.01 then
                return false
            endif
        endif
        // 4) 血量阈值
        set minHp = OMGAIActionMask_OMGAI_GetMinHpPct(abilityId)
        if minHp >= 0 then
            set maxHp = GetUnitState(u, UNIT_STATE_MAX_LIFE)
            if maxHp > 0.0 and GetUnitState(u, UNIT_STATE_LIFE) < maxHp * I2R(minHp) * 0.01 then
                return false
            endif
        endif
        // 5) 距离检查（单位目标才检查）
        if target != null then
            if OMGAIActionMask_OMGAI_GetCastRange(abilityId) > 0.0 then
                if OMGAIActionMask___DistanceBetweenUnits(u, target) > OMGAIActionMask_OMGAI_GetCastRange(abilityId) then
                    return false
                endif
            endif
        endif
        // 6) 目标存活
        if target != null and not (not IsUnitType(target, UNIT_TYPE_DEAD) and GetWidgetLife(target) > 0.405) then
            return false
        endif
        // 7) 命令白名单（坑#6 施法锁定）：当前正在施法/引导 → 屏蔽
        if GetUnitCurrentOrder(u) != 0 then
            // 若正在移动/攻击可允许打断；若在施法引导则 false（由 SpellCast 判定）
            // TODO: 更精确的 order 判定
        endif
        return true
    endfunction

