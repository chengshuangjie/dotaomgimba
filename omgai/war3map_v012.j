call XF7(oA,'A0LO')
call SetUnitAbilityLevel(oA,'A0LO',B287_GetUnitAbilityLevel(D8,'A0LN')+GetUnitAbilityLevel(D8,'A4F0'))
call UnitApplyTimedLife(oA,'BTLF',2)
set WI7=null
set oA=null
endfunction
function uN takes unit WI7 returns nothing
local group LQ7=WS7()
local boolexpr hP=Condition(function uM)
