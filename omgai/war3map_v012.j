call R1T(m5,o6,V77)
endfunction
function SuijiMode_DurationMulticastSkillMatches takes integer savedSkill,integer requestedSkill returns boolean
if savedSkill==requestedSkill then
return true
endif
if (savedSkill=='A2XO' and requestedSkill=='A0O8') or (savedSkill=='A0O8' and requestedSkill=='A2XO') then
return true
endif
if (savedSkill=='A4J4' and requestedSkill=='A0Q7') or (savedSkill=='A0Q7' and requestedSkill=='A4J4') then
return true
endif
if (savedSkill=='A0LC' and requestedSkill=='A4CB') or (savedSkill=='A4CB' and requestedSkill=='A0LC') then
return true
endif
if (savedSkill=='A0LH' or savedSkill=='A2Z9' or savedSkill=='A4F3' or savedSkill=='A4F4' or savedSkill=='A4F5' or savedSkill=='A4FU') and (requestedSkill=='A0LH' or requestedSkill=='A2Z9' or requestedSkill=='A4F3' or requestedSkill=='A4F4' or requestedSkill=='A4F5' or requestedSkill=='A4FU') then
return true
endif
return false
endfunction
function SuijiMode_GetDurationMulticastCount takes unit u,integer skill returns integer
local integer h=0
local integer savedSkill=0
local integer count=1
if SUIJI_MODE==false or u==null or GetUnitTypeId(u)==0 then
return 1
endif
set h=GetHandleId(u)
if LoadReal(L7,h,StringHash("SuijiDurationMulticastUntil"))<TimerGetElapsed(W) then
return 1
endif
set savedSkill=LoadInteger(L7,h,StringHash("SuijiDurationMulticastSkill"))
if SuijiMode_DurationMulticastSkillMatches(savedSkill,skill)==false then
return 1
endif
set count=LoadInteger(L7,h,StringHash("SuijiDurationMulticastCount"))
if count<1 then
return 1
endif
return count
endfunction
function SuijiMode_DurationBuffTimer takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer h=GetHandleId(t)
local unit target=LoadUnitHandle(L7,h,0)
local integer buff1=LoadInteger(L7,h,1)
local integer buff2=LoadInteger(L7,h,2)
local real duration=LoadReal(L7,h,3)
local integer tries=LoadInteger(L7,h,4)+1
local boolean applied=false
if target!=null and GetUnitTypeId(target)!=0 then
if buff1!=0 and GetUnitAbilityLevel(target,buff1)>0 then
call MHBuff_SetRemain(target,buff1,duration)
set applied=true
endif
if buff2!=0 and GetUnitAbilityLevel(target,buff2)>0 then
call MHBuff_SetRemain(target,buff2,duration)
set applied=true
endif
endif
if applied or tries>=20 or target==null or GetUnitTypeId(target)==0 then
call FlushChildHashtable(L7,h)
call DestroyTimer(t)
else
call SaveInteger(L7,h,4,tries)
endif
set target=null
set t=null
endfunction
function SuijiMode_ScheduleDurationBuff takes unit target,integer buff1,integer buff2,real duration returns nothing
local timer t=null
local integer h=0
if target==null or GetUnitTypeId(target)==0 or duration<=0. then
return
endif
set t=CreateTimer()
set h=GetHandleId(t)
call SaveUnitHandle(L7,h,0,target)
call SaveInteger(L7,h,1,buff1)
call SaveInteger(L7,h,2,buff2)
call SaveReal(L7,h,3,duration)
call SaveInteger(L7,h,4,0)
call TimerStart(t,.03,true,function SuijiMode_DurationBuffTimer)
set t=null
endfunction
