function MYE takes nothing returns nothing
if IsUnitInGroup(GetEnumUnit(),IQ4)==false then
	if B287_GetUnitAbilityLevel(U22,'A0MS')>0 or ISLABIKE(U22) then
		set TMPU3=U22
		set TMPU4=GetEnumUnit()
		call ExecuteFunc("EXEC_WYSW")
	endif
set vZ=CreateUnit(GetOwningPlayer(IN4),'e00E',GetUnitX(GetEnumUnit()),GetUnitY(GetEnumUnit()),0)
call XF7(vZ,'A17N')
call SetUnitAbilityLevel(vZ,'A17N',R94)
call IssueTargetOrderById(vZ,$D022F,GetEnumUnit())
call SuijiMode_ScheduleDurationBuff(GetEnumUnit(),'B0AQ',0,13.1*SuijiMode_GetDurationMulticastCount(U22,'A173'))
call GroupAddUnit(IQ4,GetEnumUnit())
endif
endfunction
function MZE takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local group g=OF7(OB7,"g")
local unit oA=O77(OB7,"Caster")
local unit WI7=O77(OB7,"Hero")
local integer V77=OM7(OB7,"Level")
local real RK=ON7(OB7,"Angle")
local group LQ7
local real x
local real y
local real MAE
local real MBE
local real MCE=30
local unit M3E
if oA==null or WI7==null or g==null or GetUnitTypeId(oA)==0 or GetUnitTypeId(WI7)==0 then
if g!=null then
call WR7(g)
endif
if oA!=null and GetUnitTypeId(oA)!=0 then
call ShowUnit(oA,false)
call KillUnit(oA)
endif
call NM7(OB7)
call OZ7(t)
set t=null
set g=null
set LQ7=null
set oA=null
set M3E=null
set WI7=null
return false
endif
set R94=V77
if GetTriggerEvalCount(t)>28 or BlockUnitPass(oA) then
call WR7(g)
call NM7(OB7)
call OZ7(t)
call ShowUnit(oA,false)
call KillUnit(oA)
else
set x=GetUnitX(oA)
set y=GetUnitY(oA)
set LQ7=WS7()
set IQ4=g
set IN4=oA
set U22=WI7
set IJ4=V77*70
call GroupEnumUnitsInRange(LQ7,x,y,175,Condition(function BG7))
call ForGroup(LQ7,function MYE)
call WR7(LQ7)
set MAE=X17(x+MCE*Cos(RK*bj_DEGTORAD))
set MBE=X07(y+MCE*Sin(RK*bj_DEGTORAD))
call SetUnitX(oA,MAE)
call SetUnitY(oA,MBE)
if ModuloInteger(GetTriggerEvalCount(t),3)==0 then
set M3E=CreateUnit(GetOwningPlayer(oA),'o01W',MAE,MBE,0)
call KillUnit(M3E)
endif
endif
set t=null
set g=null
set LQ7=null
set oA=null
set M3E=null
set WI7=null
return false
endfunction
function M6E takes nothing returns nothing
local trigger t=null
local integer OB7=0
local group g=null
local unit WI7=GetTriggerUnit()
local location l=null
local real x1=0.
local real y1=0.
local real x2=0.
local real y2=0.
local real RK=0.
local integer V77=0
local unit oA=null
if WI7==null or GetUnitTypeId(WI7)==0 then
set WI7=null
return
endif
set t=CreateTrigger()
set OB7=GetHandleId(t)
set g=WS7()
set l=GetSpellTargetLoc()
set x1=GetUnitX(WI7)
set y1=GetUnitY(WI7)
set x2=GetLocationX(l)
set y2=GetLocationY(l)
set RK=J77(x1,y1,x2,y2)
set V77=B287_GetUnitAbilityLevel(WI7,'A173')
set oA=CreateUnit(GetOwningPlayer(WI7),'h07K',x1,y1,RK)
call Y17(QR,x1,y1)
call NT7(OB7,"Caster",oA)
call NP7(OB7,"Level",V77)
call NB7(OB7,"g",g)
call NQ7(OB7,"Angle",RK)
call NT7(OB7,"Hero",WI7)
call TriggerRegisterTimerEvent(t,.025,true)
call TriggerAddCondition(t,Condition(function MZE))
call RemoveLocation(l)
set t=null
set oA=null
set g=null
set WI7=null
set l=null
endfunction
function MLE takes nothing returns boolean
if B287_GetSpellAbilityId()=='A173' then
call M6E()
endif
return false
endfunction
