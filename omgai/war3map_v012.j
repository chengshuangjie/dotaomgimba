function SOF takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local integer U38=OM7(OB7,"Count")
local unit p5=O77(OB7,"Source")
local integer B07=OM7(OB7,"TargetIndex")
local unit m5=TQ7(B07)
local real SPF=.4
local string tx=OP7(OB7,"tx")
if GetTriggerEventId()!=EVENT_UNIT_DAMAGED then
    set U38=U38+1
    call SNF(U38,p5,m5)
    if U38==1 then
        call LINGXIA(p5,m5)
    endif
    if U38==8 then
        call TP7(B07)
        call NM7(OB7)
        call OZ7(t)
    else
        call NP7(OB7,"Count",U38)
    endif
elseif C677(GetEventDamage())and IsUnitEnemy(GetTriggerUnit(),GetOwningPlayer(GetEventDamageSource()))and IsUnitType(GetEventDamageSource(),UNIT_TYPE_STRUCTURE)==false then
if IsUnitType(GetEventDamageSource(),UNIT_TYPE_HERO) or GetUnitAbilityLevel(GetEventDamageSource(),'A04R')==0 then
call SetUnitState(GetEventDamageSource(),UNIT_STATE_LIFE,GetUnitState(GetEventDamageSource(),UNIT_STATE_LIFE)+GetEventDamage()*SPF)
else
call SetUnitState(M7[GetPlayerId(GetOwningPlayer(GetEventDamageSource()))],UNIT_STATE_LIFE,GetUnitState(M7[GetPlayerId(GetOwningPlayer(GetEventDamageSource()))],UNIT_STATE_LIFE)+GetEventDamage()*SPF)
endif
call DestroyEffect(AddSpecialEffectTarget(tx,GetEventDamageSource(),"origin"))
endif
set t=null
set p5=null
set m5=null
return false
endfunction
function SQF takes nothing returns nothing
local unit p5=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local integer id=GetUnitTypeId(p5)
local string tx
local string tx2
if id=='Z00C' then
    set tx="model\\Hero_Lifestealer_N2S_W_Recover.mdl"
    set tx2="model\\Hero_Lifestealer_N2S_W_Target_2.mdl"
else
    set tx="Abilities\\Spells\\Undead\\VampiricAura\\VampiricAuraTarget.mdl"
    set tx2="tx\\dog\\N'aix_W.mdl"
endif
call SNF(0,p5,m5)
call NP7(OB7,"Count",0)
call NT7(OB7,"Source",p5)
call NP7(OB7,"TargetIndex",TS7(m5))
call NR7(OB7,"tx",tx)
call TriggerRegisterTimerEvent(t,1,true)
call TriggerRegisterTimerEvent(t,.01,false)
call TriggerRegisterUnitEvent(t,m5,EVENT_UNIT_DAMAGED)
call TriggerAddCondition(t,Condition(function SOF))
call DestroyEffect(AddSpecialEffectTarget(tx2,m5,"chest"))
set t=null
set p5=null
set m5=null
endfunction
