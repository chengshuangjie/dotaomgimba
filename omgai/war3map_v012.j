return
endif
set OB7=GetHandleId(ZX7)
set t=LoadTriggerHandle(L7,OB7,StringHash("SuijiReincarnationDeathTrigger"))
if t!=null and OZ7_IsQueued(t)==false then
set t=null
return
endif
set t=CreateTrigger()
set I97=GetHandleId(t)
call TriggerRegisterDeathEvent(t,ZX7)
call TriggerAddCondition(t,Condition(function HBG))
call SaveUnitHandle(L7,I97,2,ZX7)
call SaveTriggerHandle(L7,OB7,StringHash("SuijiReincarnationDeathTrigger"),t)
if D4 then
call SaveTriggerHandle(L7,OB7,'A01Y',t)
endif
set t=null
