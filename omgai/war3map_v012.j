function ADF takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit WI7=O77(OB7,"Hero")
local integer WF8=GetTriggerEvalCount(t)
local real now_life=GetUnitState(WI7,UNIT_STATE_LIFE)
local real now_mana=GetUnitState(WI7,UNIT_STATE_MANA)
local real max_life=GetUnitState(WI7,UNIT_STATE_MAX_LIFE)
local real max_mana=GetUnitState(WI7,UNIT_STATE_MAX_MANA)
local real recover1=50.+max_life*0.05
local real recover2=50.+max_mana*0.05
if WF8>=30 or GetUnitAbilityLevel(WI7,'B01S')==0 or (now_life==max_life and now_mana==max_mana) then
	call UnitRemoveAbility(WI7,'B01S')
	call UnitRemoveAbility(WI7,'B04A')
	call NM7(OB7)
	call OZ7(t)
else
	call SetUnitState(WI7,UNIT_STATE_LIFE,now_life+recover1)
	call SetUnitState(WI7,UNIT_STATE_MANA,now_mana+recover2)
endif
set t=null
set WI7=null
return false
endfunction
//回复
function AEF takes unit WI7,item QU8 returns nothing
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
call TriggerRegisterTimerEvent(t,1.,true)
call TriggerAddCondition(t,Condition(function ADF))
call NT7(OB7,"Hero",WI7)
set t=null
endfunction
function FUO takes unit WI7,item QU8 returns nothing
local integer G0O=R2I((TimerGetElapsed(W))/60)
local integer XXP
local integer hY
local integer Eov=1
local boolean GIO=(LoadBoolean(L7,(GetHandleId(QU8)),(835)))
if B287_GetUnitAbilityLevel(WI7,'A0O3')>0 then
set Eov=2+B287_GetUnitAbilityLevel(WI7,'A0O3')
endif
call DestroyEffect(AddSpecialEffectTarget("UI\\Feedback\\GoldCredit\\GoldCredit.mdl",WI7,"origin"))
if GetItemTypeId(QU8)=='I0Q5' then
set hY=100*Eov
set XXP=0
else
set hY=(50+2*B)*Eov
set XXP=(50+5*B)
endif
if IsUnitType(WI7,UNIT_TYPE_HERO)then
call AddHeroXP(WI7,XXP,true)
endif
call U27(GetOwningPlayer(WI7),hY)
call PlaySoundOnUnitBJ(GOO,100,WI7)
endfunction
function AFF takes unit WI7,item QU8 returns nothing
local unit u=WI7
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local unit BB7=CreateUnit(GetOwningPlayer(u),'e00E',x,y,0)
local unit AGF=CreateUnit(GetOwningPlayer(u),'e00E',x,y,0)
call UnitAddAbility(BB7,'A0GR')
call UnitAddAbility(AGF,'A0GR')
call IssueTargetOrderById(BB7,$D0132,u)
call IssueTargetOrderById(AGF,$D0132,u)
set u=null
set BB7=null
set AGF=null
endfunction
function AHF takes unit WI7,item QU8 returns nothing
if GetItemTypeId(QU8)=='I007' or GetItemTypeId(QU8)=='I006' or GetItemTypeId(QU8)=='I008' or GetItemTypeId(QU8)=='I00K' or GetItemTypeId(QU8)=='I00J' or GetItemTypeId(QU8)=='I0PJ' or GetItemTypeId(QU8)=='I0Q5' then
call FN9(WI7,GetItemTypeId(QU8),false)
endif
if GetItemTypeId(QU8)=='I007' then
call AFF(WI7,QU8)
elseif GetItemTypeId(QU8)=='I00J' then
if GetUnitAbilityLevel(WI7,'B09Y')>0 then
call UnitRemoveAbility(WI7,'B09Y')
call UnitRemoveAbility(WI7,'B01Q')
call DisableTrigger(GetTriggeringTrigger())
call UnitAddItemById(WI7,'I00J')
call EnableTrigger(GetTriggeringTrigger())
endif
elseif GetItemTypeId(QU8)=='I008' then
call AEF(WI7,QU8)
elseif GetItemTypeId(QU8)=='I0PJ' or GetItemTypeId(QU8)=='I0Q5' then
call FUO(WI7,QU8)
endif
endfunction
function AIF takes unit WX7,item D88 returns nothing
local integer XG7
local integer BC7
call UnitRemoveAbility(WX7,'A27S')
call UnitRemoveAbility(WX7,'A27Q')
call UnitRemoveAbility(WX7,'A27R')
call UnitRemoveAbility(WX7,'A27T')
if GetUnitAbilityLevel(WX7,'A28F')>0 then
call UnitRemoveAbility(WX7,'A28F')
call UnitAddAbility(WX7,'A28F')
endif
if GetUnitTypeId(WX7)=='Edem' then
set XG7='A4JH'
elseif GetUnitTypeId(WX7)=='U00F' or GetUnitTypeId(WX7)=='Z00F' then
set XG7='A06D'
elseif GetUnitTypeId(WX7)=='EC77' then
set XG7='A0MM'
elseif GetUnitTypeId(WX7)=='Ogrh' then
set XG7='A0DB'
else
set WX7=null
return
endif
set BC7=GetUnitAbilityLevel(WX7,XG7)
if BC7>0 then
call UnitRemoveAbility(WX7,XG7)
call UnitAddAbility(WX7,XG7)
call SetUnitAbilityLevel(WX7,XG7,BC7)
endif
endfunction
function AJF takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit u=O77(OB7,"Unit")
local integer AKF=OM7(OB7,"itemslot")
local item QU8=UnitItemInSlot(u,AKF)
if QU8!=null and W47(KY7(QU8))==false and GetWidgetLife(QU8)>0 and F_9(QU8)==false then
call SetItemDroppable(QU8,true)
endif
call NM7(OB7)
call OZ7(t)
set t=null
set QU8=null
return false
endfunction
function AMF takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit u=O77(OB7,"Unit")
local integer AKF=OM7(OB7,"itemslot")
local item QU8=UnitItemInSlot(u,AKF)
call NM7(OB7)
call OZ7(t)
if(u!=null and GetUnitTypeId(u)>1 and IsUnitType(u,UNIT_TYPE_DEAD)==false)and(QU8!=null and GetWidgetLife(QU8)>0)then
set t=CreateTrigger()
set OB7=GetHandleId(t)
call SetItemDroppable(QU8,false)
call NP7(OB7,"itemslot",AKF)
call NT7(OB7,"Unit",u)
call TriggerRegisterUnitEvent(t,u,EVENT_UNIT_ISSUED_POINT_ORDER)
call TriggerAddCondition(t,Condition(function AJF))
endif
set QU8=null
set u=null
set t=null
return false
endfunction
function ANF takes nothing returns nothing
local integer AKF
local unit u=GetTriggerUnit()
local trigger t
local integer OB7
local item QU8
if GetIssuedOrderId()==$D0028 then
set AKF=0
elseif GetIssuedOrderId()==$D0029 then
set AKF=1
elseif GetIssuedOrderId()==$D002A then
set AKF=2
elseif GetIssuedOrderId()==$D002B then
set AKF=3
elseif GetIssuedOrderId()==$D002C then
set AKF=4
elseif GetIssuedOrderId()==$D002D then
set AKF=5
endif
set QU8=UnitItemInSlot(u,AKF)
if QU8!=null and GetWidgetLife(QU8)>0 then
set t=CreateTrigger()
set OB7=GetHandleId(t)
call NP7(OB7,"itemslot",AKF)
call NT7(OB7,"Unit",u)
call TriggerRegisterTimerEvent(t,0,false)
call TriggerAddCondition(t,Condition(function AMF))
endif
set QU8=null
set u=null
set t=null
endfunction
function AOF takes nothing returns boolean
if GetIssuedOrderId()==$D0028 or GetIssuedOrderId()==$D0029 or GetIssuedOrderId()==$D002A or GetIssuedOrderId()==$D002B or GetIssuedOrderId()==$D002C or GetIssuedOrderId()==$D002D then
call ANF()
endif
return false
endfunction
function APF takes integer Y68 returns boolean
return Y68!=B5 and Y68!=DI4 and Y68!=EW and Y68!=HW and Y68!=X0
endfunction
//设置物品可否抵押
function AQF takes nothing returns nothing
//if GetTriggerEventId()==EVENT_PLAYER_UNIT_PICKUP_ITEM then
