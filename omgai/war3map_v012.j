function Chat_Delay_Send2 takes nothing returns nothing
	local timer t=GetExpiredTimer()
	local integer OB7=GetHandleId(t)
	local player p=LoadPlayerHandle(L7,OB7,0)
	local integer msgtype=LoadInteger(L7,OB7,10)
	local integer n
	local string VH=""
	if msgtype==StringHash("LianSha") then
		set n=M[GetPlayerId(p)]
		if n==2 then
			set VH="KILL2"
		elseif n==3 then
			set VH="KILL3"
		elseif n==4 then
			set VH="KILL4"		
		elseif n>=5 then
			set VH="KILL5"
		endif
	elseif msgtype==StringHash("ChaoShen") then
		set VH="CHAOSHEN"
	endif
	call Send_Chat_Text(p,Get_Chat_Text(p,VH))
	call RemoveSavedHandle(L7,GetHandleId(p),msgtype)
	call PauseTimer(t)
	call FlushChildHashtable(L7,OB7)
	call DestroyTimer(t)
	set t=null
	set p=null
endfunction
function Chat_Delay_Send takes player p,real d,integer Type returns nothing
	local timer t
	local integer OB7
	local integer msgtype
	local integer O5=GetPlayerId(p)
	if Type==1 then
		set msgtype=StringHash("LianSha")
	elseif Type==2 then
		set msgtype=StringHash("ChaoShen")
	else
		return
	endif
	if Type==1 and M[O5]>=5 then
		if AI_Text_Baozou_Cooldown[O5]<=GetGameTime() then
			set AI_Text_Baozou_Cooldown[O5]=GetGameTime()+10.
		else
			return
		endif
	endif
	if Type==2 then
		if AI_Text_Chaoshen_Cooldown[O5]<=GetGameTime() then
			set AI_Text_Chaoshen_Cooldown[O5]=GetGameTime()+10.
		else
			return
		endif
	endif
	if not HaveSavedHandle(L7,GetHandleId(p),msgtype) then
		set t=CreateTimer()
		set OB7=GetHandleId(t)
		call SaveTimerHandle(L7,GetHandleId(p),msgtype, t)
		call SavePlayerHandle(L7,OB7,0,p)
		call SaveInteger(L7,OB7,10,msgtype)
		call TimerStart(t,5,false,function Chat_Delay_Send2)
	endif
	set t=null
endfunction
function ISHZHS takes unit u returns boolean
return GetUnitAbilityLevel(u,'A4D9')>0
endfunction
function MV7 takes unit S4,integer n5 returns item
local integer D5
local item f5
set D5=0
loop
exitwhen D5>5
set f5=UnitItemInSlot(S4,D5)
if(f5!=null)and(GetItemTypeId(f5)==n5)then
set f5=null
return UnitItemInSlot(S4,D5)
endif
set D5=D5+1
endloop
set f5=null
return null
endfunction
function AI_ITEM_POINT takes unit it,unit m5,integer which returns boolean
local integer O5=GetPlayerId(GetOwningPlayer(it))
local boolean J4=true
if m5!=null then
call DisableTrigger(Q04[O5])
call UnitUseItemPoint(it,MV7(it,which),GetUnitX(m5),GetUnitY(m5))
call EnableTrigger(Q04[O5])
endif
return J4
endfunction
function AI_ITEM_LOCATION takes unit it,location b5,integer which returns boolean
local integer O5=GetPlayerId(GetOwningPlayer(it))
local boolean J4=true
if b5==null then
	return false
endif
if b5!=null then
call DisableTrigger(Q04[O5])
call UnitUseItemPointLoc(it,MV7(it,which),b5)
call EnableTrigger(Q04[O5])
endif
return J4
endfunction
function AI_ITEM_OK takes unit u,string VH returns boolean
    local item it=null
    local integer id
    local integer skill
    if VH=="xueji" then
        set id=ZU[it_xueji]
    elseif VH=="zhzg" then
        set id=ZU[it_zhzg]
    elseif VH=="tiaodao" then
        set id=ZU[RW]
    elseif VH=="datiaodao1" then
        set id=ZU[it_sg]
    elseif VH=="datiaodao2" then
        set id=ZU[it_xjsg]
    elseif VH=="bkb" then
        set id=ZU[D0]
    elseif VH=="tiantang" then
        set id=ZU[R3]
    elseif VH=="sadan" then
        set id=ZU[it_sadan]
    elseif VH=="fls" then
        set id=ZU[it_fls]
    elseif VH=="dayun" then
        set id=ZU[U3]
    elseif VH=="renjia" then
        set id=ZU[AL]
    elseif VH=="darenjia" then
        set id=ZU[it_jjj]
    elseif VH=="dadianchui" then
        set id=ZU[it_dadianchui]
    elseif VH=="dayindao" then
        set id=ZU[RLL]
    elseif VH=="yangdao" then
        set id=ZU[it_yangdao]
    elseif VH=="shj" then
        set id=ZU[it_shj]
    elseif VH=="feixie" then
        set id=ZU[F6]
    elseif VH=="dafeixie" then
        set id=ZU[FF6]
    elseif VH=="sanshi" then
        set id=ZU[E1]
    elseif VH=="xuehou" then
        set id=ZU[it_xh]
    elseif VH=="dachuifeng" then
        set id=ZU[it_fzz]
    elseif VH=="dagen" then
        set id=ZU[N5]
    elseif VH=="xulingdao" then
        set id=ZU[E24]
    endif
    set it=MV7(u,id)
    if it!=null then
        set skill=MHItem_GetAbilityId(it,1)
        set it=null
        return MHAbility_GetCooldown(u,skill)==0
    endif
    set it=null
    return false
endfunction
function AI_SKILL_OK takes unit u,integer skill returns boolean
	return GetUnitAbilityLevel(u,skill)>0 and MHAbility_GetCooldown(u,skill)==0
endfunction
function SpiritBreakerAI_UltimateSkill takes unit u returns integer
if u==null or GetUnitTypeId(u)==0 then
return 0
endif
if B287_GetUnitAbilityLevel(u,'A1D8')>0 then
return 'A1D8'
endif
return 'A0G4'
endfunction
function SpiritBreakerAI_UltimateCooldown takes unit u,integer skill returns real
local integer level=GetUnitAbilityLevel(u,skill)
if level<=0 then
return 0.
elseif skill=='A1D8' then
return 45.-10.*level
endif
return 70.-10.*level
endfunction
function SpiritBreakerAI_UltimateReady takes unit u returns boolean
local integer skill=SpiritBreakerAI_UltimateSkill(u)
if skill==0 or AI_SKILL_OK(u,skill)==false then
return false
endif
return LoadReal(L7,GetHandleId(u),StringHash("SpiritBreakerAI|NetherStrikeUntil"))<=TimerGetElapsed(W)
endfunction
function SpiritBreakerAI_IssueUltimate takes unit u,unit target returns boolean
local integer skill=SpiritBreakerAI_UltimateSkill(u)
local boolean issued=false
if u==null or target==null or GetUnitTypeId(u)==0 or GetUnitTypeId(target)==0 then
return false
endif
if skill==0 or SpiritBreakerAI_UltimateReady(u)==false then
return false
endif
set issued=IssueTargetOrderById(u,$D0118,target)
if issued then
call SaveReal(L7,GetHandleId(u),StringHash("SpiritBreakerAI|NetherStrikeUntil"),TimerGetElapsed(W)+SpiritBreakerAI_UltimateCooldown(u,skill))
endif
return issued
endfunction
function AI_ITEM_RENJIA takes unit it returns boolean
local boolean J4=false
if AI_ITEM_OK(it,"darenjia") then
set TB4=true
set J4=UnitUseItem(it,MV7(it,ZU[it_jjj]))
elseif AI_ITEM_OK(it,"renjia") then
set TB4=true
set J4=UnitUseItem(it,MV7(it,ZU[AL]))  
endif
return J4
endfunction
function Get_Tiaodao takes unit u returns integer
    local integer i
    local item it
    set i=0
    loop
    exitwhen i>5
    set it=UnitItemInSlot(u,i)
    if(it!=null)and(GetItemTypeId(it)==ZU[RW] or GetItemTypeId(it)==ZU[it_sg] or GetItemTypeId(it)==ZU[it_sssg] or GetItemTypeId(it)==ZU[it_xjsg])and(MHAbility_GetCooldown(u,MHItem_GetAbilityId(it,1))==0) then
    set it=null
    return i
    endif
    set i=i+1
    endloop
    set it=null
    return -1
endfunction
function OTO takes nothing returns nothing
	if ZCDTT == false then
		call RegisterUnitAttackEvent("UYYEQ",-1)
		call RegisterUnitAttackEvent("UYYRQ",-2)
		set ZCDTT = true
	endif
endfunction

//预先执行
function OFO takes nothing returns nothing
	if JPGH == false then
		call RegisterUnitAttackEvent("OGO", 0)	//祭品
		set JPGH = true
	endif
	if ZCBJ == false then
		call RegisterUnitAttackEvent("MNBJ_PD",0)  //暴击
		set ZCBJ = true
	endif
	if ZCFL == false then
		call RegisterUnitAttackEvent("MNFL_PD",0)  //分裂
		set ZCFL = true
	endif
	if JGBX == false then
		call RegisterUnitAttackEvent("TPA", 2)   //金箍棒、晕锤、眩晕技能
        call RegisterUnitAttackEvent("ODO" , 2) //大隐刀
		set JGBX = true
	endif
	if JJMX == false then
		call RegisterUnitAttackEvent("ORO", -3)	//减甲装备
		set JJMX = true
	endif
	if WPXX == false then
        call RegisterUnitAttackEvent("OPL", 0)	//物理吸血
        call RegisterUnitAttackEvent("OPM", 1)  //散华、天堂之戟、地狱面首
            set WPXX = true
    endif
endfunction
function XHYZR takes nothing returns nothing
	if BHYZR == false then
		call RegisterUnitAttackEvent("Hyzr", 1)	//回音战刃攻击
		set BHYZR = true
	endif
endfunction
function X7O takes nothing returns nothing
	if DCBV == false then
		call RegisterUnitAttackEvent("X8O", 1)	//雷神之锤、漩涡
		set DCBV = true
	endif
endfunction
function X9O takes nothing returns nothing
	if BDFX == false then
		call RegisterUnitAttackEvent("OVO", 0)	//压制之刃
		set BDFX = true
	endif
endfunction
function OEO takes nothing returns nothing
	if SSPX == false then
		call RegisterUnitAttackEvent("OWO", 0)	//净魂之刃
		set SSPX = true
	endif
endfunction
function OIO takes nothing returns nothing
	if CDTX == false then
		call RegisterUnitAttackEvent("OAO", 3)	//淬毒之珠
		set CDTX = true
	endif
endfunction
function ONO takes nothing returns nothing
	if BYSX == false then
		call RegisterUnitAttackEvent("OBO", 4)	//冰眼
		set BYSX = true
	endif
endfunction
function UnitAddPermanentAbility takes unit tri_u, integer skill returns boolean
	return UnitAddAbility(tri_u, skill) and UnitMakeAbilityPermanent(tri_u, true, skill)
endfunction

function UnitAddPermanentAbilitySetLevel takes unit u, integer id, integer level returns nothing
	if GetUnitAbilityLevel(u, id) == 0 then
		call UnitAddPermanentAbility(u, id)
	endif
	call SetUnitAbilityLevel(u, id, level)
endfunction
//闪烁类技能
function OXX takes integer id returns boolean
	if id =='A0ME' or id =='AEbl' or id =='Abbk' or id =='A01O' or id =='A0FN' or id =='A14O' or id =='A2YR' or id =='A4HR' or id =='A4HS' then
		return true
	elseif id=='A0B8' or id=='A4KW' then
		return true
	endif
		return false
endfunction
function RadianBetweenUnit takes unit a,unit b returns real
	return Atan2(GetUnitY(b) - GetUnitY(a), GetUnitX(b) - GetUnitX(a))
endfunction
function AngleBetweenXY takes real x1, real y1, real x2, real y2 returns real
	return bj_RADTODEG * Atan2(y2 -y1, x2 -x1)
endfunction
function AngleBetweenUnit takes unit a, unit b returns real
	return bj_RADTODEG * Atan2(GetUnitY(b)-GetUnitY(a), GetUnitX(b)-GetUnitX(a))
endfunction
//坐标修正
function CoordinateX50 takes real x returns real
	local real dx = GetRectMinX(bj_mapInitialPlayableArea)+ 50
	if(x < dx) then
		return dx
	endif
	set dx = GetRectMaxX(bj_mapInitialPlayableArea)-50
	if(x > dx) then
		return dx
	endif
	return x
endfunction
function CoordinateY50 takes real y returns real
	local real dy = GetRectMinY(bj_mapInitialPlayableArea)+ 50
	if(y < dy) then
		return dy
	endif
	// set dy = GetRectMaxY(bj_mapInitialPlayableArea)-50
    set dy = 7146
	if(y > dy) then
		return dy
	endif
	return y
endfunction
//创建一个一次性计时器，返回值是计时器的整数地址，需要手动销毁。
function TimerStartSingle takes real timeout, code callback returns integer
	local timer t = CreateTimer()
	local integer h = GetHandleId(t)
	call FlushChildHashtable(TABLE_HY, h)
	call TimerStart(t, timeout, false, callback)
	set t = null
	return h
endfunction
//单位射程
function Unit_Setrange takes unit u, real r returns nothing
	call SetUnitState(u, UNIT_STATE_ATTACK1_RANGE, r)
endfunction
// 技能Id是攻击特效
function IsAttackSpecialEffects takes integer id returns boolean
	return id =='A0DY' or id =='A1WB' or id =='A026' or id =='A2ZJ' or id =='A09V' or id =='A4HO' or id =='AHfa' or id =='A0LZ' or id =='A0OI' or id =='X0OI' or id =='A0QN'
endfunction
function IWX takes integer i returns unit
	call DisableTrigger(EA)
	set EUNIT[i]= CreateUnit(Player(i),'e00E', 0, 0, 0)
	call EnableTrigger(EA)
	return EUNIT[i]
endfunction
function DGBD takes unit ZX7,unit IH7 returns nothing
    if B287_GetUnitAbilityLevel(IH7,'A1E6')>0 and IsUnitInRange(ZX7,IH7,1000) then
        set TMPU3=IH7
        set TMPU4=ZX7
        call ExecuteFunc("EXEC_DGBD")
    endif
endfunction
