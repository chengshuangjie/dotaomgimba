elseif n==2 then
call SetTextTagVelocity(tt,.05,.03)
elseif n==3 then
call SetTextTagVelocity(tt,-.05,-.03)
elseif n==4 then
call SetTextTagVelocity(tt,.05,-.03)
elseif n==5 then
call SetTextTagVelocity(tt,-.03,.05)
elseif n==6 then
call SetTextTagVelocity(tt,.03,.05)
elseif n==7 then
call SetTextTagVelocity(tt,-.03,-.05)
elseif n==8 then
call SetTextTagVelocity(tt,.03,-.05)
endif
call SetTextTagFadepoint(tt,0.5)
call SetTextTagPermanent(tt,false)
call SetTextTagLifespan(tt,Hk)
if IsUnitVisible(HX,GetLocalPlayer())or WG7(GetLocalPlayer())then
