function XEX takes unit u returns boolean
local integer i=GetUnitTypeId(u)
return i=='u00R' or i=='umtw' or i=='e026' or i=='ebal'
endfunction
function LVI takes nothing returns boolean
return (IsUnitEnemy(U22,GetOwningPlayer(GetFilterUnit())) and (GetUnitAbilityLevel(GetFilterUnit(),'A04R')==0 or XEX(GetFilterUnit())) and IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==false and XH7(GetFilterUnit())==false and CHUIFENG(GetFilterUnit())==false)!=null
endfunction
function QPD takes unit WI7,boolean b returns nothing
local group g=WS7()
local integer id=GetUnitTypeId(WI7)
if id=='Zpgh' then
    call DestroyEffect(AddSpecialEffect("model\\Hero_Axe_N9S_X_Source.mdl",GetUnitX(WI7),GetUnitY(WI7)))
elseif id=='Zpgi' then
    call DestroyEffect(AddSpecialEffect("model\\Hero_Axe_N4S_X_Source.mdl",GetUnitX(WI7),GetUnitY(WI7)))
endif
set U22=WI7
call GroupEnumUnitsInRange(g,GetUnitX(WI7),GetUnitY(WI7),300,Condition(function LVI))
call ForGroup(g,function QOD)
call SetUnitAnimation(WI7,"spin")
call ZP7(WI7,.6)
if b==false then
    if GetUnitAbilityLevel(WI7,'A2VW')>0 then
call O37(WI7,"QPD",.75*(.5-.05*B287_GetUnitAbilityLevel(WI7,'A0C6')))
    else
call O37(WI7,"QPD",.5-.05*B287_GetUnitAbilityLevel(WI7,'A0C6'))
    endif
endif
call WR7(g)
set g=null
endfunction
function FJLX takes nothing returns nothing
	if B287_GetUnitAbilityLevel(YXX,'A0C6')> 0 and IsUnitType(WXX, UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(WXX,'A04R')==0 and IsUnitEnemy(WXX, GetOwningPlayer(YXX)) and GetPrdRandom(YXX, 'A0C6', 20) and ISPH(YXX)==false then
        if MV7(YXX,ZU[it_xh])!=null then
            call QPD(YXX,true) 
        elseif OT7(YXX,"QPD")==false then
            call QPD(YXX,false)
        endif 
    elseif B287_GetUnitAbilityLevel(WXX,'A0C6')> 0 and IsUnitType(YXX, UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(YXX,'A04R')==0 and IsUnitEnemy(WXX, GetOwningPlayer(YXX)) and GetPrdRandom(WXX, 'A0C6', 20) and ISPH(WXX)==false and SuijiMode_HasAghanimState(WXX) then
        if MV7(WXX,ZU[it_xh])!=null then
            call QPD(WXX,true)
        elseif OT7(WXX,"QPD")==false then
            call QPD(WXX,false)
        endif
    endif
endfunction
function Is_Use_TD takes unit ZX7,integer i returns boolean
    set i=i-852008
    return GetItemTypeId(UnitItemInSlot(ZX7,i))==ZU[RW] or GetItemTypeId(UnitItemInSlot(ZX7,i))==ZU[it_sg] or GetItemTypeId(UnitItemInSlot(ZX7,i))==ZU[it_sssg] or GetItemTypeId(UnitItemInSlot(ZX7,i))==ZU[it_xjsg]
endfunction
function xC takes nothing returns boolean
return AW7_gai() and GetUnitAbilityLevel(GetFilterUnit(),'B008')==0 and GetUnitAbilityLevel(GetFilterUnit(),'Bcyc')==0
endfunction
