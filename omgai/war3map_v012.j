function LQA takes nothing returns boolean
	local trigger t = GetTriggeringTrigger()
	local integer h = GetHandleId(t)
	local unit WUE =(LoadUnitHandle(TABLE_HY, h, 2))
	local integer CVX =(LoadInteger(TABLE_HY, h, 59))
	call FlushChildHashtable(TABLE_HY, h)
	call OZ7(t)
	call UnitRemoveAbility(WUE, CVX)
	call UnitRemoveAbility(WUE,'B0FJ')
	call UnitRemoveAbility(WUE,'B0FK')
	set t = null
	set WUE = null
	return false
endfunction
function LSA takes nothing returns nothing
	local timer t = GetExpiredTimer()
	local unit u = LoadUnitHandle(TABLE_HY, GetHandleId(t), 0)
	call UnitRemoveAbility(u,'A2GD')
	call UnitRemoveAbility(u,'A2GE')
	call UnitRemoveAbility(u,'A2GF')
	call UnitRemoveAbility(u,'A2GC')
	call UnitRemoveAbility(u,'B0FJ')
	call UnitRemoveAbility(u,'B0FK')
	call FlushChildHashtable(TABLE_HY, GetHandleId(t))
	call DestroyTimer(t)
	set t = null
	set u = null
endfunction
function LTA takes unit u, unit WLE returns nothing
	local timer t = CreateTimer()
	call TimerStart(t, 0.3, false, function LSA)
	call SaveUnitHandle(TABLE_HY, GetHandleId(t), 0, u)
	set t = null
endfunction
function LUA takes unit R8X,unit WLE returns nothing
	local trigger t
	local integer h
	local integer BC7 = GetUnitAbilityLevel(WLE,'A2EY')
	local integer id
	local integer probability = 25
	// if IsUnitType(R8X, UNIT_TYPE_HERO) then
	// 	set probability = 35
	// endif
	// if IsUnitType(R8X, UNIT_TYPE_HERO) then
	// 	set probability = 35
	// endif
	// if IsUnitType(R8X, UNIT_TYPE_HERO) then
	// 	set probability = 35
	// endif
	if GetPrdRandom(WLE,'A2EY', probability) then
        if GetUnitAbilityLevel(WLE,'A2VW')>0 then
            call O37(WLE,"4316",.75*(3.2-0.6*BC7))
        else
            call O37(WLE,"4316",3.2-0.6*BC7)
        endif
		// call YDWESetUnitAbilityState(WLE,'QP1O', 1, 3.31 - BC7 * 0.6)
		if BC7 == 1 then
			set id ='A2GD'
		elseif BC7 == 2 then
			set id ='A2GE'
		elseif BC7 == 3 then
			set id ='A2GF'
		elseif BC7 == 4 then
			set id ='A2GC'
		endif
		call XF7(WLE, id)
		call SetPlayerAbilityAvailable(GetOwningPlayer(WLE), id, false)
		set t = CreateTrigger()
		set h = GetHandleId(t)
		call TriggerRegisterDeathEvent(t, WLE)
		call TriggerRegisterTimerEvent(t, 1., false)
		call TriggerAddCondition(t, Condition(function LQA))
		call SaveUnitHandle(TABLE_HY, h, 2, WLE)
		call SaveInteger(TABLE_HY, h, 59, id)
		set t = null
	endif
endfunction
function TDA takes nothing returns nothing
	if GetUnitAbilityLevel(YXX,'A2EY')> 0 and OT7(YXX,"4316")==false and IsUnitEnemy(YXX, GetOwningPlayer(WXX)) and ISPH(YXX)==false then
		call LUA(WXX,YXX)
	endif
endfunction
function SFA takes nothing returns nothing
	if LoadInteger(TABLE_HY, EOO, 120)> 0 and(GetUnitAbilityLevel(WXX,'A2GD')> 0 or GetUnitAbilityLevel(WXX,'A2GE')> 0 or GetUnitAbilityLevel(WXX,'A2GF')> 0 or GetUnitAbilityLevel(WXX,'A2GC')> 0) then
		call SaveInteger(TABLE_HY, EOO, 120, LoadInteger(TABLE_HY, EOO, 120)-1)
		call LTA(WXX, YXX)
	endif
endfunction
function SGA takes nothing returns nothing
	call SaveBoolean(TABLE_HY, EOO, 120, GetUnitAbilityLevel(WXX,'B0FJ')> 0)
	if GetUnitAbilityLevel(WXX,'B0FJ')> 0 then
		call SaveInteger(TABLE_HY, EOO, 120, LoadInteger(TABLE_HY, EOO, 120)+ 1)
	endif
endfunction
//决斗
function Y1G takes unit ZX7,integer BC7,unit IH7,boolean b returns nothing
local integer I97=GetHandleId(ZX7)
local integer Y0G=(LoadInteger(L7,(I97),(739)))
local integer O5=GetPlayerId(GetOwningPlayer(ZX7))
if IsUnitType(IH7,UNIT_TYPE_HERO) then
set JTJD[O5]=JTJD[O5]+8+4*BC7
set Y0G=Y0G+8+4*BC7
call SaveInteger(L7,(I97),(739),(Y0G))
if SPEPLAYER[GetPlayerId(GetOwningPlayer(ZX7))]==1 and ISLABIKE(ZX7) then
    call YW7("我才是军团！",5,ZX7,.03,$FF,$FF,0,$FF)
else
    call YW7(GetUnitName(ZX7)+" Winner!!",5,ZX7,.03,$FF,$FF,0,$FF)
endif
call YLG(ZX7,Y0G)
if IS_AI(ZX7) and IS_HUMAN(IH7) then
	if b then
		call Send_Chat_Text(GetOwningPlayer(ZX7),Get_Skill_Text(GetOwningPlayer(ZX7),"JueDouWin"))
	else
		call Send_Chat_Text(GetOwningPlayer(ZX7),Get_Skill_Text(GetOwningPlayer(ZX7),"JueDouLose"))
	endif
endif
endif
endfunction
function Y2G takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local unit IH7=(LoadUnitHandle(L7,(I97),(17)))
local integer BC7=(LoadInteger(L7,(I97),(5)))
local integer id=(LoadInteger(L7,(I97),(100)))
local integer HaveA=(LoadInteger(L7,(I97),(10)))
local real VM8=(LoadReal(L7,(I97),(442)))
local real d=(LoadReal(L7,(I97),(400)))
local unit BB7
if GetTriggerEvalCount(t)==1 then
set BB7=CreateUnit(GetOwningPlayer(IH7),'e00E',GetUnitX(IH7),GetUnitY(IH7),0)
call UnitAddAbility(BB7,'A2G5')
    call IssueTargetOrderById(BB7,$D0267,IH7)
    if HaveA==0 then
set BB7=CreateUnit(GetOwningPlayer(ZX7),'e00E',GetUnitX(ZX7),GetUnitY(ZX7),0)
call UnitAddAbility(BB7,'A2G5')
        call IssueTargetOrderById(BB7,$D0267,ZX7)
    endif
    call LINGXIA(ZX7,IH7)
    set BB7=null
endif
if GetTriggerEventId()==EVENT_WIDGET_DEATH or VM8<(TimerGetElapsed(W)) or Ma(ZX7,IH7)>2000 then
if GetTriggerEventId()==EVENT_WIDGET_DEATH then
if GetTriggerUnit()==ZX7 then
call Y1G(IH7,BC7,GetTriggerUnit(),false)
else
call Y1G(ZX7,BC7,GetTriggerUnit(),true)
endif
endif
call UnitRemoveAbility(ZX7,'B0FG')
call UnitRemoveAbility(IH7,'B0FG')
call DestroyEffect((LoadEffectHandle(L7,(I97),($AF))))
call DestroyEffect((LoadEffectHandle(L7,(I97),($B0))))
if GetPlayerController(GetOwningPlayer(ZX7))==MAP_CONTROL_COMPUTER then
    set JTJDING[GetPlayerId(GetOwningPlayer(ZX7))]=0
    set h4[GetPlayerId(GetOwningPlayer(ZX7))]=IH7
endif
if GetPlayerController(GetOwningPlayer(IH7))==MAP_CONTROL_COMPUTER then
    set JTJDING[GetPlayerId(GetOwningPlayer(IH7))]=0
    set h4[GetPlayerId(GetOwningPlayer(IH7))]=ZX7
endif
call FlushChildHashtable(L7,(I97))
call OZ7(t)
call SetUnitPathing(ZX7,true)
call SetUnitPathing(IH7,true)
elseif GetIssuedOrderId()!=$D0005 then
call SetUnitPathing(ZX7,false)
call SetUnitPathing(IH7,false)
call DisableTrigger(t)



if GetTriggerUnit()==ZX7 and HaveA>0 then
//if B287_GetSpellAbilityId()=='A2JB' or B287_GetSpellAbilityId()=='A2J2' or B287_GetSpellAbilityId()=='A27F' or B287_GetSpellAbilityId()=='A27G' or B287_GetSpellAbilityId()=='A27X' or B287_GetSpellAbilityId()=='A27H' or B287_GetSpellAbilityId()=='A2TZ' then
if B287_GetSpellAbilityId()=='A2JB' or B287_GetSpellAbilityId()=='A2J2' or (GetTriggerEventId()==EVENT_UNIT_SPELL_CAST and (id=='E02X' or id=='Z02X') )then
call SaveReal(L7,(I97),(400),(((TimerGetElapsed(W))+.3)*1.))
endif
elseif d<(TimerGetElapsed(W)) then
call IssueTargetOrderById(ZX7,$D000F,IH7)
endif


call IssueTargetOrderById(IH7,$D000F,ZX7)
call EnableTrigger(t)
endif
set t=null
set ZX7=null
set IH7=null
return false
endfunction
function Y_G takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local unit IH7=GetSpellTargetUnit()
local integer id=0
local integer BC7=0
local trigger t=null
local integer I97=0
local boolean HaveA=false
local integer suijiDuelHandle=0
if ZX7==null or IH7==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 then
set ZX7=null
set IH7=null
return
endif
set id=GetUnitTypeId(ZX7)
set BC7=SuijiMode_GetPairCastLevel(ZX7,B287_GetSpellAbilityId(),'A2CI','A2SB')
set HaveA=SuijiMode_HasAghanimState(ZX7)
if SUIJI_MODE then
set suijiDuelHandle=GetHandleId(ZX7)
if LoadReal(L7,suijiDuelHandle,StringHash("SuijiDuelBlockUntil"))>TimerGetElapsed(W) then
set ZX7=null
set IH7=null
return
endif
call SaveReal(L7,suijiDuelHandle,StringHash("SuijiDuelBlockUntil"),TimerGetElapsed(W)+.60)
endif
call SuijiMode_StartPairCooldownSync(ZX7,B287_GetSpellAbilityId(),'A2CI','A2SB',"SuijiDuelCooldown",50.,50.,50.,50.,50.,50.)
call SetUnitPathing(ZX7,false)
call SetUnitPathing(IH7,false)
call IssueTargetOrderById(ZX7,$D000F,IH7)
call IssueTargetOrderById(IH7,$D000F,ZX7)
set t=CreateTrigger()
set I97=GetHandleId(t)
call SaveEffectHandle(L7,(I97),($AF),(AddSpecialEffectTarget("war3mapImported\\DuelFX.mdx",ZX7,"overhead")))
call SaveEffectHandle(L7,(I97),($B0),(AddSpecialEffectTarget("war3mapImported\\DuelFX.mdx",IH7,"overhead")))
call SaveUnitHandle(L7,(I97),(2),(ZX7))
call SaveUnitHandle(L7,(I97),(17),(IH7))
call SaveInteger(L7,(I97),(5),(BC7))
call SaveInteger(L7,(I97),(100),(id))
call SaveReal(L7,(I97),(400),(((TimerGetElapsed(W)))*1.))
if HaveA then
call SaveReal(L7,(I97),(442),(((TimerGetElapsed(W))+9999999)*1.))
call SaveInteger(L7,(I97),(10),(1))
else
call SaveReal(L7,(I97),(442),(((TimerGetElapsed(W))+0.75*BC7+3.25)*1.))
endif
if GetPlayerController(GetOwningPlayer(ZX7))==MAP_CONTROL_COMPUTER then
    set JTJDING[GetPlayerId(GetOwningPlayer(ZX7))]=1
endif
if GetPlayerController(GetOwningPlayer(IH7))==MAP_CONTROL_COMPUTER then
    set JTJDING[GetPlayerId(GetOwningPlayer(IH7))]=1
endif
call TriggerAddCondition(t,Condition(function Y2G))
call TriggerRegisterTimerEvent(t,.05,true)
call TriggerRegisterTimerEvent(t,.01,false)
call TriggerRegisterDeathEvent(t,ZX7)
call TriggerRegisterDeathEvent(t,IH7)
call TriggerRegisterUnitEvent(t,IH7,EVENT_UNIT_ISSUED_TARGET_ORDER)
call TriggerRegisterUnitEvent(t,IH7,EVENT_UNIT_ISSUED_POINT_ORDER)
call TriggerRegisterUnitEvent(t,IH7,EVENT_UNIT_ISSUED_ORDER)
call TriggerRegisterUnitEvent(t,ZX7,EVENT_UNIT_ISSUED_TARGET_ORDER)
call TriggerRegisterUnitEvent(t,ZX7,EVENT_UNIT_ISSUED_POINT_ORDER)
call TriggerRegisterUnitEvent(t,ZX7,EVENT_UNIT_ISSUED_ORDER)
call TriggerRegisterUnitEvent(t,ZX7,EVENT_UNIT_SPELL_CAST)
set ZX7=null
set IH7=null
set t=null
endfunction
