function KX9 takes nothing returns nothing
call SetPlayerAbilityAvailable(GetOwningPlayer(B2),'A147',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(B2),'A148',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(B2),'A11U',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(B2),'A149',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(C2),'A147',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(C2),'A148',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(C2),'A11U',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(C2),'A149',false)
endfunction
function IQG takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local integer T_7=GetHandleId(t)
local unit WX7=O77(T_7,"Hero")
local real IRG=KQ7()
local integer BC7=0
local real ISG=.0
local boolean ITG=false
local integer BC77=4
if WX7==null then
call NM7(T_7)
call OZ7(t)
set t=null
set WX7=null
return
endif
set BC7=B287_GetUnitAbilityLevel(WX7,'A13T')
set ISG=ON7(GetHandleId(WX7),"WaterSword|LastUsed")
set ITG=OO7(GetHandleId(WX7),"WaterSword|Active")
if BC7<=0 then
call NS7(GetHandleId(WX7),"WaterSword|Active",false)
call NS7(GetHandleId(WX7),"KunkkaTidebringerInit",false)
call UnitRemoveAbility(WX7,'A11O')
call UnitRemoveAbility(WX7,'A11R')
call UnitRemoveAbility(WX7,'A147')
call UnitRemoveAbility(WX7,'A148')
call UnitRemoveAbility(WX7,'A11U')
call UnitRemoveAbility(WX7,'A149')
call NM7(T_7)
call OZ7(t)
set t=null
set WX7=null
return
endif
if GetUnitAbilityLevel(WX7,'A2VW')>0 then
set BC77=3
endif
if IRG-ISG>BC77 and ITG==false and UnitAlive(WX7) and XH7(WX7)==false and ISPH(WX7)==false then
call NS7(GetHandleId(WX7),"WaterSword|Active",true)
call UnitAddAbility(WX7,'A11O')
call SetUnitAbilityLevel(WX7,'A11O',BC7)
call UnitAddAbility(WX7,'A11R')
if BC7==1 then
call XF7(WX7,'A147')
elseif BC7==2 then
call XF7(WX7,'A148')
elseif BC7==3 then
call XF7(WX7,'A11U')
elseif BC7==4 then
call XF7(WX7,'A149')
endif
call SetPlayerAbilityAvailable(GetOwningPlayer(WX7),'A147',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(WX7),'A148',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(WX7),'A11U',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(WX7),'A149',false)
elseif ITG==false then
call UnitRemoveAbility(WX7,'A11O')
call UnitRemoveAbility(WX7,'A11R')
call UnitRemoveAbility(WX7,'A147')
call UnitRemoveAbility(WX7,'A148')
call UnitRemoveAbility(WX7,'A11U')
call UnitRemoveAbility(WX7,'A149')
endif
set t=null
set WX7=null
endfunction
function IUG takes nothing returns boolean
