function MBF takes unit it returns integer
local integer kt=B287_GetUnitAbilityLevel(it,'A0DH')
local integer MCF
if(kt<1)then
set kt=B287_GetUnitAbilityLevel(it,'A1OB')
endif
if(kt>0)then
set hr=it
set MCF=MP7(500.,it,Condition(function MAF))-1
if(MCF<=2)then
return 0
endif
return $8C+(50*kt)+((25+($A*kt))*MCF)
endif
return 0
endfunction
