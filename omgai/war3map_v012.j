local integer VWF=0
local integer VXF=0
set WMF=WNF
set WNF=WOF
set WOF=WKF
if WMF=='A21X' then
set VVF=VVF+1
elseif WMF=='A21W' then
set VWF=VWF+1
elseif WMF=='A21V' then
set VXF=VXF+1
endif
if WNF=='A21X' then
set VVF=VVF+1
elseif WNF=='A21W' then
set VWF=VWF+1
elseif WNF=='A21V' then
set VXF=VXF+1
endif
if WOF=='A21X' then
set VVF=VVF+1
elseif WOF=='A21W' then
set VWF=VWF+1
elseif WOF=='A21V' then
set VXF=VXF+1
endif
call NP7(OB7,"Invoker|OrbFirst",WMF)
