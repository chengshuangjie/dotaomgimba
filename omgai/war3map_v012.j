//视野马甲
function CH7 takes unit ZX7 returns integer
local integer U57=GetUnitTypeId(ZX7)
local integer CI7
if GetUnitAbilityLevel(ZX7,'A2Q3')>0 then
set CI7='o11P'
else
set CI7='o01P'
endif
if U57=='E005' or U57=='Z005' or U57=='Z105' or U57=='Z205' then
set CI7='o01O'
endif
return CI7
endfunction
function CJ7 takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local unit BB7=(LoadUnitHandle(L7,(I97),(19)))
local integer O5=GetPlayerId(GetOwningPlayer(ZX7))
local integer id=GetUnitTypeId(ZX7)
if GetTriggerEventId()==EVENT_UNIT_DEATH or ZX7==null then
call KillUnit(BB7)
call FlushChildHashtable(L7,(I97))
call OZ7(t)
elseif GetTriggerEventId()==EVENT_UNIT_PICKUP_ITEM and CHIYY[O5]==0 and (id!='E005' and id!='Z005' and id!='Z105' and id!='Z205') then
if GetItemTypeId(GetManipulatedItem())==ZU[GC] then
call KillUnit(BB7)
set BB7=CreateUnit(GetOwningPlayer(ZX7),CH7_2(ZX7,true),GetUnitX(ZX7),GetUnitY(ZX7),0)
call SaveUnitHandle(L7,(I97),(19),(BB7))
endif
elseif GetTriggerEventId()==EVENT_UNIT_DROP_ITEM and CHIYY[O5]==0 and (id!='E005' and id!='Z005' and id!='Z105' and id!='Z205') then
if GetItemTypeId(GetManipulatedItem())==ZU[GC] then
call KillUnit(BB7)
set BB7=CreateUnit(GetOwningPlayer(ZX7),CH7_2(ZX7,false),GetUnitX(ZX7),GetUnitY(ZX7),0)
call SaveUnitHandle(L7,(I97),(19),(BB7))
endif
else
call SetUnitX(BB7,GetUnitX(ZX7))
call SetUnitY(BB7,GetUnitY(ZX7))
endif
set t=null
set ZX7=null
set BB7=null
return false
endfunction
