set t=null
set ZX7=null
endfunction
function RYD takes nothing returns boolean
if B287_GetLearnedSkill()=='A0BG' and IsUnitIllusion(GetTriggerUnit())==false then
call RXD(GetTriggerUnit(),false)
endif
if D4 and B287_GetLearnedSkill()=='A0BG' and B287_GetUnitAbilityLevel(GetTriggerUnit(),'A0BG')==1 and IsUnitIllusion(GetTriggerUnit())==false then
    call XXZZW()
endif
return false
