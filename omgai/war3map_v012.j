    set x=GetUnitX(it)+(450+B287_GetUnitAbilityLevel(it,'A2W7'))*Cos(RadianBetweenUnit(it,GetQSMJ(it)))
    set y=GetUnitY(it)+(450+B287_GetUnitAbilityLevel(it,'A2W7'))*Sin(RadianBetweenUnit(it,GetQSMJ(it)))
    set J4=IssuePointOrderById(it,$D00F9,x,y)
endif
if(not J4)and((GetUnitLifePercent(it)<60)or(ME7(it))or(GetUnitMoveSpeed(it)<150)or(b>0))then
if(not J4)and(MR7(it,ZU[DI4])) and i1!='Ntin' then
