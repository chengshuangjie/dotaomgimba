set JOF=Bz
loop
call J_7(.5)
exitwhen((GetUnitCurrentOrder(j5)!=$D0073)or(IsUnitDeadBJ(j5)))
endloop
call MHUnit_EnableControl(j5)
set j5=null
set pl=null
endfunction
