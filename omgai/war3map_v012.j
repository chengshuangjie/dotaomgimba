endif
set BB7=CreateUnit(suijiPitMaliceDummyOwner,'e00E',GetUnitX(GetEnumUnit()),GetUnitY(GetEnumUnit()),0)
call UnitApplyTimedLife(BB7,'BTLF',1.)
call XF7(BB7,skill)
call SetUnitAbilityLevel(BB7,skill,suijiPitMaliceLevel)
call IssueTargetOrderById(BB7,$D008A,GetEnumUnit())
call B67(ZS4,GetEnumUnit(),16,100+0*suijiPitMaliceLevel)
endif
set BB7=null
set suijiPitMaliceDummyOwner=null
endfunction
function L_D takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local integer i
local group g=OF7(OB7,"g")
local real x=ON7(OB7,"x")
local real y=ON7(OB7,"y")
local group D4E=WS7()
local unit S79=O77(OB7,"UnitVar")
local boolean suijiDrainA0RAStopNow=OO7(OB7,"SuijiDrainA0RAStop")
if suijiDrainA0RAStopNow==false then
set IN4=S79
set ZS4=S79
call GroupEnumUnitsInRange(D4E,x,y,300,Condition(function AJ7_gai))
set IQ4=g
call ForGroup(D4E,function L2D)
endif
call WR7(D4E)
if suijiDrainA0RAStopNow or GetTriggerEvalCount(t)>ZQ4*$A then
set i=1
loop
exitwhen i>16
call DestroyEffect(OG7(OB7,"Effect"+I2S(i)))
set i=i+1
endloop
call WR7(g)
if S79!=null then
call RemoveSavedHandle(L7,GetHandleId(S79),StringHash("SuijiDrainA0RATrigger"))
endif
call NM7(OB7)
call OZ7(t)
endif
set t=null
set g=null
set D4E=null
set S79=null
return false
endfunction
function D7E takes nothing returns nothing
local integer i=1
local location l=GetSpellTargetLoc()
local real D8E=GetLocationX(l)
local real D9E=GetLocationY(l)
local real x
local real y
local integer DDE=16
local string fx
local trigger t=CreateTrigger()
local integer I97=GetHandleId(t)
local group g=WS7()
local unit u=GetTriggerUnit()
local integer id=GetUnitTypeId(u)
local integer suijiDrainA0RACasterHandle=GetHandleId(u)
local trigger suijiDrainA0RAOldTrigger=null
if id=='N10R' then
    set fx="model\\Hero_PitLord_N1S_T_Stone.mdl"
elseif id=='N20R' then
    set fx="model\\Hero_PitLord_N2S_T_Stone.mdl"
elseif id=='N30R' then
    set fx="model\\Hero_PitLord_N2S_T_Stone.mdl"
else
    set fx="Abilities\\Spells\\Undead\\Graveyard\\GraveMarker.mdl"
endif
call Y17(WN,D8E,D9E)
call TriggerRegisterTimerEvent(t,.1,true)
call TriggerAddCondition(t,Condition(function L_D))
call NB7(I97,"g",g)
call NT7(I97,"UnitVar",GetTriggerUnit())
if SUIJI_MODE and u!=null and LoadBoolean(L7,suijiDrainA0RACasterHandle,StringHash("SuijiDone")) then
set suijiDrainA0RAOldTrigger=LoadTriggerHandle(L7,suijiDrainA0RACasterHandle,StringHash("SuijiDrainA0RATrigger"))
if suijiDrainA0RAOldTrigger!=null then
call SaveBoolean(L7,GetHandleId(suijiDrainA0RAOldTrigger),StringHash("SuijiDrainA0RAStop"),true)
call TriggerEvaluate(suijiDrainA0RAOldTrigger)
endif
call SaveTriggerHandle(L7,suijiDrainA0RACasterHandle,StringHash("SuijiDrainA0RATrigger"),t)
endif
call NQ7(I97,"x",D8E)
call NQ7(I97,"y",D9E)
loop
exitwhen i>DDE
set x=D8E+ZR4*Cos(i*360/DDE*bj_DEGTORAD)
set y=D9E+ZR4*Sin(i*360/DDE*bj_DEGTORAD)
call NU7(I97,"Effect"+I2S(i),AddSpecialEffect(fx,x,y))
if i==1 or i==5 or i==9 or i==$D then
set x=D8E+275*Cos(i*360/DDE*bj_DEGTORAD)
set y=D9E+275*Sin(i*360/DDE*bj_DEGTORAD)
endif
set i=i+1
endloop
call RemoveLocation(l)
set l=null
set t=null
set g=null
set u=null
set suijiDrainA0RAOldTrigger=null
endfunction
