call K29()
set u=null
set p=null
endfunction
///////////////////////////一键购买
function E4O takes unit u returns nothing
	local integer i = 0
	local item it
	local integer TME = GetPlayerId(GetOwningPlayer(u))
	local region r = CreateRegion()
	local boolean b = KW7(u) or GetUnitTypeId(u)=='ncop'
    local string name
	if TV7(GetOwningPlayer(u)) then
		call RegionAddRect(r, WAA)
	else
		call RegionAddRect(r, YAA)
	endif



	loop
	exitwhen i > 5
		set it = UnitItemInSlot(u, i)
		if it != null then
			set it = UnitRemoveItemFromSlot(u, i)
			call SetItemPosition(it,GetUnitX(u),GetUnitY(u))
			if b == false then
                set name=GetItemName(it)
                set name=MHString_Sub(name , 0 , MHString_Find(name , "|n" , 0))
				call DisplayTimedTextToPlayer(GetOwningPlayer(u), 0, 0, 7, "|c00ffff00" + name+ "|r 已被放置在你的能量圈中")
			endif
			if(GetUnitTypeId(u)=='ncop' or IsUnitInRegion(r, u)) and IsPlayerAlly(GetItemPlayer(it), GetOwningPlayer(u)) then //判断购买物品的单位是能量圈或者马甲单位在矩形区域中
				set TME = GetPlayerId(GetItemPlayer(it))
				call SetItemPosition(it, KV4[TME], KW4[TME])
			endif
		endif
		set i = i + 1
	endloop
	call RemoveRegion(r)
	set it = null
	set r = null
endfunction
function E5O takes unit u, integer id returns nothing
	local player p = GetOwningPlayer(u)
	local real x=GetUnitX(u)
	local real y=GetUnitY(u)
    local integer index=Y38(id)
    local integer RTF=0
	local integer O5=GetPlayerId(p)
    if index==188 then
        set RTF=6
    elseif index==108 then
        set RTF=8
    endif
	call Y0F(p, u, GetSellingUnit(), index, x, y, RTF, 0)
	call Record_Buy_Item(p,O5,id)
	set p = null
endfunction
function E6O takes unit u returns unit
	local unit d = null
	local player p = GetOwningPlayer(u)
	if HaveSavedHandle(TABLE_K, GetHandleId(p),'COUR'+ 1)== false or not UnitAlive(LoadUnitHandle(TABLE_K, GetHandleId(p),'COUR'+ 1)) then
		set d = CreateUnit(p,'e00E', GetUnitX(KU4[GetPlayerId(p)]), GetUnitY(KU4[GetPlayerId(p)]), 0)
		call XF7(d,'AInv')
		call SaveUnitHandle(TABLE_K, GetHandleId(p),'COUR'+ 1, d)
		call UnitPauseTimedLife(d, true)
	elseif HaveSavedHandle(TABLE_K, GetHandleId(p),'COUR'+ 1) then
		set d = LoadUnitHandle(TABLE_K, GetHandleId(p),'COUR'+ 1)
		if p != GetOwningPlayer(d) then
			call SetUnitOwner(d, p, true)
			call SetUnitPosition(d, GetUnitX(KU4[GetPlayerId(p)]), GetUnitY(KU4[GetPlayerId(p)]))
		endif     
	endif
	set d = null
	set p = null
	return LoadUnitHandle(TABLE_K, GetHandleId(GetOwningPlayer(u)),'COUR'+ 1)
endfunction
