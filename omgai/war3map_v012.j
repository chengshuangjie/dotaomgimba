if B287_GetSpellAbilityId()=='A04P' or B287_GetSpellAbilityId()=='A1AU' then
    if WF7(GetSpellTargetUnit()) then
        call KR7(GetTriggerUnit())
call X37(GetOwningPlayer(GetTriggerUnit()),GetObjectName('n0LR'))
    else
        call E0G()
    endif
endif
