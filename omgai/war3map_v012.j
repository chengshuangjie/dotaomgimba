function SJD takes unit WI7,boolean UA9 returns nothing
local integer sr=0
local integer h=0
local trigger t
if WI7==null or GetUnitTypeId(WI7)==0 then
return
endif
set sr=B287_GetUnitAbilityLevel(WI7,'A0IF')
set h=GetHandleId(WI7)
if(sr==1 or UA9)then
if UA9==false or OO7(h,"SuijiA0IFInit")==false then
if UA9 then
call NS7(h,"SuijiA0IFInit",true)
endif
set t=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function SHD))
call TriggerAddAction(t,function SID)
call NT7(GetHandleId(t),"Destroyer",WI7)
if UA9 then
set nj[GetPlayerId(GetOwningPlayer(WI7))]=t
endif
endif
endif
if UA9 then
call UnitAddAbility(WI7,'A0OL')
if sr>1 then
call UnitAddAbility(WI7,'A0OM')
endif
if sr>2 then
call UnitAddAbility(WI7,'A0ON')
endif
if sr>3 then
call UnitAddAbility(WI7,'A0OH')
endif
else
if(sr==1)then
call XF7(WI7,'A0OL')
elseif(sr==2)then
call XF7(WI7,'A0OM')
elseif(sr==3)then
call XF7(WI7,'A0ON')
elseif(sr==4)then
call XF7(WI7,'A0OH')
endif
endif
set t=null
endfunction
