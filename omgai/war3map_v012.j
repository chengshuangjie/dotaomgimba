function SuijiMode_OgreShouldKeepVisible takes unit suijiOgreUnit,integer suijiOgreSkill returns boolean
local integer suijiOgreHandle=GetHandleId(suijiOgreUnit)
if suijiOgreSkill==QI7(suijiOgreUnit) or suijiOgreSkill==QJ7(suijiOgreUnit) or suijiOgreSkill==QK7(suijiOgreUnit) then
return true
endif
if suijiOgreSkill==OM7(suijiOgreHandle,"SuijiSmallSkill") or suijiOgreSkill==OM7(suijiOgreHandle,"SuijiUltSkill") then
return true
endif
return false
endfunction
function SuijiMode_FixOgreNativeSkillVisibility takes unit suijiOgreUnit returns nothing
local integer suijiOgreHandle=0
local player suijiOgreOwner=null
if SUIJI_MODE==false or suijiOgreUnit==null or GetUnitTypeId(suijiOgreUnit)!='Hmkg' then
return
endif
set suijiOgreHandle=GetHandleId(suijiOgreUnit)
if OO7(suijiOgreHandle,"SuijiDone")==false then
return
endif
set suijiOgreOwner=GetOwningPlayer(suijiOgreUnit)
call B287_SetPlayerAbilityAvailable(suijiOgreOwner,'A088',true)
call SetPlayerAbilityAvailable(suijiOgreOwner,'A04W',SuijiMode_OgreShouldKeepVisible(suijiOgreUnit,'A04W'))
call SetPlayerAbilityAvailable(suijiOgreOwner,'A089',SuijiMode_OgreShouldKeepVisible(suijiOgreUnit,'A089'))
call SetPlayerAbilityAvailable(suijiOgreOwner,'A08A',SuijiMode_OgreShouldKeepVisible(suijiOgreUnit,'A08A'))
call B287_SetPlayerAbilityAvailable(suijiOgreOwner,'A08D',SuijiMode_OgreShouldKeepVisible(suijiOgreUnit,'A08D'))
call SetPlayerAbilityAvailable(suijiOgreOwner,'A011',SuijiMode_OgreShouldKeepVisible(suijiOgreUnit,'A011'))
call SetPlayerAbilityAvailable(suijiOgreOwner,'A007',SuijiMode_OgreShouldKeepVisible(suijiOgreUnit,'A007'))
call SetPlayerAbilityAvailable(suijiOgreOwner,'A01T',SuijiMode_OgreShouldKeepVisible(suijiOgreUnit,'A01T'))
call B287_SetPlayerAbilityAvailable(suijiOgreOwner,'A00F',SuijiMode_OgreShouldKeepVisible(suijiOgreUnit,'A00F'))
call SetPlayerAbilityAvailable(suijiOgreOwner,'A083',SuijiMode_OgreShouldKeepVisible(suijiOgreUnit,'A083'))
call SetPlayerAbilityAvailable(suijiOgreOwner,'A08F',SuijiMode_OgreShouldKeepVisible(suijiOgreUnit,'A08F'))
call SetPlayerAbilityAvailable(suijiOgreOwner,'A08G',SuijiMode_OgreShouldKeepVisible(suijiOgreUnit,'A08G'))
call B287_SetPlayerAbilityAvailable(suijiOgreOwner,'A08I',SuijiMode_OgreShouldKeepVisible(suijiOgreUnit,'A08I'))
call SetPlayerAbilityAvailable(suijiOgreOwner,'A2KQ',(OO7(suijiOgreHandle,"AI|Magi2Blast") and GetUnitAbilityLevel(suijiOgreUnit,'A2KQ')>0) or SuijiMode_OgreShouldKeepVisible(suijiOgreUnit,'A2KQ'))
set suijiOgreOwner=null
endfunction
function SuijiMode_IsInvokerUnit takes unit suijiInvokerUnit returns boolean
local integer suijiInvokerUnitId=0
if suijiInvokerUnit==null then
return false
endif
set suijiInvokerUnitId=GetUnitTypeId(suijiInvokerUnit)
return GetUnitPointValue(suijiInvokerUnit)==94 or suijiInvokerUnitId=='H00U' or suijiInvokerUnitId=='Z00U' or suijiInvokerUnitId=='Z10U' or suijiInvokerUnitId=='Z20U' or suijiInvokerUnitId=='Z02X'
endfunction
function SuijiMode_IsInvokerInvokedSkill takes integer suijiInvokerSkill returns boolean
return suijiInvokerSkill=='A0VS' or suijiInvokerSkill=='A0VK' or suijiInvokerSkill=='A0VQ' or suijiInvokerSkill=='A0XL' or suijiInvokerSkill=='A0VM' or suijiInvokerSkill=='A0VN' or suijiInvokerSkill=='A0VO' or suijiInvokerSkill=='A0VP' or suijiInvokerSkill=='A0VG' or suijiInvokerSkill=='A0VZ'
endfunction
function SuijiMode_SetCopiedInvokerLevels takes unit suijiInvokerUnit,integer suijiInvokerSkillLevel returns nothing
local integer suijiInvokerOrbLevel=1
local integer suijiInvokerHandle=0
if SUIJI_MODE==false or suijiInvokerUnit==null or GetUnitTypeId(suijiInvokerUnit)==0 or SuijiMode_IsInvokerUnit(suijiInvokerUnit) then
return
endif
if suijiInvokerSkillLevel<1 then
set suijiInvokerSkillLevel=1
elseif suijiInvokerSkillLevel>4 then
set suijiInvokerSkillLevel=4
endif
set suijiInvokerOrbLevel=suijiInvokerSkillLevel*2-1
set suijiInvokerHandle=GetHandleId(suijiInvokerUnit)
call NP7(suijiInvokerHandle,"WexLevel",suijiInvokerOrbLevel)
call NP7(suijiInvokerHandle,"QuasLevel",suijiInvokerOrbLevel)
call NP7(suijiInvokerHandle,"ExortLevel",suijiInvokerOrbLevel)
endfunction
function SuijiMode_InitCopiedInvokerSkill takes unit suijiInvokerUnit,integer suijiInvokerSkill,integer suijiInvokerSkillLevel returns nothing
if SuijiMode_IsInvokerInvokedSkill(suijiInvokerSkill)==false then
return
endif
if suijiInvokerSkillLevel<1 and suijiInvokerUnit!=null and GetUnitTypeId(suijiInvokerUnit)!=0 then
set suijiInvokerSkillLevel=B287_GetUnitAbilityLevel(suijiInvokerUnit,suijiInvokerSkill)
endif
call SuijiMode_SetCopiedInvokerLevels(suijiInvokerUnit,suijiInvokerSkillLevel)
endfunction
function SuijiMode_UpdateCopiedInvokerLevels takes unit suijiInvokerUnit returns nothing
local integer suijiInvokerHandle=0
local integer suijiInvokerSkill=0
local integer suijiInvokerSkillLevel=0
if SUIJI_MODE==false or suijiInvokerUnit==null or GetUnitTypeId(suijiInvokerUnit)==0 or SuijiMode_IsInvokerUnit(suijiInvokerUnit) then
return
endif
set suijiInvokerHandle=GetHandleId(suijiInvokerUnit)
set suijiInvokerSkill=OM7(suijiInvokerHandle,"SuijiSmallSkill")
if SuijiMode_IsInvokerInvokedSkill(suijiInvokerSkill) then
set suijiInvokerSkillLevel=GetUnitAbilityLevel(suijiInvokerUnit,suijiInvokerSkill)
endif
set suijiInvokerSkill=OM7(suijiInvokerHandle,"SuijiUltSkill")
if SuijiMode_IsInvokerInvokedSkill(suijiInvokerSkill) and B287_GetUnitAbilityLevel(suijiInvokerUnit,suijiInvokerSkill)>suijiInvokerSkillLevel then
set suijiInvokerSkillLevel=B287_GetUnitAbilityLevel(suijiInvokerUnit,suijiInvokerSkill)
endif
if suijiInvokerSkillLevel>0 then
call SuijiMode_SetCopiedInvokerLevels(suijiInvokerUnit,suijiInvokerSkillLevel)
endif
endfunction
function SuijiMode_InvokerShouldKeepVisible takes unit suijiInvokerUnit,integer suijiInvokerSkill returns boolean
local integer suijiInvokerHandle=0
if suijiInvokerUnit==null or suijiInvokerSkill==0 then
return false
endif
set suijiInvokerHandle=GetHandleId(suijiInvokerUnit)
return suijiInvokerSkill==OM7(suijiInvokerHandle,"Invoker|Current1") or suijiInvokerSkill==OM7(suijiInvokerHandle,"Invoker|Current2") or suijiInvokerSkill==OM7(suijiInvokerHandle,"Invoker|Current3") or suijiInvokerSkill==OM7(suijiInvokerHandle,"SuijiSmallSkill") or suijiInvokerSkill==OM7(suijiInvokerHandle,"SuijiUltSkill")
endfunction
function SuijiMode_FixInvokerNativeSkillVisibility takes unit suijiInvokerUnit returns nothing
local integer suijiInvokerHandle=0
local integer suijiInvokerIndex=1
local integer suijiInvokerSkill=0
local integer suijiInvokerCurrent1=0
local integer suijiInvokerCurrent2=0
local integer suijiInvokerCurrent3=0
local player suijiInvokerOwner=null
if SUIJI_MODE==false or SuijiMode_IsInvokerUnit(suijiInvokerUnit)==false then
return
endif
set suijiInvokerHandle=GetHandleId(suijiInvokerUnit)
if OO7(suijiInvokerHandle,"SuijiDone")==false then
return
endif
set suijiInvokerCurrent1=OM7(suijiInvokerHandle,"Invoker|Current1")
set suijiInvokerCurrent2=OM7(suijiInvokerHandle,"Invoker|Current2")
set suijiInvokerCurrent3=OM7(suijiInvokerHandle,"Invoker|Current3")
if (suijiInvokerCurrent1==0 or GetUnitAbilityLevel(suijiInvokerUnit,suijiInvokerCurrent1)==0) and (suijiInvokerCurrent2==0 or GetUnitAbilityLevel(suijiInvokerUnit,suijiInvokerCurrent2)==0) and (suijiInvokerCurrent3==0 or GetUnitAbilityLevel(suijiInvokerUnit,suijiInvokerCurrent3)==0) then
return
endif
set suijiInvokerOwner=GetOwningPlayer(suijiInvokerUnit)
loop
exitwhen suijiInvokerIndex>10
set suijiInvokerSkill=BS[suijiInvokerIndex]
if suijiInvokerSkill!=0 then
call SetPlayerAbilityAvailable(suijiInvokerOwner,suijiInvokerSkill,SuijiMode_InvokerShouldKeepVisible(suijiInvokerUnit,suijiInvokerSkill) and GetUnitAbilityLevel(suijiInvokerUnit,suijiInvokerSkill)>0)
endif
set suijiInvokerIndex=suijiInvokerIndex+1
endloop
set suijiInvokerOwner=null
endfunction
function SuijiMode_IsTransientStateButton takes integer skill returns boolean
return skill=='Aamk' or skill=='A0NR' or skill=='A02T' or skill=='A0GC' or skill=='A0HA' or skill=='A0RT' or skill=='A0SA' or skill=='A121' or skill=='A13D' or skill=='A1MN' or skill=='A1NH' or skill=='A1S9' or skill=='A1TU' or skill=='A1WF' or skill=='A1Z2' or skill=='A1Z3' or skill=='A205' or skill=='A20N' or skill=='A21H' or skill=='A24A' or skill=='A24B' or skill=='A24E' or skill=='A2MB' or skill=='A2NI' or skill=='A4HF'
endfunction
function SuijiMode_ShouldRestoreVisibleAbility takes unit u,integer skill returns boolean
if u==null or GetUnitTypeId(u)==0 then
return false
endif
if B287_IsStateReplaceBaseSkill(skill) and LoadBoolean(L7,GetHandleId(u),StringHash("B289StateReplaceBase")+skill) then
return false
endif
if skill=='A11N' and OM7(GetHandleId(u),"SuijiXMarkActiveCount")>0 then
return false
endif
return true
endfunction
function SuijiAI_RestoreVisibleAbility takes unit u,player p,integer skill returns nothing
if skill!=0 and SuijiMode_IsTransientStateButton(skill)==false and SuijiMode_ShouldRestoreVisibleAbility(u,skill) then
call SetPlayerAbilityAvailable(p,skill,true)
endif
endfunction
function SuijiAI_RestoreVisibleLogicalAbility takes unit u,player p,integer skill returns nothing
if skill!=0 and SuijiMode_IsTransientStateButton(skill)==false and SuijiMode_ShouldRestoreVisibleAbility(u,skill) then
call B287_SetPlayerAbilityAvailable(p,skill,true)
endif
endfunction
function SuijiAI_RestoreOwnedAbility takes unit u,player p,integer skill returns nothing
if skill!=0 and SuijiMode_IsTransientStateButton(skill)==false and GetUnitAbilityLevel(u,skill)>0 then
call SetPlayerAbilityAvailable(p,skill,true)
endif
endfunction
function SuijiAI_HideOwnedAbility takes unit u,player p,integer skill returns nothing
if skill!=0 and GetUnitAbilityLevel(u,skill)>0 then
call SetPlayerAbilityAvailable(p,skill,false)
endif
endfunction
function SuijiAI_RestoreVisibleSkills takes unit u returns nothing
local integer idx=0
local integer h=0
local integer i=KL4
local integer skill=0
local player p=null
if u==null then
return
endif
set idx=SuijiMode_GetStableHeroIndex(u)
set h=GetHandleId(u)
set p=GetOwningPlayer(u)
loop
exitwhen i>K54
call SuijiAI_HideOwnedAbility(u,p,HR4[i])
call SuijiAI_HideOwnedAbility(u,p,HS4[i])
call SuijiAI_HideOwnedAbility(u,p,HT4[i])
call SuijiAI_HideOwnedAbility(u,p,HU4[i])
call SuijiAI_HideOwnedAbility(u,p,HV4[i])
set i=i+1
endloop
if idx>=KL4 and idx<=K54 then
call SuijiAI_RestoreVisibleAbility(u,p,HM4[idx])
call SuijiAI_RestoreVisibleAbility(u,p,HN4[idx])
call SuijiAI_RestoreVisibleAbility(u,p,HO4[idx])
call SuijiAI_RestoreVisibleAbility(u,p,HP4[idx])
call SuijiAI_RestoreVisibleAbility(u,p,HQ4[idx])
endif
if SuijiMode_IsInvokerUnit(u)==false then
set i=1
loop
exitwhen i>10
set skill=LoadInteger(MSK,idx,i)
if skill!=0 and SuijiMode_IsTransientStateButton(skill)==false and GetUnitAbilityLevel(u,skill)>0 and SuijiMode_ShouldRestoreVisibleAbility(u,skill) then
call SetPlayerAbilityAvailable(p,skill,true)
endif
set i=i+1
endloop
endif
call SuijiAI_RestoreVisibleLogicalAbility(u,p,OM7(h,"SuijiSmallSkill"))
call SuijiAI_RestoreVisibleLogicalAbility(u,p,OM7(h,"SuijiUltSkill"))
if OM7(h,"SuijiSmallHelper")!=0 then
call SetPlayerAbilityAvailable(p,OM7(h,"SuijiSmallHelper"),false)
endif
if OM7(h,"SuijiUltHelper")!=0 then
call SetPlayerAbilityAvailable(p,OM7(h,"SuijiUltHelper"),false)
endif
call SuijiMode_FixOgreNativeSkillVisibility(u)
call SuijiMode_FixInvokerNativeSkillVisibility(u)
set p=null
endfunction
function SuijiAI_IsImmediateOrder takes string order returns boolean
return order=="stomp" or order=="thunderclap" or order=="fanofknives" or order=="roar" or order=="battleroar" or order=="howlofterror" or order=="berserk" or order=="metamorphosis" or order=="chemicalrage" or order=="bearform" or order=="windwalk" or order=="immolation" or order=="locustswarm" or order=="mirrorimage" or order=="voodoo" or order=="manashield" or order=="phaseshift" or order=="elementalfury" or order=="selfdestruct" or order=="corporealform" or order=="reincarnation" or order=="carrionscarabs" or order=="carrionscarabsoff" or order=="cannibalize" or order=="ancestralspirit" or order=="spiritwolf" or order=="summongrizzly" or order=="itemchangetime"
endfunction
function SuijiAI_IsPointOrder takes string order returns boolean
return order=="blizzard" or order=="flamestrike" or order=="rainoffire" or order=="shockwave" or order=="carrionswarm" or order=="breathoffire" or order=="impale" or order=="clusterrockets" or order=="volcano" or order=="tornado" or order=="inferno" or order=="forceofnature" or order=="summonward" or order=="healingward" or order=="landmine" or order=="stasistrap" or order=="darkportal" or order=="whirlwind" or order=="blink"
endfunction
function SuijiAI_IsSelfTargetOrder takes string order returns boolean
return order=="bloodlust" or order=="innerfire" or order=="frostarmor" or order=="antimagicshell" or order=="invisibility" or order=="replenishmana" or order=="creepheal" or order=="itemareaheal" or order=="holybolt"
endfunction
