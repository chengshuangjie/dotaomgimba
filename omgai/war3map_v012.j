function JDEBUG takes nothing returns nothing
local string VH=GetEventPlayerChatString()
local string VH2=SubString(VH,0,13)
local string VH3=SubString(VH,0,9)
local string VH44=SubString(VH,0,10)
local string VH55=SubString(VH,0,11)
local string VH66=SubString(VH,0,13)
local player p=GetTriggerPlayer()
local integer id=GetPlayerId(p)
local unit u=M7[id]
local unit ZX7
local integer iii
local integer i=S2I(SubString(VH,6,StringLength(VH)))
local trigger t
local real x=GetUnitX(u)
local real y=GetUnitY(u)
//local real x=GetRectCenterX(QD)
//local real y=GetRectCenterX(QD)
//local real x=GetRectCenterX(QD)
//local real y=GetRectCenterX(QD)
//local real x=GetRectCenterX(QD)
//local real y=GetRectCenterX(QD)
local real Face=GetUnitFacing(u)
if SPEPLAYER[id]!=1 and IS11 then
set u=null
set p=null
return
endif
if VH=="-debugorder" then
set t=CreateTrigger()
call TriggerRegisterPlayerUnitEventSimple(t, Player(1), EVENT_PLAYER_UNIT_ISSUED_ORDER)
call TriggerRegisterPlayerUnitEventSimple(t, Player(1), EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER)
call TriggerRegisterPlayerUnitEventSimple(t, Player(1), EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER)
call TriggerAddAction(t, function DEBUG_ORDER)
call DisplayTextToPlayer(GetTriggerPlayer(),0,0, "开启显示命令ID")
set t=null
set u=null
set p=null
endif
if VH3=="-debugbuy" then
set i=S2I(SubString(VH,10,StringLength(VH)))
call DisplayTextToPlayer(GetTriggerPlayer(),0,0, I2S(i)+"楼执行BVE，直接购买物品")
if i>5 then
set i=i+1
endif
call BVE(i,M7[i],false)
set u=null
set p=null
return
endif
if VH44=="-debugsczb" then 
set i=S2I(SubString(VH,11,12))
set iii=S2I(SubString(VH,13,StringLength(VH)))
call DisplayTextToPlayer(GetTriggerPlayer(),0,0, "删除第"+I2S(i)+"格装备，"+"对于"+I2S(iii)+"楼")
set i=i-1
if iii>5 then
set iii=iii+1
endif
call RemoveItem(UnitItemInSlot(M7[iii],i))
set u=null
set p=null
return
endif
if VH=="-debugtestopen" then 
call CP8()
set u=null
set p=null
return
endif
if VH=="-debugnd" then 
set P94=true
call VV7(bj_FORCE_ALL_PLAYERS,$A,"|cFF00FF00秒活模式开启，英雄死亡后不需要复活时间。|r")
set u=null
set p=null
return
endif
if VH44=="-debugtest" then 
call SetCameraFieldForPlayer(p, CAMERA_FIELD_TARGET_DISTANCE,2600 , 0)
call SaveReal(TABLE_Z,GetHandleId(p),100,2600)
call TriggerEvaluate(MS)
call AdjustPlayerStateBJ(100000,Player(1),PLAYER_STATE_RESOURCE_GOLD)
call AdjustPlayerStateBJ(100000,Player(2),PLAYER_STATE_RESOURCE_GOLD)
call AdjustPlayerStateBJ(100000,Player(7),PLAYER_STATE_RESOURCE_GOLD)
call FogEnableOff()
call FogMaskEnableOff()
call Test_Control()
call EnableWeatherEffect(bo,false)
call EnableWeatherEffect(Bo,false)
call EnableWeatherEffect(fL,false)
call EnableWeatherEffect(FL,false)
call CR8()
set PK4=true
set u=null
set p=null
return
endif
if VH3=="-debugwtf" then 
call CR8()
set u=null
set p=null
return
endif
if VH44=="-debugwjzb" then 
set i=S2I(SubString(VH,11,StringLength(VH)))
call DisplayTextToPlayer(GetTriggerPlayer(), 0, 0,"|c00FF8000玩家 X坐标|r"+R2S(GetUnitX(u))+"Y坐标"+R2S(GetUnitY(u)))
//call DisplayTextToPlayer(GetTriggerPlayer(), 0, 0,"|c00FF8000玩家面向|r"+R2S(GetUnitFacing(u)))
set u=null
set p=null
return
endif
if VH55=="-debugdummy" then 
set i=S2I(SubString(VH,12,15))
if TW7(GetOwningPlayer(u))then
set ZX7=CreateUnit(Z7[1],K34[i],GetRectCenterX(QD),GetRectCenterX(QD),0)
else
set ZX7=CreateUnit(A7[1],K34[i],GetRectCenterX(QD),GetRectCenterX(QD),0)
endif
call SetHeroLevel(ZX7,$A,false)
set tmpunit=ZX7
