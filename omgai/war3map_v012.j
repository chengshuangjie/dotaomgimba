        call DzAPI_Map_SaveServerString(Player(playerId - 1), key, value)
    endfunction

    function OMGAIIPlatformAPI___KKLoadDataImpl takes integer playerId, string key returns string
        return DzAPI_Map_GetServerString(Player(playerId - 1), key)
    endfunction

