call SaveUnitHandle(L7,(I97),(17),(m5))
call SetUnitOwner(m5,GetOwningPlayer(p5),true)
call UnitApplyTimedLife(m5,'BTLF',80)
call XF7(m5,'Aeth')
call XF7(m5,'A12G')
call YP7(m5)
call AddHeroXP(p5,R2I(EEG(GetUnitLevel(m5))),true)
