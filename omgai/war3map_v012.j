function DLG_level takes integer skill returns integer
local integer D1G=0
if skill=='A02O' then
set D1G=1
endif
if skill=='A08Y' then
set D1G=2
endif
if skill=='A08Z' then
set D1G=3
endif
if skill=='A090' then
set D1G=4
endif
if skill=='A092' then
set D1G=5
endif
return D1G
endfunction
