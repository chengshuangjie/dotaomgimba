function AI_LEARN_EX_SKILL takes unit ZX7 returns nothing
local integer id=GetUnitTypeId(ZX7)
local integer skill
local integer skill2
local integer n=1
if id=='H071' then
    set skill='A4BV'
    set skill2='A4BW'
elseif id=='U00P' then
    set skill='A4A1'
    set skill2='A4A2'
elseif id=='N00R' then
    set skill='A4BP'
    set skill2='A4BQ'
elseif id=='N01V' then
    set skill='A0LN'
    set skill2='A4F0'
elseif id=='Hvsh' then
    set skill='A0LH'
    set skill2='A2Z9'
elseif id=='E02H' then
    set skill='A2ZM'
    set skill2='A2ZN'
elseif id=='Ofar' then
    set skill='A29I'
    set skill2='A2UL'
elseif id=='U00K' then
    set skill='A06O'
    set skill2='A4I2'
elseif id=='Hvwd' then
    set skill='A02A'
    set skill2='A4J2'
elseif id=='UC01' then
    set skill='A0Q7'
    set skill2='A4J4'
elseif id=='Ntin' then
	set skill='A2UR'
    set skill2='A2US'
else
    return
endif
loop
exitwhen n>4
    call SelectHeroSkill(ZX7,skill)
    call SelectHeroSkill(ZX7,skill2)
set n=n+1
endloop
endfunction
function AICZB takes integer O5,unit it,player p returns nothing
if XM_MODE and GetPlayerController(p)==MAP_CONTROL_COMPUTER and GetUnitLevel(it)>15 and GetUnitAbilityLevel(it,'A2Q5')==0 then
call XF7(it,'A2Q5')
call XF7(it,'A2Q3')
endif
if XM_MODE and GetPlayerController(p)==MAP_CONTROL_COMPUTER and GetUnitLevel(it)>21 and GetUnitAbilityLevel(it,'A330')==0 then
call AI_LEARN_EX_SKILL(it)
call XF7(it,'A330')
call CHIA_SKILL(it,p)
call CHIA_TX(it,p)
call XF7(it,'A2VW')
call XF7(it,'A334')
call CHILLX_SKILL(it,p)
set CHIA[O5]=1
set CHILLX[O5]=1
endif
if FORCE_AICZB then
call XF7(it,'A2Q5')
call XF7(it,'A2Q3')
call XF7(it,'A330')
call CHIA_SKILL(it,p)
call CHIA_TX(it,p)
call XF7(it,'A2VW')
call XF7(it,'A334')
call CHILLX_SKILL(it,p)
set CHIA[O5]=1
set CHILLX[O5]=1
endif
endfunction
function BVE takes integer O5,unit it,boolean BUE returns nothing
local integer i1=GetUnitTypeId(it)
local integer array BWE
local boolean MA7=false
local boolean BXE=false
local boolean BYE=false
local boolean J4=false
local string BZE
local integer i
local integer ZPE
local integer j
local integer JA7
local integer BAE
local integer k
local integer ZQE
local unit u
local player p=GetOwningPlayer(it)
local integer x
if AISZ[O5]==1 then
return
endif
if BHE(O5)then
return
endif
if(G97[432+O5]==2)then
if OM7(GetHandleId(KU4[16+O5]),"aiCrow|CurrentOwner")!=O5 and DEBUGBVE then
return
endif
set KU4[32+O5]=KU4[16+O5]
else
set KU4[32+O5]=KU4[O5]
endif
if(not GE7[112+O5])then
set G97[$90+O5]=1
else
set G97[$A0+O5]=R2I(Bz)+30
call Y0E(O5,it)
endif
set GE7[48+O5]=BUE
set GE7[$A0+O5]=(BUE and GE7[$B0+O5])
set i=G97[$90+O5]
if(G97[$90+O5]==0)and(not BUE)then
if(PY4)then
else
call BOE(O5,it,QC,true)
endif
call B4E(O5,it,TC,true)
endif
set ZPE=OM7(GetHandleId(Player(O5)),"AI|Class")
if(G97[$90+O5]==0)and(not BUE)then
set JA7=WH7(it)



if ZPE==4 then
call BNE(O5,it,-2,TC)
else
if IsUnitType(it,UNIT_TYPE_MELEE_ATTACKER)then
call B4E(O5,it,EZ,false)
if i1!=12111191870 then
call B4E(O5,it,BA,false)
endif
else
call B4E(O5,it,AX,false)
if JA7==1 then
call BNE(O5,it,-2,HL)
elseif JA7==2 then
call BNE(O5,it,-2,DL)
else
call BNE(O5,it,-2,A6)
endif
endif
endif


set G97[$90+O5]=1
set G97[112+O5]=0
endif
if i1=='H00D' then
if(G97[$90+O5]==1)and(not GE7[$A0+O5])then
call BNE(O5,it,0,H6)
call BNE(O5,it,1,DT4)
call BNE(O5,it,2,it_silingshu3)
call BNE(O5,it,3,FR4)
call BNE(O5,it,4,it_yangdao)
call BNE(O5,it,5,N5)
endif
if(G97[$90+O5]==2)or(GE7[$A0+O5])then
set BWE[0]=U3
endif
elseif i1=='H0DO' then
if(G97[$90+O5]==1)and(not GE7[$A0+O5])then
call BNE(O5,it,0,N6)
call BNE(O5,it,1,DT4)
call BNE(O5,it,2,DR4)
call BNE(O5,it,3,it_fls)
call BNE(O5,it,4,it_yangdao)
call BNE(O5,it,5,F5)
endif
if(G97[$90+O5]==2)or(GE7[$A0+O5])then
set BWE[0]=it_bingjia
set BWE[1]=N5
endif
elseif i1=='N016' or i1=='N017' or i1=='N200' or i1=='N201' or i1=='N02B' then
if(G97[$90+O5]==1)and(not GE7[$A0+O5])then
call BNE(O5,it,0,G6)
call BNE(O5,it,1,DT4)
call BNE(O5,it,2,J1)
call BNE(O5,it,3,E1)
call BNE(O5,it,4,A1)
call BNE(O5,it,5,Z2)
endif
if(G97[$90+O5]==2)or(GE7[$A0+O5])then
set BWE[0]=E2
set BWE[1]=it_sadan
set BWE[2]=L5
endif
elseif i1=='Harf' then
if(G97[$90+O5]==1)and(not GE7[$A0+O5])then
call BNE(O5,it,0,F74)
call BNE(O5,it,1,DT4)
call BNE(O5,it,2,C0)
call BNE(O5,it,3,it_yangdao)
call BNE(O5,it,4,DR4)
call BNE(O5,it,5,N5)
endif
if(G97[$90+O5]==2)or(GE7[$A0+O5])then
set BWE[0]=it_bingjia
set BWE[1]=RLL
endif
elseif i1=='Naka' then
if(G97[$90+O5]==1)and(not GE7[$A0+O5])then
call BNE(O5,it,0,G6)
call BNE(O5,it,1,DT4)
call BNE(O5,it,2,U1)
call BNE(O5,it,3,N5)
call BNE(O5,it,4,it_yangdao)
call BNE(O5,it,5,E2)
endif
if(G97[$90+O5]==2)or(GE7[$A0+O5])then
set BWE[0]=it_sadan
endif
elseif i1=='U00P' then
if(G97[$90+O5]==1)and(not GE7[$A0+O5])then
call BNE(O5,it,0,N6)
call BNE(O5,it,1,DT4)
call BNE(O5,it,2,DR4)
call BNE(O5,it,3,FR4)
call BNE(O5,it,4,C0)
call BNE(O5,it,5,it_yangdao)
endif
if(G97[$90+O5]==2)or(GE7[$A0+O5])then
set BWE[0]=it_bingjia
set BWE[0]=RLL
endif
elseif i1=='Ntin' then
if(G97[$90+O5]==1)and(not GE7[$A0+O5])then
call BNE(O5,it,0,N6)
call BNE(O5,it,1,DT4)
call BNE(O5,it,2,DI4)
call BNE(O5,it,3,it_yangdao)
call BNE(O5,it,4,N5)
call BNE(O5,it,5,it_xyf)
endif
if(G97[$90+O5]==2)or(GE7[$A0+O5])then
set BWE[0]=it_shj
endif
elseif i1=='Udre' or i1=='Udrf' then
if(G97[$90+O5]==1)and(not GE7[$A0+O5])then
call BNE(O5,it,0,H6)
call BNE(O5,it,1,DT4)
call BNE(O5,it,2,R3)
call BNE(O5,it,3,J1)
call BNE(O5,it,4,it_qiangxi)
call BNE(O5,it,5,A1)
endif
if(G97[$90+O5]==2)or(GE7[$A0+O5])then
set BWE[0]=R2
set BWE[1]=L5
set BWE[2]=it_sadan
endif
elseif i1=='E004' then
