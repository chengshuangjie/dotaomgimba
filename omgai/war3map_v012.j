function K19 takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit ZX7=O77(OB7,"Unit")
local integer n=0
local unit S4
//local integer i1=GetUnitTypeId(ZX7)
local integer i1=GetUnitPointValue(ZX7)
local real array d
local texttag tt
if GetTriggerEvalCount(t)==5 then
    call SetUnitPosition(ZX7,-7017.,6683.)
    call PauseUnitEx(ZX7,true)
    call SetUnitInvulnerable(ZX7,true)
    call DisplayTimedTextToPlayer(GetOwningPlayer(ZX7),0,0,10,"|cFF00FF00正在使用重建指令，请耐久等待30秒|r")
endif
if GetTriggerEvalCount(t)>5 and GetTriggerEvalCount(t)<36 then
set tt=CreateTextTag()
call SetTextTagText(tt,I2S(36-GetTriggerEvalCount(t)),.03)
call SetTextTagPosUnit(tt,ZX7,0)
call SetTextTagColorBJ(tt,0,29,$FF,$F)
call SetTextTagVelocity(tt,0,.035)
call SetTextTagFadepoint(tt,3)
call SetTextTagLifespan(tt,.9)
call SetTextTagPermanent(tt,false)
call SetTextTagVisibility(tt,true)
endif
if GetTriggerEvalCount(t)>35 then
    set S4=CreateUnit(GetOwningPlayer(ZX7),K34[i1],GetUnitX(ZX7),GetUnitY(ZX7),bj_UNIT_FACING)
    call SetHeroXP(S4,GetHeroXP(ZX7),false)
    set n=0
    loop
    exitwhen n>5
    set d[n]=MHAbility_GetCooldown(ZX7,MHItem_GetAbilityId(UnitItemInSlot(ZX7, n),1))
    set n=n+1
    endloop
    call GAIN_ITEM(S4,ZX7)
    set n=0
    loop
    exitwhen n>5
    if d[n]>0 then
    call Set_Item_Drop(UnitItemInSlot(S4,n),d[n])
    endif
    set n=n+1
    endloop
    call CHANGE_HERO_SYNC(S4,ZX7,GetPlayerId(GetOwningPlayer(ZX7)))
    call YE7(ZX7)
    set M7[GetPlayerId(GetOwningPlayer(S4))]=S4
    call DisplayTimedTextToPlayer(GetOwningPlayer(ZX7),0,0,10,"|cFF00FF00已重建英雄|r")
    call NM7(OB7)
    call OZ7(t)
endif
set t=null
set tt=null
set S4=null
set ZX7=null
endfunction
