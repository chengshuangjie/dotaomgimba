if (GetTriggerEventId()==EVENT_PLAYER_UNIT_SPELL_EFFECT and B287_GetSpellAbilityId()==skill) or GetTriggerEventId()==EVENT_GAME_TIMER_EXPIRED then
	// call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "|c00FF8000已经使用物品或超过10秒|r")
    call SaveInteger(TABLE_BUY, O5, n, 0)
