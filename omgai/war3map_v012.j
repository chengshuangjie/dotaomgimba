//星落
function XJCAX takes nothing returns nothing
	local integer h = GetHandleId(GetExpiredTimer())
	local unit u = LoadUnitHandle(TABLE_HY, h, 0)
	local integer c = LoadInteger(TABLE_HY, h, 0)
	local group g
	local unit m5
	if LoadBoolean(TABLE_HY, h, 0) then
		call RemoveSavedBoolean(TABLE_HY, h, 0)
		call TimerStart(GetExpiredTimer(), 1., true, function XJCAX)
	endif
	if c > 0 then
		set c = c -1
		call SaveInteger(TABLE_HY, h, 0, c)
	endif
	if c == 0 and GetUnitAbilityLevel(u,'A3UF')> 0 and B287_GetUnitAbilityLevel(u,'A0KV')> 0 and(GetWidgetLife(u)> 0.405 and not IsUnitType(u, UNIT_TYPE_DEAD)) then
		call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A3UG',false)
		call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A3UF',true)
		set g = WS7()
		set IN4 = u
		call GroupEnumUnitsInRange(g, GetUnitX(u), GetUnitY(u), 650, Condition(function AX7))
		//如果英雄非隐身
		if not DXX(u) then
			set m5=FirstOfGroup(g)
			if m5!=null and UnitAlive(m5) then
				call LP9(u)
				if GetUnitAbilityLevel(u,'A2VW')>0 then
					call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A3UF',false)
					call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A3UG',true)
					call SaveInteger(TABLE_HY, h, 0, 6)
					call YDWESetUnitAbilityState(u,'A3UG', 1, 6.01)
				else
					call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A3UF',false)
					call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A3UG',true)
					call SaveInteger(TABLE_HY, h, 0, 8)
					call YDWESetUnitAbilityState(u,'A3UG', 1, 8.01)
				endif
			endif



		endif
		call WR7(g)
	endif
	set u = null
	set m5 = null
	set g = null
endfunction
function XJVXX takes nothing returns nothing
	local timer t = CreateTimer()
	local unit u = U22
	local integer h = GetHandleId(t)
	call TimerStart(t, 0, false, function XJCAX)
	call SaveUnitHandle(TABLE_HY, h, 0, u)
	call SaveInteger(TABLE_HY, h, 0, 0)
	call SaveBoolean(TABLE_HY, h, 0, true)
	call SaveTimerHandle(TABLE_HY, GetHandleId(u),'A3UF', t)
	set u = null
	set t = null
endfunction
function Mirana_HasScepter takes unit miranaScepterUnit returns boolean
if miranaScepterUnit==null then
return false
endif
return SuijiMode_HasAghanimState(miranaScepterUnit)
endfunction
function Mirana_EnsureStarfallScepter takes unit miranaStarfallUnit returns nothing
local player miranaStarfallOwner=null
if miranaStarfallUnit==null then
return
endif
set miranaStarfallOwner=GetOwningPlayer(miranaStarfallUnit)
if Mirana_HasScepter(miranaStarfallUnit) and B287_GetUnitAbilityLevel(miranaStarfallUnit,'A0KV')>0 then
if GetUnitAbilityLevel(miranaStarfallUnit,'A3UG')==0 then
call XF7(miranaStarfallUnit,'A3UG')
endif
call SetPlayerAbilityAvailable(miranaStarfallOwner,'A3UG',false)
if GetUnitAbilityLevel(miranaStarfallUnit,'A3UF')==0 then
call XF7(miranaStarfallUnit,'A3UF')
endif
if GetUnitAbilityLevel(miranaStarfallUnit,'A4F2')==0 then
call XF7(miranaStarfallUnit,'A4F2')
endif
call SetPlayerAbilityAvailable(miranaStarfallOwner,'A4F2',false)
if not HaveSavedHandle(TABLE_HY, GetHandleId(miranaStarfallUnit),'A3UF') then
set U22=miranaStarfallUnit
call ExecuteFunc("XJVXX")
endif
else
call SetPlayerAbilityAvailable(miranaStarfallOwner,'A3UF',false)
call SetPlayerAbilityAvailable(miranaStarfallOwner,'A3UG',false)
call SetPlayerAbilityAvailable(miranaStarfallOwner,'A4F2',false)
call UnitRemoveAbility(miranaStarfallUnit,'A3UF')
call UnitRemoveAbility(miranaStarfallUnit,'A3UG')
call UnitRemoveAbility(miranaStarfallUnit,'A4F2')
endif
set miranaStarfallOwner=null
endfunction
function uj takes nothing returns boolean
return (IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(D8)) and GetUnitAbilityLevel(GetFilterUnit(),'A04R')==0 and GetUnitState(GetFilterUnit(),UNIT_STATE_LIFE)>1 and IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==false)!=null
endfunction
function uJ takes real uk,real uK,real iN,real io returns integer
local real in=SquareRoot((iN-uk)*(iN-uk)+(io-uK)*(io-uK))
return YG7(R2I(in/$96),$B)
endfunction
//白虎箭
function R_EXTX takes integer id,unit WI7,real Il,real IL returns nothing
local unit u
if id=='Z11V' then
set u=CreateUnit(GetOwningPlayer(WI7),'h206',Il,IL,0)
call KillUnit(u)
elseif id=='Z21V' then
set u=CreateUnit(GetOwningPlayer(WI7),'h306',Il,IL,0)
call KillUnit(u)
endif
set u=null
endfunction
function ul takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer OB7=GetHandleId(t)
local unit WI7=O77(OB7,"Hero")
local unit IJ=O77(OB7,"Projectile")
local real hN=ON7(OB7,"TargetX")
local real ho=ON7(OB7,"TargetY")
local real RK=ON7(OB7,"Angle")
local integer id=OM7(OB7,"ID")
local integer level=OM7(OB7,"level")
local real iN=GetUnitX(IJ)
local real io=GetUnitY(IJ)
local real Il=X17(GetUnitX(IJ)+40*Cos(RK))
local real IL=X07(GetUnitY(IJ)+40*Sin(RK))
local boolexpr hP=Condition(function uj)
local group LQ7=WS7()
local unit oA
local unit m5
local real uk
local real uK
local integer BC7
call SetUnitX(IJ,Il)
call SetUnitY(IJ,IL)
set D8=WI7
call GroupEnumUnitsInRange(LQ7,Il,IL,155,hP)
set m5=FirstOfGroup(LQ7)
call WR7(LQ7)
call DestroyBoolExpr(hP)
if m5!=null then
if IsUnitType(m5,UNIT_TYPE_HERO) then
set SO4[GetPlayerId(GetOwningPlayer(WI7))]=SO4[GetPlayerId(GetOwningPlayer(WI7))]+1
call C27("AA_Hits"+I2S(GetPlayerId(GetOwningPlayer(WI7))),SO4[GetPlayerId(GetOwningPlayer(WI7))])
endif
set uk=ON7(OB7,"OriginalX")
set uK=ON7(OB7,"OriginalY")
set oA=CreateUnit(GetOwningPlayer(m5),'e00E',iN,io,0)
call XF7(oA,'A0L7')
call SetUnitAbilityLevel(oA,'A0L7',uJ(uk,uK,iN,io))
call IssueTargetOrderById(oA,$D007F,m5)
call UnitApplyTimedLife(oA,'BTLF',1.)
if (IsUnitEnemy(WI7,GetOwningPlayer(m5)) and (GetUnitAbilityLevel(m5,'A04R')==0 and IsUnitType(m5,UNIT_TYPE_STRUCTURE)==false and XH7(m5)==false) and IsUnitType(m5,UNIT_TYPE_ANCIENT)==false or Z_7(m5) and (IsUnitType(m5,UNIT_TYPE_HERO)==false and IsUnitIllusion(m5)==false) and IsMagicImmuneUnit(m5)==false and AS7(m5)==false)!=null then
call SetUnitLifeBJ(m5,10)
if KE7(WI7,m5)>1300 then
set BC7=GetUnitLevel(m5)
call AddHeroXP(WI7,R2I(EEG(BC7)),true)
endif
endif
call B67(WI7,m5,1,(75*level)+((uJ(uk,uK,iN,io)-1)*14))
call KillUnit(IJ)
call R_EXTX(id,WI7,Il,IL)
call Mv(t)
set oA=null
if uJ(uk,uK,iN,io)>1 and UnitAlive(m5) and IsMagicImmuneUnit(m5)==false then
call ZKR(WI7, m5, uJ(uk,uK,iN,io))
endif
elseif(Il-hN)*(Il-hN)+(IL-ho)*(IL-ho)<1600 or BlockUnitPass(IJ) then
call KillUnit(IJ)
call R_EXTX(id,WI7,Il,IL)
call Mv(t)
endif
set WI7=null
set IJ=null
set t=null
set hP=null
set LQ7=null
set m5=null
endfunction
function Get_POM_R_UNIT takes integer id,integer i returns integer
if id=='Z01V' or i==1 then
return 'h105'
elseif id=='Z11V'or i==2 then
return 'h205'
elseif id=='Z21V'or i==3 then
return 'h305'
elseif id=='Z31V'or i==4 then
return 'h405'
elseif id=='Z41V'or i==5 then
return 'h505'
else
return 'h005'
endif
endfunction
function LS9 takes unit WI7,real iN,real io,real RK,integer i returns nothing
local timer t=CreateTimer()
local integer OB7=GetHandleId(t)
local integer id=GetUnitTypeId(WI7)
local unit IJ
local integer skillmj
local integer level=B287_GetUnitAbilityLevel(WI7,'A0L8')
local real d=3000
set d=Labike_ZZMF_Skill_Range(WI7,d)
if GetUnitAbilityLevel(WI7,'A2YK')>0 then
    set d=d+200
elseif GetUnitAbilityLevel(WI7,'A2YJ')>0 then
    set d=d+150
endif
set skillmj=Get_POM_R_UNIT(id,i)
set IJ=CreateUnit(GetOwningPlayer(WI7),skillmj,iN,io,RK*bj_RADTODEG)
set SP4[GetPlayerId(GetOwningPlayer(WI7))]=SP4[GetPlayerId(GetOwningPlayer(WI7))]+1
call C27("AA_Total"+I2S(GetPlayerId(GetOwningPlayer(WI7))),SP4[GetPlayerId(GetOwningPlayer(WI7))])
call SetUnitFacing(IJ,RK*bj_RADTODEG)
call SetUnitPathing(IJ,false)
call NQ7(OB7,"OriginalX",iN)
call NQ7(OB7,"OriginalY",io)
call NQ7(OB7,"TargetX",X17(iN+d*Cos(RK)))
call NQ7(OB7,"TargetY",X07(io+d*Sin(RK)))
call NQ7(OB7,"Angle",RK)
call NT7(OB7,"Hero",WI7)
call NT7(OB7,"Projectile",IJ)
call NP7(OB7,"ID",id)
call NP7(OB7,"level",level)
call TimerStart(t,.035,true,function ul)
set t=null
set IJ=null
endfunction
function LS9PD takes nothing returns nothing
local unit WI7=GetTriggerUnit()
local real iN=X17(GetUnitX(WI7))
local real io=X07(GetUnitY(WI7))
local real hN=GetSpellTargetX()
local real ho=GetSpellTargetY()
local real RK=Atan2(ho-io,hN-iN)
local integer id=GetUnitTypeId(WI7)
local integer level=B287_GetUnitAbilityLevel(WI7,'A0L8')
local real a
local real x
local real y
local integer i=0
if id=='Z02X' then
    set i=GetRandomInt(1,5)
endif
call LS9(WI7,iN,io,RK,i)
if Mirana_HasScepter(WI7) then
    set a=RK*bj_RADTODEG-90
    if a>360 then
        set a=a-360
    elseif a<0 then
        set a=a+360
    endif
    set x=X17(GetUnitX(WI7)+200*Cos(a*bj_DEGTORAD))
    set y=X07(GetUnitY(WI7)+200*Sin(a*bj_DEGTORAD))
    call LS9(WI7,x,y,RK,i)
    set a=RK*bj_RADTODEG+90
    if a>360 then
        set a=a-360
    elseif a<0 then
        set a=a+360
    endif
    set x=X17(GetUnitX(WI7)+200*Cos(a*bj_DEGTORAD))
    set y=X07(GetUnitY(WI7)+200*Sin(a*bj_DEGTORAD))
    call LS9(WI7,x,y,RK,i)
endif
set WI7=null
endfunction
function LR9 takes nothing returns boolean
if B287_GetSpellAbilityId()=='A0L8' then
    call LS9PD()
endif
return false
endfunction
function LT9 takes nothing returns boolean
local integer LU9=SO4[GetPlayerId(GetTriggerPlayer())]
local integer D5=SP4[GetPlayerId(GetTriggerPlayer())]
local integer id=GetUnitTypeId(M7[GetPlayerId(GetTriggerPlayer())])
if (id=='N01V' or id=='Z01V' or id=='Z11V' or id=='Z21V' or id=='Z31V' or id=='Z41V') and D5>0 then
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,E9,10.,GetObjectName('n0GM')+" "+R2S(I2R(LU9)/I2R(D5)*100)+"% ("+I2S(LU9)+"/"+I2S(D5)+")")
endif
return false
endfunction
