function JDZC_SLOW_REMOVE takes unit IH7 returns nothing
    call UnitRemoveAbility(IH7,'A4JW')
    call UnitRemoveAbility(IH7,'A4JX')
    call UnitRemoveAbility(IH7,'A4JY')
    call UnitRemoveAbility(IH7,'A4JZ')
    call UnitRemoveAbility(IH7,'B07I')
    call UnitRemoveAbility(IH7,'B07E')
endfunction
function M8E takes nothing returns boolean
    local trigger t=GetTriggeringTrigger()
    local integer OB7=GetHandleId(t)
    local unit ZX7=LoadUnitHandle(ExtraHT, OB7, 1)
    local unit IH7=LoadUnitHandle(ExtraHT, OB7, 0)
    local real n=LoadReal(ExtraHT, OB7, 0)
    local real d=LoadReal(ExtraHT, OB7, 10)
    local integer MAX=LoadInteger(ExtraHT, OB7, 0)
    if ZX7==null or IH7==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 then
        if IH7!=null then
            call JDZC_SLOW_REMOVE(IH7)
            call RemoveSavedHandle(ExtraHT, 'jdzc', GetHandleId(IH7))
            call RemoveSavedHandle(ExtraHT, 'jdzc'+1, GetHandleId(IH7))
        endif
        call FlushChildHashtable(ExtraHT, OB7)
        call OZ7(t)
        set t=null
        set ZX7=null
        set IH7=null
        return false
    endif
    if n>MAX or (GetUnitAbilityLevel(IH7,'B07I')==0 and n>1) or GetTriggerEventId()==EVENT_UNIT_DEATH then
        call JDZC_SLOW_REMOVE(IH7)
        call RemoveSavedHandle(ExtraHT, 'jdzc', GetHandleId(IH7))
        call RemoveSavedHandle(ExtraHT, 'jdzc'+1, GetHandleId(IH7))
        call FlushChildHashtable(ExtraHT, OB7)
        call OZ7(t)
    elseif ModuloReal(n,10.)==0 then
        call B67(ZX7,IH7,2,d)
    endif
    call SaveReal(ExtraHT, OB7, 0, n+1)
    set t=null
    set ZX7=null
    set IH7=null
    return false
endfunction
function MDE takes nothing returns nothing
local boolean b = LoadBoolean(TABLE_HY, GetHandleId(GetTriggeringTrigger()), 100)
local unit ZX7 = U22
local unit IH7 = W22
local trigger t
local integer OB7
local integer level=B287_GetUnitAbilityLevel(ZX7,'A0NQ')
local integer slow_skill='A4JV'+level
local real d=8.+12*level
local integer durationCount=LoadInteger(TABLE_HY,GetHandleId(GetTriggeringTrigger()),101)
if durationCount<=0 then
set durationCount=1
endif
if HaveSavedHandle(ExtraHT, 'jdzc', GetHandleId(IH7)) then
    set t=LoadTriggerHandle(ExtraHT, 'jdzc', GetHandleId(IH7))
    set OB7=GetHandleId(t)
    call SaveReal(ExtraHT, OB7, 0, 0)
    call SaveReal(ExtraHT, OB7, 10, d)
    call SaveInteger(ExtraHT, OB7, 0, (20+level*10)*durationCount)
else
    set t=CreateTrigger()
    set OB7=GetHandleId(t)
    call SaveUnitHandle(ExtraHT, OB7, 1, ZX7)
    call SaveUnitHandle(ExtraHT, OB7, 0, IH7)
    call SaveReal(ExtraHT, OB7, 0, 0)
    call SaveReal(ExtraHT, OB7, 10, d)
    call SaveInteger(ExtraHT, OB7, 0, (30+level*10)*durationCount)
    call SaveTriggerHandle(ExtraHT, 'jdzc', GetHandleId(IH7), t)
    call TriggerRegisterTimerEvent(t,.1,true)
    call TriggerRegisterUnitEvent(t,IH7,EVENT_UNIT_DEATH)
    call TriggerAddCondition(t,Condition(function M8E))
    call XF7(IH7,slow_skill)
endif
if b then
    call LINGXIA(ZX7,IH7)
endif
set t=null
set ZX7=null
set IH7=null
endfunction
function JDZC takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local unit IH7=GetSpellTargetUnit()
local group g=WS7()
local integer level=B287_GetUnitAbilityLevel(ZX7,'A0NQ')
local integer MAX=level*2
local integer i=1
local trigger t
set U22=ZX7
call GroupEnumUnitsInRange(g, GetUnitX(IH7), GetUnitY(IH7), 400+50*level, Condition(function DJX))
set t=NHX(ZX7, IH7,'h0HH', "MDE",1300, true, "Abilities\\Weapons\\GargoyleMissile\\GargoyleMissile.mdl")
call SaveBoolean(TABLE_HY, GetHandleId(t), 100, true)
call SaveInteger(TABLE_HY, GetHandleId(t), 101, SuijiMode_GetDurationMulticastCount(ZX7,'A0NQ'))
call GroupRemoveUnit(g,IH7)
loop
exitwhen FirstOfGroup(g)==null or i>=MAX
set IH7=M59(g,GetUnitX(IH7),GetUnitY(IH7))
call GroupRemoveUnit(g,IH7)
if WQ7(IH7) then
    call PLK(IH7)
else
    set t=NHX(ZX7, IH7,'h0HH', "MDE",1300, true, "Abilities\\Weapons\\GargoyleMissile\\GargoyleMissile.mdl")
    call SaveInteger(TABLE_HY, GetHandleId(t), 101, SuijiMode_GetDurationMulticastCount(ZX7,'A0NQ'))
endif
set i=i+1
endloop
call WR7(g)
set g=null
set ZX7=null
set IH7=null
set t=null
endfunction
//剧毒之触
function K_E takes nothing returns boolean
if B287_GetSpellAbilityId()=='A0NQ' and WQ7(GetSpellTargetUnit())==false then
        call JDZC()
endif
return false
endfunction
function KF8 takes nothing returns nothing
local trigger t=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function K_E))
set t=null
endfunction
function MFE takes real BZ7 returns string
if BZ7>4.5 then
return"5.0"
elseif BZ7>4. then
return"4.5"
elseif BZ7>3.5 then
return"4.0"
elseif BZ7>3. then
return"3.5"
elseif BZ7>2.5 then
return"3.0"
elseif BZ7>2. then
return"2.5"
elseif BZ7>1.5 then
return"2.0"
elseif BZ7>1. then
return"1.5"
elseif BZ7>.5 then
return"1.0"
elseif BZ7>.0 then
return"0.5"
else
return"0.0"
endif
return" "
endfunction
function BZ_TEXT takes string YY7,unit IH7,unit WX7 returns nothing
local texttag tt=CreateTextTag()
call SetTextTagText(tt,YY7,.033)
call SetTextTagPosUnit(tt,IH7,64)
call SetTextTagColor(tt,$A0,0,$FF,$FF)
call SetTextTagVelocity(tt,0,.0355)
call SetTextTagFadepoint(tt,.15)
call SetTextTagPermanent(tt,false)
call SetTextTagLifespan(tt,.65)
call SetTextTagVisibility(tt,true)
set tt=null
endfunction
function MGE takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit IH7=O77(I97,"Target")
local integer WF8=GetTriggerEvalCount(t)
if WF8>$B or UnitAlive(IH7)==false then
call FlushChildHashtable(L7,(I97))
call OZ7(t)
else
call BZ_TEXT(MFE(5.5-.5*WF8),IH7,IH7)
endif
set t=null
set IH7=null
return false
endfunction
function MHE takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit m5=O77(OB7,"Target")
local real MIE=ON7(OB7,"Damage")
local real MJE=0.
local real MKE=0.
if m5==null or GetUnitTypeId(m5)==0 then
call NM7(OB7)
call OZ7(t)
set t=null
set m5=null
return false
endif
set MJE=YK7(GetUnitState(m5,UNIT_STATE_LIFE)-MIE,2)
set MKE=ON7(GetHandleId(m5),"ShallowGrave|FakeLife")
call SetUnitState(m5,UNIT_STATE_LIFE,MJE)
call NQ7(GetHandleId(m5),"ShallowGrave|FakeLife",MKE-MIE)
call NM7(OB7)
call OZ7(t)
set t=null
set m5=null
return false
endfunction
function MME takes unit m5,real MIE returns nothing
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local real MKE=ON7(GetHandleId(m5),"ShallowGrave|FakeLife")
call NT7(OB7,"Target",m5)
call NQ7(OB7,"Damage",MIE)
call NQ7(GetHandleId(m5),"ShallowGrave|FakeLife",MKE+MIE)
call TriggerRegisterTimerEvent(t,0,false)
call TriggerAddCondition(t,Condition(function MHE))
set t=null
endfunction
function MNE takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit m5
local real Wx
local real MIE
local integer iX=GetTriggerEvalCount(t)
local real MKE
local real MOE=ON7(OB7,"LastFrame")
local real MPE=ON7(OB7,"FrameDamage")
local boolean b=OO7(OB7,"HaveA")
if MOE!=KQ7()then
set MOE=KQ7()
set MPE=0
call NQ7(OB7,"LastFrame",MOE)
call NQ7(OB7,"FrameDamage",MPE)
endif
if GetTriggerEventId()==EVENT_UNIT_DAMAGED then
set m5=GetTriggerUnit()
set MKE=ON7(GetHandleId(m5),"ShallowGrave|FakeLife")
set Wx=GetUnitState(m5,UNIT_STATE_LIFE)
set MIE=GetEventDamage()
if((Wx-MKE-MPE)-MIE)<1 then
call SetUnitState(m5,UNIT_STATE_LIFE,Wx+MIE+MPE)
call MME(m5,MIE)
else
set MPE=MPE+MIE
call NQ7(OB7,"FrameDamage",MPE)
endif
else
call SaveInteger(L7,(GetHandleId(((LoadUnitHandle(L7,(OB7),(17)))))),((2485)),(2))
call OX7(O77(OB7,"Target"),"ShallowGrave|Active")
call DestroyEffect(OG7(OB7,"FX"))
call UnitRemoveAbility(O77(OB7,"Target"),'A21I')
call UnitRemoveAbility(O77(OB7,"Target"),'B07D')
    if b then
        call YZ8(O77(OB7,"Target"))
        call YW8(O77(OB7,"Target"),0,0)
    endif
call NM7(OB7)
call OZ7(t)
endif
set m5=null
set t=null
return false
endfunction
function MQE takes nothing returns nothing
local trigger t=CreateTrigger()
local integer I97=GetHandleId(t)
local unit p5=GetTriggerUnit()
local unit IH7=Unit_BZ
local boolean b=false
if SuijiMode_HasAghanimState(p5) then
    set b=true
endif
call XF7(IH7,'A21I')
call TriggerRegisterTimerEvent(t,5,false)
call TriggerRegisterUnitEvent(t,IH7,EVENT_UNIT_DAMAGED)
call TriggerAddCondition(t,Condition(function MNE))
call NU7(I97,"FX",AddSpecialEffectTarget("war3mapImported\\DarkHands.mdx",IH7,"overhead"))
call NQ7(GetHandleId(IH7),"ShallowGrave|FakeLife",0)
call NQ7(I97,"LastFrame",KQ7())
call NQ7(I97,"FrameDamage",0)
call NT7(I97,"Target",IH7)
call NS7(I97,"HaveA",b)
call OV7(IH7,"ShallowGrave|Active")
call SaveInteger(L7,(GetHandleId((IH7))),((2485)),(1))
set t=CreateTrigger()
set I97=GetHandleId(t)
call TriggerRegisterTimerEvent(t,.5,true)
call TriggerRegisterTimerEvent(t,0,false)
call TriggerAddCondition(t,Condition(function MGE))
call NT7(I97,"Target",IH7)
set t=null
set p5=null
set IH7=null
endfunction
