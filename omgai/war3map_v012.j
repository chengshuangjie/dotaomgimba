//回光
function Q7D takes unit WI7 returns nothing
local trigger t=null
if WI7==null or GetUnitTypeId(WI7)==0 then
return
endif
set t=CreateTrigger()
call TriggerRegisterUnitEvent(t,WI7,EVENT_UNIT_DAMAGED)
call TriggerRegisterUnitEvent(t,WI7,EVENT_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function Q4D))
set t=null
endfunction
function Q8D takes nothing returns boolean
if (B287_GetLearnedSkill()=='A0NS' or B287_GetLearnedSkill()=='A1DA') and IsUnitIllusion(GetTriggerUnit())==false and (B287_GetUnitAbilityLevel(GetTriggerUnit(),'A0NS')==1 or B287_GetUnitAbilityLevel(GetTriggerUnit(),'A1DA')==1) then
call Q7D(GetTriggerUnit())
endif
return false
endfunction
function JM8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_HERO_SKILL)
call TriggerAddCondition(t,Condition(function Q8D))
set t=null
endfunction
function QDD takes nothing returns boolean
local integer level
if B287_GetSpellAbilityId()=='A4LQ' then
	set level=IMaxBJ(B287_GetUnitAbilityLevel(GetTriggerUnit(),'A0MG'),1)
	if ISLABIKE(GetTriggerUnit()) then
		set level=4
	endif
	call Z57(GetSpellTargetUnit(),'A4LP',1,20,'B0KR')
	call NP7(GetHandleId(GetSpellTargetUnit()),"SZAS|Level",level)
endif
return false
endfunction
function JK8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function QDD))
set t=null
endfunction
function GetSZASBar takes unit u returns string
local integer W9I=LoadInteger(TABLE_XJ,(GetHandleId(u)),('A0MG'))
local string c1="|c001100ff"
local string c2=" ! "
local string s="|r"
local string szasBarText=""
    if W9I==4 then
    set szasBarText=c1+c2+c2+c2+c2+s
    elseif W9I==3 then
    set szasBarText=c1+c2+c2+c2+s+c2
    elseif W9I==2 then
    set szasBarText=c1+c2+c2+s+c2+c2
    elseif W9I==1 then
    set szasBarText=c1+c2+s+c2+c2+c2
    endif
    return szasBarText
endfunction
function SZAS_OnCount takes nothing returns boolean
    local trigger t=GetTriggeringTrigger()
    local integer HEI=GetHandleId(t)
    local unit ZX7=(LoadUnitHandle(TABLE_XJ,(HEI),(2)))
    local unit IH7=(LoadUnitHandle(TABLE_XJ,(HEI),(17)))
    local real XDI=(TimerGetElapsed(W))
    local real U3O=(LoadReal(TABLE_XJ,(HEI),(34)))
    local texttag tt=(LoadTextTagHandle(TABLE_XJ,(HEI),(231)))
    if IH7==null or GetUnitTypeId(IH7)==0 or ZX7==null or GetUnitTypeId(ZX7)==0 then
    call DestroyTextTag(tt)
    if IH7!=null then
    call SaveInteger(TABLE_XJ,(GetHandleId(IH7)),('A0MG'),(0))
    call RemoveSavedHandle(TABLE_XJ,(GetHandleId(IH7)),('A0MG'))
    endif
    call FlushChildHashtable(TABLE_XJ,(HEI))
    call OZ7(t)
    set t=null
    set tt=null
    set ZX7=null
    set IH7=null
    return false
    endif
    if GetTriggerEventId()==EVENT_UNIT_DEATH then
    call DestroyTextTag(tt)
    call SaveInteger(TABLE_XJ,(GetHandleId(IH7)),('A0MG'),(0))
	call RemoveSavedHandle(TABLE_XJ,(GetHandleId(IH7)),('A0MG'))
    call FlushChildHashtable(TABLE_XJ,(HEI))
    call OZ7(t)
    elseif GetTriggerEventId()==EVENT_UNIT_DAMAGED then
    	if (B287_GetUnitAbilityLevel(GetEventDamageSource(),'A0MG')>0 or GetUnitAbilityLevel(GetEventDamageSource(),'B0KR')>0) and GetEventDamage()>0 and YDWEIsEventPhysicalDamage() then
    		call SaveReal(TABLE_XJ,(HEI),(34),(((TimerGetElapsed(W)))*1.0))
    	endif
    else
    if XDI-U3O>5 or LoadInteger(TABLE_XJ,(GetHandleId(IH7)),('A0MG'))>=4 then
    call DestroyTextTag(tt)
    call SaveInteger(TABLE_XJ,(GetHandleId(IH7)),('A0MG'),(0))
	call RemoveSavedHandle(TABLE_XJ,(GetHandleId(IH7)),('A0MG'))
    call FlushChildHashtable(TABLE_XJ,(HEI))
    call OZ7(t)
    else
    call SetTextTagText(tt,GetSZASBar(IH7),0.02)
    call SetTextTagPosUnit(tt,IH7,0)
    call SetTextTagVisibility(tt, IsUnitAlly(ZX7,GetLocalPlayer()) and IsUnitVisible(IH7,GetLocalPlayer()) )
    endif
    endif
    set t=null
    set tt=null
    set ZX7=null
    set IH7=null
    return false
endfunction
function SZAS_count takes unit ZX7,unit IH7 returns nothing
    local trigger t
    local integer HEI
    local texttag tt
    if UnitAlive(IH7) then
    set t=CreateTrigger()
    set HEI=GetHandleId(t)
    set tt=CreateTextTag()
    call SetTextTagText(tt,GetSZASBar(IH7),0.02)
    call SetTextTagPosUnit(tt,IH7,0)
    call SetTextTagVisibility(tt,IsUnitAlly(ZX7,GetLocalPlayer()) and IsUnitVisible(IH7,GetLocalPlayer()))
    call SetTextTagPermanent(tt,true)
    call TriggerRegisterTimerEvent(t,0.05,true)
    call TriggerRegisterUnitEvent(t,IH7,EVENT_UNIT_DEATH)
    call TriggerRegisterUnitEvent(t,IH7,EVENT_UNIT_DAMAGED)
    call TriggerAddCondition(t,Condition(function SZAS_OnCount))
    call SaveUnitHandle(TABLE_XJ,(HEI),(2),(ZX7))
    call SaveUnitHandle(TABLE_XJ,(HEI),(17),(IH7))
    call SaveReal(TABLE_XJ,(HEI),(34),(((TimerGetElapsed(W)))*1.0))
    call SaveTextTagHandle(TABLE_XJ,(HEI),(231),(tt))
	call SaveTriggerHandle(TABLE_XJ,(GetHandleId(IH7)),('A0MG'),(t))
    endif
    set t=null
    set tt=null
endfunction
function SZAS_add takes unit ZX7,unit IH7 returns nothing
    local integer WQI=LoadInteger(TABLE_XJ,(GetHandleId(IH7)),('A0MG'))
	local unit BB7
    if WQI==0 then
        call SZAS_count(ZX7,IH7)
    endif
    set WQI=YG7(WQI+1,4)
    if WQI==4 then
set BB7=CreateUnit(GetOwningPlayer(ZX7),'e00E',GetUnitX(IH7),GetUnitY(IH7),0)
		call XF7(BB7,'A4LG')
		call IssueTargetOrderById(BB7,$D02BC,IH7)
		set BB7=null
    endif
    call SaveInteger(TABLE_XJ,(GetHandleId(IH7)),('A0MG'),(WQI))
endfunction
function SZAS_Range_PD takes nothing returns boolean
return (IsUnitEnemy(IN4,GetOwningPlayer(GetFilterUnit())) and GetUnitAbilityLevel(GetFilterUnit(),'A04R')==0 and IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==false and IsHideUnit(GetFilterUnit())==false and CHUIFENG(GetFilterUnit())==false and WF7(GetFilterUnit())==false and (AK7(GetFilterUnit())==false or IsUnitVisible(GetFilterUnit(),GetOwningPlayer(IN4))) and XH7(GetFilterUnit())==false)!=null
endfunction
function Get_SZAS_BAD_BUFF takes integer level returns integer
	local integer skill
	if level==4 then
		set skill='A4LK'
	elseif level==3 then
		set skill='A4LJ'
	elseif level==2 then
		set skill='A4LI'
	else
		set skill='A4LH'
	endif
	return skill
endfunction
function Get_SZAS_GOOD_BUFF takes integer level returns integer
	local integer skill
	if level==4 then
		set skill='A4LO'
	elseif level==3 then
		set skill='A4LN'
	elseif level==2 then
		set skill='A4LM'
	else
		set skill='A4LL'
	endif
	return skill
endfunction
function REFRESH_ADD_SZAS takes unit ZX7,unit IH7 returns nothing
	local trigger t
	local integer n
	if UnitAlive(IH7) and IsUnitType(IH7,UNIT_TYPE_HERO) and GetUnitAbilityLevel(IH7,'B0KQ')==0 and WF7(IH7)==false then
		set n=LoadInteger(TABLE_XJ,(GetHandleId(IH7)),('A0MG'))
		if n==1 or n==2 then
			set t=LoadTriggerHandle(TABLE_XJ,(GetHandleId(IH7)),('A0MG'))
			if t!=null then
			call SaveReal(TABLE_XJ,(GetHandleId(t)),(34),(((TimerGetElapsed(W)))*1.0))
			endif
			set t=null
		endif
		call SZAS_add(ZX7,IH7)
	endif
endfunction
function SZAS_Range_TRI takes nothing returns nothing
	local unit IH7=GetEnumUnit()
	local integer skill=Get_SZAS_BAD_BUFF(IH4)
	call Z57(IH7,skill,1,3.5,'B066')
	call REFRESH_ADD_SZAS(IN4,IH7)
	set IH7=null
endfunction
function SZAS_Range takes unit ZX7,unit IH7 returns nothing
	local group g=WS7()
	local integer level=B287_GetUnitAbilityLevel(ZX7,'A0MG')
	set IH4=level
	set IN4=ZX7
	call GroupEnumUnitsInRange(g,GetUnitX(IH7),GetUnitY(IH7),275,Condition(function SZAS_Range_PD))
	call GroupRemoveUnit(g,IH7)
	call ForGroup(g,function SZAS_Range_TRI)
	call WR7(g)
	set g=null
endfunction
function SZAS_BUFF takes unit ZX7,unit IH7 returns nothing
    local integer level=B287_GetUnitAbilityLevel(ZX7,'A0MG')
	local integer skill
	local integer skill2
	if level==0 and GetUnitAbilityLevel(ZX7,'B0KR')>0 then
		set level=OM7(GetHandleId(ZX7),"SZAS|Level")
	endif
	set skill=Get_SZAS_BAD_BUFF(level)
	set skill2=Get_SZAS_GOOD_BUFF(level)
	call NP7(GetHandleId(IH7),"MarkOfTheAbyss|Level",level)
	call Z57(IH7,skill,1,3.5,'B066')
	call Z57(ZX7,skill2,1,4.5,'B065')
endfunction
function SZAS_Add_Goodbuff takes unit ZX7,unit IH7 returns nothing
    local integer level=OM7(GetHandleId(IH7),"MarkOfTheAbyss|Level")
	local integer skill2=Get_SZAS_GOOD_BUFF(level)
		call Z57(ZX7,skill2,1,4.5,'B065')
endfunction
function ZCSZAS takes nothing returns boolean
    //非建筑非守卫敌对非魔免
    if (B287_GetUnitAbilityLevel(WXX,'A0MG')>0 or GetUnitAbilityLevel(WXX,'B0KR')>0) and ISPH(WXX)==false and LoadBoolean(TABLE_HY, EOO, 11)== false and LoadBoolean(TABLE_HY, EOO, 14) and LoadBoolean(TABLE_HY, EOO, 15) and WF7(YXX)==false and UnitAlive(YXX) then
		call SZAS_BUFF(WXX,YXX)
        if IsUnitType(YXX,UNIT_TYPE_HERO) and GetUnitAbilityLevel(YXX,'B0KQ')==0 then
            call SZAS_add(WXX,YXX)
        endif
		if (B287_GetUnitAbilityLevel(WXX,'A0MG')>0 and GetUnitAbilityLevel(WXX,'B0KR')>0) then
			call SZAS_Range(WXX,YXX)
		endif
	elseif IsUnitType(WXX, UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(WXX,'A04R')==0 and GetUnitAbilityLevel(YXX,'B066')>0 then
			call SZAS_Add_Goodbuff(WXX,YXX)
    endif
return false
endfunction
function WU takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer OB7=GetHandleId(t)
local unit WI7=O77(OB7,"Hero")
local real YM7=ON7(OB7,"Damage")
if WI7!=null and GetUnitTypeId(WI7)!=0 and GetUnitState(WI7,UNIT_STATE_LIFE)>1 then
if GetUnitState(WI7,UNIT_STATE_LIFE)<=YM7 then
call SetUnitState(WI7,UNIT_STATE_LIFE,YM7+1)
endif
call SetUnitState(WI7,UNIT_STATE_LIFE,GetUnitState(WI7,UNIT_STATE_LIFE)-YM7)
endif
call NM7(OB7)
call PauseTimer(t)
call DestroyTimer(t)
set t=null
set WI7=null
endfunction
function SWCR_PD takes nothing returns boolean
	return UnitAlive(GetFilterUnit()) and IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(GetFilterUnit(),'A04R')==0 and CHUIFENG(GetFilterUnit())==false and IsHideUnit(GetFilterUnit())==false and IsUnitVisible(GetFilterUnit(),GetOwningPlayer(U22))
endfunction
function SWCR_TRI takes nothing returns nothing
local unit ZX7=U22
local unit m5=GetEnumUnit()
if IsUnitAlly(m5,GetOwningPlayer(ZX7)) then
	call SetUnitState(m5,UNIT_STATE_LIFE,GetUnitState(m5,UNIT_STATE_LIFE)+IJ4*DGH_BUFF(m5))
else
	call B67(ZX7,m5,1,IK4)
	call REFRESH_ADD_SZAS(ZX7,m5)
endif
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\AnimateDead\\AnimateDeadTarget.mdl",m5,"origin"))
set ZX7=null
set m5=null
endfunction
function P3D takes nothing returns nothing
local unit WI7=GetTriggerUnit()
local unit IH7=GetSpellTargetUnit()
local real x=GetUnitX(IH7)
local real y=GetUnitY(IH7)
local integer level=B287_GetUnitAbilityLevel(WI7,'A0I3')
local real YM7=25*level
local timer t=CreateTimer()
local integer OB7=GetHandleId(t)
local real recover
local real damage
local group g
local real now_life=GetUnitState(WI7,UNIT_STATE_LIFE)
local real d=GetHeroStr(WI7,true)*0.5
set recover=50*level
set damage=25+75*level
if SuijiMode_HasAghanimState(WI7) then
	set recover=recover+d
	set damage=damage+d
endif
set g=WS7()
set U22=WI7
set IJ4=recover
set IK4=damage
call GroupEnumUnitsInRange(g,x,y,300,Condition(function SWCR_PD))
call GroupRemoveUnit(g,WI7)
call ForGroup(g,function SWCR_TRI)
call WR7(g)
call NT7(OB7,"Hero",WI7)
call NQ7(OB7,"Damage",YM7)
call TimerStart(t,0,false,function WU)
call LINGXIA(WI7,IH7)
set WI7=null
set IH7=null
set t=null
set g=null
endfunction
function PCD takes nothing returns boolean
if B287_GetSpellAbilityId()=='A0I3' and (IsUnitEnemy(GetSpellTargetUnit(),GetOwningPlayer(GetTriggerUnit()))==false or WQ7(GetSpellTargetUnit())==false) then
	call P3D()
endif
return false
endfunction
function PCD_PD takes nothing returns boolean
if B287_GetSpellAbilityId()=='A0I3' then
if GetUnitState(GetTriggerUnit(),UNIT_STATE_LIFE)<B287_GetUnitAbilityLevel(GetTriggerUnit(),'A0I3')*25 then
		call KR7(GetTriggerUnit())
		call X37(GetOwningPlayer(GetTriggerUnit()),"生命值不足以使用技能")
	endif
endif
return false
endfunction
function JJ8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function PCD))
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_CAST)
call TriggerAddCondition(t,Condition(function PCD_PD))
set t=null
endfunction
function QFD takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local unit IH7=(LoadUnitHandle(L7,(I97),(17)))
local integer BC7=(LoadInteger(L7,(I97),(5)))
local integer WF8=(LoadInteger(L7,(I97),(34)))
local integer durationTicks=LoadInteger(L7,I97,StringHash("SuijiDurationTicks"))
local real VW9
local integer BZ7
local unit VX8
if durationTicks<=0 then
set durationTicks=10
endif
if ZX7==null or IH7==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 then
call DestroyEffect((LoadEffectHandle(L7,(I97),(32))))
call FlushChildHashtable(L7,(I97))
call OZ7(t)
set t=null
set ZX7=null
set IH7=null
set VX8=null
return false
endif
if BC7==1 then
set VW9=16
set BZ7=$A
elseif BC7==2 then
set VW9=24
set BZ7=$A
elseif BC7==3 then
set VW9=32
set BZ7=10
elseif BC7==4 then
set VW9=40
set BZ7=10
endif
if GetTriggerEventId()==EVENT_UNIT_SPELL_EFFECT then
if GetTriggerEvalCount(t)>1 and B287_GetSpellAbilityId()=='A0S1' and WQ7(GetSpellTargetUnit())==false and IH7==GetSpellTargetUnit() then
        call DestroyEffect((LoadEffectHandle(L7,(I97),(32))))
        call FlushChildHashtable(L7,(I97))
        call OZ7(t)
    endif
elseif GetTriggerEventId()==EVENT_PLAYER_UNIT_DEATH then
    set VX8=GetKillingUnit()
    if C37(VX8)then
        set VX8=(M7[GetPlayerId(GetOwningPlayer((VX8)))])
    endif
    if GetTriggerUnit()==IH7 or VX8==IH7 then
        call DestroyEffect((LoadEffectHandle(L7,(I97),(32))))
        call FlushChildHashtable(L7,(I97))
        call OZ7(t)
call UnitRemoveAbility(IH7,'A1W3')
call UnitRemoveAbility(IH7,'B0DO')
    endif
else
    set WF8=WF8+1
    call SaveInteger(L7,(I97),(34),(WF8))
if WF8>=durationTicks or GetUnitAbilityLevel(IH7,'B0DO')==0 or WF7(IH7) then
        call DestroyEffect((LoadEffectHandle(L7,(I97),(32))))
        call FlushChildHashtable(L7,(I97))
        call OZ7(t)
call UnitRemoveAbility(IH7,'A1W3')
call UnitRemoveAbility(IH7,'B0DO')
    endif
    call B67(ZX7,IH7,1,VW9)
    if WF8==1 then
        call LINGXIA(ZX7,IH7)
    endif
endif
set t=null
set ZX7=null
set IH7=null
set VX8=null
return false
endfunction
function QGD takes nothing returns nothing
local trigger t=CreateTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=GetTriggerUnit()
local unit IH7=GetSpellTargetUnit()
local integer BC7=B287_GetUnitAbilityLevel(ZX7,'A0S1')
local integer id=GetUnitTypeId(ZX7)
local string tx
local string tx2
if id=='Zpgh' then
    set tx="model\\Hero_Axe_N9S_R_Target_1.mdl"
    set tx2="model\\Hero_Axe_N9S_R_Target_2.mdl"
elseif id=='Zpgi' then
    set tx="model\\Hero_Axe_N4S_R_Target_1.mdl"
    set tx2="model\\Hero_Axe_N4S_R_Target_2.mdl"
elseif id=='Zpgj' then
    set tx="AZModel\\AZ_AxeCold_R1.mdl"
    set tx2="AZModel\\AZ_AxeCold_R_BUFF.mdl"
else
    set tx="Abilities\\Spells\\Demon\\ReviveDemon\\ReviveDemon.mdl"
    set tx2="Abilities\\Spells\\Other\\SoulBurn\\SoulBurnbuff.mdl"
endif
call DestroyEffect(AddSpecialEffectTarget(tx,IH7,"overhead"))
call SetPlayerAbilityAvailable(GetOwningPlayer(IH7),'A1W3',false)
call XF7(IH7,'A1W3')
call TriggerRegisterTimerEvent(t,1,true)
call YB7(t,EVENT_PLAYER_UNIT_DEATH)
call TriggerRegisterUnitEvent(t,ZX7,EVENT_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function QFD))
call SaveUnitHandle(L7,(I97),(2),(ZX7))
call SaveUnitHandle(L7,(I97),(17),(IH7))
call SaveInteger(L7,(I97),(5),(BC7))
call SaveInteger(L7,(I97),(34),(0))
call SaveInteger(L7,I97,StringHash("SuijiDurationTicks"),10*SuijiMode_GetDurationMulticastCount(ZX7,'A0S1'))
call SaveEffectHandle(L7,(I97),(32),(AddSpecialEffectTarget(tx2,IH7,"overhead")))
set ZX7=null
set IH7=null
set t=null
endfunction
function QID takes nothing returns nothing
if GetUnitAbilityLevel(GetEnumUnit(),'B0DO')>0 and IsUnitEnemy(IN4,GetOwningPlayer(GetEnumUnit())) and GetUnitAbilityLevel(GetEnumUnit(),'A04R')==0 then
set EX7=EX7+1
endif
endfunction
function QJD takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local group g=WS7()
if ZX7==null or GetUnitTypeId(ZX7)==0 or B287_GetUnitAbilityLevel(ZX7,'A0S1')<=0 then
call WR7(g)
call FlushChildHashtable(L7,(I97))
call OZ7(t)
set t=null
set ZX7=null
set g=null
return false
endif
set IN4=ZX7
set EX7=0
// call GroupEnumUnitsInRange(g,0,0,9999,Condition(function AJ7_gai))
call GroupAddGroup(PlayerUnitGroup,g)
call ForGroup(g,function QID)
call WR7(g)
if EX7==0 then
if GetUnitAbilityLevel(ZX7,'B0EZ')>0 then
call UnitRemoveAbility(ZX7,'A2AR')
call UnitRemoveAbility(ZX7,'A2AS')
call UnitRemoveAbility(ZX7,'A2AU')
call UnitRemoveAbility(ZX7,'A2AT')
call UnitRemoveAbility(ZX7,'A2AQ')
call UnitRemoveAbility(ZX7,'A2AP')
call UnitRemoveAbility(ZX7,'B0EZ')
endif
elseif EX7==1 then
if GetUnitAbilityLevel(ZX7,'A2AR')==0 then
call UnitRemoveAbility(ZX7,'A2AR')
call UnitRemoveAbility(ZX7,'A2AS')
call UnitRemoveAbility(ZX7,'A2AU')
call UnitRemoveAbility(ZX7,'A2AT')
call UnitRemoveAbility(ZX7,'A2AQ')
call UnitRemoveAbility(ZX7,'A2AP')
call UnitRemoveAbility(ZX7,'B0EZ')
call UnitAddAbility(ZX7,'A2AR')
endif
elseif EX7==2 then
if GetUnitAbilityLevel(ZX7,'A2AS')==0 then
call UnitRemoveAbility(ZX7,'A2AR')
call UnitRemoveAbility(ZX7,'A2AS')
call UnitRemoveAbility(ZX7,'A2AU')
