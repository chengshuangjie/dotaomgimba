			// 狼人(40) * (1.6 1.8 2)
			set level=B287_GetUnitAbilityLevel(ZX7,'A2PX')
			if level > 0 and GetPrdRandom(ZX7 , 'A2PX' , 40.) then
				set Damagerate=1.4+level*.2
