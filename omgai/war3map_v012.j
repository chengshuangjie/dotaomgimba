call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,E9,10,GetObjectName('n08F'))
return false
endif
if KY9(GetTriggerPlayer())==false then
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,E9,10,GetObjectName('n08H'))
return false
endif
return true
endfunction
