function S4D takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer V07=GetHandleId(t)
local unit Z69=(LoadUnitHandle(L7,(V07),(2)))
local real S7D=0.
if Z69==null or GetUnitTypeId(Z69)==0 then
call FlushChildHashtable(L7,(V07))
call OZ7(t)
set t=null
set Z69=null
return false
endif
set S7D=GetUnitState(Z69,UNIT_STATE_LIFE)
if (GetTriggerEventId()==EVENT_UNIT_SPELL_EFFECT and B287_GetSpellAbilityId()!='A04Q') or (GetTriggerEventId()==EVENT_UNIT_SPELL_EFFECT and B287_GetSpellAbilityId()=='A04Q' and GetTriggerEvalCount(t)==1) then
elseif GetTriggerEventId()==EVENT_UNIT_SPELL_EFFECT and B287_GetSpellAbilityId()=='A04Q' then
call FlushChildHashtable(L7,(V07))
call OZ7(t)
else
call UnitRemoveAbility(Z69,'A1R0')
call UnitRemoveAbility(Z69,'B0D5')
call B_7(Z69,0)
call C77(Z69,0)
call SetUnitState(Z69,UNIT_STATE_LIFE,S7D)
call FlushChildHashtable(L7,(V07))
call OZ7(t)
endif
set t=null
set Z69=null
return false
endfunction
function S8D takes nothing returns nothing
local unit Z69=GetTriggerUnit()
local unit ZZ9=GetSpellTargetUnit()
local trigger t=null
local integer V07=0
local integer KP7=B287_GetUnitAbilityLevel(Z69,'A04Q')
local real S9D=0
local real S7D=GetUnitState(Z69,UNIT_STATE_LIFE)
local integer SDD
local integer SED
local boolean HaveA=false
if SuijiMode_IsSacrificeProtectedTarget(ZZ9) then
set Z69=null
set ZZ9=null
set t=null
return
endif
set t=CreateTrigger()
set V07=GetHandleId(t)
set S9D=GetUnitState(ZZ9,UNIT_STATE_LIFE)
if SuijiMode_HasAghanimState(Z69) then
    set HaveA=true
    set S9D=RMaxBJ(1200.,S9D)
endif
set SDD=R2I((.03+.02*KP7)*S9D)
set SED=R2I((.3+.20*KP7)*S9D)
call B_7(Z69,SDD)
call C77(Z69,SED)
call XF7(Z69,'A1R0')
call SetUnitState(ZZ9,UNIT_STATE_LIFE,1)
call B67(Z69,ZZ9,2,20)
call B67(Z69,ZZ9,1,20)
call B67(Z69,ZZ9,3,20)
call SetUnitState(Z69,UNIT_STATE_LIFE,S7D+SED)
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl",ZZ9,"chest"))
call SaveUnitHandle(L7,(V07),(2),(Z69))
call TriggerRegisterUnitEvent(t,Z69,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(t,Z69,EVENT_UNIT_SPELL_EFFECT)
if HaveA==false then
call TriggerRegisterTimerEvent(t,65,false)
endif
call TriggerAddCondition(t,Condition(function S4D))
set Z69=null
set ZZ9=null
set t=null
endfunction
function SFD takes nothing returns boolean
if B287_GetSpellAbilityId()=='A04Q' and GetUnitState(GetTriggerUnit(),UNIT_STATE_LIFE)>.5 and KW7(GetSpellTargetUnit())==false and SuijiMode_IsSacrificeProtectedTarget(GetSpellTargetUnit())==false then
call S8D()
endif
return false
endfunction
