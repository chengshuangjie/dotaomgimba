function YBB takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit p5=(LoadUnitHandle(L7,(I97),(2)))
local unit m5=(LoadUnitHandle(L7,(I97),(17)))
local integer M4I=(LoadInteger(L7,(I97),(34)))
local integer d=(LoadInteger(L7,(I97),(50)))
local real YM7=(LoadReal(L7,(I97),(100)))
local integer WF8=GetTriggerEvalCount(t)
if p5==null or m5==null then
call SuijiDoom_RemoveTargetAbilities(m5)
call FlushChildHashtable(L7,(I97))
call OZ7(t)
set t=null
set p5=null
set m5=null
return false
endif
if Ma(p5,m5)>900 or XH7(p5)==true then
set M4I=M4I+1
call SaveInteger(L7,(I97),(34),(M4I))
endif
if M4I>d*10 then
call SuijiDoom_RemoveTargetAbilities(m5)
call FlushChildHashtable(L7,(I97))
call OZ7(t)
elseif GetUnitAbilityLevel(m5,'BNdd')==0 then
call SuijiDoom_RemoveTargetAbilities(m5)
call FlushChildHashtable(L7,(I97))
call OZ7(t)
else
call B67(p5,m5,8,YM7)
    if WF8==1 then
        call LINGXIA(p5,m5)
    endif
endif
set t=null
set p5=null
set m5=null
return false
endfunction
function YCC takes nothing returns nothing
local unit p5=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local trigger t=null
local integer I97=0
local integer d=12
local integer id=0
local integer i=0
local integer level=0
local real YM7=0.
local integer suijiDoomHandle=0
if p5==null or m5==null or GetUnitTypeId(p5)==0 or GetUnitTypeId(m5)==0 then
set p5=null
set m5=null
return
endif
set id=GetUnitTypeId(p5)
set i=GetPlayerId(GetOwningPlayer(p5))
set level=SuijiMode_GetPairCastLevel(p5,B287_GetSpellAbilityId(),'A0MU','A0A2')
set YM7=20+30*level
if SuijiMode_HasAghanimState(p5) then
    set YM7=35+35*level
    set d=16
endif
if SUIJI_MODE then
set suijiDoomHandle=GetHandleId(p5)
if LoadReal(L7,suijiDoomHandle,StringHash("SuijiDoomBlockUntil"))>TimerGetElapsed(W) then
set p5=null
set m5=null
return
endif
call SaveReal(L7,suijiDoomHandle,StringHash("SuijiDoomBlockUntil"),TimerGetElapsed(W)+.60)
endif
call SuijiMode_StartPairCooldownSync(p5,B287_GetSpellAbilityId(),'A0MU','A0A2',"SuijiDoomCooldown",100.,100.,100.,80.,80.,80.)
set t=CreateTrigger()
set I97=GetHandleId(t)
if IsUnitType(m5, UNIT_TYPE_HERO) or AS7(m5) then
    if SPEPLAYER[i]==1 and ISLABIKE(p5) then
        call YW7("爸爸赏你个大宝贝！",5,p5,.03,$FF,$FF,0,$FF)
    else
        call YW7("父爱如山！",5,p5,.03,$FF,$FF,0,$FF)
    endif
elseif IsUnitIllusion(m5) then
call YW7("震惊！末日竟然大幻象了！",10,m5,.05,$FF,$FF,0,$FF)
else
call YW7("震惊！末日竟然大小兵了！",10,m5,.05,$FF,$FF,0,$FF)
endif
call UnitRemoveBuffs(m5,true,false)
call RemoveUnitGoodBuff(m5,false)
call RemoveRYBF(m5)
if id=='ZC42' then
    call XF7(m5,'A4GD')
    call XF7(m5,'A4GE')
elseif id=='ZC43' then
    call XF7(m5,'A4GG')
    call XF7(m5,'A4GH')
else
    call XF7(m5,'A4DH')
endif
call TriggerRegisterTimerEvent(t,0.1,true)
call TriggerAddCondition(t,Condition(function YBB))
call SaveUnitHandle(L7,(I97),(2),(p5))
call SaveUnitHandle(L7,(I97),(17),(m5))
call SaveInteger(L7,(I97),(34),(0))
call SaveInteger(L7,(I97),(50),(d))
call SaveReal(L7,(I97),(100),(YM7/10.))
set p5=null
set m5=null
set t=null
endfunction
