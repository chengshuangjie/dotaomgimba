function IB9 takes nothing returns nothing
local player p=GetTriggerPlayer()
local unit u=M7[GetPlayerId(p)]
if u==null then
    call DisplayTextToPlayer(GetTriggerPlayer(),0,0, "英雄不存在，无法重建")
    set u=null
    set p=null
    return
endif
if UnitAlive(u)==false then
    call DisplayTextToPlayer(GetTriggerPlayer(),0,0, "英雄已死亡，无法重建")
    set u=null
    set p=null
