function SAYM takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit WI7=O77(OB7,"Hero")
local real YM7=ON7(OB7,"YM7")
local real x=ON7(OB7,"X")
local real y=ON7(OB7,"Y")
local integer level=OM7(OB7,"level")
local group g
local boolexpr staticStormDamageFilter=null
local integer WF8=GetTriggerEvalCount(t)
if WF8>12 then
	call NM7(OB7)
	call OZ7(t)
else
	set g=WS7()
	set IM4=YM7
	set FB=WI7
	set IN4=WI7
	set staticStormDamageFilter=Condition(function AJ7_gai)
	call GroupEnumUnitsInRange(g,x,y,225+level*25,staticStormDamageFilter)
	call DestroyBoolExpr(staticStormDamageFilter)
	call ForGroup(g,function SAYM2)
	call WR7(g)
endif
set t=null
set WI7=null
set g=null
set staticStormDamageFilter=null
return false
endfunction
function HLD takes nothing returns nothing
local unit WI7=GetTriggerUnit()
local location l=GetSpellTargetLoc()
local real x=GetLocationX(l)
local real y=GetLocationY(l)
local unit oA=CreateUnit(GetOwningPlayer(WI7),'e003',x,y,0)
local integer level=B287_GetUnitAbilityLevel(WI7,'A0RG')
local real vr=(83+17*level)*.01
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local real YM7=level*15*0.5
call SetUnitVertexColor(oA,$FF,$FF,$FF,$96)
call UnitApplyTimedLife(oA,'BTLF',6)
call SetUnitScale(oA,vr,vr,vr)
if TW7(GetOwningPlayer(WI7))then
call XF7(oA,'A019')
call SetUnitAbilityLevel(oA,'A019',level)
else
call XF7(oA,'A0E7')
call SetUnitAbilityLevel(oA,'A0E7',level)
endif
call EnableAttackEffectByTime(13, 8.)
set YMDJ=level
call IssuePointOrderById(oA,$D01F9,x,y)
call TriggerRegisterTimerEvent(t,0.5,true)
call TriggerAddCondition(t,Condition(function SAYM))
call NT7(OB7,"Hero",WI7)
call NQ7(OB7,"YM7",YM7)
call NQ7(OB7,"X",x)
call NQ7(OB7,"Y",y)
call NP7(OB7,"level",level)
call RemoveLocation(l)
set WI7=null
set l=null
set oA=null
endfunction
