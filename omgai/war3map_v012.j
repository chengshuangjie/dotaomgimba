// endfunction
function E8O takes unit u, integer id returns boolean
	local unit d = E6O(u)
	local integer TBX = Get_Item_Price(ZU[id])
	local player p = GetOwningPlayer(u)
	local boolean b = false
    local string name
    set name=GetObjectName(ZU[id])
    set name=MHString_Sub(name , 0 , MHString_Find(name , "|n" , 0))
	if GetPlayerState(p, PLAYER_STATE_RESOURCE_GOLD)>= TBX then
		set b = true
		call SetPlayerState(p, PLAYER_STATE_RESOURCE_GOLD, GetPlayerState(p, PLAYER_STATE_RESOURCE_GOLD)-TBX)
		call E5O(d, id)
        call DisplayTimedTextToPlayer(p, 0,0,7, "已自动购买 "+"|c00fffc01"+name+"|r")
	else
		call DisplayTimedTextToPlayer(p, 0, 0, 7, L87("没有足够的金币来购买 $item", "$item", "|c00ffff00" + name+ "|r"))
	endif
	set d = null
	set p = null
	return b
endfunction
