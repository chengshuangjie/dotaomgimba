local integer OB7=GetHandleId(t)
local unit ya=(LoadUnitHandle(L7,(OB7),(19)))
local unit WI7=(LoadUnitHandle(L7,(OB7),(14)))
local integer V77=(LoadInteger(L7,(OB7),(5)))
