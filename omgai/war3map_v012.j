//删除装备
function JSCZB takes nothing returns nothing
local unit u=M7[GetPlayerId(GetTriggerPlayer())]
local integer i=S2I(SubString(GetEventPlayerChatString(),5,7))
local item ff
if u==null then
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,E9,10.,GetObjectName('n08A'))
elseif not IsUnitAliveBJ(u) then
call DisplayTextToPlayer(GetTriggerPlayer(),0,0, "请等待英雄复活")
elseif i > 0 and i < 7 then
set i=i-1
set ff=UnitItemInSlot(u,i)
if(ff!=null)and(Y_8(ff))then
call DisplayTextToPlayer(GetTriggerPlayer(),0,0, "|c00FF0000无法对A杖使用该指令|r")
else
call RemoveItem(UnitItemInSlot(u,i))
call DisplayTextToPlayer(GetTriggerPlayer(),0,0, "成功删除装备")
endif
else
call DisplayTextToPlayer(GetTriggerPlayer(),0,0,"删除装备指令使用方法：|cFF00FF00-sczb 数字|r\n(数字为1~6)，左上角为1，右下角为6")
endif
set u=null
set ff=null
endfunction
function JDEBUGON takes nothing returns nothing
set DEBUG=true
set DEBUG2=true
endfunction
function JDEBUGOFF takes nothing returns nothing
set DEBUG=false
set DEBUG2=false
endfunction
function JXSBJ takes nothing returns nothing
if GetPlayerId(GetTriggerPlayer())!=1 then
call DisplayTextToPlayer(GetTriggerPlayer(),0,0, "只有玩家1可以使用")
return
endif
set XSBJ=not XSBJ
if XSBJ==true then
call DisplayTextToPlayer(GetTriggerPlayer(),0,0, "已开启骷髅王、PA暴击具体伤害显示")
else
call DisplayTextToPlayer(GetTriggerPlayer(),0,0, "已关闭骷髅王、PA暴击具体伤害显示")
endif
endfunction
function TXSTRI takes nothing returns boolean 
local trigger t=GetTriggeringTrigger() 
local integer I97=GetHandleId(t) 
local player p=LoadPlayerHandle(TABLE_VV,I97, 0)
local unit u
call DisplayTimedTextToPlayer(p,0,0,4, "数量："+I2S(Dy))
set u=null
set t=null 
set p=null 
return false 
endfunction 
function JXSTRI takes nothing returns nothing
local trigger t
local integer I97
local player p=GetTriggerPlayer()
local integer O5=GetPlayerId(p)
if XSTRI[O5]==0 then
set XSTRI[O5]=1
set t=CreateTrigger()
set I97=GetHandleId(t)
call TriggerRegisterTimerEvent(t,1,true) 
call TriggerAddCondition(t,Condition(function TXSTRI))
call SavePlayerHandle(TABLE_VV,I97, 0, p)
call SaveTriggerHandle(TABLE_VV,GetHandleId(p), 1, t)
call DisplayTextToPlayer(p,0,0, "开启数量显示")
else
set XSTRI[O5]=0
set t=LoadTriggerHandle(TABLE_VV,GetHandleId(p),1)
if t!=null then
call OZ7(t)
endif
call DisplayTextToPlayer(p,0,0, "关闭数量显示")
endif
set t=null
set p=null
endfunction
function JXSID takes nothing returns nothing
if XSID then
call DisplayTextToPlayer(GetTriggerPlayer(),0,0, "关闭ID显示")
else
call DisplayTextToPlayer(GetTriggerPlayer(),0,0, "开启ID显示")
endif
set XSID=not XSID
endfunction
function JDISPLAY takes nothing returns nothing
	local player p = GetTriggerPlayer()
	local integer OB7 = GetHandleId(p)
	local boolean b = LoadBoolean(TABLE_P, OB7,'A0RO')
    set b=not b
    call SaveBoolean(TABLE_P, OB7,'A0RO', b)
    if b then
        call DisplayTextToPlayer(p, 0, 0, "灵能之刃作用范围显示|c00FF0000已关闭|r")
    else
        call DisplayTextToPlayer(p, 0, 0, "灵能之刃作用范围显示|cFF00FF00已开启|r")
    endif
endfunction
//预载英雄
function PRESKILL_TRI takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer n=GetTriggerEvalCount(t)
//暗牧
if n==1 then
call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "|cFF00FF00预载部分英雄技能，减少后续卡顿|r")
if LOADSKILL[90]==0 then
call ExecuteFunc("KE8")
call ExecuteFunc("KF8")
call ExecuteFunc("KG8")
call ExecuteFunc("KH8")
call RegisterUnitAttackEvent("ZCJDZC", 1)
set LOADSKILL[90]=1
endif
endif
//小黑
if n==3 then
if LOADSKILL[35]==0 then
call ExecuteFunc("Q51")
call ExecuteFunc("PP8")
call ExecuteFunc("PQ8")
set LOADSKILL[35]=1
endif
endif
//卡尔
if n==5 then
if LOADSKILL[94]==0 then
call ExecuteFunc("MP8")
call ExecuteFunc("ZCEnableThreeSkill")
set LOADSKILL[94]=1
endif
endif
//大牛
if n==7 then
if LOADSKILL[15]==0 then
call ExecuteFunc("NK8")
call ExecuteFunc("NM8")
call ExecuteFunc("NN8")
call ExecuteFunc("NO8")
set LOADSKILL[15]=1
endif
endif
//巨魔
if n==8 then
if LOADSKILL[27]==0 then
call ExecuteFunc("GC8")
call ExecuteFunc("G38")
call RegisterUnitAttackEvent("G68", -2)
call ExecuteFunc("GL8")
call ExecuteFunc("G18")
set LOADSKILL[27]=1
endif
call OZ7(t)
endif
set t=null
return false
endfunction
function PRESKILL takes nothing returns nothing
local trigger t=CreateTrigger()
call TriggerRegisterTimerEvent(t,1,true)
call TriggerAddCondition(t,Condition(function PRESKILL_TRI))
set t=null
endfunction
//修复地卜师
function JFIXDBS takes nothing returns nothing
local unit u
local group g
local integer i
call DisplayTextToPlayer(GetTriggerPlayer(),0,0,"|cFF00FF00修复地卜师占用头像问题|r")
set g=GetUnitsOfPlayerAndTypeId(GetTriggerPlayer(),'H00I')
set u=FirstOfGroup(g)
call RemoveUnit(u)
call DestroyGroup(g)
set g=GetUnitsOfPlayerAndTypeId(GetTriggerPlayer(),'H00J')
set i=CountUnitsInGroup(g)
if i>0 then
loop
exitwhen i==0
set u=FirstOfGroup(g)
call GroupRemoveUnit(g,u)
call RemoveUnit(u)
set i=i-1
endloop
endif
call DestroyGroup(g)
set u=null
set g=null
endfunction
function JFIXDG takes nothing returns nothing
local unit u
local group g
local integer i
call DisplayTextToPlayer(GetTriggerPlayer(),0,0,"|cFF00FF00修复电狗分身占用头像问题|r")
set g=GetUnitsOfPlayerAndTypeId(GetTriggerPlayer(),'N0MM')
set i=CountUnitsInGroup(g)
if i>0 then
loop
exitwhen i==0
set u=FirstOfGroup(g)
call GroupRemoveUnit(g,u)
call RemoveUnit(u)
set i=i-1
endloop
endif
call DestroyGroup(g)
set u=null
set g=null
endfunction
function JSV takes nothing returns nothing
local unit u
local integer ia
local integer i=S2I(SubString(GetEventPlayerChatString(),3,6))
if i > 0 and i < 11 then
if i > 5 then
set i=i+1
endif
set u=M7[i]
if u!=null then
call DisplayTextToPlayer(GetTriggerPlayer(), 0,0, Q[i]+GetUnitName(u)+"("+I2S(GetUnitLevel(u))+"级)|r"+" 技能加点：")
call DisplayTextToPlayer(GetTriggerPlayer(), 0,0, "        - |c0000cc00"+GetAbilityName(eY[336+i])+"|r [|c00ffff00等级 "+I2S(GetUnitAbilityLevel(u,eY[336+i]))+"|r]")
call DisplayTextToPlayer(GetTriggerPlayer(), 0,0, "        - |c0000cc00"+GetAbilityName(eY[352+i])+"|r [|c00ffff00等级 "+I2S(GetUnitAbilityLevel(u,eY[352+i]))+"|r]")
call DisplayTextToPlayer(GetTriggerPlayer(), 0,0, "        - |c0000cc00"+GetAbilityName(eY[368+i])+"|r [|c00ffff00等级 "+I2S(GetUnitAbilityLevel(u,eY[368+i]))+"|r]")
if GetUnitAbilityLevel(u,eY[$BC+i]) > 0 then
call DisplayTextToPlayer(GetTriggerPlayer(), 0,0, "        - |c0000cc00"+GetAbilityName(eY[$BC+i])+"|r [|c00ffff00等级 "+I2S(GetUnitAbilityLevel(u,eY[$BC+i]))+"|r]")
else
call DisplayTextToPlayer(GetTriggerPlayer(), 0,0, "        - |c0000cc00"+GetAbilityName(eY[$AC+i])+"|r [|c00ffff00等级 "+I2S(GetUnitAbilityLevel(u,eY[$AC+i]))+"|r]")
endif
set ia='Aamk'
if GetUnitTypeId(u)=='Nfir' or GetUnitTypeId(u)=='O00P' or GetUnitTypeId(u)=='N01O' or GetUnitTypeId(u)=='N013' or GetUnitTypeId(u)=='N014' or GetUnitTypeId(u)=='N015' or GetUnitTypeId(u)=='Hblm' or GetUnitTypeId(u)=='E02X' or GetUnitTypeId(u)=='UC42' or GetUnitTypeId(u)=='H00K' or GetUnitTypeId(u)=='UC60' or GetUnitTypeId(u)=='H00R' or GetUnitTypeId(u)=='H06W' or GetUnitTypeId(u)=='H06X' or GetUnitTypeId(u)=='H06Y' or GetUnitTypeId(u)=='H07I' or GetUnitTypeId(u)=='O016' or GetUnitTypeId(u)=='O017' or GetUnitTypeId(u)=='H0BC' or GetUnitTypeId(u)=='E02F' or GetUnitTypeId(u)=='O01F' or GetUnitTypeId(u)=='N0MU' or GetUnitTypeId(u)=='N0MV' or GetUnitTypeId(u)=='E01B' then
set ia='A0NR'
endif
call DisplayTextToPlayer(GetTriggerPlayer(), 0,0, "        - |c0000cc00属性附加|r [|c00ffff00等级 "+I2S(GetUnitAbilityLevel(u,ia))+"|r]")
call DisplayTextToPlayer(GetTriggerPlayer(), 0,0,"[数据仅供参考]")
endif
else
call DisplayTextToPlayer(GetTriggerPlayer(), 0, 0,"查看指定楼层技能加点：|cFF00FF00-sv 1~10|r")
endif
set u=null
endfunction
function JCAM takes nothing returns nothing
	local real r = S2R(SubString(GetEventPlayerChatString(), 5, 15))
	call SetCameraFieldForPlayer(GetTriggerPlayer(), CAMERA_FIELD_FARZ,$5F5E100, 0)
	if r <= 0 then
        set r=$672
		call SetCameraFieldForPlayer(GetTriggerPlayer(), CAMERA_FIELD_TARGET_DISTANCE,r, 0)
        call SaveReal(TABLE_Z,GetHandleId(GetTriggerPlayer()),100,0)
		call X37(GetTriggerPlayer(),"镜头已调整至默认值")
	elseif r == 1 then
        set r=2000
		call SetCameraFieldForPlayer(GetTriggerPlayer(), CAMERA_FIELD_TARGET_DISTANCE,r , 0)
        call SaveReal(TABLE_Z,GetHandleId(GetTriggerPlayer()),100,r)
        call DisplayTextToPlayer(GetTriggerPlayer(), 0, 0,"|cFF00FF00已锁定镜头为2000，解锁镜头请输入-cam|r")
	elseif r == 2 then
        set r=2300
		call SetCameraFieldForPlayer(GetTriggerPlayer(), CAMERA_FIELD_TARGET_DISTANCE,r , 0)
        call SaveReal(TABLE_Z,GetHandleId(GetTriggerPlayer()),100,r)
        call DisplayTextToPlayer(GetTriggerPlayer(), 0, 0,"|cFF00FF00已锁定镜头为2300，解锁镜头请输入-cam|r")
	elseif r == 3 then
        set r=2600
		call SetCameraFieldForPlayer(GetTriggerPlayer(), CAMERA_FIELD_TARGET_DISTANCE,r , 0)
        call SaveReal(TABLE_Z,GetHandleId(GetTriggerPlayer()),100,r)
        call DisplayTextToPlayer(GetTriggerPlayer(), 0, 0,"|cFF00FF00已锁定镜头为2600，解锁镜头请输入-cam|r")
	elseif r >= 600 and r <= 4500 then
		call SetCameraFieldForPlayer(GetTriggerPlayer(), CAMERA_FIELD_TARGET_DISTANCE, r, 0)
        call SaveReal(TABLE_Z,GetHandleId(GetTriggerPlayer()),100,r)
        call DisplayTextToPlayer(GetTriggerPlayer(), 0, 0,"|cFF00FF00已锁定镜头为"+I2S(R2I(r))+"，解锁镜头请输入-cam|r")
	else
        call SaveReal(TABLE_Z,GetHandleId(GetTriggerPlayer()),100,0)
		call X37(GetTriggerPlayer(),"参数不能低于600或高于4500")
	endif
endfunction
function JSH takes nothing returns nothing
    local player p=GetTriggerPlayer()
    local unit u
    local integer i=1
    local integer n=1
    local real time
    local integer minute=GetPlayerState(p,PLAYER_STATE_RESOURCE_LUMBER)
    local integer seconds=GetPlayerState(p,PLAYER_STATE_RESOURCE_FOOD_USED)
    if X14 then
        set time=(TimerGetElapsed(W)-M_4+60)/60
    else
        set time=1.
        set minute=0
        set seconds=0
    endif
    call ZZ7(p)
    call DisplayTimedTextToPlayer(p,0,0,10,"------------游戏时间: "+I2S(minute)+"分"+I2S(seconds)+"秒"+"------------")
    loop
    exitwhen n>5
    set u=M7[i]
    if u!=null then
        // if TL4 and GetPlayerController(GetOwningPlayer(u))==MAP_CONTROL_COMPUTER then
            // call DisplayTimedTextToPlayer(p,0,0,10, Q[i]+GetPlayerName(Player(i))+"("+GetUnitName(u)+")"+"|r 伤害总计 "+I2S(PlayerDamage[i])+" ("+I2S(R2I(PlayerDamage[i]/time))+"/分)")
        // else
        // if TL4 and GetPlayerController(GetOwningPlayer(u))==MAP_CONTROL_COMPUTER then
            // call DisplayTimedTextToPlayer(p,0,0,10, Q[i]+GetPlayerName(Player(i))+"("+GetUnitName(u)+")"+"|r 伤害总计 "+I2S(PlayerDamage[i])+" ("+I2S(R2I(PlayerDamage[i]/time))+"/分)")
        // else
            call DisplayTimedTextToPlayer(p,0,0,10, Q[i]+GetPlayerName(Player(i))+"|r 伤害总计 "+I2S(PlayerDamage[i])+" ("+I2S(R2I(PlayerDamage[i]/time))+"/分)")
        // endif
    endif
    set i=i+1
    set n=n+1
    endloop
    call DisplayTimedTextToPlayer(p,0,0,10,"------------------------------------")
    set i=7
    set n=1
    loop
    exitwhen n>5
    set u=M7[i]
    if u!=null then
        // if TL4 and GetPlayerController(GetOwningPlayer(u))==MAP_CONTROL_COMPUTER then
            // call DisplayTimedTextToPlayer(p,0,0,10, Q[i]+GetPlayerName(Player(i))+"("+GetUnitName(u)+")"+"|r 伤害总计 "+I2S(PlayerDamage[i])+" ("+I2S(R2I(PlayerDamage[i]/time))+"/分)")
        // else
        // if TL4 and GetPlayerController(GetOwningPlayer(u))==MAP_CONTROL_COMPUTER then
            // call DisplayTimedTextToPlayer(p,0,0,10, Q[i]+GetPlayerName(Player(i))+"("+GetUnitName(u)+")"+"|r 伤害总计 "+I2S(PlayerDamage[i])+" ("+I2S(R2I(PlayerDamage[i]/time))+"/分)")
        // else
            call DisplayTimedTextToPlayer(p,0,0,10, Q[i]+GetPlayerName(Player(i))+"|r 伤害总计 "+I2S(PlayerDamage[i])+" ("+I2S(R2I(PlayerDamage[i]/time))+"/分)")
        // endif
    endif
    set i=i+1
    set n=n+1
    endloop
    call DisplayTimedTextToPlayer(p,0,0,10,"------------------------------------")
    call DisplayTimedTextToPlayer(p,0,0,10," ")
    set u=null
    set p=null
endfunction
function Z32 takes player p returns nothing
local integer Z42
local player p2
set Z42=0
loop
set p2=Player(Z42)
if(PlayersAreCoAllied(p,p2)and p!=p2)then
call SetPlayerAlliance(p,p2,ALLIANCE_SHARED_VISION,true)
call SetPlayerAlliance(p,p2,ALLIANCE_SHARED_CONTROL,true)
call SetPlayerAlliance(p2,p,ALLIANCE_SHARED_CONTROL,true)
endif
set Z42=Z42+1
exitwhen Z42==12
endloop
endfunction
function JKICKAFK takes nothing returns nothing
local integer O5=S2I(SubString(GetEventPlayerChatString(),9,StringLength(GetEventPlayerChatString())))
local player p=GetTriggerPlayer()
local integer i=GetPlayerId(p)
local string VH
if SPEPLAYER[i]!=1 and SPEPLAYER[i]!=2 and SPEPLAYER[i]!=20 then
    set p=null
    return
endif
if O5>5 then
set O5=O5+1
endif
if O5==i then
	call DisplayTextToPlayer(GetTriggerPlayer(),0,0, "|c00ff0303不能踢自己|r")
	set p=null
	return
endif
if(C<10)then
set VH=I2S(B)+":0"+I2S(C)
else
set VH=I2S(B)+":"+I2S(C)
endif
if TY7(Player(O5)) then
call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "|c00ff0303"+KZ4[GetPlayerId(Player(O5))]+" 已被踢出游戏|r")
set C9[GetPlayerId(Player(O5))]="|c00555555"+VH+"|r"
call RemovePlayer(Player(O5),PLAYER_GAME_RESULT_DEFEAT)
call Z32(Player(O5))
set U2[GetPlayerId(Player(O5))]=true
call DG8(Player(O5))
call DF8(Player(O5))
endif
set p=null
endfunction
