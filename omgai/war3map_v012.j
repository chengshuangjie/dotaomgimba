endfunction
function MZD takes nothing returns boolean
local unit ZX7=GetTriggerUnit()
local unit IH7=GetAttacker()
local integer BC7=B287_GetUnitAbilityLevel(ZX7,'A19Q')
local unit BB7
local integer id=GetUnitTypeId(ZX7)
local real d=5+BC7*5
if GetPrdRandom(ZX7,'A19Q',d) and KE7(ZX7,IH7)<=325 and ISPH(ZX7)==false then
set BB7=CreateUnit(GetOwningPlayer(ZX7),'e00E',GetUnitX(IH7),GetUnitY(IH7),0)
call XF7(BB7,'A0BV')
call SetUnitAbilityLevel(BB7,'A0BV',BC7)
call IssueTargetOrderById(BB7,$D007F,IH7)
if id=='Zcrl' or id=='Z01X' then
call DestroyEffect(AddSpecialEffectTarget("model\\hero_giantstone_n9s_c_target.mdl",IH7,"chest"))
elseif id=='Zdrl' or id=='Z11X' then
call DestroyEffect(AddSpecialEffectTarget("model\\hero_giantstone_n3s_c_target.mdl",IH7,"chest"))
elseif id=='Zerl' or id=='Z21X' then
call DestroyEffect(AddSpecialEffectTarget("model\\hero_giantstone_n6s_c_target.mdl",IH7,"chest"))
endif
set BB7=null
endif
set ZX7=null
set IH7=null
return false
endfunction
function MAD takes unit p5,boolean UA9 returns nothing
