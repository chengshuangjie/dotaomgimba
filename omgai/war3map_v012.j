// if m5==null or IssueTargetOrderById(oA,$D0097,m5)==false then
// set m5=CreateUnit(GetOwningPlayer(WI7),'e00C',x,y,0)
// call UnitApplyTimedLife(m5,'BTLF',.05)
// call UnitAddAbility(m5,'Aetl')
// call IssueTargetOrderById(oA,$D0097,m5)
if m5!=null then
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Monsoon\\MonsoonBoltTarget.mdl",m5,"origin"))
else
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Monsoon\\MonsoonBoltTarget.mdl",GetUnitX(oA),GetUnitY(oA)))
endif
call DestroyEffect(AddSpellEffectById('A05S',EFFECT_TYPE_TARGET,x,y))
// endif
set WI7=null
set m5=null
set oA=null
endfunction
function ZeusHeavenlyJump_Damage takes integer level returns real
if level==1 then
return 25.
elseif level==2 then
return 50.
elseif level==3 then
return 75.
elseif level>=4 then
return 100.
endif
return 0.
endfunction
function ZeusHeavenlyJump_Radius takes integer level returns real
if level==1 then
return 700.
elseif level==2 then
return 800.
elseif level==3 then
return 900.
elseif level>=4 then
return 1000.
endif
return 0.
endfunction
function ZeusHeavenlyJump_Filter takes nothing returns boolean
local unit u=GetFilterUnit()
local boolean b=UnitAlive(u) and WQ7(u)==false and WF7(u)==false and IsUnitEnemy(u,GetOwningPlayer(IN4)) and IsUnitVisible(u,GetOwningPlayer(IN4)) and IsUnitType(u,UNIT_TYPE_STRUCTURE)==false and IsUnitType(u,UNIT_TYPE_ANCIENT)==false and GetUnitAbilityLevel(u,'A04R')==0 and XH7(u)==false
set u=null
return b
endfunction
function ZeusHeavenlyJump_PickTarget takes unit caster,real x,real y,real radius returns unit
local group g=WS7()
local boolexpr f=Condition(function ZeusHeavenlyJump_Filter)
local unit u
local unit heroTarget=null
local unit unitTarget=null
local real heroBest=99999999.
local real unitBest=99999999.
local real dx
local real dy
local real d
set IN4=caster
call GroupEnumUnitsInRange(g,x,y,radius,f)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call GroupRemoveUnit(g,u)
set dx=GetUnitX(u)-x
set dy=GetUnitY(u)-y
set d=dx*dx+dy*dy
if IsUnitType(u,UNIT_TYPE_HERO) then
if d<heroBest then
set heroBest=d
set heroTarget=u
endif
elseif d<unitBest then
set unitBest=d
set unitTarget=u
endif
endloop
call WR7(g)
call DestroyBoolExpr(f)
set g=null
set f=null
set u=null
if heroTarget!=null then
set unitTarget=null
return heroTarget
endif
set heroTarget=null
return unitTarget
endfunction
function ZeusHeavenlyJump_RemoveSlow takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer h=GetHandleId(t)
local unit target=O77(h,"ZeusHeavenlyJumpTarget")
local integer th
if target!=null then
set th=GetHandleId(target)
if TimerGetElapsed(W)>=ON7(th,"ZeusHeavenlyJumpSlowExpire") then
call UnitRemoveAbility(target,'A3ZJ')
call UnitRemoveAbility(target,'B3ZJ')
call RemoveSavedReal(L7,th,StringHash("ZeusHeavenlyJumpSlowExpire"))
endif
endif
call NM7(h)
call OZ7(t)
set t=null
set target=null
return false
endfunction
function ZeusHeavenlyJump_ApplySlow takes unit target,integer level returns nothing
local trigger t
if target==null then
return
endif
if GetUnitAbilityLevel(target,'A3ZJ')==0 then
call UnitAddAbility(target,'A3ZJ')
endif
call SetUnitAbilityLevel(target,'A3ZJ',level)
call NQ7(GetHandleId(target),"ZeusHeavenlyJumpSlowExpire",TimerGetElapsed(W)+1.6)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\slow\\slowtarget.mdl",target,"origin"))
set t=CreateTrigger()
call NT7(GetHandleId(t),"ZeusHeavenlyJumpTarget",target)
call TriggerRegisterTimerEvent(t,1.65,false)
call TriggerAddCondition(t,Condition(function ZeusHeavenlyJump_RemoveSlow))
set t=null
endfunction
function ZeusHeavenlyJump_Cast takes nothing returns nothing
local unit caster=GetTriggerUnit()
local unit target
local unit vision
local integer level=B287_GetUnitAbilityLevel(caster,'A0N5')
local real facing=GetUnitFacing(caster)*bj_DEGTORAD
local real distance=450.
local real x=GetUnitX(caster)
local real y=GetUnitY(caster)
local real jumpX=x
local real jumpY=y
local real radius=ZeusHeavenlyJump_Radius(level)
local real damage=ZeusHeavenlyJump_Damage(level)
if level<=0 then
set caster=null
return
endif
loop
set jumpX=CoordinateX50(x+distance*Cos(facing))
set jumpY=CoordinateY50(y+distance*Sin(facing))
exitwhen distance<=0. or kJ(jumpX,jumpY)
set distance=distance-50.
endloop
if distance<=0. then
set jumpX=x
set jumpY=y
endif
call SetUnitAnimation(caster,"spell")
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl",x,y))
call SetUnitX(caster,jumpX)
call SetUnitY(caster,jumpY)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Monsoon\\MonsoonBoltTarget.mdl",jumpX,jumpY))
set vision=CreateUnit(GetOwningPlayer(caster),'e000',jumpX,jumpY,0)
call XF7(vision,'Aloc')
call SetUnitPathing(vision,false)
call UnitApplyTimedLife(vision,'BTLF',3.)
set target=ZeusHeavenlyJump_PickTarget(caster,jumpX,jumpY,radius)
if target!=null and damage>0. then
call B67(caster,target,1,damage)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Monsoon\\MonsoonBoltTarget.mdl",target,"origin"))
call ZeusHeavenlyJump_ApplySlow(target,level)
endif
call PSD()
set caster=null
set target=null
set vision=null
endfunction
function ZeusHeavenlyJump_OnSpell takes nothing returns boolean
if B287_GetSpellAbilityId()=='A0N5' then
call ZeusHeavenlyJump_Cast()
endif
return false
endfunction
function ZeusHeavenlyJump_Init takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function ZeusHeavenlyJump_OnSpell))
set t=null
endfunction
function ZeusNimbus_IsHero takes unit u returns boolean
return u!=null and (GetUnitTypeId(u)=='Hmbr' or OO7(GetHandleId(u),"SuijiZeusNimbus")) and IsUnitIllusion(u)==false
endfunction
function ZeusNimbus_HasScepter takes unit u returns boolean
if u==null then
return false
endif
return SuijiMode_HasAghanimState(u)
endfunction
function ZeusNimbus_Update takes unit u returns nothing
if not ZeusNimbus_IsHero(u) then
return
endif
if ZeusNimbus_HasScepter(u) then
if GetUnitAbilityLevel(u,'A3NB')==0 then
call UnitAddAbility(u,'A3NB')
call SetUnitAbilityLevel(u,'A3NB',1)
endif
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A3NB',true)
elseif GetUnitAbilityLevel(u,'A3NB')>0 then
call UnitRemoveAbility(u,'A3NB')
endif
endfunction
function ZeusNimbus_BoltDamage takes integer level returns real
if level==1 then
return 100.
elseif level==2 then
return 175.
elseif level==3 then
return 275.
elseif level>=4 then
return 350.
endif
return 0.
endfunction
function ZeusNimbus_Filter takes nothing returns boolean
local unit u=GetFilterUnit()
local boolean b=UnitAlive(u) and WF7(u)==false and IsUnitEnemy(u,GetOwningPlayer(IN4)) and IsUnitType(u,UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(u,'A04R')==0 and XH7(u)==false and IsUnitType(u,UNIT_TYPE_ANCIENT)==false
set u=null
return b
endfunction
function ZeusNimbus_Strike takes unit caster,unit target returns nothing
local integer level
local real damage
local real x
local real y
local unit dummy
local unit reveal
if caster==null or target==null or WQ7(target) then
return
endif
set level=B287_GetUnitAbilityLevel(caster,'A2QB')
set damage=ZeusNimbus_BoltDamage(level)
if damage<=0. then
return
endif
set x=GetUnitX(target)
set y=GetUnitY(target)
set dummy=CreateUnit(GetOwningPlayer(caster),'e00E',x,y,0)
call UnitAddAbility(dummy,'A0R9')
call IssueTargetOrderById(dummy,852095,target)
call UnitApplyTimedLife(dummy,'BTLF',2.)
set reveal=CreateUnit(GetOwningPlayer(caster),'e000',x,y,0)
call UnitAddAbility(reveal,'Aloc')
call UnitApplyTimedLife(reveal,'BTLF',4.5)
call B67(caster,target,1,damage)
call LINGXIA(caster,target)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Monsoon\\MonsoonBoltTarget.mdl",target,"origin"))
call DestroyEffect(AddSpellEffectById('A05S',EFFECT_TYPE_TARGET,x,y))
set dummy=null
set reveal=null
endfunction
function ZeusNimbus_Attack takes unit caster,unit cloud returns nothing
local group g
local unit target
local real x
local real y
if caster==null or cloud==null or B287_GetUnitAbilityLevel(caster,'A2QB')<=0 then
return
endif
set x=GetUnitX(cloud)
set y=GetUnitY(cloud)
set g=WS7()
set IN4=caster
call GroupEnumUnitsInRange(g,x,y,450.,Condition(function ZeusNimbus_Filter))
set target=M59(g,x,y)
call WR7(g)
if target!=null then
call ZeusNimbus_Strike(caster,target)
endif
set g=null
set target=null
endfunction
function ZeusNimbus_Tick takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer h=GetHandleId(t)
local unit caster=O77(h,"ZeusNimbusCaster")
local unit cloud=O77(h,"ZeusNimbusCloud")
if cloud==null or UnitAlive(cloud)==false or TimerGetElapsed(W)>=ON7(h,"ZeusNimbusExpire") then
if cloud!=null and UnitAlive(cloud) then
call KillUnit(cloud)
endif
call NM7(h)
call OZ7(t)
else
call ZeusNimbus_Attack(caster,cloud)
endif
set t=null
set caster=null
set cloud=null
return false
endfunction
function ZeusNimbus_Create takes nothing returns nothing
local unit caster=GetTriggerUnit()
local unit cloud
local trigger t
local integer h
local real x=GetSpellTargetX()
local real y=GetSpellTargetY()
if not ZeusNimbus_IsHero(caster) or not ZeusNimbus_HasScepter(caster) then
set caster=null
return
endif
set cloud=CreateUnit(GetOwningPlayer(caster),'eZNB',x,y,0)
call SetUnitPathing(cloud,false)
call UnitApplyTimedLife(cloud,'BTLF',30.)
call DestroyEffect(AddSpecialEffect("war3mapImported\\thunderstorm_groundeffect.mdx",x,y))
set t=CreateTrigger()
set h=GetHandleId(t)
call NT7(h,"ZeusNimbusCaster",caster)
call NT7(h,"ZeusNimbusCloud",cloud)
call NQ7(h,"ZeusNimbusExpire",TimerGetElapsed(W)+30.5)
call TriggerRegisterTimerEvent(t,2.5,true)
call TriggerRegisterUnitEvent(t,cloud,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function ZeusNimbus_Tick))
call TriggerEvaluate(t)
set caster=null
set cloud=null
set t=null
endfunction
function ZeusNimbus_OnSpell takes nothing returns boolean
if B287_GetSpellAbilityId()=='A3NB' then
call ZeusNimbus_Create()
endif
return false
endfunction
function ZeusNimbus_OnItem takes nothing returns boolean
call ZeusNimbus_Update(GetTriggerUnit())
return false
endfunction
function ZeusNimbus_Periodic takes nothing returns boolean
local integer i=0
loop
exitwhen i>15
call ZeusNimbus_Update(KU4[i])
set i=i+1
endloop
return false
endfunction
function ZeusNimbus_Init takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function ZeusNimbus_OnSpell))
set t=CreateTrigger()
set i=0
loop
exitwhen i>15
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_PICKUP_ITEM,null)
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_DROP_ITEM,null)
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_PAWN_ITEM,null)
set i=i+1
endloop
call TriggerAddCondition(t,Condition(function ZeusNimbus_OnItem))
set t=CreateTrigger()
call TriggerRegisterTimerEvent(t,1.,true)
call TriggerAddCondition(t,Condition(function ZeusNimbus_Periodic))
call TriggerEvaluate(t)
set t=null
endfunction
