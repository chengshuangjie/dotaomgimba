function DFE takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit p5=O77(I97,"Source")
local unit m5=O77(I97,"Target")
local unit BB7=O77(I97,"DarkRiftFXUnit")
local unit BB72=O77(I97,"DarkRiftFXUnit2")
local integer V77=OM7(I97,"Level")
local integer DGE=120
local integer WF8=OM7(I97,"Count")
if p5==null or m5==null or BB7==null or BB72==null or GetUnitTypeId(p5)==0 or GetUnitTypeId(m5)==0 or GetUnitTypeId(BB7)==0 or GetUnitTypeId(BB72)==0 then
call KillUnit(BB7)
call KillUnit(BB72)
call FlushChildHashtable(L7,(I97))
call OZ7(t)
set t=null
set BB7=null
set BB72=null
set p5=null
set m5=null
return false
endif
if GetTriggerEventId()==EVENT_UNIT_SPELL_EFFECT and B287_GetSpellAbilityId()=='A2MB' then
call KillUnit(BB7)
call KillUnit(BB72)
call OZ7(t)
call FlushChildHashtable(L7,(I97))
set t=null
set BB7=null
set BB72=null
set p5=null
set m5=null
return false
elseif GetTriggerEventId()==EVENT_UNIT_DEATH or m5==null or XH7(m5)then
call KillUnit(BB7)
call KillUnit(BB72)
call OZ7(t)
call FlushChildHashtable(L7,(I97))
set t=null
set BB7=null
set BB72=null
set p5=null
set m5=null
return false
else
set WF8=WF8+1
call NP7(I97,"Count",WF8)
endif
if V77==1 then
set DGE=180
elseif V77==2 then
set DGE=150
endif
call SetUnitX(BB7,GetUnitX(p5))
call SetUnitY(BB7,GetUnitY(p5))
call SetUnitX(BB72,GetUnitX(m5))
call SetUnitY(BB72,GetUnitY(m5))
if WF8>DGE then
call KillUnit(BB7)
call KillUnit(BB72)
call OZ7(t)
call NM7(I97)
elseif WF8==30 then
call UnitRemoveAbility(BB7,'Aloc')
call UnitRemoveAbility(BB72,'Aloc')
call ShowUnit(BB7,true)
call ShowUnit(BB72,true)
call XF7(BB7,'Aloc')
call XF7(BB72,'Aloc')
endif
set t=null
set BB7=null
set BB72=null
set p5=null
set m5=null
return false
endfunction
