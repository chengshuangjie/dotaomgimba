set suijiLycanWolfCaster=null
set j8=null
return
endif
set j8=GetOwningPlayer(suijiLycanWolfCaster)
set id=GetUnitTypeId(suijiLycanWolfCaster)
set V77=B287_GetUnitAbilityLevel(suijiLycanWolfCaster,'A03D')+GetUnitAbilityLevel(suijiLycanWolfCaster,'X03D')+GetUnitAbilityLevel(suijiLycanWolfCaster,'X13D')
if V77<=0 then
set suijiLycanWolfCaster=null
set j8=null
return
elseif V77>4 then
set V77=4
endif
set x=GetUnitX(suijiLycanWolfCaster)
set y=GetUnitY(suijiLycanWolfCaster)
set Face=GetUnitFacing(suijiLycanWolfCaster)
if Face>337.5 or Face<22.5 then
set x1=x+n+m
set y1=y+n
set x2=x+n+m
set y2=y-n
elseif Face>=22.5 and Face<=67.5 then
set x1=x+n+m
set y1=y
set x2=x
set y2=y+n+m
elseif Face>67.5 and Face<112.5 then
set x1=x-n
set y1=y+n+m
set x2=x+n
set y2=y+n+m
elseif Face>=112.5 and Face<=157.5 then
set x1=x-n-m
set y1=y
set x2=x
set y2=y+n+m
elseif Face>157.5 and Face<202.5 then
set x1=x-n-m
set y1=y+n
set x2=x-n-m
set y2=y-n
elseif Face>=202.5 and Face<=247.5 then
set x1=x-n-m
set y1=y
set x2=x
set y2=y-n-m
elseif Face>247.5 and Face<292.5 then
set x1=x-n
set y1=y-n-m
set x2=x+n
set y2=y-n-m
elseif Face>=292.5 and Face<=337.5 then
set x1=x+n+m
set y1=y
set x2=x
set y2=y-n-m
endif
if id=='Z008' or id=='E115' then
set tx="model\\hero_lycan_n4s_v_target.mdl"
call DestroyEffect(AddSpecialEffectTarget(tx,suijiLycanWolfCaster,"origin"))
if V77==1 then
set xlid='o105'
elseif V77==2 then
set xlid='o106'
elseif V77==3 then
set xlid='o107'
else
set xlid='o10F'
endif
elseif id=='Z009' or id=='E116' then
set tx="model\\hero_lycan_n3s_v_target.mdl"
call DestroyEffect(AddSpecialEffectTarget(tx,suijiLycanWolfCaster,"origin"))
if V77==1 then
set xlid='o205'
elseif V77==2 then
set xlid='o206'
elseif V77==3 then
set xlid='o207'
else
set xlid='o20F'
endif
else
set tx="Abilities\\Spells\\Orc\\FeralSpirit\\feralspirittarget.mdl"
call DestroyEffect(AddSpecialEffect(tx,x1,y1))
call DestroyEffect(AddSpecialEffect(tx,x2,y2))
if V77==1 then
set xlid='o005'
elseif V77==2 then
set xlid='o006'
elseif V77==3 then
set xlid='o007'
else
set xlid='o00F'
endif
endif
set XL1=CreateUnit(j8,xlid,x1,y1,Face)
call UnitApplyTimedLife(XL1,'BTLF',55)
if Ab[GetPlayerId(j8)]then
call SelectUnitAddForPlayer(XL1,j8)
endif
set XL2=CreateUnit(j8,xlid,x2,y2,Face)
call UnitApplyTimedLife(XL2,'BTLF',55)
if Ab[GetPlayerId(j8)]then
call SelectUnitAddForPlayer(XL2,j8)
endif
if id=='Z008' or id=='E115' or id=='Z009' or id=='E116' then
call SuijiMode_LycanWolvesRegisterDeathFx(XL1)
call SuijiMode_LycanWolvesRegisterDeathFx(XL2)
endif
set j8=null
set XL1=null
set XL2=null
set suijiLycanWolfCaster=null
endfunction
