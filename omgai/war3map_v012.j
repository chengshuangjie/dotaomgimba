function NVE takes nothing returns nothing
local integer BC7
local unit ZX7=GetTriggerUnit()
local unit BB7
if ZX7==null or GetUnitTypeId(ZX7)==0 then
set ZX7=null
return
endif
if GetUnitTypeId(ZX7)=='u017' or GetUnitTypeId(ZX7)=='u019' or GetUnitTypeId(ZX7)=='u018' or GetUnitTypeId(ZX7)=='u01A' or GetUnitTypeId(ZX7)=='u01B' or GetUnitTypeId(ZX7)=='u01C' or GetUnitTypeId(ZX7)=='u01U' or GetUnitTypeId(ZX7)=='u01V' or GetUnitTypeId(ZX7)=='u01W' then
set ZX7=null
return
endif
set BB7=CreateUnit(GetOwningPlayer(ZX7),'e00E',GetUnitX(ZX7),GetUnitY(ZX7),0)
if GetUnitTypeId(ZX7)=='u014' or GetUnitTypeId(ZX7)=='u01D' or GetUnitTypeId(ZX7)=='u01R' then
set BC7=1
elseif GetUnitTypeId(ZX7)=='u015' or GetUnitTypeId(ZX7)=='u01E' or GetUnitTypeId(ZX7)=='u01S' then
set BC7=2
else
set BC7=3
endif
call XF7(BB7,'A1NF')
call SetUnitAbilityLevel(BB7,'A1NF',BC7)
call IssueImmediateOrderById(BB7,$D009F)
call UnitApplyTimedLife(BB7,'BTLF',1.)
set ZX7=null
set BB7=null
endfunction
function NWE takes unit NXE,integer Y48,integer BC7 returns nothing
