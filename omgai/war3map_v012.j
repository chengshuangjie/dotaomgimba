call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A2AS',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A2AU',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A2AT',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A2AQ',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A2AP',false)
