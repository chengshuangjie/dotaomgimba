function QOD takes nothing returns nothing
local unit WI7=U22
local integer id=GetUnitTypeId(WI7)
local string tx
if id=='Zpgh' then
    set tx="model\\Hero_Axe_N9S_X_Target.mdl"
elseif id=='Zpgi' then
    set tx="model\\Hero_Axe_N4S_X_Target.mdl"
else
    set tx="Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl"
endif
call DestroyEffect(AddSpecialEffectTarget(tx,GetEnumUnit(),"origin"))
call B67(WI7,GetEnumUnit(),7,B287_GetUnitAbilityLevel(WI7,'A0C6')*40+60)
set WI7=null
