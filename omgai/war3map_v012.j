	// 	endif
	// endif

	// 暴击数值 > 0. 则播放暴击动画
	if value > 0. and isMelee then
		call SetUnitAnimation(ZX7, "Attack slam")
		call QueueUnitAnimation(ZX7, "Stand Ready")
	endif
	call SaveReal(ExtraHT, 'bjbs', GetHandleId(ZX7), value) //记录暴击倍数
	call SaveInteger(ExtraHT, 'bjsk', GetHandleId(ZX7), skill)  //记录暴击技能



	return value //返回暴击倍数
endfunction
function MNBJ takes unit ZX7,unit IH7,real YM7,boolean ISMNGJ returns nothing
    local real Damagerate=0.
local integer skill=0
        if IsUnitType(IH7, UNIT_TYPE_STRUCTURE) then
            return
        endif



        if IsUnitType(ZX7, UNIT_TYPE_MELEE_ATTACKER) and ISMNGJ==false then //如果是近战单位并且不是模拟攻击
            set Damagerate=LoadReal(ExtraHT, 'bjbs', GetHandleId(ZX7))  //读取暴击倍数
        else
            set Damagerate=SetUnitCriticalStrike(ZX7, false)  //否则判断是否暴击并获取倍数
        endif
        if Damagerate>0 then //如果暴击倍数大于0
if skill==0 then
            set skill=LoadInteger(ExtraHT, 'bjsk', GetHandleId(ZX7))
endif
            if skill=='ABcr' then
                call ZSDJBJ(ZX7, IH7, YM7, Damagerate)
            elseif skill=='A03Q' then
                call ECJTBJ(ZX7, IH7, YM7, ISMNGJ, Damagerate)
            elseif skill=='A03N' then
                call HDYJBJ(ZX7, IH7, YM7, Damagerate)
          elseif skill=='A1YQ' then
              if OE7(GetHandleId(ZX7),"WalrusPunch|Clear")!=null then
                  call TriggerEvaluate(OE7(GetHandleId(ZX7),"WalrusPunch|Clear"))
              endif
              call HXSQ(ZX7, IH7)
                call MNBJ_Normal(ZX7,IH7,YM7,Damagerate,ISMNGJ)
elseif skill=='A0MX' then
call MNBJ_Normal(ZX7,IH7,YM7,Damagerate,ISMNGJ)
call YW7("醉拳!",5,IH7,.024,255,110,70,255)
            else
                call MNBJ_Normal(ZX7,IH7,YM7,Damagerate,ISMNGJ)
            endif
        endif



endfunction
function SuijiMode_HasRandomAttackCritical takes unit suijiCriticalUnit returns boolean
local integer suijiCriticalHandle=0
if SUIJI_MODE==false or suijiCriticalUnit==null or GetUnitTypeId(suijiCriticalUnit)==0 then
return false
endif
set suijiCriticalHandle=GetHandleId(suijiCriticalUnit)
if OO7(suijiCriticalHandle,"SuijiDone")==false and IsUnitIllusion(suijiCriticalUnit)==false then
return false
endif
return B287_GetUnitAbilityLevel(suijiCriticalUnit,'ABcr')>0 or B287_GetUnitAbilityLevel(suijiCriticalUnit,'A03Q')>0 or B287_GetUnitAbilityLevel(suijiCriticalUnit,'A03N')>0 or B287_GetUnitAbilityLevel(suijiCriticalUnit,'A00K')>0 or B287_GetUnitAbilityLevel(suijiCriticalUnit,'A2PX')>0 or B287_GetUnitAbilityLevel(suijiCriticalUnit,'A1OY')>0 or B287_GetUnitAbilityLevel(suijiCriticalUnit,'A1YQ')>0
endfunction
function MNBJ_PD takes nothing returns nothing
	//非建筑非守卫的敌对单位且是模拟暴击英雄
	if LoadBoolean(TABLE_HY, EOO, 11)== false and LoadBoolean(TABLE_HY, EOO, 14) and LoadBoolean(TABLE_HY, EOO, 15) and (YSBJ_HERO(WXX)==false or SuijiMode_HasRandomAttackCritical(WXX)) and (IsUnitType(WXX, UNIT_TYPE_HERO) or IsUnitIllusion(WXX) or AS7(WXX) ) then
		call MNBJ(WXX,YXX,ZXX,false)
	endif
endfunction
function Get_HUIXUE takes unit u returns string
local integer D09=GetItemCharges(MV7(u,ZU[DI4]))
local real d
set d=MHUnit_GetData(u,UNIT_DATA_LIFE_REGEN)
if D09>0 then
set d=d+D09*.5
endif
if GetUnitAbilityLevel(u,'B0I9')>0 then
set d=d+16
elseif GetUnitAbilityLevel(u,'B0I8')>0 then
set d=d+8
elseif GetUnitAbilityLevel(u,'B0I7')>0 then
set d=d+4
elseif GetUnitAbilityLevel(u,'B0HO')>0 then
set d=d+2
endif
if GetUnitTypeId(u)=='H00Q' or (SUIJI_MODE and IsUnitIllusion(u)==false and OO7(GetHandleId(u),"SuijiDone") and B287_GetUnitAbilityLevel(u,'A0QQ')>0) then
    set d=d+LoadReal(ExtraHT, 'A0QQ', GetHandleId(u))
endif
return MHString_Sub(R2S(d) , 0 , MHString_Find(R2S(d) , "." , 0)+3)
endfunction
function Get_HUILAN takes unit u returns string
local integer D09=GetItemCharges(MV7(u,ZU[DI4]))
local real d
set d=MHUnit_GetData(u,UNIT_DATA_MANA_REGEN)
if D09>0 then
set d=d+D09
endif
if GetUnitAbilityLevel(u,'B0I9')>0 then
set d=d+8
elseif GetUnitAbilityLevel(u,'B0I8')>0 then
set d=d+4
elseif GetUnitAbilityLevel(u,'B0I7')>0 then
set d=d+2
elseif GetUnitAbilityLevel(u,'B0HO')>0 then
set d=d+1
endif
set d=d+Get_Bingnv_Huilan(u)*4
return MHString_Sub(R2S(d) , 0 , MHString_Find(R2S(d) , "." , 0)+3)
endfunction
function Get_MNBJ_Rate takes unit ZX7 returns string
local real a=SKBJ_RATE(ZX7)
local real b=DPBJ_RATE(ZX7)
local real c=XJBJ_RATE(ZX7)
local string VH=R2S((c-a*c-b*c+a*b*c+a+b-a*b)*100.)
set VH=MHString_Sub(VH , 0 , MHString_Find(VH , "." , 0))
return VH
endfunction
function Get_WLXX takes unit ZX7 returns string
local string VH=R2S((B4R(ZX7)+B4R_XXGH(ZX7))*100)
return MHString_Sub(VH , 0 , MHString_Find(VH , "." , 0))
endfunction
function Get_FSXX takes unit ZX7 returns string
local real d=DGH_BUFF(ZX7)
if GetUnitAbilityLevel(ZX7,'A2VW')>0 then
    set d=25.*d
else
    set d=0.
endif
return MHString_Sub(R2S(d) , 0 , MHString_Find(R2S(d) , "." , 0))
endfunction
function Get_FSZQ takes unit ZX7 returns string
local integer d
if GetUnitAbilityLevel(ZX7,'A4DJ')>0 or GetUnitAbilityLevel(ZX7,'A4DZ')>0 then
    set d=5*(GetUnitAbilityLevel(ZX7,'A4DJ')+GetUnitAbilityLevel(ZX7,'A4DZ'))
else
    set d=0
endif
if GetUnitAbilityLevel(ZX7,'A4H2')>0 then
	set d=d+18
elseif GetUnitAbilityLevel(ZX7,'A2YK')>0 then
    set d=d+15
elseif GetUnitAbilityLevel(ZX7,'A4H0')>0 then
    set d=d+10
elseif GetUnitAbilityLevel(ZX7,'A2YJ')>0 then
    set d=d+5
endif
return I2S(d)
endfunction
function Get_FJZJ takes unit ZX7 returns string
local integer d
if GetUnitAbilityLevel(ZX7,'A4DJ')>0 or GetUnitAbilityLevel(ZX7,'A4DZ')>0 then
    set d=50*(GetUnitAbilityLevel(ZX7,'A4DJ')+GetUnitAbilityLevel(ZX7,'A4DZ'))
else
    set d=0
endif
if GetUnitAbilityLevel(ZX7,'A2YK')>0 then
    set d=d+200
elseif GetUnitAbilityLevel(ZX7,'A2YJ')>0 then
    set d=d+150
endif
return I2S(d)
endfunction
function Get_LQSJ takes unit ZX7 returns string
local integer d
if GetUnitAbilityLevel(ZX7,'A2VW')>0 then
    set d=25
else
    set d=0
endif
if GetUnitAbilityLevel(ZX7,'A2YR')>0 then
    set d=d+8
endif
if B287_GetUnitAbilityLevel(ZX7,'A10Q')>0 then
    set d=R2I(d+(100-d)*(0.125+0.125*B287_GetUnitAbilityLevel(ZX7,'A10Q')))
endif
return I2S(d)
endfunction
function Get_MFKX takes unit ZX7 returns string
local real d=0
local real d1=0
local real d2=0
if Have_Item(ZX7,ZU[EZB]) then
    set d1=.4
elseif Have_Item(ZX7,ZU[R06]) or Have_Item(ZX7,ZU[DJ4]) or Have_Item(ZX7,ZU[DV4]) then
    set d1=.3
elseif Have_Item(ZX7,ZU[RX]) or Have_Item(ZX7,ZU[R0A]) or Have_Item(ZX7,ZU[it_hzpf]) then
    set d1=.15
endif
if GetUnitAbilityLevel(ZX7,'A4JH')>0 then
    set d2=(18+GetUnitAbilityLevel(ZX7,'A4JH')*8)*.01
elseif B287_GetUnitAbilityLevel(ZX7,'A0VX')>0 then
    set d2=Get_LWDP_MK(ZX7)
elseif B287_GetUnitAbilityLevel(ZX7,'A0MM')>0 then
    set d2=(5+B287_GetUnitAbilityLevel(ZX7,'A0MM')*5)*.01
elseif B287_GetUnitAbilityLevel(ZX7,'A06D')>0 then
    set d2=(4+B287_GetUnitAbilityLevel(ZX7,'A06D')*2)*.01
endif
set d=(1-(1-.25)*(1-d1)*(1-d2))*100
return MHString_Sub(R2S(d) , 0 , MHString_Find(R2S(d) , "." , 0))
endfunction
function Get_Unit_State takes unit u,string s returns string
if s=="生命" then
return "|cFF00FF00"+I2S(R2I(GetUnitState(u,UNIT_STATE_LIFE)))+"|r/|cFF00FF00"+I2S(R2I(GetUnitState(u,UNIT_STATE_MAX_LIFE)))+"|r (|cFF00FF00+"+Get_HUIXUE(u)+"|r)"
elseif s=="魔法" then
return "|cff87cefa"+I2S(R2I(GetUnitState(u,UNIT_STATE_MANA)))+"|r/|cff87cefa"+I2S(R2I(GetUnitState(u,UNIT_STATE_MAX_MANA)))+"|r (|cff87cefa+"+Get_HUILAN(u)+"|r)"
elseif s=="攻击速度" then
return "|c00fffc01"+I2S(R2I(GetUnitState(u, UNIT_STATE_ATTACK1_SPEED)*100))+"|r"
elseif s=="攻击间隔" then
return "|c00fffc01"+R2S(GetUnitState(u, UNIT_STATE_ATTACK1_COOL)/RMinBJ(GetUnitState(u, UNIT_STATE_ATTACK1_SPEED),MHUnit_GetAttackSpeedLimit(u)))+"|r 秒/次"
elseif s=="物理吸血" then
return "|c00fffc01"+Get_WLXX(u)+"|r%"
elseif s=="法术吸血" then
return "|c00fffc01"+Get_FSXX(u)+"|r%"
elseif s=="法术增强" then
return "|c00fffc01"+Get_FSZQ(u)+"|r%"
elseif s=="法距增加" then
return "|c00fffc01"+Get_FJZJ(u)+"|r"
elseif s=="冷却缩减" then
return "|c00fffc01"+Get_LQSJ(u)+"|r%"
elseif s=="魔法抗性" then
return "|c00fffc01"+Get_MFKX(u)+"|r%"
elseif s=="暴击率" then
return "|c00fffc01"+Get_MNBJ_Rate(u)+"|r%"
elseif s=="闪避率" then
return "|c00fffc01"+I2S(GetUnitMissProbability(u))+"|r%"
elseif s=="移动速度" then
return "|c00fffc01"+I2S(R2I(.5+U6V(u)))+"|r"
endif  
return ""
endfunction
function JSS takes nothing returns nothing
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local integer i=GetPlayerId(p)
local string HEROSTATE
// if MHAbility_GetCastpoint(u,'A4DV')!=.01 then
//     call MHAbility_SetCastpoint(u,'A4DV',.01)
// endif
// if MHAbility_GetCastpoint(u,'A4DV')!=.01 then
//     call MHAbility_SetCastpoint(u,'A4DV',.01)
// endif
// if MHAbility_GetCastpoint(u,'A4DV')!=.01 then
//     call MHAbility_SetCastpoint(u,'A4DV',.01)
// endif
set HEROSTATE="|cffff8000  ★【"+GetUnitName(u)+"】★|r"
set HEROSTATE=HEROSTATE+"\n生命:  "+Get_Unit_State(u,"生命")
set HEROSTATE=HEROSTATE+"\n魔法:  "+Get_Unit_State(u,"魔法")
set HEROSTATE=HEROSTATE+"\n攻击速度:  "+Get_Unit_State(u,"攻击速度")
set HEROSTATE=HEROSTATE+"\n攻击间隔:  "+Get_Unit_State(u,"攻击间隔")
set HEROSTATE=HEROSTATE+"\n物理吸血:  "+Get_Unit_State(u,"物理吸血")
set HEROSTATE=HEROSTATE+"\n法术吸血:  "+Get_Unit_State(u,"法术吸血")
set HEROSTATE=HEROSTATE+"\n法术增强:  "+Get_Unit_State(u,"法术增强")
set HEROSTATE=HEROSTATE+"\n法距增加:  "+Get_Unit_State(u,"法距增加")
set HEROSTATE=HEROSTATE+"\n冷却缩减:  "+Get_Unit_State(u,"冷却缩减")
set HEROSTATE=HEROSTATE+"\n魔法抗性:  "+Get_Unit_State(u,"魔法抗性")
set HEROSTATE=HEROSTATE+"\n暴击率:  "+Get_Unit_State(u,"暴击率")
set HEROSTATE=HEROSTATE+"\n闪避率:  "+Get_Unit_State(u,"闪避率")
set HEROSTATE=HEROSTATE+"\n移动速度:  "+Get_Unit_State(u,"移动速度")
call DisplayTimedTextToPlayer(p,0,0,10, HEROSTATE)
set p=null
set u=null
endfunction
function YCR takes nothing returns boolean
	local unit fu = GetEnumUnit()
	local real N5X = KE7(fu, YQAL)
	if N5X < YQCL then
		set YQCL = N5X
		set YQNL = fu
	endif
	set fu = null
	return false
endfunction
function YCR_PD2 takes nothing returns boolean
	local unit fu = GetFilterUnit()
	local integer id=GetHandleId(fu)
	if fu != YQAL and IsUnitEnemy(fu, GetOwningPlayer(YQIL)) and UnitAlive(fu) and AE7(fu)==false and(GetUnitAbilityLevel(fu,'A04R')== 0) and GetUnitAbilityLevel(fu,'Avul')== 0 and lWA(fu, GetOwningPlayer(YQIL)) and IsUnitInRangeXY(fu, GetUnitX(YQAL), GetUnitY(YQAL), 510) then
	set fu=null
	return true
	endif
	set fu=null
	return false
endfunction
function YCR_PD1 takes nothing returns boolean
	local unit fu = GetFilterUnit()
	local integer id=GetHandleId(fu)
	local integer YRTS1=LoadInteger(ExtraHT, YQJBID, 101)
	local integer YRTS2=LoadInteger(ExtraHT, YQJBID, 102)
	local integer YRTS3=LoadInteger(ExtraHT, YQJBID, 103)
	local integer YRTS4=LoadInteger(ExtraHT, YQJBID, 104)
	local integer YRTS5=LoadInteger(ExtraHT, YQJBID, 105)
	local integer YRTS6=LoadInteger(ExtraHT, YQJBID, 106)
	if fu != YQAL and IsUnitEnemy(fu, GetOwningPlayer(YQIL)) and UnitAlive(fu) and AE7(fu)==false and(GetUnitAbilityLevel(fu,'A04R')== 0) and GetUnitAbilityLevel(fu,'Avul')== 0 and lWA(fu, GetOwningPlayer(YQIL)) and IsUnitInRangeXY(fu, GetUnitX(YQAL), GetUnitY(YQAL), 510) and (id!=YRTS1 and id!=YRTS2 and id!=YRTS3 and id!=YRTS4 and id!=YRTS5 and id!=YRTS6) then
	set fu=null
	return true
	endif
	set fu=null
	return false
endfunction
function YBR takes nothing returns boolean
	local unit fu = GetFilterUnit()
	local real N5X = KE7(fu, YQAL)
	if fu != YQAL and IsUnitEnemy(fu, GetOwningPlayer(YQIL)) and UnitAlive(fu) and AE7(fu)==false and N5X < YQCL and(GetUnitAbilityLevel(fu,'A04R')== 0) and GetUnitAbilityLevel(fu,'Avul')== 0 and lWA(fu, GetOwningPlayer(YQIL)) and IsUnitInRangeXY(fu, GetUnitX(YQAL), GetUnitY(YQAL), 510) then
		set YQCL = N5X
		set YQNL = fu
	endif
	set fu = null
	return false
endfunction
function YDR takes nothing returns nothing
	local group g
	local integer hu
	local trigger t
	local integer ht
	local unit d = LoadUnitHandle(TABLE_HY, GetHandleId(GetTriggeringTrigger()), 45)
	local integer UYX = LoadInteger(TABLE_HY, GetHandleId(d), 0)-1
	local unit u = LoadUnitHandle(TABLE_HY, GetHandleId(d), 0)
	local unit target = W22
	local real ZCE = LoadReal(TABLE_HY, GetHandleId(d), 0)
	local integer YR_unit
	local integer id=GetUnitTypeId(u)
	local integer YRTS1=LoadInteger(ExtraHT, GetHandleId(d), 101)
	local integer YRTS2=LoadInteger(ExtraHT, GetHandleId(d), 102)
	local integer YRTS3=LoadInteger(ExtraHT, GetHandleId(d), 103)
	local integer YRTS4=LoadInteger(ExtraHT, GetHandleId(d), 104)
	local integer YRTS5=LoadInteger(ExtraHT, GetHandleId(d), 105)
	local integer YRTS6=LoadInteger(ExtraHT, GetHandleId(d), 106)
	set YQJBID=GetHandleId(d)
	call FlushChildHashtable(TABLE_HY, GetHandleId(d))
	call B67(u, target, 2, ZCE)
	if UYX > 0 then
		set YQAL = target
		set YQIL = u
		set YQCL = 9999
		set YQNL = null
		set g = WS7()
		//优先选取没被弹射过的单位，否则选取最近的单位
		call GroupEnumUnitsInRange(g, GetUnitX(target), GetUnitY(target), 500, Condition(function YCR_PD1))
		if CountUnitsInGroup(g)==0 then
			call GroupEnumUnitsInRange(g, GetUnitX(target), GetUnitY(target), 500, Condition(function YCR_PD2))
		endif
		call ForGroup(g,function YCR)
		call WR7(g)
		set g = null
		if YQNL != null then
			if id=='Z005' then
				set YR_unit='h0GI'
			elseif id=='Z105' then
				set YR_unit='h0GJ'
			elseif id=='Z205' then
				set YR_unit='h0GK'
			else
				set YR_unit='h0GH'
			endif
			call FlushChildHashtable(ExtraHT, YQJBID)
			set t = NHX_TANSHE(u, target, YQNL,YR_unit, "YDR", 880, true, "")
			set ht = GetHandleId(t)
			set hu = GetHandleId(LoadUnitHandle(TABLE_HY, ht, 45))
			call SaveInteger(TABLE_HY, hu, 0, UYX)
			call SaveReal(TABLE_HY, hu, 0, ZCE * .65)
			call SaveUnitHandle(TABLE_HY, hu, 0, u)
			call SaveInteger(ExtraHT, hu, 101, YRTS1)
			call SaveInteger(ExtraHT, hu, 102, YRTS2)
			call SaveInteger(ExtraHT, hu, 103, YRTS3)
			call SaveInteger(ExtraHT, hu, 104, YRTS4)	
			call SaveInteger(ExtraHT, hu, 105, YRTS5)
			call SaveInteger(ExtraHT, hu, 106, YRTS6)
			call SaveInteger(ExtraHT, hu, 107-UYX, GetHandleId(YQNL))
			set t = null
		endif
	else
		call FlushChildHashtable(ExtraHT, YQJBID)
	endif
	set g = null
	set u = null
	set target = null
	set d = null
endfunction
function YFR takes unit u, unit target, real d returns nothing
	local group g = WS7()
	local integer hu
	local trigger t = null
	local integer ht
	local integer BC7=B287_GetUnitAbilityLevel(u,'A041')
	local integer id=GetUnitTypeId(u)
	local integer YR_unit
	if BC7==4 then
		set BC7=5
	endif
	if id=='Z005' then
		set YR_unit='h0GI'
	elseif id=='Z105' then
		set YR_unit='h0GJ'
	elseif id=='Z205' then
		set YR_unit='h0GK'
	else
		set YR_unit='h0GH'
	endif
	set YQAL = target
	set YQIL = u
	set YQCL = 9999
	set YQNL = null
	call GroupEnumUnitsInRange(g, GetUnitX(target), GetUnitY(target), 500, Condition(function YBR))
	call WR7(g)
	set g = null
	if YQNL != null then
		set t = NHX_TANSHE(u, target, YQNL,YR_unit, "YDR", 880, true, "")
		set ht = GetHandleId(t)
		set hu = GetHandleId(LoadUnitHandle(TABLE_HY, ht, 45))
		call SaveInteger(TABLE_HY, hu, 0, BC7)
		call SaveInteger(ExtraHT, hu, 101, GetHandleId(target))
		call SaveInteger(ExtraHT, hu, 102, GetHandleId(YQNL))
		if not IsUnitIllusion(u) then
			set d = GetUnitState(u, UNIT_STATE_ATTACK1_DAMAGE_BASE) + GetUnitState(u, UNIT_STATE_ATTACK1_DAMAGE_BONUS)
		endif
		call SaveReal(TABLE_HY, hu, 0, d * .65)
		call SaveUnitHandle(TABLE_HY, hu, 0, u)
		set t = null
	endif
endfunction
function SBA takes nothing returns nothing	//月刃
	//任意敌对单位
	if B287_GetUnitAbilityLevel(WXX,'A041')>0 and LoadBoolean(TABLE_HY, EOO, 15) then
			call YFR(WXX, YXX, ZXX)
	endif
endfunction
function Get_Same_Item_Rate takes unit u,integer it,real rate returns real
local integer n=Have_Item_Quantity(u,it)
local integer i=1
local real d=1.
if n>0 then
loop
exitwhen i>n
set d=d * (1.-rate)
set i=i+1
endloop
endif
return  1. - d
endfunction
function Get_Dianchui_Skill takes unit ZX7 returns integer
	local real rate= 0.
	local integer skill= 0
	if MRPH(ZX7)==false then
		//漩涡 25
		set rate=Get_Same_Item_Rate(ZX7,LL,.25)*100.
		if rate>0 and GetPrdRandom(ZX7 , 'A0FK' , rate) then
			set skill='A0FK'
		endif
		//FLS 25
		set rate=Get_Same_Item_Rate(ZX7,it_fls,.25)*100.
		if rate>0 and GetPrdRandom(ZX7 , 'A4E8' , rate) then
			set skill='A4E8'
		endif   
		//大电 30
		set rate=Get_Same_Item_Rate(ZX7,it_dadianchui,.3)*100.
		if rate>0 and GetPrdRandom(ZX7 , 'A0JK' , rate) then
			set skill='A0JK'
		endif   
	endif
	return skill
endfunction
function B1O takes unit R8X, unit WLE returns nothing
	local unit W_V
    local integer skill=Get_Dianchui_Skill(R8X)
    if skill>0 then
		set W_V = CreateUnit(GetOwningPlayer(R8X),'e00E', GetUnitX(R8X), GetUnitY(R8X), 0)
		call UnitAddAbility(W_V, skill)
		call IssueTargetOrderById(W_V,$D0097, WLE)
		call UnitApplyTimedLife(W_V,'BTLF',1.)
    endif
		set W_V = null
endfunction
function X8O takes nothing returns nothing	//雷神之锤、漩涡
	if IsUnitType(YXX, UNIT_TYPE_STRUCTURE)== false and IsUnitEnemy(YXX, GetOwningPlayer(WXX)) and(GetUnitAbilityLevel(WXX,'A0JH')> 0 or GetUnitAbilityLevel(WXX,'A0FJ')> 0 or GetUnitAbilityLevel(WXX,'A4E5')> 0) then
		call B1O(WXX, YXX)
	endif
endfunction
function B2O takes unit ZX7, unit IH7, real d returns nothing
	local real mana = GetUnitState(IH7, UNIT_STATE_MANA)
    local integer id=GetUnitTypeId(ZX7)
    local string tx="Abilities\\Spells\\Human\\Feedback\\ArcaneTowerAttack.mdl"
	set d = RMinBJ(mana, d)
    if id=='Zgem' then
        set tx="model\\Hero_Anti-Mage_N5S_R_Target.mdl"
    elseif id=='Zhem' then
        set tx="model\\Hero_Anti-Mage_N11S_R_Target.mdl"
    endif
	if mana > 0 and IsMagicImmuneUnit(IH7)== false then
		call B67(ZX7, IH7, 2, d)
		call SetUnitState(IH7, UNIT_STATE_MANA, mana -d)
		call DestroyEffect(AddSpecialEffectTarget(tx, IH7, "origin"))
	endif
endfunction
function FYR takes nothing returns nothing
	local real mana1
	local real mana2
	if ISPH(WXX)==false and B287_GetUnitAbilityLevel(WXX,'A022')> 0 and IsUnitEnemy(WXX, GetOwningPlayer(YXX)) and GetUnitState(YXX, UNIT_STATE_MANA)> 0 then
		set mana1=16 + 12 * B287_GetUnitAbilityLevel(WXX,'A022')
		set mana2=(0.005 + B287_GetUnitAbilityLevel(WXX,'A022') * 0.005) * GetUnitState(YXX, UNIT_STATE_MAX_MANA)
		if MV7(WXX,ZU[ANEW23])!=null or SuijiMode_HasScepter(WXX) then
			set mana2=mana2 * 1.2
		endif
		call B2O(WXX, YXX, mana1 + mana2)
	endif
endfunction
//破隐一击
function ODO takes nothing returns nothing
	if LoadBoolean(TABLE_HY, EOO, 20) then
		if IsMagicImmuneUnit(YXX) == false then
			if IsUnitType(YXX,UNIT_TYPE_HERO) or AS7(YXX) or IsUnitIllusion(YXX) then
				call Z57(YXX , 'A4G4' , 1 , 5. , 'B0JW')
			endif
			call ZAA8(YXX)
		endif
		call RemoveSavedBoolean(TABLE_HY, EOO, 20)
	endif
endfunction
function B4O takes unit ZX7, unit IH7, integer level returns nothing
	local real mana1
	local real mana2
	local real mana3
	if level==1 then
		set mana1=25.
		set mana2=15.
		set mana3=10.
    elseif level==2 then
		set mana1=40.
		set mana2=20.
		set mana3=10.
    elseif level==3 then
        set mana1=50.
        set mana2=25.
        set mana3=15.
	endif
	if IsUnitIllusion(ZX7)==false then	//非镜像
		call B2O(ZX7, IH7, mana1)
	elseif IsUnitIllusion(ZX7) and IsUnitType(ZX7, UNIT_TYPE_MELEE_ATTACKER) then //近战幻象
		call B2O(ZX7, IH7, mana2)
	elseif IsUnitIllusion(ZX7) and IsUnitType(ZX7, UNIT_TYPE_MELEE_ATTACKER)==false then //远程幻象
		call B2O(ZX7, IH7, mana3)
	endif
endfunction
function OWO takes nothing returns nothing	//净魂之刃
	if IsUnitEnemy(WXX, GetOwningPlayer(YXX)) and GetUnitState(YXX, UNIT_STATE_MANA)>0 then
        if GetUnitAbilityLevel(WXX,'A4DU')> 0 then
            call B4O(WXX,YXX,3)
        elseif GetUnitAbilityLevel(WXX,'A4BO')> 0 then
			call B4O(WXX,YXX,2)
		elseif GetUnitAbilityLevel(WXX,'A4BN')> 0 then
			call B4O(WXX,YXX,1)
		endif
	endif
endfunction

function JJ_JM takes unit IH7 returns nothing	//寂灭
	call UnitRemoveAbility(IH7,'A3K4')
	call UnitRemoveAbility(IH7,'A3K5')
    call UnitRemoveAbility(IH7,'A4KH')
    call UnitRemoveAbility(IH7,'A4KI')
	call UnitRemoveAbility(IH7,'A3K2')
	call UnitRemoveAbility(IH7,'A3K3')
	call Z57(IH7,'A3K6', 1, 7, 0)
	call Z57(IH7,'A3K7', 1, 7,'B2XX')
endfunction
function JJ_AM takes unit IH7 returns nothing	//黯灭
		call UnitRemoveAbility(IH7,'A3K4')
		call UnitRemoveAbility(IH7,'A3K5')
		call UnitRemoveAbility(IH7,'A4KH')
		call UnitRemoveAbility(IH7,'A4KI')
	if GetUnitAbilityLevel(IH7,'B2XX')==0 then
		call Z57(IH7,'A3K2', 1, 7, 0)
		call Z57(IH7,'A3K3', 1, 7,'BIcb')
	endif
endfunction
function JJ_BFCJ takes unit IH7 returns nothing	//暴风长戟
    call UnitRemoveAbility(IH7,'A3K4')
    call UnitRemoveAbility(IH7,'A3K5')
if GetUnitAbilityLevel(IH7,'BIcb')==0 and GetUnitAbilityLevel(IH7,'B2XX')==0 then
    call Z57(IH7,'A4KH', 1, 7, 0)
    call Z57(IH7,'A4KI', 1, 7,'B0KK')
endif
endfunction
function JJ_KWZS takes unit IH7 returns nothing	//枯萎之石
	if GetUnitAbilityLevel(IH7,'BIcb')==0 and GetUnitAbilityLevel(IH7,'B2XX')==0 and GetUnitAbilityLevel(IH7,'B0KK')==0 then
		call Z57(IH7,'A3K4', 1, 5, 0)
		call Z57(IH7,'A3K5', 1, 5,'B0HI')
	endif
endfunction
function JJ_PD takes unit ZX7,unit IH7 returns nothing
	if GetUnitAbilityLevel(ZX7,'A2XX')> 0 then
		call JJ_JM(IH7)
	elseif GetUnitAbilityLevel(ZX7,'AIcb')> 0 then
		call JJ_AM(IH7)
	elseif GetUnitAbilityLevel(ZX7,'A4KG')> 0 then
		call JJ_BFCJ(IH7)
	elseif GetUnitAbilityLevel(ZX7,'A2XJ')> 0 then
		call JJ_KWZS(IH7)	
	endif
endfunction
function ORO takes nothing returns nothing	//黯灭
	if IsUnitEnemy(WXX, GetOwningPlayer(YXX)) and (GetUnitAbilityLevel(WXX,'A2XX')>0 or GetUnitAbilityLevel(WXX,'AIcb')>0 or GetUnitAbilityLevel(WXX,'A2XJ')>0 or GetUnitAbilityLevel(WXX,'A4KG')>0) then
		call JJ_PD(WXX,YXX)
	endif
endfunction

function SuijiMode_IsBiteSourceIllusion takes unit u returns boolean
local unit ownerHero=null
local boolean result=false
if u!=null and GetUnitTypeId(u)!=0 and IsUnitIllusion(u) then
set ownerHero=M7[GetPlayerId(GetOwningPlayer(u))]
if ownerHero!=null and GetUnitTypeId(ownerHero)!=0 then
set result=SuijiMode_HasChosenBite(ownerHero)
endif
endif
set ownerHero=null
return result
endfunction
function SuijiMode_IsBiteOwnedSecondaryUnit takes unit u returns boolean
local unit ownerHero=null
local boolean result=false
if u!=null and GetUnitTypeId(u)!=0 then
set ownerHero=M7[GetPlayerId(GetOwningPlayer(u))]
if ownerHero!=null and GetUnitTypeId(ownerHero)!=0 and ownerHero!=u then
set result=SuijiMode_HasChosenBite(ownerHero)
endif
endif
set ownerHero=null
return result
endfunction
// Illusions reach attack tier 0 reliably, while tiers 1-4 are gated by the
// original damage pipeline.  Apply this attack-event passive here and repeat
// the tier-3 eligibility checks explicitly, so illusion inheritance does not
// depend on a later event tier being reached.
function SuijiMode_ApplyIllusionBiteDirect takes nothing returns nothing
local integer level=0
local integer h=0
local integer count=0
local string reason=""
if WXX==null or YXX==null or GetUnitTypeId(WXX)==0 or GetUnitTypeId(YXX)==0 or IsUnitIllusion(WXX)==false or SuijiMode_IsBiteSourceIllusion(WXX)==false then
return
endif
set level=SuijiMode_GetIllusionPassiveBridgeLevel(WXX,'A0BK')
if IsUnitType(YXX,UNIT_TYPE_STRUCTURE) then
set reason="structure"
elseif GetUnitAbilityLevel(YXX,'A04R')>0 then
set reason="ward"
elseif IsUnitEnemy(YXX,GetOwningPlayer(WXX))==false then
set reason="ally"
elseif ISPH(WXX) then
set reason="isph"
elseif level<=0 then
set reason="level0"
endif
if reason=="" then
call Z57(YXX,'A3PV'-1+level,1,4,'B01D')
call EnableAttackEffectByTime(9,4.5)
if SUIJI_LOG then
set h=GetHandleId(WXX)
set count=OM7(h,"SuijiIllusionBiteDirectLog")
if count<3 then
call NP7(h,"SuijiIllusionBiteDirectLog",count+1)
call SuijiTest_DebugAll("ILLBITE-DIRECT-APPLY","illusion="+GetUnitName(WXX)+" level="+I2S(level)+" physical="+I2S(B287_GetUnitAbilityLevel(WXX,'A0BK'))+" target="+GetUnitName(YXX))
endif
endif
elseif SUIJI_LOG then
set h=GetHandleId(WXX)
set count=OM7(h,"SuijiIllusionBiteDirectLog")
if count<3 then
call NP7(h,"SuijiIllusionBiteDirectLog",count+1)
call SuijiTest_DebugAll("ILLBITE-DIRECT-BLOCK","illusion="+GetUnitName(WXX)+" reason="+reason+" level="+I2S(level)+" target="+GetUnitName(YXX))
endif
endif
endfunction
function SuijiMode_ApplyIllusionGhoulFrenzyDirect takes nothing returns nothing
if WXX==null or YXX==null or GetUnitTypeId(WXX)==0 or GetUnitTypeId(YXX)==0 or IsUnitIllusion(WXX)==false then
return
endif
if ISPH(WXX)==false and LoadBoolean(TABLE_HY,EOO,11)==false and LoadBoolean(TABLE_HY,EOO,14) and LoadBoolean(TABLE_HY,EOO,15) and SuijiMode_GetIllusionPassiveBridgeLevel(WXX,'A4EU')>0 and WF7(YXX)==false then
call XGZN(WXX,YXX)
endif
endfunction
function SuijiMode_ApplyIllusionGreaterBashDirect takes nothing returns nothing
if WXX==null or YXX==null or GetUnitTypeId(WXX)==0 or GetUnitTypeId(YXX)==0 or IsUnitIllusion(WXX)==false then
return
endif
if SuijiMode_GetIllusionPassiveBridgeLevel(WXX,'A0G5')>0 and IsUnitType(YXX,UNIT_TYPE_STRUCTURE)==false and IsUnitEnemy(YXX,GetOwningPlayer(WXX)) and GetRandomInt(1,100)<=17 and OT7(WXX,"pIv")==false and ISPH(WXX)==false and GetUnitAbilityLevel(YXX,'A4IF')==0 then
call JIE(WXX,YXX,false,false)
endif
endfunction
function SuijiMode_IllusionPassiveAttackFallback takes nothing returns nothing
local unit source=null
local integer h=0
local integer attempts=0
if WXX==null or GetUnitTypeId(WXX)==0 or IsUnitIllusion(WXX)==false then
return
endif
set source=M7[GetPlayerId(GetOwningPlayer(WXX))]
if source==null or GetUnitTypeId(source)==0 or source==WXX or OO7(GetHandleId(source),"SuijiDone")==false then
set source=null
return
endif
set h=GetHandleId(WXX)
if OO7(h,"SuijiIllusionPassivesCopied")==false then
set attempts=OM7(h,"SuijiIllusionPassiveCopyAttempts")
if attempts<3 then
call NP7(h,"SuijiIllusionPassiveCopyAttempts",attempts+1)
call SuijiMode_CopyChosenPassivesToIllusion(source,WXX)
endif
endif
if SuijiMode_HasChosenBite(source) then
call SuijiMode_ApplyIllusionBiteDirect()
endif
if SuijiMode_GetIllusionPassiveBridgeLevel(WXX,'A4EU')>0 then
call SuijiMode_ApplyIllusionGhoulFrenzyDirect()
endif
if SuijiMode_GetIllusionPassiveBridgeLevel(WXX,'A0G5')>0 then
call SuijiMode_ApplyIllusionGreaterBashDirect()
endif
set source=null
endfunction
function SuijiMode_DebugIllusionBiteAttackEvent takes nothing returns nothing
local integer h=0
local integer count=0
if SUIJI_LOG==false or SuijiMode_IsBiteSourceIllusion(WXX)==false then
return
endif
set h=GetHandleId(WXX)
set count=OM7(h,"SuijiIllusionBiteEventLog")
if count>=3 then
return
endif
call NP7(h,"SuijiIllusionBiteEventLog",count+1)
call SuijiTest_DebugAll("ILLBITE-EVENT","illusion="+GetUnitName(WXX)+" y03q="+I2S(GetUnitAbilityLevel(WXX,'Y03Q'))+" logical="+I2S(B287_GetUnitAbilityLevel(WXX,'A0BK'))+" isph="+SuijiMode_DebugBoolText(ISPH(WXX))+" ward="+SuijiMode_DebugBoolText(GetUnitAbilityLevel(YXX,'A04R')>0))
endfunction
function HWI takes nothing returns nothing  //麻痹之咬
	local integer biteLevel=0
	if SuijiMode_IsBiteSourceIllusion(WXX) then
		return
	endif
	set biteLevel=SuijiMode_GetIllusionPassiveBridgeLevel(WXX,'A0BK')
	if WXX!=null and YXX!=null and GetUnitTypeId(WXX)!=0 and GetUnitTypeId(YXX)!=0 and ISPH(WXX)==false and biteLevel>0 and GetUnitAbilityLevel(YXX,'A04R')== 0 then
		call Z57(YXX,'A3PV'-1 + biteLevel, 1, 4,'B01D')
		call EnableAttackEffectByTime(9, 4.5)
	endif
endfunction

function MNGJ_Miss takes unit ZX7,unit IH7 returns boolean
	local integer probability = 0
	local integer TYA = 0
	if(IsAttackEffectEnabled[17]and GetUnitAbilityLevel(ZX7,'A1FO')== 1 and(not IsUnitType(IH7, UNIT_TYPE_STRUCTURE) or(GetOwningPlayer(IH7)!= A7[0]and GetOwningPlayer(IH7)!= Z7[0]))) and MRPH(ZX7)==false and LoadInteger(L7,(GetHandleId(IH7)),('A4IS'))==0 then
		return false
	endif
	// 攻击者不是近战单位 和 飞行单位
	if not IsUnitType(ZX7, UNIT_TYPE_MELEE_ATTACKER) and not IsUnitType(ZX7, UNIT_TYPE_FLYING) then
		// 如果悬崖高就有 25% 几率丢失
		if GetTerrainCliffLevel(GetUnitX(ZX7), GetUnitY(ZX7))< GetTerrainCliffLevel(GetUnitX(IH7), GetUnitY(IH7)) then
			set TYA = 25
		endif
	endif
	// 查各种丢失 磁场 和 醉拳百分百闪避
	//if(IsAttackEffectEnabled[0]and GetUnitAbilityLevel(IH7,'ACes')> 0) or(IsAttackEffectEnabled[1]and GetUnitAbilityLevel(YX,'A34E')> 0 and GetUnitAbilityLevel(YX,'A36D')== 0) then
	// 查各种丢失 磁场 和 醉拳百分百闪避
	//if(IsAttackEffectEnabled[0]and GetUnitAbilityLevel(IH7,'ACes')> 0) or(IsAttackEffectEnabled[1]and GetUnitAbilityLevel(YX,'A34E')> 0 and GetUnitAbilityLevel(YX,'A36D')== 0) then
	if(IsAttackEffectEnabled[0]and GetUnitAbilityLevel(IH7,'ACes')> 0) then
		set probability = 100
	else
		set probability = GetUnitMissProbability(IH7)
	endif

    //风之障壁百分百闪避

    //风之障壁百分百闪避
    if GetUnitAbilityLevel(ZX7,'Aloc')==0 and IsUnitType(ZX7,UNIT_TYPE_RANGED_ATTACKER)and IsUnitType(ZX7,UNIT_TYPE_STRUCTURE)==false and(LoadInteger(L7,(GetHandleId(IH7)),('A4IS')))>0 then
    if Fc(IH7,ZX7)then
    // call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\SpellShieldAmulet\\SpellShieldCaster.mdl",IH7,"chest"))
    set probability=100
    endif
    endif

	// 获取单位致盲几率

	// 获取单位致盲几率

	// 获取单位致盲几率
	set TYA = UUEE(TYA, GetUnitBlind(ZX7))
	if(probability > 0 or TYA > 0) and(GetRandomInt(1, 100)< probability or GetRandomInt(1, 100)< TYA) then
		return true
	else
		return false
	endif
endfunction
function MNGJTX takes unit ZX7, unit IH7 returns nothing
	local integer i
    call JJ_PD(ZX7, IH7) //减甲装备
    if IsUnitType(IH7, UNIT_TYPE_STRUCTURE) then
        return
    endif
	if GetUnitAbilityLevel(ZX7,'A061')== 1 then
		if GetPrdRandom(WXX,'A061', 35) then	//金箍棒
			call TGA(ZX7, IH7, 5)
		endif
	endif
    if MV7(ZX7, ZU[RLL])!= null then	//大隐刀
        if GetPrdRandom(ZX7, 'A2QG', 15) and GetUnitAbilityLevel(IH7,'B0GT')==0 then
            call ZAA8(IH7)
        endif   
    elseif MV7(ZX7, ZU[U1])!= null or MV7(ZX7, ZU[it_sy])!= null then	//双刀、三元
		if GetPrdRandom(ZX7, 'A263', 30) and GetUnitAbilityLevel(IH7,'B08N')==0 then
			call ZW8(IH7)
		endif
	elseif MV7(ZX7, ZU[RL])!= null or MV7(ZX7, ZU[R3])!= null or MV7(ZX7, ZU[it_dyms])!= null then
		if GetPrdRandom(ZX7, 'A264', 20) and GetUnitAbilityLevel(IH7,'B02I')==0 then	//散华和天堂之戟和地狱面首
			call ZA8(IH7)
		endif
	endif
	if GetUnitAbilityLevel(ZX7,'A4C7')> 0 then	//深渊之刃和小晕锤
		if IsUnitType(ZX7, UNIT_TYPE_MELEE_ATTACKER) then
			set i = 25
		else
			set i = 10
		endif
		if LoadInteger(TABLE_HY, GetHandleId(ZX7),'bash')!= 1 and GetPrdRandom(ZX7,'A4C7', i) then
			if GetUnitAbilityLevel(ZX7,'A4C6')==1 then
				call YDWESetUnitAbilityState(ZX7,'A4C6', 1, 2)
			endif
			call EPX(ZX7,'bash', 2)
			call TGA(ZX7, IH7, 4)
		endif
	endif
	if GetUnitAbilityLevel(ZX7,'A0JH')> 0 or GetUnitAbilityLevel(ZX7,'A0FJ')> 0 or GetUnitAbilityLevel(ZX7,'A4E5')> 0 then
		call B1O(ZX7, IH7)	//漩涡和雷神之锤
	endif
    if GetUnitAbilityLevel(ZX7,'A4DU')> 0 and GetUnitState(IH7, UNIT_STATE_MANA)> 0 then //散失
        call B4O(ZX7,IH7,3)
    elseif GetUnitAbilityLevel(ZX7,'A4BO')> 0 and GetUnitState(IH7, UNIT_STATE_MANA)> 0 then
        call B4O(ZX7,IH7,2)
    elseif GetUnitAbilityLevel(ZX7,'A4BN')> 0 and GetUnitState(IH7, UNIT_STATE_MANA)> 0 then
        call B4O(ZX7,IH7,1)
    endif
	if GetUnitAbilityLevel(ZX7,'A2KV')> 0 or GetUnitAbilityLevel(ZX7,'A4H8')>0 and WF7(IH7)==false then	//冰眼
		call QZA(ZX7, IH7, IsUnitType(ZX7, UNIT_TYPE_MELEE_ATTACKER))
	endif
	if GetUnitAbilityLevel(ZX7,'A1V7')> 0 then	//淬毒之珠
		call Q0A(IH7, ZX7, IsUnitType(ZX7, UNIT_TYPE_MELEE_ATTACKER))
	endif 
endfunction
function MNGJ takes unit ZX7, unit IH7 returns nothing
	local real d=GetUnitState(ZX7, UNIT_STATE_ATTACK1_DAMAGE_BASE) + GetUnitState(ZX7, UNIT_STATE_ATTACK1_DAMAGE_BONUS)
	local real damage
	local real r=B4R(ZX7)+B4R_XXGH(ZX7)
	//非存活 隐藏 虚无吹风守卫无敌 非可见 则返回
if UnitAlive(IH7)==false or IsHideUnit(IH7) or AE7(IH7) or GetUnitAbilityLevel(IH7,'A04R')!=0 or GetUnitAbilityLevel(IH7,'Avul')!=0 or IsUnitVisible(IH7,GetOwningPlayer(ZX7))==false then
		return
elseif MNGJ_Miss(ZX7,IH7) then
		call YW7("Miss",5,ZX7,0.024,255,0,0,255)
else
    if MRPH(ZX7)==false then
	    //攻击特效
	    call MNGJTX(ZX7,IH7)
    endif
    set damage=Attack_Damage(ZX7,IH7,1)
    if MRPH(ZX7)==false then
	    //分裂
	    call MNFL(ZX7, IH7,1.,true)
	    //暴击
	    call MNBJ(ZX7,IH7,damage,true)
    endif
	if GetUnitTypeId(ZX7)=='E002' then //电棍抽攻特效
	    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\ChimaeraLightningMissile\\ChimaeraLightningMissile.mdl",IH7,"chest"))
    elseif GetUnitTypeId(ZX7)=='U00C' then //小狗攻击特效
        call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Human\\HumanLargeDeathExplode\\HumanLargeDeathExplode.mdl",GetUnitX(IH7),GetUnitY(IH7)))
    elseif GetUnitTypeId(ZX7)=='Z00C' then //小狗皮肤攻击特效
        call DestroyEffect(AddSpecialEffect("model\\Hero_Lifestealer_N2S_T_Boom_1.mdl",GetUnitX(IH7),GetUnitY(IH7)))
	endif
	call B67_DPS(ZX7,IH7,2,d)
	//压制之刃
	if UnitAlive(IH7) and GetUnitAbilityLevel(ZX7,'A1AB')> 0 and IsUnitIllusion(IH7)==false and IsUnitType(IH7, UNIT_TYPE_HERO)==false and (IH7 != V4 and AS7(IH7)) then	
		call Q5A(ZX7, IH7, damage)
	endif	
	//吸血
	if IsUnitIllusion(ZX7)==false and IsUnitIllusion(IH7)==false and r>0 and MRPH(ZX7)==false then
		call SetWidgetLife(ZX7, GetWidgetLife(ZX7)+damage*r)
		call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\VampiricAura\\VampiricAuraTarget.mdl", ZX7, "origin"))
	endif
endif
endfunction
function Func_MNGJ takes nothing returns nothing
    call MNGJ(ZX7_tmp,IH7_tmp)
endfunction
function SuijiMode_TriggerFocusFireAttackEffects takes unit source,unit target returns nothing
local integer h=0
if source==null or target==null or GetUnitTypeId(source)==0 or GetUnitTypeId(target)==0 then
return
endif
set h=GetHandleId(source)
set WXX=source
set YXX=target
set PVV=false
set EOO=h
call SaveBoolean(TABLE_HY,h,10,IsUnitType(source,UNIT_TYPE_HERO) or AS7(source) or IsUnitIllusion(source))
call SaveBoolean(TABLE_HY,h,11,IsUnitType(target,UNIT_TYPE_STRUCTURE))
call SaveBoolean(TABLE_HY,h,14,GetUnitAbilityLevel(target,'A04R')==0)
call SaveBoolean(TABLE_HY,h,15,IsUnitEnemy(source,GetOwningPlayer(target)))
if IsUnitType(source,UNIT_TYPE_HERO) or AS7(source) or IsUnitIllusion(source) then
call ExecuteAttackEvent(0)
call ExecuteAttackEvent(1)
if LoadBoolean(TABLE_HY,h,11)==false and LoadBoolean(TABLE_HY,h,14) then
call ExecuteAttackEvent(2)
if LoadBoolean(TABLE_HY,h,15) then
call ExecuteAttackEvent(3)
if IsMagicImmuneUnit(target)==false then
call ExecuteAttackEvent(4)
endif
endif
endif
endif
endfunction
function JZHLActions takes nothing returns nothing
    local integer h = GetHandleId(GetTriggeringTrigger())
    local unit ZX7=LoadUnitHandle(TABLE_HY, h,'jzhl')
	local unit IH7 = W22
	local real d=LoadReal(TABLE_HY, h,'jzhl')
	local real damage
	local real r=B4R(ZX7)+B4R_XXGH(ZX7)
	if MNGJ_Miss(ZX7,IH7) then
		call YW7("Miss",5,ZX7,0.024,255,0,0,255)
	else
	call SuijiMode_TriggerFocusFireAttackEffects(ZX7,IH7)
	if SuijiMode_HasRandomSkill(ZX7,'A0LZ') then
	call SuijiMode_UnifiedOrbApply(ZX7,IH7,'A0LZ')
	endif
    if MRPH(ZX7)==false then
	    call MNGJTX(ZX7,IH7)
    endif
    set damage=Attack_Damage(ZX7,IH7,d)
	call B67_DPS(ZX7,IH7,2,d)
	if IsUnitIllusion(ZX7)==false and IsUnitIllusion(IH7)==false and r>0 and MRPH(ZX7)==false then
		call SetWidgetLife(ZX7, GetWidgetLife(ZX7)+damage*r)
		call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\VampiricAura\\VampiricAuraTarget.mdl", ZX7, "origin"))
	endif
    if MRPH(ZX7)==false then
	    call MNBJ(ZX7,IH7,damage,true)
    endif
	endif
endfunction
function JZHL takes unit u, unit target,real d returns nothing
	local trigger t
	local integer h
    local real damage = (GetUnitState(u, UNIT_STATE_ATTACK1_DAMAGE_BASE) + GetUnitState(u, UNIT_STATE_ATTACK1_DAMAGE_BONUS) ) * d
    set t = NHX(u, target,'h30C', "JZHLActions", 1250, true, "")
    set h = GetHandleId(t)
	call SaveReal(TABLE_HY, h,'jzhl', damage)
	call SaveUnitHandle(TABLE_HY, h,'jzhl', u)
	set t = null
endfunction
function JZHLPD takes unit ZX7,unit IH7 returns boolean
	//来源 射程内 非眩晕 非虚无吹风 非隐藏 非隐身 非变羊 非缴械
	//目标 非虚无吹风 非隐藏 非无敌 可见的
	//来源 射程内 非眩晕 非虚无吹风 非隐藏 非隐身 非变羊 非缴械
	//目标 非虚无吹风 非隐藏 非无敌 可见的
	//来源 射程内 非眩晕 非虚无吹风 非隐藏 非隐身 非变羊 非缴械
	//目标 非虚无吹风 非隐藏 非无敌 可见的
	return KE7(ZX7,IH7)<=GetUnitState(ZX7,UNIT_STATE_ATTACK1_RANGE)+25. and ISSTUN(ZX7)==false and AE7(ZX7)==false and IsHideUnit(ZX7)==false and AK7(ZX7)==false and ISBIANYANG(ZX7)==false and ISJIAOXIE(ZX7)==false and AE7(IH7)==false and IsHideUnit(IH7)==false and ISWUDI(IH7)==false and IsUnitVisible(IH7,GetOwningPlayer(ZX7))
endfunction
function JLG takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit p5=O77(OB7,"Source")
local integer B07=OM7(OB7,"TargetIndex")
local unit m5=TQ7(B07)
local real J1G=ON7(OB7,"Rate")
local real time=ON7(OB7,"Time")
local boolean EWD=OO7(OB7,"Scepter")
if GetTriggerEvalCount(t)==1 then
    call TriggerRegisterUnitEvent(t,p5,EVENT_UNIT_SPELL_EFFECT)
    if GetPlayerController(GetOwningPlayer(m5))==MAP_CONTROL_COMPUTER then
        call AI_ITEM_RENJIA(m5)
    endif
endif
if MHEvent_GetId()==EVENT_ID_UNIT_ATTACK_LAUNCH then
    if MHEvent_GetUnit()==p5 then
        if MHUnitAttackLaunchEvent_GetTargetUnit()==m5 then
            call NQ7(OB7,"ATTACKTIME",GetGameTime()+0.3)
        else
            call NQ7(OB7,"ATTACKTIME",GetGameTime()+1.)
        endif
    endif
elseif GetTriggerEventId()==EVENT_UNIT_SPELL_EFFECT then
if B287_GetSpellAbilityId()=='A12P' or B287_GetSpellAbilityId()=='A1D6' then
        call TP7(B07)
        call NM7(OB7)
        call OZ7(t)
    endif
elseif GetTriggerEventId()==EVENT_UNIT_DEATH or GetGameTime()>time then
call UnitRemoveAbility(p5,'A12R')
call UnitRemoveAbility(p5,'B09X')
    call TP7(B07)
    call NM7(OB7)
    call OZ7(t)
call UnitRemoveAbility(p5,'A1FK')
call UnitRemoveAbility(p5,'A1FL')
call UnitRemoveAbility(p5,'A1FJ')
call UnitRemoveAbility(p5,'A2PS')
call UnitRemoveAbility(p5,'A2PT')
call UnitRemoveAbility(p5,'A2PU')
elseif GetGameTime()>ON7(OB7,"ATTACKTIME") and JZHLPD(p5,m5) then
        call JZHL(p5,m5,(1-J1G))
endif
set t=null
set p5=null
set m5=null
return false
endfunction
function J0G takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local unit IH7=GetSpellTargetUnit()
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local integer V77=B287_GetUnitAbilityLevel(ZX7,'A12P')
local real R9D=.6-V77*.1
local boolean TGD=false
call UnitRemoveAbility(ZX7,'A12R')
call UnitRemoveAbility(ZX7,'B09X')
if V77>0 then
call UnitRemoveAbility(ZX7,'A2PS')
call UnitRemoveAbility(ZX7,'A2PT')
call UnitRemoveAbility(ZX7,'A2PU')
if V77==1 then
call XF7(ZX7,'A1FK')
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A1FK',false)
elseif V77==2 then
call XF7(ZX7,'A1FL')
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A1FL',false)
elseif V77==3 then
call XF7(ZX7,'A1FJ')
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A1FJ',false)
endif
endif
if V77==0 then
call UnitRemoveAbility(ZX7,'A1FK')
call UnitRemoveAbility(ZX7,'A1FL')
call UnitRemoveAbility(ZX7,'A1FJ')
set TGD=true
set V77=B287_GetUnitAbilityLevel(ZX7,'A1D6')
set R9D=.45-V77*.15
if V77==1 then
call XF7(ZX7,'A2PS')
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A2PS',false)
elseif V77==2 then
call XF7(ZX7,'A2PT')
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A2PT',false)
elseif V77==3 then
call XF7(ZX7,'A2PU')
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A2PU',false)
endif
endif
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A12R',false)
call XF7(ZX7,'A12R')
call Z57(ZX7,'A4I1',1,20,0)
call IssueTargetOrderById(ZX7,$D000F,IH7)
call NT7(OB7,"Source",ZX7)
call NS7(OB7,"Scepter",TGD)
call NP7(OB7,"TargetIndex",TS7(IH7))
call NQ7(OB7,"Rate",R9D)
call NQ7(OB7,"Time",GetGameTime()+20.)
call NQ7(OB7,"ATTACKTIME",0)
call NT7(GetHandleId(ZX7),"Target",IH7)
call TriggerRegisterTimerEvent(t,.3,true)
call TriggerRegisterUnitEvent(t,ZX7,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(t,IH7,EVENT_UNIT_DEATH)
call MHUnitAttackLaunchEvent_Register(t)
call TriggerAddCondition(t,Condition(function JLG))
call LINGXIA(ZX7,IH7)
set ZX7=null
set IH7=null
set t=null
endfunction
function J5G takes nothing returns boolean
if (B287_GetSpellAbilityId()=='A12P' or B287_GetSpellAbilityId()=='A1D6') and WQ7(GetSpellTargetUnit())==false then
call J0G()
endif
return false
endfunction
function JZHLBUFF takes unit ZX7 returns nothing
local integer V77=B287_GetUnitAbilityLevel(ZX7,'A12P')
if V77>0 then
if V77==1 then
call XF7(ZX7,'A1FK')
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A1FK',false)
elseif V77==2 then
call XF7(ZX7,'A1FL')
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A1FL',false)
elseif V77==3 then
call XF7(ZX7,'A1FJ')
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A1FJ',false)
endif
endif
if V77==0 then
set V77=B287_GetUnitAbilityLevel(ZX7,'A1D6')
if V77==1 then
call XF7(ZX7,'A2PS')
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A2PS',false)
elseif V77==2 then
call XF7(ZX7,'A2PT')
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A2PT',false)
elseif V77==3 then
call XF7(ZX7,'A2PU')
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A2PU',false)
endif
endif
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A12R',false)
call XF7(ZX7,'A12R')
endfunction
function J2G takes unit ZX7 returns nothing
local unit IH7=O77(GetHandleId(ZX7),"Target")
if GetTriggerUnit()==IH7 then
call DestroyEffect(AddSpecialEffectTarget("effects\\Tornado.mdx",ZX7,"hand,left"))
call DestroyEffect(AddSpecialEffectTarget("effects\\Tornado.mdx",ZX7,"hand,right"))
if GetUnitAbilityLevel(ZX7,'A12R')==0 then
        call JZHLBUFF(ZX7)
    endif
elseif GetTriggerUnit()!=IH7 then
call UnitRemoveAbility(ZX7,'A12R')
call UnitRemoveAbility(ZX7,'B09X')
call UnitRemoveAbility(ZX7,'A1FK')
call UnitRemoveAbility(ZX7,'A1FL')
call UnitRemoveAbility(ZX7,'A1FJ')
call UnitRemoveAbility(ZX7,'A2PS')
call UnitRemoveAbility(ZX7,'A2PT')
call UnitRemoveAbility(ZX7,'A2PU')
endif
set IH7=null
endfunction
function J_G takes nothing returns boolean
if GetUnitAbilityLevel(GetAttacker(),'A4I1')>0 then
call J2G(GetAttacker())
endif
return false
endfunction
function ND8 takes nothing returns nothing
local trigger t=CreateTrigger()
local trigger t2=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function J5G))
call YB7(t2,EVENT_PLAYER_UNIT_ATTACKED)
call TriggerAddCondition(t2,Condition(function J_G))
set t=null
set t2=null
endfunction
function SuijiMode_DogInfestEnableInsideCasting takes unit suijiDogInfestHero returns nothing
if suijiDogInfestHero==null or GetUnitTypeId(suijiDogInfestHero)==0 then
return
endif
call ShowDogSkill(suijiDogInfestHero)
call UnitCancelHide(suijiDogInfestHero)
call SetUnitVertexColor(suijiDogInfestHero,$FF,$FF,$FF,0)
endfunction
function SuijiMode_DogInfestDisableInsideCasting takes unit suijiDogInfestHero returns nothing
if suijiDogInfestHero==null or GetUnitTypeId(suijiDogInfestHero)==0 then
return
endif
call ShowDogSkill(suijiDogInfestHero)
call ResetUnitVertexColor(suijiDogInfestHero,GetUnitTypeId(suijiDogInfestHero))
call UnitCancelHide(suijiDogInfestHero)
endfunction
function SuijiMode_DogInfestEmergencyCleanup takes integer suijiDogInfestHandle,trigger suijiDogInfestTrigger,unit suijiDogInfestHero returns nothing
if suijiDogInfestHero!=null and GetUnitTypeId(suijiDogInfestHero)!=0 then
call OX7(suijiDogInfestHero,"HideUnit")
call UnitRemoveAbility(suijiDogInfestHero,'A0SX')
call UnitRemoveAbility(suijiDogInfestHero,'A4FM')
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(suijiDogInfestHero),'A0SW',true)
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(suijiDogInfestHero),'A4FR',true)
call SuijiMode_DogInfestDisableInsideCasting(suijiDogInfestHero)
call SetUnitPathingEx(suijiDogInfestHero,true)
call SetUnitInvulnerable(suijiDogInfestHero,false)
call SaveInteger(L7,(GetHandleId((suijiDogInfestHero))),((4310)),(2))
endif
call DestroyEffect(OG7(suijiDogInfestHandle,"FX"))
call DestroyEffect(OG7(suijiDogInfestHandle,"FX3"))
call NM7(suijiDogInfestHandle)
call OZ7(suijiDogInfestTrigger)
endfunction
function SEF takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit IH7=O77(I97,"Target")
local unit WX7=O77(I97,"Hero")
local integer BC7=OM7(I97,"Level")
local real dur=ON7(I97,"Time")
local integer ISAI=OM7(I97,"ISAI")
local real now=GetGameTime()
local real last_attack=ON7(I97,"Last_Attack")
local string boom1=OP7(I97,"boom1")
local string boom2=OP7(I97,"boom2")
local string boom3=OP7(I97,"boom3")
if WX7==null or IH7==null then
call SuijiMode_DogInfestEmergencyCleanup(I97,t,WX7)
set t=null
set IH7=null
set WX7=null
return false
endif
if GetUnitTypeId(WX7)==0 or GetUnitTypeId(IH7)==0 or UnitAlive(WX7)==false then
call SuijiMode_DogInfestEmergencyCleanup(I97,t,WX7)
set t=null
set IH7=null
set WX7=null
return false
endif
if GetTriggerEventId()==EVENT_WIDGET_DEATH then
    call DestroyEffect(AddSpecialEffect(boom1,GetUnitX(IH7),GetUnitY(IH7)))
    call DestroyEffect(AddSpecialEffect(boom2,GetUnitX(IH7),GetUnitY(IH7)))
    call DestroyEffect(AddSpecialEffect(boom3,GetUnitX(IH7),GetUnitY(IH7)))
    call SetUnitX(WX7,GetUnitX(IH7))
    call SetUnitY(WX7,GetUnitY(IH7))
    call OX7(WX7,"HideUnit")
    call UnitRemoveAbility(WX7,'A0SX')
    call UnitRemoveAbility(WX7,'A4FM')
    call B287_SetPlayerAbilityAvailable(GetOwningPlayer(WX7),'A0SW',true)
    call B287_SetPlayerAbilityAvailable(GetOwningPlayer(WX7),'A4FR',true)
    call SuijiMode_DogInfestDisableInsideCasting(WX7)
    call SetUnitPathingEx(WX7,true)
    call ClearSelectionForPlayer(GetOwningPlayer(WX7))
    call SelectUnitForPlayerSingle(WX7,GetOwningPlayer(WX7))
    call SetUnitInvulnerable(WX7,false)
    call DestroyEffect(OG7(I97,"FX"))
    call DestroyEffect(OG7(I97,"FX3"))
    call NM7(I97)
    call OZ7(t)
    call S8F(WX7,IH7,BC7)
    call SaveInteger(L7,(GetHandleId((WX7))),((4310)),(2))
elseif(IsUnitType(IH7,UNIT_TYPE_HERO) or ASA(IH7))and IsUnitEnemy(IH7,GetOwningPlayer(WX7)) and now-dur>3. then
    call DestroyEffect(AddSpecialEffect(boom1,GetUnitX(IH7),GetUnitY(IH7)))
    call DestroyEffect(AddSpecialEffect(boom2,GetUnitX(IH7),GetUnitY(IH7)))
    call DestroyEffect(AddSpecialEffect(boom3,GetUnitX(IH7),GetUnitY(IH7)))
    call SetUnitX(WX7,GetUnitX(IH7))
    call SetUnitY(WX7,GetUnitY(IH7))
    call OX7(WX7,"HideUnit")
    call UnitRemoveAbility(WX7,'A0SX')
    call UnitRemoveAbility(WX7,'A4FM')
    call B287_SetPlayerAbilityAvailable(GetOwningPlayer(WX7),'A0SW',true)
    call B287_SetPlayerAbilityAvailable(GetOwningPlayer(WX7),'A4FR',true)
    call SuijiMode_DogInfestDisableInsideCasting(WX7)
    call SetUnitPathingEx(WX7,true)
    call ClearSelectionForPlayer(GetOwningPlayer(WX7))
    call SelectUnitForPlayerSingle(WX7,GetOwningPlayer(WX7))
    call SetUnitInvulnerable(WX7,false)
    call DestroyEffect(OG7(I97,"FX"))
    call DestroyEffect(OG7(I97,"FX3"))
    call NM7(I97)
    call OZ7(t)
    call S8F(WX7,IH7,BC7)
    call SaveInteger(L7,(GetHandleId((WX7))),((4310)),(2))
    if UnitAlive(IH7) then
        call IssueTargetOrderById(WX7,$D000F,IH7)
    endif
elseif GetTriggerEventId()==EVENT_UNIT_ISSUED_ORDER and GetIssuedOrderId()==852544 and GetUnitAbilityLevel(GetTriggerUnit(),'A4FM')>0 then
    call XGKZ(WX7,IH7)
elseif (GetTriggerEventId()==EVENT_UNIT_ISSUED_ORDER and GetIssuedOrderId()==852543 and GetUnitAbilityLevel(GetTriggerUnit(),'A0SX')>0) or (ISAI==1 and now-dur>30.) then
    call DestroyEffect(AddSpecialEffect(boom1,GetUnitX(IH7),GetUnitY(IH7)))
    call DestroyEffect(AddSpecialEffect(boom2,GetUnitX(IH7),GetUnitY(IH7)))
    call DestroyEffect(AddSpecialEffect(boom3,GetUnitX(IH7),GetUnitY(IH7)))
    if IsUnitType(IH7,UNIT_TYPE_HERO)==false and ASA(IH7)==false then
        call SetUnitState(WX7,UNIT_STATE_LIFE,GetUnitState(WX7,UNIT_STATE_LIFE)+GetUnitState(IH7,UNIT_STATE_LIFE))
    endif
    call SetUnitX(WX7,GetUnitX(IH7))
    call SetUnitY(WX7,GetUnitY(IH7))
    call OX7(WX7,"HideUnit")
    call UnitRemoveAbility(WX7,'A0SX')
    call UnitRemoveAbility(WX7,'A4FM')
    call B287_SetPlayerAbilityAvailable(GetOwningPlayer(WX7),'A0SW',true)
    call B287_SetPlayerAbilityAvailable(GetOwningPlayer(WX7),'A4FR',true)
    call SuijiMode_DogInfestDisableInsideCasting(WX7)
    call SetUnitPathingEx(WX7,true)
    call SetUnitAnimation(WX7,"Stand Victory")
    call ZP7(WX7,1.5)
    call ClearSelectionForPlayer(GetOwningPlayer(WX7))
    call SelectUnitForPlayerSingle(WX7,GetOwningPlayer(WX7))
    call SetUnitInvulnerable(WX7,false)
    call DestroyEffect(OG7(I97,"FX"))
    call DestroyEffect(OG7(I97,"FX3"))
    call NM7(I97)
    call OZ7(t)
    call S8F(WX7,IH7,BC7)
    if IsUnitType(IH7,UNIT_TYPE_HERO)==false and ASA(IH7)==false then
        if GetOwningPlayer(IH7)==GetOwningPlayer(WX7) or IsUnitAlly(IH7,GetOwningPlayer(WX7)) then
            if TV7(GetOwningPlayer(IH7))then
                call SetUnitOwner(IH7,A7[0],false)
            else
                call SetUnitOwner(IH7,Z7[0],false)
            endif
        endif
        call UnitRemoveBuffs(IH7,true,true)
        call YW8(IH7,0,0)
        call B67(WX7,IH7,1,100000)
        call B67(WX7,IH7,2,100000)
        call B67(WX7,IH7,3,100000)
    endif
    call SaveInteger(L7,(GetHandleId((WX7))),((4310)),(2))
elseif (GetTriggerEventId()==EVENT_UNIT_ISSUED_POINT_ORDER or GetTriggerEventId()==EVENT_UNIT_ISSUED_TARGET_ORDER) and GetTriggerUnit()==WX7 and GetIssuedOrderId()<852000 then
    call KR7(WX7)
else
    if GetUnitX(WX7)!=GetUnitX(IH7) or GetUnitY(WX7)!=GetUnitY(IH7) then
        call SetUnitX(WX7,GetUnitX(IH7))
        call SetUnitY(WX7,GetUnitY(IH7))
    endif
endif



if IsUnitType(IH7,UNIT_TYPE_HERO) and IsUnitEnemy(IH7,GetOwningPlayer(WX7)) and now-last_attack>=1. then
    call NQ7(I97,"Last_Attack",now)
    call MNGJ(WX7,IH7)
    call XGZN(WX7,IH7)
    call XGSY(WX7,IH7)
endif
set t=null
set IH7=null
set WX7=null
return false
endfunction
function SFF takes nothing returns nothing
local unit WI7=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local trigger SGF=null
local integer level=0
local string SHF
local string SIF
local string SJF
local string boom1
local string boom2
local string boom3
local integer id=GetUnitTypeId(WI7)
set level=SuijiMode_GetPairCastLevel(WI7,B287_GetSpellAbilityId(),'A0SW','A4FR')
if id=='Z00C' then
    set SHF="model\\Hero_Lifestealer_N2S_T_Target.mdl"
    set SIF="model\\Hero_Lifestealer_N2S_T_Tip_1.mdl"
    set SJF="model\\Hero_Lifestealer_N2S_T_Tip_2.mdl"
    set boom1="model\\Hero_Lifestealer_N2S_T_Boom_1.mdl"
    set boom2="model\\Hero_Lifestealer_N2S_T_Boom_2.mdl"
    set boom3="model\\Hero_Lifestealer_N2S_T_Boom_3.mdl"
else
    set SHF="Objects\\Spawnmodels\\Naga\\NagaBlood\\NagaBloodWindserpent.mdl"
    set SIF="Abilities\\Spells\\Human\\ManaFlare\\ManaFlareBase.mdl"
    set SJF="Abilities\\Spells\\Other\\Aneu\\AneuTarget.mdl"
    set boom1="Objects\\Spawnmodels\\Human\\HumanLargeDeathExplode\\HumanLargeDeathExplode.mdl"
    set boom2="tx\\dog\\N'aix_T.mdl"
    set boom3="tx\\dog\\N'aix_T1.mdl"
endif
if IsPlayerEnemy(GetLocalPlayer(),GetOwningPlayer(WI7))and WG7(GetLocalPlayer())==false then
set SHF=""
set SIF=""
set SJF=""
endif
call UnitRemoveBuffs(WI7,true,true)
call YW8(WI7,0,0)
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(WI7),'A0SW',false)
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(WI7),'A4FR',false)
call OV7(WI7,"HideUnit")
call XF7(WI7,'A0SX')
call SetUnitInvulnerable(WI7,true)
call SuijiMode_DogInfestEnableInsideCasting(WI7)
call SetUnitPathingEx(WI7,false)
call NT7(OB7,"Target",m5)
call NT7(OB7,"Hero",WI7)
if id=='Z00C' then
    call DestroyEffect(AddSpecialEffectTarget(SHF,m5,"chest"))
    call NU7(OB7,"FX",AddSpecialEffectTarget(SIF,m5,"origin"))
    call NU7(OB7,"FX3",AddSpecialEffectTarget(SJF,m5,"chest"))
else
    call DestroyEffect(AddSpecialEffectTarget(SHF,m5,"overhead"))
    call NU7(OB7,"FX",AddSpecialEffectTarget(SIF,m5,"overhead"))
    call NU7(OB7,"FX3",AddSpecialEffectTarget(SJF,m5,"overhead"))
endif
call NP7(OB7,"Level",level)
call NQ7(OB7,"Time",GetGameTime())
call NQ7(OB7,"Last_Attack",0.)
call NR7(OB7,"boom1",boom1)
call NR7(OB7,"boom2",boom2)
call NR7(OB7,"boom3",boom3)
if GetPlayerController(GetOwningPlayer(WI7))==MAP_CONTROL_COMPUTER then
call NP7(OB7,"ISAI",1)
endif
call TriggerRegisterDeathEvent(t,m5)
call TriggerRegisterUnitEvent(t, WI7, EVENT_UNIT_ISSUED_ORDER)
call TriggerRegisterUnitEvent(t, WI7, EVENT_UNIT_ISSUED_POINT_ORDER)
call TriggerRegisterUnitEvent(t, WI7, EVENT_UNIT_ISSUED_TARGET_ORDER)
call TriggerRegisterTimerEvent(t,.1,true)
call TriggerRegisterTimerEvent(t,0,false)
call TriggerAddCondition(t,Condition(function SEF))
call SaveInteger(L7,(GetHandleId((WI7))),((4310)),(1))
if IsUnitType(m5,UNIT_TYPE_HERO) and IsUnitEnemy(m5,GetOwningPlayer(WI7)) then
    call Z57(m5,'A4ES', 1, 3,0)
    call YS7_by_scale("Abilities\\Spells\\Other\\TalkToMe\\TalkToMe.mdl",m5,"overhead",3,2)
endif
if IsUnitType(m5,UNIT_TYPE_HERO)==false and IsUnitIllusion(m5)==false and ASA(m5)==false then
    call XF7(m5,'A0SX')
    call UnitAddAbility(m5,'ACmi')
    call TriggerRegisterUnitEvent(t, m5, EVENT_UNIT_ISSUED_ORDER)
    if GetPlayerController(GetOwningPlayer(WI7))==MAP_CONTROL_USER then
        call XF7(WI7,'A4FM')
    else
        call XGKZ(WI7,m5)
    endif
endif
set t=null
set SGF=null
set WI7=null
set m5=null
endfunction
//感染
function SuijiMode_DogInfestIsInsideHost takes unit suijiDogInfestHero returns boolean
if suijiDogInfestHero==null or GetUnitTypeId(suijiDogInfestHero)==0 then
return false
endif
return LoadInteger(L7,GetHandleId(suijiDogInfestHero),4310)==1
endfunction
function SKF takes nothing returns boolean
if (B287_GetSpellAbilityId()=='A0SW' or B287_GetSpellAbilityId()=='A4FR') and SuijiMode_DogInfestIsInsideHost(GetTriggerUnit())==false and ((IsUnitEnemy(GetSpellTargetUnit(),GetOwningPlayer(GetTriggerUnit())))==false or WQ7(GetSpellTargetUnit())==false) then
call SFF()
endif
return false
endfunction
function SMF takes nothing returns boolean
if B287_GetSpellAbilityId()=='A0SW' or B287_GetSpellAbilityId()=='A4FR' then
    if SuijiMode_DogInfestIsInsideHost(GetTriggerUnit()) then
        call KR7(GetTriggerUnit())
        call X37(GetOwningPlayer(GetTriggerUnit()),GetObjectName('n0LV'))
    elseif IsUnitEnemy(GetSpellTargetUnit(),GetOwningPlayer(GetTriggerUnit()))and(IsUnitIllusion(GetSpellTargetUnit()) or ASA(GetSpellTargetUnit())) then
        call KR7(GetTriggerUnit())
        call X37(GetOwningPlayer(GetTriggerUnit()),GetObjectName('n0LV'))
    elseif IsUnitEnemy(GetSpellTargetUnit(),GetOwningPlayer(GetTriggerUnit())) and IsUnitType(GetSpellTargetUnit(),UNIT_TYPE_HERO) and B287_GetSpellAbilityId()=='A0SW' then
        call KR7(GetTriggerUnit())
        call X37(GetOwningPlayer(GetTriggerUnit()),GetObjectName('n0LV'))
    elseif KW7(GetSpellTargetUnit()) then
        call KR7(GetTriggerUnit())
        call X37(GetOwningPlayer(GetTriggerUnit()),GetObjectName('n0LV'))
    endif
endif
return false
endfunction
function ZCDogSkill takes nothing returns nothing
    local integer i=1
    loop
    exitwhen i>11
    if i==6 then
        set i=7
    endif
    call ShowDogSkill(KU4[i])
    set i=i+1
    endloop
endfunction
function MO8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function SKF))
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_CAST)
call TriggerAddCondition(t,Condition(function SMF))
set t=null
call MHAbility_SetHookOrder('A0SX',852543)
call MHAbility_SetHookOrder('A4FM',852544)
call ZCDogSkill()
endfunction
//窒息之刃
function XQF takes nothing returns nothing
	local integer h=GetHandleId(GetTriggeringTrigger())
	local unit ZX7=U22
	local unit IH7=W22
    local integer BC7 = LoadInteger(TABLE_HY, h, 10)
	local real VW9=BC7*75
local unit BB7=CreateUnit(GetOwningPlayer(ZX7),'e00E',GetUnitX(IH7),GetUnitY(IH7),0)
local integer MQQ=B287_GetUnitAbilityLevel(ZX7,'A03Q')
	local integer id=GetPlayerId(GetOwningPlayer(ZX7))
call XF7(BB7,'A0YL')
call SetUnitAbilityLevel(BB7,'A0YL',BC7)
	call IssueTargetOrderById(BB7,$D006B,IH7)
	if SuijiMode_HasAghanimState(ZX7) then
	call MNGJ(ZX7,IH7)
	endif
	if UnitAlive(IH7) then
		if IsUnitType(IH7,UNIT_TYPE_HERO) or IsUnitIllusion(IH7) or AS7(IH7) then
			set VW9=VW9/3
		endif
		if MQQ>0 and GetPrdRandom(ZX7, 'A0YM', 16+3*MQQ) then
			set VW9=VW9*(1.5+MQQ)
			call YW7(I2S(R2I(VW9))+"!",3,IH7,0.02,255,0,0,255)
			call CreateUnit(GetOwningPlayer(IH7),'e050',GetUnitX(IH7),GetUnitY(IH7),Face_zxzr[id])
		endif
		call B67(ZX7,IH7,3,VW9)
        call LINGXIA(ZX7,IH7)
	endif
	set ZX7=null
	set IH7=null
	set BB7=null
	endfunction
function TTA takes unit u, unit target, real damage returns nothing
	set WXX = u
	set YXX = target
	set ZXX = damage
	set EOO = GetHandleId(GetTriggeringTrigger())
    if MRPH(u) then
        return
    endif
	call ExecuteAttackEvent(0)
	if not LoadBoolean(TABLE_HY, EOO, 10) then	//攻击者非英雄，非熊灵则返回，不包含镜像
		return
	endif
	//攻击者是英雄或熊灵，非镜像
	call ExecuteAttackEvent(1)	
	//攻击目标非建筑，非守卫
	if not LoadBoolean(TABLE_HY, EOO, 11) and LoadBoolean(TABLE_HY, EOO, 14) then
		call ExecuteAttackEvent(2)	//攻击目标非建筑，非守卫
		if LoadBoolean(TABLE_HY, EOO, 15) then	//攻击目标是敌对单位
			call ExecuteAttackEvent(3)	//攻击目标非建筑，非守卫，非友军
			if IsMagicImmuneUnit(target)== false then	//攻击目标非魔免
				call ExecuteAttackEvent(4)	//攻击目标非建筑，非守卫，非友军，非魔免
			endif
		endif
	endif
endfunction
//电棍抽攻
function SuijiMode_TriggerSyntheticAttackEffects takes unit source,unit target returns nothing
local integer h=0
if source==null or target==null or GetUnitTypeId(source)==0 or GetUnitTypeId(target)==0 then
return
endif
set h=GetHandleId(source)
set WXX=source
set YXX=target
set PVV=false
set EOO=h
call SaveBoolean(TABLE_HY,h,10,IsUnitType(source,UNIT_TYPE_HERO) or AS7(source) or IsUnitIllusion(source))
call SaveBoolean(TABLE_HY,h,11,IsUnitType(target,UNIT_TYPE_STRUCTURE))
call SaveBoolean(TABLE_HY,h,14,GetUnitAbilityLevel(target,'A04R')==0)
call SaveBoolean(TABLE_HY,h,15,IsUnitEnemy(source,GetOwningPlayer(target)))
if IsUnitType(source,UNIT_TYPE_HERO) or AS7(source) or IsUnitIllusion(source) then
call ExecuteAttackEvent(0)
call ExecuteAttackEvent(1)
if LoadBoolean(TABLE_HY,h,11)==false and LoadBoolean(TABLE_HY,h,14) then
call ExecuteAttackEvent(2)
if LoadBoolean(TABLE_HY,h,15) then
call ExecuteAttackEvent(3)
if IsMagicImmuneUnit(target)==false then
call ExecuteAttackEvent(4)
endif
endif
endif
endif
endfunction
function G4E takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=O77(I97,"Source")
local unit IH7=O77(I97,"Target")
local lightning G7E=OH7(I97,"Light")
local integer BC7=OM7(I97,"Level")
local real Cool=ON7(I97,"Cool")
local integer WF8=GetTriggerEvalCount(t)
local unit BB7=O77(I97,"Caster")
local real d=GetGameTime()
call MoveLightning(G7E,true,GetUnitX(ZX7),GetUnitY(ZX7),GetUnitX(IH7),GetUnitY(IH7))
call SetUnitX(BB7,GetUnitX(IH7))
call SetUnitY(BB7,GetUnitY(IH7))
if KF7(GetUnitX(ZX7),GetUnitY(ZX7),GetUnitX(IH7),GetUnitY(IH7))>800 or GetTriggerEventId()==EVENT_UNIT_DEATH then
call DestroyLightning(G7E)
call KillUnit(BB7)
if GetTriggerEventId()==EVENT_UNIT_DEATH then
call F_E(ZX7,IH7,GetTriggerUnit())
else
call F_E(ZX7,IH7,null)
endif
call UnitRemoveAbility(ZX7,'A4C2')
call NM7(I97)
call OZ7(t)
elseif WF8>80+BC7*20 then
call DestroyLightning(G7E)
call KillUnit(BB7)
call F_E(ZX7,IH7,null)
call UnitRemoveAbility(ZX7,'A4C2')
call NM7(I97)
call OZ7(t)
else
if ModuloInteger(WF8,20)==0 or WF8==1 then
call F0E(ZX7,(BC7*7)*R2I(WF8/ 20))
call F5E(IH7,(BC7*7)*R2I(WF8/ 20))
endif
if (WF8==1 or d>Cool) and AK7(ZX7)==false and IsUnitVisible(IH7,GetOwningPlayer(ZX7)) then
	call SuijiMode_TriggerSyntheticAttackEffects(ZX7,IH7)
	call MNGJ(ZX7,IH7)
	call NQ7(I97,"Cool",d+Attack_Speed(ZX7))
endif
if WF8==1 then
    call LINGXIA(ZX7,IH7)
endif
endif
set t=null
set ZX7=null
set IH7=null
set G7E=null
set BB7=null
return false
endfunction
//锚击
function CXMAOJI_BJ takes unit ZX7 returns real
    local real a
    local real b
    local real d
    local real BJ1
    local real BJ2
    set a=DPBJ_RATE(ZX7)
    set b=XJBJ_RATE(ZX7)
    set d=GetRandomReal(0,100)
    set BJ1=a*100.
    set BJ2=(b-a*b+a)*100.
    if a>0 and d<=BJ1 then
        return 2.4
    elseif b>0 and BJ1<d and d<=BJ2 then
        return 1.75
    endif
        return 1.
endfunction
function Get_Target_Attacked_Damge takes real damage, unit targetUnit returns real
	local real targetUnitArmor = GetUnitState(targetUnit, UNIT_STATE_ARMOR)
	local real reduceRatio = 1
	if IsFortDefenseTypeUnit(targetUnit) then
		set damage = damage * .5
	endif
	if targetUnitArmor >= 0 then
		set reduceRatio = 0.06 * targetUnitArmor / (0.06 * targetUnitArmor + 1)
		set reduceRatio = 1 - reduceRatio
	elseif targetUnitArmor < 0 then
		set reduceRatio = 2 - Pow(1 -0.06, -targetUnitArmor)
	endif
	set damage = damage * reduceRatio
	if IsUnitIllusion(targetUnit) then
		set damage = damage * GetIllusionUnitData(targetUnit)
	endif
	return damage
endfunction
function Get_Target_Attacked_Damge_Reduce_Arror takes real damage, unit targetUnit,real d returns real
	local real targetUnitArmor = GetUnitState(targetUnit, UNIT_STATE_ARMOR) * (1. - d )
	local real reduceRatio = 1
	if IsFortDefenseTypeUnit(targetUnit) then
		set damage = damage * .5
	endif
	if targetUnitArmor >= 0 then
		set reduceRatio = 0.06 * targetUnitArmor / (0.06 * targetUnitArmor + 1)
		set reduceRatio = 1 - reduceRatio
	elseif targetUnitArmor < 0 then
		set reduceRatio = 2 - Pow(1 -0.06, -targetUnitArmor)
	endif
	set damage = damage * reduceRatio
	if IsUnitIllusion(targetUnit) then
		set damage = damage * GetIllusionUnitData(targetUnit)
	endif
	return damage
endfunction
function Reduce_Unit_Attack takes unit ZX7,unit IH7 returns nothing
    local integer level=GetUnitAbilityLevel(ZX7,'A226')
    local integer skill
    local integer skillbuff
    if level==1 then
        set skill='A228'
        set skillbuff='B0E8'
    elseif level==2 then
        set skill='A2UI'
        set skillbuff='B0H2'
    elseif level==3 then
        set skill='A2UJ'
        set skillbuff='B0H3'
    elseif level==4 then
        set skill='A2UK'
        set skillbuff='B0H4'
    endif
    if UnitAlive(IH7) and YS8(IH7)==false then
call SetPlayerAbilityAvailable(GetOwningPlayer(IH7),'A228',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(IH7),'A2UI',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(IH7),'A2UJ',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(IH7),'A2UK',false)
call UnitRemoveAbility(IH7,'A228')
call UnitRemoveAbility(IH7,'A2UI')
call UnitRemoveAbility(IH7,'A2UJ')
call UnitRemoveAbility(IH7,'A2UK')
call UnitRemoveAbility(IH7,'B0E8')
call UnitRemoveAbility(IH7,'B0H2')
call UnitRemoveAbility(IH7,'B0H3')
call UnitRemoveAbility(IH7,'B0H4')
        call Z57(IH7,skill,1,4,skillbuff)
    endif
endfunction
function CXMAOJI takes nothing returns nothing
    local unit ZX7=Y24
    local unit IH7=GetEnumUnit()
    local real CXATTACK=ON7(GetHandleId(ZX7),"attack")
	local real d
    local real xishu=1.
	local real damage
	local real r=B4R(ZX7)+B4R_XXGH(ZX7)
    local real level
    local real FL_rate=0.
    local real BJ_rate=ON7(GetHandleId(ZX7),"BJ_rate")
    call MNGJTX(ZX7,IH7)
    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\CrushingWave\\CrushingWaveDamage.mdl",GetEnumUnit(),"chest"))
	set d=CXATTACK*xishu+50*Y_4
	set damage=Get_Target_Attacked_Damge(d,IH7)
	call B67_DPS(ZX7,IH7,2,d*BJ_rate)
	if UnitAlive(IH7) and GetUnitAbilityLevel(ZX7,'A1AB')> 0 and IsUnitIllusion(IH7)==false and IsUnitType(IH7, UNIT_TYPE_HERO)==false and (IH7 != V4 and AS7(IH7)==false) then	
		call Q5A(ZX7, IH7, damage)
	endif
	if IsUnitIllusion(ZX7)==false and IsUnitIllusion(IH7)==false and r>0 then
		call SetWidgetLife(ZX7, GetWidgetLife(ZX7)+damage*BJ_rate*r)
		call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\VampiricAura\\VampiricAuraTarget.mdl", ZX7, "origin"))
	endif
    if BJ_rate>1 then
        call YW7(I2S(R2I(damage*BJ_rate))+"!",5,IH7,0.024,255,0,128,255)
    endif
	//分裂(狂战和授予力量)
    if (GetUnitAbilityLevel(ZX7,'A1AB')> 0) and (MR7(ZX7,ZU[X1]) or MR7(ZX7,ZU[it_xh]))  then
	    set FL_rate=.45*(Have_Item_Quantity(ZX7,X1)+Have_Item_Quantity(ZX7,it_xh))
    endif
    if Have_SYLL(ZX7) then
        set level=LoadInteger(ExtraHT, 'A037', GetHandleId(ZX7))
        set FL_rate=(0.1 + level * 0.1)+FL_rate
    endif
    if FL_rate>0 and Y_5>0 then
        call B67_DPS(ZX7 , IH7 , 10 , CXATTACK*BJ_rate*FL_rate)
    endif
    call Reduce_Unit_Attack(ZX7,IH7)
set ZX7=null
set IH7=null
endfunction
function CXMAOJI_PD takes nothing returns nothing
local group g=WS7()
local unit ZX7=GetTriggerUnit()
local integer BC7=GetUnitAbilityLevel(ZX7,'A226')
local real BJ_rate
local real d=(GetUnitState(ZX7, UNIT_STATE_ATTACK1_DAMAGE_BASE) + GetUnitState(ZX7, UNIT_STATE_ATTACK1_DAMAGE_BONUS) )
local integer n
set BJ_rate=CXMAOJI_BJ(ZX7)
call NQ7(GetHandleId(ZX7),"BJ_rate",BJ_rate)
call NQ7(GetHandleId(ZX7),"attack",d)
set IN4=ZX7
set Y_4=BC7
set Y24=ZX7
call GroupEnumUnitsInRange(g,GetUnitX(ZX7),GetUnitY(ZX7),425,Condition(function AJ7_Visible))
set n=CountUnitsInGroup(g)
if n>1 then
set Y_5=1
else
set Y_5=0
endif
call NP7(GetHandleId(ZX7),"number",n)
call ForGroup(g,function CXMAOJI)
call WR7(g)
set g=null
set ZX7=null
endfunction
function XPF takes nothing returns boolean
if B287_GetSpellAbilityId()=='A226' then
if GetTriggerEventId()==EVENT_PLAYER_UNIT_SPELL_EFFECT then
call CXMAOJI_PD()
else
call XOF()
endif
endif
return false
endfunction
function IL8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call YB7(t,EVENT_PLAYER_UNIT_SPELL_CAST)
call TriggerAddCondition(t,Condition(function XPF))
set t=null
endfunction
