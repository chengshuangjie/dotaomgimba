function Get_PIFU_ID takes unit u,integer i returns integer
local integer PIFU_ID=-1
local integer id=GetUnitTypeId(u)
local integer Type=WH7(u)
if Type==3 then
if i==1 then
set PIFU_ID=LL_PIFU_LIST1(id)
elseif i==2 then
set PIFU_ID=LL_PIFU_LIST2(id)
elseif i==3 then
set PIFU_ID=LL_PIFU_LIST3(id)
elseif i==4 then
set PIFU_ID=LL_PIFU_LIST4(id)
elseif i==5 then
set PIFU_ID=LL_PIFU_LIST5(id)
//elseif i==6 then
//set PIFU_ID=LL_PIFU_LIST6(id)
//elseif i==6 then
//set PIFU_ID=LL_PIFU_LIST6(id)
//elseif i==6 then
//set PIFU_ID=LL_PIFU_LIST6(id)
endif
elseif Type==2 then
if i==1 then
set PIFU_ID=MJ_PIFU_LIST1(id)
elseif i==2 then
set PIFU_ID=MJ_PIFU_LIST2(id)
elseif i==3 then
set PIFU_ID=MJ_PIFU_LIST3(id)
elseif i==4 then
set PIFU_ID=MJ_PIFU_LIST4(id)
elseif i==5 then
set PIFU_ID=MJ_PIFU_LIST5(id)
//elseif i==6 then
//set PIFU_ID=MJ_PIFU_LIST6(id)
//elseif i==6 then
//set PIFU_ID=MJ_PIFU_LIST6(id)
//elseif i==6 then
//set PIFU_ID=MJ_PIFU_LIST6(id)
endif
else
if i==1 then
set PIFU_ID=ZL_PIFU_LIST1(id)
elseif i==2 then
set PIFU_ID=ZL_PIFU_LIST2(id)
elseif i==3 then
set PIFU_ID=ZL_PIFU_LIST3(id)
elseif i==4 then
set PIFU_ID=ZL_PIFU_LIST4(id)
elseif i==5 then
set PIFU_ID=ZL_PIFU_LIST5(id)
//elseif i==6 then
//set PIFU_ID=ZL_PIFU_LIST6(id)
//elseif i==6 then
//set PIFU_ID=ZL_PIFU_LIST6(id)
//elseif i==6 then
//set PIFU_ID=ZL_PIFU_LIST6(id)
endif
endif
return PIFU_ID
endfunction
function SET_PIFU_DEMO_NULL takes player p returns nothing
local integer n=1
local integer i
if TV7(p) then
set i=7
else
set i=1
endif
loop
exitwhen n>5
// call DzSetUnitModel(PFDEMO[i],"")
call MHUnit_SetModel(PFDEMO[i],"",false)
set n=n+1
set i=i+1
endloop
endfunction
function SET_PIFU_DEMO takes unit u,player p returns nothing
local integer id=GetUnitTypeId(u)
local integer PIFU_ID
local string VH
local real d
local integer n=1
local integer i
if TV7(p) then
set i=1
else
set i=7
endif
loop
exitwhen n>5
set PIFU_ID=Get_PIFU_ID(u,n)
if PIFU_ID>0 then
set VH=EXGetUnitString(PIFU_ID, UNIT_STRING_MODEL_PATH)
else
set VH="Objects\\InventoryItems\\QuestionMark\\QuestionMark.mdl"
endif
// call DzSetUnitModel(PFDEMO[i],VH)
call MHUnit_SetModel(PFDEMO[i],VH,false)
if PIFU_ID>0 then
set d=XX7(u)
else
set d=1.
endif
call SetUnitScale(PFDEMO[i],d,d,d)
set n=n+1
set i=i+1
endloop
endfunction
function SET_HERO_ART takes nothing returns nothing
local integer id=GetPlayerId(GetLocalPlayer())
local unit u
local string array HEROART
set HEROART[id]="ReplaceableTextures\\CommandButtons\\BTNBarrel.blp"
set u=M7[id]
if u!=null and GetUnitTypeId(u)>1 and TY7(GetOwningPlayer(u)) then
set HEROART[id]=MH4[GetUnitPointValue(u)]
endif
call MHAbility_SetDefDataStr('A4DV',ABILITY_DEF_DATA_ART,HEROART[id])
set u=null
endfunction
function SuijiTavernB295_GetEnergyCircle takes integer pid returns unit
if pid==1 then
return KJ4
elseif pid==2 then
return KK4
elseif pid==3 then
return KM4
elseif pid==4 then
return KN4
elseif pid==5 then
return KO4
elseif pid==7 then
return KP4
elseif pid==8 then
return KQ4
elseif pid==9 then
return KR4
elseif pid==10 then
return KS4
elseif pid==11 then
return KT4
endif
return KU4[pid]
endfunction
function SuijiTavernB295_GetHeroStore takes integer pid returns unit
if SUIJI_MODE and SUIJI_TAVERN_HERO[pid]!=null and GetUnitTypeId(SUIJI_TAVERN_HERO[pid])!=0 then
return SUIJI_TAVERN_HERO[pid]
endif
return KU4[pid]
endfunction
function ADD_CONTENT takes unit u,player p,integer rJ returns nothing
local integer slot
local item KA7
local unit lotteryCircle=null
//注册释放技能事件
call TriggerRegisterUnitEvent(Tri_skill,u,EVENT_UNIT_SPELL_EFFECT)
call TriggerRegisterUnitEvent(Tri_skill,u,EVENT_UNIT_SPELL_CAST)
//查看队友技能
if IsUnitAlly(u, GetLocalPlayer()) then
	call MHUnit_EnableViewSkill(u , GetLocalPlayer())
endif
if CHOUJIANGSTATE[rJ]==1 and XM_MODE then
set lotteryCircle=SuijiTavernB295_GetEnergyCircle(rJ)
if lotteryCircle!=null and GetUnitTypeId(lotteryCircle)!=0 then
call UnitAddAbility(lotteryCircle,'A4DK')
if GetGameTime()<17 then
call YDWESetUnitAbilityState(lotteryCircle, 'A4DK', 1, 17-GetGameTime())
endif
endif
endif
//设置皮肤DEMO，且单位不是皮肤英雄
if GetPlayerController(p)==MAP_CONTROL_USER and p==GetLocalPlayer() and XWE_PIFU(rJ,u,GetUnitTypeId(u))==false and IS11==false then
call SET_PIFU_DEMO(u,p)
call SET_PIFU_DEMO_NULL(p)
endif
//修复AI复活不买装备
if D4 and GetPlayerController(p)==MAP_CONTROL_COMPUTER and IsUnitType(u,UNIT_TYPE_HERO) then
set GE7[$E0+rJ]=false
endif
if D4 and XM_MODE and GetPlayerController(p)==MAP_CONTROL_COMPUTER and MAXLEVEL16[rJ]==1 then
call XF7(u,'A2Q5')
call XF7(u,'A2Q3')
endif
if D4 and XM_MODE and GetPlayerController(p)==MAP_CONTROL_COMPUTER and MAXLEVEL22[rJ]==1 then
call XF7(u,'A330')
call CHIA_SKILL(u,p)
call CHIA_TX(u,p)
call XF7(u,'A2VW')
call XF7(u,'A334')
endif
if D4 and XM_MODE and GetPlayerController(p)==MAP_CONTROL_COMPUTER and MAXLEVEL[rJ]==1 then
set AISZ[rJ]=0
set AIXLSZ[rJ]=0
endif
if CHIA[rJ]==1 then
call XF7(u,'A330')
call CHIA_SKILL(u,p)
call CHIA_TX(u,p)
endif
if CHILLX[rJ]==1 then
call XF7(u,'A2VW')
call XF7(u,'A334')
call CHILLX_SKILL(u,p)
endif
if CHIYY[rJ]==1 then
call XF7(u,'A2Q5')
call XF7(u,'A2Q3')
endif
//自动学习技能
if D4 and GetUnitLevel(u)>19 and GetPlayerController(p)==MAP_CONTROL_USER then
call LEARN_SKILL(u,rJ)
endif
//重置A杖效果
if D4 and CHIA[rJ]==0 and GetPlayerController(p)==MAP_CONTROL_USER then
set slot=FIND_SLOT(u,1)
if slot>-1 then
call RemoveItem(UnitItemInSlot(u,slot))
set KA7=UnitAddItemById(u,ZU[F59(u)])
call SetItemPlayer(KA7,GetOwningPlayer(u),false)
call SetItemUserData(KA7,1)
set KA7=null
endif
endif
//禁止自动攻击
if DISZDGJ[rJ] and GetPlayerController(p)==MAP_CONTROL_USER then
    call Disable_Unit_Auto_Attack(u,true)
endif
call CK7(u)
set lotteryCircle=null
endfunction
function ISONLINE takes nothing returns boolean
local integer x=0
if TY7(Z7[1]) then
set x=x+1
endif
if TY7(Z7[2]) then
set x=x+1
endif
if TY7(Z7[3]) then
set x=x+1
endif
if TY7(Z7[4]) then
set x=x+1
endif
if TY7(Z7[5]) then
set x=x+1
endif
if TY7(A7[1]) then
set x=x+1
endif
if TY7(A7[2]) then
set x=x+1
endif
if TY7(A7[3]) then
set x=x+1
endif
if TY7(A7[4]) then
set x=x+1
endif
if TY7(A7[5]) then
set x=x+1
endif
return x>1
endfunction
