function Execute_AI_TRI takes nothing returns nothing
  local trigger t=CreateTrigger()
  if AI_TRI_INIT!=null then
    call OZ7(AI_TRI_INIT)
    set AI_TRI_INIT=null
  endif
  call TriggerRegisterTimerEvent(t,0,false)
  call TriggerAddAction(t,function AI_TRI)
  set t=null
endfunction
