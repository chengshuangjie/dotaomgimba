function XA takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=LoadUnitHandle(L7,I97,0)
local unit IH7=LoadUnitHandle(L7,I97,1)
local integer BC7=LoadInteger(L7,I97,5)
if GetTriggerEventId()==EVENT_WIDGET_DEATH then
if GetTriggerUnit()==ZX7 and LoadBoolean(L7,I97,0)==false then
call SetHeroInt(ZX7,GetHeroInt(ZX7,false)-BC7,true)
call SaveBoolean(L7,I97,0,true)
elseif GetTriggerUnit()==IH7 and LoadBoolean(L7,I97,1)==false then
call SetHeroInt(IH7,GetHeroInt(IH7,false)+BC7,true)
call SaveBoolean(L7,I97,1,true)
endif
if LoadBoolean(L7,I97,0)and LoadBoolean(L7,I97,1)then
call OZ7(t)
call FlushChildHashtable(L7,I97)
endif
else
if LoadBoolean(L7,I97,0)==false then
call SetHeroInt(ZX7,GetHeroInt(ZX7,false)-BC7,true)
endif
if LoadBoolean(L7,I97,1)==false then
call SetHeroInt(IH7,GetHeroInt(IH7,false)+BC7,true)
endif
call OZ7(t)
call FlushChildHashtable(L7,I97)
endif
set t=null
set ZX7=null
set IH7=null
endfunction
function Xb takes unit p5,unit IH7 returns nothing
local trigger t=CreateTrigger()
local integer I97=GetHandleId(t)
local integer V77=B287_GetUnitAbilityLevel(p5,'A0OI')+GetUnitAbilityLevel(p5,'X0OI')
local integer BC7=IMinBJ(GetHeroInt(IH7,false)-1,V77)
call TriggerRegisterDeathEvent(t,p5)
call TriggerRegisterDeathEvent(t,IH7)
call TriggerRegisterTimerEvent(t,80,false)
call TriggerAddCondition(t,Condition(function XA))
call SaveUnitHandle(L7,I97,0,p5)
call SaveUnitHandle(L7,I97,1,IH7)
call SaveInteger(L7,I97,5,BC7)
call SetHeroInt(IH7,GetHeroInt(IH7,false)-BC7,true)
call SetHeroInt(p5,GetHeroInt(p5,false)+BC7,true)
set t=null
endfunction
function R4s takes unit u returns boolean
return IsUnitType(u,UNIT_TYPE_SUMMONED)and GetUnitTypeId(u)!='N0MM'
endfunction
function R4t takes unit u returns boolean //地狱火
local integer id=GetUnitTypeId(u)
return id=='n00U' or id=='n0KU' or id=='n00Y' or id=='n0KV' or id=='n00Z' or id=='n0KW'
endfunction
function XB takes unit WI7,unit IH7 returns nothing
local integer BC7=B287_GetUnitAbilityLevel(WI7,'A0OI')+GetUnitAbilityLevel(WI7,'X0OI')
local real mana=GetUnitState(WI7,UNIT_STATE_MANA)
local real d=.01*(5+BC7)*(mana+(80+20*BC7))
local integer id=GetUnitTypeId(WI7)
call UnitRemoveAbility(IH7,'B06Y')
if(R4s(IH7) or IsUnitIllusion(IH7)) and AS7(IH7)==false and R4t(IH7)==false then
set d=d+100*BC7
endif
call YW7("+"+I2S(R2I(d)),1,IH7,.023,$BF,64,$FF,$D8)
call B67(WI7,IH7,3,d)
if IsUnitType(IH7,UNIT_TYPE_HERO) and GetHeroInt(IH7,false)>1 then
call Xb(WI7,IH7)
endif
if GetUnitAbilityLevel(WI7,'B06X')>0 and GetRandomInt(1,100)<=40 then
call SetUnitState(WI7,UNIT_STATE_MANA,mana+(.05+.05*B287_GetUnitAbilityLevel(WI7,'A0IF'))*GetUnitState(WI7,UNIT_STATE_MAX_MANA))
if id=='Z00P' then
call DestroyEffect(AddSpecialEffectTarget("model\\hero_obsidiandestroyer_n3s_e_source.mdl",WI7,"overhead"))
else
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\ReplenishMana\\ReplenishManaCasterOverhead.mdl",WI7,"overhead"))
endif
endif
endfunction
function JX8 takes nothing returns nothing
