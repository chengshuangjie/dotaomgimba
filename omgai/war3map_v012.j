function EnableThreeSkill takes nothing returns boolean
local integer i=GetPlayerId(GetTriggerPlayer())
local unit u=M7[i]
local integer id=GetUnitTypeId(u)
if id=='H00U' or id=='Z00U' or id=='Z10U' or id=='Z20U' then
    if ThreeSkill[i]==0 then
        set ThreeSkill[i]=1
        call DisplayTextToPlayer(GetTriggerPlayer(),0,0, "|cFF00FF00现在可以保留三个技能|r")
    else
        set ThreeSkill[i]=0
        call DisplayTextToPlayer(GetTriggerPlayer(),0,0, "|cFF00FF00现在只会保留两个技能|r")
    endif
endif
set u=null
return false
endfunction
