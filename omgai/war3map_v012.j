call OZ7(t)
else
call B67(p5,m5,1,BC7*$12+9)
    if GetTriggerEvalCount(t)==1 then
        call LINGXIA(p5,m5)
    endif
endif
set p5=null
set m5=null
set t=null
return false
endfunction
