function Test_NoOtherHumanPlayer takes player requester returns boolean
local integer i=0
local player p=null
loop
exitwhen i>$B
set p=Player(i)
if p!=requester and GetPlayerSlotState(p)==PLAYER_SLOT_STATE_PLAYING and GetPlayerController(p)==MAP_CONTROL_USER then
set p=null
return false
endif
set i=i+1
endloop
set p=null
return true
endfunction
