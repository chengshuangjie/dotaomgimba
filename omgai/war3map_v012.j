function SuijiNightcrawler_IsVisibleToEnemy takes unit u returns boolean
local integer i=0
local player owner=null
local player observer=null
if u==null or GetUnitTypeId(u)==0 then
return false
endif
set owner=GetOwningPlayer(u)
loop
exitwhen i>11
set observer=Player(i)
if GetPlayerSlotState(observer)==PLAYER_SLOT_STATE_PLAYING and IsPlayerEnemy(observer,owner) and IsUnitVisible(u,observer) then
set owner=null
set observer=null
return true
endif
set i=i+1
endloop
set owner=null
set observer=null
return false
endfunction
function RXE takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit p5=O77(OB7,"Source")
local integer V77=0
local real CP7=0.
local real RZE=0.
local real RAE=0.
local integer passivetx=0
local real mana=0.
if p5==null or GetUnitTypeId(p5)==0 or UnitAlive(p5)==false or XH7(p5)then
if p5!=null then
call RemoveSavedHandle(ExtraHT,'A1IN',GetHandleId(p5))
endif
call NM7(OB7)
call OZ7(t)
set t=null
set p5=null
return false
endif
set V77=B287_GetUnitAbilityLevel(p5,'A1IN')
set CP7=TimerGetElapsed(W)
set RZE=ON7(OB7,"Buffer1")
set RAE=ON7(OB7,"Buffer2")
set passivetx=OM7(OB7,"TX")
set mana=GetUnitState(p5,UNIT_STATE_MAX_MANA)/1000
if GetTriggerEventId()==EVENT_UNIT_DAMAGED and GetOwningPlayer(GetEventDamageSource())==B7 then
if GetUnitAbilityLevel(p5,'A1IE')>0 then
call UnitRemoveAbility(p5,'A1IE')
call UnitRemoveAbility(p5,'B0C9')
call UnitRemoveAbility(p5,passivetx)
endif
if GetUnitAbilityLevel(p5,'A1IF')>0 then
call UnitRemoveAbility(p5,'A1IF')
call UnitRemoveAbility(p5,'B0C9')
call UnitRemoveAbility(p5,passivetx)
endif
if GetUnitAbilityLevel(p5,'A1IG')>0 then
call UnitRemoveAbility(p5,'A1IG')
call UnitRemoveAbility(p5,'B0C9')
call UnitRemoveAbility(p5,passivetx)
endif
call NQ7(OB7,"NightcrawlerTime",(CP7+2)*1.)
set t=null
set p5=null
return false
endif
if ON7(OB7,"NightcrawlerTime")>CP7 then
set t=null
set p5=null
return false
endif
if(SuijiNightcrawler_IsVisibleToEnemy(p5) and BM1(p5)==false) or ISPH(p5) or V77==0 then
set RAE=0
if GetUnitAbilityLevel(p5,'A1IE')>0 or GetUnitAbilityLevel(p5,'A1IF')>0 or GetUnitAbilityLevel(p5,'A1IG')>0 then
set RZE=RZE+.1
if RZE>.4 then
set RZE=0
if GetUnitAbilityLevel(p5,'A1IE')>0 then
call UnitRemoveAbility(p5,'A1IE')
call UnitRemoveAbility(p5,'B0C9')
call UnitRemoveAbility(p5,passivetx)
endif
if GetUnitAbilityLevel(p5,'A1IF')>0 then
call UnitRemoveAbility(p5,'A1IF')
call UnitRemoveAbility(p5,'B0C9')
call UnitRemoveAbility(p5,passivetx)
endif
if GetUnitAbilityLevel(p5,'A1IG')>0 then
call UnitRemoveAbility(p5,'A1IG')
call UnitRemoveAbility(p5,'B0C9')
call UnitRemoveAbility(p5,passivetx)
endif
endif
endif
call NQ7(OB7,"Buffer1",RZE*1.)
call NQ7(OB7,"Buffer2",RAE*1.)
elseif SuijiNightcrawler_IsVisibleToEnemy(p5)==false or BM1(p5) then
if GetUnitState(p5,UNIT_STATE_MANA)!=GetUnitState(p5,UNIT_STATE_MAX_MANA) then
call SetUnitState(p5,UNIT_STATE_MANA,GetUnitState(p5,UNIT_STATE_MANA)+mana)
endif
set RZE=0
if (V77==1 and GetUnitAbilityLevel(p5,'A1IE')==0) or (V77==2 and GetUnitAbilityLevel(p5,'A1IF')==0) or (V77==3 and GetUnitAbilityLevel(p5,'A1IG')==0) then
set RAE=RAE+.1
if RAE>.4 then
set RAE=0
if V77==1 then
if GetUnitAbilityLevel(p5,'A1IE')==0 then
call XF7(p5,'A1IE')
call XF7(p5,passivetx)
call UnitMakeAbilityPermanent(p5,true,passivetx)
call UnitMakeAbilityPermanent(p5,true,'A1I8')
call UnitMakeAbilityPermanent(p5,true,'A1IC')
endif
endif
if V77==2 then
if GetUnitAbilityLevel(p5,'A1IE')>0 then
call UnitRemoveAbility(p5,'A1IE')
call UnitRemoveAbility(p5,'B0C9')
endif
if GetUnitAbilityLevel(p5,'A1IF')==0 then
call XF7(p5,'A1IF')
call XF7(p5,passivetx)
call UnitMakeAbilityPermanent(p5,true,passivetx)
call UnitMakeAbilityPermanent(p5,true,'A1I9')
call UnitMakeAbilityPermanent(p5,true,'A1ID')
endif
endif
if V77==3 then
if GetUnitAbilityLevel(p5,'A1IE')>0 then
call UnitRemoveAbility(p5,'A1IE')
call UnitRemoveAbility(p5,'B0C9')
endif
if GetUnitAbilityLevel(p5,'A1IF')>0 then
call UnitRemoveAbility(p5,'A1IF')
call UnitRemoveAbility(p5,'B0C9')
endif
if GetUnitAbilityLevel(p5,'A1IG')==0 then
call XF7(p5,'A1IG')
call XF7(p5,passivetx)
call UnitMakeAbilityPermanent(p5,true,passivetx)
call UnitMakeAbilityPermanent(p5,true,'A1IA')
call UnitMakeAbilityPermanent(p5,true,'A1IB')
endif
endif
endif
endif
call NQ7(OB7,"Buffer1",RZE*1.)
call NQ7(OB7,"Buffer2",RAE*1.)
endif
set t=null
set p5=null
return false
endfunction
function RBE takes unit WI7 returns nothing
