function CF_ADD_SPEED takes unit WI7 returns boolean
local integer V77=1
if MV7(WI7,ZU[FV])!=null or MV7(WI7,ZU[DS4])!=null or MV7(WI7,ZU[G6])!=null or MV7(WI7,ZU[H6])!=null or MV7(WI7,ZU[N6])!=null or MV7(WI7,ZU[F74])!=null or MV7(WI7,ZU[EC])!=null then
set V77=2
endif
if MV7(WI7,ZU[LB])!=null then
set V77=3
endif
if MV7(WI7,ZU[F6])!=null or MV7(WI7,ZU[FF6])!=null then
set V77=4
endif
if MV7(WI7,ZU[Q1])!=null or MV7(WI7,ZU[it_fzz])!=null then
call UnitAddAbility(WI7,'A4LA')
call SetUnitAbilityLevel(WI7,'A4LA',V77)
