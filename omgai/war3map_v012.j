endfunction
function IUD takes unit p5,unit m5 returns nothing
local integer OB7=GetHandleId(p5)
local group g=WS7()
local integer id=GetUnitTypeId(p5)
local string tx
if id=='Z00S' then
    set tx="model\\Hero_STormSpirit_N6S_V_Target_1.mdl"
    call DestroyEffect(AddSpecialEffect("effects\\ThunderclapCasterSound.mdl",GetUnitX(m5),GetUnitY(m5)))
elseif id=='Z10S' then
    set tx="model\\Hero_STormSpirit_N4S_V_Target_1.mdl"
    call DestroyEffect(AddSpecialEffect("effects\\ThunderclapCasterSound.mdl",GetUnitX(m5),GetUnitY(m5)))
elseif id=='Z20S' then
    set tx="model\\Hero_STormSpirit_N8S_V_Target_1.mdl"
    call DestroyEffect(AddSpecialEffect("effects\\ThunderclapCasterSound.mdl",GetUnitX(m5),GetUnitY(m5)))
else
    set tx="Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl"
endif
call DestroyEffect(OG7(OB7,"OverloadFX1"))
call DestroyEffect(OG7(OB7,"OverloadFX2"))
call OX7(p5,"OverloadActive")
set IN4=p5
set FZ=p5
set gZ=B287_GetUnitAbilityLevel(p5,'A0QW')*20+20
call GroupEnumUnitsInRange(g,GetUnitX(m5),GetUnitY(m5),300,Condition(function AJ7_gai))
call ForGroup(g,function ITD)
call WR7(g)
call DestroyEffect(AddSpecialEffect(tx,GetUnitX(m5),GetUnitY(m5)))
set g=null
endfunction
function IVD takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit m5=O77(OB7,"Target")
local unit p5=O77(OB7,"Source")
if GetTriggerEventId()==EVENT_UNIT_DAMAGED then
if GetEventDamageSource()==p5 and OT7(p5,"OverloadActive")then
call DisableTrigger(t)
call IUD(p5,m5)
call NM7(OB7)
call OZ7(t)
endif
else
call NM7(OB7)
call OZ7(t)
endif
set t=null
set m5=null
set p5=null
return false
endfunction
function IWD takes nothing returns nothing
local trigger t=CreateTrigger()
local unit m5=GetTriggerUnit()
local unit p5=GetAttacker()
local integer OB7=GetHandleId(t)
call TriggerRegisterUnitEvent(t,m5,EVENT_UNIT_DAMAGED)
call TriggerRegisterTimerEvent(t,2.5,false)
call TriggerAddCondition(t,Condition(function IVD))
call NT7(OB7,"Target",m5)
call NT7(OB7,"Source",p5)
set t=null
set m5=null
set p5=null
endfunction
function IXD takes nothing returns boolean
if B287_GetUnitAbilityLevel(GetAttacker(),'A0QW')>0 and OT7(GetAttacker(),"OverloadActive") and IsUnitType(GetTriggerUnit(),UNIT_TYPE_STRUCTURE)==false and IsUnitAlly(GetAttacker(),GetOwningPlayer(GetTriggerUnit()))==false and ISPH(GetAttacker())==false then
call IWD()
endif
return false
endfunction
function IYD takes nothing returns nothing
local trigger t=CreateTrigger()
local unit p5=GetTriggerUnit()
local integer OB7=GetHandleId(p5)
local string tx=""
local string tx2=""
local integer id=GetUnitTypeId(p5)
if IsUnitAlly(p5,GetLocalPlayer())or WG7(GetLocalPlayer())then
if id=='Z00S' then
set tx="model\\Hero_STormSpirit_N6S_V_Source_1.mdl"
set tx2="model\\Hero_STormSpirit_N6S_V_Source_2.mdl"
elseif id=='Z10S' then
set tx="model\\Hero_STormSpirit_N4S_V_Source_1.mdl"
set tx2="model\\Hero_STormSpirit_N4S_V_Source_2.mdl"
elseif id=='Z20S' then
set tx="model\\Hero_STormSpirit_N8S_V_Source_1.mdl"
set tx2="model\\Hero_STormSpirit_N8S_V_Source_2.mdl"
else
set tx="Abilities\\Weapons\\FarseerMissile\\FarseerMissile.mdl"
set tx2="Abilities\\Weapons\\FarseerMissile\\FarseerMissile.mdl"
endif
endif
call NU7(OB7,"OverloadFX1",AddSpecialEffectTarget(tx,p5,"right hand"))
call NU7(OB7,"OverloadFX2",AddSpecialEffectTarget(tx2,p5,"left hand"))
set t=null
set p5=null
endfunction
function IZD takes nothing returns boolean
local unit u=GetTriggerUnit()
local integer sid=B287_GetSpellAbilityId()
local item stormOverloadSourceItem=null
local boolean stormOverloadCanTrigger=false
if OT7(u,"OverloadActive")==false then
if sid=='A14O' or sid=='A14P' or sid=='A14R' or sid=='A2Z6' then
set stormOverloadCanTrigger=true
elseif (GetUnitPointValue(u)==500 or OO7(GetHandleId(u),"SuijiOverload")) and UL7(sid) and B287_GetUnitAbilityLevel(u,sid)>0 then
set stormOverloadSourceItem=MHAbility_GetSourceItem(u,B287_GetPhysicalAbilityId(u,sid))
set stormOverloadCanTrigger=stormOverloadSourceItem==null
endif
endif
if stormOverloadCanTrigger then
call OV7(u,"OverloadActive")
call IYD()
endif
set stormOverloadSourceItem=null
set u=null
return false
endfunction
function IAD takes unit p5,boolean UA9 returns nothing
local trigger t=CreateTrigger()
call TriggerRegisterUnitEvent(t,p5,EVENT_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function IZD))
if UA9 then
set nj[GetPlayerId(GetOwningPlayer(p5))]=t
endif
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_ATTACKED)
call TriggerAddCondition(t,Condition(function IXD))
if UA9 then
set Aj[GetPlayerId(GetOwningPlayer(p5))]=t
endif
set p5=null
set t=null
endfunction
function IBD takes nothing returns boolean
if B287_GetLearnedSkill()=='A0QW' and B287_GetUnitAbilityLevel(GetTriggerUnit(),'A0QW')==1 and IsUnitIllusion(GetTriggerUnit())==false then
call IAD(GetTriggerUnit(),false)
endif
return false
endfunction
