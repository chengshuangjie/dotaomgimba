if (B287_GetSpellAbilityId()=='A2RO' or B287_GetSpellAbilityId()=='A4LE') and (IsUnitAlly(GetSpellTargetUnit(),GetOwningPlayer(GetTriggerUnit())) or GetSpellTargetUnit()==null) then
call SEEE()
endif
endfunction
function JHEND takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit IH7=O77(OB7,"Target")
local integer DUR=OM7(OB7,"DUR")
if GetTriggerEventId()==EVENT_UNIT_DEATH or (GetTriggerEventId()==EVENT_UNIT_DAMAGED and (L3F(GetUnitTypeId(GetEventDamageSource()))==false and GetEventDamageSource()!=IH7 and GetOwningPlayer(GetEventDamageSource())!=B7 or GetUnitTypeId(GetEventDamageSource())=='n00L' and GetEventDamage()>0) or V14) or DUR>=40 then
call UnitRemoveAbility(IH7,'B0HU')
call UnitRemoveAbility(IH7,'A33D')
call RemoveSavedHandle(TABLE_HY, GetHandleId(IH7),'A33D')
call DestroyEffect(OG7(OB7,"FX"))
call NM7(OB7)
call OZ7(t)
endif
if GetUnitAbilityLevel(IH7,'B0HU')>0 then
call NP7(OB7,"DUR",DUR+1)
call SetUnitState(IH7,UNIT_STATE_MANA,GetUnitState(IH7,UNIT_STATE_MANA)+4.75)
endif
set t=null
set IH7=null
return false
endfunction
function DYEND takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit IH7=O77(OB7,"Target")
local integer DUR=OM7(OB7,"DUR")
if GetTriggerEventId()==EVENT_UNIT_DEATH or (GetTriggerEventId()==EVENT_UNIT_DAMAGED and (L3F(GetUnitTypeId(GetEventDamageSource()))==false and GetEventDamageSource()!=IH7 and GetOwningPlayer(GetEventDamageSource())!=B7 or GetUnitTypeId(GetEventDamageSource())=='n00L' and GetEventDamage()>0) or V14) or DUR>=80 then
call UnitRemoveAbility(IH7,'B0HV')
call UnitRemoveAbility(IH7,'A33E')
call RemoveSavedHandle(TABLE_HY, GetHandleId(IH7),'A33E')
call DestroyEffect(OG7(OB7,"FX"))
call NM7(OB7)
call OZ7(t)
endif
if GetUnitAbilityLevel(IH7,'B0HV')>0 then
call NP7(OB7,"DUR",DUR+1)
call SetUnitState(IH7,UNIT_STATE_LIFE,GetUnitState(IH7,UNIT_STATE_LIFE)+5)
if GetUnitState(IH7,UNIT_STATE_LIFE)!=GetUnitState(IH7,UNIT_STATE_MAX_LIFE) then
call HXXS("+5",1,IH7,.02)
endif
endif
set t=null
set IH7=null
return false
endfunction
function E9G takes nothing returns nothing
local trigger t
local integer OB7
local unit I_7=GetTriggerUnit()
local unit IH7=GetSpellTargetUnit()
local integer I97
if GetSpellTargetUnit()==null then
set IH7=I_7
endif
set I97=GetHandleId(IH7)
if B287_GetSpellAbilityId()=='Abpl' then
if HaveSavedHandle(TABLE_HY, I97,'A33D') then
    set t=LoadTriggerHandle(TABLE_HY, I97,'A33D')
    set OB7=GetHandleId(t)
    call NP7(OB7,"DUR",0)
else
    set t=CreateTrigger()
    set OB7=GetHandleId(t)
    call XF7(IH7,'A33D')
	call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIma\\AImaTarget.mdl",IH7,"origin"))
    call NT7(OB7,"Target",IH7)
    call NU7(OB7,"FX",AddSpecialEffectTarget("Abilities\\Spells\\Other\\ANrl\\ANrlTarget.mdx",IH7,"origin"))
    call NP7(OB7,"DUR",0)
    call SaveTriggerHandle(TABLE_HY, I97,'A33D',t)
    call TriggerRegisterTimerEvent(t,1,true)
    call TriggerRegisterUnitEvent(t,IH7,EVENT_UNIT_DEATH)
    call TriggerRegisterUnitEvent(t,IH7,EVENT_UNIT_DAMAGED)
    call TriggerAddCondition(t,Condition(function JHEND))
endif
elseif B287_GetSpellAbilityId()=='Abpr' then
if HaveSavedHandle(TABLE_HY, I97,'A33E') then
    set t=LoadTriggerHandle(TABLE_HY, I97,'A33E')
    set OB7=GetHandleId(t)
    call NP7(OB7,"DUR",0)
else
    set t=CreateTrigger()
    set OB7=GetHandleId(t)
    call XF7(IH7,'A33E')
    call NT7(OB7,"Target",IH7)
    call NU7(OB7,"FX",AddSpecialEffectTarget("effects\\SapphiricBoost.mdx",IH7,"chest"))
    call NP7(OB7,"DUR",0)
    call SaveTriggerHandle(TABLE_HY, I97,'A33E',t)
    call TriggerRegisterTimerEvent(t,0.1,true)
    call TriggerRegisterUnitEvent(t,IH7,EVENT_UNIT_DEATH)
    call TriggerRegisterUnitEvent(t,IH7,EVENT_UNIT_DAMAGED)
    call TriggerAddCondition(t,Condition(function DYEND))
endif
endif
set I_7=null
set IH7=null
set t=null
endfunction
