function WVF takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local player p=O97(OB7,"p")
local integer B07=OM7(OB7,"TargetIndex")
local unit m5=TQ7(B07)
local integer V77=OM7(OB7,"Level")
local integer id=OM7(OB7,"ID")
local unit p5=O77(OB7,"Source")
local unit BU7=O77(OB7,"Projectile")
local real x=GetUnitX(BU7)
local real y=GetUnitY(BU7)
local real Y5=GetUnitX(m5)
local real Z5=GetUnitY(m5)
local real F4=$3E8*.035
local real l4=J77(x,y,Y5,Z5)
local real BV9=x+F4*Cos(l4*bj_DEGTORAD)
local real BW9=y+F4*Sin(l4*bj_DEGTORAD)
local boolean Z18=OO7(OB7,"Active")
local boolean b=OO7(OB7,"b")
local boolean ISSTOP=false
call SetUnitX(BU7,BV9)
call SetUnitY(BU7,BW9)
call SetUnitFacing(BU7,l4)
if b then
    call SetUnitX(p5,BV9)
    call SetUnitY(p5,BW9)
    call SetUnitFacing(p5,l4)
    if KF7(GetUnitX(p5),GetUnitY(p5),Y5,Z5)>2500 then
        set ISSTOP=true
    endif
endif
if BlockUnitPass(BU7) then
    set ISSTOP=true
endif
if b==false and ISDODGE(m5) then
    set ISSTOP=true
endif
if KF7(Y5,Z5,BV9,BW9)<=F4 or ISSTOP then
    if Z18 and ISSTOP==false and AM7(m5,p)==false then
        call WUF(p5,m5,V77,id)
    endif
    call KillUnit(BU7)
    if b then
        call SetUnitInvulnerable(p5,false)
        call PauseUnitEx(p5,false)
        call IssueTargetOrderById(p5,$D000F,m5)
    endif
    call TP7(B07)
    call NM7(OB7)
    call OZ7(t)
endif
set t=null
set p=null
set p5=null
set m5=null
set BU7=null
return false
endfunction
function Set_FBZC_Cooldown takes unit ZX7,boolean b returns nothing
    local real d=ReduceUnitAbilityCoolDownReal(ZX7)
    local real cooldown=12
    if PT4 then
        return
    endif
    if d>0 then
        set cooldown=cooldown*d
    endif
    if b then
call Japi_ReduceUnitAbilityCoolDown(ZX7,'A190',cooldown)
    elseif GetUnitAbilityLevel(ZX7,'A4IL')>0 then
        call Japi_ReduceUnitAbilityCoolDown(ZX7,'A4IL',cooldown)
    endif
endfunction
function WWF takes nothing returns nothing
local unit p5=GetTriggerUnit()
local integer skill=B287_GetSpellAbilityId()
local integer V77=B287_GetUnitAbilityLevel(p5,skill)
local unit m5=GetSpellTargetUnit()
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local unit BU7
local boolean Z18=WQ7(GetSpellTargetUnit())==false
local integer id=GetUnitTypeId(p5)
local integer skillmj
local boolean b=false
if WQ7(m5) then
    call PLK(m5)
endif
if skill=='A4IL' then
    set b=true
endif
if id=='Z001' or id=='Z0CQ' then
set skillmj='h17Q'
else
set skillmj='h07Q'
endif
if b then
call SetUnitInvulnerable(p5,true)
call PauseUnitEx(p5,true)
endif
call Set_FBZC_Cooldown(p5,b)
set BU7=CreateUnit(GetOwningPlayer(p5),skillmj,GetUnitX(p5),GetUnitY(p5),J77(GetUnitX(p5),GetUnitY(p5),GetUnitX(m5),GetUnitY(m5)))
call NS7(OB7,"Active",Z18)
call NZ7(OB7,"p",GetOwningPlayer(p5))
call NP7(OB7,"TargetIndex",TS7(m5))
call NT7(OB7,"Source",p5)
call NT7(OB7,"Projectile",BU7)
call NP7(OB7,"Level",V77)
call NP7(OB7,"ID",id)
call NS7(OB7,"b",b)
call TriggerRegisterTimerEvent(t,.035,true)
call TriggerAddCondition(t,Condition(function WVF))
set t=null
set p5=null
set m5=null
set BU7=null
endfunction
function WXF takes nothing returns boolean
local integer id=GetUnitTypeId(GetTriggerUnit())
if B287_GetSpellAbilityId()=='A190' or B287_GetSpellAbilityId()=='A4IL' then
if GetTriggerEventId()==EVENT_PLAYER_UNIT_SPELL_CAST then
if id=='Z001' or id=='Z0CQ' then
call DestroyEffect(AddSpecialEffectTarget("model\\Hero_Sven_N7S_T_Start_Weapon.mdl",GetTriggerUnit(),"weapon"))
else
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\Bolt\\BoltImpact.mdl",GetTriggerUnit(),"weapon"))
endif
else
call WWF()
endif
endif
return false
endfunction
