function CBD takes nothing returns nothing
local unit WX7=GetTriggerUnit()
local unit BB7
local group g=WS7()
local real W27=GetUnitFacing(WX7)
local real x
local real y
local real Xww=0
local unit u2
local integer id=B287_GetSpellAbilityId()
local integer BC7=B287_GetUnitAbilityLevel(WX7,id)
local real AGI=0.
local real d=75*BC7+25
local integer i1=GetUnitTypeId(WX7)
local boolean suijiShadowRazeAgh=SuijiMode_HasAghanimState(WX7) or GetUnitAbilityLevel(WX7,'A1MU')>0 or B287_GetUnitAbilityLevel(WX7,'A1MP')>0
local string suijiShadowRazeAghText="0"
if suijiShadowRazeAgh then
	set suijiShadowRazeAghText="1"
	set AGI=GetHeroAgi(WX7,true)*.5
	set d=d+AGI
endif
if SUIJI_MODE and SUIJI_AGH_DEBUG[GetPlayerId(GetOwningPlayer(WX7))] then
call DisplayTextToPlayer(GetOwningPlayer(WX7),0,0,"|cFFFF8080[A杖诊断:影压]|r skill="+GetAbilityName(id)+" state="+suijiShadowRazeAghText+" 等级="+I2S(BC7)+" 基础="+R2S(75*BC7+25)+" 敏捷加成="+R2S(AGI)+" 最终="+R2S(d))
endif
if id=='A0EY' then
set Xww=200.
elseif id=='A0FH' then
set Xww=450.
elseif id=='A0F0' then
set Xww=700.
endif
set x=GetUnitX(WX7)+Xww*Cos(W27*bj_DEGTORAD)
set y=GetUnitY(WX7)+Xww*Sin(W27*bj_DEGTORAD)
if i1=='Zfir' or i1=='Zgir' then
	call DestroyEffect(AddSpecialEffect("model\\Hero_ShadowFiend_N8S_X_Boom.mdl",x,y))
elseif i1=='Zhir' then
	call DestroyEffect(AddSpecialEffect("model\\Hero_ShadowFiend_N4S_X_Boom.mdl",x,y))
else
	set BB7=CreateUnit(GetOwningPlayer(WX7),'e006',x,y,0)
	call UnitApplyTimedLife(BB7,'BTLF',2)
endif
call GroupEnumUnitsInRange(g,x,y,275,Condition(function CZD))
loop
set u2=FirstOfGroup(g)
exitwhen u2==null
call B67(WX7,u2,1,d)
call GroupRemoveUnit(g,u2)
endloop
call WR7(g)
set WX7=null
set BB7=null
set g=null
set suijiShadowRazeAghText=null
endfunction
