if id=='n11U' then
// call XF7(oA,'X0XJ'+T7F)
set skilltx='h0GT'
elseif id=='n21U' then
// call XF7(oA,'X1XJ'+T7F)
set skilltx='h0GU'
elseif id=='n31U' then
// call XF7(oA,'X2XJ'+T7F)
set skilltx='h0GV'
else
// call XF7(oA,1093687371)
// call SetUnitAbilityLevel(oA,1093687371,T7F)
// call XF7(oA,1093687371)
// call SetUnitAbilityLevel(oA,1093687371,T7F)
// call XF7(oA,1093687371)
// call SetUnitAbilityLevel(oA,1093687371,T7F)
set skilltx='h0GS'
endif



if WF7(m5)==false then
call MNXCF(p5,m5,skilltx,T9F,false)
call B27_KAERCF(T8F,m5,1,70+(S1F+T7F)*20.,T9F+.1)
endif
call UnitApplyTimedLife(T8F,'BTLF',T9F+1.)
// if KCD(m5) then
// else
// call IssueTargetOrderById(oA,$D00B0,m5)
// call B27(T8F,m5,1,70+(S1F+T7F)*20.,T9F)
// endif
// set oA=null
// if KCD(m5) then
// else
// call IssueTargetOrderById(oA,$D00B0,m5)
// call B27(T8F,m5,1,70+(S1F+T7F)*20.,T9F)
// endif
// set oA=null
// if KCD(m5) then
// else
// call IssueTargetOrderById(oA,$D00B0,m5)
// call B27(T8F,m5,1,70+(S1F+T7F)*20.,T9F)
// endif
// set oA=null
set T8F=null
endfunction
