local unit JED
local unit BB7=CreateUnit(GetOwningPlayer(p5),'e00E',GetUnitX(p5),GetUnitY(p5),0)
local integer level=B287_GetUnitAbilityLevel(p5,B287_GetSpellAbilityId())
