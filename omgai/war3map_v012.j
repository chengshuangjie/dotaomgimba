function H1G takes nothing returns nothing
local unit p5=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local real t5=GetUnitX(p5)
local real w5=GetUnitY(p5)
local real Y5=GetUnitX(m5)
local real Z5=GetUnitY(m5)
local real l4=J77(t5,w5,Y5,Z5)
local real BAD=KF7(t5,w5,Y5,Z5)
local real d=GetRandomReal(BAD*.3,BAD*.8)
local integer V77=B287_GetUnitAbilityLevel(p5,'A0RW')
local real SIE=t5+d*Cos(l4*bj_DEGTORAD)
local real SJE=w5+d*Sin(l4*bj_DEGTORAD)
local unit u
local unit u2
local group g
local trigger t
local integer OB7
local integer id=GetUnitTypeId(p5)
if id=='Z00A' then
call YT7("model\\Hero_ChaosKnight_N1S_E_Self.mdl",GetUnitX(p5),GetUnitY(p5),0.5)
elseif id=='Z10A' then
call YT7("model\\Hero_ChaosKnight_N2S_E_Self.mdl",GetUnitX(p5),GetUnitY(p5),0.5)
else
set u=CreateUnit(GetOwningPlayer(p5),EB,SIE,SJE,0)
call KillUnit(u)
endif
call SetUnitX(p5,SIE)
call SetUnitY(p5,SJE)
call SetUnitFacing(p5,-l4)
call PlaySoundOnUnitBJ(zE,100,m5)
if id=='Z00A' then
set u=CreateUnit(GetOwningPlayer(p5),'h16J',SIE,SJE,90)
call KillUnit(u)
elseif id=='Z10A' then
set u=CreateUnit(GetOwningPlayer(p5),'h26J',SIE,SJE,90)
call KillUnit(u)
endif
if IsUnitEnemy(m5,GetOwningPlayer(p5)) and GetUnitTypeId(m5)!='n00L' then
set t=CreateTrigger()
set OB7=GetHandleId(t)
call TriggerRegisterTimerEvent(t,1.2,false)
call TriggerRegisterUnitEvent(t,p5,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function H6G))
call NT7(OB7,"Source",p5)
set t=null
call B_7(p5,75+25*V77)
set SIE=t5+(d-25)*Cos(l4*bj_DEGTORAD)
set SJE=w5+(d-25)*Sin(l4*bj_DEGTORAD)
call O37(m5,"4405",1)
call SetUnitX(m5,SIE)
call SetUnitY(m5,SJE)
call SetUnitFacing(m5,l4)
call IssueTargetOrderById(p5,$D000F,m5)
set g=WS7()
set OB=SIE
set AB=SJE
set BB=p5
set cB=m5
call GroupEnumUnitsInRange(g,t5,w5,$578,Condition(function HLG))
call WR7(g)
if id=='Z00A' then
call YT7("model\\Hero_ChaosKnight_N1S_E_Self.mdl",SIE,SJE,0.5)
elseif id=='Z10A' then
call YT7("model\\Hero_ChaosKnight_N2S_E_Self.mdl",SIE,SJE,0.5)
else
set u2=CreateUnit(GetOwningPlayer(p5),EB,SIE,SJE,0)
call KillUnit(u2)
endif
call LINGXIA(p5,m5)
endif
set p5=null
set m5=null
set u=null
set u2=null
set g=null
endfunction
