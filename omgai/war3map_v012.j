call B67(UY4,GetEnumUnit(),1,UZ4*20+20)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\Bolt\\BoltImpact.mdl",GetEnumUnit(),"chest"))
endif
endfunction
function SDG takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local unit IH7=(LoadUnitHandle(L7,(I97),(17)))
local unit BB7=(LoadUnitHandle(L7,(I97),(19)))
local unit Y27=(LoadUnitHandle(L7,(I97),(45)))
local integer BC7=(LoadInteger(L7,(I97),(5)))
local group g
local integer QSG=GetTriggerEvalCount(t)
local unit SEG=null
local boolexpr suijiThunderStormFilter=null
if ZX7==null or IH7==null or BB7==null or Y27==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 or GetUnitTypeId(BB7)==0 or GetUnitTypeId(Y27)==0 then
if BB7!=null and GetUnitTypeId(BB7)!=0 then
call KillUnit(BB7)
endif
if Y27!=null and GetUnitTypeId(Y27)!=0 then
call KillUnit(Y27)
endif
call FlushChildHashtable(L7,(I97))
call OZ7(t)
set t=null
set ZX7=null
set IH7=null
set BB7=null
set Y27=null
return false
endif
call SetUnitX(BB7,GetUnitX(IH7))
call SetUnitY(BB7,GetUnitY(IH7))
call SetUnitX(Y27,GetUnitX(IH7))
call SetUnitY(Y27,GetUnitY(IH7))
if QSG==1 or QSG==100 or QSG==$C8 or QSG==300 then
set g=WS7()
if XH7(IH7)then
set SEG=CreateUnit(GetOwningPlayer(IH7),'e00C',GetUnitX(IH7),GetUnitY(IH7),0)
call UnitApplyTimedLife(SEG,'BTLF',.2)
call IssueTargetOrderById(BB7,$D0097,SEG)
else
call IssueTargetOrderById(BB7,$D0097,IH7)
call B67(ZX7,IH7,1,BC7*20+20)
if QSG==1 then
    call LINGXIA(ZX7,IH7)
endif
endif
call YS7("war3mapImported\\ThunderStorm_Groundeffect.mdx",IH7,"origin",.6)
set IN4=ZX7
set UY4=ZX7
set UX4=IH7
set UZ4=BC7
set suijiThunderStormFilter=Condition(function AJ7_gai)
call GroupEnumUnitsInRange(g,GetUnitX(IH7),GetUnitY(IH7),240+25,suijiThunderStormFilter)
call ForGroup(g,function S9G)
call WR7(g)
call DestroyBoolExpr(suijiThunderStormFilter)
if GetTriggerEvalCount(t)==300 then
call KillUnit(BB7)
call KillUnit(Y27)
call FlushChildHashtable(L7,(I97))
call OZ7(t)
endif
endif
set t=null
set ZX7=null
set IH7=null
set BB7=null
set g=null
set SEG=null
set Y27=null
set suijiThunderStormFilter=null
return false
endfunction
function SFG takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local unit IH7=GetSpellTargetUnit()
local trigger t=null
local integer I97=0
local integer BC7=0
local unit BB7=null
local unit Y27=null
if ZX7==null or IH7==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 then
set ZX7=null
set IH7=null
return
endif
set t=CreateTrigger()
set I97=GetHandleId(t)
set BC7=B287_GetUnitAbilityLevel(ZX7,'A1TV')
set BB7=CreateUnit(GetOwningPlayer(IH7),'e00E',GetUnitX(IH7),GetUnitY(IH7),0)
set Y27=CreateUnit(GetOwningPlayer(ZX7),'e02P',GetUnitX(IH7),GetUnitY(IH7),0)
call XF7(Y27,'Aloc')
call XF7(BB7,'A1U7')
call SetUnitAbilityLevel(BB7,'A1U7',BC7)
call XF7(BB7,'Aloc')
call TriggerRegisterTimerEvent(t,.02,true)
call TriggerAddCondition(t,Condition(function SDG))
call SaveUnitHandle(L7,(I97),(2),(ZX7))
call SaveUnitHandle(L7,(I97),(17),(IH7))
call SaveUnitHandle(L7,(I97),(19),(BB7))
call SaveUnitHandle(L7,(I97),(45),(Y27))
call SaveInteger(L7,(I97),(5),(BC7))
set ZX7=null
set IH7=null
set BB7=null
set t=null
set Y27=null
endfunction
function SGG takes nothing returns boolean
if B287_GetSpellAbilityId()=='A1TV' and WQ7(GetSpellTargetUnit())==false then
call SFG()
endif
return false
endfunction
