call DestroyEffect(AddSpecialEffectTarget(tx,hn,"origin"))
if WGE==1 then
set WEE='X104'
set WFE='X107'
elseif WGE==2 then
set WEE='X101'
set WFE='X106'
elseif WGE==3 then
set WEE='X102'
set WFE='X105'
elseif WGE==4 then
set WEE='X103'
set WFE='X108'
endif
elseif id=='Z009' or id=='E116' then
set tx="model\\hero_lycan_n3s_w_source.mdl"
call DestroyEffect(AddSpecialEffectTarget(tx,hn,"origin"))
if WGE==1 then
set WEE='X204'
set WFE='X207'
elseif WGE==2 then
set WEE='X201'
set WFE='X206'
elseif WGE==3 then
set WEE='X202'
set WFE='X205'
elseif WGE==4 then
set WEE='X203'
set WFE='X208'
endif
else
