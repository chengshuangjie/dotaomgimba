//非魔免，无视林肯吹风
function GetEscapeHero_PD1 takes nothing returns boolean
return (IsUnitType(GetFilterUnit(),UNIT_TYPE_HERO) and IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(IN4)) and M87(GetFilterUnit()) and IsUnitVisible(GetFilterUnit(),GetOwningPlayer(IN4)) and IsMagicImmuneUnit(GetFilterUnit())==false and ISINQS(GetFilterUnit())==false and IsUnitInRange(IN4,GetFilterUnit(),200)==false and GetUnitAbilityLevel(GetFilterUnit(),'A04R')==0 and GetUnitTypeId(GetFilterUnit())!='N0MM')!=null
endfunction
//非魔免，非林肯，非吹风
function GetEscapeHero_PD2 takes nothing returns boolean
return (IsUnitType(GetFilterUnit(),UNIT_TYPE_HERO) and IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(IN4)) and M87(GetFilterUnit()) and IsUnitVisible(GetFilterUnit(),GetOwningPlayer(IN4)) and WQ7(GetFilterUnit())==false and IsMagicImmuneUnit(GetFilterUnit())==false and IsUnitInRange(IN4,GetFilterUnit(),200)==false and ISINQS(GetFilterUnit())==false and GetUnitAbilityLevel(GetFilterUnit(),'A04R')==0 and CHUIFENG(GetFilterUnit())==false and CANNOT_SELECT(GetFilterUnit())==false and GetUnitTypeId(GetFilterUnit())!='N0MM')!=null
endfunction
//无视魔免，非林肯，非吹风
function GetEscapeHero_PD3 takes nothing returns boolean
return (IsUnitType(GetFilterUnit(),UNIT_TYPE_HERO) and IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(IN4)) and M87(GetFilterUnit()) and IsUnitVisible(GetFilterUnit(),GetOwningPlayer(IN4)) and WQ7(GetFilterUnit())==false and ISINQS(GetFilterUnit())==false and IsUnitInRange(IN4,GetFilterUnit(),200)==false and GetUnitAbilityLevel(GetFilterUnit(),'A04R')==0 and CHUIFENG(GetFilterUnit())==false and CANNOT_SELECT(GetFilterUnit())==false and GetUnitTypeId(GetFilterUnit())!='N0MM')!=null
endfunction
function GetEscapeHero takes unit W4I,real r,integer Type returns unit
local unit u1=null
local unit EscapeHero=null
local integer id=GetUnitTypeId(W4I)
local group g=WS7()
set IN4=W4I
if Type==1 then
call GroupEnumUnitsInRange(g,GetUnitX(W4I),GetUnitY(W4I),r,Condition(function GetEscapeHero_PD1))
elseif Type==2 then
call GroupEnumUnitsInRange(g,GetUnitX(W4I),GetUnitY(W4I),r,Condition(function GetEscapeHero_PD2))
elseif Type==3 then
call GroupEnumUnitsInRange(g,GetUnitX(W4I),GetUnitY(W4I),r,Condition(function GetEscapeHero_PD3))
endif
set EscapeHero=FirstOfGroup(g)
loop
set u1=FirstOfGroup(g)
exitwhen u1==null
call GroupRemoveUnit(g,u1)
if GetUnitState(EscapeHero,UNIT_STATE_LIFE)>GetUnitState(u1,UNIT_STATE_LIFE) then
set EscapeHero=u1
endif
endloop
call GroupClear(g)
call WR7(g)
set u1=null
set g=null
return EscapeHero
endfunction
function Z_7 takes unit S4 returns boolean
local integer z8=GetUnitTypeId(S4)
return z8=='n004' or z8=='n01G' or z8=='n01C' or z8=='n018' or z8=='e00K' or z8=='e00I' or z8=='e00L' or z8=='e01J'
endfunction
function A47 takes nothing returns boolean
