function TechiesBlastOff_OnSpellCast takes nothing returns nothing
local unit caster=GetTriggerUnit()
call SetUnitAnimation(caster,"spell")
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",GetUnitX(caster),GetUnitY(caster)))
set caster=null
endfunction
function TechiesBlastOff_OnSpellEffect takes nothing returns nothing
local unit caster=GetTriggerUnit()
local unit spellTarget=GetSpellTargetUnit()
local unit target
local group g=WS7()
local integer level=B287_GetUnitAbilityLevel(caster,'A06B')
local real x=GetSpellTargetX()
local real y=GetSpellTargetY()
local real damage=100.+100.*level
local real stun=.6+.2*level
local real life=GetUnitState(caster,UNIT_STATE_LIFE)
if spellTarget!=null then
set x=GetUnitX(spellTarget)
set y=GetUnitY(spellTarget)
endif
if level<1 then
set level=1
elseif level>4 then
set level=4
endif
set damage=100.+100.*level
set stun=.6+.2*level
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl",GetUnitX(caster),GetUnitY(caster)))
call SetUnitX(caster,CoordinateX50(x))
call SetUnitY(caster,CoordinateY50(y))
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Other\\NeutralBuildingExplosion\\NeutralBuildingExplosion.mdl",x,y))
call GroupEnumUnitsInRange(g,x,y,400.,null)
loop
set target=FirstOfGroup(g)
exitwhen target==null
call GroupRemoveUnit(g,target)
if UnitAlive(target) and IsUnitEnemy(target,GetOwningPlayer(caster)) and not IsUnitType(target,UNIT_TYPE_STRUCTURE) and GetUnitAbilityLevel(target,'A04R')==0 and not XH7(target) then
call B67(caster,target,3,damage)
call CommonUnitAddStun(target,stun,false)
endif
endloop
call SetUnitState(caster,UNIT_STATE_LIFE,RMaxBJ(life*.8,1.))
call WR7(g)
set caster=null
set spellTarget=null
set target=null
set g=null
endfunction
function TechiesStickyBomb_FindTarget takes unit caster,real x,real y returns unit
local group g=WS7()
local unit u=null
local unit best=null
local player p=GetOwningPlayer(caster)
local real dx
local real dy
local real d
local real bestD=999999.
call GroupEnumUnitsInRange(g,x,y,300.,null)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call GroupRemoveUnit(g,u)
if UnitAlive(u) and IsUnitEnemy(u,p) and not IsUnitType(u,UNIT_TYPE_STRUCTURE) and GetUnitAbilityLevel(u,'A04R')==0 and not XH7(u) and not IsMagicImmuneUnit(u) then
set dx=GetUnitX(u)-x
set dy=GetUnitY(u)-y
set d=dx*dx+dy*dy
if d<bestD then
set bestD=d
set best=u
endif
endif
endloop
call WR7(g)
set g=null
set u=null
set p=null
return best
endfunction
function TechiesStickyBomb_OnTimer takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer h=GetHandleId(t)
local unit caster=LoadUnitHandle(L7,h,0)
local unit bomb=LoadUnitHandle(L7,h,1)
local unit stickTarget=LoadUnitHandle(L7,h,2)
local integer level=LoadInteger(L7,h,3)
local real x=LoadReal(L7,h,4)
local real y=LoadReal(L7,h,5)
local real start=LoadReal(L7,h,6)
local real now=TimerGetElapsed(W)
local real damage=20.+75.*level
local group g=null
local unit u=null
if stickTarget!=null and UnitAlive(stickTarget) and not XH7(stickTarget) then
set x=GetUnitX(stickTarget)
set y=GetUnitY(stickTarget)
call SaveReal(L7,h,4,x)
call SaveReal(L7,h,5,y)
endif
if bomb!=null and not XH7(bomb) then
call SetUnitX(bomb,CoordinateX50(x))
call SetUnitY(bomb,CoordinateY50(y))
endif
if now-start>=2. then
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Other\\NeutralBuildingExplosion\\NeutralBuildingExplosion.mdl",x,y))
set g=WS7()
call GroupEnumUnitsInRange(g,x,y,350.,null)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call GroupRemoveUnit(g,u)
if UnitAlive(u) and IsUnitEnemy(u,GetOwningPlayer(caster)) and not IsUnitType(u,UNIT_TYPE_STRUCTURE) and GetUnitAbilityLevel(u,'A04R')==0 and not XH7(u) and not IsMagicImmuneUnit(u) then
call B67(caster,u,3,damage)
if UnitAlive(u) and not XH7(u) then
call Z57(u,'A3SC',level,3.,'B3SC')
endif
endif
endloop
call WR7(g)
if bomb!=null then
call RemoveUnit(bomb)
endif
call FlushChildHashtable(L7,h)
call PauseTimer(t)
call DestroyTimer(t)
endif
set t=null
set caster=null
set bomb=null
set stickTarget=null
set g=null
set u=null
endfunction
function TechiesStickyBomb_OnSpellEffect takes nothing returns nothing
local unit caster=GetTriggerUnit()
local unit spellTarget=GetSpellTargetUnit()
local unit stickTarget=null
local unit bomb=null
local timer t=CreateTimer()
local integer h=GetHandleId(t)
local integer level=B287_GetUnitAbilityLevel(caster,'A05J')
local real x=GetSpellTargetX()
local real y=GetSpellTargetY()
if spellTarget!=null then
set x=GetUnitX(spellTarget)
set y=GetUnitY(spellTarget)
endif
if level<1 then
set level=1
elseif level>4 then
set level=4
endif
set x=CoordinateX50(x)
set y=CoordinateY50(y)
set stickTarget=TechiesStickyBomb_FindTarget(caster,x,y)
if stickTarget!=null then
set x=GetUnitX(stickTarget)
set y=GetUnitY(stickTarget)
endif
set bomb=CreateUnit(GetOwningPlayer(caster),'e0SB',x,y,0)
call SetUnitPathing(bomb,false)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\AcidBomb\\BottleImpact.mdl",x,y))
if stickTarget!=null then
call Z57(stickTarget,'A3SB',level,2.,'B3SB')
endif
call FlushChildHashtable(L7,h)
call SaveUnitHandle(L7,h,0,caster)
call SaveUnitHandle(L7,h,1,bomb)
call SaveUnitHandle(L7,h,2,stickTarget)
call SaveInteger(L7,h,3,level)
call SaveReal(L7,h,4,x)
call SaveReal(L7,h,5,y)
call SaveReal(L7,h,6,TimerGetElapsed(W))
call TimerStart(t,.03,true,function TechiesStickyBomb_OnTimer)
set caster=null
set spellTarget=null
set stickTarget=null
set bomb=null
set t=null
endfunction
function W6A takes nothing returns boolean
	local integer i = B287_GetSpellAbilityId()
	local eventid id = GetTriggerEventId()
	if i != 0 then
if i=='A06B' and id==EVENT_UNIT_SPELL_CAST then
call TechiesBlastOff_OnSpellCast()
elseif id==EVENT_UNIT_SPELL_EFFECT then
if i=='A05J' then
call TechiesStickyBomb_OnSpellEffect()
elseif i=='A06B' then
call TechiesBlastOff_OnSpellEffect()
endif
			call UTA(GetTriggerUnit(), i)
		endif
	endif
	set id=null
	return false
endfunction
