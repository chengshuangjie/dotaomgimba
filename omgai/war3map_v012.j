function XGKZ takes unit WI7,unit m5 returns nothing
local unit BB7=CreateUnit(GetOwningPlayer(WI7),'e00E',GetUnitX(m5),GetUnitY(m5),0)
local real d
local integer id=GetUnitTypeId(WI7)
local string tx
if id=='Z00C' then
    set tx="model\\Hero_Lifestealer_N2S_F_Control.mdl"
else
    set tx="Abilities\\Spells\\Other\\Charm\\CharmTarget.mdl"
endif
call DestroyEffect(AddSpecialEffectTarget(tx,m5,"overhead"))
call UnitAddAbility(BB7,'A2S3')
call IssueTargetOrder(BB7,"charm",m5)
call UnitApplyTimedLife(BB7,'BTLF',1.)
call ClearSelectionForPlayer(GetOwningPlayer(WI7))
call SelectUnitForPlayerSingle(m5,GetOwningPlayer(WI7))
call SetUnitState(m5,UNIT_STATE_MANA,GetUnitState(m5,UNIT_STATE_MAX_MANA))
call UnitRemoveAbility(WI7,'A4FM')
set d=GetUnitDefaultMoveSpeed(WI7)+ I2R(U3V(WI7))
call SetUnitMoveSpeed(m5,R2I(d))
set BB7=null
endfunction
function XGZN takes unit ZX7,unit IH7 returns nothing
    if B287_GetUnitAbilityLevel(ZX7,'A4EU')>0 and WF7(IH7)==false then
	    call Z57(IH7,'A4FM'+B287_GetUnitAbilityLevel(ZX7,'A4EU'), 1, 1.5,'B0JP')
        call YS7("Abilities\\Spells\\Human\\slow\\slowtarget.mdl",IH7,"origin",1.5)
    endif
endfunction
function ZCXGZN takes nothing returns nothing //食尸鬼之怒
    // Random-skill illusions run this effect from the proven tier-0 bridge
    // callback below.  Keeping it out of this original callback prevents the
    // same attack from applying the timed slow twice.
    if IsUnitIllusion(WXX) and SuijiMode_GetIllusionPassiveBridgeLevel(WXX,'A4EU')>0 then
        return
    endif
    if ISPH(WXX)==false and LoadBoolean(TABLE_HY, EOO, 11)==false and LoadBoolean(TABLE_HY, EOO, 14) and LoadBoolean(TABLE_HY, EOO, 15) and B287_GetUnitAbilityLevel(WXX,'A4EU')>0 and WF7(YXX)==false then
        call XGZN(WXX,YXX)
    endif
endfunction
function fj_Actions takes nothing returns boolean
	local trigger t = GetTriggeringTrigger()
    local integer OB7=GetHandleId(t)
    local unit u=LoadUnitHandle(ExtraHT, OB7, 0)
    local real n=LoadReal(ExtraHT, OB7, 0)
	if GetTriggerEventId()==EVENT_WIDGET_DEATH or GetGameTime()>n or (GetUnitAbilityLevel(u,'A4DO')==0 and GetTriggerEvalCount(t)>2) then
        call RemoveSavedHandle( ExtraHT, 'fjzd', GetHandleId(u))
        call NM7(OB7)
		call OZ7(t)
	// elseif GetTriggerEventId()== EVENT_UNIT_DAMAGED then
	// 	if(EXGetEventDamageData(1) != 0) and GetUnitAbilityLevel(u,'A4DO')> 0 and GetEventDamage() > 1.00 then
	// 		call Z57(u,'A4DP', 1, 0.4,'B0J7') //否决减速
	// 	endif
	// elseif GetTriggerEventId()== EVENT_UNIT_DAMAGED then
	// 	if(EXGetEventDamageData(1) != 0) and GetUnitAbilityLevel(u,'A4DO')> 0 and GetEventDamage() > 1.00 then
	// 		call Z57(u,'A4DP', 1, 0.4,'B0J7') //否决减速
	// 	endif
    elseif GetTriggerEventId()==EVENT_UNIT_ISSUED_ORDER or GetTriggerEventId()==EVENT_UNIT_ISSUED_TARGET_ORDER or GetTriggerEventId()==EVENT_UNIT_ISSUED_POINT_ORDER then
		if GetIssuedOrderId()>= 852008 and GetIssuedOrderId()<= 852013 then
            call KR7(u)
            call X37(GetOwningPlayer(u),"你被否决了，无法使用物品!")
		endif
	endif
	set t = null
	set u = null
	return false
endfunction
function fj_exec takes unit u,unit u2 returns nothing
	// local unit u = U22
	// local unit u2 = W22
	// local unit u = U22
	// local unit u2 = W22
	// local unit u = U22
	// local unit u2 = W22
	local trigger t
    local integer OB7
	if (IsUnitType(u2,UNIT_TYPE_HERO)==false and AS7(u2)==false) or UnitAlive(u2)==false then
        set u=null
        set u2=null
        return
    endif
    call Z57(u2,'A4DO', 1, 5.0,'B0J6')
    if HaveSavedHandle(ExtraHT, 'fjzd', GetHandleId(u2)) then
        set t=LoadTriggerHandle(ExtraHT, 'fjzd', GetHandleId(u2))
        set OB7=GetHandleId(t)
        call SaveReal(ExtraHT, OB7, 0, GetGameTime()+5.)
    else
        set t = CreateTrigger()
        set OB7=GetHandleId(t)
        call SaveUnitHandle(ExtraHT, OB7, 0, u2)
        call SaveReal(ExtraHT, OB7, 0, GetGameTime()+5.)
        call SaveTriggerHandle(ExtraHT, 'fjzd', GetHandleId(u2), t)
        call TriggerRegisterTimerEvent(t, 0.1, true)
        call TriggerRegisterDeathEvent(t, u2)
        // call TriggerRegisterUnitEvent(t, u2, EVENT_UNIT_DAMAGED)
        call TriggerAddCondition(t, Condition(function fj_Actions))
        call TriggerRegisterUnitEvent(t, u2, EVENT_UNIT_ISSUED_ORDER)
        call TriggerRegisterUnitEvent(t, u2, EVENT_UNIT_ISSUED_TARGET_ORDER)
        call TriggerRegisterUnitEvent(t, u2, EVENT_UNIT_ISSUED_POINT_ORDER)
    endif
	set t = null
	// set u = null
	// set u2 = null
	// set u = null
	// set u2 = null
	// set u = null
	// set u2 = null
endfunction
function fj_trigger takes nothing returns nothing
	local unit ZX7 = GetTriggerUnit()
	local unit IH7 = GetSpellTargetUnit()
    local integer skill=B287_GetSpellAbilityId()
    if IH7==null then
        set IH7=ZX7
    endif
    if IsUnitEnemy(IH7,GetOwningPlayer(ZX7)) and WQ7(IH7)==false then
        if WF7(IH7) then
            call KR7(ZX7)
call X37(GetOwningPlayer(GetTriggerUnit()),GetObjectName('n0LR'))
            call Japi_ReduceUnitAbilityCoolDown(ZX7,skill,0.)
            set ZX7=null
            set IH7=null
            return
        else
	        // call NHX(ZX7, IH7,'h0GW', "fj_exec", 5000, false, "")
            call fj_exec(ZX7,IH7)
        endif
    endif
	set ZX7 = null
	set IH7 = null
endfunction
function JINGHUA_SLOW_REMOVE takes unit IH7 returns nothing
    call UnitRemoveAbility(IH7,'A4HA')
    call UnitRemoveAbility(IH7,'A4HB')
    call UnitRemoveAbility(IH7,'A4HC')
    call UnitRemoveAbility(IH7,'A4HD')
    call UnitRemoveAbility(IH7,'Bprg')
endfunction
function JINGHUA_SLOW_TRI takes nothing returns boolean
    local trigger t=GetTriggeringTrigger()
    local integer OB7=GetHandleId(t)
    local unit IH7=LoadUnitHandle(ExtraHT, OB7, 0)
    local real n=LoadReal(ExtraHT, OB7, 0)
    local integer i=0
    local boolean b=false
    if ModuloReal(n,10.)==0 then
        set i=R2I(n/10)
        set b=true
    endif
    if n>=40 or GetUnitAbilityLevel(IH7,'A4H9')==0 or GetTriggerEventId()==EVENT_UNIT_DEATH then
        call JINGHUA_SLOW_REMOVE(IH7)
        call UnitRemoveAbility(IH7,'A4H9')
        call RemoveSavedHandle( ExtraHT, 'ssjh', GetHandleId(IH7))
        call FlushChildHashtable(ExtraHT, OB7)
        call OZ7(t)
        set t=null
        set IH7=null
        return false
    endif
    if n==1 or b then
        call JINGHUA_SLOW_REMOVE(IH7)
call XF7(IH7,'A4HA'+i)
    endif
    call SaveReal(ExtraHT, OB7, 0, n+1)
    set t=null
    set IH7=null
    return false
endfunction
function JINGHUA_SLOW takes unit IH7 returns nothing
    local trigger t
    local integer OB7
    if HaveSavedHandle(ExtraHT, 'ssjh', GetHandleId(IH7)) then
	    set t=LoadTriggerHandle(ExtraHT, 'ssjh', GetHandleId(IH7))
		set OB7=GetHandleId(t)
        call SaveReal(ExtraHT, OB7, 0, 2.)
        call JINGHUA_SLOW_REMOVE(IH7)
        call UnitRemoveAbility(IH7,'A4H9')
        call XF7(IH7,'A4H9')
call XF7(IH7,'A4HA')
    else
        set t=CreateTrigger()
        set OB7=GetHandleId(t)
        call SaveUnitHandle(ExtraHT, OB7, 0, IH7)
        call SaveReal(ExtraHT, OB7, 0, 1.)
        call SaveTriggerHandle(ExtraHT, 'ssjh', GetHandleId(IH7), t)
        call TriggerRegisterTimerEvent(t,.1,true)
        call TriggerRegisterUnitEvent(t,IH7,EVENT_UNIT_DEATH)
        call TriggerAddCondition(t,Condition(function JINGHUA_SLOW_TRI))
        call XF7(IH7,'A4H9')
    endif
    set t=null
endfunction
function JINGHUA takes unit ZX7,unit IH7,integer skill returns nothing
    if IsUnitEnemy(IH7,GetOwningPlayer(ZX7))==false then
        call YZ8(IH7)
        call YW8(IH7,0,0)
        call YS7("Abilities\\Spells\\Orc\\Purge\\PurgeBuffTarget.mdl",IH7,"origin",0.6)       
    elseif WF7(IH7) and GetUnitAbilityLevel(IH7,'B014')==0 then
        call KR7(ZX7)
call X37(GetOwningPlayer(GetTriggerUnit()),GetObjectName('n0LR'))
        call Japi_ReduceUnitAbilityCoolDown(ZX7,skill,0.)
	elseif OT7(IH7,"Omnislashing") then
        call KR7(ZX7)
        call Japi_ReduceUnitAbilityCoolDown(ZX7,skill,0.)	
    elseif WQ7(IH7) then
        call PLK(IH7)
    elseif WQ7(IH7)==false then
	    call RemoveUnitGoodBuff(IH7,false)
        call RemoveRYBF(IH7)
        call JINGHUA_SLOW(IH7)
        if skill=='A4DT' then
            // call NHX(ZX7, IH7,'h0GW', "fj_exec", 5000, false, "")
            call fj_exec(ZX7,IH7)
        endif
    endif
endfunction
function JINGHUA_PD takes nothing returns nothing
	local unit ZX7 = GetTriggerUnit()
	local unit IH7 = GetSpellTargetUnit()
    local integer skill=B287_GetSpellAbilityId()
    if IH7==null then
        set IH7=ZX7
    endif
    if UnitAlive(IH7)==false then
        set ZX7=null
        set IH7=null
        return
    endif
    call JINGHUA(ZX7,IH7,skill)
	set ZX7 = null
	set IH7 = null
endfunction
