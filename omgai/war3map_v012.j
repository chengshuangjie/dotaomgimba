endif
//化学狂暴
elseif id=='ANcr' then
if Cw=='N01H' or Cw=='N01T' or Cw=='N01J' then
return true
endif
//变狼
elseif id=='A093' then
if Cw=='E015' then
return true
endif
elseif id=='X093' then
if Cw=='E115' then
return true
endif
elseif id=='X193' then
if Cw=='E116' then
return true
endif
//血肉傀儡
elseif id=='A15J' then
if Cw=='H07I' then
return true
endif
elseif id=='X15J' then
if Cw=='Z07I' then
return true
endif
//TB
elseif id=='A1RI' then    
if Cw=='Eevm' or Cw=='E02V' or Cw=='E02W' or Cw=='E02U' then
return true
endif
//斯文
elseif id=='A1WH' then
if Cw=='H0CQ' then
return true
endif
elseif id=='X1WH' then
if Cw=='Z0CQ' then
return true
endif
//光法
elseif id=='A11T' then
if Cw=='H06X' or Cw=='H06Y' or Cw=='H06W' or Cw=='H0BC' then
return true
endif
//蝙蝠
elseif id=='A19Z' then
if Cw=='O017' then
return true
endif
//冰龙
elseif id=='A2NE' then
if (Cw=='N0MB' or Cw=='N0MC' or Cw=='N0MO' or Cw=='N0MA') then
return true
endif
//夜魔
elseif id=='A03K' then
if Cw=='Udrf' then
return true
endif
//飞机不用改
endif
return false
endfunction

