function Ii takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit IH7=O77(I97,"Target")
local real Ij=ON7(I97,"Speed")
local unit Y27=O77(I97,"Projectile")
