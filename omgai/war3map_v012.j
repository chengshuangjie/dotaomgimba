call SetUnitAbilityLevel(hn,'A0XL',B287_GetUnitAbilityLevel(hn,'A21X'))
endif
endfunction
function SuijiMode_ApplyInvokerInvokeAghState takes unit hn,integer IMF returns nothing
local integer level=0
local real cooldown=0.
local real factor=0.
if SUIJI_MODE==false or hn==null or GetUnitTypeId(hn)==0 or (IMF!='A21Y' and IMF!='A1GU') or SuijiMode_HasAghanimState(hn)==false then
return
endif
set level=SuijiMode_GetPairCastLevel(hn,IMF,'A21Y','A1GU')
if level<1 then
set level=1
elseif level>4 then
set level=4
endif
call SetUnitState(hn,UNIT_STATE_MANA,GetUnitState(hn,UNIT_STATE_MANA)+20.+5.*level)
if level==1 then
set cooldown=16.
elseif level==2 then
set cooldown=8.
elseif level==3 then
set cooldown=4.
else
set cooldown=2.
endif
set factor=ReduceUnitAbilityCoolDownReal(hn)
if factor>0. then
set cooldown=cooldown*factor
endif
call Japi_ReduceUnitAbilityCoolDown(hn,IMF,cooldown)
endfunction
function VAF2 takes nothing returns nothing
local integer VBF=0
local unit hn=GetTriggerUnit()
local integer IMF=B287_GetSpellAbilityId()
local integer T_7=GetHandleId(hn)
local integer VCF=OM7(T_7,"Invoker|Wex")
local integer V3F=OM7(T_7,"Invoker|Quas")
local integer V6F=OM7(T_7,"Invoker|Exort")
local integer U47=OM7(T_7,"Invoker|Current1")
local integer U77=OM7(T_7,"Invoker|Current2")
if GetUnitAbilityLevel(hn,'A4H6')==0 then
    call SetPlayerAbilityAvailable(GetOwningPlayer(hn),OM7(T_7,"Invoker|Current3"),false)
    call SetPlayerAbilityAvailable(GetOwningPlayer(hn),U47,false)
    call SetPlayerAbilityAvailable(GetOwningPlayer(hn),U77,false)
    call XF7(hn,'A4H6')
    call SetPlayerAbilityAvailable(GetOwningPlayer(hn),U47,true)
    call SetPlayerAbilityAvailable(GetOwningPlayer(hn),U77,true)
endif
if VCF==3 and V3F==0 and V6F==0 then
set VBF=1
elseif VCF==2 and V3F==1 and V6F==0 then
set VBF=2
elseif VCF==2 and V3F==0 and V6F==1 then
set VBF=3
elseif VCF==1 and V3F==2 and V6F==0 then
set VBF=4
elseif VCF==1 and V3F==1 and V6F==1 then
set VBF=5
elseif VCF==1 and V3F==0 and V6F==2 then
set VBF=6
elseif VCF==0 and V3F==1 and V6F==2 then
set VBF=7
elseif VCF==0 and V3F==2 and V6F==1 then
set VBF=8
elseif VCF==0 and V3F==0 and V6F==3 then
set VBF=9
elseif VCF==0 and V3F==3 and V6F==0 then
set VBF=$A
endif
if BS[VBF]==U77 then
if SuijiMode_HasAghanimState(hn) and SuijiMode_GetPairCastLevel(hn,IMF,'A21Y','A1GU')==4 then
else
call Japi_ReduceUnitAbilityCoolDown(hn,IMF,0.)
endif
set hn=null
return
endif
if U47!=0 and U77!=0 then
call SetPlayerAbilityAvailable(GetOwningPlayer(hn),U47,false)
call SetPlayerAbilityAvailable(GetOwningPlayer(hn),U77,false)
set U47=U77
set U77=BS[VBF]
call SetPlayerAbilityAvailable(GetOwningPlayer(hn),U47,true)
call SetPlayerAbilityAvailable(GetOwningPlayer(hn),U77,true)
elseif U47==0 and U77!=0 then
call SetPlayerAbilityAvailable(GetOwningPlayer(hn),U77,false)
set U47=U77
set U77=BS[VBF]
call SetPlayerAbilityAvailable(GetOwningPlayer(hn),U47,true)
call SetPlayerAbilityAvailable(GetOwningPlayer(hn),U77,true)
else
set U77=BS[VBF]
call SetPlayerAbilityAvailable(GetOwningPlayer(hn),U77,true)
endif
call NP7(T_7,"Invoker|Current1",U47)
call NP7(T_7,"Invoker|Current2",U77)
call VZF(hn)
set hn=null
endfunction
function VAF takes nothing returns nothing
local integer skill=0
local unit hn=GetTriggerUnit()
local integer IMF=B287_GetSpellAbilityId()
local integer T_7=GetHandleId(hn)
local integer VCF=OM7(T_7,"Invoker|Wex")
local integer V3F=OM7(T_7,"Invoker|Quas")
local integer V6F=OM7(T_7,"Invoker|Exort")
local integer skill3=OM7(T_7,"Invoker|Current3")
local integer skill2=OM7(T_7,"Invoker|Current2")
local integer skill1=OM7(T_7,"Invoker|Current1")
if GetUnitAbilityLevel(hn,'A4H6')==1 then
    call UnitRemoveAbility(hn,'A4H6')
endif
if VCF==3 and V3F==0 and V6F==0 then
set skill=1
elseif VCF==2 and V3F==1 and V6F==0 then
set skill=2
elseif VCF==2 and V3F==0 and V6F==1 then
set skill=3
elseif VCF==1 and V3F==2 and V6F==0 then
set skill=4
elseif VCF==1 and V3F==1 and V6F==1 then
set skill=5
elseif VCF==1 and V3F==0 and V6F==2 then
set skill=6
elseif VCF==0 and V3F==1 and V6F==2 then
set skill=7
elseif VCF==0 and V3F==2 and V6F==1 then
set skill=8
elseif VCF==0 and V3F==0 and V6F==3 then
set skill=9
elseif VCF==0 and V3F==3 and V6F==0 then
set skill=$A
endif
if BS[skill]==skill1 or BS[skill]==skill2 then
if SuijiMode_HasAghanimState(hn) and SuijiMode_GetPairCastLevel(hn,IMF,'A21Y','A1GU')==4 then
else
call Japi_ReduceUnitAbilityCoolDown(hn,IMF,0.)
endif
set hn=null
return
endif
if skill2!=0 and skill1!=0 then
call SetPlayerAbilityAvailable(GetOwningPlayer(hn),skill3,false)
call SetPlayerAbilityAvailable(GetOwningPlayer(hn),skill2,false)
call SetPlayerAbilityAvailable(GetOwningPlayer(hn),skill1,false)
set skill3=skill2
set skill2=skill1
set skill1=BS[skill]
call SetPlayerAbilityAvailable(GetOwningPlayer(hn),skill3,true)
call SetPlayerAbilityAvailable(GetOwningPlayer(hn),skill2,true)
call SetPlayerAbilityAvailable(GetOwningPlayer(hn),skill1,true)
elseif skill3==0 and skill2==0 and skill1!=0 then
call SetPlayerAbilityAvailable(GetOwningPlayer(hn),skill1,false)
set skill2=skill1
set skill1=BS[skill]
call SetPlayerAbilityAvailable(GetOwningPlayer(hn),skill2,true)
call SetPlayerAbilityAvailable(GetOwningPlayer(hn),skill1,true)
else
set skill1=BS[skill]
call SetPlayerAbilityAvailable(GetOwningPlayer(hn),skill1,true)
endif
call NP7(T_7,"Invoker|Current3",skill3)
call NP7(T_7,"Invoker|Current2",skill2)
call NP7(T_7,"Invoker|Current1",skill1)
call VZF(hn)
set hn=null
endfunction
function VLF takes unit WX7,integer V1F,integer V0F,integer V5F returns nothing
local integer V2F //雷
local integer V_F
local integer W4F
local integer W7F //冰
local integer W8F
local integer W9F
local integer WDF //火
local integer WEF
local integer WFF
local integer id=GetUnitTypeId(WX7)
if id=='Z00U' then
call UnitRemoveAbility(WX7,'X0DN')
call UnitRemoveAbility(WX7,'X0DG')
call UnitRemoveAbility(WX7,'X0IX')
call UnitRemoveAbility(WX7,'X0I1')
call UnitRemoveAbility(WX7,'X0I0')
call UnitRemoveAbility(WX7,'X0HZ')
call UnitRemoveAbility(WX7,'X0IC')
call UnitRemoveAbility(WX7,'X0IB')
call UnitRemoveAbility(WX7,'X0ID')
elseif id=='Z10U' then
call UnitRemoveAbility(WX7,'X1DN')
call UnitRemoveAbility(WX7,'X1DG')
call UnitRemoveAbility(WX7,'X1IX')
