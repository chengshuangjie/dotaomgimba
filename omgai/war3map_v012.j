endif
if(not J4)and(MR7(it,ZU[C0]) or MR7(it,ZU[RLL]))then
set J4=UnitUseItem(it,bj_lastCreatedItem)
endif
if(not J4)and(MR7(it,ZU[it_ged]))then
set J4=UnitUseItem(it,bj_lastCreatedItem)
endif
endif
if(not J4)and(h4[O5]!=null or ME7(it))then
if(not J4)and(MZ7(it,ZU[Y0]))then
set J4=UnitUseItem(it,bj_lastCreatedItem)
endif
