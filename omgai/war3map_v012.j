function XX9 takes nothing returns boolean
local unit ZX7=MHDamageEvent_GetSource()
local unit IH7=MHEvent_GetUnit()
local integer id=0
if ZX7==null or IH7==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 then
set ZX7=null
set IH7=null
return false
endif
set id=GetUnitTypeId(ZX7)
if MHEvent_GetId()==EVENT_ID_UNIT_DAMAGE and MHDamageEvent_IsPhysical() and GetUnitAbilityLevel(ZX7,'Broa')>0 then
    call UnitRemoveAbility(ZX7,'A4KU')
    call UnitRemoveAbility(ZX7,'XADL')
    call UnitRemoveAbility(ZX7,'X0DL')
    call UnitRemoveAbility(ZX7,'X1DL')
    call UnitRemoveAbility(ZX7,'X2DL')
    call UnitRemoveAbility(ZX7,'Broa')
    if id=='Ztch' then
        call DestroyEffect(AddSpecialEffectTarget("model\\Hero_EarthShaker_N3S_E_target.mdl",IH7,"chest"))
    elseif id=='Zuch' then
        call DestroyEffect(AddSpecialEffectTarget("model\\Hero_EarthShaker_N7S_E_target.mdl",IH7,"chest"))
    elseif id=='Zvch' then
        call DestroyEffect(AddSpecialEffectTarget("AZModel\\AZ_ESFrost_E1_Caster.mdl",IH7,"chest"))
    endif
endif



set ZX7=null
set IH7=null
return false
endfunction
