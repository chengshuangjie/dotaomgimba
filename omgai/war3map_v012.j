function VisageSummonFamiliars_Register takes unit suijiVisageFamiliarUnit,integer suijiVisageFamiliarLevel returns nothing
local trigger suijiVisageFamiliarTrigger
local integer suijiVisageFamiliarTriggerHandle
if suijiVisageFamiliarUnit==null then
return
endif
set suijiVisageFamiliarTrigger=CreateTrigger()
set suijiVisageFamiliarTriggerHandle=GetHandleId(suijiVisageFamiliarTrigger)
call TriggerRegisterTimerEvent(suijiVisageFamiliarTrigger,1,true)
call TriggerRegisterUnitEvent(suijiVisageFamiliarTrigger,suijiVisageFamiliarUnit,EVENT_UNIT_DEATH)
call TriggerAddCondition(suijiVisageFamiliarTrigger,Condition(function NAE))
call NT7(suijiVisageFamiliarTriggerHandle,"Source",suijiVisageFamiliarUnit)
call NP7(suijiVisageFamiliarTriggerHandle,"Level",suijiVisageFamiliarLevel)
call NP7(GetHandleId(suijiVisageFamiliarUnit),"Level",suijiVisageFamiliarLevel)
call ZCZHYS(suijiVisageFamiliarUnit)
set suijiVisageFamiliarTrigger=null
endfunction
function VisageSummonFamiliars_Prepare takes unit suijiVisageSummonCaster,unit suijiVisageFamiliarUnit,integer suijiVisageFamiliarLevel,integer suijiVisageFamiliarDamage returns nothing
if suijiVisageFamiliarUnit==null then
return
endif
call YLG2(suijiVisageFamiliarUnit,suijiVisageFamiliarDamage)
if Ab[GetPlayerId(GetOwningPlayer(suijiVisageSummonCaster))]then
call SelectUnitAddForPlayer(suijiVisageFamiliarUnit,GetOwningPlayer(suijiVisageSummonCaster))
endif
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\RaiseSkeletonWarrior\\RaiseSkeleton.mdl",suijiVisageFamiliarUnit,"origin"))
call VisageSummonFamiliars_Register(suijiVisageFamiliarUnit,suijiVisageFamiliarLevel)
endfunction
function VisageSummonFamiliars_Create takes unit suijiVisageSummonCaster,boolean suijiVisageSummonClearExisting returns nothing
local group suijiVisageSummonGroup=null
local real suijiVisageSummonX=0.
local real suijiVisageSummonY=0.
local real suijiVisageSummonFacing=0.
local integer suijiVisageSummonLevel=0
local integer suijiVisageSummonDamage=0
local boolean suijiVisageSummonScepter=false
local unit suijiVisageFamiliarOne=null
local unit suijiVisageFamiliarTwo=null
local unit suijiVisageFamiliarThree=null
if suijiVisageSummonCaster==null then
return
endif
if suijiVisageSummonClearExisting then
set suijiVisageSummonGroup=WS7()
call GroupEnumUnitsOfPlayer(suijiVisageSummonGroup,GetOwningPlayer(suijiVisageSummonCaster),Condition(function NBE))
call WR7(suijiVisageSummonGroup)
endif
set suijiVisageSummonX=GetUnitX(suijiVisageSummonCaster)
set suijiVisageSummonY=GetUnitY(suijiVisageSummonCaster)
set suijiVisageSummonFacing=GetUnitFacing(suijiVisageSummonCaster)
set suijiVisageSummonLevel=B287_GetUnitAbilityLevel(suijiVisageSummonCaster,'A1NE')
if suijiVisageSummonLevel==0 then
set suijiVisageSummonLevel=B287_GetUnitAbilityLevel(suijiVisageSummonCaster,'A2IG')
set suijiVisageSummonScepter=true
endif
if suijiVisageSummonLevel<=0 then
set suijiVisageSummonGroup=null
set suijiVisageSummonCaster=null
return
endif
set suijiVisageSummonDamage=R2I((GetUnitState(suijiVisageSummonCaster,UNIT_STATE_ATTACK1_DAMAGE_BASE))*0.3)
if suijiVisageSummonLevel==1 then
set suijiVisageFamiliarOne=CreateUnit(GetOwningPlayer(suijiVisageSummonCaster),'u014',suijiVisageSummonX+75,suijiVisageSummonY+75,suijiVisageSummonFacing)
set suijiVisageFamiliarTwo=CreateUnit(GetOwningPlayer(suijiVisageSummonCaster),'u01D',suijiVisageSummonX-75,suijiVisageSummonY-75,suijiVisageSummonFacing)
elseif suijiVisageSummonLevel==2 then
set suijiVisageFamiliarOne=CreateUnit(GetOwningPlayer(suijiVisageSummonCaster),'u015',suijiVisageSummonX+75,suijiVisageSummonY+75,suijiVisageSummonFacing)
set suijiVisageFamiliarTwo=CreateUnit(GetOwningPlayer(suijiVisageSummonCaster),'u01E',suijiVisageSummonX-75,suijiVisageSummonY-75,suijiVisageSummonFacing)
elseif suijiVisageSummonLevel==3 then
set suijiVisageFamiliarOne=CreateUnit(GetOwningPlayer(suijiVisageSummonCaster),'u016',suijiVisageSummonX+75,suijiVisageSummonY+75,suijiVisageSummonFacing)
set suijiVisageFamiliarTwo=CreateUnit(GetOwningPlayer(suijiVisageSummonCaster),'u01F',suijiVisageSummonX-75,suijiVisageSummonY-75,suijiVisageSummonFacing)
endif
if suijiVisageSummonScepter then
if suijiVisageSummonLevel==1 then
set suijiVisageFamiliarThree=CreateUnit(GetOwningPlayer(suijiVisageSummonCaster),'u01R',suijiVisageSummonX+75,suijiVisageSummonY,suijiVisageSummonFacing)
elseif suijiVisageSummonLevel==2 then
set suijiVisageFamiliarThree=CreateUnit(GetOwningPlayer(suijiVisageSummonCaster),'u01S',suijiVisageSummonX+75,suijiVisageSummonY,suijiVisageSummonFacing)
elseif suijiVisageSummonLevel==3 then
set suijiVisageFamiliarThree=CreateUnit(GetOwningPlayer(suijiVisageSummonCaster),'u01T',suijiVisageSummonX+75,suijiVisageSummonY,suijiVisageSummonFacing)
endif
endif
call VisageSummonFamiliars_Prepare(suijiVisageSummonCaster,suijiVisageFamiliarOne,suijiVisageSummonLevel,suijiVisageSummonDamage)
call VisageSummonFamiliars_Prepare(suijiVisageSummonCaster,suijiVisageFamiliarTwo,suijiVisageSummonLevel,suijiVisageSummonDamage)
call VisageSummonFamiliars_Prepare(suijiVisageSummonCaster,suijiVisageFamiliarThree,suijiVisageSummonLevel,suijiVisageSummonDamage)
set suijiVisageSummonGroup=null
set suijiVisageSummonCaster=null
set suijiVisageFamiliarOne=null
set suijiVisageFamiliarTwo=null
set suijiVisageFamiliarThree=null
endfunction
