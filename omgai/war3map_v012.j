function Fun_FastMode takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
if GetTriggerEvalCount(t)==1 and FastMode>0 then
set killers=150
call VV7(bj_FORCE_ALL_PLAYERS,10,"|cFF00FF00已开启杀戮模式，人头数为：|r|c00FF0000"+I2S(killers)+"|r  (任意一方杀完即可获胜)")
    if FastMode==5 then
        set P94=false
        set PSR=false
        set PDR=false
        set PGR=true
        call VV7(bj_FORCE_ALL_PLAYERS,10.,"|c00FF8000已开启加速模式，工资翻倍，死亡不掉钱，且复活时间随游戏时间增加|r")
    endif
endif
if GetTriggerEvalCount(t)==4 and XM_MODE then
    call VV7(bj_FORCE_ALL_PLAYERS,10.,"|c00FF8000XM模式选择英雄后可以在能量圈抽奖|r")
    call VV7(bj_FORCE_ALL_PLAYERS,10.," ")
endif   
if GetTriggerEvalCount(t)>4 then
    call OZ7(t)
endif
set t=null
endfunction
function Q299 takes nothing returns nothing
local trigger ri=CreateTrigger()
local trigger rI=CreateTrigger()
local trigger rII=CreateTrigger()
local trigger rIII=CreateTrigger()
local trigger nd=CreateTrigger()
local trigger cg=CreateTrigger()
local trigger slmode=CreateTrigger()
local trigger t=CreateTrigger()
call VV7(bj_FORCE_ALL_PLAYERS,15.,"|c00FF8000你可以在15秒内输入以下命令|r")
call VV7(bj_FORCE_ALL_PLAYERS,15.,"|c00FF8000快速复活模式: |r|cFF00FF00-sr|r  |c00FF8000慢速复活模式: |r|cFF00FF00-dr|r  |c00FF8000动态复活模式: |r|cFF00FF00-gr|r")
// call VV7(bj_FORCE_ALL_PLAYERS,15.,"|c00FF8000秒活模式: |r|cFF00FF00-nd|r")
call VV7(bj_FORCE_ALL_PLAYERS,15.,"|c00FF8000杀戮模式: |r|cFF00FF00-sl 人头数|r (某方杀到指定人头数即可获胜)")
call VV7(bj_FORCE_ALL_PLAYERS,15.,"|c00FF8000AI行为增强模式: |r|cFF00FF00-fuck|r(可随时开启关闭) ")
//call VV7(bj_FORCE_ALL_PLAYERS,10.," ")
call VV7(bj_FORCE_ALL_PLAYERS,15.,"|c00d000ffAI增强命令(仅XM模式可用)|r |cFF00FF00-cg X|r (X范围1~1000，每点加成10%经验和5金钱)")
call VV7(bj_FORCE_ALL_PLAYERS,15.,"|c00d000ffAI分路进攻模式(XM模式或AM模式可用)|r |cFF00FF00-FL|r")
// call VV7(bj_FORCE_ALL_PLAYERS,15.,"|cFF00FF00-cg X|r (额外经验和金钱) |cFF00FF00-cge X|r (额外经验) |cFF00FF00-cgg X|r (额外金钱)")
if ISONLINE()==false and IS11==false then
    call DisplayTimedTextToForce(GetPlayersAll(), 20.00, "|c00FF0000注意：单机玩家进行第二局游戏前需要大退魔兽|r")
endif
call TriggerRegisterTimerEvent(t,1.,true)
call TriggerAddAction(t,function Fun_FastMode)
call TriggerRegisterTimerEvent(ri,15.,false)
call TriggerAddAction(ri,function rhh)
call NV7(GetHandleId(ri),"nd",nd)
call NV7(GetHandleId(ri),"sr",rI)
call NV7(GetHandleId(ri),"dr",rII)
call NV7(GetHandleId(ri),"gr",rIII)
call NV7(GetHandleId(ri),"cg",cg)
call NV7(GetHandleId(ri),"slmode",slmode)
call TriggerRegisterPlayerChatEvent(nd,Le,"-nd",true)
call TriggerAddAction(nd,function rFF)
call TriggerRegisterPlayerChatEvent(rI,Le,"-sr",false)
call TriggerAddAction(rI,function rgg)
call TriggerRegisterPlayerChatEvent(rII,Le,"-dr",false)
call TriggerAddAction(rII,function rggg)
call TriggerRegisterPlayerChatEvent(rIII,Le,"-gr",false)
call TriggerAddAction(rIII,function rgggg)
call TriggerRegisterPlayerChatEvent(cg,Le,"-cg",false)
call TriggerAddAction(cg,function Func_cg)
call TriggerRegisterPlayerChatEvent(slmode,Le,"-sl",false)
call TriggerAddAction(slmode,function Func_sl)
set ri=null
set rI=null
set rII=null
set rIII=null
set nd=null
set cg=null
set slmode=null
set t=null
endfunction
