function HXFT2 takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local integer iX=GetTriggerEvalCount(t)
local unit WI7=O77(OB7,"Hero")
local unit p5=O77(OB7,"Source")
local integer id=OM7(OB7,"id")
local real x1=GetUnitX(p5)
local real y1=GetUnitY(p5)
local real x2=ON7(OB7,"Tossx0")
local real y2=ON7(OB7,"Tossy0")
local real RK
local real K_D
local real M4D
local real M7D
local real Il
local real IL
local location l
set RK=J77(x1,y1,x2,y2)
set K_D=KF7(x1,y1,x2,y2)
set M4D=K_D/(41-iX)
set M7D=(iX-20)*(iX-20)
set Il=x1+M4D*Cos(RK*bj_DEGTORAD)
set IL=y1+M4D*Sin(RK*bj_DEGTORAD)
if iX==10 then
call SetUnitTimeScale(WI7,1)
endif
if iX<41 then
if KCD(p5)==false then
call SetUnitFlyHeight(p5,550-M7D,0)
endif
call SetUnitPosition(p5,Il,IL)
else
if KCD(p5)==false then
call SetUnitFlyHeight(p5,GetUnitDefaultFlyHeight(p5),0)
endif
call PauseUnitEx(p5,false)
call SetUnitPathing(p5,true)
call SetUnitPosition(p5,x2,y2)
set l=Location(x2,y2)
call TerrainDeformationRippleBJ(.2,true,l,1.,300.,96.,1,64.)
call RemoveLocation(l)
call DestroyEffect(OG7(OB7,"FX"))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",GetUnitX(p5),GetUnitY(p5)))
call Y67(x2,y2,300)
call K6D(WI7,x2,y2,300,200+GetHeroStr(WI7,true))
call NM7(OB7)
call OZ7(t)
endif
set t=null
set WI7=null
set p5=null
set l=null
return false
endfunction
function HXFT takes nothing returns nothing
local unit WI7=GetTriggerUnit()
local unit p5=VJ4
local location l_source=GetUnitLoc(WI7)
local location l_target=GetSpellTargetLoc()
local location l
local real Angle=AngleBetweenPoints(l_source,l_target)
local real SourcetX=GetLocationX(l_source)
local real SourcetY=GetLocationY(l_source)
local real TargetX=GetLocationX(l_target)
local real TargetY=GetLocationY(l_target)
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local integer id=GetUnitTypeId(WI7)
local real d=800.
if KF7(SourcetX,SourcetY,TargetX,TargetY)>d then
    set TargetX=X17(SourcetX+d*Cos(Angle*bj_DEGTORAD))
    set TargetY=X07(SourcetY+d*Sin(Angle*bj_DEGTORAD))
endif
if IsPointInRegion(IU4,TargetX,TargetY) then
    set l=YV8(TargetX,TargetY)
    set TargetX=GetLocationX(l)
    set TargetY=GetLocationY(l)
    call RemoveLocation(l)
    set l=null
endif
call SetUnitTimeScale(WI7,3)
call SetUnitAnimationByIndex(WI7,7)
call PauseUnitEx(p5,true)
call SetUnitPathing(p5,false)
if KCD(p5)==false then
call XF7(p5,'Amrf')
call UnitRemoveAbility(p5,'Amrf')
endif
call Z57(p5,'A4HH',1,2,'B0K1')
call NT7(OB7,"Hero",WI7)
call NT7(OB7,"Source",p5)
call NU7(OB7,"FX",AddSpecialEffectTarget("Abilities\\Spells\\Human\\FlakCannons\\FlakTarget.mdl",p5,"origin"))
call NQ7(OB7,"Tossx0",TargetX)
call NQ7(OB7,"Tossy0",TargetY)
call NP7(OB7,"id",id)
call TriggerRegisterTimerEvent(t,.02,true)
call TriggerAddCondition(t,Condition(function HXFT2))
call RemoveLocation(l_source)
call RemoveLocation(l_target)
set l_source=null
set l_target=null
set WI7=null
set p5=null
set t=null
endfunction
function HXFT_CONDITION takes nothing returns boolean
return(AV7()and KW7(GetFilterUnit())==false and WF7(GetFilterUnit())==false and IsUnitEnemy(IN4,GetOwningPlayer(GetFilterUnit())) and GetFilterUnit()!=V4 )!=null
endfunction
function HXFT_UNIT takes unit WI7 returns unit
local unit p5=null
local group g=WS7()
set IN4=WI7
call GroupEnumUnitsInRange(g,GetUnitX(WI7),GetUnitY(WI7),275,Condition(function HXFT_CONDITION))
call GroupRemoveUnit(g,WI7)
set p5=M59(g,GetUnitX(WI7),GetUnitY(WI7))
call WR7(g)
set IN4=p5
set p5=null
set g=null
return IN4
endfunction
