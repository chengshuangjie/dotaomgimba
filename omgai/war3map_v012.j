call EnableTrigger(SV4)
if IsPlayerAlly(GetLocalPlayer(),p4) then
if ZCE==T1 then
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,4,Q[GetPlayerId(p4)]+KZ4[GetPlayerId(p4)]+"|r |c00ffff00"+GetObjectName('n0LX')+"|r")
elseif ZCE==B5 then
