function SKTIP_TRI takes nothing returns nothing
	local unit u=GetEnumUnit()
	local integer id=GetUnitTypeId(u)
	local string VH
	local integer skill
	local integer level
	if id=='Z060' and UnitAlive(u) then
		set skill='A4IU'
		set level=GetUnitAbilityLevel(u,skill)
		set VH=MHAbility_GetLevelDefDataStr(skill,level,ABILITY_LEVEL_DEF_DATA_UBERTIP)
		call MHAbility_SetCustomLevelDataStr(u,skill,level,ABILITY_LEVEL_DEF_DATA_UBERTIP,VH+"|n|cff99ccff冷却时间：|r"+R2S(Get_JH_1_CD(u))+" (与攻速相关，不享受冷却缩减)")



		set skill='A4IT'
		set level=GetUnitAbilityLevel(u,skill)
		set VH=MHAbility_GetLevelDefDataStr(skill,level,ABILITY_LEVEL_DEF_DATA_UBERTIP)
		call MHAbility_SetCustomLevelDataStr(u,skill,level,ABILITY_LEVEL_DEF_DATA_UBERTIP,VH+"|n|cff99ccff冷却时间：|r"+R2S(Get_JH_3_CD(u))+" (与敏捷值相关，不享受冷却缩减)")



		set skill='A4IX'
		set level=GetUnitAbilityLevel(u,skill)
		set VH=MHAbility_GetLevelDefDataStr(skill,level,ABILITY_LEVEL_DEF_DATA_UBERTIP)
		call MHAbility_SetCustomLevelDataStr(u,skill,level,ABILITY_LEVEL_DEF_DATA_UBERTIP,VH+"|n|cff99ccff当前范围：|r"+I2S(R2I(Get_JH_4_Range(u)))+"|n|cff99ccff当前眩晕：|r"+R2S(Get_JH_4_Xuanyun(u)))
	endif
	set u=null
endfunction
function SKTIP takes nothing returns boolean
	local group g=WS7()
	call GroupAddGroup(PlayerUnitGroup,g)
	call ForGroup(g,function SKTIP_TRI)
	call WR7(g)
	set g=null
return false
endfunction
