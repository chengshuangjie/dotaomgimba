function Communication__GetItemNameById takes integer itemId returns string
    local string name= GetObjectName(itemId)
    local integer pos= MHString_Find(name , "|n" , 0)
    return MHString_Sub(name , 0 , pos)
endfunction


function Communication__OnPurchasePing takes integer skillButton returns nothing
    local integer id= MHUIData_GetCommandButtonOrderId(skillButton)
    local string itemName=Communication__GetItemNameById(id)
    local string msg= null
    local integer gold=GetPlayerState(GetLocalPlayer(),PLAYER_STATE_RESOURCE_GOLD)
    local integer cost=MHUIData_GetCommandButtonGoldCost(skillButton)
if id>='h099' and id<='h0AZ' then
        if gold >= cost then
            set msg="|cFFFFFF00买活|r > 准备就绪"
        else
            set gold=cost - gold
            set msg="|cFFFFFF00买活|r > 我还需要 |c00FF0000"+I2S(gold)+"|r 黄金"
        endif
    else
        if gold >= cost then
            set msg="我想购买 > |cFFFFFF00$itemName$|r"
        else
            set gold=cost - gold
            set msg="我还需要 |c00FF0000"+I2S(gold)+"|r 黄金购买 > |cFFFFFF00$itemName$|r"
        endif
        set msg=MHString_Replace(msg , "$itemName$" , itemName)
    endif
    if msg != null then
        call s__PlayerChat_SendChatToAlliedPlayers(msg)
    endif
endfunction
function Communication__GetAbiiltyLevelSkip takes integer abilId returns integer
    local integer levelSkip= MHAbility_GetDefDataInt(abilId , ABILITY_DEF_DATA_LEVEL_SKIP)
    if levelSkip <= 0 then
        return 2
    endif
    return levelSkip
endfunction
function Communication__GetAbilityRequireLevel takes integer abilId returns integer
    local integer requireLevel= MHAbility_GetDefDataInt(abilId , ABILITY_DEF_DATA_REQ_LEVEL)
    if requireLevel <= 0 then
        return 1
    endif
    return requireLevel
endfunction
// 计算这个技能要求的的等级 等级要求 + 下一级等级 * 跳级
function Communication__GetAbilityRequireLevelByLevel takes integer abilId,integer abilLevel returns integer
    return ( abilLevel - 1 ) * Communication__GetAbiiltyLevelSkip(abilId) + Communication__GetAbilityRequireLevel(abilId)
endfunction
// ping学习技能
function Communication__OnLearnSkillPing takes unit whichUnit,integer skillButton returns nothing
    local integer abilId= MHUIData_GetCommandButtonOrderId(skillButton)
    local integer abilLevel
    local integer requireLevel
    local integer requireExp
    local string msg= null
    local integer skillPoints
    // 目标是敌人
    if IsUnitEnemy(whichUnit, GetLocalPlayer()) then
        return
    endif
    set abilLevel=GetUnitAbilityLevel(whichUnit, abilId) + 1
    set requireLevel=Communication__GetAbilityRequireLevelByLevel(abilId , abilLevel) - GetHeroLevel(whichUnit)
    // ping自己
    if IsUnitOwnedByPlayer(whichUnit, GetLocalPlayer()) then
        set skillPoints=GetHeroSkillPoints(whichUnit)
        if requireLevel <= 0 and skillPoints > 0 then
            set msg="我准备学习技能 > |cFFFFFF00$abilityName$（Lv $abilityLevel$）|r"
            set msg=MHString_Replace(msg , "$abilityName$" , GetObjectName(abilId))
            set msg=MHString_Replace(msg , "$abilityLevel$" , I2S(abilLevel))
        elseif requireLevel <= 1 then
            set requireExp=MHHero_GetNeededExp(whichUnit , GetHeroLevel(whichUnit))
            set msg="我还需要$requireExp$点经验才能学习 > |cFFFFFF00$abilityName$（Lv $abilityLevel$）|r"
            set msg=MHString_Replace(msg , "$abilityName$" , GetObjectName(abilId))
            set msg=MHString_Replace(msg , "$abilityLevel$" , I2S(abilLevel))
            set msg=MHString_Replace(msg , "$requireExp$" , I2S(requireExp))
        else
            set msg="我还需要升$requireLevel$级才能学习 > |cFFFFFF00$abilityName$（Lv $abilityLevel$）|r"
            set msg=MHString_Replace(msg , "$abilityName$" , GetObjectName(abilId))
            set msg=MHString_Replace(msg , "$abilityLevel$" , I2S(abilLevel))
            set msg=MHString_Replace(msg , "$requireLevel$" , I2S(IMaxBJ(requireLevel, 1)))
        endif
    else
        // ping友军时
        if requireLevel <= 0 and GetHeroSkillPoints(whichUnit) > 0 then
            set msg="$heroName$ > 应该学习 > |cFFFFFF00$abilityName$（Lv $abilityLevel$）|r"
            set msg=MHString_Replace(msg , "$heroName$" , GetObjectName(GetUnitTypeId(whichUnit)))
            
            
            set msg=MHString_Replace(msg , "$abilityName$" , GetObjectName(abilId))
            set msg=MHString_Replace(msg , "$abilityLevel$" , I2S(abilLevel))
        elseif requireLevel <= 1 then
            set requireExp=MHHero_GetNeededExp(whichUnit , GetHeroLevel(whichUnit)) // ?
set msg="$heroName$ > 还需要$requireExp$点经验才能学习 > |cFFFFFF00$abilityName$（Lv $abilityLevel$）|r"
            set msg=MHString_Replace(msg , "$heroName$" , GetObjectName(GetUnitTypeId(whichUnit)))
            
            
            set msg=MHString_Replace(msg , "$abilityName$" , GetObjectName(abilId))
            set msg=MHString_Replace(msg , "$abilityLevel$" , I2S(abilLevel))
            set msg=MHString_Replace(msg , "$requireExp$" , I2S(requireExp))
        else
            set msg="$heroName$ > 还需要升$requireLevel$级才能学习 > |cFFFFFF00$abilityName$（Lv $abilityLevel$）|r"
            set msg=MHString_Replace(msg , "$heroName$" , GetObjectName(GetUnitTypeId(whichUnit)))
            
            
            set msg=MHString_Replace(msg , "$abilityName$" , GetObjectName(abilId))
            set msg=MHString_Replace(msg , "$abilityLevel$" , I2S(abilLevel))
            set msg=MHString_Replace(msg , "$requireLevel$" , I2S(IMaxBJ(requireLevel, 1)))
        endif
    endif
    
    
    if msg != null then
        call s__PlayerChat_SendChatToAlliedPlayers(msg)
    endif
endfunction
    //技能冷却提示
    function Communication__OnAbilitiesPing takes unit whichUnit,integer skillButton returns nothing
        local integer abilId= MHUIData_GetCommandButtonAbility(skillButton)
        local integer abilLevel= GetUnitAbilityLevel(whichUnit, abilId)
        local real cooldownRemaining= MHUIData_GetCommandButtonCooldown(skillButton)
        local integer manaCost= MHUIData_GetCommandButtonManaCost(skillButton)
        local string msg= null
        local string yellow="|cFFFFFF00"
        // ping队友时在前面加上
        if not IsUnitOwnedByPlayer(whichUnit, GetLocalPlayer()) then
            set msg=MHString_Replace("$heroName$ > " , "$heroName$" , GetObjectName(GetUnitTypeId(whichUnit)))
        endif
        if abilId=='A06D' then
            set msg=msg + yellow + "腐肉堆积|r"+" > 永久力量值： " + I2S(LoadInteger(L7,(GetHandleId(whichUnit)),(673)))
        elseif abilId=='A1HR' then
            set msg=msg + yellow + "能量转移|r"+" > 永久敏捷值： " + I2S(XYMJ[GetPlayerId(GetOwningPlayer(whichUnit))])
        elseif cooldownRemaining > 0. then
            // 冷却中
            if MHAbility_GetDefDataInt(abilId , ABILITY_DEF_DATA_MAX_LEVEL) > 1 and abilId!='A20U' then
                set msg=msg + yellow+ "$abilityName$（Lv $abilityLevel$） |r> 还剩 |c00FF0000$cooldown$|r 秒"
            else
                set msg=msg + yellow+ "$abilityName$ |r> 还剩 |c00FF0000$cooldown$|r 秒"
            endif
            set msg=MHString_Replace(msg , "$abilityName$" , MHAbility_GetDefDataStr(abilId , ABILITY_DEF_DATA_NAME))
            set msg=MHString_Replace(msg , "$abilityLevel$" , I2S(abilLevel))
            set msg=MHString_Replace(msg , "$cooldown$" , I2S(R2I(cooldownRemaining + 1.)))
        elseif manaCost > GetUnitState(whichUnit, UNIT_STATE_MANA) then
            // 魔法不足
            if MHAbility_GetDefDataInt(abilId , ABILITY_DEF_DATA_MAX_LEVEL) > 1 then
                set msg=msg + yellow + "$abilityName$（Lv $abilityLevel$） |r> 还差 |c00FF0000$manaCost$|r 点魔法"
            else
                set msg=msg + yellow + "$abilityName$ |r> 还差 |c00FF0000$manaCost$|r 点魔法"
            endif
            set msg=MHString_Replace(msg , "$abilityName$" , MHAbility_GetDefDataStr(abilId , ABILITY_DEF_DATA_NAME))
            set msg=MHString_Replace(msg , "$abilityLevel$" , I2S(abilLevel))
            set msg=MHString_Replace(msg , "$manaCost$" , I2S(R2I(manaCost * 1. - GetUnitState(whichUnit, UNIT_STATE_MANA))))
        elseif MRPH(whichUnit) then
            // 被禁用
            if MHAbility_GetDefDataInt(abilId , ABILITY_DEF_DATA_MAX_LEVEL) > 1 then
                set msg=msg + yellow+ "$abilityName$（Lv $abilityLevel$） |r> |c00FF0000已被禁用|r"
            else
                set msg=msg + yellow+ "$abilityName$ |r> |c00FF0000已被禁用|r"
            endif
            set msg=MHString_Replace(msg , "$abilityName$" , MHAbility_GetDefDataStr(abilId , ABILITY_DEF_DATA_NAME))
            set msg=MHString_Replace(msg , "$abilityLevel$" , I2S(abilLevel))
        elseif UC7(whichUnit) then
            // 被沉默
            if MHAbility_GetDefDataInt(abilId , ABILITY_DEF_DATA_MAX_LEVEL) > 1 then
                set msg=msg + yellow+ "$abilityName$（Lv $abilityLevel$） |r> |c00FF0000已被沉默|r"
            else
                set msg=msg + yellow+ "$abilityName$ |r> |c00FF0000已被沉默|r"
            endif
            set msg=MHString_Replace(msg , "$abilityName$" , MHAbility_GetDefDataStr(abilId , ABILITY_DEF_DATA_NAME))
            set msg=MHString_Replace(msg , "$abilityLevel$" , I2S(abilLevel))
        else
            // 准备就绪
            if MHAbility_GetDefDataInt(abilId , ABILITY_DEF_DATA_MAX_LEVEL) > 1 then
                set msg=msg + yellow + "$abilityName$（Lv $abilityLevel$） |r> 准备就绪"
            else
                set msg=msg + yellow + "$abilityName$ |r> 准备就绪"
            endif
            set msg=MHString_Replace(msg , "$abilityName$" , MHAbility_GetDefDataStr(abilId , ABILITY_DEF_DATA_NAME))
            set msg=MHString_Replace(msg , "$abilityLevel$" , I2S(abilLevel))
        endif
        if msg != null then
            call s__PlayerChat_SendChatToAlliedPlayers(msg)
        endif
    endfunction
function onClickSkillCommandButton takes integer skillButton returns nothing
    local unit u= MHPlayer_GetSelectUnit()
    local integer abilId
    local integer orderId
    if u == null then
        return
    endif
    set abilId=MHUIData_GetCommandButtonAbility(skillButton)
    set orderId=MHUIData_GetCommandButtonOrderId(skillButton)
    if abilId==0 or abilId=='A4DV' or orderId==852000 then
        set u=null
        return
    endif
    if abilId == 'Asud' or abilId == 'Asel' then //购买单位
        call Communication__OnPurchasePing(skillButton)
    elseif abilId == 'AHer' then  //学习技能
        call Communication__OnLearnSkillPing(u , skillButton)
    else
        call Communication__OnAbilitiesPing(u , skillButton) //技能冷却提示
    endif
    set u=null
endfunction
function OnClickSkillButton takes nothing returns boolean
    local integer skillButton
    if MHMsg_IsKeyDown(OSKEY_ALT) and MHEvent_GetKey() == MEMHACK_VK_LBUTTON then
        set skillButton=MHEvent_GetFrame()
        call onClickSkillCommandButton(skillButton)
        call MHEvent_SetKey(- 1)
    endif
    return false
endfunction
function GetItemButtonIndex takes integer itemButton returns integer
    local integer i= 1
    loop
        exitwhen i > 6
        if itemButton == ItemBarButton[i] then
            return i
        endif
        set i=i + 1
    endloop
    return 0
endfunction
function OnClickItemButton takes nothing returns boolean
    local integer itemButton
    local integer itemSlot
    if MHMsg_IsKeyDown(OSKEY_ALT) and MHEvent_GetKey() == MEMHACK_VK_LBUTTON then
        set itemButton=MHEvent_GetFrame()
        set itemSlot=GetItemButtonIndex(itemButton)
        if itemSlot>0 then
            call onClickItemCommandButton(GetPlayerId(GetLocalPlayer()),itemSlot - 1)
        endif
        call MHEvent_SetKey(- 1)
    endif
    return false
endfunction
function ClickMouseButton takes nothing returns boolean
    if MHEvent_GetKey() == MEMHACK_VK_RBUTTON and OT7(MHPlayer_GetSelectUnit(),"DISRB") then
        if not DzIsKeyDown(16) then
            call ClearTextMessages()
            call MHUI_PlayErrorSound()
            call DisplayTimedTextToPlayer(GetLocalPlayer(),.5,-1.,2., "|cffffcc00传送只能用停止(S)键打断|r")
            call MHEvent_SetKey(-1)
        endif
    endif
    return false
endfunction
