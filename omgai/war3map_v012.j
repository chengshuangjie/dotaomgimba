//图标变亮
function ShowDogSkill takes unit u returns nothing
local player p= GetOwningPlayer(u)
	call KillUnit(LoadUnitHandle(TABLE_HY, GetHandleId(p), 'brek'))
	call SaveUnitHandle(TABLE_HY, GetHandleId(p), 'brek', CreateUnit(p, 'e060', 0, 0, 0))
	call ShowUnit(LoadUnitHandle(TABLE_HY, GetHandleId(p), 'brek'), false)
	call PauseUnit(LoadUnitHandle(TABLE_HY, GetHandleId(p), 'brek'), true)
set p=null
endfunction
//图标变暗
function HideDogSkill takes unit u returns nothing
local player p= GetOwningPlayer(u)
	call KillUnit(LoadUnitHandle(TABLE_HY, GetHandleId(p), 'brek'))
set p=null
endfunction
function B4R takes unit u returns real
local real d=DGH_BUFF(u)
local real i=.0
local integer id=GetUnitTypeId(u)
local integer suijiBattleTranceHandle=GetHandleId(u)
    if GetUnitAbilityLevel(u,'B00B')>0 and (id=='N016' or id=='N017' or id=='N200' or id=='N201' or id=='N02B' or B287_GetUnitAbilityLevel(u,'A1EJ')>0) then
        if LoadBoolean(L7,suijiBattleTranceHandle,StringHash("SuijiHasScepter")) or (MV7(u,ZU[ANEW31])!=null) or CHIA[GetPlayerId(GetOwningPlayer(u))]==1 or GetUnitAbilityLevel(u,'A330')>0 then
            set i=.3                            //神杖战斗专注
        endif
    endif
    if GetUnitAbilityLevel(u,'A4CU')>0 then	//如意棒法
        set i = i + (.2+.1*GetUnitAbilityLevel(u,'A4CQ'))
    endif
    if GetUnitAbilityLevel(u,'A0WW')>0 then	//极度饥渴
        set i = i + .6
    elseif GetUnitAbilityLevel(u,'A0WV')>0 then
        set i = i + .8
    elseif GetUnitAbilityLevel(u,'A0WX')>0 then
        set i = i + 1.0
    endif



	if GetUnitAbilityLevel(u,'A1CN')== 1 then	//撒旦主动
		set i=i+2.
    elseif GetUnitAbilityLevel(u,'A04T')== 1 then	//撒旦被动
		set i=i+.3
	elseif GetUnitAbilityLevel(u,'A0II')== 1 then	//疯脸和大疯脸
		set i=i+.2
	elseif GetUnitAbilityLevel(u,'A09P')== 1 then	//死亡面具和支配头盔
		set i=i+.15
    endif
	return i*d
endfunction
function B4R_XXGH takes unit u returns real
local real d=DGH_BUFF(u)
local integer level
local real i=.0
		if GetUnitAbilityLevel(u,'BVA4')>0 then
			set level = GetUnitAbilityLevel(u,'BVA4')* 4
			set i = .1 + .05 * level
		elseif GetUnitAbilityLevel(u,'BVA3')>0 then
			set level = GetUnitAbilityLevel(u,'BVA3')* 3
			set i = .1 + .05 * level
		elseif GetUnitAbilityLevel(u,'BVA2')>0 then
			set level = GetUnitAbilityLevel(u,'BVA2')* 2
			set i = .1 + .05 * level
		elseif GetUnitAbilityLevel(u,'BVA1')>0 then
			set level = GetUnitAbilityLevel(u,'BVA1')
			set i = .1 + .05 * level
		endif
		if GetUnitAbilityLevel(u,'B3B5')>0 then //祭品
			set i = i + .15
		endif
		return i*d
endfunction

//设置单位射程
function QTUWW takes unit u, boolean WEWQQ returns nothing
	local real r = GetUnitState(u, UNIT_STATE_ATTACK1_RANGE) 
	if not IsUnitType(u, UNIT_TYPE_MELEE_ATTACKER) then
		if WEWQQ then
			if r < 90000 then
				call Unit_Setrange(u, r + 90000)
			endif
		else
			if r > 90000 then
				call Unit_Setrange(u, r -90000)
			endif
		endif
	endif
endfunction

//攻击目标和被攻击目标判断
function UYYEQ1 takes unit src, unit dst returns nothing
	local integer h = GetHandleId(src)
	if LoadReal(TABLE_HY, h,'A3UC')< GetGameTime() or LoadReal(TABLE_HY, h,'A3UC')== 0 then
		call QTUWW(src, false)
		call RemoveSavedReal(TABLE_HY, h,'A3UC')
		call RemoveSavedInteger(TABLE_HY, h,'A3UC')
		call UnitRemoveAbility(src,'A3UC')
		call UnitRemoveAbility(src,'B0KU')
	else
		if GetUnitAbilityLevel(src,'A3UC')> 0 and dst != LoadUnitHandle(TABLE_HY, h,'A3UC') then
			call UnitRemoveAbility(src,'A3UC')
			call UnitRemoveAbility(src,'B0KU')
			call QTUWW(src, false)
		elseif LoadInteger(TABLE_HY, h,'A3UC')> 0 and dst == LoadUnitHandle(TABLE_HY, h,'A3UC') then
			call UnitAddAbility(src,'A3UC')
			call QTUWW(src, true)
		endif
	endif
endfunction

//注册大推推攻击事件
function UYYEQ takes nothing returns nothing
	call UYYEQ1(WXX, YXX)
endfunction
function QTUYW takes nothing returns nothing
	local integer h = GetHandleId(GetExpiredTimer())
	call UYYEQ1(LoadUnitHandle(TABLE_HY, h, 0), null)
	call FlushChildHashtable(TABLE_HY, GetHandleId(GetExpiredTimer()))
	call DestroyTimer(GetExpiredTimer())
endfunction
function QTUUW takes nothing returns nothing
	local integer h = TimerStartSingle(0, function QTUYW)
	call SaveUnitHandle(TABLE_HY, h, 0, WXX)
endfunction
//大推推攻击次数
function UYYRQ takes nothing returns nothing
	local integer h = GetHandleId(WXX)
	local integer i = LoadInteger(TABLE_HY, h,'A3UC')
	if i > 0 and YXX == LoadUnitHandle(TABLE_HY, h,'A3UC') then
		if i == 1 then
			call RemoveSavedInteger(TABLE_HY, h,'A3UC')
			call RemoveSavedReal(TABLE_HY, h,'A3UC')
			call QTUUW()
		else
			call SaveInteger(TABLE_HY, h,'A3UC', i -1)
		endif
	endif
endfunction
//吹风加鞋子移速
function U3V takes unit u returns integer
	local integer level = GetUnitAbilityLevel(u,'A4LA')
	local integer U5V=0
	if level > 0 then
		if level == 1 then
			set U5V = 30
		elseif level == 2 then
			set U5V = 80
		elseif level == 3 then
			set U5V = 105
		elseif level == 4 then
			set U5V = 120
        endif
	return U5V
	endif


	if GetUnitAbilityLevel(u,'A00D')> 0 then     //小大飞鞋
		return 90 
	elseif GetUnitAbilityLevel(u,'A2HR')> 0 then  //静谧之鞋 +75
		return 75
	elseif GetUnitAbilityLevel(u,'A1VR')> 0 then  //秘法 +50
		return 50
	elseif GetUnitAbilityLevel(u,'A05U')> 0 or GetUnitAbilityLevel(u,'A12V')> 0 then //A05U假腿，+50 ， A12V相位，+50
		return 50
	elseif GetUnitAbilityLevel(u,'AIms')> 0 or GetUnitAbilityLevel(u,'A2I9')> 0 then  //速度之靴 +50 静谧之鞋（破损）+50
		return 50
	endif
	return 0
endfunction
//移动速度查询返回值
function U6V takes unit u returns real
	if LoadReal(TABLE_K, GetHandleId(u), 99)> 0 then
		return LoadReal(TABLE_K, GetHandleId(u), 99)+ GetUnitMoveSpeed(u)
	endif
	return GetUnitMoveSpeed(u)
endfunction
//相位移动
function SetUnitPhaseMove takes unit whichUnit, boolean open returns nothing
    //穿越地形时则返回
    if LoadBoolean(UnitDataHashTable, GetHandleId(whichUnit), UNIT_PATHING) then
        return
    endif
	if open then
		if not IsUnitType(whichUnit, UNIT_TYPE_FLYING) then
			call EXSetUnitMoveType(whichUnit, MOVE_TYPE_WINDWALK )
			call EXSetUnitCollisionType(true, whichUnit, COLLISION_TYPE_UNIT)
		endif
		// 没相位buff和大鱼冲刺和迅疾闪光和暗影之境和蝴蝶振翅再移除
	elseif GetUnitAbilityLevel( whichUnit, 'B09Y' ) == 0 and not HaveSavedHandle(TABLE_HY, GetHandleId(whichUnit),'A05C') and not HaveSavedHandle(TABLE_HY, GetHandleId(whichUnit),'A4HS') and not HaveSavedHandle(TABLE_HY, GetHandleId(whichUnit),'A4IE') and LoadInteger(L7,GetHandleId(whichUnit),'BFLY')<=0 and LoadInteger(L7,GetHandleId(whichUnit),'B0KV')<=0 then
		if not IsUnitType(whichUnit, UNIT_TYPE_FLYING) then
			call EXSetUnitMoveType(whichUnit, MOVE_TYPE_FOOT )
			call EXSetUnitCollisionType(false, whichUnit, COLLISION_TYPE_UNIT)
			// 重新设置位置 防止模型消失
			call SetUnitX( whichUnit, GetUnitX(whichUnit) )
			call SetUnitY( whichUnit, GetUnitY(whichUnit) )
		endif
	endif
endfunction
