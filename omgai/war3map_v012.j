function SuijiTest_RawCode takes string raw returns integer
local integer a=0
local integer b=0
local integer c=0
local integer d=0
if StringLength(raw)!=4 then
return 0
endif
set a=SuijiTest_RawChar(SubString(raw,0,1))
set b=SuijiTest_RawChar(SubString(raw,1,2))
set c=SuijiTest_RawChar(SubString(raw,2,3))
set d=SuijiTest_RawChar(SubString(raw,3,4))
if a==0 or b==0 or c==0 or d==0 then
return 0
endif
return a*16777216+b*65536+c*256+d
endfunction
function SuijiTest_Command takes nothing returns nothing
local player host=GetTriggerPlayer()
local player target=null
local string text=GetEventPlayerChatString()
local string heroText=""
local string smallText=""
local string ultText=""
local integer floor=0
local integer hero=0
local integer small=0
local integer ult=0
local integer pid=0
if Test_NoOtherHumanPlayer(host)==false then
call DisplayTimedTextToPlayer(host,0,0,8.,"|cFFFFCC00有其他真人玩家时不能使用 -omgtest|r")
set host=null
return
endif
if GetPlayerController(host)!=MAP_CONTROL_USER then
call DisplayTimedTextToPlayer(host,0,0,8.,"|cFFFFCC00只有玩家可以使用 OMG 测试指令|r")
set host=null
return
endif
if SUIJI_MODE==false then
call DisplayTimedTextToPlayer(host,0,0,8.,"|cFFFFCC00请先进入 OMG 模式后再使用测试指令|r")
set host=null
return
endif
set floor=S2I(SuijiTest_CommandWord(text,2))
set heroText=SuijiTest_CommandWord(text,3)
set smallText=SuijiTest_CommandWord(text,4)
set ultText=SuijiTest_CommandWord(text,5)
if floor<1 or floor>10 or StringLength(heroText)!=4 or StringLength(smallText)!=4 or StringLength(ultText)!=4 then
call DisplayTimedTextToPlayer(host,0,0,12.,"|cFFFFCC00用法：-omgtest 楼层 英雄ID 小技能ID 大招ID，例如 -omgtest 6 Nfir A0EY A29J|r")
set host=null
return
endif
set target=K27(floor)
if target==null or (target!=host and GetPlayerController(target)!=MAP_CONTROL_COMPUTER) then
call DisplayTimedTextToPlayer(host,0,0,8.,"|cFFFFCC00目标楼层必须是自己所在楼层或电脑玩家|r")
set host=null
set target=null
return
endif
set hero=SuijiTest_RawCode(heroText)
set small=SuijiTest_RawCode(smallText)
set ult=SuijiTest_RawCode(ultText)
if SuijiTest_FindHeroIndex(hero)==0 or SuijiTest_IsSmallPoolSkill(small)==false or SuijiTest_IsUltPoolSkill(ult)==false or small==ult then
call DisplayTimedTextToPlayer(host,0,0,12.,"|cFFFFCC00技能槽位不匹配：第一个必须是随机小技能，第二个必须是随机大招。请用网页生成命令。|r")
set host=null
set target=null
return
endif
set pid=GetPlayerId(target)
call SaveInteger(L7,StringHash("SuijiTestPresetHero"),pid,hero)
call SaveInteger(L7,StringHash("SuijiTestPresetSmall"),pid,small)
call SaveInteger(L7,StringHash("SuijiTestPresetUlt"),pid,ult)
call SavePlayerHandle(L7,StringHash("SuijiTestPresetController"),pid,host)
if SuijiTest_ReplaceAIHero(target) then
call DisplayTimedTextToPlayer(host,0,0,10.,"|cFF00FF00OMG测试：已创建第 "+I2S(floor)+" 楼 AI，立即给予英雄 "+heroText+"、小技能 "+smallText+"、大招 "+ultText+"。|r")
else
call DisplayTimedTextToPlayer(host,0,0,10.,"|cFFFFCC00OMG测试：目标 AI 创建失败，请在选人阶段后重试。|r")
endif
set host=null
set target=null
set text=""
set heroText=""
set smallText=""
set ultText=""
endfunction
function SuijiTest_CommandInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
exitwhen i>=12
call TriggerRegisterPlayerChatEvent(t,Player(i),"-omgtest",false)
set i=i+1
endloop
call TriggerAddAction(t,function SuijiTest_Command)
set t=null
endfunction
function SuijiTest_StartRandomUnspecifiedAI takes nothing returns nothing
local integer floor=1
local player allyAI=null
local player enemyAI=null
loop
exitwhen floor>5
set allyAI=Z7[floor]
if allyAI!=null and GetPlayerController(allyAI)==MAP_CONTROL_COMPUTER and M7[GetPlayerId(allyAI)]==null then
call XZE(GetPlayerId(allyAI),0)
endif
set enemyAI=A7[floor]
if enemyAI!=null and GetPlayerController(enemyAI)==MAP_CONTROL_COMPUTER and M7[GetPlayerId(enemyAI)]==null then
call XZE(GetPlayerId(enemyAI),0)
endif
set floor=floor+1
endloop
set allyAI=null
set enemyAI=null
endfunction
function SuijiTest_CloseOriginalHeroSelection takes nothing returns nothing
if HK!=null then
call DisableTrigger(HK)
endif
if QA4!=null then
call DisableTrigger(QA4)
endif
if QV4!=null then
call SetUnitOwner(h4[512+GetPlayerId(QT4)],QT4,false)
call SetUnitOwner(h4[512+GetPlayerId(QV4)],QV4,false)
call RemoveUnit(nc)
call RemoveUnit(Vc)
set nc=null
set Vc=null
set QV4=null
endif
if QW4!=null then
call SetUnitOwner(h4[512+GetPlayerId(QU4)],QU4,false)
call SetUnitOwner(h4[512+GetPlayerId(QW4)],QW4,false)
call RemoveUnit(nc)
call RemoveUnit(Vc)
set nc=null
set Vc=null
set QW4=null
endif
endfunction
function SuijiTest_StartCommand takes nothing returns nothing
local player p=GetTriggerPlayer()
if GetPlayerController(p)!=MAP_CONTROL_USER then
set p=null
return
endif
if SUIJI_MODE==false then
call DisplayTimedTextToPlayer(p,0,0,8.,"|cFFFFCC00请先进入 OMG 模式后再使用 -start|r")
set p=null
return
endif
if Bz>=QD4 then
call DisplayTimedTextToPlayer(p,0,0,8.,"|cFFFFCC00游戏已经开始，-start 只能在出兵前使用。|r")
set p=null
return
endif
if PE4==false then
call OM9()
endif
call SuijiTest_CloseOriginalHeroSelection()
call SuijiTest_StartRandomUnspecifiedAI()
set QD4=R2I(Bz)+30
if Q84==null then
call H79()
endif
call PauseTimer(Q84)
call TimerStart(Q84,30.,false,null)
call YP8(0,30,true)
call VV7(bj_FORCE_ALL_PLAYERS,8.,"|cFF00FF00测试快速开局：已启用 OM 中路模式，30 秒后出兵。|r")
set p=null
endfunction
function SuijiTest_StartCommandInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
exitwhen i>=12
call TriggerRegisterPlayerChatEvent(t,Player(i),"-start",true)
set i=i+1
endloop
call TriggerAddAction(t,function SuijiTest_StartCommand)
set t=null
endfunction
function SuijiMode_StopStoredA0RADrain takes unit suijiDrainStopCaster returns nothing
local trigger suijiDrainStopTrigger=null
local integer suijiDrainStopCasterHandle=0
local integer suijiDrainStopTriggerHandle=0
if suijiDrainStopCaster==null then
return
endif
set suijiDrainStopCasterHandle=GetHandleId(suijiDrainStopCaster)
set suijiDrainStopTrigger=LoadTriggerHandle(L7,suijiDrainStopCasterHandle,StringHash("SuijiDrainA0RATrigger"))
if suijiDrainStopTrigger!=null then
set suijiDrainStopTriggerHandle=GetHandleId(suijiDrainStopTrigger)
call SaveBoolean(L7,suijiDrainStopTriggerHandle,StringHash("SuijiDrainA0RAStop"),true)
call TriggerEvaluate(suijiDrainStopTrigger)
call RemoveSavedHandle(L7,suijiDrainStopCasterHandle,StringHash("SuijiDrainA0RATrigger"))
endif
set suijiDrainStopTrigger=null
endfunction
function SuijiMode_ChannelEndCleanup takes nothing returns boolean
local unit suijiDrainEndCaster=GetTriggerUnit()
local integer suijiDrainEndCasterHandle=0
local integer suijiDrainEndSkill=0
local integer suijiDrainEndIssuedOrder=0
if SUIJI_MODE==false or suijiDrainEndCaster==null then
set suijiDrainEndCaster=null
return false
endif
set suijiDrainEndCasterHandle=GetHandleId(suijiDrainEndCaster)
if OO7(suijiDrainEndCasterHandle,"SuijiDone")==false then
set suijiDrainEndCaster=null
return false
endif
if GetTriggerEventId()==EVENT_PLAYER_UNIT_DEATH then
call SuijiMode_StopStoredA0RADrain(suijiDrainEndCaster)
set suijiDrainEndCaster=null
return false
endif
if GetTriggerEventId()==EVENT_PLAYER_UNIT_ISSUED_ORDER or GetTriggerEventId()==EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER or GetTriggerEventId()==EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER then
set suijiDrainEndIssuedOrder=GetIssuedOrderId()
if LoadTriggerHandle(L7,suijiDrainEndCasterHandle,StringHash("SuijiDrainA0RATrigger"))!=null and SuijiAI_IsBusyChannelingOrder(suijiDrainEndIssuedOrder)==false then
call SuijiMode_StopStoredA0RADrain(suijiDrainEndCaster)
call SuijiAI_RestoreVisibleSkills(suijiDrainEndCaster)
call SuijiMode_UpdateLevels(suijiDrainEndCaster)
endif
set suijiDrainEndCaster=null
return false
endif
set suijiDrainEndSkill=B287_GetSpellAbilityId()
if SuijiMode_IsChannelOrDrainSkill(suijiDrainEndSkill) then
if suijiDrainEndSkill=='A0RA' then
call SuijiMode_StopStoredA0RADrain(suijiDrainEndCaster)
endif
call SuijiAI_RestoreVisibleSkills(suijiDrainEndCaster)
call SuijiMode_UpdateLevels(suijiDrainEndCaster)
if GetPlayerController(GetOwningPlayer(suijiDrainEndCaster))==MAP_CONTROL_COMPUTER then
if suijiDrainEndSkill==OM7(suijiDrainEndCasterHandle,"SuijiSmallSkill") then
call SuijiAI_SetSoftCooldown(suijiDrainEndCaster,"SuijiSmall",suijiDrainEndSkill,3.)
elseif suijiDrainEndSkill==OM7(suijiDrainEndCasterHandle,"SuijiUltSkill") then
call SuijiAI_SetSoftCooldown(suijiDrainEndCaster,"SuijiUlt",suijiDrainEndSkill,6.)
endif
endif
endif
set suijiDrainEndCaster=null
return false
endfunction
