function IKE takes nothing returns nothing
local unit WI7=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local real t5=X17(GetUnitX(WI7))
local real w5=X07(GetUnitY(WI7))
local unit BU7
local timer t=CreateTimer()
local integer OB7=GetHandleId(t)
local group T69=WS7()
local location IME
local real l4
local real Y5
local real Z5
local integer id=GetUnitTypeId(WI7)
local integer skillmj
if id=='Z01B' then
set skillmj='h103'
elseif id=='Z11B' then
set skillmj='h203'
elseif id=='Z21B' then
set skillmj='h303'
elseif id=='Z31B' then
set skillmj='h403'
else
set skillmj='h003'
endif
set BU7=CreateUnit(GetOwningPlayer(WI7),skillmj,t5,w5,0)
call SetUnitPathing(BU7,false)
call NB7(OB7,"AlreadyDamaged",T69)
call NT7(OB7,"Hero",WI7)
call NT7(OB7,"Projectile",BU7)
if m5!=null then
call NP7(OB7,"TargetIndex",TS7(m5))
call TimerStart(t,.035,true,function IFE)
else
set IME=GetSpellTargetLoc()
set Y5=GetLocationX(IME)
set Z5=GetLocationY(IME)
set l4=Atan2(Z5-w5,Y5-t5)
call SetUnitFacing(BU7,l4*bj_RADTODEG)
set Y5=X17(t5+$834*Cos(l4))
set Z5=X07(w5+$834*Sin(l4))
call NQ7(OB7,"TargetX",(Y5)*1.)
call NQ7(OB7,"TargetY",(Z5)*1.)
call NQ7(OB7,"Angle",l4*1.)
call TimerStart(t,.035,true,function IGE)
endif
set t=CreateTimer()
set OB7=GetHandleId(t)
call SetUnitPathingEx(WI7,false)
call NT7(OB7,"Hero",WI7)
call TimerStart(t,.2,true,function IIE)
set WI7=null
set m5=null
set BU7=null
set t=null
set T69=null
call RemoveLocation(IME)
set IME=null
endfunction
function IJE takes nothing returns boolean
if B287_GetSpellAbilityId()=='A0HW' then
    call IKE()
endif
return false 
endfunction
function JN8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function IJE))
call CreateSound("Sounds\\Spectral Dagger.mp3",false,false,false,$A,$A,"DefaultEAXON")
call X_7('A0I2')
call X_7('A0HY')
set t=null
endfunction
function HUANGWU_PD takes nothing returns boolean
return IsUnitAlly(GetFilterUnit(),GetOwningPlayer(IN4)) and GetUnitAbilityLevel(GetFilterUnit(),'A04R')==0 and UnitAlive(GetFilterUnit()) and IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==false
endfunction
function HUANGWU_TRI takes unit ZX7,unit IH7,integer level,string skilltx returns nothing
if OT7(ZX7,"Desolate")==false then
	call B67(ZX7,IH7,21,20*level)
	call DestroyEffect(AddSpecialEffectTarget(skilltx,IH7,"overhead"))
	if GetUnitAbilityLevel(ZX7,'A2VW')>0 then
		call O37(ZX7,"Desolate",.225)
	else
		call O37(ZX7,"Desolate",.3)
	endif
endif
endfunction
function HUANGWU2 takes unit ZX7,unit IH7 returns nothing
local group g
local boolexpr spectreDesolateAllyFilter=null
local integer level=B287_GetUnitAbilityLevel(ZX7,'A0FX')
local integer id=GetUnitTypeId(ZX7)
local string skilltx
if id=='Z01B' then
set skilltx="model\\Hero_Spectre_N7S_L_Target.mdl"
elseif id=='Z11B' then
set skilltx="model\\Hero_Spectre_N6S_L_Target.mdl"
elseif id=='Z21B' then
set skilltx="model\\Hero_Spectre_N4S_L_Target.mdl"
elseif id=='Z31B' then
set skilltx="model\\Hero_Spectre_N3S_L_Target.mdl"
else
set skilltx="Abilities\\Spells\\Undead\\DeathandDecay\\DeathandDecayTarget.mdl"
endif
if SuijiMode_HasAghanimState(ZX7) then
	call HUANGWU_TRI(ZX7,IH7,level,skilltx)
else
	set g=WS7()
	set IN4=IH7
	set spectreDesolateAllyFilter=Condition(function HUANGWU_PD)
	call GroupEnumUnitsInRange(g,GetUnitX(IH7),GetUnitY(IH7),300,spectreDesolateAllyFilter)
	call DestroyBoolExpr(spectreDesolateAllyFilter)
	call GroupRemoveUnit(g,IH7)
	if FirstOfGroup(g)==null then
		call HUANGWU_TRI(ZX7,IH7,level,skilltx)
	endif
	call WR7(g)
endif
set g=null
set spectreDesolateAllyFilter=null
endfunction
function HUANGWU takes nothing returns nothing
	if ISPH(WXX)==false and B287_GetUnitAbilityLevel(WXX,'A0FX')>0 and IsUnitEnemy(YXX,GetOwningPlayer(WXX)) and IsUnitType(YXX, UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(YXX,'A04R')==0 and GetUnitAbilityLevel(YXX,'A4IF')==0 then
		call HUANGWU2(WXX, YXX)
	endif
endfunction
function aDx takes nothing returns boolean
return (IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(GetFilterUnit(),'A04R')==0 and IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(GetTriggerUnit())))!=null
endfunction
function IRE takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit m5=GetEnumUnit()
local real d=KE7(u,m5)-25
local real ISE=0
local integer id=GetUnitTypeId(u)
local string skilltx
local integer O5=GetPlayerId(GetOwningPlayer(u))
if id=='Z01B' then
set skilltx="model\\Hero_Spectre_N7S_I_Target.mdl"
elseif id=='Z11B' then
set skilltx="model\\Hero_Spectre_N6S_I_Target.mdl"
elseif id=='Z21B' then
set skilltx="model\\Hero_Spectre_N4S_I_Target.mdl"
elseif id=='Z31B' then
set skilltx="model\\Hero_Spectre_N3S_I_Target.mdl"
else
set skilltx="Abilities\\Spells\\Undead\\DeathandDecay\\DeathandDecayDamage.mdl"
endif
if d<=300 then
set ISE=1
elseif d<$3E8 then
set ISE=($3E8-d)/700
endif
if ISE>0 then
set V04[GetPlayerId(GetOwningPlayer(m5))]=true
call B67(u,m5,3,YS*ISE)
set V04[GetPlayerId(GetOwningPlayer(m5))]=false
	if UGZSTX[O5] then
		call DestroyEffect(AddSpecialEffectTarget(skilltx,m5,"chest"))
	endif
endif
set u=null
set m5=null
endfunction
function ITE takes nothing returns boolean
local unit WX7=GetTriggerUnit()
local real VW9=GetEventDamage()
local integer BC7=B287_GetUnitAbilityLevel(WX7,'A0NA')
local group g
local boolexpr spectreDispersionEnemyFilter=null
local integer O5=GetPlayerId(GetOwningPlayer(WX7))
local unit spectreDamageSource=GetEventDamageSource()
local boolean spectreSkipDrainDamage=false
if spectreDamageSource!=null and GetUnitTypeId(spectreDamageSource)!=0 and GetUnitAbilityLevel(spectreDamageSource,'Bdcl')>0 and (B287_GetUnitAbilityLevel(spectreDamageSource,'A0CC')>0 or B287_GetUnitAbilityLevel(spectreDamageSource,'A02Z')>0) and LoadUnitHandle(L7,GetHandleId(spectreDamageSource),'A0CC')==WX7 then
set spectreSkipDrainDamage=true
endif
if C677(VW9) and ISPH(WX7)==false and spectreSkipDrainDamage==false then
	if GetGameTime()>UGZS[O5]+.3 then
		set UGZS[O5]=GetGameTime()+.3
		set UGZSTX[O5]=true
	else
		set UGZSTX[O5]=false
	endif
set g=WS7()
set YS=VW9*(.06+.04*BC7)
call YN7(WX7,YS)
set spectreDispersionEnemyFilter=Condition(function AW7)
call GroupEnumUnitsInRange(g,GetUnitX(WX7),GetUnitY(WX7),$401,spectreDispersionEnemyFilter)
call DestroyBoolExpr(spectreDispersionEnemyFilter)
call ForGroup(g,function IRE)
call WR7(g)
endif
set WX7=null
set g=null
set spectreDispersionEnemyFilter=null
set spectreDamageSource=null
return false
endfunction
function IUE takes unit WI7 returns nothing
local trigger t=null
if WI7==null or GetUnitTypeId(WI7)==0 then
return
endif
set t=CreateTrigger()
call TriggerRegisterUnitEvent(t,WI7,EVENT_UNIT_DAMAGED)
call TriggerAddCondition(t,Condition(function ITE))
set t=null
endfunction
function IVE takes nothing returns boolean
if B287_GetLearnedSkill()=='A0NA' and B287_GetUnitAbilityLevel(GetTriggerUnit(),'A0NA')==1 and IsUnitIllusion(GetTriggerUnit())==false then
call IUE(GetTriggerUnit())
endif
return false
endfunction
function JP8 takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
call YB7(t,EVENT_PLAYER_HERO_SKILL)
call TriggerAddCondition(t,Condition(function IVE))
loop
exitwhen i>15
set UGZSTX[i]=false
set i=i+1
endloop
set t=null
endfunction
function IXE takes nothing returns nothing
local unit m5=GetEnumUnit()
local unit WI7=GetTriggerUnit()
local unit oA=CreateUnit(GetOwningPlayer(WI7),'e00E',GetUnitX(m5),GetUnitY(m5),0)
call NT7(GetHandleId(oA),"HauntTarget",m5)
call XF7(oA,'A0N9')
call SetUnitAbilityLevel(oA,'A0N9',B287_GetUnitAbilityLevel(WI7,'A0H9'))
call IssueTargetOrderById(oA,$D0132,WI7)
call UnitApplyTimedLife(oA,'BTLF',1.)
set m5=null
set WI7=null
set oA=null
endfunction
function IXE2 takes nothing returns nothing
local unit m5=GetSpellTargetUnit()
local unit WI7=GetTriggerUnit()
local unit oA=CreateUnit(GetOwningPlayer(WI7),'e00E',GetUnitX(m5),GetUnitY(m5),0)
call XF7(WI7,'A0HA')
call NT7(GetHandleId(oA),"HauntTarget",m5)
call XF7(oA,'A0N9')
call SetUnitAbilityLevel(oA,'A0N9',B287_GetUnitAbilityLevel(WI7,'A0H9'))
call IssueTargetOrderById(oA,$D0132,WI7)
call UnitApplyTimedLife(oA,'BTLF',1.)
call LINGXIA(WI7,m5)
set m5=null
set WI7=null
set oA=null
endfunction
function IYE takes nothing returns boolean
return(IsUnitType(GetFilterUnit(),UNIT_TYPE_HERO)and IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(GetTriggerUnit())))!=null
endfunction
function IZE takes nothing returns nothing
local integer OB7=GetHandleId(GetTriggeringTrigger())
local unit XU=O77(OB7,"HauntImage")
local unit m5=O77(OB7,"HauntTarget")
local integer IAE=OM7(OB7,"HauntPhase")
if XU==null or m5==null or GetUnitTypeId(XU)==0 or GetUnitTypeId(m5)==0 then
call DisableTrigger(GetTriggeringTrigger())
call NM7(OB7)
call OZ7(GetTriggeringTrigger())
if XU!=null then
call RemoveSavedHandle(L7,GetHandleId(M7[GetPlayerId(GetOwningPlayer(XU))]),StringHash("HauntTarget")+GetHandleId(XU))
call KillUnit(XU)
endif
set XU=null
set m5=null
return
endif
if GetTriggerEventId()!=EVENT_UNIT_DEATH and GetTriggerEventId()!=EVENT_UNIT_ISSUED_TARGET_ORDER and GetTriggerEventId()!=EVENT_UNIT_ISSUED_POINT_ORDER then
set IAE=IAE+1
call NP7(OB7,"HauntPhase",IAE)
endif
if GetTriggerEventId()==EVENT_UNIT_DEATH then
call DisableTrigger(GetTriggeringTrigger())
call RemoveSavedHandle(L7,GetHandleId(M7[GetPlayerId(GetOwningPlayer(XU))]),StringHash("HauntTarget")+GetHandleId(XU))
call NM7(GetHandleId(GetTriggeringTrigger()))
if m5==GetTriggerUnit()then
call KillUnit(XU)
endif
call OZ7(GetTriggeringTrigger())
elseif IsUnitPaused(XU)==false then
if IAE==2 then
call SetUnitVertexColor(XU,$FF,$FF,$FF,$FF)
endif
if IAE>1 then
call DisableTrigger(GetTriggeringTrigger())
call IssueTargetOrderById(XU,$D000F,m5)
call EnableTrigger(GetTriggeringTrigger())
else
call DisableTrigger(GetTriggeringTrigger())
call IssueTargetOrderById(XU,$D0012,m5)
call EnableTrigger(GetTriggeringTrigger())
endif
endif
set XU=null
set m5=null
endfunction
function IBE takes nothing returns boolean
return GetUnitAbilityLevel(GetSummonedUnit(),'B06L')>0
endfunction
function ICE takes nothing returns nothing
local unit WI7=GetTriggerUnit()
local unit oA=GetSummoningUnit()
local unit XU=GetSummonedUnit()
local unit m5=O77(GetHandleId(oA),"HauntTarget")
local integer BC7=B287_GetUnitAbilityLevel(WI7,'A0H9')
local trigger t=CreateTrigger()
if oA==null or XU==null or m5==null or GetUnitTypeId(oA)==0 or GetUnitTypeId(XU)==0 or GetUnitTypeId(m5)==0 then
if XU!=null then
call KillUnit(XU)
endif
if oA!=null then
call NM7(GetHandleId(oA))
endif
call OZ7(t)
set t=null
set m5=null
set XU=null
set oA=null
set WI7=null
return
endif
call SaveUnitHandle(L7,GetHandleId(M7[GetPlayerId(GetOwningPlayer(oA))]),StringHash("HauntTarget")+GetHandleId(XU),m5)
call SetUnitPathing(XU,false)
call SetUnitMoveSpeed(XU,339+61*BC7)
call SetUnitX(XU,GetUnitX(m5))
call SetUnitY(XU,GetUnitY(m5))
