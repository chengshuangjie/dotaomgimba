	if PD_ITEM_SKILL(ZU[id])>0 then
		call PD_Alreay_Use(p,O5,BUY[O5],PD_ITEM_SKILL(ZU[id]))
	 endif
    set BUY[O5]=BUY[O5]+1
endfunction
function Z3X takes unit ZX7, unit u, boolean Z4X, integer Z5X returns nothing
	local integer i = 0
	local item it
	local integer k = 0
	local integer Z6X = 0
	local integer j
	local player p = GetOwningPlayer(u)
	local integer Z7X
	local integer Z8X
	local integer O5=GetPlayerId(p)
	call FlushChildHashtable(TABLE_HY,'ITEM')
	loop
		set it = UnitItemInSlot(ZX7, i)
		if it != null and(GetItemPlayer(it)== p or PK4 or GetPlayerSlotState(GetItemPlayer(it))== PLAYER_SLOT_STATE_LEFT) then
			call SaveItemHandle(TABLE_HY,'ITEM', k, it)
			call SaveInteger(TABLE_HY,'ITEM', k, KY7(it))
			set k = k + 1
		endif
		set it = UnitItemInSlot(u, i)
		if it != null and(GetItemPlayer(it)== p or PK4 or GetPlayerSlotState(GetItemPlayer(it))== PLAYER_SLOT_STATE_LEFT) then
			call SaveItemHandle(TABLE_HY,'ITEM', k, it)
			call SaveInteger(TABLE_HY,'ITEM', k, KY7(it))
			set k = k + 1
		endif
		set i = i + 1
	exitwhen i > 5
	endloop
	set it = null
	if Z4X == false and k <= 6 then
        set p=null
		return
	endif
	set Z6X = k
	set k = 1
	if Z4X then
		set k = Z5X
	endif
	loop
		call SaveInteger(TABLE_HY,'ITEM', 51, FJ4[k])
		call SaveInteger(TABLE_HY,'ITEM', 52, FK4[k])
		call SaveInteger(TABLE_HY,'ITEM', 53, FM4[k])
		call SaveInteger(TABLE_HY,'ITEM', 54, FN4[k])
		call SaveInteger(TABLE_HY,'ITEM', 55, FO4[k])
		set Z8X = 0
		set Z7X = 0
		set i = 0
		if FJ4[k]!= 0 then
			set Z7X = Z7X + 1
		endif
		if FK4[k]!= 0 then
			set Z7X = Z7X + 1
		endif
		if FM4[k]!= 0 then
			set Z7X = Z7X + 1
		endif
		if FN4[k]!= 0 then
			set Z7X = Z7X + 1
		endif
		if FO4[k]!= 0 then
			set Z7X = Z7X + 1
		endif
		loop
			set j = LoadInteger(TABLE_HY,'ITEM', i)
			if j > 0 and LoadBoolean(TABLE_HY,'ITEM', i)!= true then
				if(j == LoadInteger(TABLE_HY,'ITEM', 51) and Z2X(TABLE_HY,'ITEM', 51)) or(j == LoadInteger(TABLE_HY,'ITEM', 52) and Z2X(TABLE_HY,'ITEM', 52)) or(j == LoadInteger(TABLE_HY,'ITEM', 53) and Z2X(TABLE_HY,'ITEM', 53)) or(j == LoadInteger(TABLE_HY,'ITEM', 54) and Z2X(TABLE_HY,'ITEM', 54)) or(j == LoadInteger(TABLE_HY,'ITEM', 55) and Z2X(TABLE_HY,'ITEM', 55)) then
					call SaveItemHandle(TABLE_HY,'ITEM', 100 + Z8X, LoadItemHandle(TABLE_HY,'ITEM', i))
					call SaveBoolean(TABLE_HY,'ITEM', i, true)
					call SaveInteger(TABLE_HY,'ITEM',$C8+ Z8X, i)
					set Z8X = Z8X + 1
				endif
			endif
			set i = i + 1
		exitwhen i >= Z6X
		endloop
		if Z8X > 0 then
			set i = 100 
			loop
				if Z8X == Z7X then
					set it = LoadItemHandle(TABLE_HY,'ITEM', i)
					if FP4[k]== DI4 then
						call SaveInteger(TABLE_HY,'ITEM', 300, 12)
                    elseif FP4[k]== VB then
                        call SaveInteger(TABLE_HY,'ITEM', 300, 6)
                    elseif FP4[k]== E1 then
                        call SaveInteger(TABLE_HY,'ITEM', 300, 8)
					elseif FP4[k]== it_dgh then
						if KY7(it)== DY4 then
							call SaveInteger(TABLE_HY,'ITEM', 300, GetItemCharges(it))
						endif
					elseif FP4[k]== DT4 then
						if KY7(it)== ZA then
							call SaveInteger(TABLE_HY,'ITEM', 300, GetItemCharges(it))
						endif
					endif
					call RemoveItem(it)
				else
					call RemoveSavedBoolean(TABLE_HY,'ITEM', LoadInteger(TABLE_HY,'ITEM', 100 + i))
				endif
				call RemoveSavedHandle(TABLE_HY,'ITEM', i)
				set i = i + 1
			exitwhen HaveSavedHandle(TABLE_HY,'ITEM', i)== false
			endloop
		endif
		if Z8X == Z7X then
            if Z4X == false then
				set it = UnitAddItemById(u, ZU[FP4[k]])
				if FP4[k]== DI4 or FP4[k]== DT4 or FP4[k]==it_dgh or FP4[k]== VB or FP4[k]== E1 then
					if HaveSavedInteger(TABLE_HY,'ITEM', 300) then
						call SetItemCharges(it, LoadInteger(TABLE_HY,'ITEM', 300))
						call RemoveSavedInteger(TABLE_HY,'ITEM', 300)
					endif
				endif
				call SetItemPlayer(it, p, true)
				call SetItemUserData(it, 0)
				call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIem\\AIemTarget.mdl", u, "origin"))
				set it = null
            else
                set it = CreateItem(SU[FP4[k]], GetUnitX(u), GetUnitY(u))
				call Record_Buy_Item(p,O5,FP4[k])
				if FP4[k]==B5 and IsPlayerAlly(GetLocalPlayer(),p) then
					set BUYSJTIME[GetPlayerId(p)]=GetGameTime()
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,4,Q[GetPlayerId(p)]+KZ4[GetPlayerId(p)]+"|r |c00ffff00"+GetObjectName('n0LY')+"|r")
				endif
				if FP4[k]== DI4 or FP4[k]== DT4 or FP4[k]== it_dgh or FP4[k]== VB or FP4[k]== E1 then
					if HaveSavedInteger(TABLE_HY,'ITEM', 300) then
						call SetItemCharges(it, LoadInteger(TABLE_HY,'ITEM', 300))
						call RemoveSavedInteger(TABLE_HY,'ITEM', 300)
					endif
				endif
				call SetItemPlayer(it, p, true)
				call SetItemUserData(it, 0)
				call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIem\\AIemTarget.mdl", u, "origin"))
                call UnitAddItem(u, it)
				set it = null
            endif
		endif
	exitwhen k >= FQ4
		set k = k + 1
	endloop
	set p=null
endfunction
