local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local integer skill='A4KM'
local integer BC7=0
local real BZ7
local unit BB7
local real x=0.
local real y=0.
local real d=0.
local integer OB7=0
local real time=2.
if ZX7==null then
set t=null
return false
endif
set BC7=B287_GetUnitAbilityLevel(ZX7,skill)
set x=GetUnitX(ZX7)
set y=GetUnitY(ZX7)
set d=ReduceUnitAbilityCoolDownReal(ZX7)
set OB7=GetHandleId(ZX7)
if BC7==0 then
set skill='A01Y'
    set BC7=B287_GetUnitAbilityLevel(ZX7,skill)
    set time=3.
endif
set BZ7=LoadReal(ZCC,-skill,BC7)
//有不朽盾就返回
if GetUnitAbilityLevel(ZX7,'A2YV')>0 then
set t=null
set ZX7=null
return false
endif
if ON7(OB7,"SuijiReincarnationReadyAt")<=TimerGetElapsed(W) and (GetUnitState(ZX7,UNIT_STATE_MANA)>=140 or B287_GetUnitAbilityLevel(ZX7,'A4KM')>0) then
    call OV7(ZX7,"chongsheng")
    if d>0 then
        //call EE5(ZX7,1093677401,true,25)
        set BZ7=BZ7*d
        call Japi_ReduceUnitAbilityCoolDown(ZX7,skill,BZ7)
    endif
    call NQ7(OB7,"SuijiReincarnationReadyAt",TimerGetElapsed(W)+BZ7)
    if GetUnitTypeId(ZX7)=='ZC00' then
        call DestroyEffect(AddSpecialEffect("model\\hero_skeletonking_n7s_r_blast.mdx",x,y))
    endif
set BB7=CreateUnit(GetOwningPlayer(ZX7),'e00E',GetUnitX(ZX7),GetUnitY(ZX7),0)
call UnitApplyTimedLife(BB7,'BTLF',3.)
call UnitAddAbility(BB7,'A274')
call SetUnitAbilityLevel(BB7,'A274',BC7)
    call IssueImmediateOrder(BB7,"thunderclap")
    set t=CreateTrigger()
    set I97=GetHandleId(t)
    call TriggerRegisterTimerEvent(t,time+.01,false)
    call TriggerAddCondition(t,Condition(function HAG))
    call SaveUnitHandle(L7,(I97),(2),(ZX7))
    call SaveInteger(L7,(I97),(10),(skill))
endif
if skill=='A4KM' then
    call Refresh_Item(ZX7)
    call B287_MHAbility_SetCooldown(ZX7, 'XHtb', 0)
endif
set t=null
set ZX7=null
set BB7=null
return false
endfunction
