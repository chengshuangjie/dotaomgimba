function I69 takes nothing returns nothing
local unit u
if X04 then
return
endif
if(M7[GetPlayerId(GetTriggerPlayer())]==null)then
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,E9,10.,GetObjectName('n08A'))
else
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,E9,10.,GetUnitName(M7[GetPlayerId(GetTriggerPlayer())])+" "+GetObjectName('n08N')+" "+I2S(R2I(.5+U6V(M7[GetPlayerId(GetTriggerPlayer())]))))
if MD9(M7[GetPlayerId(GetTriggerPlayer())])then
set u=ME9(M7[GetPlayerId(GetTriggerPlayer())])
if u!=null then
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,E9,10.,GetUnitName(u)+" "+GetObjectName('n08N')+" "+I2S(R2I(.5+U6V(u))))
endif
endif
endif
set u=null
