function Get_Gold takes unit u returns integer
    local integer gold=0
    local integer n=0
    local unit courier=null
    local unit Bear=null
    local integer i=GetPlayerId(GetOwningPlayer(u))
    local unit BB7=KU4[i]
    if u!=null then
        set courier=LoadUnitHandle(TABLE_K, GetHandleId(GetOwningPlayer(u)),'COUR')
        set Bear=O77(GetHandleId(GetOwningPlayer(u)),"MyBear")
    endif


    loop
    exitwhen n>5
        set gold=gold+Get_Item_Price(GetItemTypeId(UnitItemInSlot(u,n)))
        set gold=gold+Get_Item_Price(GetItemTypeId(UnitItemInSlot(courier,n)))
        set gold=gold+Get_Item_Price(GetItemTypeId(UnitItemInSlot(BB7,n)))
        if Bear!=null then
            set gold=gold+Get_Item_Price(GetItemTypeId(UnitItemInSlot(Bear,n)))
        endif
        set n=n+1
    endloop
    if CHIA[i]==1 then
        set gold=gold+6200
    endif
    if CHILLX[i]==1 then
        set gold=gold+8400
    endif
    if CHIYY[i]==1 then
        set gold=gold+4000
    endif
    if GetUnitAbilityLevel(u,'B0HS')==1 then
        set gold=gold+2900
    endif
    set gold=gold+GetPlayerState(GetOwningPlayer(u), PLAYER_STATE_RESOURCE_GOLD)
    set courier=null
    set Bear=null
    return gold
endfunction
function JCC takes nothing returns nothing
    local player p=GetTriggerPlayer()
    local unit u
    local integer i
    local integer n=1
    local integer gold
    local real time
    local integer minute=GetPlayerState(p,PLAYER_STATE_RESOURCE_LUMBER)
    local integer seconds=GetPlayerState(p,PLAYER_STATE_RESOURCE_FOOD_USED)
    if X14 then
        set time=(TimerGetElapsed(W)-M_4+60)/60
    else
        set time=1.
        set minute=0
        set seconds=0
    endif
    if TV7(p) then
        set i=1
    else
        set i=7
    endif
    call ZZ7(p)
    call DisplayTimedTextToPlayer(p,0,0,10,"------------游戏时间: "+I2S(minute)+"分"+I2S(seconds)+"秒"+"------------")
    loop
    exitwhen n>5
    set gold=0
    set u=M7[i]
    if u!=null then
        set gold=Get_Gold(u)
        call DisplayTimedTextToPlayer(p,0,0,10, Q[i]+GetPlayerName(Player(i))+"|r 财产总计 "+I2S(gold)+" ("+I2S(R2I(gold/time))+"/分)")
    endif
    set i=i+1
    set n=n+1
    endloop
    call DisplayTimedTextToPlayer(p,0,0,10,"------------------------------------")
    call DisplayTimedTextToPlayer(p,0,0,10," ")
    set u=null
    set p=null
endfunction
