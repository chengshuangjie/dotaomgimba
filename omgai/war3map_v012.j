		call SetUnitState(m5,UNIT_STATE_LIFE,LoadReal(TABLE_HY, GetHandleId(m5),StringHash("LIFE")))
		set interval=LoadInteger(TABLE_HY, GetHandleId(m5),StringHash("INTERVAL"))
		set interval=interval+1
		if interval==$A then
			set interval=0
			if level==1 then
				call B67(ZX7,m5,1,12.5)
			elseif level==2 then
				call B67(ZX7,m5,1,20)
			elseif level==3 then
				call B67(ZX7,m5,1,32)
			endif
		endif
		call SaveInteger(TABLE_HY, GetHandleId(m5),StringHash("INTERVAL"),interval)
	elseif DUR>CP7 and UnitAlive(m5)==false then
		call SaveReal(TABLE_HY, GetHandleId(m5),StringHash("DUR"),0)
		call SaveReal(TABLE_HY, GetHandleId(m5),StringHash("LIFE"),99999)
	endif
