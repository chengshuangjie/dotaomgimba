if GetSpellAbilityId()=='Y0BF' then
set duration=30.*SuijiMode_GetDurationMulticastCount(ZX7,'A03K')
call SuijiMode_StartScriptedFlight(ZX7,1,duration)
endif
call UnitApplyTimedLife(BB7,'BTLF',2.)
call Sky_View_MJ(ZX7,30.)
call StartSound(Sound_DarkTime)
call XF7(BB7,'A4G5')
call IssueImmediateOrderById(BB7,$D028D)
call SaveUnitHandle(L7,OB7,0,ZX7)
call TriggerRegisterTimerEvent(t,0.1,false)
call TriggerRegisterTimerEvent(t,duration,false)
call TriggerRegisterUnitEvent(t,ZX7,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function HASJ_Damage))
call YS7("tx\\yemo\\portaleffect.mdl",ZX7,"origin",1)
set ZX7=null
set BB7=null
endfunction
function HASJ2 takes nothing returns boolean
