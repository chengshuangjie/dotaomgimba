function Get_JH_1_CD takes unit u returns real
	return RMaxBJ(1.,4-((GetUnitState(u,UNIT_STATE_ATTACK1_SPEED)-1)/1.33))
endfunction
function Get_JH_3_CD takes unit u returns real
	return 3/(0.77+GetHeroAgi(u,true)*0.01)
endfunction
function Get_JH_4_Range takes unit u returns real
	return 250+GetHeroStr(u,true)*1.5
endfunction
function Get_JH_4_Xuanyun takes unit u returns real
	return GetHeroStr(u,true)*0.01+0.75
endfunction


function rp4 takes nothing returns boolean
local unit u=GetAttacker()
local integer id
if IsUnitType(u,UNIT_TYPE_HERO) then
    call SaveReal(L7,GetHandleId(u),'ZGSX',GetUnitX(GetTriggerUnit()))
    call SaveReal(L7,GetHandleId(u),'ZGSY',GetUnitY(GetTriggerUnit()))
endif
if GetUnitTypeId(u)=='Z060' then
    set id=(LoadInteger(L7,(GetHandleId(u)),(2038257011)))+1
    call SetUnitAnimationByIndex(u,JH_ACTION[id])
    if id==4 then
        set id=0
    endif
    call SaveInteger(L7,(GetHandleId(u)),(2038257011),(id))
endif
set u=null
return false
endfunction
function ZCJH takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_ATTACKED)
call TriggerAddCondition(t,Condition(function rp4))
set JH_ACTION[1]=0
set JH_ACTION[2]=2
set JH_ACTION[3]=4
set JH_ACTION[4]=3
set t=null
endfunction


function JH_HJCT takes unit ZX7,unit IH7,real d returns nothing
    local real damage1
    local real damage2
    local real damage
    local real Damagerate
    local real Reducerate=0.5
    if ZX7==null or IH7==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 then
        return
    endif
    if d==0 then
        set d=(GetUnitState(ZX7, UNIT_STATE_ATTACK1_DAMAGE_BASE) + GetUnitState(ZX7, UNIT_STATE_ATTACK1_DAMAGE_BONUS) )
        set Damagerate=LoadReal(ExtraHT, 'bjbs', GetHandleId(ZX7))
        if Damagerate==0 then
            set Damagerate=1.
        endif
    else
        set Damagerate=ON7(GetHandleId(ZX7),"BJ_rate")
    endif
    if Have_Item(ZX7, ZU[ANEW39]) then
        set Reducerate=0.75
    endif
    set damage1=Get_Target_Attacked_Damge_Reduce_Arror(d,IH7,Reducerate)
    set damage2=Get_Target_Attacked_Damge(d,IH7)
    set damage=(damage1- damage2) * Damagerate
    if damage > 0 then
        call B67_DPS(ZX7 , IH7 , 10 , damage)
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\FarseerMissile\\FarseerMissile.mdl",IH7,"chest"))
        call HJCT_TEXT("+"+I2S(R2I(damage)),1,IH7,.023,$BF,64,$FF,$D8)
    endif
endfunction
function JH_HJCT_PD takes unit ZX7,unit IH7 returns nothing
	if ZX7==null or IH7==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 then
        return
    endif
	if (GetUnitAbilityLevel(ZX7,'B0KD')>0) and IsUnitEnemy(ZX7, GetOwningPlayer(IH7)) and IsUnitType(IH7, UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(IH7,'A04R')==0 then
        call JH_HJCT(ZX7,IH7,0)
	endif
endfunction
function JH_HJCT_ATTACK takes nothing returns nothing
    call JH_HJCT_PD(WXX,YXX)
endfunction




function Get_Z takes unit u returns real
local location p=GetUnitLoc(u)
local real z=GetLocationZ(p)
call RemoveLocation(p)
return z
endfunction
function Obb takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local integer h=GetHandleId(t)
local unit u=(LoadUnitHandle(L7,(h),(-$3CFCF863)))
local unit IH7=(LoadUnitHandle(L7,(h),($5372AAA)))
local lightning l=LoadLightningHandle(TABLE_HY,h,0)
local real Pb=(LoadReal(L7,(h),(-$692098B0)))
if u==null or IH7==null or GetUnitTypeId(u)==0 or GetUnitTypeId(IH7)==0 then
if l!=null then
call DestroyLightning(l)
endif
call FlushChildHashtable(TABLE_HY,h)
call FlushChildHashtable(L7,((h)))
call OZ7(t)
set l=null
set u=null
set IH7=null
set t=null
return
endif
call MoveLightningEx(l,false,GetUnitX(u),GetUnitY(u),Get_Z(u)+GetUnitFlyHeight(u)+60,GetUnitX(IH7),GetUnitY(IH7),GetUnitFlyHeight(IH7)+Get_Z(IH7)+60)
if IsUnitInGroup(IH7,yw)and SquareRoot((GetUnitX(IH7)-GetUnitX(u))*(GetUnitX(IH7)-GetUnitX(u))+(GetUnitY(IH7)-GetUnitY(u))*(GetUnitY(IH7)-GetUnitY(u)))<1200 then
if IsUnitAliveBJ(u)and IsUnitVisible(IH7,GetOwningPlayer(u)) then
else
call SetLightningColor(l,1,1,1,0)
endif
else
set Pb=Pb-.1
call SaveReal(L7,(h),(-$692098B0),((Pb)*1.))
if IsUnitAliveBJ(u)then
if GetLocalPlayer()==GetOwningPlayer(u)then
call SetLightningColor(l,1,1,1,Pb)
endif
else
call SetLightningColor(l,1,1,1,0)
endif
if Pb<=0 then
call DestroyLightning(l)
call FlushChildHashtable(TABLE_HY,h)
call FlushChildHashtable(L7,((h)))
call OZ7(t)
endif
endif
set l=null
set u=null
set IH7=null
endfunction
//大招箭头标识
function Qbb takes nothing returns nothing
local unit u=GetEnumUnit()
local unit IH7=IN4
local lightning l
local trigger t
local integer h
if u==null or IH7==null or GetUnitTypeId(u)==0 or GetUnitTypeId(IH7)==0 then
set IH7=null
set u=null
return
endif
if AI_SKILL_OK(u,'A4IX') and SquareRoot((GetUnitX(IH7)-GetUnitX(u))*(GetUnitX(IH7)-GetUnitX(u))+(GetUnitY(IH7)-GetUnitY(u))*(GetUnitY(IH7)-GetUnitY(u)))<1300 and IsUnitEnemy(u,GetOwningPlayer(IH7))then
set l=AddLightningEx("ARROW",false,0,0,0,0,0,0)
if GetLocalPlayer()!=GetOwningPlayer(u)then
call SetLightningColor(l,1,1,1,0)
endif
set t=CreateTrigger()
set h=GetHandleId(t)
call TriggerAddAction(t,function Obb)
call TriggerRegisterTimerEvent(t,.04,true)
call SaveUnitHandle(L7,(h),(-$3CFCF863),(u))
call SaveUnitHandle(L7,(h),($5372AAA),(IH7))
call SaveReal(L7,(h),(-$692098B0),((1)*1.))
call SaveLightningHandle(TABLE_HY,h,0,l)
endif
set IH7=null
set u=null
set t=null
set l=null
endfunction
function Rb takes unit u returns nothing
local integer i
if(IsUnitType(u, UNIT_TYPE_HERO))then
set i=(LoadInteger(L7,(GetHandleId(u)),(-$1AD8105D)))+1
call SaveInteger(L7,(GetHandleId(u)),(-$1AD8105D),(i))
if i==1 then
call GroupAddUnit(yw,u)
set IN4=u
call ForGroup(zww,function Qbb)
endif
endif
endfunction
function Sb takes unit u returns nothing
local integer i
if(IsUnitType(u, UNIT_TYPE_HERO))then
set i=(LoadInteger(L7,(GetHandleId(u)),(-$1AD8105D)))-1
call SaveInteger(L7,(GetHandleId(u)),(-$1AD8105D),(i))
if i==0 then
call GroupRemoveUnit(yw,u)
endif
endif
endfunction
function rq4 takes unit u,real fx returns nothing
local unit m=CreateUnit(GetOwningPlayer(u),'h0HH',GetUnitX(u),GetUnitY(u),fx)
local real scale=1.3
call SetUnitScale(m,scale,scale,scale)
call MHUnit_SetModel(m,"tx\\jianhao\\jianhao_blade_flash.mdl",false)
call KillUnit(m)
set m=null
endfunction
function rr4 takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local integer h=GetHandleId(t)
local unit u=(LoadUnitHandle(L7,(h),(-$3CFCF863)))
local integer n=(LoadInteger(L7,(h),($2970F80D)))
local boolean TJING=LoadBoolean(TABLE_HY,h,0)
if TJING==false then
call SetUnitAnimationByIndex(u,$B+n)
if n!=2 then
call rq4(u,(LoadReal(L7,(h),(-$3815E6B8))))
endif
else
call SetUnitAnimationByIndex(u,5)
endif
call QueueUnitAnimation(u,"stand")
call FlushChildHashtable(L7,((h)))
call OZ7(t)
set u=null
set t=null
endfunction
function rt4 takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local integer h=GetHandleId(t)
local unit IH7=(LoadUnitHandle(L7,(h),($5372AAA)))
local real v=LoadReal(L7,h,'84ER')
call SetUnitFlyHeight(IH7,GetUnitFlyHeight(IH7)+v,0)
if v<=-32 then
call Sb(IH7)
call PauseUnitEx(IH7,false)
call SetUnitPathing(IH7,true)
call FlushChildHashtable(L7,((h)))
call OZ7(t)
endif
set v=v-2
call SaveReal(L7,h,'84ER',v*1.)
set IH7=null
set t=null
endfunction
function ZGS_GJ takes unit ZX7,unit IH7 returns nothing
    local real CXATTACK=ON7(GetHandleId(ZX7),"attack")
	local real d
    local real xishu=.4
	local real damage
	local real r=B4R(ZX7)+B4R_XXGH(ZX7)
    local real FL_rate=0.
    local real BJ_rate=ON7(GetHandleId(ZX7),"BJ_rate")
	local integer level=GetUnitAbilityLevel(ZX7,'A4IU')
    if XM_MODE then
        set xishu=.5
    endif
    call MNGJTX(ZX7,IH7)
	set d=CXATTACK*xishu+20*level
	set damage=Get_Target_Attacked_Damge(d,IH7)
	call B67_DPS(ZX7,IH7,2,d*BJ_rate)
    if UnitAlive(IH7) and GetUnitAbilityLevel(ZX7,'B0KD')>0 then
        call JH_HJCT(ZX7,IH7,d)
    endif
    // call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "|c00FF8000暴击值|r"+R2S(BJ_rate)+" 减伤前伤害"+R2S(d*BJ_rate)+" 减伤后伤害"+R2S(damage*BJ_rate))
	if UnitAlive(IH7) and GetUnitAbilityLevel(ZX7,'A1AB')> 0 and IsUnitIllusion(IH7)==false and IsUnitType(IH7, UNIT_TYPE_HERO)==false and (IH7 != V4 and AS7(IH7)==false) then	
		call Q5A(ZX7, IH7, damage)
	endif
	if IsUnitIllusion(ZX7)==false and IsUnitIllusion(IH7)==false and r>0 then
		call SetWidgetLife(ZX7, GetWidgetLife(ZX7)+damage*BJ_rate*r)
		call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\VampiricAura\\VampiricAuraTarget.mdl", ZX7, "origin"))
	endif
    if BJ_rate>1 then
        call YW7(I2S(R2I(damage*BJ_rate))+"!",2,IH7,0.024,255,0,128,255)
    endif
	//分裂(狂战和授予力量)
    if (GetUnitAbilityLevel(ZX7,'A1AB')> 0) and (MR7(ZX7,ZU[X1]) or MR7(ZX7,ZU[it_xh]))  then
	    set FL_rate=.45*(Have_Item_Quantity(ZX7,X1)+Have_Item_Quantity(ZX7,it_xh))
    endif
    if Have_SYLL(ZX7) then
        set level=LoadInteger(ExtraHT, 'A037', GetHandleId(ZX7))
        set FL_rate=(0.1 + level * 0.1)+FL_rate
    endif
    if FL_rate>0 and JH_FL then
        call B67_DPS(ZX7 , IH7 , 10 , d*BJ_rate*FL_rate)
    endif
set ZX7=null
set IH7=null
endfunction
function ru4 takes nothing returns nothing //旋风
local unit u=Y24
local unit IH7=GetEnumUnit()
local integer h
local trigger t
if IsUnitInGroup(IH7,IQ4)==false then
call ZGS_GJ(u,IH7)
call GroupAddUnit(IQ4,IH7)
if WF7(IH7)==false then
	if KCD(IH7)==false then
call XF7(IH7,'Amrf')
call UnitRemoveAbility(IH7,'Amrf')
	endif
// call FC(u,IH7,1,0) //击晕敌人
call PauseUnitEx(IH7,true)
call SetUnitPathing(IH7,false)
set t=CreateTrigger()
set h=GetHandleId(t)
call TriggerAddAction(t,function rt4)
call TriggerRegisterTimerEvent(t,.03,true)
call SaveUnitHandle(L7,(h),($5372AAA),(IH7))
call SaveReal(L7,h,'84ER',32*1.)
call YS7("tx\\jianhao\\jianhao_blade.mdl",IH7,"chest",.5)
call Rb(IH7)
endif
endif
set u=null
set IH7=null
set t=null
endfunction
function rv4 takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local integer h=GetHandleId(t)
local unit m=(LoadUnitHandle(L7,(h),($2B0A6845)))
local unit u=(LoadUnitHandle(L7,(h),(-$3CFCF863)))
local real rw4=(LoadReal(L7,(h),($64956AE6)))
local real rx4=(LoadReal(L7,(h),($29E62CB7)))
local real dx=(LoadReal(L7,(h),($1FB8CFB5)))-rw4
local real dy=(LoadReal(L7,(h),($73298C5)))-rx4
local group g=(LoadGroupHandle(L7,(h),($214C62CC)))
local group g2=(LoadGroupHandle(L7,(h),($214C62CD)))
local integer n=GetTriggerExecCount(t)
if n<33 and BlockUnitPass(m)==false then
call SaveReal(L7,(h),($1FB8CFB5),((dx)*1.))
call SaveReal(L7,(h),($73298C5),((dy)*1.))
call SetUnitX(m,GetUnitX(m)+dx)
call SetUnitY(m,GetUnitY(m)+dy)
set IN4=u
set Y24=u
set IQ4=g2
set IJ4=(LoadReal(L7,(h),(-$3F5412B6)))
set JH_FL=false  //单条旋风不附带分裂效果
call GroupEnumUnitsInRange(g,GetUnitX(m),GetUnitY(m),200,Condition(function AJ7_Visible))
call ForGroup(g,function ru4)
else
call KillUnit(m)
call WR7(g)
call WR7(g2)
call FlushChildHashtable(L7,((h)))
call OZ7(t)
endif
set g=null
set g2=null
set m=null
set u=null
set t=null
endfunction
