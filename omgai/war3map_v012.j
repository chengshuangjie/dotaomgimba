function SXI takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer I97=GetHandleId(t)
local unit ZX7=LoadUnitHandle(L7,I97,0)
local unit IH7=LoadUnitHandle(L7,I97,1)
local integer BC7=LoadInteger(L7,I97,0)
local group g=null
local unit u
local integer SWYJPD=1
local integer i=0
if ZX7==null or IH7==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 then
call FlushChildHashtable(L7,I97)
call DestroyTimer(t)
set t=null
set IH7=null
set ZX7=null
return
endif
set g=WS7()
set i=GetPlayerId(GetOwningPlayer(ZX7))
if SWYJPD==1 and IsUnitType(IH7, UNIT_TYPE_HERO) then
set SWYJ[i]=SWYJ[i]+20
set SWYJPD=0
endif
set IN4=ZX7
call GroupEnumUnitsInRange(g,GetUnitX(IH7),GetUnitY(IH7),300+25,Condition(function AR7_gai))
call GroupRemoveUnit(g,IH7)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if WF7(u)==false then
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Demon\\DemonBoltImpact\\DemonBoltImpact.mdl",u,"origin"))
call B67(ZX7,u,1,575+150*BC7+SWYJ[i])
endif
call GroupRemoveUnit(g,u)
if SWYJPD==1 and IsUnitType(u, UNIT_TYPE_HERO) then
set SWYJ[i]=SWYJ[i]+20
set SWYJPD=0
endif
endloop
call WR7(g)
call FlushChildHashtable(L7,I97)
call DestroyTimer(t)
set t=null
set g=null
set u=null
set IH7=null
set ZX7=null
endfunction
function SOI takes nothing returns nothing
