call SaveUnitHandle(L7,(I97),(335),(VZ8))
call SaveUnitHandle(L7,(I97),(17),(IH7))
call UnitAddAbility(VZ8,'Aloc')
call SetUnitPosition(VZ8,GetUnitX(IH7)+100,GetUnitY(IH7)+100)
call IssueTargetOrderById(VZ8,$D000F,IH7)
call SetUnitMoveSpeed(VZ8,522)
call SetUnitVertexColorBJ(VZ8,100,100,100,60)
    if b then
        call LINGXIA(ZX7,IH7)
    endif
endif
set t=null
set IH7=null
set ZX7=null
set BB7=null
return false
endfunction
function K7E takes unit ZX7,unit IH7,boolean b returns nothing
local integer BC7=0
local integer id
local unit BB7=null
local trigger t
local integer I97
if ZX7==null or IH7==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 or UnitAlive(ZX7)==false or UnitAlive(IH7)==false then
set ZX7=null
set IH7=null
return
endif
set BC7=B287_GetUnitAbilityLevel(ZX7,'A2KZ')+B287_GetUnitAbilityLevel(ZX7,'A4HW')
if BC7<=0 then
set ZX7=null
set IH7=null
return
endif
if BC7>4 then
set BC7=4
endif
set BB7=CreateUnit(GetOwningPlayer(ZX7),'e00E',GetUnitX(ZX7),GetUnitY(ZX7),0)
call UnitApplyTimedLife(BB7,'BTLF',2.)
if BC7==1 then
set id='A26V'
elseif BC7==2 then
set id='A26W'
elseif BC7==3 then
set id='A26X'
elseif BC7==4 then
set id='A26Y'
endif
call SetPlayerAbilityAvailable(GetOwningPlayer(IH7),id,false)
if YS8(IH7)==false then
call Z57(IH7,id,1,5,'B0EJ')
endif
set t=CreateTrigger()
set I97=GetHandleId(t)
call YB7(t,EVENT_PLAYER_UNIT_SUMMON)
call TriggerAddCondition(t,Condition(function K4E))
call SaveUnitHandle(L7,(I97),(2),(ZX7))
call SaveUnitHandle(L7,(I97),(17),(IH7))
call SaveUnitHandle(L7,(I97),(19),(BB7))
call SaveBoolean(L7,(I97),(100),(b))
call XF7(BB7,'A24K')
call SetUnitAbilityLevel(BB7,'A24K',BC7)
call IssueTargetOrderById(BB7,$D0132,IH7)
call Y17(YC4,GetUnitX(IH7),GetUnitY(IH7))
set BB7=null
set t=null
endfunction
