function WBF takes nothing returns nothing
local location l
local unit WI7=GetTriggerUnit()
local real x1=0.
local real y1=0.
local real a
local real x2
local real y2
local integer V77=0
local real YM7
local real Hk
local unit m5=null
local integer length
local integer ZZMF_level=0
local integer ZZMF=0
if WI7==null or GetUnitTypeId(WI7)==0 then
set WI7=null
return
endif
set x1=GetUnitX(WI7)
set y1=GetUnitY(WI7)
set V77=B287_GetUnitAbilityLevel(WI7,'A0X5')
set ZZMF_level=GetUnitAbilityLevel(WI7,'A4DJ')+GetUnitAbilityLevel(WI7,'A4DZ')
if ZZMF_level>0 then
    set ZZMF=50*ZZMF_level
endif
if GetUnitAbilityLevel(WI7,'A2YK')>0 then
set length=900+ZZMF
elseif GetUnitAbilityLevel(WI7,'A2YJ')>0 then
set length=850+ZZMF
else
set length=700+ZZMF
endif
if GetSpellTargetUnit()!=null then
set l=GetUnitLoc(GetSpellTargetUnit())
else
set l=GetSpellTargetLoc()
endif
set x2=GetLocationX(l)
set y2=GetLocationY(l)
set a=Atan2(y2-y1,x2-x1)
set x2=x1+length*Cos(a)
set y2=y1+length*Sin(a)
if V77==1 then
set YM7=90
set Hk=1.1
elseif V77==2 then
set YM7=160
set Hk=1.6
elseif V77==3 then
set YM7=230
set Hk=2.1
elseif V77==4 then
set YM7=300
set Hk=2.6
endif
if GetSpellTargetUnit()!=null and WQ7(GetSpellTargetUnit())then
set m5=GetSpellTargetUnit()
endif
call H8E(WI7,m5,YM7,Hk,.52,x1,y1,x2,y2,$96,null,true,$640)
call RemoveLocation(l)
set l=null
set WI7=null
set m5=null
endfunction
