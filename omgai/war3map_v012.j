call XF7(GetEnumUnit(),'A1C9')
endif
elseif DNGH==3 then
if GetUnitAbilityLevel(GetEnumUnit(),'A1CB')==0 then
call XF7(GetEnumUnit(),'A1CB')
endif
elseif DNGH==4 then
if GetUnitAbilityLevel(GetEnumUnit(),'A1CC')==0 then
call XF7(GetEnumUnit(),'A1CC')
endif
endif
if IsUnitType(GetEnumUnit(),UNIT_TYPE_HERO) then
call CD7(GetEnumUnit(),R2I((I2R(GetHeroAgi(GetEnumUnit(),true))/ 7)*0.25*DNGH)-1)
endif
endfunction
