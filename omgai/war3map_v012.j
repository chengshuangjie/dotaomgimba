function SuijiMode_A0S1Status takes nothing returns boolean
local trigger suijiA0S1StatusTrigger=GetTriggeringTrigger()
local integer suijiA0S1StatusHandle=GetHandleId(suijiA0S1StatusTrigger)
local unit suijiA0S1StatusUnit=LoadUnitHandle(L7,suijiA0S1StatusHandle,2)
if suijiA0S1StatusUnit==null or GetUnitTypeId(suijiA0S1StatusUnit)==0 or UnitAlive(suijiA0S1StatusUnit)==false or B287_GetUnitAbilityLevel(suijiA0S1StatusUnit,'A0S1')<=0 then
call FlushChildHashtable(L7,suijiA0S1StatusHandle)
call OZ7(suijiA0S1StatusTrigger)
else
call QJD()
endif
set suijiA0S1StatusUnit=null
set suijiA0S1StatusTrigger=null
return false
endfunction
function SuijiMode_InitA0S1 takes unit suijiA0S1Unit returns nothing
local trigger suijiA0S1Trigger
local integer suijiA0S1TriggerHandle=0
local integer suijiA0S1Handle=0
if suijiA0S1Unit==null or GetUnitTypeId(suijiA0S1Unit)==0 then
return
endif
set suijiA0S1Handle=GetHandleId(suijiA0S1Unit)
if OO7(suijiA0S1Handle,"SuijiA0S1Init") then
return
endif
call NS7(suijiA0S1Handle,"SuijiA0S1Init",true)
set suijiA0S1Trigger=CreateTrigger()
set suijiA0S1TriggerHandle=GetHandleId(suijiA0S1Trigger)
call TriggerRegisterTimerEvent(suijiA0S1Trigger,.1,true)
call TriggerRegisterDeathEvent(suijiA0S1Trigger,suijiA0S1Unit)
call TriggerAddCondition(suijiA0S1Trigger,Condition(function SuijiMode_A0S1Status))
call SaveUnitHandle(L7,suijiA0S1TriggerHandle,2,suijiA0S1Unit)
call SetPlayerAbilityAvailable(GetOwningPlayer(suijiA0S1Unit),'A2AR',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(suijiA0S1Unit),'A2AS',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(suijiA0S1Unit),'A2AU',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(suijiA0S1Unit),'A2AT',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(suijiA0S1Unit),'A2AQ',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(suijiA0S1Unit),'A2AP',false)
set suijiA0S1Trigger=null
endfunction
function SuijiMode_InitEarthSpiritCopiedUnit takes unit suijiEarthSpiritUnit returns nothing
local integer suijiEarthSpiritHandle=0
local player suijiEarthSpiritPlayer=null
if suijiEarthSpiritUnit==null or GetUnitTypeId(suijiEarthSpiritUnit)==0 then
return
endif
set suijiEarthSpiritHandle=GetHandleId(suijiEarthSpiritUnit)
if OO7(suijiEarthSpiritHandle,"SuijiSource58UnitInit") then
return
endif
call NS7(suijiEarthSpiritHandle,"SuijiSource58UnitInit",true)
set suijiEarthSpiritPlayer=GetOwningPlayer(suijiEarthSpiritUnit)
if GetUnitAbilityLevel(suijiEarthSpiritUnit,'A2VM')==0 then
call XF7(suijiEarthSpiritUnit,'A2VM')
call UnitMakeAbilityPermanent(suijiEarthSpiritUnit,true,'A2VM')
endif
call SetPlayerAbilityAvailable(suijiEarthSpiritPlayer,'A2VM',false)
call UnitMakeAbilityPermanent(suijiEarthSpiritUnit,true,'A2Z4')
call ZIU6(suijiEarthSpiritUnit)
set suijiEarthSpiritPlayer=null
endfunction
function SuijiMode_SyncRandomDragonBlood takes unit u,integer level returns nothing
if u==null or GetUnitTypeId(u)==0 or level<=0 then
return
endif
if GetUnitAbilityLevel(u,'A4T4')==0 then
call UnitAddAbility(u,'A4T4')
call UnitMakeAbilityPermanent(u,true,'A4T4')
endif
call SetUnitAbilityLevel(u,'A4T4',level)
endfunction
function SuijiMode_InitCopiedSkill takes unit u,integer skill,integer level returns nothing
if u==null or GetUnitTypeId(u)==0 then
return
endif
call SuijiMode_InitCopiedInvokerSkill(u,skill,level)
call SuijiMode_InitAttackPassiveEvents(skill)
call SuijiMode_RegisterIllusionPassiveAttackInheritance(u,skill)
call SuijiMode_InitCrossRangeOrb(u,skill)
if skill=='A2V6' or skill=='A2V4' or skill=='A2V5' or skill=='A2V7' or skill=='A2Z3' then
call SuijiMode_InitEarthSpiritCopiedUnit(u)
endif
if skill=='A1NA' then
call VisageSoulAssumption_InitUnit(u)
elseif skill=='A0VX' then
call VisageGravekeeperCloak_InitUnit(u,level)
elseif skill=='A1NE' or skill=='A2IG' then
call XF7(u,'A4AV')
call XF7(u,'A4JO')
endif
if skill=='A0S9' then
call UnitAddAbility(u,'A0SA')
call UnitMakeAbilityPermanent(u,true,'A0SA')
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A0SA',false)
elseif skill=='A1NI' then
call SuijiMode_RemoveIdleTransientButton(u,'A1NH')
elseif skill=='A11N' then
call SuijiMode_RemoveIdleTransientButton(u,'A13D')
elseif skill=='A13T' then
call KunkkaTidebringer_InitUnit(u)
elseif skill=='A0MB' then
call UnitAddAbility(u,'A0MB')
call UnitMakeAbilityPermanent(u,true,'A0MB')
call SetUnitAbilityLevel(u,'A0MB',level)
elseif skill=='A0AK' or skill=='A1FY' then
call UnitAddAbility(u,'A0WF')
call UnitMakeAbilityPermanent(u,true,'A0WF')
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A0WF',false)
elseif skill=='A0RP' then
call UnitAddAbility(u,'A0RT')
call UnitMakeAbilityPermanent(u,true,'A0RT')
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A0RT',false)
call B287_MHAbility_SetCastpoint(u,'A0RP',.01)
call MHAbility_SetCastpoint(u,'A0RT',.01)
call TemplarAssassin_EnsureTrapScepter(u)
elseif skill=='A0RO' then
call TemplarAssassin_UpdatePsiBladesRange(u)
elseif skill=='A0H9' then
call UnitAddAbility(u,'A0HA')
call UnitMakeAbilityPermanent(u,true,'A0HA')
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A0HA',false)
endif
if skill=='A0DJ' then
call NS7(GetHandleId(u),"SuijiAftershock",true)
call NP7(GetHandleId(u),"SuijiAftershockLevel",level)
endif
if skill=='ACac' then
call SuijiMode_InitACac(u)
endif
if skill=='AHab' then
call SuijiMode_InitAHab(u)
endif
if skill=='A0DZ' then
call UnitAddAbility(u,'A0MB')
call UnitMakeAbilityPermanent(u,true,'A0MB')
call SetUnitAbilityLevel(u,'A0MB',B287_GetUnitAbilityLevel(u,'A0DZ'))
endif
if skill=='A0LV' then
call XF7(u,'A2MC')
call SetUnitAbilityLevel(u,'A2MC',B287_GetUnitAbilityLevel(u,'A0LV'))
endif
if skill=='A00J' or skill=='A4K2' then
call B287_MHAbility_SetCastpoint(u,'A00J',.01)
call B287_MHAbility_SetCastpoint(u,'A4K2',.01)
endif
if skill=='A062' and OO7(GetHandleId(u),"SuijiA062TechInit")==false then
call NS7(GetHandleId(u),"SuijiA062TechInit",true)
call SetPlayerTechResearched(GetOwningPlayer(u),'R00I',1)
endif
if skill=='A03U' then
call SuijiMode_SyncRandomTakeAim(u,level)
endif
if skill=='A064' then
call SuijiMode_InitA064(u)
endif
if skill=='A04P' or skill=='A1AU' then
call SET_HQJJ2(u,skill)
endif
if skill=='A2RA' then
call SuijiMode_InitA2RA(u)
endif
if skill=='A0BE' then
call XF7(u,'A09E')
call SetUnitAbilityLevel(u,'A09E',level)
endif
if skill=='A0O0' then
call XF7(u,'A4HN')
endif
if skill=='A0MX' then
call BrewmasterBrawler_RegisterDamage(u)
endif
if skill=='A0CL' then
call SuijiMode_SyncRandomDragonBlood(u,level)
endif
if skill=='A0AR' then
call W_9(u)
endif
if skill=='A0KY' then
call XF7(u,'A4JH')
if level>0 then
call SetUnitAbilityLevel(u,'A4JH',level)
else
call SetUnitAbilityLevel(u,'A4JH',B287_GetUnitAbilityLevel(u,'A0KY'))
endif
endif
if skill=='A029' then
call SuijiMode_InitA029(u)
endif
if skill=='A0O8' then
call SuijiMode_InitA0O8(u)
endif
if skill=='A03P' then
call SuijiMode_InitA03P(u)
endif
if skill=='A2W7' then
call B287_MHAbility_SetCastpoint(u,'A2W7',.01)
endif
if skill=='A086' then
call LVD(u,'A086')
endif
if skill=='A0MM' then
call SuijiMode_InitA0MM(u)
endif
if skill=='A0I8' then
call SuijiMode_InitA0I8(u)
endif
if skill=='A0LH' then
call SuijiMode_InitA0LH(u)
endif
if skill=='A01I' or skill=='A4BT' or skill=='A4BU' then
call SuijiMode_InitA01I(u)
endif
if skill=='A0SB' then
call B287_MHAbility_SetCastpoint(u,'A0SB',.01)
endif
if skill=='A0S1' then
call SuijiMode_InitA0S1(u)
elseif skill=='A28Q' then
call SaveUnitHandle(L7,StringHash("SuijiIoOverchargeInitDeferred"),0,u)
call ExecuteFunc("IoOvercharge_InitCopiedDeferred")
endif
if skill=='A01Y' or skill=='A4KM' then
call SuijiMode_InitA01Y(u)
endif
if skill=='A1HR' then
call SuijiMode_InitA1HR(u)
endif
if skill=='A088' then
call NS7(GetHandleId(u),"SuijiMulticast",true)
endif
if skill=='A0DY' or skill=='A1WB' then
call NS7(GetHandleId(u),"SuijiHeartstopper",true)
call Y99(u,true)
