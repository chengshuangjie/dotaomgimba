endif
else
call SetUnitX(ZX7,GetUnitX(IH7)-40)
call SetUnitY(ZX7,GetUnitY(IH7)-40)
if (AK7(IH7) or GetUnitAbilityLevel(IH7,'B0E2')>0) and IsUnitVisible(IH7,GetOwningPlayer(ZX7))==false then
call KillUnit(ZX7)
elseif ModuloInteger(GetTriggerEvalCount(t),5)==0 then
