call SUD()
endif
return false
endfunction
function XXXTJG takes nothing returns boolean
local unit u=GetTriggerUnit()
local integer OB7=GetHandleId(u)
local integer old_skill='A4A1'
local integer new_skill='A4A2'
local real interval
if (B287_GetLearnedSkill()==old_skill or B287_GetLearnedSkill()==new_skill) and IsUnitIllusion(u)==false then
if (GetUnitAbilityLevel(u,old_skill)==1 or GetUnitAbilityLevel(u,new_skill)==1) then
call SaveInteger(MSK,(OB7),(0),('A0OJ'))
call SaveInteger(MSK,(OB7),(1),('A2ZY'))
call SaveInteger(MSK,(OB7),(2),('A2ZZ'))
call Multiple_Skill(u,1,2,1.,old_skill,new_skill)
endif
if (GetUnitAbilityLevel(u,old_skill)>1 and GetUnitAbilityLevel(u,'A2ZY')>0) or (GetUnitAbilityLevel(u,new_skill)>1 and GetUnitAbilityLevel(u,'A2ZZ')>0) then
set interval=Multiple_Skill_Interval(old_skill,(GetUnitAbilityLevel(u,old_skill)+GetUnitAbilityLevel(u,new_skill)))
call SaveReal(MSK,(OB7),(50),(interval))
endif
endif
set u=null
return false
endfunction
function JY8 takes nothing returns nothing
