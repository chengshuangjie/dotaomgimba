    call IssuePointOrderById(BB7,$D0100,x,y)
    if mjskill=='S108' then
        call FlushChildHashtable(L7,(I97))
        call OZ7(t)
    endif
elseif GetTriggerEvalCount(t)==2 then
set BB7=CreateUnit(GetOwningPlayer(ZX7),'e00E',PIE,PJE,0)
    call XF7(BB7,mjskill)
    call SetUnitAbilityLevel(BB7,mjskill,level)
    call IssuePointOrderById(BB7,$D0100,x,y)
    call FlushChildHashtable(L7,(I97))
