function Global_Skill takes nothing returns boolean
local unit ZX7=GetTriggerUnit()
local integer skill=B287_GetSpellAbilityId()
if skill=='A1OV' then
    call MR_chongjibo()
elseif skill=='ABsh' then
    call YG_chongjibo()
elseif skill=='A2S7' and WQ7(GetSpellTargetUnit())==false then
    call  MR_toushi()
elseif skill=='ABS5' and WQ7(GetSpellTargetUnit())==false then
    call  YG_toushi()
elseif skill=='A1P6' and WQ7(GetSpellTargetUnit())==false then
    call  MR_youbu()
elseif skill=='ABen' and WQ7(GetSpellTargetUnit())==false then
    call  YG_youbu()
elseif skill=='A1OU' then
    if WQ7(GetSpellTargetUnit())==false then
        call  MR_jinghua()
    else
        call PLK(GetSpellTargetUnit())
    endif
elseif skill=='ABpu' then
    if WQ7(GetSpellTargetUnit())==false then
        call  YG_jinghua()
    else
        call PLK(GetSpellTargetUnit())
    endif
endif
// if PT4==false and Is_Item_Skill(skill) and GetUnitAbilityLevel(ZX7,'A2VW')>0 then
//     call MH_ReduceUnitAbilityCoolDown(ZX7,skill)
// endif
// if PT4==false and Is_Item_Skill(skill) and GetUnitAbilityLevel(ZX7,'A2VW')>0 then
//     call MH_ReduceUnitAbilityCoolDown(ZX7,skill)
// endif
if skill=='A0RK' then //信使之盾
    call XXZD_TIP(ZX7)
endif
set ZX7=null
return false
endfunction
function Global_Skill_CAST takes nothing returns boolean
local unit ZX7=GetTriggerUnit()
local unit IH7=GetSpellTargetUnit()
local integer skill=B287_GetSpellAbilityId()
if (skill=='A1OU' or skill=='ABpu') and WF7(IH7) and GetUnitAbilityLevel(IH7,'B014')==0 then
call KR7(ZX7)
call X37(GetOwningPlayer(ZX7),GetObjectName('n0LR'))
endif
set ZX7=null
set IH7=null
return false
endfunction
function W7G takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
call AddUnitAnimationProperties(ZX7,"alternate",false)
call FlushChildHashtable(L7,(I97))
call OZ7(t)
set t=null
set ZX7=null
return false
endfunction
function W8G takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local trigger t
local integer I97
if ZX7==null or GetUnitTypeId(ZX7)==0 then
set ZX7=null
return
endif
set t=CreateTrigger()
set I97=GetHandleId(t)
call TriggerRegisterTimerEvent(t,0,false)
call TriggerAddCondition(t,Condition(function W7G))
call SaveUnitHandle(L7,(I97),(2),(ZX7))
set t=null
set ZX7=null
endfunction
function W9G takes nothing returns boolean
local unit suijiGrandMagusCastUnit=GetTriggerUnit()
local integer suijiGrandMagusCastSkill=B287_GetSpellAbilityId()
if suijiGrandMagusCastUnit!=null and GetUnitTypeId(suijiGrandMagusCastUnit)!=0 and (suijiGrandMagusCastSkill=='A073' or suijiGrandMagusCastSkill=='A03J' or suijiGrandMagusCastSkill=='A04J' or suijiGrandMagusCastSkill=='A04M' or suijiGrandMagusCastSkill=='A04N' and (GetUnitTypeId(suijiGrandMagusCastUnit)=='E02X' or GetUnitTypeId(suijiGrandMagusCastUnit)=='Z02X' or (SUIJI_MODE and OO7(GetHandleId(suijiGrandMagusCastUnit),"SuijiDone") and B287_GetUnitAbilityLevel(suijiGrandMagusCastUnit,'A04N')>0)) or GetUnitTypeId(suijiGrandMagusCastUnit)=='Z02X') then
call W8G()
endif
set suijiGrandMagusCastUnit=null
return false
endfunction
function XXCMMF takes nothing returns boolean
local unit suijiDeathProphetLearnedUnit=GetTriggerUnit()
if B287_GetLearnedSkill()=='A0P6' and suijiDeathProphetLearnedUnit!=null and GetUnitTypeId(suijiDeathProphetLearnedUnit)!=0 then
    call XF7(suijiDeathProphetLearnedUnit,'A02C')
    call B287_SetUnitAbilityLevel(suijiDeathProphetLearnedUnit,'A02C',GetUnitAbilityLevel(suijiDeathProphetLearnedUnit,'A0P6'))
endif
set suijiDeathProphetLearnedUnit=null
return false
endfunction
function OX8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function W9G))
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_HERO_SKILL)
call TriggerAddCondition(t,Condition(function XXCMMF))
set t=null
endfunction
function SFFQ_ELQX takes nothing returns nothing
	local unit target = Wave_U
	local unit u = Wave_Sou
	if u!=null and target!=null and GetUnitTypeId(u)!=0 and GetUnitTypeId(target)!=0 and GetUnitAbilityLevel(u,'A4L7')>0 and GetPrdRandom(u, 'A4L7', 20) and UnitAlive(target) then
        call ELQX(u,target)
	endif
	set target = null
	set u = null
endfunction
function SFFQ3 takes nothing returns nothing
	local unit u = GetTriggerUnit()
	local integer level = 0
	local real x = 0.
	local real y = 0.
	local real length
    local integer ZZMF_level=0
    local integer ZZMF=0
    if u==null or GetUnitTypeId(u)==0 then
        set u=null
        return
    endif
    set level = GetUnitAbilityLevel(u, 'A02M')
    set x = GetUnitX(u)
    set y = GetUnitY(u)
    set ZZMF_level=GetUnitAbilityLevel(u,'A4DJ')+GetUnitAbilityLevel(u,'A4DZ')
    if ZZMF_level>0 then
        set ZZMF=50*ZZMF_level
    endif
    if GetUnitAbilityLevel(u,'A2YK')>0 then
    set length=1010+ZZMF
    elseif GetUnitAbilityLevel(u,'A2YJ')>0 then
    set length=960+ZZMF
    else
    set length=810+ZZMF
    endif
    if GetUnitAbilityLevel(u,'A4L7')>0 then
        call Wave(u,'h0HM', 25 + 75 * level, length, 150, 300, x, y, GetSpellTargetX(), GetSpellTargetY(), 1100, 1, false, "SFFQ_ELQX", level)
    else
        call Wave(u,'h0HM', 25 + 75 * level, length, 150, 300, x, y, GetSpellTargetX(), GetSpellTargetY(), 1100, 1, false, "", level)
    endif
    set u=null
endfunction
