function IsAbilityCanDoubleTapSelfCastById takes integer iSkillId returns boolean
    return LoadBoolean(LocalHashTable, SuijiMode_ToOriginalSkill(iSkillId), KEY_USE_DOUBLECLICK_SPELL)
endfunction
function DoubleTapAbilityToSelfCast__OnKeyDown takes nothing returns boolean
    local integer pressedKey
    local integer abilKey
    local integer abilId
    local integer logicalAbilId
    if MHUI_IsChatEditBarOn() or bDoubleClickSystemIsEnable==false then
        return false
    endif
    set abilId=MHUIData_GetTargetModeAbility()
    set logicalAbilId=SuijiMode_ToOriginalSkill(abilId)
    set pressedKey=MHEvent_GetKey()
    //如果这个技能不在可双击施法的哈希表里就返回
    if not IsAbilityCanDoubleTapSelfCastById(abilId) and logicalAbilId!='A0VQ' and logicalAbilId!='A11N' then
        set DoubleTapAbilityToSelfCast__LastKeyPressTimestamp[pressedKey]=MHGame_GetGameStamp()
        return false
    endif
    set abilKey=MHAbility_GetDefDataInt(abilId , ABILITY_DEF_DATA_HOTKEY)
	if ISLABIKE(MHPlayer_GetSelectUnit()) and (logicalAbilId=='A0VQ' or logicalAbilId=='A11N') then
		set abilKey=MHAbility_GetCustomDataInt(MHPlayer_GetSelectUnit(),abilId,ABILITY_DEF_DATA_HOTKEY)
	endif
    //当指示器激活    当技能为单位目标  当技能的快捷键是按下的按键 当在0.5秒内按下两次按键
    if MHMsg_IsIndicatorOn(INDICATOR_TYPE_TARGET_MODE) and ( abilId == DoubleTapAbilityToSelfCast__TargetModeAbilityId ) and ( abilKey == pressedKey ) and ( ( MHGame_GetGameStamp() - DoubleTapAbilityToSelfCast__DOUBE_TAP_TIME_THRESHOLD ) < DoubleTapAbilityToSelfCast__LastKeyPressTimestamp[pressedKey] ) then
        // 对自己施法
        call MHFrame_Click(MHUI_GetPortraitButton())
        // 按住shift时取消指示器
        if MHMsg_IsKeyDown(OSKEY_SHIFT) then
            call MHMsg_CancelIndicator()
        endif
    endif
    set DoubleTapAbilityToSelfCast__LastKeyPressTimestamp[pressedKey]=MHGame_GetGameStamp()
    return false
endfunction
function DoubleTapAbilityToSelfCast__OnCallTargetMode takes nothing returns boolean
    local integer abilId
    //获取指示器技能
    set abilId=MHMsgCallTargetModeEvent_GetAbility()
    //如果技能可双击施法   如果技能冷却时间为0
    if IsAbilityCanDoubleTapSelfCastById(abilId) and MHAbility_GetCooldown(MHPlayer_GetSelectUnit(),abilId)==0 then
        set DoubleTapAbilityToSelfCast__TargetModeAbilityId=abilId
    else
        set DoubleTapAbilityToSelfCast__TargetModeAbilityId=0
    endif
    return false
endfunction
function DoubleTapAbilityToSelfCast__OnCancelIndicator takes nothing returns boolean
    set DoubleTapAbilityToSelfCast__TargetModeAbilityId=0
    return false
endfunction

//初始化双击施法
function DoubleTapAbilityToSelfCast_Init takes nothing returns nothing
    local trigger t
    call DoubleClickSkill__Init()

    //注册本地玩家按键按下事件

    //注册本地玩家按键按下事件
    set t=CreateTrigger()
    call MHMsgKeyDownEvent_Register(t)
    call TriggerAddCondition(t, Condition(function DoubleTapAbilityToSelfCast__OnKeyDown))

    //注册本地玩家调起指示器事件

    //注册本地玩家调起指示器事件
    set t=CreateTrigger()
    call MHMsgCallTargetModeEvent_Register(t)
    call TriggerAddCondition(t, Condition(function DoubleTapAbilityToSelfCast__OnCallTargetMode))
    
    //注册本地玩家取消指示器事件
    
    //注册本地玩家取消指示器事件
    set t=CreateTrigger()
    call MHMsgCancelIndicatorEvent_Register(t)
    call TriggerAddCondition(t, Condition(function DoubleTapAbilityToSelfCast__OnCancelIndicator))
    set t=null
endfunction



function UnitLP takes unit u, boolean b returns string
	local integer i = R2I(GetUnitLifePercent(u))
	local string s
	if b then
		set s = "|Cff00ff00"
	else
        set s = ""
	endif
	if i == 0 then
		set i = 1
	endif
	return s + I2S(i)+ "%生命|R和"
endfunction
function UnitMP takes unit u, boolean b returns string
	local integer i = R2I(GetUnitManaPercent(u))
    local string s
	if b then
		set s = "|cff87cefa"
	else
        set s = ""
	endif
	if i == 0 then
		set i = 1
	endif
	return s + I2S(i)+ "%魔法|R"
endfunction
function ConvertHandleId2Unit takes integer i returns unit
	call SaveFogStateHandle(ConvertType, 0, 0, ConvertFogState(i))
	return LoadUnitHandle(ConvertType, 0, 0)
endfunction
function PromptEnemyState takes player p, string s returns nothing
	local unit u = ConvertHandleId2Unit(S2I(s))
	local player j8
	if u == null then
		return
	endif
	set j8 = GetOwningPlayer(u)
	call EXDisplayChat(p, 1, "敌人" + Q[GetPlayerId(j8)]+ GetUnitName(u) + "|r拥有" + UnitLP(u, false)+ UnitMP(u, false))
	//call PingMinimapByPlayerColor(p, GetUnitX(u), GetUnitY(u)) //发送小地图信号
	set u = null
	set j8 = null
endfunction
function GetSeGlyphCdByUnit takes player p returns real
	if TV7(p) then
		return YDWEGetUnitAbilityState(KU4[GetPlayerId(Z7[1])], 'A141', 1)
	else
		return YDWEGetUnitAbilityState(KU4[GetPlayerId(A7[1])], 'A1WI', 1)
	endif
endfunction
function Click_UI_Glyph takes nothing returns nothing
	local player p = DzGetTriggerKeyPlayer()
	local integer i = GetPlayerId(p)
	if DzIsKeyDown(18) then
		if GetChat_times(i) then
			call DzSyncData("p", "0")
		endif
	else
		if GetSeGlyphCdByUnit(p) == 0.00 then
			call DzSyncData("p", "1")
		endif
	endif
	set p=null
endfunction
function Trig_SynsL takes player p, integer id returns nothing
	local unit u = M7[id]
	local integer i = GetHeroLevel(u)
	if IsPlayerAlly(GetLocalPlayer(), p) or WG7(GetLocalPlayer()) then
		call EXDisplayChat(p, 1, "我还需要|c00FFFF00" + I2S(DzGetUnitNeededXP(u, i)-GetHeroXP(u))+ "|r点经验到达" + I2S(i + 1)+ "级")
	endif
	set u = null
endfunction
function Trig_Synsp takes nothing returns nothing
	local player p = DzGetTriggerSyncPlayer()
	local integer id = GetPlayerId(p)
	local string s = DzGetTriggerSyncData()
	if s == "1" then //激活防御符文
		call IssueImmediateOrderById(KU4[GetPlayerId(p)],$D0114)
	elseif s == "2" then
		call Trig_SynsL(p, id)
	elseif s == "0" then
		if IsPlayerAlly(GetLocalPlayer(), p) or WG7(GetLocalPlayer()) then
			if GetSeGlyphCdByUnit(p) == 0.00 then
				call EXDisplayChat(p, 1, "|c00fffc01防御符文|r > 已准备就绪")
			else
				call EXDisplayChat(p, 1, "|c00fffc01防御符文|r > 冷却中，还剩 |c00FF0000" + I2S(R2I(GetSeGlyphCdByUnit(p)))+ "|r 秒")
			endif
		endif
	else
		if IsPlayerAlly(GetLocalPlayer(), p) or WG7(GetLocalPlayer()) then
			call PromptEnemyState(p, s)
		endif
	endif
	set p=null
endfunction
function Trig_SynsT takes nothing returns nothing
	local player p = DzGetTriggerSyncPlayer()
	if IsPlayerAlly(GetLocalPlayer(), p) or WG7(GetLocalPlayer()) then
		call EXDisplayChat(p, 1, DzGetTriggerSyncData())
	endif
	set p=null
endfunction
//发送同步信息给盟友玩家
function s__PlayerChat_SendChatToAlliedPlayers takes string msg returns nothing
    if GetChat_times(GetPlayerId(GetLocalPlayer())) then
        call DzSyncData("CHAT", msg)
    endif
endfunction
function Trig_SynsChat takes nothing returns nothing
    local player p=DzGetTriggerSyncPlayer()
    local string data= DzGetTriggerSyncData()
    local string msg= MHString_Split(data , "#" , 1)
    if IsPlayerAlly(GetLocalPlayer(), p) then
        call MHUI_SendPlayerChat(p , msg , 10. , CHAT_CHANNEL_ALLY)
    endif
    set p=null
endfunction
function Set_Player_TXXS takes player p,boolean b returns nothing
local integer n
local integer max
if TV7(p) then
    set n=1
    set max=5
else
    set n=7
    set max=11
endif
loop
exitwhen n>max
call SetPlayerAllianceBJ(Player(n),ConvertAllianceType(7),b,p)
set n=n+1
endloop
endfunction
function SetUp_SyncData takes nothing returns boolean
	local string s = DzGetTriggerSyncData()
    local integer data = S2I(s)
    local player p = DzGetTriggerSyncPlayer()
	local integer id = GetPlayerId(p)
	local boolean b
	if data == 3 then
		set DISZDGJ[id] = not DISZDGJ[id]
        if M7[id]!=null then
            call Disable_Unit_Auto_Attack(M7[id],DISZDGJ[id])
        endif


	elseif data == 4 then
		set ab[id] = not ab[id]
		if GetLocalPlayer() == p then
			call GetSetUpText("多面板显示装备", ab[id])
		endif




	elseif data == 5 then
		set Ab[id] = not Ab[id]
		if GetLocalPlayer() == p then
			call GetSetUpText("自动选择召唤物", Ab[id])
		endif
	elseif data == 6 then
		set TPFZ[id] = not TPFZ[id]
		if GetLocalPlayer() == p then
			call GetSetUpText("TP时防右键打断", TPFZ[id])
		endif


	elseif data == 7 then
		set b = not OO7(GetHandleId(p),"DisableHelp")
        call NS7(GetHandleId(p),"DisableHelp",b)
		if GetLocalPlayer() == p then
			call GetSetUpText("拒绝友方帮助技能", b)
		endif
		
		
	elseif data == 8 then
		set CW[id] = not CW[id]
		if GetLocalPlayer() == p then
			call GetSetUpText("关闭特殊音效", not CW[id])
		endif


    elseif data == 9 then
		if TEXTDUR[id]== 1. then
			set TEXTDUR[id]= 8.
		else
			set TEXTDUR[id]= 1.
		endif
		if GetLocalPlayer() == p then
			call GetSetUpText("快速清理击杀信息", TEXTDUR[id]== 1.)
		endif


	elseif data == 10 then
        set OL3[id] = not OL3[id]
		if GetLocalPlayer() == p then
			call GetSetUpText("信使复活计时窗口", OL3[id])
		endif
	elseif data == 11 then
		set OL4[id] = not OL4[id]
        if GetLocalPlayer() == p then
		    call GetSetUpText("英雄复活计时窗口", OL4[id])
        endif
    elseif data == 19 then
		set TXXS[id] = not TXXS[id]
        call Set_Player_TXXS(p,TXXS[id])
        if GetLocalPlayer() == p then
		    call GetSetUpText("开启队友头像显示", TXXS[id])
        endif
	endif
    set p = null
    return false
endfunction
//初始化同步触发器
function InitSyncTrigger takes nothing returns nothing
	local trigger trig
	set trig = CreateTrigger()
	call DzTriggerRegisterSyncData(trig, "p", false)
	call TriggerAddAction(trig, function Trig_Synsp)
	set trig = CreateTrigger()
	call DzTriggerRegisterSyncData(trig, "t", false)
	call TriggerAddAction(trig, function Trig_SynsT)
	set trig = CreateTrigger()
	call DzTriggerRegisterSyncData(trig, "CHAT", false)
	call TriggerAddAction(trig, function Trig_SynsChat)
	set trig = CreateTrigger()
	call DzTriggerRegisterSyncData(trig, "setup", false)
    call TriggerAddCondition(trig, Condition( function SetUp_SyncData))
	set trig = CreateTrigger()
	call DzTriggerRegisterSyncData(trig, "omghold", false)
	call TriggerAddAction(trig, function OmgHoldPositionHotkey_OnSync)

//	set trig = CreateTrigger()
//	call DzTriggerRegisterSyncData(trig, "FogClick", false)
 //   call TriggerAddCondition(trig, Condition( function SyncFogClickData))

	// 同步学习技能快捷键
//	set trig = CreateTrigger()
//	call DzTriggerRegisterSyncData(trig, "SyncLeranSkillHotKey", false)
 //   call TriggerAddCondition(trig, Condition( function SyncLeranSkillHotKeyActions ))

//	set trig = CreateTrigger()
//	call DzTriggerRegisterSyncData(trig, "FogClick", false)
 //   call TriggerAddCondition(trig, Condition( function SyncFogClickData))

	// 同步学习技能快捷键
//	set trig = CreateTrigger()
//	call DzTriggerRegisterSyncData(trig, "SyncLeranSkillHotKey", false)
 //   call TriggerAddCondition(trig, Condition( function SyncLeranSkillHotKeyActions ))
	set trig = null
endfunction
function Click_LifeManaButton takes nothing returns nothing
	local unit u = MHPlayer_GetSelectUnit()
	local integer i = GetPlayerId(GetLocalPlayer())
	local player p
	local integer j8 = GetPlayerId(DzGetTriggerKeyPlayer())
	if DzIsKeyDown(18) then
		if u != null and GetUnitAbilityLevel(u, 'AHer') > 0 then
			if IsUnitAlly(u, GetLocalPlayer()) and IsUnitType(u, UNIT_TYPE_HERO) then
				if GetChat_times(j8) then
					if u == M7[i] then 
						call DzSyncData("t", "我拥有" + UnitLP(u, true)+ UnitMP(u, true))
					else
						set p = GetOwningPlayer(u)
						call DzSyncData("t", "队友 " + Q[GetPlayerId(p)] + GetPlayerName(p) + "|r拥有" + UnitLP(u, true)+ UnitMP(u, true))
						set p = null
					endif
				endif
			else
				if GetChat_times(j8) then
					// 如果是敌人 直接同步单位
					call DzSyncData("p", I2S(GetHandleId(u)))
				endif
			endif
		endif
	endif
	set u = null
endfunction
function GetFrameToolTipStr takes integer frame, integer typeId returns string
	return LoadStr( ExtraHT, frame, typeId )
endfunction
function FrameToolTip__MouseEnter takes nothing returns nothing
	local integer frame = DzGetTriggerUIEventFrame()
	call DzFrameShow( UIFrame__ToolTip, true )
	call DzFrameSetText( UIText__ToolTip, GetFrameToolTipStr( frame, HTKEY_UI_TOOLTIP_STR ) )
	call DzFrameSetText( UIText__ToolUberTip, GetFrameToolTipStr( frame, HTKEY_UI_TOOLTIP_UBERSTR ) )
endfunction

function FrameToolTip__MouseLeave takes nothing returns nothing
	call DzFrameShow( UIFrame__ToolTip, false )
endfunction
// 给Frame添加工具提示
function SetFrameToolTip takes integer frame, string tip, string uberTip returns nothing
	call SaveStr( ExtraHT, frame, HTKEY_UI_TOOLTIP_STR, tip )
	call SaveStr( ExtraHT, frame, HTKEY_UI_TOOLTIP_UBERSTR, uberTip )
	call DzFrameSetScriptByCode( frame, 2, function FrameToolTip__MouseEnter, false )
	call DzFrameSetScriptByCode( frame, 3, function FrameToolTip__MouseLeave, false )
endfunction
// 关闭更新日志
function Click_OKButton_Script takes nothing returns nothing
	set UpdateLogIsShow = false
	call DzFrameShow( UIFrame__UpdateLog , false)
endfunction
function Click_SetUp_GlueCheckBox_Actions takes integer id returns nothing
	if id == 0 then //显示蓝条
		set XSLT = UIFrame__IsCheckBoxEnable[id]
        call MHUI_EnableDrawMPBar(XSLT)
		call GetSetUpText("显示蓝条", XSLT)
        if XSLT==false and XSLTOnlyFriend then 
            set UIFrame__IsCheckBoxEnable[1] = not UIFrame__IsCheckBoxEnable[1]
            call DzFrameShow( UIFrame__HighLight[1], UIFrame__IsCheckBoxEnable[1] )
            set XSLTOnlyFriend = UIFrame__IsCheckBoxEnable[1]
            call MHUI_OnlyDrawAllyMPBar(XSLTOnlyFriend)
        endif
	elseif id == 1 then //仅显示友方蓝条
		set XSLTOnlyFriend = UIFrame__IsCheckBoxEnable[id]
        if XSLT == false and XSLTOnlyFriend then 
            set UIFrame__IsCheckBoxEnable[0] = not UIFrame__IsCheckBoxEnable[0]
            call DzFrameShow( UIFrame__HighLight[0], UIFrame__IsCheckBoxEnable[0] )
            call Click_SetUp_GlueCheckBox_Actions(0)
        endif
        call MHUI_OnlyDrawAllyMPBar(XSLTOnlyFriend)
		call GetSetUpText("仅显示友方蓝条", XSLTOnlyFriend)	
	elseif id == 2 then
        set bDoubleClickSystemIsEnable = UIFrame__IsCheckBoxEnable[id]
        call GetSetUpText("双击对己施法", bDoubleClickSystemIsEnable)
	elseif id == 12 then
        set IsCapsLockEnableMultiboard = UIFrame__IsCheckBoxEnable[id]
		call GetSetUpText("CapsLock键开启多面板", UIFrame__IsCheckBoxEnable[id])
    elseif id == 13 then
        call DzEnableWideScreen(UIFrame__IsCheckBoxEnable[id])
		call GetSetUpText("宽屏模式", UIFrame__IsCheckBoxEnable[id])
	elseif id == 14 then
        set AltShowAttackRange = UIFrame__IsCheckBoxEnable[id]
		call GetSetUpText("Alt显示防御塔攻击范围", UIFrame__IsCheckBoxEnable[id])
	elseif id == 15 then
        set AltShowRefreshRange = UIFrame__IsCheckBoxEnable[id]
		call GetSetUpText("Alt显示野怪刷新范围", UIFrame__IsCheckBoxEnable[id])
	elseif id == 16 then
        call MHUI_EnableDrawAbilsHotkey(UIFrame__IsCheckBoxEnable[id])
		call GetSetUpText("开启技能热键显示", UIFrame__IsCheckBoxEnable[id])
	elseif id == 17 then
        call MHUI_EnableDrawAbilsCooldown(UIFrame__IsCheckBoxEnable[id])
		call GetSetUpText("开启技能冷却显示", UIFrame__IsCheckBoxEnable[id])
	elseif id == 18 then
        call MHUI_EnableDrawItemsCooldown(UIFrame__IsCheckBoxEnable[id])
		call GetSetUpText("开启物品冷却显示", UIFrame__IsCheckBoxEnable[id])
    else //其他都需要同步
        call DzSyncData("setup", I2S(id))
    endif
endfunction
//初始勾选的复选框回调
function Click_SetUp_GlueCheckBox_true takes nothing returns nothing
    local integer id = R2I(((DzGetTriggerUIEventFrame() - FirstCheckBox) / Frame_X ))
    set UIFrame__IsCheckBoxEnable[id] = not UIFrame__IsCheckBoxEnable[id]
    call DzFrameShow( UIFrame__HighLight[id], UIFrame__IsCheckBoxEnable[id] )
	call Click_SetUp_GlueCheckBox_Actions(id)
endfunction

// 创建复选框 id为序号,xy的值是UI的绝对位置,b为是否初始勾选
function Create__CheckBox takes integer id, string tip, boolean b returns string
    local real x
    local real y 
    if id > 9 then
        set x = CheckBox_WidthInitialValue + CheckBox_WidthSpacing
        set y = CheckBox_HeightInitialValue - CheckBox_HeightSpacing * (id - 10)
    else
        set x = CheckBox_WidthInitialValue
        set y = CheckBox_HeightInitialValue - CheckBox_HeightSpacing * id
    endif
    // 复选框,父UI为"地图设置"
    set UIFrame__CheckBox[id] = DzCreateFrameByTagName("GLUECHECKBOX", "name", UIFrame__OrderSetUp, "SetUp_CheckBox", id)
    call DzFrameSetAbsolutePoint( UIFrame__CheckBox[id], 4, x, y )
    set UIFrame__IsCheckBoxEnable[id] = b
	set Default_SetUp[id] = b
    set UIFrame__HighLight[id] = DzCreateFrameByTagName("HIGHLIGHT", "name", UIFrame__CheckBox[id], "SetUp_CheckBox_Highlight", id)
    call DzFrameSetAllPoints( UIFrame__HighLight[id], UIFrame__CheckBox[id] )
    if not b then
        call DzFrameShow(UIFrame__HighLight[id], false)
    endif
    // 初始勾选的复选框回调与初始不勾选不同,需脚本来控制高亮模型隐藏/显示
    // 事件Id,  7是勾选复选框,8是取消勾选
    // 初始勾选的复选框回调与初始不勾选不同,需脚本来控制高亮模型隐藏/显示
    // 事件Id,  7是勾选复选框,8是取消勾选
    // 初始勾选的复选框回调与初始不勾选不同,需脚本来控制高亮模型隐藏/显示
    // 事件Id,  7是勾选复选框,8是取消勾选
    call DzFrameSetScriptByCode( UIFrame__CheckBox[id], 7, function Click_SetUp_GlueCheckBox_true, false)
    call DzFrameSetScriptByCode( UIFrame__CheckBox[id], 8, function Click_SetUp_GlueCheckBox_true, false)
    // 复选框注释
    set UIFrame__CheckBoxText[id] = DzCreateFrameByTagName("TEXT", "name", UIFrame__CheckBox[id], "CheckBox_Text", id)
    call DzFrameSetPoint( UIFrame__CheckBoxText[id], 3, UIFrame__CheckBox[id], 5, 0.005, 0.0 )
    call DzFrameSetText( UIFrame__CheckBoxText[id], tip)
	return tip
endfunction
function CapsLock0 takes nothing returns nothing
	if IsCapsLockEnableMultiboard then
		call MultiboardMinimize(T4, true)
	endif
endfunction
function CapsLock1 takes nothing returns nothing
	if IsCapsLockEnableMultiboard then
		if IsMultiboardMinimized(T4) then
			call MultiboardMinimize(T4, false)
		endif
	endif
endfunction
