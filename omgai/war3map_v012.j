function BDI takes nothing returns nothing
	local trigger t = GetTriggeringTrigger()
	local integer h = GetHandleId(t)
	local unit ZX7=LoadUnitHandle(TABLE_HY, h, 0)
	local unit IH7=LoadUnitHandle(TABLE_HY, h, 1)
	local integer ht=LoadInteger(TABLE_HY, h, 20)
	local integer TME=LoadInteger(TABLE_HY, h, 21)
	local boolean cleanup=false
	local real r
	if ZX7==null or IH7==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 then
		set cleanup=true
	elseif UnitAlive(ZX7)==false or UnitAlive(IH7)==false then
		set cleanup=true
	elseif GetTriggerEventId()== EVENT_WIDGET_DEATH or (GetUnitAbilityLevel(IH7,'B4AZ')==0 and GetTriggerEvalCount(t)>2) then
		set cleanup=true
	endif
	if cleanup then
		call DestroyEffect(LoadEffectHandle(TABLE_HY, h, 10))
		if IH7!=null and GetUnitTypeId(IH7)!=0 then
			call UnitRemoveAbility(IH7,'A4AZ')
		endif
		if ht!=0 then
			call RemoveSavedHandle(TABLE_HY, ht,'FRSW'+ TME)
			call RemoveSavedBoolean(TABLE_HY, ht,'FRSW'+ TME)
		endif
		call FlushChildHashtable(TABLE_HY, h)
		call OZ7(t)
	else
		if LoadBoolean(TABLE_HY, h, 2) then
			call YW7("+" + I2S(R2I(LoadReal(TABLE_HY, h, 100))), 1, IH7, .023, 0, 232, 232, 216)
			set r=B4R(ZX7)+B4R_XXGH(ZX7)
			if IsUnitIllusion(IH7)==false and r>0 then			
				call SetWidgetLife(ZX7, GetWidgetLife(ZX7)+ LoadReal(TABLE_HY, h, 100) * r)
			endif
			call B67(ZX7, IH7, 2, LoadReal(TABLE_HY, h, 100))
			call SaveBoolean(TABLE_HY, h, 2, false)
		elseif GetGameTime()> LoadReal(TABLE_HY, h, 0) then
			call UnitRemoveAbility(IH7,'A4AZ')
			call DestroyEffect(LoadEffectHandle(TABLE_HY, h, 10))
			if ht!=0 then
				call RemoveSavedHandle(TABLE_HY, ht,'FRSW'+ TME)
				call RemoveSavedBoolean(TABLE_HY, ht,'FRSW'+ TME)
			endif
			call FlushChildHashtable(TABLE_HY, h)
			call OZ7(t)
		endif
	endif
	set t = null
	set ZX7 = null
	set IH7 = null
endfunction
function BFI takes unit ZX7, unit IH7 returns nothing
	local trigger t=null
	local integer h
    local integer ht=0
    local integer TME=0
    local integer level=0
    local integer YM7=0
    local integer jinu_level=0
    local real xishu=1
    if ZX7==null or IH7==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 then
        return
    endif
    if UnitAlive(ZX7)==false or UnitAlive(IH7)==false then
        return
    endif
    set ht=GetHandleId(IH7)
    set TME=GetPlayerId(GetOwningPlayer(ZX7))
    set level=B287_GetUnitAbilityLevel(ZX7,'A2UE')
	if level<=0 then
		return
	endif
    set YM7=10 + 5 * level
    set jinu_level=B287_GetUnitAbilityLevel(ZX7,'A0LC')+B287_GetUnitAbilityLevel(ZX7,'A4CB')
    if jinu_level==1 then
        set xishu=1.5
    elseif jinu_level==2 then
        set xishu=1.8
    elseif jinu_level==3 then
        set xishu=2.0
    endif
    if OT7(ZX7,"JINU") then
        set YM7=R2I(YM7*xishu)
    endif
	set t=LoadTriggerHandle(TABLE_HY, ht,'FRSW'+ TME)
	if LoadBoolean(TABLE_HY, ht,'FRSW'+ TME)== false or t==null then
		set t = CreateTrigger()
		set h = GetHandleId(t)
		call TriggerRegisterDeathEvent(t, IH7)
		call TriggerRegisterTimerEvent(t, 1, true)
		call TriggerAddCondition(t, Condition(function BDI))
		call SaveBoolean(TABLE_HY, ht,'FRSW'+ TME, true)
		call SaveTriggerHandle(TABLE_HY, ht,'FRSW'+ TME, t)
		call SaveBoolean(TABLE_HY, h, 2, true)
		call SaveUnitHandle(TABLE_HY, h, 1, IH7)
		call SaveInteger(TABLE_HY, h, 20, ht)
		call SaveInteger(TABLE_HY, h, 21, TME)
		call TriggerRegisterTimerEvent(t, 0, false)
		call SaveEffectHandle(TABLE_HY, h, 10, AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\BattleRoar\\RoarTarget.mdl", IH7, "overhead"))
		call XF7(IH7,'A4AZ')
	else
		set h = GetHandleId(t)
		call SaveBoolean(TABLE_HY, h, 2, true)
		call TriggerRegisterTimerEvent(t, 0, false)
	endif
		call SaveUnitHandle(TABLE_HY, h, 0, ZX7)
		call SaveReal(TABLE_HY, h, 100, LoadReal(TABLE_HY, h, 100)+ YM7)
		call SaveReal(TABLE_HY, h, 0, GetGameTime()+ 15)
	set t = null
endfunction
