call YB7(suijiDrainEndTrigger,EVENT_PLAYER_UNIT_SPELL_FINISH)
call YB7(suijiDrainEndTrigger,EVENT_PLAYER_UNIT_DEATH)
call YB7(suijiDrainEndTrigger,EVENT_PLAYER_UNIT_ISSUED_ORDER)
call YB7(suijiDrainEndTrigger,EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER)
call YB7(suijiDrainEndTrigger,EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER)
call TriggerAddCondition(suijiDrainEndTrigger,Condition(function SuijiMode_ChannelEndCleanup))
set suijiDrainEndTrigger=null
