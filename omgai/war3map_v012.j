//library OMGAITimerService:

    // ---- 定时器周期任务回调表（最多 32 个周期任务）-------------------------

    // 周期任务到期：找到对应 trigger 并求值
    function OMGAITimerService___OnPeriodicTick takes nothing returns nothing
        local trigger t = LoadTriggerHandle(OMGAI_PeriodicTable, GetHandleId(GetExpiredTimer()), 0)
        if t != null then
            call TriggerEvaluate(t)
        endif
    endfunction

    // 注册周期任务
    // interval - 周期（秒）
    // callback - 回调 trigger（由调用方创建并加 Condition）
    function OMGAITimerService_RegisterPeriodic takes real interval, trigger callback returns nothing
        if OMGAI_PeriodicCount >= 32 then
            call OMGAILogger_E("TimerSvc", "RegisterPeriodic: max 32 reached")
            return
        endif
        set OMGAI_PeriodicCount = OMGAI_PeriodicCount + 1
        set OMGAI_PeriodicIntervals[OMGAI_PeriodicCount] = interval
        set OMGAI_PeriodicTimers[OMGAI_PeriodicCount] = CreateTimer()
        if OMGAI_PeriodicTable == null then
            set OMGAI_PeriodicTable = InitHashtable()
        endif
        call SaveTriggerHandle(OMGAI_PeriodicTable, GetHandleId(OMGAI_PeriodicTimers[OMGAI_PeriodicCount]), 0, callback)
        call TimerStart(OMGAI_PeriodicTimers[OMGAI_PeriodicCount], interval, true, function OMGAITimerService___OnPeriodicTick)
    endfunction

    // ---- 主心跳回调（0.1s）---------------------------------------------------
    function OMGAITimerService___OnMainTick takes nothing returns nothing
        set OMGAI_TickCount = OMGAI_TickCount + 1
        // 触发 AI 心跳事件
        call OMGAIEventDispatcher_Fire(OMGAI_EVT_AI_HEARTBEAT)
        // 每 600 tick（约 60s）做一次泄漏自检
        if ModuloInteger(OMGAI_TickCount, 600) == 0 then
            set OMGAI_LeakCheckCounter = OMGAI_LeakCheckCounter + 1
            if OMGAI_DEBUG then
                call OMGAILogger_D("TimerSvc", "LeakCheck #" + I2S(OMGAI_LeakCheckCounter) + " created=" + I2S(OMGAI_HandleCreated) + " destroyed=" + I2S(OMGAI_HandleDestroyed))
            endif
        endif
    endfunction

    // ---- 模块初始化 ---------------------------------------------------------
    function OMGAITimerService_Init takes nothing returns nothing
        set OMGAI_MainTimer = CreateTimer()
        call TimerStart(OMGAI_MainTimer, OMGAI_TIMER_TICK_INTERVAL, true, function OMGAITimerService___OnMainTick)
        call OMGAILogger_I("TimerSvc", "Main timer started @ " + R2S(OMGAI_TIMER_TICK_INTERVAL) + "s")
    endfunction


//library OMGAITimerService ends
//library OMGAIHeroSkillManager:

    // 赋予技能到单位
    function OMGAIHeroSkillManager_GrantSkill takes unit u, integer rawCode returns nothing
        local integer skillIdx = OMGAISkillDef_FindByRawCode(rawCode)
        if skillIdx == 0 then
            call OMGAILogger_W("HSM", "GrantSkill: unknown rawCode=" + I2S(rawCode))
            return
        endif
        call UnitAddAbility(u, rawCode)
        if OMGAISkillDef_IsUltimate(skillIdx) then
            call SetPlayerAbilityAvailable(GetOwningPlayer(u), rawCode, true)
        endif

        // 触发 SKILL_GRANTED 事件（让 AI Controller 监听生成画像）
        call OMGAIEventDispatcher_ClearPayload()
        set OMGAI_EvtPayloadUnit    = u
        set OMGAI_EvtPayloadInt1   = rawCode
        call OMGAIEventDispatcher_Fire(OMGAI_EVT_SKILL_GRANTED)

        call OMGAILogger_D("HSM", "granted rawCode=" + I2S(rawCode) + " to " + GetUnitName(u))
    endfunction

    // 移除技能（含状态清理，预防竞品 -fixstate 坑）
    function OMGAIHeroSkillManager_RemoveSkill takes unit u, integer rawCode returns nothing
        local integer skillIdx = OMGAISkillDef_FindByRawCode(rawCode)
        // 先清理关联 buff
        call OMGAIStateCleaner_CleanForSkillRemoval(u, rawCode)
        call UnitRemoveAbility(u, rawCode)
        call OMGAILogger_D("HSM", "removed rawCode=" + I2S(rawCode))
    endfunction

    // 转技能被动重生：转技能刷新池前移除旧被动、再赋予新被动
    // oldRawCode: 旧技能（被替换或移除）；0 表示无旧技能
    // newRawCode: 新技能 rawcode；0 表示仅移除不新增
    function OMGAIHeroSkillManager_HandlePassiveRebirth takes unit u, integer oldRawCode, integer newRawCode returns nothing
        if oldRawCode != 0 then
            call OMGAIHeroSkillManager_RemoveSkill(u, oldRawCode)
        endif
        if newRawCode != 0 then
            call OMGAIHeroSkillManager_GrantSkill(u, newRawCode)
        endif
    endfunction


