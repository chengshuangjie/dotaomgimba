function Have_SYLL takes unit ZX7 returns boolean
if ZX7==null or GetUnitTypeId(ZX7)==0 then
return false
endif
return GetUnitAbilityLevel(ZX7, 'B0JU')>0 or GetUnitAbilityLevel(ZX7, 'B0JT')>0 or GetUnitAbilityLevel(ZX7, 'B0JS')>0 or GetUnitAbilityLevel(ZX7, 'B0JR')>0
endfunction
function Add_Tmp_Attack takes unit u,integer d returns nothing
local integer array b
local integer a=d
local integer c=1
local integer i=0
local integer UDD
if d<1 then
call UnitRemoveAbility(u,AddTmpAttack[0])
call UnitRemoveAbility(u,AddTmpAttack[1])
call UnitRemoveAbility(u,AddTmpAttack[2])
call UnitRemoveAbility(u,AddTmpAttack[3])
call UnitRemoveAbility(u,AddTmpAttack[4])
call UnitRemoveAbility(u,AddTmpAttack[5])
call UnitRemoveAbility(u,AddTmpAttack[6])
call UnitRemoveAbility(u,AddTmpAttack[7])
call UnitRemoveAbility(u,AddTmpAttack[8])
call UnitRemoveAbility(u,AddTmpAttack[9])
return
endif
loop
exitwhen c==0
set c=a/2
set b[i]=a-c*2
set a=c
set i=i+1
endloop
set UDD=9
set i=0
loop
exitwhen i>UDD
if b[i]==1 then
call XF7(u,AddTmpAttack[i])
else
call UnitRemoveAbility(u,AddTmpAttack[i])
endif
set i=i+1
endloop
endfunction
function Add_Tmp_Attack_Buff2 takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit m5
local integer o6
set m5=LoadUnitHandle(L7,OB7,17)
if m5==null or GetUnitTypeId(m5)==0 then
call FlushChildHashtable(L7,OB7)
call OZ7(t)
set m5=null
set t=null
return false
endif
if TimerGetElapsed(W)>=LoadReal(L7,OB7,0) or GetTriggerEventId()==EVENT_WIDGET_DEATH or LoadBoolean(L7,OB7,0) or Have_SYLL(m5)==false then
set o6=LoadInteger(L7,OB7,59)
call SaveBoolean(L7,OB7,0,true)
call Add_Tmp_Attack(m5,0)
call FlushChildHashtable(L7,OB7)
call OZ7(t)
call RemoveSavedHandle(Dvv,GetHandleId(m5),0-o6)
endif
set m5=null
set t=null
return false
endfunction
function Add_Tmp_Attack_Buff takes unit m5,integer o6,integer d,real Z27 returns nothing
local trigger t
local integer OB7
local real hyy
local real Hyy=TimerGetElapsed(W)+Z27
if m5==null or GetUnitTypeId(m5)==0 or XH7(m5)then
return
endif
if HaveSavedHandle(Dvv,GetHandleId(m5),0-o6)then
set t=LoadTriggerHandle(Dvv,GetHandleId(m5),0-o6)
set OB7=GetHandleId(t)
else
set t=CreateTrigger()
set OB7=GetHandleId(t)
call FlushChildHashtable(L7,OB7)
call SaveUnitHandle(L7,OB7,17,m5)
call SaveInteger(L7,OB7,59,o6)
call SaveReal(L7,OB7,0,0)
call TriggerRegisterDeathEvent(t,m5)
call TriggerRegisterTimerEvent(t,.1,true)
call TriggerAddCondition(t,Condition(function Add_Tmp_Attack_Buff2))
call SaveTriggerHandle(Dvv,GetHandleId(m5),0-o6,t)
endif
call SaveBoolean(L7,OB7,0,false)
set hyy=LoadReal(L7,OB7,0)
if hyy<Hyy then
call SaveReal(L7,OB7,0,Hyy)
endif
set t=null
call Add_Tmp_Attack(m5,d)
endfunction
