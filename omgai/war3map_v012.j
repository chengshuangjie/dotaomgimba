function CF_BE_JINGHUA takes eventid id,unit source,unit target,unit BB7, integer skill returns boolean
    return id==EVENT_PLAYER_UNIT_SPELL_EFFECT and (target==GetSpellTargetUnit() or BB7==GetSpellTargetUnit()) and IsUnitEnemy(target,GetOwningPlayer(source)) and JINGHUA_SKILL(skill)
endfunction
function MNXCF2 takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(OB7),(0)))
local unit IH7=(LoadUnitHandle(L7,(OB7),(1)))
local unit BB7=(LoadUnitHandle(L7,(OB7),(2)))
local unit oA=(LoadUnitHandle(L7,(OB7),(3)))
local integer WF8=GetTriggerEvalCount(t)
local real dur=(LoadReal(L7,(OB7),(10)))
local boolean ISITEM=(LoadBoolean(L7,(OB7),(11)))
local real Face=(LoadReal(L7,(OB7),(4)))
local real x
local real y
local integer cbtx
if CF_BE_JINGHUA(GetTriggerEventId(),GetTriggerUnit(),IH7,BB7,B287_GetSpellAbilityId()) and WQ7(IH7) then
    call PLK(IH7)
elseif WF8==dur or UnitAlive(IH7)==false or (CF_BE_JINGHUA(GetTriggerEventId(),GetTriggerUnit(),IH7,BB7,B287_GetSpellAbilityId()) and WQ7(IH7)==false)then
    call RemoveUnit(BB7)
    call RemoveUnit(oA)
    // call UnitRemoveAbility(IH7,'A04R')
    call UnitRemoveAbility(IH7,'A4DE')
    call UnitRemoveAbility(IH7,'A4DL')
    call UnitRemoveAbility(IH7,'Bcyc')
    call SetUnitInvulnerable(IH7,false)
    // call MHUnit_Silence(IH7,false)
    call FixUnitSilence(IH7)
    // call SetUnitScale(IH7,XX7(IH7),XX7(IH7),XX7(IH7))
    call UnitCancelHide(IH7)
	call OX7(IH7,"HideUnit")
    call SetUnitFlyHeight(IH7,GetUnitDefaultFlyHeight(IH7),0)
    call PauseUnitEx(IH7,false)
    set cbtx=LoadInteger(TABLE_Z, GetPlayerId(GetOwningPlayer(IH7)),0)
    if cbtx!=0 then
    call XF7(IH7,cbtx)
    endif
    if IsPlayerEnemy(GetOwningPlayer(ZX7),GetOwningPlayer(IH7)) and ISITEM then
        call B67(ZX7,IH7,1,50)
    endif
    if WF8==dur or UnitAlive(IH7)==false then
    else
        if BB7==GetSpellTargetUnit() and (WF7(IH7)==false or GetUnitAbilityLevel(IH7,'B014')==1) then
            call JINGHUA(GetTriggerUnit(),IH7,B287_GetSpellAbilityId())
        endif
    endif
    if IsUnitSelected(IH7,GetLocalPlayer()) then
        call SelectUnitForPlayerSingle(IH7,GetLocalPlayer())
    endif
    call RemoveSavedHandle(TABLE_HY,'CFMJ', GetHandleId(IH7))
    call FlushChildHashtable(L7,(OB7))
    call OZ7(t)
elseif GetTriggerEventId()==EVENT_UNIT_SELECTED then
    if IsUnitSelected(BB7,GetLocalPlayer()) then
        call SelectUnitForPlayerSingle(IH7,GetLocalPlayer())
    endif
else
    // call SetUnitScale(IH7,0,0,0)
    call SetUnitX(BB7,GetUnitX(IH7))
    call SetUnitY(BB7,GetUnitY(IH7))
    set Face=Face+10.8
    if Face>=360 then
        set Face=Face-360
    endif
    call SaveReal(L7,(OB7),(4),(Face))
    set x=GetUnitX(IH7)-75*Cos(Face*bj_DEGTORAD)
    set y=GetUnitY(IH7)-75*Sin(Face*bj_DEGTORAD)
    call MHUnit_SetFacing(oA,Face,true)
    call SetUnitX(oA,x)
    call SetUnitY(oA,y)
endif
set t=null
set ZX7=null
set IH7=null
set BB7=null
set oA=null
endfunction
function MNXCF takes unit ZX7, unit IH7,integer skilltx,real dur,boolean ISITEM returns nothing
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local unit BB7=CreateUnit(GetOwningPlayer(IH7),skilltx,GetUnitX(IH7),GetUnitY(IH7),0)
local real Face=GetUnitFacing(IH7)
local real x=GetUnitX(IH7)-75*Cos(Face*bj_DEGTORAD)
local real y=GetUnitY(IH7)-75*Sin(Face*bj_DEGTORAD)
local unit oA=CreateUnit(GetOwningPlayer(IH7),'h0GR',x,y,0)
local real d=XX7(IH7)
local real d2=1.
local integer cbtx
call SetUnitInvulnerable(IH7,true)
call YZ8(IH7)
call YW8(IH7,0,0)
// call XF7(IH7,'A04R')
call XF7(IH7,'A4DE')
call XF7(IH7,'A4DL')
call MHUnit_Silence(IH7,true)
call PauseUnitEx(IH7,true)
// call SetUnitScale(IH7,0,0,0)
call UnitEnterHide(IH7)
call OV7(IH7,"HideUnit")
if KCD(IH7)==false then
call XF7(IH7,'Amrf')
call UnitRemoveAbility(IH7,'Amrf')
endif
call SetUnitFlyHeight(IH7,500,0)
call MHUnit_SetModel(oA,EXGetUnitString(GetUnitTypeId(IH7), UNIT_STRING_MODEL_PATH),false)
call ResetUnitVertexColor(oA,GetUnitTypeId(IH7))
call MHUnit_SetTeamColor(oA,ConvertPlayerColor(GetPlayerId(GetOwningPlayer(IH7))))
call MHUnit_SetTeamGlow(oA,ConvertPlayerColor(GetPlayerId(GetOwningPlayer(IH7))))
if IsPlayerEnemy(GetLocalPlayer(),GetOwningPlayer(IH7)) and IsUnitVisible(IH7,GetLocalPlayer())==false then
    set d=0
    set d2=0
endif
call SetUnitScale(oA,d,d,d)
call SetUnitScale(BB7,d,d,d)
call SetUnitPathing(oA,false)
call SetUnitPathing(BB7,false)
call MHUnit_SetFacing(oA,Face,true)
call SetUnitFlyHeight(oA,500,3000)
if GetUnitTypeId(IH7)=='U00P' then
call SetUnitAnimation(oA,"stand alternate")
endif
call TriggerRegisterTimerEvent(t,0.02,true)
call TriggerRegisterUnitEvent(t,BB7,EVENT_UNIT_SELECTED)
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function MNXCF2))
call SaveUnitHandle(L7,(OB7),(0),(ZX7))
call SaveUnitHandle(L7,(OB7),(1),(IH7))
call SaveUnitHandle(L7,(OB7),(2),(BB7))
call SaveUnitHandle(L7,(OB7),(3),(oA))
call SaveReal(L7,(OB7),(4),(Face))
call SaveReal(L7,(OB7),(10),(dur*50))
call SaveBoolean(L7,(OB7),(11),(ISITEM))
call SaveUnitHandle(TABLE_HY,'CFMJ', GetHandleId(IH7), BB7)
set cbtx=LoadInteger(TABLE_Z, GetPlayerId(GetOwningPlayer(IH7)),0)
if cbtx!=0 then
call UnitRemoveAbility(IH7,cbtx)
endif
set t=null
set ZX7=null
set IH7=null
set BB7=null
set oA=null
endfunction
