function XPG takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local trigger t
local integer I97=GetHandleId(ZX7)
local integer X8G=(LoadInteger(L7,(I97),(746)))
local unit IGD
local boolean b=(GetPlayerController(GetOwningPlayer(ZX7))==MAP_CONTROL_COMPUTER)
if X8G>0 and((LoadInteger(L7,(GetHandleId((ZX7))),((4319))))==1)==false then
set t=CreateTrigger()
set I97=GetHandleId(t)
call SetUnitVertexColor(ZX7,$FF,0,0,75)
call SetUnitTimeScale(ZX7,2)
call SetUnitAnimationByIndex(ZX7,0)
call SetUnitPathing(ZX7,false)
call SetUnitInvulnerable(ZX7,true)
call XF7(ZX7,'A04R')
call SaveInteger(L7,(GetHandleId((ZX7))),((4319)),(1))
call TriggerRegisterTimerEvent(t,.02,true)
call TriggerAddCondition(t,Condition(function XMG))
call TriggerRegisterDeathEvent(t,ZX7)
call SaveEffectHandle(L7,(I97),($AF),(AddSpecialEffectTarget("war3mapImported\\Phoenix_Missile_smaller.mdx",ZX7,"hand right alternate")))
call SaveEffectHandle(L7,(I97),($B0),(AddSpecialEffectTarget("war3mapImported\\Phoenix_Missile_smaller.mdx",ZX7,"hand left alternate")))
call SaveEffectHandle(L7,(I97),($B1),(AddSpecialEffectTarget("war3mapImported\\FlameDash_Ground.mdx",ZX7,"origin")))
call SaveUnitHandle(L7,(I97),(2),(ZX7))
call SaveReal(L7,(I97),(47),((GetSpellTargetX())*1.))
call SaveReal(L7,(I97),(48),((GetSpellTargetY())*1.))
set IGD=XJG(ZX7,GetSpellTargetX(),GetSpellTargetY())
call SaveUnitHandle(L7,(I97),(19),(IGD))
call SaveReal(L7,(I97),(44),((XKG(ZX7,IGD))*1.))
call SaveReal(L7,(I97),(6),((GetUnitX(IGD))*1.))
call SaveReal(L7,(I97),(7),((GetUnitY(IGD))*1.))
call SaveInteger(L7,(I97),(34),(1))
call SaveBoolean(L7,(I97),(100),(b))
//else
//set t=CreateTrigger()
//set I97=GetHandleId(t)
//call TriggerRegisterTimerEvent(t,.0,false)
//call TriggerAddCondition(t,Condition(function XOG))
//call SaveUnitHandle(L7,(I97),(2),(ZX7))
//else
//set t=CreateTrigger()
//set I97=GetHandleId(t)
//call TriggerRegisterTimerEvent(t,.0,false)
//call TriggerAddCondition(t,Condition(function XOG))
//call SaveUnitHandle(L7,(I97),(2),(ZX7))
if GetUnitAbilityLevel(ZX7,'A2YX')==0 then
call XF7(ZX7,'A2YX')
endif
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A2JL',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A3JL',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A2YX',true)
endif
set t=null
set ZX7=null
set IGD=null
endfunction
//释放火之余烬
function XQG takes nothing returns boolean
local unit ZX7=GetTriggerUnit()
local integer skill=B287_GetSpellAbilityId()
if GetUnitAbilityLevel(ZX7,'A2JK')+GetUnitAbilityLevel(ZX7,'A3JK')>0 then
if skill==DZ7[0] or skill==DZ7[1] or skill==DZ7[2] or skill==DZ7[3] or skill==DZ7[4] or skill==DZ7[5] then
call XGG()
elseif skill=='A2JL' or skill=='A3JL' then
call XPG()
endif
endif
set ZX7=null
return false
endfunction
function XRG takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local integer N5E=(LoadInteger(L7,(GetHandleId(ZX7)),(747)))
local integer WF8=(LoadInteger(L7,(I97),(34)))
local integer n
if GetUnitAbilityLevel(ZX7,'A3JK')>0 then
set n=5
else
set n=3
endif
if N5E<n then
set WF8=WF8-1
call SaveInteger(L7,(I97),(34),(WF8))
if WF8==0 then
call UnitRemoveAbility(ZX7,DZ7[N5E])
if GetUnitAbilityLevel(ZX7,'A2VW')>0 then
set WF8=27
else
set WF8=35
endif
call SaveInteger(L7,(I97),(34),(WF8))
set N5E=N5E+1
call SaveInteger(L7,(GetHandleId(ZX7)),(747),(N5E))
call XF7(ZX7,DZ7[N5E])
endif
endif
set t=null
set ZX7=null
return false
endfunction
function XSG takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local trigger t=CreateTrigger()
local integer I97=GetHandleId(t)
if GetUnitAbilityLevel(ZX7,'A3JK')>0 then
call SaveInteger(L7,(GetHandleId(ZX7)),(747),(5))
call XF7(ZX7,DZ7[5])
else
call SaveInteger(L7,(GetHandleId(ZX7)),(747),(3))
call XF7(ZX7,DZ7[3])
endif
call TriggerRegisterTimerEvent(t,1,true)
call TriggerAddCondition(t,Condition(function XRG))
call SaveUnitHandle(L7,(I97),(2),(ZX7))
call SaveInteger(L7,(I97),(34),(30))
set ZX7=null
set t=null
endfunction
//学习火之余烬
function XTG takes nothing returns boolean
if (B287_GetLearnedSkill()=='A2JK') and IsUnitIllusion(GetTriggerUnit())==false then
call XF7(GetTriggerUnit(),'A2JL')
call SetUnitAbilityLevel(GetTriggerUnit(),'A2JL',GetUnitAbilityLevel(GetTriggerUnit(),'A2JK'))
endif
if (B287_GetLearnedSkill()=='A3JK') and IsUnitIllusion(GetTriggerUnit())==false then
call XF7(GetTriggerUnit(),'A3JL')
call SetUnitAbilityLevel(GetTriggerUnit(),'A3JL',GetUnitAbilityLevel(GetTriggerUnit(),'A3JK'))
endif
if ((B287_GetLearnedSkill()=='A2JK' and GetUnitAbilityLevel(GetTriggerUnit(),'A2JK')==1) or (B287_GetLearnedSkill()=='A3JK' and GetUnitAbilityLevel(GetTriggerUnit(),'A3JK')==1)) and IsUnitIllusion(GetTriggerUnit())==false then
call XSG()
call W5G()
call SetPlayerAbilityAvailable(GetOwningPlayer(GetTriggerUnit()),'A2JL',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(GetTriggerUnit()),'A3JL',false)
call XF7(GetTriggerUnit(),'A2YX')
call SetPlayerAbilityAvailable(GetOwningPlayer(GetTriggerUnit()),'A2YX',true)
endif
return false
endfunction
