call SetUnitX(ZX7,x)
call SetUnitY(ZX7,y)
// call SetUnitScale(ZX7,0,0,0)
call SetUnitFacing(BALL,a*bj_RADTODEG-$B4)
call SetUnitScale(BALL,VWE,VWE,VWE)
set XT4=x
set XU4=y
call ForGroup((LoadGroupHandle(L7,(OB7),(22))),function ATB5)
if KF7(x,y,Y_7,Z47)<r*2 or WF8==150 then
    call Y67(x,y,300)
    set g=WS7()
    call GroupEnumUnitsInRange(g,x,y,UVG,Condition(function AJ7_gai))
    call ForGroup(g,function ATA5)
    call WR7(g)
    set g=null
    set XT4=x
    set XU4=y
    call ForGroup((LoadGroupHandle(L7,(OB7),(22))),function AT95)
    call WR7((LoadGroupHandle(L7,(OB7),(22))))
    call WR7(UGG)
    call KillUnit(BALL)
    call NM7(OB7)
    call OZ7(t)
    call SetUnitInvulnerable(ZX7,false)
    call UnitRemoveAbility(ZX7,'Abun')
    // call UnitRemoveAbility(ZX7,'A04R')
    call OX7(ZX7,"HideUnit")
    // call SetUnitScale(ZX7,XX7(ZX7),XX7(ZX7),XX7(ZX7))
    call UnitCancelHide(ZX7)
    if IsUnitSelected(ZX7,GetOwningPlayer(ZX7)) then
        call SelectUnitForPlayerSingle(ZX7,GetOwningPlayer(ZX7))
    endif
else
    if ModuloInteger(GetTriggerEvalCount(t),5)==0 then
        call Y67(x,y,300)
        set g=WS7()
        call GroupEnumUnitsInRange(g,x,y,UVG,Condition(function AJ7_gai))
        call ForGroup(g,function ATA5)
        call WR7(g)
        set g=null
    endif
endif
set t=null
set ZX7=null
set IH7=null
set BALL=null
set UGG=null
return false
endfunction
function ATE5 takes unit ZX7,group g,unit u returns nothing
if IsUnitInGroup(u,g)==false then
call GroupAddUnit(g,u)
call DestroyEffect(AddSpecialEffect("war3mapImported\\ChainFreeze_F6.mdx",GetUnitX(u),GetUnitY(u)))
call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\FrostWyrmMissile\\FrostWyrmMissile.mdl",GetUnitX(u),GetUnitY(u)))
if ZX7!=u then
call SetUnitX(u,GetUnitX(ZX7))
call SetUnitY(u,GetUnitY(ZX7))
// call SetUnitScale(u,0,0,0)
call OV7(u,"HideUnit")
// call ImprisonedUnit(u,true)
call UnitEnterHide(u)
call SetUnitInvulnerable(u,true)
call PauseUnitEx(u,true)
endif
if ZX7!=u then
set XW4=XW4+1
endif
endif
endfunction
function ATG5 takes nothing returns nothing
call ATE5(XP4,IQ4,GetEnumUnit())
endfunction
function ATH5 takes nothing returns boolean
return ((IsUnitType(GetFilterUnit(),UNIT_TYPE_HERO) and IsHideUnit(GetFilterUnit())==false and OO7(GetHandleId(GetOwningPlayer(GetFilterUnit())),"DisableHelp")==false and IsUnitEnemy(IN4,GetOwningPlayer(GetFilterUnit()))==false and (GetUnitAbilityLevel(GetFilterUnit(),'A04R')==0 and IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==false and XH7(GetFilterUnit())==false) and IsUnitType(GetFilterUnit(),UNIT_TYPE_ANCIENT)==false or Z_7(GetFilterUnit())) or (GetOwningPlayer(GetFilterUnit())==GetOwningPlayer(IN4) and (GetUnitAbilityLevel(GetFilterUnit(),'A04R')==0 and IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==false and XH7(GetFilterUnit())==false) and IsUnitType(GetFilterUnit(),UNIT_TYPE_ANCIENT)==false or Z_7(GetFilterUnit())) and LoadBoolean(L7,GetHandleId(GetOwningPlayer(GetFilterUnit())),139)==false or XP4==GetFilterUnit())!=null
endfunction
function ATZ5 takes unit ZX7,unit IH7,integer ATD5,group g2,unit BALL returns nothing
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local real AQXI=GetUnitX(ZX7)
local real AQYI=GetUnitY(ZX7)
local real AQJI=GetUnitX(IH7)
local real AQKI=GetUnitY(IH7)
local real a=J77(AQXI,AQYI,AQJI,AQKI)*bj_DEGTORAD
set XV4=650+XW4*100
set XW4=ATD5
set XP4=ZX7
call SetUnitTimeScale(BALL,2)
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A1S7',true)
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A4HF',false)
call TriggerRegisterTimerEvent(t,.02,true)
call TriggerRegisterUnitEvent(t,ZX7,EVENT_UNIT_ISSUED_POINT_ORDER)
call TriggerAddCondition(t,Condition(function ATC5))
call SaveUnitHandle(L7,(OB7),(2),(ZX7))
call SaveUnitHandle(L7,(OB7),(17),(IH7))
call SaveUnitHandle(L7,(OB7),(19),(XR4))
call SaveUnitHandle(L7,(OB7),(45),(BALL))
call SaveReal(L7,(OB7),(137),((a)*1.))
call SaveReal(L7,(OB7),(671),((XV4*.02)*1.))
call SaveReal(L7,(OB7),(47),((AQJI)*1.))
call SaveReal(L7,(OB7),(48),((AQKI)*1.))
call SaveInteger(L7,(OB7),(34),(ATD5))
call SaveGroupHandle(L7,(OB7),(22),(g2))
call SaveGroupHandle(L7,(OB7),(133),(WS7()))
set t=null
endfunction
function ATV5 takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(OB7),(2)))
local unit IH7=(LoadUnitHandle(L7,(OB7),(17)))
local unit BALL=(LoadUnitHandle(L7,(OB7),(45)))
local boolean b=(LoadBoolean(L7,(OB7),(66)))
local real x=(LoadReal(L7,(OB7),(6)))
local real y=(LoadReal(L7,(OB7),(7)))
local group g
local integer WF8=(LoadInteger(L7,(OB7),(34)))
local unit u
call SetUnitX(ZX7,x)
call SetUnitY(ZX7,y)
// call SetUnitScale(ZX7,0,0,0)
// call UnitEnterHide(ZX7)
// call SetUnitScale(ZX7,0,0,0)
// call UnitEnterHide(ZX7)
// call SetUnitScale(ZX7,0,0,0)
// call UnitEnterHide(ZX7)
set XS4=GetUnitAbilityLevel(ZX7,'A1S7')
set IN4=ZX7
set XP4=ZX7
set XQ4=IH7
set XR4=(LoadUnitHandle(L7,(OB7),(19)))
if GetTriggerEventId()==EVENT_UNIT_ISSUED_TARGET_ORDER then
if GetIssuedOrderId()==851971 then
set u=GetOrderTargetUnit()
if KE7(ZX7,u)<425 and IsUnitAlly(u,GetOwningPlayer(ZX7))==true and IsHideUnit(u)==false and IsUnitType(u,UNIT_TYPE_HERO)==true or (GetOwningPlayer(u)==GetOwningPlayer(ZX7) and GetUnitAbilityLevel(u,'A04R')==0) then
    if OO7(GetHandleId(GetOwningPlayer(u)),"DisableHelp") then
call X37(GetOwningPlayer(ZX7),GetObjectName('n038'))
    else
        call ATE5(ZX7,(LoadGroupHandle(L7,(OB7),(22))),u)
    endif
endif
endif
elseif GetTriggerEventId()==EVENT_UNIT_ISSUED_POINT_ORDER then
    if GetIssuedOrderId()>= 852008 and GetIssuedOrderId()<= 852013 and Is_Use_TD(ZX7,GetIssuedOrderId()) then
        // call EXStopUnit(ZX7)
        call KR7(ZX7)
    endif
elseif GetTriggerEventId()==EVENT_UNIT_SPELL_EFFECT then
if B287_GetSpellAbilityId()=='A4HF' then
call ATZ5(ZX7,IH7,XW4,LoadGroupHandle(L7,(OB7),(22)),BALL)
call FlushChildHashtable(L7,(OB7))
call OZ7(t)
endif
else
set WF8=WF8+1
call SaveInteger(L7,(OB7),(34),(WF8))
if WF8==200 or (WF8==50 and b) then
    call ATZ5(ZX7,IH7,XW4,LoadGroupHandle(L7,(OB7),(22)),BALL)
    call FlushChildHashtable(L7,(OB7))
    call OZ7(t)
endif
if WF8==10 and b then
    call IssuePointOrderById(ZX7,$D02AC,GetUnitX(IH7),GetUnitY(IH7))
elseif WF8==25 and b then
    call IssueImmediateOrderById(ZX7,$D022E)
endif
endif
set t=null
set ZX7=null
set BALL=null
set g=null
return false
endfunction
function ATW5 takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local unit IH7=GetSpellTargetUnit()
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local unit BALL=CreateUnit(GetOwningPlayer(ZX7),'h0C3',GetUnitX(ZX7),GetUnitY(ZX7),AngleBetweenUnit(ZX7,IH7))
local unit BB7=CreateUnit(GetOwningPlayer(ZX7),'e00E',GetUnitX(ZX7),GetUnitY(ZX7),0)
local group g=WS7()
local group g2=WS7()
local boolean b=false
local real range=150
if GetPlayerController(GetOwningPlayer(ZX7))==MAP_CONTROL_COMPUTER then
set b=true
set range=250
endif
set XV4=0
set XW4=0
set XP4=ZX7
set XQ4=IH7
set IQ4=g2
set IN4=ZX7
call GroupEnumUnitsInRange(g,GetUnitX(ZX7),GetUnitY(ZX7),range,Condition(function ATH5))
call ForGroup(g,function ATG5)
call WR7(g)
call XF7(BB7,'A0X6')
call SetUnitInvulnerable(ZX7,true)
call XF7(ZX7,'Abun')
// call XF7(ZX7,'A04R')
call OV7(ZX7,"HideUnit")
// call SetUnitScale(ZX7,0,0,0)
call UnitEnterHide(ZX7)
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A1S7',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A4HF',true)
call XF7(ZX7,'A4HF')
call SetUnitTimeScale(BALL,2)
call TriggerRegisterTimerEvent(t,.02,true)
call TriggerRegisterUnitEvent(t,ZX7,EVENT_UNIT_ISSUED_TARGET_ORDER)
call TriggerRegisterUnitEvent(t,ZX7,EVENT_UNIT_ISSUED_POINT_ORDER)
call TriggerRegisterUnitEvent(t,ZX7,EVENT_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function ATV5))
call SaveUnitHandle(L7,(OB7),(2),(ZX7))
call SaveUnitHandle(L7,(OB7),(17),(IH7))
call SaveUnitHandle(L7,(OB7),(19),(BB7))
call SaveUnitHandle(L7,(OB7),(45),(BALL))
call SaveBoolean(L7,(OB7),(66),(b))
call SaveReal(L7,(OB7),(6),((GetUnitX(ZX7))*1.))
call SaveReal(L7,(OB7),(7),((GetUnitY(ZX7))*1.))
call SaveGroupHandle(L7,(OB7),(22),(g2))
set t=null
set ZX7=null
set IH7=null
set BALL=null
set BB7=null
set g=null
set g2=null
endfunction
