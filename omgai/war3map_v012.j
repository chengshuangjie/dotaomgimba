function NLZY2 takes nothing returns nothing
	local trigger t = GetTriggeringTrigger()
	local integer h = GetHandleId(t)
    local integer id
	local unit IH7
	local unit ZX7
	if GetTriggerEventId()== EVENT_WIDGET_DEATH then
		set ZX7 = LoadUnitHandle(TABLE_HY, h, 0)
		set IH7 = LoadUnitHandle(TABLE_HY, h, 1)
        set id=GetPlayerId(GetOwningPlayer(ZX7))
		call UnitRemoveAbility(IH7,'A4B1')
		call UnitRemoveAbility(IH7,'B0IH')
		if IsUnitInRange(ZX7,IH7,300) then
            set XYSR[id]=XYSR[id]+1
            call ModifyHeroStat(1,ZX7,bj_MODIFYMETHOD_ADD,R2I(I2R(XYSR[id])*0.5-XYMJ[id])) 
			set XYMJ[id]=R2I(XYSR[id]*0.5)
			call YW7("+0.5 敏捷",3,ZX7,.023,0,$FF,0,$E6)
		endif
		call FlushChildHashtable(TABLE_HY, h)
		call OZ7(t)
		call RemoveSavedHandle(TABLE_HY, GetHandleId(IH7),'NLZY'+ GetPlayerId(GetOwningPlayer(ZX7)))
		call RemoveSavedBoolean(TABLE_HY, GetHandleId(IH7),'NLZY'+ GetPlayerId(GetOwningPlayer(ZX7)))
	else
		set ZX7 = LoadUnitHandle(TABLE_HY, h, 0)
		set IH7 = LoadUnitHandle(TABLE_HY, h, 1)
		if LoadBoolean(TABLE_HY, h, 2) then
			call SaveBoolean(TABLE_HY, h, 2, false)
		elseif GetGameTime()> LoadReal(TABLE_HY, h, 0) then
			call UnitRemoveAbility(IH7,'A4B1')
			call UnitRemoveAbility(IH7,'B0IH')
			call FlushChildHashtable(TABLE_HY, h)
			call OZ7(t)
			call RemoveSavedHandle(TABLE_HY, GetHandleId(IH7),'NLZY'+ GetPlayerId(GetOwningPlayer(ZX7)))
			call RemoveSavedBoolean(TABLE_HY, GetHandleId(IH7),'NLZY'+ GetPlayerId(GetOwningPlayer(ZX7)))
		endif
	endif
	set t = null
	set ZX7 = null
	set IH7 = null
endfunction
function NLZY takes unit ZX7, unit IH7 returns nothing
	local trigger t
	local integer h
	local integer ht = GetHandleId(IH7)
	local integer TME = GetPlayerId(GetOwningPlayer(ZX7))
	local integer level = B287_GetUnitAbilityLevel(ZX7,'A1HR')
	local real d
	if level==1 then
		set d=15
	elseif level==2 then
		set d=30
	elseif level==3 then
		set d=60
	elseif level==4 then
		set d=120
	endif
	if LoadBoolean(TABLE_HY, ht,'NLZY'+ TME)== false then
		set t = CreateTrigger()
		set h = GetHandleId(t)
		call TriggerRegisterDeathEvent(t, IH7)
		call TriggerRegisterTimerEvent(t, 1, true)
		call TriggerAddCondition(t, Condition(function NLZY2))
		call SaveBoolean(TABLE_HY, ht,'NLZY'+ TME, true)
		call SaveTriggerHandle(TABLE_HY, ht,'NLZY'+ TME, t)
		call SaveBoolean(TABLE_HY, h, 2, true)
		call SaveUnitHandle(TABLE_HY, h, 1, IH7)
		call TriggerRegisterTimerEvent(t, 0, false)
		call XF7(IH7,'A4B1')
	else
		set t = LoadTriggerHandle(TABLE_HY, ht,'NLZY'+ TME)
		set h = GetHandleId(t)
		call SaveBoolean(TABLE_HY, h, 2, true)
		call TriggerRegisterTimerEvent(t, 0, false)
	endif
		call SaveUnitHandle(TABLE_HY, h, 0, ZX7)
		call SaveReal(TABLE_HY, h, 0, GetGameTime()+ d)
	set t = null
endfunction
function CJA takes nothing returns boolean
	local trigger t = GetTriggeringTrigger()
	local integer h = GetHandleId(t)
	local unit ZX7 = LoadUnitHandle(TABLE_HY, h, 2)
	local unit IH7 = LoadUnitHandle(TABLE_HY, h, 17)
	local integer E5X = LoadInteger(TABLE_HY, h, 422)
	local integer E6X = LoadInteger(TABLE_HY, h, 423)
	local integer E4X = LoadInteger(TABLE_HY, h, 424)
	if GetTriggerEventId()== EVENT_WIDGET_DEATH then
		if(LoadBoolean(TABLE_HY, h, 276))== false and GetTriggerUnit()== ZX7 then
			call SaveBoolean(TABLE_HY, h, 276,(true))
			call SetHeroAgi(ZX7, GetHeroAgi(ZX7, false)-E5X -E6X -E4X, true)
			call SaveInteger(TABLE_K, GetHandleId(ZX7), 31, LoadInteger(TABLE_K, GetHandleId(ZX7), 31)-E5X -E6X -E4X)
		elseif(LoadBoolean(TABLE_HY, h, 277))== false and GetTriggerUnit()== IH7 then
			call SaveBoolean(TABLE_HY, h, 277,(true))
			call SetHeroAgi(IH7, GetHeroAgi(IH7, false)+ E5X, true)
			call SetHeroStr(IH7, GetHeroStr(IH7, false)+ E6X, true)
			call SetHeroInt(IH7, GetHeroInt(IH7, false)+ E4X, true)
		endif
	else
		if(LoadBoolean(TABLE_HY, h, 276))== false then
			call SaveBoolean(TABLE_HY, h, 276,(true))
			call SetHeroAgi(ZX7, GetHeroAgi(ZX7, false)-E5X -E6X -E4X, true)
			call SaveInteger(TABLE_K, GetHandleId(ZX7), 31, LoadInteger(TABLE_K, GetHandleId(ZX7), 31)-E5X -E6X -E4X)
		endif
		if(LoadBoolean(TABLE_HY, h, 277))== false then
			call SaveBoolean(TABLE_HY, h, 277,(true))
			call SetHeroAgi(IH7, GetHeroAgi(IH7, false)+ E5X, true)
			call SetHeroStr(IH7, GetHeroStr(IH7, false)+ E6X, true)
			call SetHeroInt(IH7, GetHeroInt(IH7, false)+ E4X, true)
		endif
		call FlushChildHashtable(TABLE_HY, h)
		call OZ7(t)
	endif
	set t = null
	set ZX7 = null
	set IH7 = null
	return false
endfunction
function CKA takes unit u, unit IH7 returns nothing
	local trigger t
	local integer h
	local integer agi
	local integer str
	local integer int
	local integer TME = GetPlayerId(GetOwningPlayer(u))
	local integer level=B287_GetUnitAbilityLevel(u,'A1HR')
	local real d
	local integer id=GetUnitTypeId(u)
	if level==1 then
	set d=15
	elseif level==2 then
	set d=30
	elseif level==3 then
	set d=60
	elseif level==4 then
	set d=120
	endif
	set agi = IMinBJ(GetHeroAgi(IH7, false)-1, 1)
	set str = IMinBJ(GetHeroStr(IH7, false)-1, 1)
	set int = IMinBJ(GetHeroInt(IH7, false)-1, 1)
	set t = CreateTrigger()
	set h = GetHandleId(t)
	call SetHeroAgi(u, GetHeroAgi(u, false)+ agi + str + int, true)
	call SaveInteger(TABLE_K, GetHandleId(u), 31, LoadInteger(TABLE_K, GetHandleId(u), 31)+ agi + str + int)
	call SetHeroAgi(IH7, GetHeroAgi(IH7, false)-agi, true)
	call SetHeroStr(IH7, GetHeroStr(IH7, false)-str, true)
	call SetHeroInt(IH7, GetHeroInt(IH7, false)-int, true)
	call SaveInteger(TABLE_HY, h, 422, agi)
	call SaveInteger(TABLE_HY, h, 424, str)
	call SaveInteger(TABLE_HY, h, 423, int)
	call SaveUnitHandle(TABLE_HY, h, 2, u)
	call SaveUnitHandle(TABLE_HY, h, 17, IH7)
	call SaveBoolean(TABLE_HY, h, 276, false)
	call SaveBoolean(TABLE_HY, h, 277, false)
	call TriggerRegisterTimerEvent(t, d , false)
	call TriggerRegisterDeathEvent(t, u)
	call TriggerRegisterDeathEvent(t, IH7)
	call TriggerAddCondition(t, Condition(function CJA))
	if id=='Z071' then
		call DestroyEffect(AddSpecialEffectTarget("model\\Hero_MurlocNightcrawler_N6S_N_Target.mdl",IH7,"overhead"))
	endif
	set t = null
endfunction
function CLA takes nothing returns boolean
	local trigger t = GetTriggeringTrigger()
	local integer h = GetHandleId(t)
	local unit u = LoadUnitHandle(TABLE_HY, h, 2)
	local unit target = LoadUnitHandle(TABLE_HY, h, 17)
	if GetTriggerEventId()!= EVENT_WIDGET_DEATH then
		call CKA(u, target)
	endif
	call FlushChildHashtable(TABLE_HY, h)
	call OZ7(t)
	set t = null
	set target = null
	return false
endfunction
function CMA takes unit u, unit target returns nothing
	local trigger t = CreateTrigger()
	local integer h = GetHandleId(t)
	call TriggerRegisterTimerEvent(t, .01, false)
	call TriggerAddCondition(t, Condition(function CLA))
	call TriggerRegisterDeathEvent(t, u)
	call TriggerRegisterDeathEvent(t, target)
	call SaveUnitHandle(TABLE_HY, h, 2, u)
	call SaveUnitHandle(TABLE_HY, h, 17, target)
	set t = null
endfunction
//能量转移
function STA takes nothing returns nothing
	if ISPH(WXX)==false and (B287_GetUnitAbilityLevel(WXX,'A1HR')> 0) and IsUnitType(YXX, UNIT_TYPE_HERO) then
		call CMA(WXX, YXX)
		call NLZY(WXX, YXX)
	endif
endfunction



