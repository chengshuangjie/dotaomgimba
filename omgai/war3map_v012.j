// local integer OB7=GetHandleId(u)
// if GetUnitAbilityLevel(u,'Aloc')==0 and GetOwningPlayer(u)!=Player($F)then
// call TriggerRegisterUnitEvent(JJe,u,EVENT_UNIT_DAMAGED)
// endif
// set u=null
// return false
