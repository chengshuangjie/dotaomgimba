call TriggerAddCondition(t,Condition(function I_D))
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_CAST)
call TriggerAddCondition(t,Condition(function J4D))
set t=null
endfunction
