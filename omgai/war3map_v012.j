function SuijiMode_ClearScriptedSpiritFormButtons takes unit u returns nothing
if u==null then
return
endif
call UnitRemoveAbility(u,'A11X')
call UnitRemoveAbility(u,'A10U')
call UnitRemoveAbility(u,'A11V')
call UnitRemoveAbility(u,'A11Y')
call UnitRemoveAbility(u,'A11W')
call UnitRemoveAbility(u,'A11Z')
endfunction
function SuijiMode_UpdateScriptedSpiritForm takes unit u returns nothing
local integer h=0
local integer logicalSkill=0
local integer level=0
local integer firstSkill=0
local integer secondSkill=0
if u==null or GetUnitTypeId(u)==0 then
return
endif
set h=GetHandleId(u)
if OO7(h,"SuijiScriptedSpiritForm")==false then
return
endif
set logicalSkill=OM7(h,"SuijiScriptedSpiritSkill")
set level=B287_GetUnitAbilityLevel(u,logicalSkill)
if level<1 then
set level=1
elseif level>3 then
set level=3
endif
if level==OM7(h,"SuijiScriptedSpiritLevel") then
return
endif
call NP7(h,"SuijiScriptedSpiritLevel",level)
call SuijiMode_ClearScriptedSpiritFormButtons(u)
if level==1 then
set firstSkill='A11X'
set secondSkill='A10U'
elseif level==2 then
set firstSkill='A11V'
set secondSkill='A11Y'
else
set firstSkill='A11W'
set secondSkill='A11Z'
endif
call XF7(u,firstSkill)
call UnitMakeAbilityPermanent(u,true,firstSkill)
call XF7(u,secondSkill)
call UnitMakeAbilityPermanent(u,true,secondSkill)
call SuijiMode_MarkUnitVisibilityDirty(u)
endfunction
function SuijiMode_RestoreScriptedSpiritForm takes unit u returns nothing
local integer h=0
local effect fx=null
if u==null then
return
endif
set h=GetHandleId(u)
if OO7(h,"SuijiScriptedSpiritForm")==false then
return
endif
call SuijiMode_ClearScriptedSpiritFormButtons(u)
call UnitRemoveAbility(u,'ZKOS')
set fx=LoadEffectHandle(L7,h,StringHash("SuijiScriptedSpiritEffect"))
if fx!=null then
call DestroyEffect(fx)
call RemoveSavedHandle(L7,h,StringHash("SuijiScriptedSpiritEffect"))
endif
call NS7(h,"SuijiScriptedSpiritForm",false)
call NP7(h,"SuijiScriptedSpiritLevel",0)
if GetUnitTypeId(u)!=0 then
call SuijiMode_MarkUnitVisibilityDirty(u)
endif
set fx=null
endfunction
function SuijiMode_ScriptedSpiritFormTick takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer timerHandle=GetHandleId(t)
local unit u=LoadUnitHandle(L7,timerHandle,0)
local integer serial=LoadInteger(L7,timerHandle,1)
local integer h=0
if u==null or GetUnitTypeId(u)==0 then
call FlushChildHashtable(L7,timerHandle)
call PauseTimer(t)
call DestroyTimer(t)
set u=null
set t=null
return
endif
set h=GetHandleId(u)
if serial!=OM7(h,"SuijiScriptedSpiritSerial") then
call FlushChildHashtable(L7,timerHandle)
call PauseTimer(t)
call DestroyTimer(t)
set u=null
set t=null
return
endif
if UnitAlive(u)==false or TimerGetElapsed(W)>=LoadReal(L7,timerHandle,2) then
call SuijiMode_RestoreScriptedSpiritForm(u)
call FlushChildHashtable(L7,timerHandle)
call PauseTimer(t)
call DestroyTimer(t)
else
call SuijiMode_UpdateScriptedSpiritForm(u)
endif
set u=null
set t=null
endfunction
function SuijiMode_StartScriptedSpiritForm takes unit u,integer physicalSkill returns nothing
local integer h=0
local integer logicalSkill='A11T'
local integer level=0
local integer count=1
local integer serial=0
local real duration=30.
local timer t=null
local effect fx=null
if u==null or GetUnitTypeId(u)==0 then
return
endif
set h=GetHandleId(u)
if OO7(h,"SuijiScriptedSpiritForm") then
call SuijiMode_RestoreScriptedSpiritForm(u)
endif
if physicalSkill=='Y0FL' then
set logicalSkill='A4AS'
endif
set level=B287_GetUnitAbilityLevel(u,logicalSkill)
if level<1 then
return
elseif level>3 then
set level=3
endif
if level>=3 then
set duration=99999.
elseif logicalSkill=='A4AS' or level==2 then
set duration=40.
endif
set count=SuijiMode_GetDurationMulticastCount(u,logicalSkill)
if count>1 and duration<1000. then
set duration=duration*count
endif
set serial=OM7(h,"SuijiScriptedSpiritSerial")+1
call NP7(h,"SuijiScriptedSpiritSerial",serial)
call NP7(h,"SuijiScriptedSpiritSkill",logicalSkill)
call NP7(h,"SuijiScriptedSpiritLevel",0)
call NS7(h,"SuijiScriptedSpiritForm",true)
call XF7(u,'ZKOS')
call UnitMakeAbilityPermanent(u,true,'ZKOS')
set fx=AddSpecialEffectTarget("Abilities\\Spells\\Human\\InnerFire\\InnerFireTarget.mdl",u,"overhead")
call SaveEffectHandle(L7,h,StringHash("SuijiScriptedSpiritEffect"),fx)
call SuijiMode_UpdateScriptedSpiritForm(u)
set t=CreateTimer()
call SaveUnitHandle(L7,GetHandleId(t),0,u)
call SaveInteger(L7,GetHandleId(t),1,serial)
call SaveReal(L7,GetHandleId(t),2,TimerGetElapsed(W)+duration)
call TimerStart(t,.25,true,function SuijiMode_ScriptedSpiritFormTick)
set fx=null
set t=null
endfunction
function SuijiMode_ChemicalRageCompatRestore takes unit u returns nothing
local integer h=0
local effect fx=null
if u==null then
return
endif
set h=GetHandleId(u)
if OO7(h,"SuijiChemicalRageActive")==false then
return
endif
if GetUnitTypeId(u)!=0 then
call SetUnitState(u,UNIT_STATE_ATTACK1_COOL,ON7(h,"SuijiChemicalRageBaseAttack"))
call MHUnit_SetData(u,UNIT_DATA_LIFE_REGEN,ON7(h,"SuijiChemicalRageBaseLifeRegen"))
call MHUnit_SetData(u,UNIT_DATA_MANA_REGEN,ON7(h,"SuijiChemicalRageBaseManaRegen"))
call UnitRemoveAbility(u,'ZCRG')
endif
set fx=LoadEffectHandle(L7,h,StringHash("SuijiChemicalRageEffect"))
if fx!=null then
call DestroyEffect(fx)
call RemoveSavedHandle(L7,h,StringHash("SuijiChemicalRageEffect"))
endif
call NS7(h,"SuijiChemicalRageActive",false)
set fx=null
endfunction
function SuijiMode_ChemicalRageCompatApply takes unit u returns nothing
local integer h=0
local integer level=0
local integer currentType=0
local real attackCooldown=1.4
local real lifeRegen=10.
local real manaRegen=15.
if u==null or GetUnitTypeId(u)==0 then
return
endif
set h=GetHandleId(u)
if OO7(h,"SuijiChemicalRageActive")==false then
return
endif
set level=OM7(h,"SuijiChemicalRageLevel")
if level<1 then
set level=1
elseif level>3 then
set level=3
endif
if level==2 then
set attackCooldown=1.2
set lifeRegen=20.
set manaRegen=25.
elseif level>=3 then
set attackCooldown=1.
set lifeRegen=30.
set manaRegen=35.
endif
set currentType=GetUnitTypeId(u)
if currentType!=OM7(h,"SuijiChemicalRageUnitType") then
call NP7(h,"SuijiChemicalRageUnitType",currentType)
call NQ7(h,"SuijiChemicalRageBaseAttack",GetUnitState(u,UNIT_STATE_ATTACK1_COOL))
call NQ7(h,"SuijiChemicalRageBaseLifeRegen",MHUnit_GetData(u,UNIT_DATA_LIFE_REGEN))
call NQ7(h,"SuijiChemicalRageBaseManaRegen",MHUnit_GetData(u,UNIT_DATA_MANA_REGEN))
endif
if GetUnitAbilityLevel(u,'ZCRG')==0 then
call UnitAddAbility(u,'ZCRG')
call UnitMakeAbilityPermanent(u,true,'ZCRG')
endif
if GetUnitAbilityLevel(u,'ZCRG')!=level then
call SetUnitAbilityLevel(u,'ZCRG',level)
endif
call SetUnitState(u,UNIT_STATE_ATTACK1_COOL,attackCooldown)
call MHUnit_SetData(u,UNIT_DATA_LIFE_REGEN,ON7(h,"SuijiChemicalRageBaseLifeRegen")+lifeRegen)
call MHUnit_SetData(u,UNIT_DATA_MANA_REGEN,ON7(h,"SuijiChemicalRageBaseManaRegen")+manaRegen)
endfunction
function SuijiMode_ChemicalRageCompatTick takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer timerHandle=GetHandleId(t)
local unit u=LoadUnitHandle(L7,timerHandle,0)
local integer serial=LoadInteger(L7,timerHandle,1)
local integer unitHandle=0
if u==null or GetUnitTypeId(u)==0 then
call FlushChildHashtable(L7,timerHandle)
call PauseTimer(t)
call DestroyTimer(t)
set u=null
set t=null
return
endif
set unitHandle=GetHandleId(u)
if serial!=OM7(unitHandle,"SuijiChemicalRageSerial") then
call FlushChildHashtable(L7,timerHandle)
call PauseTimer(t)
call DestroyTimer(t)
set u=null
set t=null
return
endif
if UnitAlive(u)==false or TimerGetElapsed(W)>=ON7(unitHandle,"SuijiChemicalRageEnd") then
call SuijiMode_ChemicalRageCompatRestore(u)
call FlushChildHashtable(L7,timerHandle)
call PauseTimer(t)
call DestroyTimer(t)
else
call SuijiMode_ChemicalRageCompatApply(u)
endif
set u=null
set t=null
endfunction
