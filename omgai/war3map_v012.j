endif
set suijiPitMaliceLevel=B287_GetUnitAbilityLevel(ZS4,'A0RA')
if suijiPitMaliceLevel<1 then
set suijiPitMaliceLevel=1
endif
if IsUnitInGroup(GetEnumUnit(),IQ4)==false then
call GroupAddUnit(IQ4,GetEnumUnit())
if SUIJI_MODE and ZS4!=null and OO7(GetHandleId(ZS4),"SuijiDone") then
set suijiPitMaliceDummyOwner=GetOwningPlayer(ZS4)
