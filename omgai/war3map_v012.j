call XB(WXX,YXX)
endif
endfunction
function SQD takes nothing returns boolean
local timer t=GetExpiredTimer()
local integer OB7=GetHandleId(t)
local unit p5=O77(OB7,"Source")
local unit m5=O77(OB7,"Target")
local real x=ON7(OB7,"TargetX")
local real y=ON7(OB7,"TargetY")
local group g=WS7()
local unit u
local integer BC7=OM7(OB7,"Level")
call OX7(m5,"AstralImprisonmentState")
call DestroyEffect(OG7(OB7,"FX"))
// call SetUnitInvulnerable(m5,false)
// call PauseUnit(m5,false)
// call ShowUnit(m5,true)
// call SetUnitX(m5,x)
// call SetUnitY(m5,y)
// call ClearSelectionForPlayer(GetOwningPlayer(m5))
// call SelectUnitAddForPlayer(m5,GetOwningPlayer(m5))
//防止对自己重复释放两次
// if p5==m5 and B287_GetUnitAbilityLevel(p5,'A0OJ')==0 then
// call IssueImmediateOrder(m5,"stop")
// endif
// call SetUnitInvulnerable(m5,false)
// call PauseUnit(m5,false)
// call ShowUnit(m5,true)
// call SetUnitX(m5,x)
// call SetUnitY(m5,y)
// call ClearSelectionForPlayer(GetOwningPlayer(m5))
// call SelectUnitAddForPlayer(m5,GetOwningPlayer(m5))
//防止对自己重复释放两次
// if p5==m5 and B287_GetUnitAbilityLevel(p5,'A0OJ')==0 then
// call IssueImmediateOrder(m5,"stop")
// endif
call OX7(m5,"HideUnit")
// call ImprisonedUnit(m5,false)
call UnitCancelHide(m5)
call SetUnitInvulnerable(m5 , false)
call PauseUnitEx(m5, false)
if IsUnitSelected(m5,GetOwningPlayer(m5)) then
    call SelectUnitForPlayerSingle(m5,GetOwningPlayer(m5))
endif
set IN4=p5
call GroupEnumUnitsInRange(g,GetUnitX(m5),GetUnitY(m5),425,Condition(function AJ7_gai))
loop
set u=FirstOfGroup(g)
exitwhen u==null
call B67(p5,u,1,75*BC7+25)
call GroupRemoveUnit(g,u)
endloop
call LINGXIA(p5,m5)
call WR7(g)
call NN7(GetHandleId(p5),"748")
call NM7(OB7)
call PauseTimer(t)
call DestroyTimer(t)
set t=null
set p5=null
set m5=null
set g=null
return false
endfunction
function SRD takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local integer OB7=0
local integer BC7=0
local unit IH7=GetSpellTargetUnit()
local real x=0.
local real y=0.
local integer id=0
local timer t
local integer I97
local unit BB7
local integer N5E=0
local real WF8
local integer skill=0
if ZX7==null or IH7==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 then
set ZX7=null
set IH7=null
return
endif
set OB7=Get_Multiple_Skill_Key(ZX7,'A4A1')
set BC7=GetUnitAbilityLevel(ZX7,'A4A1')+GetUnitAbilityLevel(ZX7,'A4A2')+Labike_Multiple_Skill_Level(ZX7,'A4A1')
set x=GetUnitX(IH7)
set y=GetUnitY(IH7)
set id=GetUnitTypeId(ZX7)
set N5E=(LoadInteger(MSK,(OB7),(30)))
set skill=(LoadInteger(MSK,(OB7),(N5E)))
if N5E>0 then
    if IsUnitEnemy(IH7, GetOwningPlayer(ZX7)) and WQ7(IH7) then
        call PLK(IH7)
    else
set BB7=CreateUnit(GetOwningPlayer(ZX7),'o019',GetUnitX(IH7),GetUnitY(IH7),0)
call UnitApplyTimedLife(BB7,'BTLF',4.1)
        call OV7(IH7,"AstralImprisonmentState")
        set t=CreateTimer()
        set I97=GetHandleId(t)
        call OV7(IH7,"HideUnit")
        // call ImprisonedUnit(IH7,true)
        call IssueImmediateOrder(IH7,"stop")
        call UnitEnterHide(IH7)
        call SetUnitInvulnerable(IH7 , true)
		call PauseUnitEx(IH7, true)
        // call HideUnit_Fix_Location(IH7,3.9)
        if id=='Z00P' then
            call NU7(I97,"FX",AddSpecialEffect("model\\hero_obsidiandestroyer_n3s_t_target.mdl",GetUnitX(IH7),GetUnitY(IH7)))
        else
            call NU7(I97,"FX",AddSpecialEffect("Abilities\\Spells\\Demon\\DarkConversion\\ZombifyTarget.mdl",GetUnitX(IH7),GetUnitY(IH7)))
        endif
        call NT7(I97,"Source",ZX7)
        call NT7(I97,"Target",IH7)
        call NQ7(I97,"TargetX",x)
        call NQ7(I97,"TargetY",y)
        call NP7(I97,"Level",BC7)
        if(IsUnitEnemy(IH7,GetOwningPlayer(ZX7))) then
            call NT7(GetHandleId(ZX7),"748",IH7)
            call DGBD(ZX7,IH7)
        endif
        // call TriggerRegisterTimerEvent(t,4,false)
        // call TriggerAddCondition(t,Condition(function SQD))
        // call TriggerRegisterTimerEvent(t,4,false)
        // call TriggerAddCondition(t,Condition(function SQD))
        // call TriggerRegisterTimerEvent(t,4,false)
        // call TriggerAddCondition(t,Condition(function SQD))
        call TimerStart(t,4.,false,function SQD)
    endif
    call UnitRemoveAbility(ZX7,skill)
    set N5E=N5E-1
    call SaveInteger(MSK,(OB7),(30),(N5E))
    set skill=(LoadInteger(MSK,(OB7),(N5E)))
    call XF7(ZX7,skill)
    call SetUnitAbilityLevel(ZX7,skill,BC7)
    call Reset_Skill_range(ZX7)
else
    call X377(GetOwningPlayer(ZX7),"无可用次数")
endif
if N5E==0 then
    set WF8=(LoadReal(MSK,(OB7),(50)))
    if WF8>0 then
        call Japi_ReduceUnitAbilityCoolDown(ZX7,skill,WF8)
    endif
endif
set BB7=null
set ZX7=null
set IH7=null
set t=null
endfunction
function STD takes nothing returns boolean
if B287_GetSpellAbilityId()=='A0OJ' or B287_GetSpellAbilityId()=='A2ZY' or B287_GetSpellAbilityId()=='A2ZZ' then
call SRD()
endif
return false
endfunction
function SUD takes nothing returns nothing
local unit suijiAstralCaster=GetTriggerUnit()
local unit suijiAstralTarget=GetSpellTargetUnit()
if suijiAstralCaster==null or suijiAstralTarget==null or GetUnitTypeId(suijiAstralCaster)==0 or GetUnitTypeId(suijiAstralTarget)==0 then
set suijiAstralCaster=null
set suijiAstralTarget=null
return
endif
if IsUnitAlly(suijiAstralTarget,GetOwningPlayer(suijiAstralCaster))and OO7(GetHandleId(GetOwningPlayer(suijiAstralTarget)),"DisableHelp")and suijiAstralTarget!=suijiAstralCaster then
call KR7(suijiAstralCaster)
call X37(GetOwningPlayer(suijiAstralCaster),GetObjectName('n038'))
elseif GetUnitTypeId(suijiAstralTarget)=='n00L' then
call KR7(suijiAstralCaster)
call X37(GetOwningPlayer(suijiAstralCaster),GetObjectName('n0K9'))
endif
set suijiAstralCaster=null
set suijiAstralTarget=null
endfunction
