return B287_GetSpellAbilityId()=='A0H4'
endfunction
function TerrorbladeConjureImage_Create takes unit suijiTerrorbladeMirrorCaster returns nothing
local integer suijiTerrorbladeMirrorLevel=0
local integer suijiTerrorbladeMirrorDummySkill=0
local unit suijiTerrorbladeMirrorDummy=null
local group suijiTerrorbladeMirrorSelectionGroup=null
if suijiTerrorbladeMirrorCaster==null or GetUnitTypeId(suijiTerrorbladeMirrorCaster)==0 or UnitAlive(suijiTerrorbladeMirrorCaster)==false then
return
endif
set suijiTerrorbladeMirrorLevel=B287_GetUnitAbilityLevel(suijiTerrorbladeMirrorCaster,'A0H4')
if suijiTerrorbladeMirrorLevel<=0 then
set suijiTerrorbladeMirrorLevel=1
endif
if GetPlayerController(GetOwningPlayer(suijiTerrorbladeMirrorCaster))==MAP_CONTROL_USER then
set suijiTerrorbladeMirrorDummySkill='A4AK'
else
set suijiTerrorbladeMirrorDummySkill='A2JN'
endif
set suijiTerrorbladeMirrorDummy=CreateUnit(GetOwningPlayer(suijiTerrorbladeMirrorCaster),'e00E',GetUnitX(suijiTerrorbladeMirrorCaster),GetUnitY(suijiTerrorbladeMirrorCaster),0)
call UnitApplyTimedLife(suijiTerrorbladeMirrorDummy,'BTLF',2.)
call UnitAddAbility(suijiTerrorbladeMirrorDummy,suijiTerrorbladeMirrorDummySkill)
call SetUnitAbilityLevel(suijiTerrorbladeMirrorDummy,suijiTerrorbladeMirrorDummySkill,suijiTerrorbladeMirrorLevel)
call IssueTargetOrderById(suijiTerrorbladeMirrorDummy,852274,suijiTerrorbladeMirrorCaster)
if Ab[GetPlayerId(GetOwningPlayer(suijiTerrorbladeMirrorCaster))]then
call ClearSelectionForPlayer(GetOwningPlayer(suijiTerrorbladeMirrorCaster))
call SelectUnitAddForPlayer(suijiTerrorbladeMirrorCaster,GetOwningPlayer(suijiTerrorbladeMirrorCaster))
set suijiTerrorbladeMirrorSelectionGroup=WS7()
set BB=suijiTerrorbladeMirrorCaster
call GroupEnumUnitsInRange(suijiTerrorbladeMirrorSelectionGroup,GetUnitX(suijiTerrorbladeMirrorCaster),GetUnitY(suijiTerrorbladeMirrorCaster),600,Condition(function PDFS))
call WR7(suijiTerrorbladeMirrorSelectionGroup)
endif
set suijiTerrorbladeMirrorSelectionGroup=null
set suijiTerrorbladeMirrorDummy=null
endfunction
