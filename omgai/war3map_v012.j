call RemoveUnit(O77(GetHandleId(Aj[N0G]),"VisionUnit"))
endif
if HO4[N5G]=='A1E6' then
call RemoveSavedHandle(L7,GetHandleId(Y58),StringHash("SuijiA1E6Trigger"))
endif
if HO4[N5G]=='A04E' or HN4[N5G]=='A04E' or HP4[N5G]=='A04E' or HM4[N5G]=='A04E' then
set suijiKrakenShellStoredTrigger=LoadTriggerHandle(L7,GetHandleId(Y58),StringHash("SuijiA04ETrigger"))
if suijiKrakenShellStoredTrigger!=null then
call VX7(suijiKrakenShellStoredTrigger)
call RemoveSavedHandle(L7,GetHandleId(Y58),StringHash("SuijiA04ETrigger"))
endif
call RemoveSavedBoolean(L7,GetHandleId(Y58),StringHash("SuijiA04EInit"))
endif
if N5G==87 then
call UnitRemoveAbility(Y58,'A0OL')
call UnitRemoveAbility(Y58,'A0OM')
call UnitRemoveAbility(Y58,'A0ON')
call UnitRemoveAbility(Y58,'A0OH')
endif
call VX7(nj[N0G])
call VX7(Aj[N0G])
if O8G>0 then
call UnitAddAbility(Y58,'A502')
call SetUnitAbilityLevel(Y58,'A502',O8G)
endif
set nj[N0G]=null
set Aj[N0G]=null
set g=null
set suijiKrakenShellStoredTrigger=null
endfunction
function O9G takes unit Y58 returns nothing
local integer N0G=GetPlayerId(GetOwningPlayer(Y58))
local integer N5G=Y08(Y58,4)
local boolean EWD=MR7(Y58,ZU[GX4])
local integer ODG=GetUnitAbilityLevel(Y58,HP4[N5G])
if EWD and HQ4[N5G]!=0 then
set ODG=GetUnitAbilityLevel(Y58,HQ4[N5G])
endif
call UnitRemoveAbility(Y58,HU4[N5G])
call UnitRemoveAbility(Y58,HV4[N5G])
call UnitRemoveAbility(Y58,'A503')
call DisableTrigger(Vj[N0G])
call DisableTrigger(Nj[N0G])
call UnitRemoveAbility(Y58,'A0MB')
call UnitRemoveAbility(Y58,'A02T')
call UnitRemoveAbility(Y58,'A0RT')
call UnitRemoveAbility(Y58,'A0HA')
call UnitRemoveAbility(Y58,'A1IE')
call UnitRemoveAbility(Y58,'B0C9')
call UnitRemoveAbility(Y58,'A1IF')
call UnitRemoveAbility(Y58,'B0C9')
call UnitRemoveAbility(Y58,'A1IG')
call UnitRemoveAbility(Y58,'B0C9')
call NN7(GetHandleId(Y58),"HeartstopperTrigger")
if N5G==29 then
call RemoveUnit(O77(GetHandleId(Y58),"Warpath|Caster"))
call B_7(Y58,0)
endif
call VX7(Vj[N0G])
call VX7(Nj[N0G])
if ODG>0 then
call UnitAddAbility(Y58,'A503')
call SetUnitAbilityLevel(Y58,'A503',ODG)
endif
call TimerStart(N84[N0G],0,false,null)
set Vj[N0G]=null
set Nj[N0G]=null
endfunction
function OEG takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit Y58=O77(GetHandleId(t),"FormlessUnit")
local integer OFG=OM7(GetHandleId(t),"PU8")
call IssueImmediateOrderById(Y58,$D00D2)
if OFG=='A504' then
call N1G(Y58)
call N_G(Y58)
call O7G(Y58)
call O9G(Y58)
elseif OFG=='A505' then
call N1G(Y58)
elseif OFG=='A506' then
call N_G(Y58)
elseif OFG=='A507' then
call O7G(Y58)
elseif OFG=='A508' then
call O9G(Y58)
endif
call DestroyTimer(t)
set Y58=null
set t=null
endfunction
function OGG takes unit Y58,integer OFG returns nothing
local integer N0G=GetPlayerId(GetOwningPlayer(Y58))
local timer t=CreateTimer()
call IssueImmediateOrderById(Y58,$D0004)
call NT7(GetHandleId(t),"FormlessUnit",Y58)
call NP7(GetHandleId(t),"PU8",OFG)
call TimerStart(t,0,false,function OEG)
set t=null
endfunction
function OHG takes nothing returns boolean
if B287_GetSpellAbilityId()=='A504' or B287_GetSpellAbilityId()=='A505' or B287_GetSpellAbilityId()=='A506' or B287_GetSpellAbilityId()=='A507' or B287_GetSpellAbilityId()=='A508' then
call OGG(GetTriggerUnit(),B287_GetSpellAbilityId())
endif
return false
endfunction
function PU8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function OHG))
set t=null
endfunction
function OIG takes nothing returns boolean
return B287_GetSpellAbilityId()=='A500' or B287_GetSpellAbilityId()=='A501' or B287_GetSpellAbilityId()=='A502' or B287_GetSpellAbilityId()=='A503'
endfunction
function OJG takes nothing returns nothing
local unit Y58=GetTriggerUnit()
local player p=GetOwningPlayer(Y58)
local integer OKG=GetUnitPointValue(GetSpellTargetUnit())
local integer OMG=B287_GetUnitAbilityLevel(Y58,B287_GetSpellAbilityId())
local integer ONG=B287_GetSpellAbilityId()
local integer N0G=GetPlayerId(p)
local integer OOG=0
local integer OPG=0
local integer OQG=0
local string ORG=""
local string OSG=""
local boolean EWD=MR7(Y58,ZU[GX4])
local trigger t
local integer OTG=Y08(Y58,1)
local integer OUG=Y08(Y58,2)
local integer OVG=Y08(Y58,3)
local integer OWG=Y08(Y58,4)
if ONG=='A500' then
set OOG=HM4[OKG]
set OPG=HR4[OKG]
set ORG=HW4[OKG]
set OSG="Abilities\\Spells\\Items\\AIsm\\AIsmTarget.mdl"
elseif ONG=='A501' then
set OOG=HN4[OKG]
set OPG=HS4[OKG]
set ORG=HX4[OKG]
set OSG="Abilities\\Spells\\Items\\AIem\\AIemTarget.mdl"
elseif ONG=='A502' then
set OOG=HO4[OKG]
set OPG=HT4[OKG]
set ORG=HY4[OKG]
set OSG="Abilities\\Spells\\Items\\AIam\\AIamTarget.mdl"
elseif ONG=='A503' then
set OOG=HP4[OKG]
set OPG=HU4[OKG]
set ORG=HZ4[OKG]
set OSG="Abilities\\Spells\\Demon\\DarkPortal\\DarkPortalTarget.mdl"
if EWD and HQ4[OKG]!=0 then
set OOG=HQ4[OKG]
set OPG=HV4[OKG]
endif
endif
if OPG==0 then
call X37(p,"Unable to copy "+GetAbilityName(OOG)+".")
elseif bj[N0G]==false and ORG!="passive" and(ORG==HW4[OTG]or ORG==HX4[OUG]or ORG==HY4[OVG]or ORG==HZ4[OWG])then
if ORG==HW4[OTG]then
set OQG=HM4[OTG]
elseif ORG==HX4[OUG]then
set OQG=HN4[OUG]
elseif ORG==HY4[OVG]then
set OQG=HO4[OVG]
elseif ORG==HZ4[OWG]then
set OQG=HP4[OWG]
endif
call X37(p,"Cannot copy "+GetAbilityName(OOG)+" because you already\n        have an ability with this base order ("+GetAbilityName(OQG)+").\n        Use -override to disable this.")
else
call DestroyEffect(AddSpecialEffectTarget(OSG,Y58,"origin"))
call UnitRemoveAbility(Y58,ONG)
call UnitAddAbility(Y58,OOG)
call UnitAddAbility(Y58,OPG)
call SetPlayerAbilityAvailable(p,OPG,false)
call SetUnitAbilityLevel(Y58,OOG,OMG)
if OOG=='A0S9' then
call UnitAddAbility(Y58,'A0SA')
elseif OOG=='A11N' then
call UnitAddAbility(Y58,'A13D')
elseif OOG=='A0MB' then
call UnitAddAbility(Y58,'A0MB')
call SetUnitAbilityLevel(Y58,'A0MB',OMG)
elseif OOG=='A0AK' or OOG=='A1FY' then
call UnitAddAbility(Y58,'A0WF')
elseif OOG=='A0RP' then
call UnitAddAbility(Y58,'A0RT')
elseif OOG=='A0H9' then
call UnitAddAbility(Y58,'A0HA')
endif
if OOG=='A0DY' then
call Y99(Y58,true)
elseif OOG=='A18X' then
elseif OOG=='A0LZ' then
call G_D(Y58,true)
elseif OOG=='A1CD' then
call MJG(Y58,true)
elseif OOG=='A19Q' then
elseif OOG=='A0M3' then
call VP9(Y58,true)
elseif OOG=='A0FV' then
call VG9(Y58,true)
elseif OOG=='A1IQ' then
call UZ9(Y58,true)
elseif OOG=='A0QW' then
call IAD(Y58,true)
elseif OOG=='A0QN' then
call A89(Y58,true)
elseif OOG=='A0QQ' then
call AH9(Y58,true)
elseif OOG=='A1EA' then
elseif OOG=='A03E' then
call W7E(Y58,true)
elseif OOG=='A0BG' then
call RXD(Y58,true)
elseif OOG=='A0CZ' then
if OO7(GetHandleId(Y58),"SuijiA0CZInit")==false then
call NS7(GetHandleId(Y58),"SuijiA0CZInit",true)
call TXD(Y58,true)
endif
elseif OOG=='A081' then
elseif OOG=='A1E6' then
call FLE(Y58,true)
elseif OOG=='A0SS' then
elseif OOG=='A04E' then
if OO7(GetHandleId(Y58),"SuijiA04EInit")==false then
call NS7(GetHandleId(Y58),"SuijiA04EInit",true)
call KPE(Y58,true)
endif
elseif OOG=='A01N' then
call CFD(Y58,true)
elseif OOG=='A06D' then
elseif OOG=='A0ES' then
call JDE(Y58,true)
elseif OOG=='A0CT' then
elseif OOG=='A0NS' or OOG=='A1DA' then
elseif OOG=='A0NA' then
elseif OOG=='A0OI' then
elseif OOG=='A0IF' then
call SJD(Y58,true)
elseif OOG=='A1IN' then
endif
endif
set Y58=null
set p=null
set t=null
endfunction
