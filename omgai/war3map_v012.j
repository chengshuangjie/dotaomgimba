//call SetUnitAbilityLevel(TXF,skill,(OM7(GetHandleId(hn),"QuasLevel")))
call SetUnitX(TXF,GetUnitX(hn))
call SetUnitY(TXF,GetUnitY(hn))
endif
set t=null
set TXF=null
set hn=null
