call SaveReal(L7,(I97),(6),((x)*1.))
call SaveReal(L7,(I97),(7),((y)*1.))
call SaveReal(L7,(I97),(442),(((TimerGetElapsed(W)))*1.))
call SaveReal(L7,(I97),(57),((CHF)*1.))
