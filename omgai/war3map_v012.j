//library OMGAISkillConflictResolver:

    // 对外统一接口：判断待选技能是否与当前已选技能集冲突
    // candidateRawCode - 待选技能 rawcode
    // currentRawCodes  - 当前已选技能 rawcode 数组
    // currentCount     - 数组有效长度
    function OMGAISkillConflictResolver_IsConflict takes integer candidateRawCode, integer currentCount returns boolean
        return OMGAIConflictRule_IsConflictWith(candidateRawCode, currentCount)
    endfunction

    // 特殊处理：卡尔元素 + 地卜师大招
    // 这些技能单独走 SPECIAL_HANDLE 分支
    function OMGAISkillConflictResolver_IsSpecialHandled takes integer rawCode returns boolean
        local integer ruleIdx = OMGAIConflictRule_FindRuleOfSkill(rawCode)
        if ruleIdx == 0 then
            return false
        endif
        return OMGAIConflictRule_GetPolicy(ruleIdx) == 2
    endfunction


//library OMGAISkillConflictResolver ends
//library OMGAISkillPool:


    // 构建两个子池（在 SkillData.init 之后调用）
    function OMGAISkillPool_BuildPools takes nothing returns nothing
        local integer i
        local integer slot
        set SmallPool_Count = 0
        set BigPool_Count   = 0
        set i = 1
        loop
            exitwhen i > SkillDef_Count
            set slot = SkillDef_Slot[i]
            if slot == 1 then
                set SmallPool_Count = SmallPool_Count + 1
                set SmallPool_Indices[SmallPool_Count] = i
            elseif slot == 2 then
                set BigPool_Count = BigPool_Count + 1
                set BigPool_Indices[BigPool_Count] = i
            endif
            set i = i + 1
        endloop
        call OMGAILogger_I("SkillPool", "SmallPool=" + I2S(SmallPool_Count) + " BigPool=" + I2S(BigPool_Count))
    endfunction

    // 从指定池随机抽 N 个 SkillDef index，返回填充到 outArray
    // poolType: 1=小池 2=大池
    // count:    抽取数量
    // excludeRawCodes: 已选/固定的技能 rawcode 数组（这些不能出现）
    // excludeCount: excludeRawCodes 有效长度
    // outArray: 输出数组（填充 1..count）
    // 返回 实际成功抽取的数量（若池不足可能小于 count）
    function OMGAISkillPool_GetRandomOffers takes integer poolType, integer count, integer excludeCount returns integer
        local integer poolStart
        local integer poolCount
        local integer candidateCount = 0
        local integer i
        local integer j
        local integer idx
        local integer rawCode
        local integer result
        local integer picked
        local boolean excluded
        local boolean conflict

        // 选用池
        if poolType == 1 then
            set poolCount = SmallPool_Count
        else
            set poolCount = BigPool_Count
        endif

        if poolCount == 0 then
            call OMGAILogger_W("SkillPool", "GetRandomOffers: empty pool")
            return 0
        endif

        // 预填充冲突校验输入通道（exclude 列表在整个筛选过程中不变）
        set i = 1
        loop
            exitwhen i > excludeCount
            set ConflictRule_CheckList[i] = SkillPool_ExcludeRawCodes[i]
            set i = i + 1
        endloop

        // 第一阶段：遍历池，过滤禁选/排除/冲突
        set i = 1
        loop
            exitwhen i > poolCount
            set idx = 0
            if poolType == 1 then
                set idx = SmallPool_Indices[i]
            else
                set idx = BigPool_Indices[i]
            endif

            set rawCode = SkillDef_RawCode[idx]

            // 排除已选
            set excluded = false
            set j = 1
            loop
                exitwhen j > excludeCount
                if SkillPool_ExcludeRawCodes[j] == rawCode then
                    set excluded = true
                    exitwhen true
                endif
                set j = j + 1
            endloop

            // 排除冲突（与当前已选技能）
            set conflict = false
            if not excluded then
                set conflict = OMGAIConflictRule_IsConflictWith(rawCode, excludeCount)
            endif

            if not excluded and not conflict then
                set candidateCount = candidateCount + 1
                set SkillPool_Candidates[candidateCount] = idx
            endif

            set i = i + 1
        endloop

        if candidateCount == 0 then
            call OMGAILogger_W("SkillPool", "GetRandomOffers: no valid candidates after filter")
            return 0
        endif

        // 第二阶段：Fisher-Yates 部分洗牌取前 count 个
        set i = 1
        loop
            exitwhen i > count or i >= candidateCount
            // 随机选 j in [i, candidateCount]
            set j = i + GetRandomInt(0, candidateCount - i)
            // 交换 candidates[i] 与 candidates[j]
            set picked      = SkillPool_Candidates[i]
            set SkillPool_Candidates[i] = SkillPool_Candidates[j]
            set SkillPool_Candidates[j] = picked
            set SkillPool_OutIndices[i] = SkillPool_Candidates[i]
            set i = i + 1
        endloop
        // 若 i 不足 count，把剩余 candidates[i..] 填入
        loop
            exitwhen i > count or i > candidateCount
            set SkillPool_OutIndices[i] = SkillPool_Candidates[i]
            set i = i + 1
        endloop

        return i - 1
    endfunction


//library OMGAISkillPool ends
//library OMGAISkillProfile:

    // ---- SkillProfile 全局数组（每个玩家一份，按 playerId 索引）---------

    // 从一组技能构造画像
    // skillIndices - 技能 SkillDef index 数组
    // count        - 数组有效长度
    // targetPlayerId - 把画像写入对应的 playerId
    function OMGAISkillProfile_BuildFromSkills takes integer count, integer targetPlayerId returns nothing
        local integer i
        local integer idx
        local integer tags
        local integer ctrlMask
        local real burst       = 0
        local real sustain      = 0
        local real control       = 0
        local real mobility     = 0
        local real durability    = 0
        local real heal         = 0

        set i = 1
        loop
            exitwhen i > count
            set idx = SkillProfile_InputIndices[i]
            if idx >= 1 and idx <= SkillDef_Count then
                set tags     = SkillDef_Tags[idx]
                set ctrlMask = SkillDef_CtrlMask[idx]

                // 爆发分：含 BURST_HIGH 加 7，含 DMG_MAGICAL 加 2（法系爆发基础分）
                if OMGAISkillTag_HasTag(tags, STAG_BURST_HIGH) then
                    set burst = burst + 7.0
                endif
                if OMGAISkillTag_HasTag(tags, STAG_DMG_MAGICAL) then
                    set burst = burst + 2.0
                endif

                // 持续输出分：含 SUSTAIN_HIGH 加 6，含 DMG_PHYSICAL 加 2
                if OMGAISkillTag_HasTag(tags, STAG_SUSTAIN_HIGH) then
                    set sustain = sustain + 6.0
                endif
                if OMGAISkillTag_HasTag(tags, STAG_DMG_PHYSICAL) then
                    set sustain = sustain + 2.0
                endif

                // 控制分：每种控制 +3，最长持续 +1
                if OMGAISkillTag_HasTag(ctrlMask, STAG_CTRL_STUN) then
                    set control = control + 3.0
                endif
                if OMGAISkillTag_HasTag(ctrlMask, STAG_CTRL_SLOW) then
                    set control = control + 1.5
                endif
                if OMGAISkillTag_HasTag(ctrlMask, STAG_CTRL_SILENCE) then
                    set control = control + 2.0
                endif
                if OMGAISkillTag_HasTag(ctrlMask, STAG_CTRL_ROOT) then
                    set control = control + 2.0
                endif
                set control = control + SkillDef_CtrlDuration[idx] * 0.5

                // 机动分：DASH +2，BLINK +4，ESCAPE +2
                if OMGAISkillTag_HasTag(tags, STAG_DASH) then
                    set mobility = mobility + 2.0
                endif
                if OMGAISkillTag_HasTag(tags, STAG_BLINK) then
                    set mobility = mobility + 4.0
                endif
                if OMGAISkillTag_HasTag(tags, STAG_ESCAPE) then
                    set mobility = mobility + 2.0
                endif

                // 承伤分：DURABILITY 加 5，SHIELD 加 3
                if OMGAISkillTag_HasTag(tags, STAG_DURABILITY) then
                    set durability = durability + 5.0
                endif
                if OMGAISkillTag_HasTag(tags, STAG_SHIELD) then
                    set durability = durability + 3.0
                endif

                // 治疗分：HEAL 加 5，LIFESTEAL 加 2
                if OMGAISkillTag_HasTag(tags, STAG_HEAL) then
                    set heal = heal + 5.0
                endif
                if OMGAISkillTag_HasTag(tags, STAG_LIFESTEAL) then
                    set heal = heal + 2.0
                endif
            endif
            set i = i + 1
        endloop

        // 归一化到 0-10
        if burst > 10.0 then
            set burst = 10.0
        endif
        if sustain > 10.0 then
            set sustain = 10.0
        endif
        if control > 10.0 then
            set control = 10.0
        endif
        if mobility > 10.0 then
            set mobility = 10.0
        endif
        if durability > 10.0 then
            set durability = 10.0
        endif
        if heal > 10.0 then
            set heal = 10.0
        endif

        set SkillProfile_Burst[targetPlayerId]     = burst
        set SkillProfile_Sustain[targetPlayerId]    = sustain
        set SkillProfile_Control[targetPlayerId]  = control
        set SkillProfile_Mobility[targetPlayerId] = mobility
        set SkillProfile_Durability[targetPlayerId] = durability
        set SkillProfile_Heal[targetPlayerId]      = heal
    endfunction

    // 清空画像（玩家离开/重选）
    function OMGAISkillProfile_Clear takes integer playerId returns nothing
        set SkillProfile_Burst[playerId]    = 0.0
        set SkillProfile_Sustain[playerId]    = 0.0
        set SkillProfile_Control[playerId]     = 0.0
        set SkillProfile_Mobility[playerId]    = 0.0
        set SkillProfile_Durability[playerId] = 0.0
        set SkillProfile_Heal[playerId]        = 0.0
    endfunction


//library OMGAISkillProfile ends
//library OMGAISpellCast:

//---------------------------------------------------------------------------
// 1. 取消计数（坑#5：同技能同目标连续取消 2 次 → 强制换目标/放弃）
//    结构：主键=单位 hid，槽=20 存取消计数
//---------------------------------------------------------------------------

    function OMGAISpellCast_OMGAI_CastCanceled takes unit u, integer abilityId, unit target returns nothing
        local integer hid = GetHandleId(u)
        local integer c = OMGAICore_OMGAI_LoadInt(hid, SLOT_CANCEL_COUNT)
        set c = c + 1
        call OMGAICore_OMGAI_SaveInt(hid, SLOT_CANCEL_COUNT, c)
        call OMGAILog_LOG_WARN("CAST", "施法取消 " + I2S(c) + "/" + I2S(CANCEL_MAX) + " ability=" + I2S(abilityId))
        if c >= CANCEL_MAX then
            // 强制换目标：目标缓存清空
            call OMGAICore_OMGAI_SaveInt(hid, 9, 0)
            call OMGAICore_OMGAI_SaveInt(hid, SLOT_CANCEL_COUNT, 0)
            call OMGAILog_LOG_INFO("CAST", "取消超限，强制换目标")
        endif
    endfunction

    function OMGAISpellCast_OMGAI_CastSuccess takes unit u returns nothing
        call OMGAICore_OMGAI_SaveInt(GetHandleId(u), SLOT_CANCEL_COUNT, 0)
    endfunction

//---------------------------------------------------------------------------
// 2. 8 类 targetType 分发（方案 §7.3）
//    orderId 由 SkillPool 配表提供
//---------------------------------------------------------------------------

        function OMGAISpellCast_OMGAI_IssueOrder takes unit u, integer abilityId, integer tt, unit target, real x, real y returns boolean
        if u == null then
            return false
        endif
        // V2: 直接对接基图 SuijiAI 施法引擎（技能 -> 订单映射 + 执行）
        if tt == TT_UNIT or tt == TT_ALLY or tt == TT_SELF or tt == TT_CORPSE then
            if target != null then
                return SuijiAI_IssueMappedTarget(u, target, abilityId)
            endif
        elseif tt == TT_POINT or tt == TT_AREA then
            return SuijiAI_IssueMappedPoint(u, x, y, abilityId)
        else
            return SuijiAI_IssueMappedImmediate(u, abilityId)
        endif
        return false
    endfunction

//---------------------------------------------------------------------------
// 3. 施法三重守卫（方案 §7.2，D1 CAAS 思想）
//    ① 动作掩码（CD/蓝/血/距离/目标）
//    ② 命令白名单（防吟唱插队，坑#6）
//    ③ 单位级软冷却
//---------------------------------------------------------------------------

        function OMGAISpellCast_OMGAI_SpellGuard takes unit u, integer abilityId, unit target returns boolean
        local integer hid = GetHandleId(u)
        local real now = OMGAICore_OMGAI_GetGameTime()
        // 1. 单位软冷却（OMGAI 自身）
        if OMGAICore_OMGAI_LoadReal(hid, SLOT_SOFT_CD) > now then
            return false
        endif
        // 2. 动作掩码校验
        if not OMGAIActionMask_OMGAI_ActionMaskValid(u, abilityId, target) then
            return false
        endif
        // 3. 基图蓝耗/资源校验（SuijiAI_CanPayAndCastNormally）
        if not SuijiAI_CanPayAndCastNormally(u, abilityId) then
            return false
        endif
        return true
    endfunction

//---------------------------------------------------------------------------
// 4. 施法入口（行为模块调用）
//    流程：Guard → IssueOrder → 成功则 MarkCooldown + CastSuccess
//          → 失败 OMGAI_CastCanceled
//    施放后 0.5s 补发原命令防站桩（D1 CAAS onAttackOrder 思想）
//---------------------------------------------------------------------------

    function OMGAISpellCast_OMGAI_CastAbility takes unit u, integer abilityId, integer tt, unit target, real x, real y returns boolean
        local boolean ok = false
        local real lbias = 0.0
        if u == null then
            return false
        endif
        // 守卫
        if not OMGAISpellCast_OMGAI_SpellGuard(u, abilityId, target) then
            return false
        endif
        // 下发命令
        set ok = OMGAISpellCast_OMGAI_IssueOrder(u, abilityId, tt, target, x, y)
        if ok then
            // 登记自维护冷却（软冷却 + 技能 CD）
            call OMGAIActionMask_OMGAI_MarkCooldown(u, abilityId, OMGAIActionMask_OMGAI_GetSoftCD(abilityId))
            call OMGAICore_OMGAI_SaveReal(GetHandleId(u), SLOT_SOFT_CD, OMGAICore_OMGAI_GetGameTime() + 0.15)
            call OMGAISpellCast_OMGAI_CastSuccess(u)
            call OMGAILearn_OMGAI_LearnOnCast(u, abilityId, target)
            // v0.11: 自学习反馈——低分技能施放间隔惩罚（越证明无效越少放）
            set lbias = OMGAILearn_OMGAI_LearnBiasForCast(u, abilityId)
            if lbias < 0.0 then
                call OMGAICore_OMGAI_SaveReal(GetHandleId(u), SLOT_SOFT_CD, OMGAICore_OMGAI_GetGameTime() + 0.5 - lbias * 10.0)
            endif
            // 补发原命令（0.5s 后若 idle 则补攻击/移动）
            // TODO: TimerService 延迟回调 OMGAI_ReissueCommand(u)
            return true
        else
            call OMGAISpellCast_OMGAI_CastCanceled(u, abilityId, target)
            return false
        endif
    endfunction

//---------------------------------------------------------------------------
// 5. 防卡死补丁（D1 AIfixSimple：一次性施法技能 ENDCAST 后自动删除技能）
//    适用于 OMG 随机技能中的一次性/变身类，防 AI 发呆
//---------------------------------------------------------------------------

    function OMGAISpellCast_OMGAI_EndCastRemove takes unit u, integer abilityId returns nothing
        // TODO: 判断是否一次性技能（SkillPool eventMask）
        call UnitRemoveAbility(u, abilityId)
        call OMGAILog_LOG_INFO("CAST", "ENDCAST 清理技能: " + I2S(abilityId))
    endfunction

//---------------------------------------------------------------------------
// 6. 工具
//---------------------------------------------------------------------------


    function OMGAISpellCast_OMGAI_SpellCastInit takes nothing returns nothing
        call OMGAILog_LOG_INFO("CAST", "OMGAISpellCast 初始化完成")
    endfunction


