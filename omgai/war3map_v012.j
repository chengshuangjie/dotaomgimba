function T7G takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local integer QSG=(LoadInteger(L7,(I97),(34)))
local integer BC7=B287_GetUnitAbilityLevel(ZX7,'A28Q')
local unit IH7=(LoadUnitHandle(L7,(I97),(17)))
local unit T8G=(LoadUnitHandle(L7,(GetHandleId(ZX7)),(652)))
local boolean T9G=false
local real TDG=.2*(GetUnitState(ZX7,UNIT_STATE_LIFE)*.035)
local real TEG=.2*(GetUnitState(ZX7,UNIT_STATE_MANA)*.035)
local integer id=(LoadInteger(L7,(I97),(10)))
if GetTriggerEventId()==EVENT_UNIT_ISSUED_ORDER then
if GetIssuedOrderId()==852589then
call T4G(ZX7,BC7,id)
elseif GetIssuedOrderId()==852590then
call S2G(ZX7)
endif
endif
if GetUnitAbilityLevel(ZX7,'A1TS')>0 or GetUnitAbilityLevel(ZX7,'A1TR')>0 or GetUnitAbilityLevel(ZX7,'A1TT')>0 or GetUnitAbilityLevel(ZX7,'A1TP')>0 then
set T9G=true
call SetUnitState(ZX7,UNIT_STATE_LIFE,RMaxBJ(GetUnitState(ZX7,UNIT_STATE_LIFE)-TDG,1))
call SetUnitState(ZX7,UNIT_STATE_MANA,RMaxBJ(GetUnitState(ZX7,UNIT_STATE_MANA)-TEG,1))
endif
if T8G==null then
if IH7!=null then
call S2G(IH7)
set IH7=null
call SaveUnitHandle(L7,(I97),(17),(IH7))
endif
else
if IH7==null then
set IH7=T8G
if T9G then
call SaveUnitHandle(L7,(I97),(17),(IH7))
call T4G(IH7,BC7,id)
else
call S2G(IH7)
endif
elseif IH7!=T8G then
call S2G(IH7)
if T9G then
set IH7=T8G
call SaveUnitHandle(L7,(I97),(17),(IH7))
call T4G(IH7,BC7,id)
endif
elseif T9G==false then
call S2G(IH7)
elseif IH7==T8G then
if T9G then
set IH7=T8G
call SaveUnitHandle(L7,(I97),(17),(IH7))
call T4G(IH7,BC7,id)
endif
endif
endif
if ZX7==null then
    call FlushChildHashtable(L7,(I97))
    call FlushChildHashtable(L7,(GetHandleId(ZX7)))
    call OZ7(t)
endif
set t=null
set ZX7=null
set IH7=null
set T8G=null
return false
endfunction
