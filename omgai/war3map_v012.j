function YRD takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local trigger t=CreateTrigger()
local integer I97=GetHandleId(t)
local integer BC7=B287_GetUnitAbilityLevel(ZX7,'A1OP')
local integer id=GetUnitTypeId(ZX7)
if id=='ZC42' then
    if BC7==1 then
        call XF7(ZX7,'X1OL')
        call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'X1OL',false)
    elseif BC7==2 then
        call XF7(ZX7,'X1ON')
        call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'X1ON',false)
    elseif BC7==3 then
        call XF7(ZX7,'X1OO')
        call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'X1OO',false)
    elseif BC7==4 then
        call XF7(ZX7,'X1OM')
        call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'X1OM',false)
    endif   
elseif id=='ZC43' then
    if BC7==1 then
        call XF7(ZX7,'X2OL')
        call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'X2OL',false)
    elseif BC7==2 then
        call XF7(ZX7,'X2ON')
        call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'X2ON',false)
    elseif BC7==3 then
        call XF7(ZX7,'X2OO')
        call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'X2OO',false)
    elseif BC7==4 then
        call XF7(ZX7,'X2OM')
        call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'X2OM',false)
    endif   
else
    if BC7==1 then
        call XF7(ZX7,'A1OL')
        call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A1OL',false)
    elseif BC7==2 then
        call XF7(ZX7,'A1ON')
        call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A1ON',false)
    elseif BC7==3 then
        call XF7(ZX7,'A1OO')
        call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A1OO',false)
    elseif BC7==4 then
        call XF7(ZX7,'A1OM')
        call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A1OM',false)
    endif
endif
call TriggerRegisterTimerEvent(t,8+2*BC7,false)
call TriggerRegisterUnitEvent(t,ZX7,EVENT_UNIT_DEATH)
