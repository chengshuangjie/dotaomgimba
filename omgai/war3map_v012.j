function XWE_SWAP takes nothing returns nothing
call XWE(GetPlayerId(GetOwningPlayer(U22)),U22,GetUnitTypeId(U22))
endfunction
function XXE takes nothing returns nothing
call GQ9(GetTriggerUnit())
if(GetPlayerController(GetOwningPlayer(GetTriggerUnit()))==MAP_CONTROL_COMPUTER)then
if GetUnitTypeId(GetTriggerUnit())!='H00J' then
call ExecuteFunc("UD")
else
call ExecuteFunc("xh")
endif
elseif GetUnitTypeId(GetTriggerUnit())!='H00J' then
if not(((QA4!=null)and(IsTriggerEnabled(QA4)))and(((GetOwningPlayer(GetTriggerUnit())==QT4)and(QV4!=null))or((GetOwningPlayer(GetTriggerUnit())==QU4)and(QW4!=null))))then
set bj_lastLoadedUnit=GetTriggerUnit()
call XWE(GetPlayerId(GetOwningPlayer(bj_lastLoadedUnit)),bj_lastLoadedUnit,GetUnitTypeId(bj_lastLoadedUnit))
call ExecuteFunc("XYE")
endif
endif
endfunction
function SuijiTest_ModeText takes nothing returns string
if SUIJI_MODE then
return " SUIJI=1"
endif
return " SUIJI=0"
endfunction
function SuijiTest_DebugAll takes string tag,string msg returns nothing
if SUIJI_LOG then
call VV7(bj_FORCE_ALL_PLAYERS,8.,"|cFF66CCFF随机OMG日志["+tag+"]：|r"+msg+SuijiTest_ModeText())
endif
endfunction
function SuijiTest_DebugPlayer takes player p,string tag,string msg returns nothing
local integer pid=0
if SUIJI_LOG==false or p==null then
return
endif
if GetPlayerController(p)!=MAP_CONTROL_COMPUTER then
return
endif
set pid=GetPlayerId(p)
call VV7(bj_FORCE_ALL_PLAYERS,8.,"|cFF66CCFF随机OMG日志["+tag+"]：|rAI"+I2S(pid)+" "+Q[pid]+KZ4[pid]+"|r "+msg+SuijiTest_ModeText())
endfunction
function SuijiTest_DebugUnit takes unit u,string tag,string msg returns nothing
local player p=null
local integer pid=0
if SUIJI_LOG==false then
return
endif
if u==null then
call VV7(bj_FORCE_ALL_PLAYERS,8.,"|cFF66CCFF随机OMG日志["+tag+"]：|runit=null "+msg+SuijiTest_ModeText())
return
endif
set p=GetOwningPlayer(u)
if GetPlayerController(p)!=MAP_CONTROL_COMPUTER then
set p=null
return
endif
set pid=GetPlayerId(p)
call VV7(bj_FORCE_ALL_PLAYERS,8.,"|cFF66CCFF随机OMG日志["+tag+"]：|rAI"+I2S(pid)+" "+Q[pid]+KZ4[pid]+"|r "+GetUnitName(u)+" pv="+I2S(GetUnitPointValue(u))+" "+msg+SuijiTest_ModeText())
set p=null
endfunction
function SuijiTest_PresetHero takes integer pid returns integer
return LoadInteger(L7,StringHash("SuijiTestPresetHero"),pid)
endfunction
function SuijiTest_PresetSmall takes integer pid returns integer
return LoadInteger(L7,StringHash("SuijiTestPresetSmall"),pid)
endfunction
function SuijiTest_PresetUlt takes integer pid returns integer
return LoadInteger(L7,StringHash("SuijiTestPresetUlt"),pid)
endfunction
function SuijiTest_PresetController takes integer pid returns player
return LoadPlayerHandle(L7,StringHash("SuijiTestPresetController"),pid)
endfunction
function SuijiTest_HasPreset takes integer pid returns boolean
return SuijiTest_PresetHero(pid)!=0 and SuijiTest_PresetSmall(pid)!=0 and SuijiTest_PresetUlt(pid)!=0
endfunction
function SuijiTest_FindHeroIndex takes integer hero returns integer
local integer idx=KL4
loop
exitwhen idx>K54
if K34[idx]==hero then
return idx
endif
set idx=idx+1
endloop
return 0
endfunction
// 超级AI组合池：当前测试阶段固定100%，正式版只需调整此处概率。
function SuijiSuperAI_Chance takes nothing returns integer
if ISTEST then
return 100
endif
return 10
endfunction
function SuijiSuperAI_PresetHero takes integer pid returns integer
return LoadInteger(L7,StringHash("SuijiSuperAIHero"),pid)
endfunction
function SuijiSuperAI_PresetSmall takes integer pid returns integer
return LoadInteger(L7,StringHash("SuijiSuperAISmall"),pid)
endfunction
function SuijiSuperAI_PresetUlt takes integer pid returns integer
return LoadInteger(L7,StringHash("SuijiSuperAIUlt"),pid)
endfunction
function SuijiSuperAI_HasPreset takes integer pid returns boolean
return SuijiSuperAI_PresetHero(pid)!=0 and SuijiSuperAI_PresetSmall(pid)!=0 and SuijiSuperAI_PresetUlt(pid)!=0
endfunction
function SuijiMode_HasForcedPreset takes integer pid returns boolean
return SuijiTest_HasPreset(pid) or SuijiSuperAI_HasPreset(pid)
endfunction
function SuijiMode_ForcedHero takes integer pid returns integer
if SuijiTest_HasPreset(pid) then
return SuijiTest_PresetHero(pid)
endif
return SuijiSuperAI_PresetHero(pid)
endfunction
function SuijiMode_ForcedSmall takes integer pid returns integer
if SuijiTest_HasPreset(pid) then
return SuijiTest_PresetSmall(pid)
endif
return SuijiSuperAI_PresetSmall(pid)
endfunction
function SuijiMode_ForcedUlt takes integer pid returns integer
if SuijiTest_HasPreset(pid) then
return SuijiTest_PresetUlt(pid)
endif
return SuijiSuperAI_PresetUlt(pid)
endfunction
function SuijiSuperAI_ClearPreset takes integer pid returns nothing
call SaveInteger(L7,StringHash("SuijiSuperAIHero"),pid,0)
call SaveInteger(L7,StringHash("SuijiSuperAISmall"),pid,0)
call SaveInteger(L7,StringHash("SuijiSuperAIUlt"),pid,0)
call SaveBoolean(L7,StringHash("SuijiSuperAIAnnounced"),pid,false)
endfunction
function SuijiSuperAI_PoolSize takes nothing returns integer
return 30
endfunction
