function XY_TRI2 takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local group g=(LoadGroupHandle(L7,(OB7),(22)))
local real dur=ON7(OB7,"DUR")
local real U4F=ON7(OB7,"YM7")
local integer i=0
local unit TLF
local unit T6F=LoadUnitHandle(L7,OB7,20)
local real SourceX=ON7(OB7,"SourceX")
local real SourceY=ON7(OB7,"SourceY")
local real a
local real x2
local real y2
local real x
local real y
local group g3
set g3=WS7()
loop
set TLF=LoadUnitHandle(L7,OB7,100+i)
set x2=LoadReal(L7,OB7,200+i)
set y2=LoadReal(L7,OB7,300+i)
set a=LoadReal(L7,OB7,100+i)
set x=GetUnitX(TLF)
set y=GetUnitY(TLF)
if KF7(x,y,x2,y2)<10 then
set x=x2
set y=y2
else
set x=x+33*Cos(a)
set y=y+33*Sin(a)
endif
call SetUnitX(TLF,X17(x))
call SetUnitY(TLF,X07(y))
set U22=T6F
set IN4=TLF
set IQ4=g
set IJ4=dur
set IK4=U4F
set ZB4=SourceX
set ZC4=SourceY
call GroupEnumUnitsInRange(g3,x,y,125,Condition(function AJ7_gai))
call ForGroup(g3,function XY_ADD_UNIT)
call GroupClear(g3)
if GetTriggerEvalCount(t)>15 then
call KillUnit(TLF)
endif
set i=i+1
exitwhen i==$C
endloop
call WR7(g3)
if GetTriggerEvalCount(t)>15 then
call FlushChildHashtable(L7,(OB7))
call OZ7(t)
call WR7(g)
endif
set t=null
set TLF=null
set T6F=null
set g=null
set g3=null
return false
endfunction
function XY_TRI takes nothing returns nothing
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local unit T6F=GetTriggerUnit()
local real a=0
local unit TLF
local integer i=0
local integer C2D=$C
local integer id=GetUnitTypeId(T6F)
local integer skillmj='h0H6'
local integer level=B287_GetUnitAbilityLevel(T6F,'A4HK')
loop
set a=30*i
set TLF=CreateUnit(GetOwningPlayer(T6F),skillmj,GetUnitX(T6F),GetUnitY(T6F),a)
call SaveUnitHandle(L7,OB7,100+i,TLF)
call SaveReal(L7,OB7,100+i,a*bj_DEGTORAD)
call SetUnitX(TLF,GetUnitX(T6F))
call SetUnitY(TLF,GetUnitY(T6F))
call SaveReal(L7,OB7,200+i,X17(GetUnitX(TLF)+500*Cos(a*bj_DEGTORAD)))
call SaveReal(L7,OB7,300+i,X07(GetUnitY(TLF)+500*Sin(a*bj_DEGTORAD)))
set i=i+1
exitwhen i==C2D
endloop
call TriggerRegisterTimerEvent(t,.02,true)
call TriggerAddCondition(t,Condition(function XY_TRI2))
call SaveGroupHandle(L7,(OB7),(22),(WS7()))
call SaveUnitHandle(L7,OB7,20,T6F)
call NQ7(OB7,"SourceX",GetUnitX(T6F))
call NQ7(OB7,"SourceY",GetUnitY(T6F))
call NQ7(OB7,"DUR",1.+.5*level)
call NQ7(OB7,"YM7",60.+level*60)
call SaveInteger(L7,OB7,0,$A)
set t=null
set T6F=null
set TLF=null
endfunction
