		call SetTextTagText(tt, s, .03)
		call SetTextTagPosUnit(tt, m5, 0)
		call SetTextTagColorBJ(tt, 150, 0, 255, 15)
		call SetTextTagVelocity(tt, 0, .035)
		call SetTextTagFadepoint(tt, 3)
		call SetTextTagLifespan(tt, RMaxBJ(1., GEX / 2))
		call SetTextTagPermanent(tt, false)
		call SetTextTagVisibility(tt, IsUnitAlly(u, GetLocalPlayer()) or WG7(GetLocalPlayer()))
	endif
	set tt = null
endfunction
function HXXS takes string Hx,real Hk,unit HX,real Ia returns nothing
