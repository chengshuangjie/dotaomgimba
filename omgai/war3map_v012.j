function xn takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit p5=O77(OB7,"Source")
local unit m5=O77(OB7,"Target")
local integer V77=OM7(OB7,"Level")
local real xN=ON7(OB7,"LastX")
local real xo=ON7(OB7,"LastY")
local real x=0.
local real y=0.
local real d=0.
local real B39
local integer QI=OM7(OB7,"Iteration")
local integer durationIterations=OM7(OB7,"DurationIterations")
local integer O5=0
local unit suijiDetectXnKillDummy=null
if durationIterations<=0 then
set durationIterations=48
endif
if p5==null or m5==null or GetUnitTypeId(p5)==0 or GetUnitTypeId(m5)==0 then
call FlushChildHashtable(L7,(OB7))
call OZ7(t)
set t=null
set p5=null
set m5=null
return false
endif
set x=GetUnitX(m5)
set y=GetUnitY(m5)
set d=SquareRoot((xN-x)*(xN-x)+(xo-y)*(xo-y))
set O5=GetPlayerId(GetOwningPlayer(m5))
set B39=(.1+.3*V77)*d
set BANITEM[O5]=false
if GetTriggerEventId()==EVENT_WIDGET_DEATH or OT7(m5,"EGG") then
call UnitRemoveAbility(m5,'A0IH')
call UnitRemoveAbility(m5,'B08L')
call FlushChildHashtable(L7,(OB7))
call OZ7(t)
set t=null
set p5=null
set m5=null
return false
endif
if d>2000 then
set B39=0
endif
if B39>5 and CHUIFENG(m5)==false then
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl",m5,"origin"))
endif
if((LoadInteger(L7,(GetHandleId((m5))),((2485))))==1)and B39>=GetUnitState(m5,UNIT_STATE_LIFE)-2 then
set B39=GetUnitState(m5,UNIT_STATE_LIFE)-2
endif
if KW7(m5)then
set B39=0
endif
if B39>0 and XH7(m5)==false and CHUIFENG(m5)==false then
	set BANITEM[O5]=true
	call B67(p5,m5,2,0.01)
	call SetUnitState(m5,UNIT_STATE_LIFE,RMaxBJ(GetUnitState(m5,UNIT_STATE_LIFE)-B39,1))
	if GetUnitState(m5,UNIT_STATE_LIFE)<2 and OT7(m5,"ShallowGrave|Active")==false then
		set XMGL_KILL=true
call RFD(p5,m5)
call UnitRemoveBuffs(m5,true,true)
call UnitRemoveAbility(m5,'Aetl')
set suijiDetectXnKillDummy=CreateUnit(GetOwningPlayer(p5),'e00E',0,0,0)
call UnitDamageTarget(suijiDetectXnKillDummy,m5,100000000.,true,false,ATTACK_TYPE_MELEE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
call UnitApplyTimedLife(suijiDetectXnKillDummy,'BTLF',1.)
		set XMGL_KILL=false
	endif
	call Add_EX_PlayerDamage(p5,m5,B39)
endif
call NQ7(OB7,"LastX",x)
call NQ7(OB7,"LastY",y)
call NP7(OB7,"Iteration",QI+1)
if XH7(m5)then
call NM7(OB7)
call OZ7(t)
elseif QI>durationIterations then
call UnitRemoveAbility(m5,'A0IH')
call UnitRemoveAbility(m5,'B08L')
call NM7(OB7)
call OZ7(t)
endif
set t=null
set p5=null
set m5=null
set suijiDetectXnKillDummy=null
return false
endfunction
function xp takes nothing returns nothing
