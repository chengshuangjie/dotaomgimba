function BOZANG_CAST2 takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local unit IH7=GetSpellTargetUnit()
local group g
local real x
local real y
if IH7!=null then
    set Unit_BZ=IH7
else
    set x=GetSpellTargetX()
    set y=GetSpellTargetY()
    set g=WS7()
    set U22=ZX7
    call GroupEnumUnitsInRange(g,x,y,400,Condition(function BGX))
    set IH7=Get_LowHP_Friend_PD(g)
    if IH7!=null then
        set Unit_BZ=IH7
    else
        call KR7(ZX7)
        call X37(GetOwningPlayer(GetTriggerUnit()),"附近没有友方英雄")
    endif
    call WR7(g)
endif
set ZX7=null
set IH7=null
set g=null
endfunction
