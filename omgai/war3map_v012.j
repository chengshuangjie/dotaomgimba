// 	local timer t
// 	local integer TME = GetPlayerId(p)
// 	if GetItemTypeId(it)== LoadInteger(TABLE_P,'ITEM', TME) and GetGameTime()-LoadReal(TABLE_P,'ITEM', TME)< 11. and Alreay_Use(it)==false then
// 		set t = CreateTimer()
// 		call TimerStart(t, 0, false, function OHO)
// 		call SavePlayerHandle(TABLE_HY, GetHandleId(t), 0, p)
