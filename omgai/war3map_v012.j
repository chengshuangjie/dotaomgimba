//极度饥渴
function RZD takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit WI7=O77(OB7,"Hero")
// if GetTriggerEventId()!=EVENT_PLAYER_UNIT_SPELL_EFFECT or(GetTriggerEventId()==EVENT_PLAYER_UNIT_SPELL_EFFECT and YA8(B287_GetSpellAbilityId())and GetSpellTargetUnit()==WI7)then
if WI7==null or GetUnitTypeId(WI7)==0 then
call DestroyEffect(OG7(OB7,"FX"))
call NM7(OB7)
call OZ7(t)
set t=null
set WI7=null
return false
endif
if XH7(WI7)==false then
call UnitRemoveAbility(WI7,'A0WR')
call UnitRemoveAbility(WI7,'B01E')
endif
call DestroyEffect(OG7(OB7,"FX"))
call NM7(OB7)
call OZ7(t)
// endif
set t=null
set WI7=null
return false
endfunction
function RAD takes nothing returns nothing
local trigger t=null
local integer OB7=0
local unit WI7=GetTriggerUnit()
if WI7==null or GetUnitTypeId(WI7)==0 then
set WI7=null
return
endif
set t=CreateTrigger()
set OB7=GetHandleId(t)
call TriggerRegisterTimerEvent(t,20,false)
// call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function RZD))
call NT7(OB7,"Hero",WI7)
call NU7(OB7,"FX",AddSpecialEffectTarget("Abilities\\Spells\\Items\\VampiricPotion\\VampPotionCaster.mdl",WI7,"origin"))
call XF7(WI7,'A0WR')
call SetUnitAbilityLevel(WI7,'A0WR',B287_GetUnitAbilityLevel(WI7,'A0WQ'))
call SetPlayerAbilityAvailable(GetOwningPlayer(WI7),'A0WR',false)
set t=null
set WI7=null
