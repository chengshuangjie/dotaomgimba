call DisplayTextToPlayer(GetTriggerPlayer(),0,0,"添加特效方法：|cFF00FF00-tx 1~35|r (一共35种)\n使用 -cxtx 查询特效具体效果\n使用 -qx 取消所有特效")
endif
set u=null
endfunction
