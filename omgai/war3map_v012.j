function M0D takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local unit BB7=(LoadUnitHandle(L7,(I97),(19)))
local real x=0.
local real y=0.
local unit M5D=(LoadUnitHandle(L7,(I97),(675)))
local unit M2D=(LoadUnitHandle(L7,(I97),(676)))
local real a=(LoadReal(L7,(I97),($D)))
local real d=(LoadReal(L7,(I97),(433)))
local integer BC7=(LoadInteger(L7,(I97),(5)))
local group BQ9=(LoadGroupHandle(L7,(I97),($BB)))
local group g=WS7()
local boolexpr suijiTwinProjectileFilter=null
if ZX7==null or BB7==null or M5D==null or M2D==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(BB7)==0 or GetUnitTypeId(M5D)==0 or GetUnitTypeId(M2D)==0 then
if M5D!=null and GetUnitTypeId(M5D)!=0 then
call KillUnit(M5D)
endif
if M2D!=null and GetUnitTypeId(M2D)!=0 then
call KillUnit(M2D)
endif
if BB7!=null and GetUnitTypeId(BB7)!=0 then
call KillUnit(BB7)
endif
if BQ9!=null then
call WR7(BQ9)
endif
call WR7(g)
call FlushChildHashtable(L7,(I97))
call OZ7(t)
set t=null
set ZX7=null
set BB7=null
set M5D=null
set M2D=null
set BQ9=null
set g=null
return false
endif
set x=GetUnitX(ZX7)
set y=GetUnitY(ZX7)
set suijiTwinProjectileFilter=Condition(function AJ7_gai)
if GetTriggerEvalCount(t)<=50 then
set a=a+20
set d=d+7
call SaveReal(L7,(I97),($D),((a)*1.))
call SaveReal(L7,(I97),(433),((d)*1.))
elseif GetTriggerEvalCount(t)<=100 then
set a=a+20
set d=d-7
call SaveReal(L7,(I97),($D),((a)*1.))
call SaveReal(L7,(I97),(433),((d)*1.))
endif
call SetUnitX(M5D,X17(x+d*Cos(a*bj_DEGTORAD)))
call SetUnitY(M5D,X07(y+d*Sin(a*bj_DEGTORAD)))
set a=a+$B4
call SetUnitX(M2D,X17(x+d*Cos(a*bj_DEGTORAD)))
call SetUnitY(M2D,X07(y+d*Sin(a*bj_DEGTORAD)))
set IN4=ZX7
set Z84=ZX7
set Z94=BB7
set ZE4=BQ9
set ZF4=BC7
call GroupEnumUnitsInRange(g,GetUnitX(M5D),GetUnitY(M5D),125,suijiTwinProjectileFilter)
call ForGroup(g,function M1D)
set IN4=ZX7
call GroupEnumUnitsInRange(g,GetUnitX(M2D),GetUnitY(M2D),125,suijiTwinProjectileFilter)
call ForGroup(g,function M1D)
call WR7(g)
call DestroyBoolExpr(suijiTwinProjectileFilter)
if GetTriggerEvalCount(t)>100 then
call KillUnit(M5D)
call KillUnit(M2D)
call KillUnit(BB7)
call WR7(BQ9)
call FlushChildHashtable(L7,(I97))
call OZ7(t)
endif
set t=null
set ZX7=null
set M5D=null
set M2D=null
set BB7=null
set BQ9=null
set g=null
set suijiTwinProjectileFilter=null
return false
endfunction
function M_D takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local real x=0.
local real y=0.
local unit M5D=null
local unit M2D=null
local trigger t=null
local integer I97=0
local unit BB7=null
if ZX7==null or GetUnitTypeId(ZX7)==0 then
set ZX7=null
return
endif
set x=GetUnitX(ZX7)
set y=GetUnitY(ZX7)
set M5D=CreateUnit(GetOwningPlayer(ZX7),'e02Y',x,y,0)
set M2D=CreateUnit(GetOwningPlayer(ZX7),'e02Y',x,y,0)
set t=CreateTrigger()
set I97=GetHandleId(t)
set BB7=CreateUnit(GetOwningPlayer(ZX7),'e00E',x,y,0)
call SaveUnitHandle(L7,(I97),(2),(ZX7))
call SaveUnitHandle(L7,(I97),(19),(BB7))
call SaveUnitHandle(L7,(I97),(675),(M5D))
call SaveUnitHandle(L7,(I97),(676),(M2D))
call SaveReal(L7,(I97),($D),((0)*1.))
call SaveReal(L7,(I97),(433),((0)*1.))
call SaveInteger(L7,I97,5,GetUnitAbilityLevel(ZX7,'A21N'))
call SaveGroupHandle(L7,(I97),($BB),(WS7()))
call TriggerRegisterTimerEvent(t,.03,true)
call TriggerAddCondition(t,Condition(function M0D))
call EnableAttackEffectByTime(16, 12.)
set ZX7=null
set M5D=null
set M2D=null
set t=null
set BB7=null
endfunction
