function B7D takes nothing returns nothing
local unit IH7=GetEnumUnit()
if CHUIFENG(IH7) then
    call UnitCancelHide(IH7)
endif
call GroupAddUnit(RJ4,IH7)
call IssueTargetOrderById(RH4,$D008F,IH7)
if GetUnitAbilityLevel(IH7,'B0BQ')==1 and GetUnitAbilityLevel(IH7,'A2YL')==0 then
call Z57(IH7,'A2YL',1,5,0)
endif
set IH7=null
endfunction
function B8D takes unit ZX7,unit IH7 returns boolean
local real a=J47(IH7,ZX7)
local real B9D=GetUnitFacing(IH7)
local real c1
local real c2
local real d1=-1.
local real d2=-1.
local real e1
local real e2
local real f1=-1.
local real f2=-1.
if IsUnitVisible(ZX7,GetOwningPlayer(IH7))==false then
return false
endif
set c1=RMaxBJ(B9D-75,0)
set c2=B9D
if B9D-75<=0 then
set d1=360-(75-(c2-c1))
set d2=360
endif
set e1=B9D
set e2=RMinBJ(B9D+75,360)
if B9D+75>=360 then
set f1=0
set f2=0+(75-(e2-e1))
endif
if a<0 then
set a=a+360
elseif a>360 then
set a=a-360
endif
if(a>c1 and a<c2)or(d1!=-1 and a>d1 and a<d2)or(a>e1 and a<e2)or(f1!=-1 and a>f1 and a<f2)then
return true
endif
return false
endfunction
function BDD takes nothing returns boolean
return (IsUnitEnemy(IN4,GetOwningPlayer(GetFilterUnit())) and (GetUnitAbilityLevel(GetFilterUnit(),'A04R')==0 or CHUIFENG(GetFilterUnit())) and IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==false and XH7(GetFilterUnit())==false and (IsUnitType(GetFilterUnit(),UNIT_TYPE_ANCIENT)==false or Z_7(GetFilterUnit())) and IsUnitInGroup(GetFilterUnit(),RJ4)==false and B8D(IN4,GetFilterUnit()) and GetUnitAbilityLevel(GetFilterUnit(),'B0BQ')==0)!=null
endfunction
function BED takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=O77(I97,"Source")
local integer BC7=0
local unit BB7=O77(I97,"Caster")
local group g=WS7()
local group BQ9=OF7(I97,"AlreadyHit")
local boolexpr suijiStoneGazeEnemyFilter=null
if ZX7==null or UnitAlive(ZX7)==false or IsHideUnit(ZX7) or GetUnitAbilityLevel(ZX7,'Avul')>0 then
call WR7(g)
call DestroyEffect(OG7(I97,"FX"))
if BB7!=null then
call RemoveUnit(BB7)
endif
call OZ7(t)
call NM7(I97)
call WR7(BQ9)
set ZX7=null
set BB7=null
set g=null
set t=null
set BQ9=null
return false
endif
set BC7=B287_GetUnitAbilityLevel(ZX7,'A1AT')
set RH4=BB7
set RI4=ZX7
set IN4=ZX7
set RJ4=BQ9
set suijiStoneGazeEnemyFilter=Condition(function BDD)
call GroupEnumUnitsInRange(g,GetUnitX(ZX7),GetUnitY(ZX7),725+100*BC7,suijiStoneGazeEnemyFilter)
call DestroyBoolExpr(suijiStoneGazeEnemyFilter)
call ForGroup(g,function B7D)
call WR7(g)
call DestroyEffect(OG7(I97,"FX"))
if GetTriggerEvalCount(t)>100 then
if BB7!=null then
call RemoveUnit(BB7)
endif
call OZ7(t)
call NM7(I97)
call WR7(BQ9)
else
call NU7(I97,"FX",AddSpecialEffectTarget("Abilities\\Spells\\Orc\\EtherealForm\\SpiritWalkerChange.mdl",ZX7,"chest"))
endif
set ZX7=null
set BB7=null
set g=null
set t=null
set BQ9=null
set suijiStoneGazeEnemyFilter=null
return false
endfunction
function BFD takes nothing returns nothing
local trigger t=null
local integer I97=0
local unit suijiStoneGazeCaster=GetTriggerUnit()
local unit BB7=null
if suijiStoneGazeCaster==null or GetUnitTypeId(suijiStoneGazeCaster)==0 then
set suijiStoneGazeCaster=null
return
endif
set t=CreateTrigger()
set I97=GetHandleId(t)
set BB7=CreateUnit(GetOwningPlayer(suijiStoneGazeCaster),'e00E',GetUnitX(suijiStoneGazeCaster),GetUnitY(suijiStoneGazeCaster),0)
call TriggerRegisterTimerEvent(t,.05,true)
call TriggerAddCondition(t,Condition(function BED))
call NT7(I97,"Source",suijiStoneGazeCaster)
call NT7(I97,"Caster",BB7)
call XF7(BB7,'A02V')
call NB7(I97,"AlreadyHit",WS7())
call NU7(I97,"FX",AddSpecialEffectTarget("Abilities\\Spells\\Orc\\EtherealForm\\SpiritWalkerChange.mdl",suijiStoneGazeCaster,"chest"))
call SetUnitAbilityLevel(BB7,'A02V',B287_GetUnitAbilityLevel(suijiStoneGazeCaster,'A1AT'))
call TriggerEvaluate(t)
set t=null
set BB7=null
set suijiStoneGazeCaster=null
endfunction
