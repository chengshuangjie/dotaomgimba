function XOO takes unit KKX, integer XRO, player p returns nothing
	local integer i = 0
	local item it
	local integer k = 0
	local integer Z6X = 0
	local integer j
	local integer Z7X
	local integer Z8X
	local unit Y1X = LoadUnitHandle(TABLE_K, GetHandleId(p),'COUR')
	local integer id
	local unit d
	local real x
	local real y
	if XRO ==-1 or GetPlayerSlotState(p)== PLAYER_SLOT_STATE_LEFT then
		set it = null
		set Y1X = null
		set d = null
		return
	endif
	//if Y1X == null then
	//	set Y1X = HJX(p)  //判断其他信使
	//endif
	//if Y1X == null then
	//	set Y1X = HJX(p)  //判断其他信使
	//endif
	//if Y1X == null then
	//	set Y1X = HJX(p)  //判断其他信使
	//endif
	call FlushChildHashtable(TABLE_HY,'ITEM')
	loop
		if Y1X != null then
			set it = UnitItemInSlot(Y1X, i)
			if it != null and (GetItemPlayer(it)==p or PK4) then
				call SaveItemHandle(TABLE_HY,'ITEM', k, it)
				call SaveInteger(TABLE_HY,'ITEM', k, KY7(it))
				set k = k + 1
			endif
		endif
        if KKX != Y1X then
		    set it = UnitItemInSlot(KKX, i)
		    if it != null and (GetItemPlayer(it)==p or PK4) then
			    call SaveItemHandle(TABLE_HY,'ITEM', k, it)
			    call SaveInteger(TABLE_HY,'ITEM', k, KY7(it))
			    set k = k + 1
		    endif
        endif
		if KKX != M7[GetPlayerId(p)] then
			set it = UnitItemInSlot(M7[GetPlayerId(p)], i)
			if it != null and (GetItemPlayer(it)==p or PK4) then
				call SaveItemHandle(TABLE_HY,'ITEM', k, it)
				call SaveInteger(TABLE_HY,'ITEM', k, KY7(it))
				set k = k + 1
			endif
		endif
		set i = i + 1
	exitwhen i > 5
	endloop
	set E33 = p
	set Q22 = 0
	if TV7(p) then
		call EnumItemsInRect(WAA, Condition(function E9O), function XVO)
	else
		call EnumItemsInRect(YAA, Condition(function E9O), function XVO)
	endif
	set i = Q22
	loop
	exitwhen i < 0
		if HaveSavedHandle(TABLE_VV,'ITEM', i) then
			call SaveItemHandle(TABLE_HY,'ITEM', k, LoadItemHandle(TABLE_VV,'ITEM', i))
			call SaveInteger(TABLE_HY,'ITEM', k, KY7(LoadItemHandle(TABLE_VV,'ITEM', i)))
			call RemoveSavedHandle(TABLE_VV,'ITEM', i)
			set k = k + 1
		endif
		set i = i -1
	endloop
	set it = null
	set Z6X = k
    set XRO=YJGM_EXTRA_PD(XRO)
	set k = XRO
	call SaveInteger(TABLE_HY,'ITEM', 51, FJ4[k])
	call SaveInteger(TABLE_HY,'ITEM', 52, FK4[k])
	call SaveInteger(TABLE_HY,'ITEM', 53, FM4[k])
	call SaveInteger(TABLE_HY,'ITEM', 54, FN4[k])
	call SaveInteger(TABLE_HY,'ITEM', 55, FO4[k])
	set Z8X = 0
	set Z7X = 0
	set i = 0
	if FJ4[k]!= 0 then
		set Z7X = Z7X + 1
	endif
	if FK4[k]!= 0 then
		set Z7X = Z7X + 1
	endif
	if FM4[k]!= 0 then
		set Z7X = Z7X + 1
	endif
	if FN4[k]!= 0 then
		set Z7X = Z7X + 1
	endif
	if FO4[k]!= 0 then
		set Z7X = Z7X + 1
	endif
	loop
		set j = LoadInteger(TABLE_HY,'ITEM', i)
		if j > 0 and LoadBoolean(TABLE_HY,'ITEM', i)== false then
			if(j == LoadInteger(TABLE_HY,'ITEM', 51) and Z2X(TABLE_HY,'ITEM', 51)) or(j == LoadInteger(TABLE_HY,'ITEM', 52) and Z2X(TABLE_HY,'ITEM', 52)) or(j == LoadInteger(TABLE_HY,'ITEM', 53) and Z2X(TABLE_HY,'ITEM', 53)) or(j == LoadInteger(TABLE_HY,'ITEM', 54) and Z2X(TABLE_HY,'ITEM', 54)) or(j == LoadInteger(TABLE_HY,'ITEM', 55) and Z2X(TABLE_HY,'ITEM', 55)) then
				call SaveItemHandle(TABLE_HY,'ITEM', 100 + Z8X, LoadItemHandle(TABLE_HY,'ITEM', i))
				call SaveBoolean(TABLE_HY,'ITEM', i, true)
				call SaveInteger(TABLE_HY,'ITEM',$C8+ Z8X, i)
				set Z8X = Z8X + 1
			endif
		endif
		set i = i + 1
	exitwhen i >= Z6X
	endloop
	if Z8X != Z7X then
		set id = LoadInteger(TABLE_HY,'ITEM', 51)
		if id != 0 then
			if E8O(KKX, id) then
				set Z7X = Z7X + 1
			endif
		endif
		set id = LoadInteger(TABLE_HY,'ITEM', 52)
		if id != 0 then
			if E8O(KKX, id) then
				set Z7X = Z7X + 1
			endif
		endif
		set id = LoadInteger(TABLE_HY,'ITEM', 53)
		if id != 0 then
			if E8O(KKX, id) then
				set Z7X = Z7X + 1
			endif
		endif
		set id = LoadInteger(TABLE_HY,'ITEM', 54)
		if id != 0 then
			if E8O(KKX, id) then
				set Z7X = Z7X + 1
			endif
		endif
		set id = LoadInteger(TABLE_HY,'ITEM', 55)
		if id != 0 then
			if E8O(KKX, id) then
				set Z7X = Z7X + 1
			endif
		endif
		if Z8X == Z7X then
			set i = 100 
			loop
				call UnitAddItem(LoadUnitHandle(TABLE_K, GetHandleId(GetOwningPlayer(KKX)),'COUR'+ 1), LoadItemHandle(TABLE_HY,'ITEM', i))
				call RemoveSavedHandle(TABLE_HY,'ITEM', i)
				set i = i + 1
			exitwhen HaveSavedHandle(TABLE_HY,'ITEM', i)== false
			endloop
		endif
		set d = LoadUnitHandle(TABLE_K, GetHandleId(GetOwningPlayer(KKX)),'COUR'+ 1)
		if true then
			set x = GetUnitX(d)
			set y = GetUnitY(d)
			call SetUnitX(d, GetUnitX(KKX))
			call SetUnitY(d, GetUnitY(KKX))
			if UnitAlive(KKX) and (IsUnitInRange(KKX, IZ4,2100) or IsUnitInRange(KKX, JA4,2100)) then
				call Z3X(d, KKX, true, k)
				if YRE(KKX)> 0 then
					call UnitDropItemTarget(d, UnitItemInSlot(d, 0), KKX)
				endif
				if YRE(KKX)> 0 then
					call UnitDropItemTarget(d, UnitItemInSlot(d, 1), KKX)
				endif
				if YRE(KKX)> 0 then
					call UnitDropItemTarget(d, UnitItemInSlot(d, 2), KKX)
				endif
				if YRE(KKX)> 0 then
					call UnitDropItemTarget(d, UnitItemInSlot(d, 3), KKX)
				endif
				if YRE(KKX)> 0 then
					call UnitDropItemTarget(d, UnitItemInSlot(d, 4), KKX)
				endif
				if YRE(KKX)> 0 then
					call UnitDropItemTarget(d, UnitItemInSlot(d, 5), KKX)
				endif
			elseif Y1X != null and UnitAlive(Y1X) and(IsUnitInRangeXY(Y1X, GetRectCenterX(WAA), GetRectCenterY(WAA),$640) or IsUnitInRangeXY(Y1X, GetRectCenterX(YAA), GetRectCenterY(YAA),$640)) then
				call SetUnitX(d, GetUnitX(Y1X))
				call SetUnitY(d, GetUnitY(Y1X))
				call Z3X(d, Y1X, true, k)
				if YRE(Y1X)> 0 then
					call UnitDropItemTarget(d, UnitItemInSlot(d, 0), Y1X)
				endif
				if YRE(Y1X)> 0 then
					call UnitDropItemTarget(d, UnitItemInSlot(d, 1), Y1X)
				endif
				if YRE(Y1X)> 0 then
					call UnitDropItemTarget(d, UnitItemInSlot(d, 2), Y1X)
				endif
				if YRE(Y1X)> 0 then
					call UnitDropItemTarget(d, UnitItemInSlot(d, 3), Y1X)
				endif
				if YRE(Y1X)> 0 then
					call UnitDropItemTarget(d, UnitItemInSlot(d, 4), Y1X)
				endif
				if YRE(Y1X)> 0 then
					call UnitDropItemTarget(d, UnitItemInSlot(d, 5), Y1X)
				endif
			endif
			call SetUnitX(d, x)
			call SetUnitY(d, y)
		endif
		call E4O(d)
		set d = null
	endif
	call UnitRemoveAbility(LoadUnitHandle(TABLE_K, GetHandleId(GetOwningPlayer(KKX)),'COUR'+ 1),'AInv')
	call UnitAddAbility(LoadUnitHandle(TABLE_K, GetHandleId(GetOwningPlayer(KKX)),'COUR'+ 1),'AInv')
	set Y1X = null
	set it = null
	set d = null
endfunction
