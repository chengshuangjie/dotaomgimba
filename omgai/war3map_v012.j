//盛势闪光
function SSSG takes unit u returns nothing
    local timer t=CreateTimer()
    local integer I97=GetHandleId(t)
    call SaveUnitHandle(L7,I97,0,u)
    call TimerStart(t,0,false,function SSSG2)
    set t=null
endfunction
//迅疾闪光
function XJSG2 takes nothing returns nothing
	local trigger t = GetTriggeringTrigger()
	local integer h = GetHandleId(t)
	local unit u = LoadUnitHandle(TABLE_HY, h, 0)
	local integer hu = GetHandleId(u)
	local real X_A = LoadReal(TABLE_HY, h, 0)
	if GetTriggerEventId()== EVENT_WIDGET_DEATH or(GetUnitAbilityLevel(u,'B0K4')== 0 and GetTriggerEvalCount(t)> 2) or GetGameTime()>= X_A then
		call RemoveSavedHandle(TABLE_HY, hu,'A4HS')
		call SetUnitPhaseMove( u, false )
		call FlushChildHashtable(TABLE_HY, h)
		call OZ7(t)
	endif
	set t = null
	set u = null
endfunction
function XJSG takes unit u returns nothing
	local trigger t
	local integer h
	local integer hu = GetHandleId(u)
    call Z57(u,'A4HU',1,5,'B0K4')
    call Z57(u,'A4HV',1,5,0)
	if HaveSavedHandle(TABLE_HY, hu,'A4HS') then
		set t = LoadTriggerHandle(TABLE_HY, hu,'A4HS')
		set h = GetHandleId(t)
	else
		set t = CreateTrigger()
		set h = GetHandleId(t)
		call SetUnitPhaseMove( u, true )
		call TriggerRegisterTimerEvent(t, .02, true)
		call TriggerRegisterDeathEvent(t, u)
		call TriggerAddCondition(t, Condition(function XJSG2))
		call SaveTriggerHandle(TABLE_HY, hu,'A4HS', t)
		call SaveUnitHandle(TABLE_HY, h, 0, u)
	endif
	call SaveReal(TABLE_HY, h, 0, GetGameTime()+ 5.)
	set t = null
endfunction
function GetHeroCast takes unit u returns real
    local real herocast=0
	if HaveSavedReal(TABLE_U, GetUnitTypeId(u),'CAST')==false then
        set herocast = MHUnit_GetDefDataReal(GetUnitTypeId(u),UNIT_DEF_DATA_CAST_POINT)
		call SaveReal(TABLE_U, GetUnitTypeId(u),'CAST', herocast)
	else
		set herocast = LoadReal(TABLE_U, GetUnitTypeId(u),'CAST')
	endif
    return herocast
endfunction
function GetHeroSkill takes unit u,integer i returns integer
    return LoadInteger(MSK,GetUnitPointValue(u),i)
endfunction
//排除已设置过前摇的技能
function BAN_Skill_Cast takes integer skill returns boolean
    return skill!='A3RD' and skill!='A0RP' and skill!='A0RT' and skill!='A04P' and skill!='A1AU' and skill!='A2W7' and skill!='A4IT' and skill!='A4KK' and skill!='A0SB' and skill!='A4LZ'
endfunction
function SetSkillCast takes unit u,boolean b returns nothing
    local integer i=1
    local integer skill
    local real skillcast
    local real herocast=GetHeroCast(u)
    // call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "|c00FF8000默认施法前摇是|r"+R2S(herocast))
    loop
    exitwhen i>10
        set skill=GetHeroSkill(u,i)
        set skillcast=MHAbility_GetCastpoint(u,skill)
        if GetUnitAbilityLevel(u,skill)>0 and skillcast>0 and herocast>0 and BAN_Skill_Cast(skill) then
            if b then
                if skillcast==herocast then
                    call MHAbility_SetCastpoint(u,skill,herocast*.5)
                endif
            else
                if skillcast<herocast then
                    call MHAbility_SetCastpoint(u,skill,herocast)
                endif
            endif 
        endif               
        set i=i+1
    endloop
endfunction
function MASG_TRI2 takes nothing returns nothing
local unit ZX7=GetEnumUnit()
if IsUnitType(ZX7,UNIT_TYPE_HERO) and IsUnitIllusion(ZX7)==false then
    if GetUnitAbilityLevel(ZX7,'A2YR')>0 then
        call SetSkillCast(ZX7,true)
    else
        call SetSkillCast(ZX7,false)
    endif
endif
set ZX7=null
endfunction
function MASG_TRI takes nothing returns boolean
local group g=WS7()
call GroupAddGroup(PlayerUnitGroup,g)
call ForGroup(g,function MASG_TRI2)
call WR7(g)
set g=null
return false
endfunction
