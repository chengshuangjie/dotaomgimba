call KLG(m5,WI7,p5,false,LoadInteger(dvv,'A1MV',0),false,false)
elseif p5!=null and GetUnitTypeId(p5)!=0 then
call UnitRemoveAbility(p5,'B0BI')
endif
call FlushChildHashtable(dvv,'A1MV')
set WI7=null
set p5=null
set m5=null
endfunction
