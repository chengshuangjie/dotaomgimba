function SuijiSuperAI_IsEnemyAI takes player p returns boolean
local integer i=0
if p==null or GetPlayerController(p)!=MAP_CONTROL_COMPUTER then
return false
endif
loop
exitwhen i>$B
if GetPlayerSlotState(Player(i))==PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(i))==MAP_CONTROL_USER and IsPlayerEnemy(p,Player(i)) then
return true
endif
set i=i+1
endloop
return false
endfunction
function SuijiSuperAI_HumanMulticastQuota takes nothing returns integer
local integer i=0
local integer h=0
local integer quota=0
local unit hero=null
local player human=null
loop
exitwhen i>$B
set human=Player(i)
if GetPlayerSlotState(human)==PLAYER_SLOT_STATE_PLAYING and GetPlayerController(human)==MAP_CONTROL_USER then
set hero=M7[i]
if hero!=null and GetUnitTypeId(hero)!=0 then
set h=GetHandleId(hero)
if SuijiMode_HasChosenMulticast(h) then
set quota=quota+1
endif
endif
endif
set i=i+1
endloop
set hero=null
set human=null
return quota
endfunction
function SuijiSuperAI_HumanEnemyMulticastQuota takes player ai returns integer
local integer i=0
local integer h=0
local integer quota=0
local unit hero=null
local player human=null
if ai==null then
return 0
endif
loop
exitwhen i>$B
set human=Player(i)
if GetPlayerSlotState(human)==PLAYER_SLOT_STATE_PLAYING and GetPlayerController(human)==MAP_CONTROL_USER and IsPlayerEnemy(ai,human) then
set hero=M7[i]
if hero!=null and GetUnitTypeId(hero)!=0 then
set h=GetHandleId(hero)
if SuijiMode_HasChosenMulticast(h) then
set quota=quota+1
endif
endif
endif
set i=i+1
endloop
set hero=null
set human=null
return quota
endfunction
function SuijiSuperAI_HumanAllyMulticastQuota takes player humanOwner returns integer
local integer i=0
local integer h=0
local integer quota=0
local unit hero=null
local player human=null
if humanOwner==null then
return 0
endif
loop
exitwhen i>$B
set human=Player(i)
if GetPlayerSlotState(human)==PLAYER_SLOT_STATE_PLAYING and GetPlayerController(human)==MAP_CONTROL_USER and IsPlayerAlly(humanOwner,human) then
set hero=M7[i]
if hero!=null and GetUnitTypeId(hero)!=0 then
set h=GetHandleId(hero)
if SuijiMode_HasChosenMulticast(h) then
set quota=quota+1
endif
endif
endif
set i=i+1
endloop
set hero=null
set human=null
return quota
endfunction
function SuijiSuperAI_EnemyAIRank takes player ai returns integer
local integer floor=1
local integer rank=0
local player current=null
if ai==null then
return 0
endif
loop
exitwhen floor>10
set current=K27(floor)
if current!=null and GetPlayerSlotState(current)==PLAYER_SLOT_STATE_PLAYING and GetPlayerController(current)==MAP_CONTROL_COMPUTER and IsPlayerAlly(current,ai) and SuijiSuperAI_IsEnemyAI(current) then
set rank=rank+1
if current==ai then
set current=null
return rank
endif
endif
set floor=floor+1
endloop
set current=null
return 0
endfunction
function SuijiSuperAI_FindEnemyAIFloor takes player humanOwner,integer wantedRank returns integer
local integer floor=1
local integer rank=0
local player current=null
if humanOwner==null or wantedRank<=0 then
return 0
endif
loop
exitwhen floor>10
set current=K27(floor)
if current!=null and GetPlayerSlotState(current)==PLAYER_SLOT_STATE_PLAYING and GetPlayerController(current)==MAP_CONTROL_COMPUTER and IsPlayerEnemy(current,humanOwner) then
set rank=rank+1
if rank==wantedRank then
set current=null
return floor
endif
endif
set floor=floor+1
endloop
set current=null
return 0
endfunction
function SuijiSuperAI_IsMulticastReserved takes player ai returns boolean
local integer quota=SuijiSuperAI_HumanEnemyMulticastQuota(ai)
local integer rank=SuijiSuperAI_EnemyAIRank(ai)
return quota>0 and rank>0 and rank<=quota
endfunction
function SuijiSuperAI_BaseChanceEnabled takes player ai returns boolean
local integer team=0
local integer enabledKey=StringHash("SuijiSuperAIBaseChance")
local integer rolledKey=StringHash("SuijiSuperAIBaseChanceRolled")
if ai==null then
return false
endif
if i5(ai)<=5 then
set team=1
else
set team=2
endif
if LoadBoolean(L7,rolledKey,team)==false then
call SaveBoolean(L7,rolledKey,team,true)
call SaveBoolean(L7,enabledKey,team,GetRandomInt(1,100)<=SuijiSuperAI_Chance())
endif
return LoadBoolean(L7,enabledKey,team)
endfunction
function SuijiSuperAI_HeroTaken takes integer pid,integer hero returns boolean
local integer i=0
local unit u=null
if hero==0 then
return true
endif
loop
exitwhen i>$B
if i!=pid then
if SuijiSuperAI_PresetHero(i)==hero then
return true
endif
set u=M7[i]
if u!=null and GetUnitTypeId(u)==hero then
set u=null
return true
endif
endif
set i=i+1
endloop
set u=null
return false
endfunction
function SuijiSuperAI_Roll takes player p returns nothing
local integer pid=0
local integer combo=0
local integer hero=0
local integer small=0
local integer ult=0
local integer heroIndex=0
local integer offset=0
local integer firstCombo=0
local integer quota=0
local integer rank=0
local boolean found=false
local boolean multicastReserved=false
if p==null or SUIJI_MODE==false or GetPlayerController(p)!=MAP_CONTROL_COMPUTER then
return
endif
set pid=GetPlayerId(p)
call SuijiSuperAI_ClearPreset(pid)
if SuijiSuperAI_IsEnemyAI(p)==false then
return
endif
set quota=SuijiSuperAI_HumanEnemyMulticastQuota(p)
set rank=SuijiSuperAI_EnemyAIRank(p)
set multicastReserved=SuijiSuperAI_IsMulticastReserved(p)
if multicastReserved==false then
// The normal 10% roll (100% in -test) creates at most one super AI.  Human
// multicast choices deterministically reserve the first N enemy AI floors.
if quota>0 or rank!=1 or SuijiSuperAI_BaseChanceEnabled(p)==false then
return
endif
endif
set firstCombo=GetRandomInt(1,SuijiSuperAI_PoolSize())
loop
exitwhen offset>=SuijiSuperAI_PoolSize() or found
set combo=ModuloInteger(firstCombo+offset-2,SuijiSuperAI_PoolSize())+1
set hero=SuijiSuperAI_PoolHero(combo)
set heroIndex=SuijiTest_FindHeroIndex(hero)
if heroIndex>0 and J[heroIndex]==false and SuijiSuperAI_HeroTaken(pid,hero)==false then
set small=SuijiSuperAI_PoolSmall(combo)
set ult=SuijiSuperAI_PoolUlt(combo)
set found=true
endif
set offset=offset+1
endloop
if found==false then
return
endif
call SaveInteger(L7,StringHash("SuijiSuperAIHero"),pid,hero)
call SaveInteger(L7,StringHash("SuijiSuperAISmall"),pid,small)
call SaveInteger(L7,StringHash("SuijiSuperAIUlt"),pid,ult)
endfunction
function SuijiSuperAI_Announce takes unit u returns nothing
local integer pid=0
if u==null then
return
endif
set pid=GetPlayerId(GetOwningPlayer(u))
if SuijiSuperAI_HasPreset(pid)==false or LoadBoolean(L7,StringHash("SuijiSuperAIAnnounced"),pid) then
return
endif
call SaveBoolean(L7,StringHash("SuijiSuperAIAnnounced"),pid,true)
call VV7(bj_FORCE_ALL_PLAYERS,12.,"|cFFFF0000敌方第"+I2S(i5(GetOwningPlayer(u)))+"楼出现一位超级AI！|r "+GetPlayerName(GetOwningPlayer(u))+" 的 "+GetUnitName(u)+" 获得 |cFFFFCC00"+GetAbilityName(SuijiSuperAI_PresetSmall(pid))+"|r 和 |cFFFFCC00"+GetAbilityName(SuijiSuperAI_PresetUlt(pid))+"|r")
endfunction
function SuijiSuperAI_NotifyMulticastSelection takes unit selector returns nothing
local player owner=null
local integer quota=0
local integer floor=0
if selector==null or GetUnitTypeId(selector)==0 then
return
endif
set owner=GetOwningPlayer(selector)
if GetPlayerController(owner)!=MAP_CONTROL_USER then
set owner=null
return
endif
set quota=SuijiSuperAI_HumanAllyMulticastQuota(owner)
set floor=SuijiSuperAI_FindEnemyAIFloor(owner,quota)
if floor>0 then
call VV7(bj_FORCE_ALL_PLAYERS,12.,"|cFFFFCC00"+GetPlayerName(owner)+" 选择了多重施法。|r敌方第 |cFFFF0000"+I2S(floor)+"|r 楼将成为第 "+I2S(quota)+" 位超级AI；只有该超级AI楼层禁止 -re，其他楼层不受影响。")
else
call DisplayTimedTextToPlayer(owner,0,0,8.,"|cFFFFCC00已选择多重施法，但敌方AI数量不足，超级AI数量按现有AI自然封顶。|r")
endif
set owner=null
endfunction
function GetRandomHeroNum takes nothing returns integer
local integer i=GetRandomInt(1,4)
local integer d=0
if i==1 then
    set d=GetRandomInt(1,22)
elseif i==2 then
    set d=GetRandomInt(24,57)
elseif i==3 then
    set d=GetRandomInt(59,88)
else
    set d=GetRandomInt(90,112)
endif
// if SPEPLAYER[1]==1 and (d==7 or d==9 or d==16) then
if SPEPLAYER[1]==1 and (d==7) then
    set d=GetRandomInt(90,112)
endif
    return d
endfunction
function XZE takes integer O5,integer JS7 returns nothing
local integer XAE=0
local real x
local real y
local integer XBE=KL4
local integer XCE=K54
local player pl=Player(O5)
local integer i=0
if(TA7(pl)and(GetPlayerController(pl)==MAP_CONTROL_COMPUTER)and(M7[GetPlayerId(pl)]==null))then
call SuijiTest_DebugPlayer(pl,"XZE0","进入AI自动选英雄，M7为空")
if(((TV7(pl))and(not P4 and not VT))or((P4 or VT)and(GetRandomInt(1,2)==1)))then
set XBE=KL4
set XCE=K14
else
set XBE=K04
set XCE=K54
endif
if(TV7(pl))then
set x=GetRandomReal(GetRectMinX(ED),GetRectMaxX(ED))
set y=GetRandomReal(GetRectMinY(ED),GetRectMaxY(ED))
else
set x=GetRandomReal(GetRectMinX(L9),GetRectMaxX(L9))
set y=GetRandomReal(GetRectMinY(L9),GetRectMaxY(L9))
endif
set eY[GetPlayerId(pl)]=0
if SUIJI_MODE then
call SuijiSuperAI_Roll(pl)
endif
loop
if SuijiMode_HasForcedPreset(GetPlayerId(pl)) then
set XAE=SuijiTest_FindHeroIndex(SuijiMode_ForcedHero(GetPlayerId(pl)))
else
set XAE=GetRandomInt(XBE,XCE)
//电脑非死亡模式禁选某些英雄
if not D4 then
set XAE=GetRandomHeroNum()
endif
endif
//if((not J[XAE])and(JR7(K34[XAE],JS7)or i>20))then
// if TZ4 then
// if GetPlayerId(pl)==1 then
// set XAE=89
// endif
//if((not J[XAE])and(JR7(K34[XAE],JS7)or i>20))then
// if TZ4 then
// if GetPlayerId(pl)==1 then
// set XAE=89
// endif
//if((not J[XAE])and(JR7(K34[XAE],JS7)or i>20))then
// if TZ4 then
// if GetPlayerId(pl)==1 then
// set XAE=89
// endif
if SuijiMode_HasForcedPreset(GetPlayerId(pl)) or not J[XAE] then
set M7[GetPlayerId(pl)]=CreateUnit(pl,K34[XAE],x,y,bj_UNIT_FACING)
if SuijiSuperAI_HasPreset(GetPlayerId(pl)) then
set J[XAE]=true
endif
endif
set i=i+1
exitwhen(M7[GetPlayerId(pl)]!=null)
endloop




call SuijiTest_DebugUnit(M7[GetPlayerId(pl)],"XZE1","自动选英雄完成，检查是否触发随机")
if SUIJI_MODE and M7[GetPlayerId(pl)]!=null then
set IN4=M7[GetPlayerId(pl)]
call ExecuteFunc("SuijiMode_ApplyCurrent")
else
call SuijiTest_DebugPlayer(pl,"XZE2","未触发ApplyCurrent，原因可能是SUIJI未开启或M7为空")
endif
if(not(E4 or O4 or A8 or H34))then
call AdjustPlayerStateBJ(-$FA,pl,PLAYER_STATE_RESOURCE_GOLD)
endif
endif
set pl=null
endfunction
