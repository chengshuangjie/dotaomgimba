endif
else
if p!=A7[m]then
set ADE[k]=A7[m]
set k=k+1
endif
endif
set m=m+1
endloop
endif
set k=1
loop
exitwhen k>YAF
set A9E=ADE[k]
set i=0
if AEE!=null and ASE==1 and(AKE==A9E or PK4 or(GetPlayerSlotState((AKE))==PLAYER_SLOT_STATE_LEFT))then
set Z5E[i+1]=AYE
else
set Z5E[i+1]=0
