function YLG takes unit u,integer d returns nothing
local integer array b
local integer a=d
local integer c=1
local integer i=0
local integer UDD
if d<1 then
call UnitRemoveAbility(u,D17[0])
call UnitRemoveAbility(u,D17[1])
call UnitRemoveAbility(u,D17[2])
call UnitRemoveAbility(u,D17[3])
call UnitRemoveAbility(u,D17[4])
call UnitRemoveAbility(u,D17[5])
call UnitRemoveAbility(u,D17[6])
call UnitRemoveAbility(u,D17[7])
call UnitRemoveAbility(u,D17[8])
call UnitRemoveAbility(u,D17[9])
call UnitRemoveAbility(u,D17[10])
call UnitRemoveAbility(u,D17[11])
return
endif
loop
exitwhen c==0
set c=a/2
set b[i]=a-c*2
set a=c
set i=i+1
endloop
set UDD=11
set i=0
loop
exitwhen i>UDD
if b[i]==1 then
call XF7(u,D17[i])
else
call UnitRemoveAbility(u,D17[i])
endif
set i=i+1
endloop
endfunction
function ZHF takes player p,integer Y68 returns nothing
local integer i=GetPlayerId(p)
if Y68==OC then
set Zh[i]=Zh[i]+1
elseif Y68==QC then
set Zh[i]=Zh[i]+1
elseif Y68==TC then
set Zh[i]=Zh[i]+3
elseif Y68==VC then
set Zh[i]=Zh[i]+2
set H74[i]=H74[i]+2
elseif Y68==WC then
set Zh[i]=Zh[i]+2
set H74[i]=H74[i]+2
elseif Y68==XC then
set Zh[i]=Zh[i]+1
elseif Y68==YC then
set Zh[i]=Zh[i]+1
elseif Y68==CC then
set Zh[i]=Zh[i]+2
elseif Y68==PC then
set Zh[i]=Zh[i]+2
elseif Y68==LC then
set Zh[i]=Zh[i]+2
endif
endfunction
function ZIF takes unit ZJF,unit ZKF returns boolean
local integer Y68
if GetUnitTypeId(ZKF)=='N0MM' then
return true
endif
if(ZJF==JC4 or ZJF==JB4)and IsUnitAlly(ZKF,A7[0])then
return false
elseif(ZJF==I_4 or ZJF==I34)and IsUnitAlly(ZKF,Z7[0])then
return false
endif
set Y68=WD7(ZKF)
if Y68==VC or Y68==EW or Y68==H3 then
return true
endif
return false
endfunction
function ZMF takes unit Y5F,unit ZNF returns real
if Y5F==I34 or Y5F==IL4 or Y5F==I04 or Y5F==I_4 or Y5F==J44 or Y5F==J444 or Y5F==J74 or Y5F==UJ74 or Y5F==UJ744 or Y5F==J84 or Y5F==J94 or Y5F==JD4 or Y5F==JD44 or Y5F==SHOPNM1 or Y5F==SHOPKG1 or Y5F==JE4 or Y5F==PFGH1 or Y5F==PFDEMO[1] or Y5F==PFDEMO[2] or Y5F==PFDEMO[3] or Y5F==PFDEMO[4] or Y5F==PFDEMO[5] or Y5F==PFDEMO[6] then
return KV4[GetPlayerId(GetOwningPlayer(ZNF))]
elseif Y5F==JB4 or Y5F==zs or Y5F==Zs or Y5F==JC4 or Y5F==eS or Y5F==eSS or Y5F==oS or Y5F==oSS or Y5F==oSSS  or Y5F==rS or Y5F==aS or Y5F==nS or Y5F==nSS or Y5F==SHOPNM2 or Y5F==SHOPKG2 or Y5F==VS or Y5F==PFGH2 or Y5F==PFDEMO[7] or Y5F==PFDEMO[8] or Y5F==PFDEMO[9] or Y5F==PFDEMO[10] or Y5F==PFDEMO[11] or Y5F==PFDEMO[12] then
return KV4[GetPlayerId(GetOwningPlayer(ZNF))]
elseif Y5F==B44 or Y5F==B94 then
return-7133.
elseif Y5F==B74 or Y5F==B84 then
return 7207.
endif
return GetUnitX(ZNF)
endfunction
function ZOF takes unit Y5F,unit ZNF returns real
if Y5F==I34 or Y5F==IL4 or Y5F==I04 or Y5F==I_4 or Y5F==J44 or Y5F==J444 or Y5F==J74 or Y5F==UJ74 or Y5F==UJ744 or Y5F==J84 or Y5F==J94 or Y5F==JD4 or Y5F==JD44 or Y5F==SHOPNM1 or Y5F==SHOPKG1 or Y5F==JE4 or Y5F==PFGH1 or Y5F==PFDEMO[1] or Y5F==PFDEMO[2] or Y5F==PFDEMO[3] or Y5F==PFDEMO[4] or Y5F==PFDEMO[5] or Y5F==PFDEMO[6] then
return KW4[GetPlayerId(GetOwningPlayer(ZNF))]
elseif Y5F==JB4 or Y5F==zs or Y5F==Zs or Y5F==JC4 or Y5F==eS or Y5F==eSS or Y5F==oS or Y5F==oSS or Y5F==oSSS or Y5F==rS or Y5F==aS or Y5F==nS or Y5F==nSS or Y5F==SHOPNM2 or Y5F==SHOPKG2 or Y5F==VS or Y5F==PFGH2 or Y5F==PFDEMO[7] or Y5F==PFDEMO[8] or Y5F==PFDEMO[9] or Y5F==PFDEMO[10] or Y5F==PFDEMO[11] or Y5F==PFDEMO[12] then
return KW4[GetPlayerId(GetOwningPlayer(ZNF))]
elseif Y5F==B44 or Y5F==B94 then
return 4317.
elseif Y5F==B74 or Y5F==B84 then
return-4243.
endif
return GetUnitY(ZNF)
endfunction
function ZPF takes unit Y5F,unit ZNF returns real
if Y5F==I34 or Y5F==IL4 or Y5F==I04 or Y5F==I_4 or Y5F==J44 or Y5F==J444 or Y5F==J74 or Y5F==UJ74 or Y5F==UJ744 or Y5F==J84 or Y5F==J94 or Y5F==JD4 or Y5F==JD44 or Y5F==SHOPNM1 or Y5F==SHOPKG1 or Y5F==JE4 or Y5F==PFGH1 or Y5F==PFDEMO[1] or Y5F==PFDEMO[2] or Y5F==PFDEMO[3] or Y5F==PFDEMO[4] or Y5F==PFDEMO[5] or Y5F==PFDEMO[6] then
return GetRectCenterX(ED)
elseif Y5F==JB4 or Y5F==zs or Y5F==Zs or Y5F==JC4 or Y5F==eS or Y5F==eSS or Y5F==oS or Y5F==oSS or Y5F==oSSS or Y5F==rS or Y5F==aS or Y5F==nS or Y5F==nSS or Y5F==SHOPNM2 or Y5F==SHOPKG2 or Y5F==VS or Y5F==PFGH2 or Y5F==PFDEMO[7] or Y5F==PFDEMO[8] or Y5F==PFDEMO[9] or Y5F==PFDEMO[10] or Y5F==PFDEMO[11] or Y5F==PFDEMO[12] then
return GetRectCenterX(L9)
endif
return GetUnitX(ZNF)
endfunction
function ZQF takes unit Y5F,unit ZNF returns real
if Y5F==I34 or Y5F==IL4 or Y5F==I04 or Y5F==I_4 or Y5F==J44 or Y5F==J444 or Y5F==J74 or Y5F==UJ74 or Y5F==UJ744 or Y5F==J84 or Y5F==J94 or Y5F==JD4 or Y5F==JD44 or Y5F==SHOPNM1 or Y5F==SHOPKG1 or Y5F==JE4 or Y5F==PFGH1 or Y5F==PFDEMO[1] or Y5F==PFDEMO[2] or Y5F==PFDEMO[3] or Y5F==PFDEMO[4] or Y5F==PFDEMO[5] or Y5F==PFDEMO[6] then
return GetRectCenterY(ED)
elseif Y5F==JB4 or Y5F==zs or Y5F==Zs or Y5F==JC4 or Y5F==eS or Y5F==eSS or Y5F==oS or Y5F==oSS or Y5F==oSSS or Y5F==rS or Y5F==aS or Y5F==nS or Y5F==nSS or Y5F==SHOPNM2 or Y5F==SHOPKG2 or Y5F==VS or Y5F==PFGH2 or Y5F==PFDEMO[7] or Y5F==PFDEMO[8] or Y5F==PFDEMO[9] or Y5F==PFDEMO[10] or Y5F==PFDEMO[11] or Y5F==PFDEMO[12] then
return GetRectCenterY(L9)
endif
return GetUnitY(ZNF)
endfunction
//预载技能特效防止释放时卡顿
function PRELOAD_HERO_SKILL takes integer id returns nothing
local real x=7280.
local real y=7500.
if id=='Z00E' then
call DestroyEffect(AddSpecialEffect("model\\hero_necrolyte_n4s_r_target.mdl",x,y))
elseif id=='Z10E' then
call DestroyEffect(AddSpecialEffect("model\\hero_necrolyte_n5s_r_target.mdl",x,y))
elseif id=='Z20E' then
call DestroyEffect(AddSpecialEffect("model\\hero_necrolyte_n2s_r_target.mdl",x,y))
elseif id=='Z30E' then
call DestroyEffect(AddSpecialEffect("model\\hero_necrolyte_n3s_r_target.mdl",x,y))
endif
endfunction
function CHANGE_HERO_SYNC takes unit WI7,unit u,integer O5 returns nothing
local integer array skill
local integer array skill_level
local integer learn_skill
local integer i=1
local integer i1=GetUnitTypeId(u)
local real r=(TimerGetRemaining(N84[O5]))
local integer tmp_int
local integer id=GetPlayerId(GetOwningPlayer(WI7))
local trigger t
if HaveSavedHandle(MSK,GetHandleId(u),0) then
set t=LoadTriggerHandle(MSK,(GetHandleId(u)),(0))
if t!=null then
call FlushChildHashtable(MSK,(GetHandleId(t)))
call OZ7(t)
set t=null
endif
call FlushChildHashtable(MSK,(GetHandleId(u)))
endif
//停止某些循环触发
if HaveSavedHandle(L7,GetHandleId(u),StringHash("Invoker|QuasTrigger")) then
set t=OE7(GetHandleId(u),"Invoker|QuasTrigger")
if t!=null then
call NM7(GetHandleId(t))
call OZ7(t)
set t=null
endif
endif
//
if i1=='E02X' or i1=='Z02X' then
call Set_Labike_Multiple_Skill(u,"clear")
elseif i1=='O01F' then
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(u),'A1TA',true)
endif
//死亡模式停止重生触发
if D4 then
if i1=='NC00' or i1=='ZC00' then
set t=LoadTriggerHandle(L7,(GetHandleId(u)),('A01Y'))
if t!=null then
call OZ7(t)
call RemoveSavedHandle(L7,(GetHandleId(u)),('A01Y'))
set t=null
endif
endif
endif
//宝石buff
if GetUnitAbilityLevel(u,'A333')>0 then
call XF7(WI7,'A332')
call UnitMakeAbilityPermanent(WI7,true,'A14K')
call SetPlayerAbilityAvailable(GetOwningPlayer(WI7),'A332',false)
call XF7(WI7,'A26A')
call XF7(WI7,'A333')
endif
//移除长大buff
if (i1=='Ucrl' or i1=='U01X' or i1=='Zcrl' or i1=='Z01X' or i1=='Zdrl' or i1=='Z11X' or i1=='Zerl' or i1=='Z21X') and xxzd[id]!=null then 
call KillUnit(xxzd[id])
set xxzd[id]=null
endif
//移除野性驱使buff
if (i1=='U008' or i1=='E015' or i1=='Z008' or i1=='E115' or i1=='Z009' or i1=='E116') and yxqs[id]!=null then
call KillUnit(LoadUnitHandle(L7,(GetHandleId(yxqs[id])),(19)))
call NM7(GetHandleId(yxqs[id]))
call OZ7(yxqs[id])
set yxqs[id]=null
endif
set skill[1]=eY[$80+O5]
set skill_level[1]=B287_GetUnitAbilityLevel(u,skill[1])
set skill[2]=eY[$90+O5]
set skill_level[2]=B287_GetUnitAbilityLevel(u,skill[2])
set skill[3]=eY[$A0+O5]
set skill_level[3]=B287_GetUnitAbilityLevel(u,skill[3])
set skill[4]=eY[$AC+O5]
set skill_level[4]=B287_GetUnitAbilityLevel(u,skill[4])
set skill[5]=eY[$BC+O5]
set skill_level[5]=B287_GetUnitAbilityLevel(u,skill[5])
if i1=='Nfir' or i1=='O00P' or i1=='N01O' or i1=='N013' or i1=='N014' or i1=='N015' or (i1=='Hblm' or i1=='H06X' or i1=='H06Y' or i1=='H06W') or i1=='H00K' or i1=='E02F' or i1=='O01F' or i1=='E02X' or i1=='H0BC' or i1=='H06W' or i1=='H06X' or i1=='H06Y' or i1=='O016' or i1=='O017' or i1=='UC60' or i1=='UC42' or i1=='O00P' or i1=='H00R' or i1=='H07I' or i1=='N0MU' or i1=='N0MV' or i1=='E01B' or i1=='Z052' or i1=='Z060' or i1=='U00C' or i1=='Z00C' then
set skill[6]='A0NR'
set skill_level[6]=GetUnitAbilityLevel(u,skill[6])
else
set skill[6]='Aamk'
set skill_level[6]=GetUnitAbilityLevel(u,skill[6])
endif
//重新应用英雄皮肤技能表
call XWE_PIFU(O5,WI7,GetUnitTypeId(WI7))
if skill_level[1]>0 then
set i=1
set learn_skill=eY[$80+O5]
loop
exitwhen i>skill_level[1]
call B287_SelectHeroSkill(WI7,learn_skill)
set i=i+1
endloop
endif
if skill_level[2]>0 then
set i=1
set learn_skill=eY[$90+O5]
loop
exitwhen i>skill_level[2]
call B287_SelectHeroSkill(WI7,learn_skill)
set i=i+1
endloop
endif
if skill_level[3]>0 then
set i=1
set learn_skill=eY[$A0+O5]
loop
exitwhen i>skill_level[3]
call B287_SelectHeroSkill(WI7,learn_skill)
set i=i+1
endloop
endif
if skill_level[4]>0 then
set i=1
set learn_skill=eY[$AC+O5]
loop
exitwhen i>skill_level[4]
call B287_SelectHeroSkill(WI7,learn_skill)
set i=i+1
endloop
if r>0 and ISLABIKE(WI7)==false then
call Japi_ReduceUnitAbilityCoolDown(WI7,B287_GetLearnableAbilityId(learn_skill),r)
endif
endif
if skill_level[5]>0 then
set i=1
set learn_skill=eY[$BC+O5]
loop
exitwhen i>skill_level[5]
//不学习原技能可能会出现有A但没有自动学习技能的情况
call B287_SelectHeroSkill(WI7,eY[$AC+O5])
call B287_SelectHeroSkill(WI7,learn_skill)
set i=i+1
endloop
if r>0 and ISLABIKE(WI7)==false then
call Japi_ReduceUnitAbilityCoolDown(WI7,B287_GetLearnableAbilityId(learn_skill),r)
endif
endif
if skill_level[6]>0 then
set i=1
if skill[6]=='A0NR' then
set learn_skill='A0NR'
elseif skill[6]=='Aamk' then
set learn_skill='Aamk'
endif
loop
exitwhen i>skill_level[6]
call SelectHeroSkill(WI7,learn_skill)
set i=i+1
endloop
endif
//同步被动技能数据
if i1=='U00F' or i1=='Z00F' then //屠夫
set tmp_int=(LoadInteger(L7,(GetHandleId(u)),(672)))
call SaveInteger(L7,(GetHandleId(WI7)),(672),(tmp_int))
endif
if i1=='H071' or i1=='Z071' then //小鱼
set tmp_int=XYMJ[id]
if tmp_int>0 then
call ModifyHeroStat(1,WI7,bj_MODIFYMETHOD_ADD,R2I(I2R(XYSR[id])*0.5)) 
endif
endif
if i1=='Nfir' or i1=='Zfir' or i1=='Zgir' or i1=='Zhir'  then //影魔
set tmp_int=GetUnitAbilityLevel(u,'A0CQ')
call SetUnitAbilityLevel(WI7,'A0CQ',tmp_int)
    call SetUnitAbilityLevel(WI7,'A4CE',tmp_int)
    call SaveInteger(L7,(GetHandleId(WI7)),(710),(tmp_int))
endif
set tmp_int=SR4[id]
if tmp_int>0 and (i1=='N01A' or SilencerCanStealInt(WI7)) then //沉默
    call SetHeroInt(WI7,GetHeroInt(WI7,false)+tmp_int,true)
endif
if SilencerCanStealInt(WI7) then
call SilencerStealInt_InitUnit(WI7)
endif
set tmp_int=LoadInteger(L7,(GetHandleId(u)),(739)) //军团
if tmp_int>0 then
    call YLG(WI7,tmp_int)
    call SaveInteger(L7,(GetHandleId(WI7)),(739),(tmp_int))
endif
endfunction
function PIFU_CONDITION takes unit u,player p returns boolean
if GetUnitState(u,UNIT_STATE_MANA)!=GetUnitState(u,UNIT_STATE_MAX_MANA)or GetUnitState(u,UNIT_STATE_LIFE)!=GetUnitState(u,UNIT_STATE_MAX_LIFE)then
call X37(p,"只有在满血满魔的状态下才能切换皮肤")
return false
endif
return true
endfunction
function Set_Item_Drop2 takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local item QU8=(LoadItemHandle(L7,(I97),(0)))
call SetItemDroppable(QU8,true)
call FlushChildHashtable(L7,(I97))
call OZ7(t)
set t=null
set QU8=null
endfunction
function Set_Item_Drop takes item QU8,real d returns nothing
local trigger t=CreateTrigger()
local integer I97=GetHandleId(t)
call SetItemDroppable(QU8,false)
call TriggerRegisterTimerEvent(t,d,false)
call TriggerAddCondition(t,Condition(function Set_Item_Drop2))
call SaveItemHandle(L7,(I97),(0),(QU8))
set t=null
endfunction
function CHANGE_HERO takes unit u,integer WI7_ID,player p returns nothing
local integer i=GetPlayerId(p)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real Face=GetUnitFacing(u)
local unit WI7
local real array d
local integer n
local boolean b=true
// set ZDGJ[i]=false
call SetUnitPathing(u,false)
set M7[i]=CreateUnit(p,WI7_ID,x,y,Face)
set WI7=M7[i]
set SJTRI=false
call SetHeroXP(WI7,GetHeroXP(u),false)
set SJTRI=true
set n=0
loop
exitwhen n>5
set d[n]=MHAbility_GetCooldown(u,MHItem_GetAbilityId(UnitItemInSlot(u, n),1))
set n=n+1
endloop
call GAIN_ITEM(WI7,u)
set n=0
loop
exitwhen n>5
if d[n]>0 then
call Set_Item_Drop(UnitItemInSlot(WI7,n),d[n])
if b then
set b=false
call DisplayTextToPlayer(p,0,0, "|c00FF0000某些物品在本次冷却时间内无法丢弃|r")
endif
endif
set n=n+1
endloop
call CHANGE_HERO_SYNC(WI7,u,i)
call PRELOAD_HERO_SKILL(WI7_ID)
call RemoveUnit(u)
call SetUnitPosition(WI7,x,y)
call ClearSelectionForPlayer(p)
call SelectUnitAddForPlayer(WI7,p)
endfunction
//非完整版皮肤
function TMP_PIFU_LIST takes integer id returns integer
//小小、狼人、屠夫、白虎、恶魔巫师、黑鸟
if id=='Ucrl' then  //小小
	return 'Zcrl'
elseif id=='U01X' then  //A杖小小
	return 'Z01X'
elseif id=='U008' then
	return 'Z009'
elseif id=='U00F' then
	return 'Z00F'
elseif id=='N01V' then
	return 'Z01V'
elseif id=='UC18' then
	return 'ZC18'
elseif id=='U00P' then
	return 'Z00P'
endif
return -1
endfunction
function CHANGE_PIFU takes player p,integer i returns nothing
local unit u=GetBuyingUnit()
local integer id=GetUnitTypeId(u)
local integer WI7_ID
if IsUnitType(u,UNIT_TYPE_HERO)==false then
call DisplayTimedTextToPlayer(p,0,0,10,"英雄需要在商店附近才可以切换")
set u=null
return
endif
