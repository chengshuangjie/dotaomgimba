set N_E=s+p+s+p+c+p+c
elseif N5E==3 then
set N_E=s+p+s+p+s+p+c
elseif N5E==4 then
set N_E=s+p+s+p+s+p+s
endif
elseif N2E==3 then
if N5E==0 then
set N_E=c+p+c+p+c+p+c+p+c
elseif N5E==1 then
set N_E=s+p+c+p+c+p+c+p+c
elseif N5E==2 then
