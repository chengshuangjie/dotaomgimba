function SJTQ takes unit ZX7,unit IH7 returns nothing
    local player p=GetOwningPlayer(ZX7)
    local player p5=GetOwningPlayer(IH7)
    local integer X78=GetPlayerState(p5,PLAYER_STATE_RESOURCE_GOLD)
    local integer X98=X78-VH4[GetPlayerId(p5)]
    local texttag tt=CreateTextTag()
    local integer WW8=B287_GetUnitAbilityLevel(ZX7,'A1IQ')*6+6
    if SuijiMode_HasAghanimState(ZX7) then
        set WW8=WW8*2
    endif
    if WW8>X98 then
        set WW8=X98
    endif
    call WI8(IH7,WW8)
    call WI8(ZX7,-WW8)
    call SetTextTagText(tt,"+"+I2S(WW8),.025)
    call SetTextTagPosUnit(tt,ZX7,0)
    call SetTextTagColor(tt,$FF,$DC,0,$FF)
    call SetTextTagVelocity(tt,0,.03)
    if GetLocalPlayer() == p  or WG7(GetLocalPlayer()) then
    call SetTextTagVisibility(tt,true)
    else
    call SetTextTagVisibility(tt,false)
    endif
    call SetTextTagFadepoint(tt,2)
    call SetTextTagLifespan(tt,3)
    call SetTextTagPermanent(tt,false)
    call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Transmute\\PileofGold.mdl",GetUnitX(IH7),GetUnitY(IH7)))
    set p=null
    set p5=null
    set tt=null
endfunction
