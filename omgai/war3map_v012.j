function BrambleMaze_Damage takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer HEI=GetHandleId(t)
local unit u=(LoadUnitHandle(TABLE_XJ,(HEI),(2)))
local effect fx=(LoadEffectHandle(TABLE_XJ,(HEI),(32)))
local unit HKI=(LoadUnitHandle(TABLE_XJ,(HEI),(14)))
local integer V6I=(LoadInteger(TABLE_XJ,(HEI),(5)))
local unit N4I
local unit IH7=GetTriggerUnit()
if GetTriggerEventId()==EVENT_GAME_TIMER_EXPIRED then
if u!=null then
call RemoveUnit(u)
endif
call DestroyEffect(fx)
call FlushChildHashtable(TABLE_XJ,(HEI))
call OZ7(t)
elseif HKI==null or u==null or GetUnitTypeId(HKI)==0 or GetUnitTypeId(u)==0 then
if u!=null and GetUnitTypeId(u)!=0 then
call RemoveUnit(u)
endif
call DestroyEffect(fx)
call FlushChildHashtable(TABLE_XJ,(HEI))
call OZ7(t)
elseif IH7!=null and GetUnitTypeId(IH7)!=0 and IsUnitEnemy(IH7,GetOwningPlayer(HKI))==true and IsUnitType(IH7,UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(IH7,'A04R')==0 and GetUnitAbilityLevel(IH7,'Avul')==0 and WF7(IH7)==false and IsHideUnit(IH7)==false and UnitAlive(IH7) then
set N4I=CreateUnit(GetOwningPlayer(HKI),'e00E',GetUnitX(IH7),GetUnitY(IH7),0)
call XF7(N4I,'A4IC')
call SetUnitAbilityLevel(N4I,'A4IC',V6I)
call IssueTargetOrderById(N4I,$D008A,IH7)
call Loop_Damage(HKI,IH7,.1,.5+V6I*.5,10)
call RemoveUnit(u)
call DestroyEffect(fx)
call FlushChildHashtable(TABLE_XJ,(HEI))
call OZ7(t)
endif
set t=null
set u=null
set fx=null
set HKI=null
set N4I=null
set IH7=null
return false
endfunction
function BrambleMaze_Remove takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer HEI=GetHandleId(t)
local integer ZXI
local integer ZYI
set ZXI=1
set ZYI=12
loop
exitwhen ZXI>ZYI
if LoadUnitHandle(TABLE_XJ,(HEI),(100+ZXI))!=null then
call RemoveUnit(LoadUnitHandle(TABLE_XJ,(HEI),(100+ZXI)))
call DestroyEffect(LoadEffectHandle(TABLE_XJ,(HEI),(200+ZXI)))
endif
set ZXI=ZXI+1
endloop
call FlushChildHashtable(TABLE_XJ,(HEI))
call OZ7(t)
set t=null
return false
endfunction
function BrambleMaze_Main takes nothing returns nothing
local unit HKI=GetTriggerUnit()
local real x0=GetSpellTargetX()
local real y0=GetSpellTargetY()
local trigger t1=null
local integer SEI=0
local integer V6I=0
local trigger t
local integer HEI
local integer ZXI
local integer ZYI
local real d
local real x
local real y
local unit u
local effect fx
if HKI==null or GetUnitTypeId(HKI)==0 then
set HKI=null
return
endif
set t1=CreateTrigger()
set SEI=GetHandleId(t1)
set V6I=GetUnitAbilityLevel(HKI,'A4ID')
call TriggerRegisterTimerEvent(t1,10,false)
call TriggerAddCondition(t1,Condition(function BrambleMaze_Remove))
set ZXI=1
set ZYI=4
loop
exitwhen ZXI>ZYI
set d=ZXI/I2R(4)*360.0
set x=x0+250*Cos(d*bj_DEGTORAD)
set y=y0+250*Sin(d*bj_DEGTORAD)
set u=CreateUnit(GetOwningPlayer(HKI),'h0H9',x,y,bj_UNIT_FACING)
set fx=AddSpecialEffect("tx\\xyfl\\BrambleMaze.mdl",x,y)
call SaveUnitHandle(TABLE_XJ,(SEI),(100+ZXI),(u))
call SaveEffectHandle(TABLE_XJ,(SEI),(200+ZXI),(fx))
set t=CreateTrigger()
set HEI=GetHandleId(t)
call TriggerRegisterTimerEvent(t,10,false)
call TriggerRegisterUnitInRange(t,u,90,Condition(function TO7))
call TriggerAddCondition(t,Condition(function BrambleMaze_Damage))
call SaveUnitHandle(TABLE_XJ,(HEI),(2),(u))
call SaveEffectHandle(TABLE_XJ,(HEI),(32),(fx))
call SaveUnitHandle(TABLE_XJ,(HEI),(14),(HKI))
call SaveInteger(TABLE_XJ,(HEI),(5),(V6I))
set ZXI=ZXI+1
endloop
set ZXI=1
set ZYI=4
loop
exitwhen ZXI>ZYI
set d=ZXI/I2R(4)*360.0+45.0
set x=x0+500*Cos(d*bj_DEGTORAD)
set y=y0+500*Sin(d*bj_DEGTORAD)
set u=CreateUnit(GetOwningPlayer(HKI),'h0H9',x,y,bj_UNIT_FACING)
set fx=AddSpecialEffect("tx\\xyfl\\BrambleMaze.mdl",x,y)
call SaveUnitHandle(TABLE_XJ,(SEI),(100+ZXI+4),(u))
call SaveEffectHandle(TABLE_XJ,(SEI),(200+ZXI+4),(fx))
set t=CreateTrigger()
set HEI=GetHandleId(t)
call TriggerRegisterTimerEvent(t,10,false)
call TriggerRegisterUnitInRange(t,u,90,Condition(function TO7))
call TriggerAddCondition(t,Condition(function BrambleMaze_Damage))
call SaveUnitHandle(TABLE_XJ,(HEI),(2),(u))
call SaveEffectHandle(TABLE_XJ,(HEI),(32),(fx))
call SaveUnitHandle(TABLE_XJ,(HEI),(14),(HKI))
call SaveInteger(TABLE_XJ,(HEI),(5),(V6I))
set ZXI=ZXI+1
endloop
if SuijiMode_HasAghanimState(HKI) then
set ZXI=1
set ZYI=4
loop
exitwhen ZXI>ZYI
set d=ZXI/I2R(4)*360.0
set x=x0+550*Cos(d*bj_DEGTORAD)
set y=y0+550*Sin(d*bj_DEGTORAD)
set u=CreateUnit(GetOwningPlayer(HKI),'h0H9',x,y,bj_UNIT_FACING)
set fx=AddSpecialEffect("tx\\xyfl\\BrambleMaze.mdl",x,y)
call SaveUnitHandle(TABLE_XJ,(SEI),(100+ZXI+8),(u))
call SaveEffectHandle(TABLE_XJ,(SEI),(200+ZXI+8),(fx))
set t=CreateTrigger()
set HEI=GetHandleId(t)
call TriggerRegisterTimerEvent(t,10,false)
call TriggerRegisterUnitInRange(t,u,90,Condition(function TO7))
call TriggerAddCondition(t,Condition(function BrambleMaze_Damage))
call SaveUnitHandle(TABLE_XJ,(HEI),(2),(u))
call SaveEffectHandle(TABLE_XJ,(HEI),(32),(fx))
call SaveUnitHandle(TABLE_XJ,(HEI),(14),(HKI))
call SaveInteger(TABLE_XJ,(HEI),(5),(V6I))
set ZXI=ZXI+1
endloop
endif
set HKI=null
set t=null
set t1=null
set u=null
set fx=null
endfunction
function BrambleMaze_Cast takes nothing returns boolean
if B287_GetSpellAbilityId()=='A4ID' then
call BrambleMaze_Main()
endif
return false
endfunction
function BrambleMaze_Init takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function BrambleMaze_Cast))
set t=null
endfunction
function ShadowRealm_Damage takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(TABLE_XJ,(OB7),(2)))
local unit IH7=(LoadUnitHandle(TABLE_XJ,(OB7),(17)))
local real YM7=(LoadReal(TABLE_XJ,(OB7),(34)))
local boolean HaveA=(LoadBoolean(TABLE_XJ,(OB7),(100)))
if ZX7==null or IH7==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 or UnitAlive(ZX7)==false then
if HaveA==false and ZX7!=null and GetUnitTypeId(ZX7)!=0 then
    if GetUnitState(ZX7, UNIT_STATE_ATTACK1_RANGE)>1000 then
        call Unit_Setrange(ZX7, GetUnitState(ZX7, UNIT_STATE_ATTACK1_RANGE) - 600)
    endif
    call UnitRemoveAbility(ZX7,'A4IF')
endif
call FlushChildHashtable(TABLE_XJ,(OB7))
call OZ7(t)
set t=null
set ZX7=null
set IH7=null
return false
endif
if GetTriggerEventId()!=EVENT_UNIT_DAMAGED then
    if HaveA==false then
        if GetUnitState(ZX7, UNIT_STATE_ATTACK1_RANGE)>1000 then
            call Unit_Setrange(ZX7, GetUnitState(ZX7, UNIT_STATE_ATTACK1_RANGE) - 600)
        endif
        call UnitRemoveAbility(ZX7,'A4IF')
    endif
call FlushChildHashtable(TABLE_XJ,(OB7))
call OZ7(t)
else
if GetEventDamageSource()==ZX7 and GetEventDamage()>0 then
    if HaveA==false then 
        if GetUnitState(ZX7, UNIT_STATE_ATTACK1_RANGE)>1000 then   
            call Unit_Setrange(ZX7, GetUnitState(ZX7, UNIT_STATE_ATTACK1_RANGE) - 600)
        endif
        call UnitRemoveAbility(ZX7,'A4IF')
    endif
call FlushChildHashtable(TABLE_XJ,(OB7))
call OZ7(t)
    if IsUnitType(IH7,UNIT_TYPE_STRUCTURE)==false then
        call B67(ZX7,IH7,1,YM7)
        call YW7("+"+I2S(R2I(YM7)),2,IH7,0.023,0,128,255,255)
    endif
endif
endif
set t=null
set ZX7=null
set IH7=null
return false
endfunction
function SetShadowRealmDamage takes unit ZX7,unit IH7,real YM7,boolean HaveA returns boolean
local trigger t
local integer OB7
local player p=null
if ZX7==null or IH7==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 or UnitAlive(ZX7)==false then
return false
endif
set p=GetOwningPlayer(ZX7)
if IsUnitEnemy(IH7,p) and UnitAlive(IH7) then
    set t=CreateTrigger()
    set OB7=GetHandleId(t)
    call TriggerRegisterUnitEvent(t,IH7,EVENT_UNIT_DAMAGED)
    call TriggerRegisterTimerEvent(t,3.,false)
    call TriggerAddCondition(t,Condition(function ShadowRealm_Damage))
    call SaveUnitHandle(TABLE_XJ,(OB7),(2),(ZX7))
    call SaveUnitHandle(TABLE_XJ,(OB7),(17),(IH7))
    call SaveReal(TABLE_XJ,(OB7),(34),(YM7))
    call SaveBoolean(TABLE_XJ,(OB7),(100),(HaveA))
elseif HaveA==false then
    if GetUnitState(ZX7, UNIT_STATE_ATTACK1_RANGE)>1000 then
        call Unit_Setrange(ZX7, GetUnitState(ZX7, UNIT_STATE_ATTACK1_RANGE) - 600)
    endif
endif
set t=null
set p=null
return false
endfunction
function ShadowRealm_Action takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(TABLE_XJ,(OB7),(2)))
local player p=null
local integer i=0
local boolean HaveA=(LoadBoolean(TABLE_XJ,(OB7),(300)))
local integer level=(LoadInteger(TABLE_XJ,(OB7),(5)))
local real YM7=(LoadReal(TABLE_XJ,(OB7),(34)))
local real W9I=(LoadReal(TABLE_XJ,(OB7),(13)))
local integer WF8=(LoadInteger(TABLE_XJ,(OB7),(100)))
if ZX7==null or GetUnitTypeId(ZX7)==0 then
call FlushChildHashtable(TABLE_XJ,(OB7))
call OZ7(t)
set t=null
set ZX7=null
set p=null
return false
endif
set p=GetOwningPlayer(ZX7)
set i=GetPlayerId(p)
if GetTriggerEventId()==EVENT_UNIT_DEATH or WF8==50 then
    if DISZDGJ[i]==false and HaveA==false then
        call Disable_Unit_Auto_Attack(ZX7,false)
    endif
    call SetUnitPhaseMove( ZX7, false )
    call RemoveSavedHandle(TABLE_HY, GetHandleId(ZX7),'A4IE')
    call UnitRemoveAbility(ZX7,'A4IF')
    call UnitRemoveAbility(ZX7,'A4IG')
    call UnitRemoveAbility(ZX7,'A4IH')
    if GetUnitState(ZX7, UNIT_STATE_ATTACK1_RANGE)>1000 then
        call Unit_Setrange(ZX7, GetUnitState(ZX7, UNIT_STATE_ATTACK1_RANGE) - 600)
    endif
    call FlushChildHashtable(TABLE_XJ,(OB7))
    call OZ7(t)
elseif GetTriggerEventId()==EVENT_PLAYER_UNIT_ATTACKED then
    if GetAttacker()==ZX7 then
        if HaveA==false then
            if DISZDGJ[i]==false then
                call Disable_Unit_Auto_Attack(ZX7,false)
            endif
            call SetUnitPhaseMove( ZX7, false )
            call RemoveSavedHandle(TABLE_HY, GetHandleId(ZX7),'A4IE')
            call UnitRemoveAbility(ZX7,'A4IG')
            call UnitRemoveAbility(ZX7,'A4IH')
            call FlushChildHashtable(TABLE_XJ,(OB7))
            call OZ7(t)
        endif
        call SetShadowRealmDamage(ZX7,GetTriggerUnit(),YM7,HaveA)
    endif
    if GetTriggerUnit()==ZX7 then
        if IsUnitEnemy(ZX7,GetOwningPlayer(GetAttacker())) and GetUnitAbilityLevel(GetAttacker(),'Aloc')==0 and GetUnitAbilityLevel(GetAttacker(),'A04R')==0 then
            call KR7(GetAttacker())
        endif
    endif
elseif GetTriggerEventId()==EVENT_PLAYER_UNIT_SPELL_EFFECT or GetTriggerEventId()==EVENT_PLAYER_UNIT_SPELL_CAST then
    if GetSpellTargetUnit()==ZX7 and IsUnitEnemy(ZX7,GetOwningPlayer(GetTriggerUnit())) and GetUnitAbilityLevel(GetTriggerUnit(),'Aloc')==0 and GetUnitAbilityLevel(GetTriggerUnit(),'A04R')==0 then
        call KR7(GetTriggerUnit())
    endif
elseif GetTriggerEventId()==EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER then
    if GetOrderTargetUnit()==ZX7 and(GetIssuedOrderId()>= 852008 and GetIssuedOrderId()<= 852013)and IsUnitEnemy(ZX7,GetOwningPlayer(GetTriggerUnit())) and GetUnitAbilityLevel(GetTriggerUnit(),'Aloc')==0 and GetUnitAbilityLevel(GetTriggerUnit(),'A04R')==0 then
        call KR7(GetTriggerUnit())
    endif
else
    set WF8=WF8+1
    call SaveInteger(TABLE_XJ,(OB7),(100), WF8)
    if WF8<30 then
        set YM7=YM7+(W9I)/3*0.1
        call SaveReal(TABLE_XJ,(OB7),(34),(YM7*1.0))
    elseif WF8==30 then
        call SaveReal(TABLE_XJ,(OB7),(34),((W9I)*1.0))
        call UnitRemoveAbility(ZX7,'A4IG')
        call XF7(ZX7,'A4IH')
        // call XC7(p,"Sound\\Interface\\SecretFound.wav")
    endif
    // if WF8==1 or WF8==10 or WF8==20 or WF8==30 or WF8==40 then
    //     call XC7(p,"Sound\\Interface\\ItemReceived.wav")
    // endif
    // if WF8==1 or WF8==10 or WF8==20 or WF8==30 or WF8==40 then
    //     call XC7(p,"Sound\\Interface\\ItemReceived.wav")
    // endif
    // if WF8==1 or WF8==10 or WF8==20 or WF8==30 or WF8==40 then
    //     call XC7(p,"Sound\\Interface\\ItemReceived.wav")
    // endif
endif
set t=null
set ZX7=null
set p=null
return false
endfunction
function ShadowRealm_Main takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local player p=null
local integer i=0
local integer level=0
local trigger t
local integer OB7
local real W9I=0
local real r=0
local boolean HaveA=false 
if ZX7==null or GetUnitTypeId(ZX7)==0 then
set ZX7=null
return
endif
set p=GetOwningPlayer(ZX7)
set i=GetPlayerId(p)
set level=GetUnitAbilityLevel(ZX7,'A4IE')
set W9I=80*level+40
set r=GetUnitState(ZX7, UNIT_STATE_ATTACK1_RANGE)
call ShowUnit(ZX7,false)
call ShowUnit(ZX7,true)
call SelectUnitForPlayerSingle(ZX7,p)
if HaveSavedHandle(TABLE_HY, GetHandleId(ZX7),'A4IE') then
    set t=LoadTriggerHandle(TABLE_HY, GetHandleId(ZX7),'A4IE')
    set OB7=GetHandleId(t)
    call UnitRemoveAbility(ZX7,'A4IH')
    call XF7(ZX7,'A4IG')
    call SaveInteger(TABLE_XJ,(OB7),(100), 0)
else
    set t=CreateTrigger()
    set OB7=GetHandleId(t)
    if SuijiMode_HasAghanimState(ZX7) then
        set HaveA=true
    endif
    if DISZDGJ[i]==false and HaveA==false then
        call Disable_Unit_Auto_Attack(ZX7,true)
    endif
    if r<1000 then
        call Unit_Setrange(ZX7, r + 600)
    endif
    call SetUnitPhaseMove( ZX7, true )
    call SaveTriggerHandle(TABLE_HY, GetHandleId(ZX7),'A4IE', t)
    call XF7(ZX7,'A4IG')
    call XF7(ZX7,'A4IF')
    call TriggerRegisterTimerEvent(t,0.1,true)
    call TriggerRegisterUnitEvent(t,ZX7,EVENT_UNIT_DEATH)
    call YB7(t,EVENT_PLAYER_UNIT_ATTACKED)
    call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call YB7(t,EVENT_PLAYER_UNIT_SPELL_CAST)
    call YB7(t,EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER)
    call SaveUnitHandle(TABLE_XJ,(OB7),(2),(ZX7))
    call SaveBoolean(TABLE_XJ,(OB7),(300),(HaveA))
    call SaveInteger(TABLE_XJ,(OB7),(5),(level))
    call SaveReal(TABLE_XJ,(OB7),(34),(0))
    call SaveReal(TABLE_XJ,(OB7),(13),(W9I))
    call SaveInteger(TABLE_XJ,(OB7),(100), 0)
    call TriggerAddCondition(t,Condition(function ShadowRealm_Action))
endif
set ZX7=null
set p=null
set t=null
endfunction
function ShadowRealm_Cast takes nothing returns boolean
if B287_GetSpellAbilityId()=='A4IE' then
call ShadowRealm_Main()
endif
return false
endfunction
function ShadowRealm_Init takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function ShadowRealm_Cast))
set t=null
endfunction
function CursedCrown_Damage takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(TABLE_XJ,(OB7),(2)))
local unit IH7=(LoadUnitHandle(TABLE_XJ,(OB7),(17)))
local unit N4I=(LoadUnitHandle(TABLE_XJ,(OB7),(19)))
local integer level=(LoadInteger(TABLE_XJ,(OB7),(5)))
local integer W9I=(LoadInteger(TABLE_XJ,(OB7),(34)))
local texttag tt=(LoadTextTagHandle(TABLE_XJ,(OB7),(231)))
local integer WF8=GetTriggerEvalCount(t)
local group g
local boolexpr cursedCrownEnemyFilter=null
local unit u
local string VH
local string tx=""
if ZX7==null or IH7==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 then
if tt!=null then
    call SetTextTagVisibility(tt,false)
    call DestroyTextTag(tt)
endif
if N4I!=null then
    call KillUnit(N4I)
endif
if IH7!=null then
    call UnitRemoveAbility(IH7,'A4IJ')
endif
call FlushChildHashtable(TABLE_XJ,(OB7))
call OZ7(t)
set t=null
set u=null
set g=null
set ZX7=null
set IH7=null
set N4I=null
return false
endif
if GetTriggerEventId()==EVENT_WIDGET_DEATH then
    call SetTextTagVisibility(tt,false)
    call DestroyTextTag(tt)
    call KillUnit(N4I)
    // call DestroyEffect(LoadEffectHandle(TABLE_XJ,(OB7),(32)))
    call UnitRemoveAbility(IH7,'A4IJ')
    call FlushChildHashtable(TABLE_XJ,(OB7))
    call OZ7(t)
elseif WF8>=80 then
    call SetTextTagVisibility(tt,false)
    call DestroyTextTag(tt)
    call KillUnit(N4I)
    // call DestroyEffect(LoadEffectHandle(TABLE_XJ,(OB7),(32)))
    call UnitRemoveAbility(IH7,'A4IJ')
    call FlushChildHashtable(TABLE_XJ,(OB7))
    call OZ7(t)
    if IsUnitVisible(IH7,GetLocalPlayer())or WG7(GetLocalPlayer())then
        set tx="war3mapImported\\UnstableConcoctionRangeDisplay3.mdl"
    endif
    call YT7_by_scale(tx,GetUnitX(IH7),GetUnitY(IH7),1,.4)
    set g=WS7()
    set U22=ZX7
    set cursedCrownEnemyFilter=Condition(function DJX)
    call GroupEnumUnitsInRange(g,GetUnitX(IH7),GetUnitY(IH7),325+25,cursedCrownEnemyFilter)
    call DestroyBoolExpr(cursedCrownEnemyFilter)
    call GroupAddUnit(g,IH7)
    loop
    set u=FirstOfGroup(g)
    exitwhen u==null
    call GroupRemoveUnit(g,u)
    if GetPlayerController(GetOwningPlayer(u))==MAP_CONTROL_COMPUTER and IsUnitType(u, UNIT_TYPE_HERO) then
        set IH7_tmp=u
        set ZX7_tmp=ZX7
        call ExecuteFunc("Func_MSF1")
    endif
    call CommonUnitAddStun(u,0.5*level+0.5,false)
    if u==IH7 then
        set ZX7_tmp=ZX7
        set IH7_tmp=IH7
        call ExecuteFunc("Func_MNGJ")
    endif
    endloop
    call WR7(g)
elseif WF8==20 then
    call SaveInteger(TABLE_XJ,(OB7),(34),(3))
    call XC7(GetOwningPlayer(ZX7),"Sound\\Interface\\QuestLog.wav")
    call XC7(GetOwningPlayer(IH7),"Sound\\Interface\\QuestLog.wav")
elseif WF8==40 then
    call SaveInteger(TABLE_XJ,(OB7),(34),(2))
    call XC7(GetOwningPlayer(ZX7),"Sound\\Interface\\QuestLog.wav")
    call XC7(GetOwningPlayer(IH7),"Sound\\Interface\\QuestLog.wav")
elseif WF8==60 then
    call SaveInteger(TABLE_XJ,(OB7),(34),(1))
    call XC7(GetOwningPlayer(ZX7),"Sound\\Interface\\QuestLog.wav")
    call XC7(GetOwningPlayer(IH7),"Sound\\Interface\\QuestLog.wav")
else
    if W9I==4 then
        set VH="●○○○"
    elseif W9I==3 then
        set VH="●●○○"
    elseif W9I==2 then
        set VH="●●●○"
    elseif W9I==1 then
        set VH="●●●●"
    endif
    call SetTextTagText(tt,"|cffFF0080"+VH+"|r",0.03)
    call SetTextTagPosUnit(tt,IH7,0)
    if IsUnitVisible(IH7,GetLocalPlayer())or WG7(GetLocalPlayer())then
        call SetTextTagVisibility(tt,true)
        call SetUnitVertexColor(N4I,$FF,$FF,$FF,$FF)
    else
        call SetTextTagVisibility(tt,false)
        call SetUnitVertexColor(N4I,$FF,$FF,$FF,0)
    endif
    call SetUnitX(N4I,GetUnitX(IH7))
    call SetUnitY(N4I,GetUnitY(IH7))
endif
set t=null
set u=null
set g=null
set cursedCrownEnemyFilter=null
set ZX7=null
set IH7=null
set N4I=null
return false
endfunction
function CursedCrown_Action takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local unit IH7=GetSpellTargetUnit()
local integer level=0
local trigger t
local integer OB7
local texttag tt
local unit u
if ZX7==null or IH7==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 then
set ZX7=null
set IH7=null
return
endif
set level=GetUnitAbilityLevel(ZX7,'A4II')
set t=CreateTrigger()
set OB7=GetHandleId(t)
set tt=CreateTextTag()
set u=CreateUnit(GetOwningPlayer(ZX7),'h0HA',GetUnitX(IH7),GetUnitY(IH7),bj_UNIT_FACING)
call SetUnitTimeScale(u,0.5)
call SetTextTagText(tt,"|cffFF0080●○○○|r",0.03)
call SetTextTagPosUnit(tt,IH7,0)
if IsUnitVisible(IH7,GetLocalPlayer())or WG7(GetLocalPlayer())then
call SetTextTagVisibility(tt,true)
call SetUnitVertexColor(u,$FF,$FF,$FF,$FF)
else
call SetTextTagVisibility(tt,false)
call SetUnitVertexColor(u,$FF,$FF,$FF,0)
endif
call SetTextTagPermanent(tt,true)
call SaveTextTagHandle(TABLE_XJ,(OB7),(231),(tt))
call SaveUnitHandle(TABLE_XJ,(OB7),(2),(ZX7))
call SaveUnitHandle(TABLE_XJ,(OB7),(17),(IH7))
call SaveUnitHandle(TABLE_XJ,(OB7),(19),(u))
call SaveInteger(TABLE_XJ,(OB7),(5),(level))
call SaveInteger(TABLE_XJ,(OB7),(34),(4))
//call SaveEffectHandle(TABLE_XJ,(OB7),(32),(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\Curse\\CurseTarget.mdl",IH7,"overhead")))
call XF7(IH7,'A4IJ')
call TriggerRegisterDeathEvent(t,IH7)
call TriggerRegisterTimerEvent(t,0.05,true)
call TriggerAddCondition(t,Condition(function CursedCrown_Damage))
call XC7(GetOwningPlayer(ZX7),"Sound\\Interface\\QuestLog.wav")
call XC7(GetOwningPlayer(IH7),"Sound\\Interface\\QuestLog.wav")
call LINGXIA(ZX7,IH7)
set ZX7=null
set IH7=null
set t=null
set tt=null
endfunction
function CursedCrown_Main takes nothing returns boolean
local unit suijiCursedCrownTarget=GetSpellTargetUnit()
if B287_GetSpellAbilityId()=='A4II' and suijiCursedCrownTarget!=null and GetUnitTypeId(suijiCursedCrownTarget)!=0 and WQ7(suijiCursedCrownTarget)==false then
call CursedCrown_Action()
endif
set suijiCursedCrownTarget=null
return false
endfunction
function CursedCrown_Init takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function CursedCrown_Main))
set t=null
endfunction
function Bedlam_Action takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(TABLE_XJ,(OB7),(2)))
local unit IH7=(LoadUnitHandle(TABLE_XJ,(OB7),(3)))
local unit u1=(LoadUnitHandle(TABLE_XJ,(OB7),(17)))
local unit u2=(LoadUnitHandle(TABLE_XJ,(OB7),(19)))
local integer level=(LoadInteger(TABLE_XJ,(OB7),(5)))
local real x
local real y
local real a
local real XGI=0
local real XHI=0
local real J72=-1*360*0.01/1.5
local integer WF8=GetTriggerEvalCount(t)
local real W9I
local group g
local boolexpr bedlamEnemyFilter=null
local unit u
if ZX7==null or IH7==null or u1==null or u2==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 or GetUnitTypeId(u1)==0 or GetUnitTypeId(u2)==0 or UnitAlive(ZX7)==false or UnitAlive(IH7)==false then
if u1!=null then
call RemoveUnit(u1)
endif
if u2!=null then
call RemoveUnit(u2)
endif
call FlushChildHashtable(TABLE_XJ,(OB7))
call OZ7(t)
set t=null
set u1=null
set u2=null
set ZX7=null
set IH7=null
set u=null
set g=null
return false
endif
set XGI=GetUnitX(IH7)
set XHI=GetUnitY(IH7)
if GetTriggerEventId()==EVENT_UNIT_DEATH or WF8==500 then
call RemoveUnit(u1)
call RemoveUnit(u2)
call FlushChildHashtable(TABLE_XJ,(OB7))
call OZ7(t)
else
set W9I=90
set a=W9I+J72*WF8
set x=CoordinateX50(XGI+200*Cos(a*bj_DEGTORAD))
set y=CoordinateY50(XHI+200*Sin(a*bj_DEGTORAD))
call SetUnitX(u1,x)
call SetUnitY(u1,y)
call SetUnitX(u2,x)
call SetUnitY(u2,y)
call MHUnit_SetFacing(u1,a-90,true)
if ModuloInteger(WF8,25)==0 then
set U22=ZX7
set g=WS7()
set bedlamEnemyFilter=Condition(function DKX)
call GroupEnumUnitsInRange(g,XGI,XHI,300,bedlamEnemyFilter)
call DestroyBoolExpr(bedlamEnemyFilter)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call GroupRemoveUnit(g,u)
call B67(ZX7,u,1,15+45*level)
endloop
call WR7(g)
endif
endif
set t=null
set u1=null
set u2=null
set ZX7=null
set IH7=null
set u=null
set g=null
set bedlamEnemyFilter=null
return false
endfunction
function Bedlam_Main takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local unit IH7=GetSpellTargetUnit()
local integer level=0
local trigger t=null
local integer OB7=0
local unit u1
local unit u2
local real x
local real y
local integer suijiBedlamHandle=0
if ZX7==null or IH7==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 then
set ZX7=null
set IH7=null
return
endif
set level=GetUnitAbilityLevel(ZX7,'A4IK')
if SUIJI_MODE then
set suijiBedlamHandle=GetHandleId(ZX7)
