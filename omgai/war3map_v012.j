function O9E takes unit p5,real YM7 returns nothing
local integer V77=0
local real ODE=110
if YM7>ODE*6 then
set V77=6
elseif YM7>ODE*5 then
set V77=5
elseif YM7>ODE*4 then
set V77=4
elseif YM7>ODE*3 then
set V77=3
elseif YM7>ODE*2 then
set V77=2
elseif YM7>ODE*1 then
set V77=1
endif
set V77=YG7(V77,2+B287_GetUnitAbilityLevel(p5,'A1NA'))
call NP7(GetHandleId(p5),"Level",V77)
call O7E(p5,V77)
endfunction
function OEE takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit p5=O77(OB7,"Source")
local integer V77=0
local texttag suijiVisageSoulText=null
if p5==null or GetUnitTypeId(p5)==0 or B287_GetUnitAbilityLevel(p5,'A1NA')<=0 then
if p5!=null then
set suijiVisageSoulText=O87(GetHandleId(p5),"SoulAssumption|Text")
if suijiVisageSoulText!=null then
call DestroyTextTag(suijiVisageSoulText)
endif
set D3[GetPlayerId(GetOwningPlayer(p5))]=null
call NS7(GetHandleId(p5),"SuijiA1NAInit",false)
endif
call NM7(OB7)
call OZ7(t)
set suijiVisageSoulText=null
set t=null
set p5=null
return false
endif
set V77=B287_GetUnitAbilityLevel(p5,'A1NA')
call N0E(p5,OM7(GetHandleId(p5),"Level"),V77)
call O9E(p5,ON7(GetHandleId(p5),"RecentDamage"))
set suijiVisageSoulText=null
set t=null
set p5=null
return false
endfunction
function OFE takes nothing returns nothing
	local unit ZX7 = U22
	local unit IH7 = W22
	local integer h = GetHandleId(GetTriggeringTrigger())
	local real d = LoadReal(TABLE_HY, h, 11)
    if ZX7==null or IH7==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 then
        set ZX7=null
        set IH7=null
        return
    endif
    set f3=true
    call B67(ZX7,IH7,1,d)
    call LINGXIA(ZX7,IH7)
    set f3=false
    call YW7("-"+I2S(R2I(d)),1,IH7,.023,17,217,17,$D8)
set ZX7=null
set IH7=null
endfunction
function OGE takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit p5=O77(OB7,"Source")
if p5!=null and GetUnitTypeId(p5)!=0 then
call O9E(p5,ON7(GetHandleId(p5),"RecentDamage"))
endif
call NM7(OB7)
call OZ7(t)
set t=null
set p5=null
return false
endfunction
function OHE takes nothing returns nothing
local unit p5=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local integer V77=0
local trigger t
local integer OB7
local real d=0.
if p5==null or m5==null or GetUnitTypeId(p5)==0 or GetUnitTypeId(m5)==0 then
set p5=null
set m5=null
return
endif
set V77=OM7(GetHandleId(p5),"Level")
set d=(40+V77*50)*1.
if WQ7(m5)==false then
    set t=NHX(p5, m5,'h0BE', "OFE",1000, true, "")
    call SaveReal(TABLE_HY, GetHandleId(t), 11, d)
endif
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\AntiMagicShell\\AntiMagicShell.mdl",p5,"chest"))
call NQ7(GetHandleId(p5),"RecentDamage",0*1.)
call O9E(p5,0)
call O37(p5,"SoulAssumptionState",4)
set t=CreateTrigger()
set OB7=GetHandleId(t)
call TriggerAddCondition(t,Condition(function OGE))
call TriggerRegisterTimerEvent(t,4,false)
call NT7(OB7,"Source",p5)
set p5=null
set m5=null
set t=null
endfunction
function OIE takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit p5=O77(OB7,"Source")
local real YM7=ON7(OB7,"Damage")
if p5==null or GetUnitTypeId(p5)==0 then
call NM7(OB7)
call OZ7(t)
set t=null
set p5=null
return false
endif
if GetTriggerEventId()!=EVENT_UNIT_SPELL_EFFECT or (GetTriggerEventId()==EVENT_UNIT_SPELL_EFFECT and B287_GetSpellAbilityId()=='A1NA') then
if GetTriggerEventId()!=EVENT_UNIT_SPELL_EFFECT then
call NQ7(GetHandleId(p5),"RecentDamage",(ON7(GetHandleId(p5),"RecentDamage")-YM7)*1.)
endif
call O9E(p5,ON7(GetHandleId(p5),"RecentDamage"))
call NM7(OB7)
call OZ7(t)
endif
set t=null
set p5=null
return false
endfunction
function VisageSoulAssumption_InitUnit takes unit suijiVisageSoulUnit returns nothing
local integer suijiVisageSoulHandle=0
local texttag suijiVisageSoulText=null
local boolean suijiVisageSoulVisible=false
local trigger suijiVisageSoulTrigger=null
if suijiVisageSoulUnit==null or IsUnitIllusion(suijiVisageSoulUnit) then
return
endif
if B287_GetUnitAbilityLevel(suijiVisageSoulUnit,'A1NA')<=0 then
return
endif
set suijiVisageSoulHandle=GetHandleId(suijiVisageSoulUnit)
set D3[GetPlayerId(GetOwningPlayer(suijiVisageSoulUnit))]=suijiVisageSoulUnit
if OO7(suijiVisageSoulHandle,"SuijiA1NAInit") then
call O9E(suijiVisageSoulUnit,ON7(suijiVisageSoulHandle,"RecentDamage"))
return
endif
call NS7(suijiVisageSoulHandle,"SuijiA1NAInit",true)
set suijiVisageSoulText=CreateTextTag()
set suijiVisageSoulTrigger=CreateTrigger()
call TriggerRegisterTimerEvent(suijiVisageSoulTrigger,.05,true)
call TriggerAddCondition(suijiVisageSoulTrigger,Condition(function OEE))
call NT7(GetHandleId(suijiVisageSoulTrigger),"Source",suijiVisageSoulUnit)
if GetOwningPlayer(suijiVisageSoulUnit)==GetLocalPlayer()then
set suijiVisageSoulVisible=true
endif
call SetTextTagText(suijiVisageSoulText," ",.023)
call SetTextTagPosUnit(suijiVisageSoulText,suijiVisageSoulUnit,0)
call SetTextTagVisibility(suijiVisageSoulText,suijiVisageSoulVisible)
call SetTextTagPermanent(suijiVisageSoulText,true)
call N67(suijiVisageSoulHandle,"SoulAssumption|Text",suijiVisageSoulText)
call NQ7(suijiVisageSoulHandle,"RecentDamage",0*1.)
call O9E(suijiVisageSoulUnit,0)
set suijiVisageSoulTrigger=null
set suijiVisageSoulText=null
endfunction
function OJE takes nothing returns nothing
call VisageSoulAssumption_InitUnit(GetTriggerUnit())
endfunction
//灵魂超渡
function OKE takes unit OME,unit ONE returns nothing
local real YM7=GetEventDamage()
local integer V77=0
local real OOE=0.
local trigger t
local integer OB7
if OME==null or ONE==null or GetUnitTypeId(OME)==0 or GetUnitTypeId(ONE)==0 then
set t=null
return
endif
set V77=B287_GetUnitAbilityLevel(OME,'A1NA')
set OOE=ON7(GetHandleId(OME),"RecentDamage")
if KE7(OME,ONE)<1300 and f3==false then
if C67(YM7) and GetEventDamage()>2 and GetEventDamageSource()!=GetTriggerUnit() and TX7(GetOwningPlayer(GetEventDamageSource())) or GetUnitTypeId(GetEventDamageSource())=='n00L' then
set OOE=OOE+YM7
call NQ7(GetHandleId(OME),"RecentDamage",OOE*1.)
set t=CreateTrigger()
set OB7=GetHandleId(t)
call NT7(OB7,"Source",OME)
call NQ7(OB7,"Damage",YM7*1.)
call TriggerRegisterTimerEvent(t,10,false)
call TriggerRegisterUnitEvent(t,OME,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(t,OME,EVENT_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function OIE))
call O9E(OME,OOE)
endif
endif
set t=null
endfunction
function OPE takes nothing returns nothing
local integer i=0
loop
exitwhen i>$C
if D3[i]!=null then
call OKE(D3[i],GetTriggerUnit())
endif
set i=i+1
endloop
endfunction
function OQE takes nothing returns boolean
if B287_GetLearnedSkill()=='A1NA' and B287_GetUnitAbilityLevel(GetTriggerUnit(),'A1NA')==1 and IsUnitIllusion(GetTriggerUnit())==false then
call OJE()
endif
if (B287_GetLearnedSkill()=='A1NE' or B287_GetLearnedSkill()=='A2IG') and IsUnitIllusion(GetTriggerUnit())==false and (B287_GetUnitAbilityLevel(GetTriggerUnit(),'A1NE')==1 or B287_GetUnitAbilityLevel(GetTriggerUnit(),'A2IG')==1) and GetPlayerController(GetOwningPlayer(GetTriggerUnit()))==MAP_CONTROL_USER then
call XF7(GetTriggerUnit(),'A4AV')
call XF7(GetTriggerUnit(),'A4JO')
endif
return false
endfunction
function YSPD takes nothing returns boolean
return GetOwningPlayer(GetFilterUnit())==IR4 and (GetUnitTypeId(GetFilterUnit())=='u014' or GetUnitTypeId(GetFilterUnit())=='u015' or GetUnitTypeId(GetFilterUnit())=='u016' or GetUnitTypeId(GetFilterUnit())=='u01D' or GetUnitTypeId(GetFilterUnit())=='u01E' or GetUnitTypeId(GetFilterUnit())=='u01F' or GetUnitTypeId(GetFilterUnit())=='u01R' or GetUnitTypeId(GetFilterUnit())=='u01S' or GetUnitTypeId(GetFilterUnit())=='u01T') and XH7(GetFilterUnit())==false
endfunction
function YSSH2 takes nothing returns nothing
local real OQD=KF7(GetUnitX(GetEnumUnit()),GetUnitY(GetEnumUnit()),IJ4,IK4)
local real ORD=KF7(GetUnitX(IN4),GetUnitY(IN4),IJ4,IK4)
if OQD<ORD then
set IN4=GetEnumUnit()
endif
endfunction
function YSSH takes nothing returns nothing
local unit suijiVisageStoneCaster=GetTriggerUnit()
local group g=null
if suijiVisageStoneCaster==null or GetUnitTypeId(suijiVisageStoneCaster)==0 then
set suijiVisageStoneCaster=null
return
endif
set g=WS7()
set IR4=GetOwningPlayer(suijiVisageStoneCaster)
call GroupEnumUnitsInRange(g,GetUnitX(suijiVisageStoneCaster),GetUnitY(suijiVisageStoneCaster),9000,Condition(function YSPD))
set IN4=FirstOfGroup(g)
set IJ4=GetUnitX(suijiVisageStoneCaster)
set IK4=GetUnitY(suijiVisageStoneCaster)
if IN4==null or GetUnitTypeId(IN4)==0 then
call WR7(g)
set g=null
set suijiVisageStoneCaster=null
return
endif
call ForGroup(g,function YSSH2)
call IssueImmediateOrderById((IN4),$D00BB)
call IssueImmediateOrderById((IN4),$D00AA)
call IssueImmediateOrderById((IN4),$D02B0)
call IssueImmediateOrderById((IN4),$D00BC)
call IssueImmediateOrderById((IN4),$D00AB)
call IssueImmediateOrderById((IN4),$D02B1)
call WR7(g)
set g=null
set suijiVisageStoneCaster=null
endfunction
function ZHYS_PD takes nothing returns boolean
return (GetUnitTypeId(GetFilterUnit())=='u014' or GetUnitTypeId(GetFilterUnit())=='u015' or GetUnitTypeId(GetFilterUnit())=='u016' or GetUnitTypeId(GetFilterUnit())=='u01D' or GetUnitTypeId(GetFilterUnit())=='u01E' or GetUnitTypeId(GetFilterUnit())=='u01F' or GetUnitTypeId(GetFilterUnit())=='u01R' or GetUnitTypeId(GetFilterUnit())=='u01S' or GetUnitTypeId(GetFilterUnit())=='u01T') and UnitAlive(GetFilterUnit())
endfunction
function ZHYS2 takes nothing returns nothing
local unit VD=GetEnumUnit()
if VD!=null and GetUnitTypeId(VD)!=0 and IN4!=null and GetUnitTypeId(IN4)!=0 and LoadReal(L7,(GetHandleId(VD)),(714))+3<TimerGetElapsed(W) then
call SetUnitX(VD,GetUnitX(IN4)+GetRandomReal(25,50)*Cos(GetRandomReal(0,360)))
call SetUnitY(VD,GetUnitY(IN4)+GetRandomReal(25,50)*Sin(GetRandomReal(0,360)))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\RaiseSkeletonWarrior\\RaiseSkeleton.mdl",VD,"origin"))
endif
set VD=null
endfunction
function ZHYS takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local group g=null
if ZX7==null or GetUnitTypeId(ZX7)==0 then
set ZX7=null
return
endif
set g=WS7()
set IN4=ZX7
call GroupEnumUnitsOfPlayer(g,GetOwningPlayer(ZX7),Condition(function ZHYS_PD))
if FirstOfGroup(g)==null then
    call DisplayTextToPlayer(GetOwningPlayer(ZX7),0,0, "没有可召回的佣兽")
else
    call ForGroup(g,function ZHYS2)
endif
call WR7(g)
set g=null
set ZX7=null
endfunction
function ORE takes nothing returns boolean
if B287_GetSpellAbilityId()=='A1NA' then
call OHE()
endif
if B287_GetSpellAbilityId()=='A4AV' then
call YSSH()
endif
if B287_GetSpellAbilityId()=='A4JO' then
call ZHYS()
endif
return false
endfunction
function J88 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_HERO_SKILL)
call TriggerAddCondition(t,Condition(function OQE))
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function ORE))
set t=null
call S08("OPE")
endfunction
function OSE takes nothing returns boolean
return B287_GetSpellAbilityId()=='A06P'
endfunction
function OTE takes nothing returns boolean
return (IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(D8)) and IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(GetFilterUnit(),'A04R')==0 and GetUnitState(GetFilterUnit(),UNIT_STATE_LIFE)>1)!=null
endfunction
function OUE takes nothing returns nothing
local unit m5=GetEnumUnit()
local unit oA=CreateUnit(GetOwningPlayer(D8),'e00C',GetUnitX(m5),GetUnitY(m5),0)
call XF7(oA,'A0JE')
call SetUnitAbilityLevel(oA,'A0JE',E8)
call IssueTargetOrderById(oA,$D006B,m5)
call UnitApplyTimedLifeBJ(1.,'BTLF',oA)
call UnitAddAbility(oA,'Aloc')
set oA=null
set m5=null
endfunction
function OVE takes unit BB7,unit WI7 returns nothing
local group LQ7=WS7()
local boolexpr hP=Condition(function OTE)
set D8=WI7
call GroupEnumUnitsInRange(LQ7,GetUnitX(BB7),GetUnitY(BB7),675,hP)
call ForGroup(LQ7,function OUE)
call WR7(LQ7)
call DestroyBoolExpr(hP)
set LQ7=null
set hP=null
endfunction
function OWE takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit WI7
local unit oA=O77(OB7,"Caster")
if GetTriggerEventId()==EVENT_UNIT_SPELL_ENDCAST then
call KillUnit(oA)
call NM7(OB7)
call OZ7(t)
elseif GetTriggerEvalCount(t)>22 then
call KillUnit(oA)
call NM7(OB7)
call OZ7((t))
call KR7(O77(OB7,"Hero"))
else
call SetUnitAnimation(oA,"birth")
set WI7=O77(OB7,"Hero")
set E8=GetTriggerExecCount(t)*B287_GetUnitAbilityLevel(WI7,'A06P')/2
if E8 >=12 then
set E8 = 12
elseif E8 <1 then
set E8 = 1
endif
//call OVE(oA,WI7)
call SetUnitAbilityLevel(oA,'A0JE',E8)
endif
set t=null
set oA=null
set WI7=null
endfunction
function OXE takes nothing returns nothing
local unit WI7=GetTriggerUnit()
local location Mk=GetSpellTargetLoc()
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local real x=GetLocationX(Mk)
local real y=GetLocationY(Mk)
local unit oA=CreateUnit(GetOwningPlayer(WI7),'e01G',x,y,0)
call XF7(oA,'A0JE')
call RemoveLocation(Mk)
if SuijiMode_HasAghanimState(WI7) then
else
call TriggerRegisterUnitEvent(t,WI7,EVENT_UNIT_SPELL_ENDCAST)
endif
call TriggerRegisterTimerEvent(t,.5,true)
call TriggerAddAction(t,function OWE)
call NT7(OB7,"Hero",WI7)
call NT7(OB7,"Caster",oA)
set WI7=null
set Mk=null
set t=null
set oA=null
endfunction
function J18 takes nothing returns nothing
local trigger t=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddAction(t,function OXE)
call TriggerAddCondition(t,Condition(function OSE))
call X_7('A0JE')
set t=null
endfunction
function OYE takes nothing returns boolean
return B287_GetSpellAbilityId()=='A0J5'
endfunction
function OZE takes nothing returns nothing
call Z57(GetEnumUnit(),'A0P2',1,25,'B048')
endfunction
function OBE takes unit OCE,unit O3E returns nothing
if OCE!=null and O3E!=null then
call YV7("CLPB",GetUnitX(OCE),GetUnitY(OCE),GetUnitX(O3E),GetUnitY(O3E),.7,.1,.9,1,.3)
endif
endfunction
function O6E takes nothing returns nothing
local unit WI7=O77(GetHandleId(GetTriggeringTrigger()),"Hero")
local real YM7=.2*GetEventDamage()
set YM7=YJ7(YM7,GetUnitState(GetTriggerUnit(),UNIT_STATE_LIFE))
if GetUnitState(GetEnumUnit(),UNIT_STATE_LIFE)>1 and GetEnumUnit()!=GetTriggerUnit() and GetUnitAbilityLevel(GetEnumUnit(),'B048')>0 then
if GetUnitState(GetEnumUnit(),UNIT_STATE_LIFE)<YM7 then
call B67(WI7,GetEnumUnit(),3,YM7)
else
call ZA7(WI7,GetEnumUnit(),YM7)
endif
endif
set WI7=null
endfunction
function OLE takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local group LQ7=OF7(OB7,"Group")
local real time=ON7(OB7,"TIME")
if GetTriggerEventId()==EVENT_UNIT_DAMAGED and GetUnitAbilityLevel(GetTriggerUnit(),'B048')>0 then
	if GetEventDamage()>$A and GetEventDamage()<9000 then
		call DisableTrigger(t)
		call ForGroup(LQ7,function O6E)
		call EnableTrigger(t)
	endif
elseif GetGameTime()>time then
	call WR7(LQ7)
	call NM7(OB7)
	call OZ7(t)
endif
set t=null
set LQ7=null
endfunction
function O1E takes nothing returns boolean
