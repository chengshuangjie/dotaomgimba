function WYSW_TRI takes nothing returns nothing
	local trigger t=GetTriggeringTrigger()
	local integer OB7=GetHandleId(t)
	local unit ZX7=LoadUnitHandle(L7,OB7,0)
	local unit BB7=LoadUnitHandle(L7,OB7,1)
	local real DUR=LoadReal(L7,OB7,2)
	local unit IH7=LoadUnitHandle(L7,OB7,3)
	local string VH
	if GetGameTime()>DUR or ZX7==null or BB7==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(BB7)==0 or UnitAlive(ZX7)==false or UnitAlive(BB7)==false then
		if BB7!=null and GetUnitTypeId(BB7)!=0 and UnitAlive(BB7) then
			call KillUnit(BB7)
		endif
		call FlushChildHashtable(L7, OB7)
		call OZ7(t)
	elseif GetTriggerEventId()==EVENT_UNIT_ISSUED_TARGET_ORDER and (GetUnitCurrentOrder(ZX7)==$D000F or GetUnitCurrentOrder(ZX7)==$D0003) and IsUnitEnemy(GetOrderTargetUnit(),GetOwningPlayer(ZX7)) then
		call SaveUnitHandle(L7,OB7,3,GetOrderTargetUnit())
	else
		call SetUnitX(BB7,GetUnitX(ZX7))
		call SetUnitY(BB7,GetUnitY(ZX7))
		if IsHideUnit(ZX7) or IsUnitVisible(ZX7,GetLocalPlayer())==false then
			set VH=""
		else
			set VH="units\\orc\\SerpentWard\\SerpentWard.mdl"
		endif
		call MHUnit_SetModel(BB7,VH,false)
		if ModuloInteger(GetTriggerEvalCount(t),25)==0 and IH7!=null and GetUnitTypeId(IH7)!=0 then
			call IssueTargetOrderById(BB7,$D000F,IH7)
		endif
	endif
	set ZX7=null
	set BB7=null
	set IH7=null
	set t=null
endfunction
function WYSW takes unit ZX7,unit IH7 returns nothing
local unit BB7
local integer uid
local player p=null
local real x
local real y
local integer level=0
local real d=40.
local trigger t
local integer OB7
local boolean b=false
local integer DC_level=0
local real EX_ATTACK=0.
if ZX7==null or GetUnitTypeId(ZX7)==0 then
    return
endif
if IH7!=null and GetUnitTypeId(IH7)==0 then
    set IH7=null
endif
set p=GetOwningPlayer(ZX7)
set level=B287_GetUnitAbilityLevel(ZX7,'A0MS')
set DC_level=B287_GetUnitAbilityLevel(ZX7,'A0MY')
set EX_ATTACK=(GetUnitState(ZX7, UNIT_STATE_ATTACK1_DAMAGE_BASE) + GetUnitState(ZX7, UNIT_STATE_ATTACK1_DAMAGE_BONUS))*0.15
if ISLABIKE(ZX7) then
    set DC_level=4
endif
if ISLABIKE(ZX7) and level<=0 then
    set level=4
endif
if level<=0 then
    set p=null
    return
endif
if IH7!=null and IsUnitAlly(IH7,GetOwningPlayer(ZX7)) and SuijiMode_HasAghanimState(ZX7) and GetUnitAbilityLevel(IH7,'A04R')==0 then
	set x=GetUnitX(IH7)
	set y=GetUnitY(IH7)
	set b=true
elseif IH7!=null then
	set x=GetUnitX(IH7)
	set y=GetUnitY(IH7)
else
    set x=GetSpellTargetX()
    set y=GetSpellTargetY()
endif
if level==1 then
	set uid='o00T'
elseif level==2 then
	set uid='o00U'
elseif level==3 then
	set uid='o00V'
elseif level==4 then
	set uid='o00W'
endif
set BB7=CreateUnit(p,uid,x,y,0)
call UnitApplyTimedLife(BB7,'BTLF',d)
call UnitRemoveAbility(BB7,'Amov')
if DC_level>0 then
call XF7(BB7,'A0MY')
call B287_SetUnitAbilityLevel(BB7,'A0MY',DC_level)
endif
if SuijiMode_HasAghanimState(ZX7) then
	call YLG2(BB7,R2I(EX_ATTACK))
	// call SetUnitState(BB7,UNIT_STATE_ATTACK1_COOL,GetUnitState(ZX7,UNIT_STATE_ATTACK1_COOL))
	// call SetUnitState(BB7,UNIT_STATE_ATTACK1_SPEED,GetUnitState(ZX7,UNIT_STATE_ATTACK1_SPEED))
	// call SetUnitState(BB7,UNIT_STATE_ATTACK1_COOL,GetUnitState(ZX7,UNIT_STATE_ATTACK1_COOL))
	// call SetUnitState(BB7,UNIT_STATE_ATTACK1_SPEED,GetUnitState(ZX7,UNIT_STATE_ATTACK1_SPEED))
	// call SetUnitState(BB7,UNIT_STATE_ATTACK1_COOL,GetUnitState(ZX7,UNIT_STATE_ATTACK1_COOL))
	// call SetUnitState(BB7,UNIT_STATE_ATTACK1_SPEED,GetUnitState(ZX7,UNIT_STATE_ATTACK1_SPEED))
endif
if b then
	call XF7(BB7,'Aloc')
	call SetUnitPhaseMove(BB7,true)
	set t=CreateTrigger()
	set OB7=GetHandleId(t)
	call SaveUnitHandle(L7,OB7,0,IH7)
	call SaveUnitHandle(L7,OB7,1,BB7)
	call SaveReal(L7,OB7,2,GetGameTime()+d)
	call SaveUnitHandle(L7,OB7,3,null)
	call TriggerRegisterTimerEvent(t,.02,true)
	call TriggerRegisterUnitEvent(t,IH7,EVENT_UNIT_ISSUED_TARGET_ORDER)
	call TriggerAddCondition(t,Condition(function WYSW_TRI))
endif
set BB7=null
set p=null
set t=null
endfunction
