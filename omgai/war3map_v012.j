function R23 takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local integer id=GetUnitTypeId(ZX7)
local timer t=CreateTimer()
local unit IH7=GetSpellTargetUnit()
local unit BB7=CreateUnit(GetOwningPlayer(ZX7),'e00E',GetUnitX(IH7),GetUnitY(IH7),0)
local integer BC7=B287_GetUnitAbilityLevel(ZX7,'A04C')
local integer skill1
local integer skill2
local integer targetid=GetUnitTypeId(IH7)
if id=='Zjai' then
set skill1='X2WE'
set skill2='X2WF'
elseif id=='Zjaj' then
set skill1='X3WE'
set skill2='X3WF'
elseif id=='Zjak' then
set skill1='X4WE'
set skill2='X4WF'
else
set skill1='A2WE'
set skill2='A2WF'
endif
if targetid=='ndtw' or targetid=='nsth' then
if id=='Zjai' then
set skill1='X2W3'
elseif id=='Zjaj' then
set skill1='X3W3'
elseif id=='Zjak' then
set skill1='X4W3'
else
set skill1='A3WE'
endif
endif
call UnitAddAbility(BB7,skill1)
call SetUnitAbilityLevel(BB7,skill1,BC7)
if IssueTargetOrderById(BB7,$D00CB,IH7)==false then
call UnitAddAbility(BB7,skill2)
call SetUnitAbilityLevel(BB7,skill2,BC7)
if IssueTargetOrderById(BB7,$D008A,IH7)then
call XF7(IH7,'A2WG')
endif
endif
call UnitApplyTimedLife(BB7,'BTLF',2.)
call TimerStart(t,.5,true,function R22)
call SaveUnitHandle(L7,GetHandleId(t),0,ZX7)
call SaveUnitHandle(L7,GetHandleId(t),1,IH7)
call B67(ZX7,IH7,1,50)
call LINGXIA(ZX7,IH7)
set t=null
set IH7=null
set BB7=null
set ZX7=null
endfunction
