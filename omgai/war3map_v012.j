function BWDDL takes unit ZX7,unit IH7 returns nothing
    local integer level=B287_GetUnitAbilityLevel(ZX7,'A1E6')
    if level<1 then
        return
    endif
    if level>4 then
        set level=4
    endif
    if ISPH(ZX7)==false and WF7(IH7)==false or GetUnitAbilityLevel(IH7,'B014')>0 then
	    call RemoveUnitGoodBuff(IH7,false)
        call RemoveRYBF(IH7)
        call FCE(ZX7,IH7,level)
        call Z57(IH7,'A4KC', 1, 0.5*level,'B0KI')
    endif
endfunction
