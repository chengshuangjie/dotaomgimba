local real x=GetUnitX(ZX7)+20*Cos(a)
local real y=GetUnitY(ZX7)+20*Sin(a)
local location l
if d<300 or d>$866 then
set l=YV8(x,y)
set x=GetLocationX(l)
set y=GetLocationY(l)
call SetUnitX(ZX7,X17(x))
call SetUnitY(ZX7,X17(y))
call Y67(x,y,350)
call RemoveLocation(l)
