if GetUnitState(VA7,UNIT_STATE_LIFE)>5. and I77!=null and TZ7(GetOwningPlayer(VA7)) and GetUnitTypeId(VB7)=='h0BT' and UC7(VA7)==false then
call IssuePointOrderById(VA7,$D00D9,GetUnitX(VB7),GetUnitY(VB7))
