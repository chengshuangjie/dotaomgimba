function O9D takes nothing returns nothing
local unit templarPsiBladesUnit=GetTriggerUnit()
if B287_GetUnitAbilityLevel(templarPsiBladesUnit,'A0RO')==1 then
    call DisplayTextToPlayer(GetOwningPlayer(templarPsiBladesUnit),0,0, "你可以输入 -display 来开启/关闭灵能之刃的作用范围显示")
endif
call TemplarAssassin_UpdatePsiBladesRange(templarPsiBladesUnit)
set templarPsiBladesUnit=null
endfunction
