call KillUnit(Y27)
call NM7(I97)
call OZ7(t)
elseif KF7(Y_7,Z47,Z97,ZD7)<=Z77 then
call KillUnit(Y27)
set IN4=O77(I97,"Source")
set IP4=IH7
call ExecuteFunc(OP7(I97,"Callback"))
call NM7(I97)
call OZ7(t)
endif
set t=null
set IH7=null
set Y27=null
