function V79 takes nothing returns nothing
	local timer t = GetExpiredTimer()
	local integer WFV = GetHandleId(t)
	local integer DSR = LoadInteger(TABLE_P, WFV, 0)
	local integer UYX = LoadInteger(TABLE_P, DSR,'A0FV')-1 //叠加次数
	local unit u = LoadUnitHandle(TABLE_P, WFV, 0)
	local integer G1R = LoadInteger(TABLE_P, GetHandleId(u),'WARP')
	local integer N3X
	local integer WUV = LoadInteger(TABLE_P, GetHandleId(u),'WARL')
	local integer i = R2I(.5 * WUV * WUV + .5 * WUV + 4)
	local integer CJR
	set CJR =(15 + 5 * WUV) * UYX //攻击力
	set N3X = UYX *(WUV + 2)  //移速
    call Change_MS(u,N3X)
	call B_7(u,CJR)
    if UYX==0 then
        call UnitRemoveAbility(u,'A4EJ')
        call UnitRemoveAbility(u,'A4EN')
    endif
	call SaveInteger(TABLE_P, DSR,'A0FV', UYX)
	call PauseTimer(t)
	call FlushChildHashtable(TABLE_P,WFV)
	call DestroyTimer(t)
	set t = null
	set u = null
endfunction
function VE9 takes nothing returns nothing
	local timer t = null
	local unit u=GetTriggerUnit()
local integer WUV=B287_GetUnitAbilityLevel(u,'A0FV')
	local integer W0V
	local integer N3X
	local integer CJR
	local integer WFV = GetHandleId(u)
	local integer UYX = LoadInteger(TABLE_P, WFV,'A0FV')+ 1 //叠加次数
    local integer Times=5+WUV
    local integer id=GetUnitTypeId(u)
    local integer skill
    local integer skill2
    if id=='Z018' then
        set skill='A4EN'
        set skill2='A4EM'
    else
        set skill='A4EJ'
        set skill2='A4EI'
    endif
    if SuijiMode_HasAghanimState(u) then
        set Times=Times+3
    endif
	if UYX >= Times then //最多叠加次数
        set u=null
		return
	endif
	set CJR =(15 + 5 * WUV) * UYX //攻击力
	set t = CreateTimer()
	set W0V = GetHandleId(t)
	set N3X = UYX *(WUV + 2) //移速
	call B_7(u,CJR)
	call SaveInteger(TABLE_P, WFV,'A0FV', UYX)
	call SaveInteger(TABLE_P, WFV,'WARL', WUV)
    call Change_MS(u,N3X)
	call SaveUnitHandle(TABLE_P, W0V, 0, u)
	call SaveInteger(TABLE_P, W0V, 0, WFV)
	call TimerStart(t, 14., false, function V79)
	call XF7(u,skill)
	call UnitMakeAbilityPermanent(u, true,skill2)
	set t = null
	set u = null
endfunction
