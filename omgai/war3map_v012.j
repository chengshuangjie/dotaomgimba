endfunction
function ZQH5 takes nothing returns nothing
local unit IH7=GetEnumUnit()
if WQ7(IH7) then
    call PLK(IH7)
else
    if CHUIFENG(IH7) then
        call UnitCancelHide(IH7)
    endif
    call YS7("war3mapImported\\FortunesEndTarget.mdx",IH7,"origin",J5II)
    call IssueTargetOrder(J4I,"purge",IH7)  //移除涤罪之焰
if J6I!=null and GetUnitAbilityLevel(IH7,'A2VD')>0 then
    call TriggerEvaluate(J6I)  //移除命运敕令
    endif
    if WF7(IH7)==false or GetUnitAbilityLevel(IH7,'B014')>0 then
        call RemoveUnitGoodBuff(IH7,false)
        call RemoveRYBF(IH7)
        call Z57(IH7,'A4KD', 1, J5II,'B0KJ')
    endif
    if IsPlayerAlly(GetOwningPlayer(IH7),GetOwningPlayer(J3I))==false then
    call B67(J3I,IH7,1,50+50*J5I)
    endif
    if IH7==VJ4 then
        call LINGXIA(J3I,IH7)
    endif
endif
set IH7=null
endfunction
function ZQZ5_PD takes nothing returns boolean
return(IsUnitEnemy(IN4,GetOwningPlayer(GetFilterUnit()))and((GetUnitAbilityLevel(GetFilterUnit(),'A04R')==0 or CHUIFENG(GetFilterUnit())) and IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==false and XH7(GetFilterUnit())==false))!=null
endfunction
function ZQZ5 takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local unit IH7=(LoadUnitHandle(L7,(GetHandleId(ZX7)),(796)))
local real time=YJ7((TimerGetElapsed(W))-(LoadReal(L7,(GetHandleId(ZX7)),(358))),2.5)
local integer BC7=B287_GetUnitAbilityLevel(ZX7,'A2V1')
local integer QV5=R2I(2.0*time)
local unit BB7=CreateUnit(GetOwningPlayer(ZX7),'e00E',GetUnitX(ZX7),GetUnitY(ZX7),GetUnitFacing(ZX7))
local unit QW5
local group g
local integer R3C='A2XS'
local real d
if time>2.4 then
    set d=2.5
elseif time>1.9 then
    set d=2.
elseif time>1.4 then
    set d=1.5
elseif time>.9 then
    set d=1.
else
    set d=.5
endif
if SuijiMode_HasAghanimState(ZX7) then
    set d=2.5
endif
// if QV5>3 then
// set R3C=R3C+1
// set QV5=QV5-3
// endif
// if QV5>3 then
// set R3C=R3C+1
// set QV5=QV5-3
// endif
// if QV5>3 then
// set R3C=R3C+1
// set QV5=QV5-3
// endif
if IH7!=null then
set QW5=CreateUnit(GetOwningPlayer(ZX7),'o00Z',GetUnitX(IH7),GetUnitY(IH7),0)
call UnitApplyTimedLife(QW5,'BTLF',.5)
call UnitAddAbility(BB7,R3C)
// call SetUnitAbilityLevel(BB7,R3C,QV5)
set IN4=ZX7
set J3I=ZX7
set J4I=BB7
set J5I=BC7
set J5II=d
set VJ4=IH7
set g=WS7()
call GroupEnumUnitsInRange(g,GetUnitX(IH7),GetUnitY(IH7),325,Condition(function ZQZ5_PD))
call ForGroup(g,function ZQH5)
call WR7(g)
endif
set ZX7=null
set IH7=null
set BB7=null
set QW5=null
set g=null
endfunction
function ZQY5 takes nothing returns nothing
local unit WX7=GetTriggerUnit()
call SaveReal(L7,(GetHandleId(WX7)),(358),(((TimerGetElapsed(W)))*1.0))
call SaveUnitHandle(L7,(GetHandleId(WX7)),(796),(GetSpellTargetUnit()))
call DestroyEffect(AddSpecialEffect("war3mapImported\\CleanseTargetArea.mdx",GetUnitX(GetSpellTargetUnit()),GetUnitY(GetSpellTargetUnit())))
set WX7=null
endfunction
//气运之末
function ZQJ5 takes nothing returns boolean
local unit ZX7=GetTriggerUnit()
local unit IH7=GetSpellTargetUnit()
if B287_GetSpellAbilityId()=='A2V1' then
if GetTriggerEventId()==EVENT_PLAYER_UNIT_SPELL_CAST then
    call SaveBoolean(L7,(GetHandleId(ZX7)),(360),(false))
    if WF7(IH7) and GetUnitAbilityLevel(IH7,'B014')==0 then
        call KR7(ZX7)
call X37(GetOwningPlayer(ZX7),GetObjectName('n0LR'))
    else
        call ZQY5()
    endif
elseif GetTriggerEventId()==EVENT_PLAYER_UNIT_SPELL_EFFECT then
    if WQ7(IH7) then
        call PLK(IH7)
    else
            call SaveBoolean(L7,(GetHandleId(ZX7)),(360),(true))
    endif
elseif(LoadBoolean(L7,(GetHandleId(ZX7)),(360)))==true then
    call ZQZ5()
endif
endif
set ZX7=null
set IH7=null
return false
endfunction
function RL1 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_ENDCAST)
call YB7(t,EVENT_PLAYER_UNIT_SPELL_CAST)
