elseif V77==1 then
call UnitRemoveAbility(p5,'A1J3')
call UnitRemoveAbility(p5,'A1J5')
call UnitRemoveAbility(p5,'A1IU')
elseif V77==2 then
call UnitRemoveAbility(p5,'A1J4')
call UnitRemoveAbility(p5,'A1J5')
call UnitRemoveAbility(p5,'A1IU')
elseif V77==3 then
call UnitRemoveAbility(p5,'A1J4')
call UnitRemoveAbility(p5,'A1J3')
call UnitRemoveAbility(p5,'A1IU')
elseif V77==4 then
call UnitRemoveAbility(p5,'A1J4')
call UnitRemoveAbility(p5,'A1J3')
call UnitRemoveAbility(p5,'A1J5')
endif
set m5=null
set p5=null
set t=null
endif
endif
return false
