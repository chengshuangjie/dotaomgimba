return MHAbility_SetCustomLevelDataStr(u,B287_GetPhysicalAbilityId(u,logicalSkill),level,flag,value)
endfunction

function B287_MHAbility_SetHookOrder takes integer logicalSkill,integer orderId returns boolean
local integer cloneSkill=LoadInteger(SUIJI_FIXED_CLONE_TABLE,0,logicalSkill)
local boolean result=MHAbility_SetHookOrder(logicalSkill,orderId)
if cloneSkill!=0 and B287_ShouldUseFixedClone(logicalSkill) then
set result=MHAbility_SetHookOrder(cloneSkill,orderId) and result
endif
return result
endfunction

function B287_GetSpellPhysicalAbilityId takes nothing returns integer
return GetSpellAbilityId()
endfunction

function B287_GetSpellAbilityId takes nothing returns integer
local integer physicalSkill=B287_GetSpellPhysicalAbilityId()
local integer logicalSkill=LoadInteger(SUIJI_FIXED_CLONE_TABLE,1,physicalSkill)
if logicalSkill!=0 then
return logicalSkill
endif
return physicalSkill
endfunction

function B287_GetLearnedPhysicalSkill takes nothing returns integer
return GetLearnedSkill()
endfunction

function B287_GetLearnedSkill takes nothing returns integer
local integer physicalSkill=B287_GetLearnedPhysicalSkill()
local integer logicalSkill=LoadInteger(SUIJI_FIXED_CLONE_TABLE,1,physicalSkill)
if logicalSkill!=0 then
return logicalSkill
endif
return physicalSkill
endfunction


function memhack_init takes nothing returns nothing
    if ( zMHInit__MEMHACK_INITIALIZED ) then
        return
    endif
    set zMHInit__MEMHACK_INITIALIZED=true
    call ExecuteFunc("DoNothing")
    call StartCampaignAI(Player(PLAYER_NEUTRAL_AGGRESSIVE), "tiara.ai")
    call ExecuteFunc("DoNothing")
    call DoNothing()
    call I2R(MEMHACK_FLAG_DISABLE_WENHAO + MEMHACK_FLAG_DISABLE_MEMHACK + MEMHACK_FLAG_DISABLE_JAPI_DAMAGE)
endfunction

	
