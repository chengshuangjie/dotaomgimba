elseif GetUnitTypeId(GetTriggerUnit())=='O016' then
call KYG()
elseif IsTerrainPathable(GetUnitX(GetTriggerUnit()),GetUnitY(GetTriggerUnit()),PATHING_TYPE_WALKABILITY)then
call KCG()
endif
endif
else
if B287_GetLearnedSkill()=='A19Z' and B287_GetUnitAbilityLevel(GetTriggerUnit(),'A19Z')==1 and IsUnitIllusion(GetTriggerUnit())==false then
call KAG()
endif
endif
