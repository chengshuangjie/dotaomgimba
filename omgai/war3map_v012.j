function Func_sl takes nothing returns nothing
local string VH=StringCase(GetEventPlayerChatString(),false)
local integer i
local integer n
if TV7(GetTriggerPlayer()) then
	set n=T[0]
else
	set n=T[6]
endif
if SubString(VH,0,4)=="-sl " then
set i=S2I(SubString(VH,4,StringLength(VH)))
if i>0 then
    if Bz>60. then
        if i<=killers then
            call DisplayTextToPlayer(GetTriggerPlayer(),0,0, "输入错误，人头数需要大于"+I2S(killers))
		elseif i<=n then
            call DisplayTextToPlayer(GetTriggerPlayer(),0,0, "输入错误，人头数需要大于已击杀数量"+I2S(n))
        else
            set killers=i
            call VV7(bj_FORCE_ALL_PLAYERS,$A,"|cFF00FF00已调整人头数为：|r|c00FF0000"+I2S(killers)+"|r  (任意一方杀完即可获胜)")
        endif
    else
        if killers>0 then
            set killers=i
            call VV7(bj_FORCE_ALL_PLAYERS,$A,"|cFF00FF00已调整人头数为：|r|c00FF0000"+I2S(killers)+"|r  (任意一方杀完即可获胜)")
        else
            set killers=i
            call VV7(bj_FORCE_ALL_PLAYERS,$A,"|cFF00FF00已开启杀戮模式，人头数为：|r|c00FF0000"+I2S(killers)+"|r  (任意一方杀完即可获胜)")
        endif
    endif
else
    call DisplayTextToPlayer(GetTriggerPlayer(),0,0, "输入错误")
endif
endif
endfunction
