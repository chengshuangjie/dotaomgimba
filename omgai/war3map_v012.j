call SuijiMode_TideRavageMulticastText(WI7,suijiRavageMulticastCount)
set YM7=YM7*suijiRavageMulticastCount
set Hk=Hk+.30*(suijiRavageMulticastCount-1)
endif
if GetPlayerController(GetOwningPlayer(WI7))==MAP_CONTROL_COMPUTER then
    set HMRS=0
    call AI_USE_TH(WI7)
endif
loop
exitwhen i>16
set x2=x1+(range)*Cos(22.5*i*bj_DEGTORAD)
set y2=y1+(range)*Sin(22.5*i*bj_DEGTORAD)
call H8E(WI7,null,YM7,Hk,.75,x1,y1,x2,y2,250,g,false,775)
set i=i+1
endloop
call XFF(g)
set WI7=null
set oA=null
set g=null
endfunction
