function PD_Alreay_Use takes player p,integer O5,integer n,integer skill returns nothing
    local trigger t=CreateTrigger()
    local integer OB7=GetHandleId(t)
    call TriggerRegisterPlayerUnitEvent(t,p,EVENT_PLAYER_UNIT_SPELL_EFFECT,Condition(function TO7))
    call TriggerRegisterTimerEvent(t,10.,false)
    call TriggerAddCondition(t,Condition(function PD_Alreay_Use2))
    call SaveInteger(L7,OB7,0,O5)
    call SaveInteger(L7,OB7,1,n)
    call SaveInteger(L7,OB7,2,skill)
    set t=null
endfunction
function Record_Buy_Item takes player p,integer O5,integer id returns nothing
    call SaveInteger(TABLE_BUY,O5,BUY[O5] , ZU[id])
