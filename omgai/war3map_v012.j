function XF7 takes unit WX7,integer XG7 returns nothing
call UnitAddAbility(WX7,XG7)
call UnitMakeAbilityPermanent(WX7,true,XG7)
endfunction
function ConvertHandle takes handle h returns integer
	return MHTool_ToObject(h)
endfunction
function ReadRealMemory takes integer addr returns integer
	return MHTool_ReadInt(addr)
endfunction
function WriteRealMemory takes integer addr,integer value returns nothing
	call MHTool_WriteInt(addr , value)
endfunction
function UnitAdd0x60Flag takes unit whichUnit,integer bit returns nothing
	local integer pData= ConvertHandle(whichUnit)
	if pData > 0 then
set pData=pData+96
		if pData > 0 then
			call WriteRealMemory(pData , MHMath_AddBit(ReadRealMemory(pData) , bit))
		endif
	endif
endfunction
function UnitRemove0x60Flag takes unit whichUnit,integer bit returns nothing
	local integer pData= ConvertHandle(whichUnit)
	if pData > 0 then
set pData=pData+96
		if pData > 0 then
			call WriteRealMemory(pData , MHMath_RemoveBit(ReadRealMemory(pData) , bit))
		endif
	endif
endfunction
//添加隐藏
function UnitEnterHide takes unit whichUnit returns nothing
    call XF7(whichUnit,'A04R')
call UnitAdd0x60Flag(whichUnit,32)
    call MHUnit_Flag1Operator(whichUnit , FLAG_OPERATOR_ADD , UNIT_FLAG1_HIDE)
endfunction
//取消隐藏
function UnitCancelHide takes unit whichUnit returns nothing
    call UnitRemoveAbility(whichUnit,'A04R')
call UnitRemove0x60Flag(whichUnit,32)
    call MHUnit_Flag1Operator(whichUnit , FLAG_OPERATOR_REMOVE , UNIT_FLAG1_HIDE)
endfunction


