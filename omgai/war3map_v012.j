local integer OB7=Get_Multiple_Skill_Key(ZX7,'A4BP')
local real x=GetSpellTargetX()
local real y=GetSpellTargetY()
local integer BC7=GetUnitAbilityLevel(ZX7,'A4BP')+GetUnitAbilityLevel(ZX7,'A4BQ')+Labike_Multiple_Skill_Level(ZX7,'A4BP')
local unit BB7=CreateUnit(GetOwningPlayer(ZX7),'e00E',x,y,0)
local integer N5E=(LoadInteger(MSK,(OB7),(30)))
local real WF8
local integer skill=(LoadInteger(MSK,(OB7),(N5E)))
local integer skilltx
local integer id=GetUnitTypeId(ZX7)
if SUIJI_MODE and OO7(GetHandleId(ZX7),"SuijiDone") and BC7<1 then
set BC7=B287_GetUnitAbilityLevel(ZX7,B287_GetSpellAbilityId())
endif
if id=='N10R' then
    set skilltx='A362'
elseif id=='N20R' then
    set skilltx='A462'
elseif id=='N30R' then
    set skilltx='A562'
else
    set skilltx='A262'
