set i=5
if AJE!=null and AXE==1 and(ARE==A9E or PK4 or(GetPlayerSlotState((ARE))==PLAYER_SLOT_STATE_LEFT))then
set Z5E[i+1]=A3E
else
set Z5E[i+1]=0
endif
set Z5E[0]=Y68
set i=1
loop
exitwhen i>(FQ4)
set Z_E[0]=FJ4[i]
set Z_E[1]=FK4[i]
set Z_E[2]=FM4[i]
set Z_E[3]=FN4[i]
set Z_E[4]=FO4[i]
if A6E then
set A4E[0]=true
set A4E[1]=true
set A4E[2]=true
set A4E[3]=true
set A4E[4]=true
set A4E[5]=true
