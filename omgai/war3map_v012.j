function F9G takes nothing returns nothing
local unit WI7=GetTriggerUnit()
local location l
local real x
local real y
local unit m5=GetSpellTargetUnit()
if m5==null then
set l=GetSpellTargetLoc()
set x=GetLocationX(l)
set y=GetLocationY(l)
call RemoveLocation(l)
if B287_GetSpellAbilityId()=='A0CX' then
set m5=E_G(WI7,x,y)
else
set m5=F8G(WI7,x,y)
endif
set x=GetUnitX(m5)
set y=GetUnitY(m5)
else
set x=GetUnitX(GetSpellTargetUnit())
set y=GetUnitY(GetSpellTargetUnit())
endif
if(IsUnitAlly(WI7,GetLocalPlayer())and GetLocalPlayer()!=GetOwningPlayer(WI7))or(V8 and(GetLocalPlayer()==KX4 or GetLocalPlayer()==KY4))then
call PingMinimapEx(x,y,3,$FF,$FF,$FF,false)
endif
set WI7=null
set l=null
set m5=null
endfunction
function FDG takes nothing returns boolean
if B287_GetSpellAbilityId()=='A0CX' or B287_GetSpellAbilityId()=='AImt' then
call F9G()
endif
return false
endfunction
function FEG_ACTION takes nothing returns nothing
	local unit IH7=GetEnumUnit()
	call CommonUnitAddStun(IH7, 0.1, false)
	call B67(IN4,IH7,1,IJ4)
	set IH7=null
endfunction
function FEG takes unit ZX7,integer level,boolean b returns nothing
local group g=WS7()
local real x=GetUnitX(ZX7)
local real y=GetUnitY(ZX7)
local unit IH7
local real d=level*25+25
set IN4=ZX7
set IJ4=d
call GroupEnumUnitsInRange(g,x,y,300,Condition(function A17))
if b then
	call ForGroup(g,function FEG_ACTION)
else
	set IH7=GroupPickRandomUnit(g)
	if IH7!=null then
		call CommonUnitAddStun(IH7, 0.1, false)
		call B67(ZX7,IH7,1,d)
	endif
endif
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\FlakCannons\\FlakTarget.mdl",ZX7,"origin"))
call WR7(g)
set g=null
set IH7=null
endfunction
function FJG takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer FKG=GetHandleId(t)
local integer FMG=GetTriggerEvalCount(t)
local unit FNG=O77(FKG,"Hero")
local real DUR=ON7(FKG,"DUR")
if GetGameTime()>DUR or GetTriggerEventId()==EVENT_UNIT_DEATH then
call NM7(FKG)
call OZ7(t)
else
call FEG(FNG,OM7(FKG,"Level"),OO7(FKG,"HaveA"))
endif
set t=null
set FNG=null
return false
endfunction
function Clockwerk_HasScepter takes unit clockwerkScepterUnit returns boolean
if clockwerkScepterUnit==null then
return false
endif
return SuijiMode_HasAghanimState(clockwerkScepterUnit)
endfunction
function FOG takes nothing returns nothing
local trigger t=CreateTrigger()
local integer FKG=GetHandleId(t)
local unit FNG=GetTriggerUnit()
local integer level=B287_GetUnitAbilityLevel(FNG,'A0Z4')
local real d
local boolean b=false
if Clockwerk_HasScepter(FNG) then
	set b=true
endif
if level==1 then
	set d=0.7
elseif level==2 then
	set d=0.6
else
	set d=0.5
endif
call TriggerRegisterTimerEvent(t,d,true)
call TriggerRegisterUnitEvent(t,FNG,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function FJG))
call NT7(FKG,"Hero",FNG)
call NP7(FKG,"Level",level)
call NS7(FKG,"HaveA",b)
call NQ7(FKG,"DUR",GetGameTime()+10.)
call TriggerEvaluate(t)
set t=null
set FNG=null
endfunction
function FPG takes nothing returns boolean
if B287_GetSpellAbilityId()=='A0Z4' then
call FOG()
endif
return false
endfunction
function MZ8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function FPG))
set t=null
endfunction
function G9G takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit m5=O77(OB7,"Target")
local real GDG=ON7(OB7,"Angle")
local real x=GetUnitX(m5)
local real y=GetUnitY(m5)
local real T5F=6
local unit p5=O77(OB7,"Source")
local real GEG=ON7(OB7,"Damage")
if GetTriggerEvalCount(t)>21 then
call NM7(OB7)
call OZ7(t)
call OX7(m5,"PowerCogShocked")
call B67(p5,m5,1,GEG)
call SetUnitState(m5,UNIT_STATE_MANA,YK7(GetUnitState(m5,UNIT_STATE_MANA)-GEG*0.5,0))
else
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\ManaFlare\\ManaFlareBoltImpact.mdl",x,y))
call Y67(x,y,$96)
if OT7(m5,"TimeWalk|Active")==false then
call SetUnitPosition(m5,x+T5F*Cos(GDG*bj_DEGTORAD),y+T5F*Sin(GDG*bj_DEGTORAD))
endif
endif
set t=null
set m5=null
set p5=null
return false
endfunction
function ApplyCogRebound takes unit target, real cogX, real cogY, unit hero, integer level,boolean b returns nothing
    local real dx = GetUnitX(target) - cogX
    local real dy = GetUnitY(target) - cogY
    local real dist = SquareRoot(dx * dx + dy * dy)
    local real angle = Atan2(dy, dx) * bj_RADTODEG
    local real pushDist = 150.0 + 50.0 - dist
    local trigger t
    local integer OB7
	local real d = 40+40*level
	if b then
		set d=d*1.5
	endif
    if pushDist > 0 then
        call SetUnitX(target, GetUnitX(target) + pushDist * Cos(angle * bj_DEGTORAD))
        call SetUnitY(target, GetUnitY(target) + pushDist * Sin(angle * bj_DEGTORAD))
    endif
    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\ManaFlare\\ManaFlareBoltImpact.mdl", target, "chest"))
    call OV7(target, "PowerCogShocked")
    set t = CreateTrigger()
    set OB7 = GetHandleId(t)
    call NT7(OB7, "Target", target)
    call NQ7(OB7, "Angle", angle)
    call NT7(OB7, "Source", hero)
	call NQ7(OB7, "Damage", d)
    call TriggerRegisterTimerEvent(t, 0.04, true)
    call TriggerAddCondition(t, Condition(function G9G))
    set t = null
endfunction
function GFG takes nothing returns nothing
    local unit m5 = GetEnumUnit()
    local real cogX = ON7(GetHandleId(m5), "CogX")
    local real cogY = ON7(GetHandleId(m5), "CogY")
    call ApplyCogRebound(m5, cogX, cogY, IN4, IH4, false)
    set m5 = null
endfunction
function GMG takes nothing returns nothing
    local unit target = GetEnumUnit()
    local integer i
    local unit cog
    local real threshold = 125.0
    if GetUnitState(target, UNIT_STATE_MANA) > 0 and OT7(target, "PowerCogShocked") == false then
        set i = 1
        loop
            exitwhen i > 8
            set cog = O77(tl, "Cog" + I2S(i))
            if cog != null and XH7(cog) == false and OM7(GetHandleId(cog), "PowerCogUsed") != 1 then
                if KF7(GetUnitX(target), GetUnitY(target), GetUnitX(cog), GetUnitY(cog)) <= threshold then
                    call OV7(target, "PowerCogShocked")
                    call NP7(GetHandleId(cog), "PowerCogUsed", 1)
                    call SetUnitVertexColor(cog, 25, 25, 25, 175)
					call NQ7(GetHandleId(target), "CogX", GetUnitX(cog))
                    call NQ7(GetHandleId(target), "CogY", GetUnitY(cog))
                    call GroupAddUnit(aL, target)
                    exitwhen true
                endif
            endif
            set i = i + 1
        endloop
    endif
    set target = null
	set cog = null
endfunction
function GNG takes trigger t,unit WI7,real x,real y,real d,integer V77 returns nothing
local integer OB7=GetHandleId(t)
local real GOG=200
// local rect r1=Rect(x-d,y-d,x+d,y+d)
local rect r2=Rect(x-d-GOG,y-d-GOG,x+d+GOG,y+d+GOG)
// local group g1=WS7()
local group g2=WS7()
local group g3=WS7()
set IN4=WI7
// call GroupEnumUnitsInRect(g1,r1,Condition(function AJ7_gai))
call GroupEnumUnitsInRect(g2,r2,Condition(function AJ7_gai))
// set IQ4=g1
set aL=g3
set IJ4=x
set IK4=y
set IM4=d
set tl=OB7
call ForGroup(g2,function GMG)
set IH4=V77
call ForGroup(g3,function GFG)
// call WR7(g1)
call WR7(g2)
call WR7(g3)
// call RemoveRect(r1)
call RemoveRect(r2)
// set g1=null
set g2=null
set g3=null
// set r1=null
set r2=null
endfunction
function GPG takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local real x=ON7(OB7,"x")
local real y=ON7(OB7,"y")
local player p=O97(OB7,"p")
local boolean GQG=OO7(OB7,"NeedFix")
call NM7(OB7)
call OZ7(t)
if GQG then
call Y57(p,.2,x,y,500)
endif
set t=null
set p=null
return false
endfunction
function GRG takes unit GJG returns nothing
local real x=GetUnitX(GJG)
local real y=GetUnitY(GJG)
local player p=GetOwningPlayer(GJG)
local unit oA=CreateUnit(p,'u00W',x,y,0)
call KillUnit(oA)
set p=null
set oA=null
