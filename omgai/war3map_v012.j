function L2D takes nothing returns nothing
local unit BB7
local integer id=GetUnitTypeId(ZS4)
local integer skill
local integer suijiPitMaliceLevel=0
local player suijiPitMaliceDummyOwner=null
if id=='N10R' or id=='N20R' or id=='N30R' then
set skill='X0RI'
else
