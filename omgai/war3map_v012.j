endfunction
function U6D takes nothing returns boolean
return (WF7(GetFilterUnit())==false and IsHideUnit(GetFilterUnit())==false and IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(D8)) and (AK7(GetFilterUnit())==false or IsUnitVisible(GetFilterUnit(),GetOwningPlayer(D8))) and GetUnitState(GetFilterUnit(),UNIT_STATE_LIFE)>.5 and IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(GetFilterUnit(),'A04R')==0 and GetUnitTypeId(GetFilterUnit())!='n00L')!=null
endfunction
