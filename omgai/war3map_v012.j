function TUD takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit WX7=(LoadUnitHandle(L7,(I97),($E)))
local real x2=(LoadReal(L7,(I97),(66)))
local real y2=(LoadReal(L7,(I97),(67)))
local real a=(LoadReal(L7,(I97),($89)))
local integer WF8=GetTriggerEvalCount(t)
local real x=GetUnitX(WX7)
local real y=GetUnitY(WX7)
local real TP9=(LoadReal(L7,(I97),(23)))
local real TQ9=(LoadReal(L7,(I97),(24)))
local unit BB7=(LoadUnitHandle(L7,(I97),(19)))
local group g=WS7()
local group BQ9=(LoadGroupHandle(L7,(I97),($BB)))
local integer BC7=(LoadInteger(L7,(I97),(7)))
local integer id=(LoadInteger(L7,(I97),(8)))
if KF7(x,y,x2,y2)<=OU then
set x=x2
set y=y2
else
set x=X17(TP9+65*Cos(a*bj_DEGTORAD))
set y=X07(TQ9+65*Sin(a*bj_DEGTORAD))
endif
if (WF8==1 or ModuloInteger(WF8,5)==0) and (id=='ZC45' or id=='ZC46') then
call DestroyEffect(AddSpecialEffectTarget("model\\hero_facelessvoid_n5s_w_source.mdl",WX7,"origin"))
call DestroyEffect(AddSpecialEffect("model\\hero_facelessvoid_n5s_w_target.mdl",x,y))
endif
if id=='ZC47' and ModuloInteger(WF8,2)==0 then
call DestroyEffect(AddSpecialEffect("model\\Hero_FacelessVoid_N1S_W_Mover.mdl",x,y))
endif
if id=='ZC48' and ModuloInteger(WF8,2)==0 then
call DestroyEffect(AddSpecialEffect("model\\Hero_FacelessVoid_N4S_W_walk.mdl",x,y))
endif



if BC7==1 then
set Z74='A29A'
elseif BC7==2 then
set Z74='A299'
elseif BC7==3 then
set Z74='A29B'
elseif BC7==4 then
set Z74='A298'
endif
set IN4=WX7
set Z44=BQ9
call GroupEnumUnitsInRange(g,x,y,325,Condition(function AJ7_gai))
call ForGroup(g,function TTD)
call WR7(g)
call SaveReal(L7,(I97),(23),((x)*1.))
call SaveReal(L7,(I97),(24),((y)*1.))
call SetUnitPosition(WX7,x,y)
if(x==x2 and y==y2)or WF8>40 or IsHideUnit(WX7) then
if id=='ZC47' then
    call DestroyEffect(AddSpecialEffect("model\\Hero_FacelessVoid_N1S_W_Target.mdl",x,y))
elseif id=='ZC48' then
    call DestroyEffect(AddSpecialEffect("model\\hero_facelessvoid_n4s_w_target.mdl",x,y))
endif
call SetUnitX(BB7,x)
call SetUnitY(BB7,y)
call IssueImmediateOrderById(BB7,$D0080)
call WR7(BQ9)
call FlushChildHashtable(L7,(I97))
call OZ7(t)
call SetUnitAnimation(WX7,"stand")
call SetUnitPathing(WX7,true)
call SetUnitInvulnerable(WX7,false)
if GetUnitTypeId(WX7)=='EC45' then
call SetUnitVertexColor(WX7,$FF,$FF,$FF,$FF)
endif
call OX7(WX7,"TimeWalk|Active")
endif
set t=null
set WX7=null
set BB7=null
set g=null
set BQ9=null
return false
endfunction
function TVD takes nothing returns nothing
local unit WX7=GetTriggerUnit()
local location l
local trigger t=CreateTrigger()
local integer I97=GetHandleId(t)
local real x1=GetUnitX(WX7)
local real y1=GetUnitY(WX7)
local real x2
local real y2
local real a
local unit BB7=CreateUnit(GetOwningPlayer(WX7),'e00E',x1,y1,0)
local integer BC7=B287_GetUnitAbilityLevel(WX7,'A0LK')
local integer id=GetUnitTypeId(WX7)
local integer suijiDisplacementCount=B290_GetDisplacementMulticastCount(WX7,'A0LK')
if GetSpellTargetUnit()==null then
set l=GetSpellTargetLoc()
else
set l=GetUnitLoc(GetSpellTargetUnit())
endif
set x2=GetLocationX(l)
set y2=GetLocationY(l)
set x2=x1+(x2-x1)*suijiDisplacementCount
set y2=y1+(y2-y1)*suijiDisplacementCount
set a=J77(x1,y1,x2,y2)
call RemoveLocation(l)
call SetUnitAnimationByIndex(WX7,0)
call SetUnitPathing(WX7,false)
call SetUnitInvulnerable(WX7,true)
if id=='EC45' then
call SetUnitVertexColor(WX7,0,0,0,$FF)
endif
call OV7(WX7,"TimeWalk|Active")
call SaveReal(L7,(I97),(66),((X17(x2))*1.))
call SaveReal(L7,(I97),(67),((X07(y2))*1.))
call SaveReal(L7,(I97),(23),((x1)*1.))
call SaveReal(L7,(I97),(24),((y1)*1.))
call SaveReal(L7,(I97),($89),((a)*1.))
call SaveInteger(L7,(I97),(7),(BC7))
call SaveInteger(L7,(I97),(8),(id))
call SaveUnitHandle(L7,(I97),($E),(WX7))
call SaveUnitHandle(L7,(I97),(19),(BB7))
call SaveGroupHandle(L7,(I97),($BB),(WS7()))
call XF7(BB7,'A0LA')
call SetUnitAbilityLevel(BB7,'A0LA',B287_GetUnitAbilityLevel(WX7,'A0LK'))
call TriggerRegisterTimerEvent(t,.025,true)
call TriggerAddCondition(t,Condition(function TUD))
set WX7=null
set l=null
set t=null
set BB7=null
endfunction
