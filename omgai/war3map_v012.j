local unit BB7=CreateUnit(GetOwningPlayer(ZX7),'e00E',GetUnitX(IH7),GetUnitY(IH7),0)
local integer BC7=GetUnitAbilityLevel(ZX7,'A2A8')
set DA7=true
call UnitAddAbility(BB7,'A2A7')
call SetUnitAbilityLevel(BB7,'A2A7',BC7)
