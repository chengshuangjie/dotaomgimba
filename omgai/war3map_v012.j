call TriggerAddCondition(t,Condition(function UGD))
call SaveInteger(L7,(I97),(30),(TS7(IH7)))
call SaveUnitHandle(L7,(I97),(2),(ZX7))
set IH7=null
set ZX7=null
set t=null
endfunction
