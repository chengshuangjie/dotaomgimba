local string LG7
local integer LH7=StringLength(L97)
local boolean LI7=false
loop
exitwhen i+1>LF7
set LG7=SubString(s,i,i+LH7)
if LG7!=L97 or LI7 then
set LE7=LE7+SubString(s,i,i+1)
set i=i+1
else
set LE7=LE7+LD7
set i=i+LH7
set LI7=true
endif
endloop
return LE7
endfunction
