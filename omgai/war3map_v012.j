function FSTX takes unit IH7 returns nothing
local integer O5=GetPlayerId(GetOwningPlayer(IH7))
local unit ZX7=M7[O5] //不一定是来源英雄
local integer n
call CF_ADD_SPEED(IH7)
if SuijiMode_HasAghanimState(IH7) then
call CHIA_TX(IH7,GetOwningPlayer(IH7))
endif
if GetUnitAbilityLevel(ZX7,'A26A')>0 then
call XF7(IH7,'A26A')
endif
if GetUnitAbilityLevel(ZX7,'A4GA')>0 then
	set n=LoadInteger(L7,(GetHandleId(LoadTriggerHandle(TABLE_HY, GetHandleId(ZX7),'A4GA'))),(100))
	set n=IMaxBJ(55-n,10)
	call Z57(IH7,'A4GA', 1, n*0.1,0)
endif
if CHILLX[O5]==1 then
    call XF7(IH7,'A334')
endif
if CHIYY[O5]==1 then
call XF7(IH7,'A2Q5')
endif
if CHIA[O5]==1 then
call XF7(IH7,'A330')
endif
if OO7(GetHandleId(ZX7),"FSING") then
    call XF7(IH7,'A4KS')
endif
set ZX7=null
endfunction
function OPv takes nothing returns boolean
