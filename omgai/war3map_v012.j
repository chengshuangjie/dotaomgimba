if AK7(GetEnumUnit())==false then
call UnitRemoveAbility(GetEnumUnit(),'B0EY')
call UnitShareVision(GetEnumUnit(),GetOwningPlayer(YG4),true)
else
call UnitShareVision(GetEnumUnit(),GetOwningPlayer(YG4),true)
if GetUnitAbilityLevel(GetEnumUnit(),'B0EY')==0 and GetUnitAbilityLevel(GetEnumUnit(),'B00T')==0 and GetUnitAbilityLevel(GetEnumUnit(),'B0JN')==0 and GetUnitAbilityLevel(GetEnumUnit(),'B00L')==0 then
set BB7=CreateUnit(GetOwningPlayer(YG4),'e00E',GetUnitX(GetEnumUnit()),GetUnitY(GetEnumUnit()),0)
call UnitAddAbility(BB7,'A2AH')
call IssueTargetOrderById(BB7,$D00B5,GetEnumUnit())
call UnitApplyTimedLife(BB7,'BTLF',1.)
set BB7=null
endif
endif
endfunction
function RID takes nothing returns nothing
local real D4D=YH4*0+.3
if XH7(YG4) or IsUnitInGroup(GetEnumUnit(),YF4)==false or GetUnitState(GetEnumUnit(),UNIT_STATE_LIFE)/GetUnitState(GetEnumUnit(),UNIT_STATE_MAX_LIFE)>D4D or(GetUnitState(GetEnumUnit(),UNIT_STATE_LIFE)/GetUnitState(GetEnumUnit(),UNIT_STATE_MAX_LIFE)>D4D/2 and AK7(GetEnumUnit()))then
call GroupRemoveUnit(YE4,GetEnumUnit())
call UnitShareVision(GetEnumUnit(),GetOwningPlayer(YG4),false)
call UnitRemoveAbility(GetEnumUnit(),'B0EY')
endif
endfunction
function RJD takes nothing returns nothing
local real D4D
if XH7(YG4)==false and IsUnitInGroup(GetEnumUnit(),YE4)==false and IsUnitIllusion(GetEnumUnit())==false then
set D4D=YH4*0+.3
if GetUnitState(GetEnumUnit(),UNIT_STATE_LIFE)/GetUnitState(GetEnumUnit(),UNIT_STATE_MAX_LIFE)<D4D and AK7(GetEnumUnit())==false then
call GroupAddUnit(YE4,GetEnumUnit())
elseif GetUnitState(GetEnumUnit(),UNIT_STATE_LIFE)/GetUnitState(GetEnumUnit(),UNIT_STATE_MAX_LIFE)<D4D/2 then
call GroupAddUnit(YE4,GetEnumUnit())
endif
endif
endfunction
function RKD takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local group RMD=(LoadGroupHandle(L7,(I97),(22)))
local group g=WS7()
local integer BC7=0
local integer number
if ZX7==null or GetUnitTypeId(ZX7)==0 or RMD==null or B287_GetUnitAbilityLevel(ZX7,'A0I8')<=0 then
if ZX7!=null and GetUnitTypeId(ZX7)!=0 then
call YLG2(ZX7,0)
call UnitRemoveAbility(ZX7,'A214')
call SaveInteger(TABLE_K, GetHandleId(ZX7),'A214', 0)
endif
if RMD!=null then
call WR7(RMD)
endif
call WR7(g)
call FlushChildHashtable(L7,(I97))
call OZ7(t)
set t=null
set ZX7=null
set g=null
set RMD=null
return false
endif
set BC7=B287_GetUnitAbilityLevel(ZX7,'A0I8')
set IN4=ZX7
set YG4=ZX7
set YE4=RMD
set YH4=BC7
call GroupEnumUnitsInRange(g,GetUnitX(ZX7),GetUnitY(ZX7),25+25000,Condition(function A_7))
call ForGroup(g,function RJD)
set YF4=g
call ForGroup(YE4,function RID)
call ForGroup(YE4,function RHD)
set number=CountUnitsInGroup(YE4)
if FirstOfGroup(YE4)==null then
call YLG2(ZX7,0)
call UnitRemoveAbility(ZX7,'A214')
call SaveInteger(TABLE_K, GetHandleId(ZX7),'A214', 0)
else
call YLG2(ZX7,(10*BC7-5)*number)
call XF7(ZX7,'A214')
call SaveInteger(TABLE_K, GetHandleId(ZX7),'A214', number)
call SaveInteger(TABLE_K, GetHandleId(ZX7),'A215', BC7)
endif
call WR7(g)
set t=null
set ZX7=null
set g=null
set RMD=null
return false
endfunction
function HAI takes nothing returns boolean
	local trigger t = GetTriggeringTrigger()
	local integer h = GetHandleId(t)
	local unit u = LoadUnitHandle(TABLE_HY, h, 0)
	local integer number = 0
	local integer BC7 = 0
	local integer I2X = 0
	if u==null or GetUnitTypeId(u)==0 then
		call FlushChildHashtable(TABLE_HY, h)
		call OZ7(t)
		set t = null
		set u = null
		return false
	endif
	set number = LoadInteger(TABLE_K, GetHandleId(u),'A214')
	set BC7 = LoadInteger(TABLE_K, GetHandleId(u),'A215')
	set I2X =(10* BC7 -5)* number
    if ISPH(u) then
        set I2X=0
    endif
	call SetUnitImitateMoveSpeed(u, I2X, 0)
	set t = null
	set u = null
	return false
endfunction
function RND takes nothing returns nothing
local trigger t=null
local integer I97=0
local unit ZX7=GetTriggerUnit()
if ZX7==null or GetUnitTypeId(ZX7)==0 then
set ZX7=null
return
endif
set t=CreateTrigger()
set I97=GetHandleId(t)
call TriggerRegisterTimerEvent(t,.25,true)
call TriggerAddCondition(t,Condition(function RKD))
call SaveUnitHandle(L7,(I97),(2),(ZX7))
call SaveGroupHandle(L7,(I97),(22),(WS7()))
set t=CreateTrigger()
call TriggerRegisterTimerEvent(t, .1, true)
call TriggerAddCondition(t, Condition(function HAI))
call SaveUnitHandle(TABLE_HY, GetHandleId(t), 0, ZX7)
set t=null
set ZX7=null
endfunction
function ROD takes nothing returns boolean
if B287_GetLearnedSkill()=='A0I8' and IsUnitIllusion(GetTriggerUnit())==false and B287_GetUnitAbilityLevel(GetTriggerUnit(),'A0I8')==1 then
call RND()
endif
return false
endfunction
function HG8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_HERO_SKILL)
call TriggerAddCondition(t,Condition(function ROD))
set D17[0]='A2GK'
set D17[1]='A2GJ'
set D17[2]='A2GI'
set D17[3]='A2GH'
set D17[4]='A2GN'
set D17[5]='A2GO'
set D17[6]='A2GM'
set D17[7]='A2GL'
set D17[8]='A2GP'
set D17[9]='AZ0A'
set D17[10]='AZ0B'
set D17[11]='AZ0C'
set t=null
endfunction
function XUENU_TRI takes nothing returns nothing
	local timer t=GetExpiredTimer()
	local integer I97=GetHandleId(t)
	local unit ZX7=(LoadUnitHandle(L7,(I97),(0)))
	local real max=0.
	local real now=0.
	local real d=0.
	if ZX7==null or GetUnitTypeId(ZX7)==0 then
		call PauseTimer(t)
		call FlushChildHashtable(L7,(I97))
		call DestroyTimer(t)
		set t=null
		set ZX7=null
		return
	endif
	set max=GetUnitState(ZX7,UNIT_STATE_MAX_LIFE)
	set now=GetUnitState(ZX7,UNIT_STATE_LIFE)
	set d=max*0.015*0.1
	if GetGameTime()>LoadReal(L7,I97,10) or UnitAlive(ZX7)==false then
		call RemoveSavedHandle( L7, 'A0EC', GetHandleId(ZX7))
		call PauseTimer(t)
		call FlushChildHashtable(L7,(I97))
		call DestroyTimer(t)
	elseif GetUnitAbilityLevel(ZX7,'B0KX')>0 then
		call SetUnitState(ZX7,UNIT_STATE_LIFE,RMaxBJ(now-d,1))
	endif
	set t=null
	set ZX7=null
endfunction
function XUENU takes nothing returns nothing
	local timer t
	local integer I97
	local unit ZX7=GetTriggerUnit()
	if ZX7==null or GetUnitTypeId(ZX7)==0 then
		set ZX7=null
		return
	endif
	if HaveSavedHandle(L7, 'A0EC', GetHandleId(ZX7)) then
		set t=LoadTimerHandle(L7, 'A0EC', GetHandleId(ZX7))
		set I97=GetHandleId(t)
        call SaveReal(L7, I97, 10, GetGameTime()+8.)
	else
		set t=CreateTimer()
		set I97=GetHandleId(t)
		call SaveUnitHandle(L7,(I97),(0),(ZX7))
		call SaveReal(L7,(I97),(10),(GetGameTime()+8.))
		call TimerStart(t,0.1,true,function XUENU_TRI)
		call SaveTimerHandle(L7, 'A0EC', GetHandleId(ZX7), t)
	endif
	set t=null
	set ZX7=null
endfunction
function ZCXUENU takes nothing returns nothing
    if B287_GetSpellAbilityId()=='A0EC' then
        call XUENU()
    endif
endfunction
function XUENU_EVENT takes nothing returns boolean
	local unit m5=MHEvent_GetUnit()
	local real damage=MHDamagingEvent_GetDamage()
	local integer level=4
	set level=B287_GetUnitAbilityLevel(m5,'A0EC')
	if GetUnitAbilityLevel(m5,'B0KX')>0 and C677(damage) then
		set damage=(1-0.03*level)*damage
		call MHDamagingEvent_SetDamage(damage)
	endif
	set m5=null
	return false
endfunction
function HF8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function ZCXUENU))
set t=CreateTrigger()
call TriggerAddCondition(t, Condition(function XUENU_EVENT))
call MHDamagingEvent_Register(t)
set t=null
endfunction
//
function ISZHIZHU takes integer id returns boolean
	return id=='U006' or id=='n019' or id=='n01E' or id=='ndr2' or id=='ndr3'
endfunction
function HJI takes nothing returns boolean
	return GetOwningPlayer(GetFilterUnit()) == GetOwningPlayer(IN4) and ISZHIZHU(GetUnitTypeId(GetFilterUnit())) and ( GetUnitAbilityLevel(GetFilterUnit(), 'Aloc') == 0 and GetUnitAbilityLevel(GetFilterUnit(), 'A04R') == 0 )
endfunction
function HKII takes nothing returns nothing
 local real x
 local real y
 local unit web
 local integer i= 1
 local unit u= GetEnumUnit()
 local boolean b= false
 local integer TotalWebs
 local unit ZX7=M7[GetPlayerId(GetOwningPlayer(u))]
	if ZX7!= null then
        set TotalWebs=OM7(GetHandleId(ZX7),"TotalWebs")
		loop
			set web=O77(GetHandleId(ZX7),"Web"+I2S(i))
			if web != null then
				set x=GetUnitX(web)
				set y=GetUnitY(web)
				if ( KF7(x , y , GetUnitX(u) , GetUnitY(u)) < 875 ) then
					set b=true
				endif
			else
				set i=TotalWebs
			endif
			set i=i + 1
		exitwhen i > TotalWebs or b
		endloop
	endif
	if b == false then
		if IsUnitType(u, UNIT_TYPE_HERO) then
			call UnitRemoveAbility(u, 'A021')
		else
			call UnitRemoveAbility(u, 'A29C')
		endif
		call UnitRemoveAbility(u, 'B01C')
		call SetUnitPathingEx(u , true)
        call SetUnitImitateMoveSpeed(u, 0, 0)
	endif
	set web=null
	set u=null
    set ZX7=null
endfunction
function HMI takes nothing returns nothing
 local unit u=GetEnumUnit()
 local unit ZX7=M7[GetPlayerId(GetOwningPlayer(u))]
 local integer I2X
	if IsUnitType(u, UNIT_TYPE_HERO) then
		if GetUnitAbilityLevel(u, 'A021') == 0 then
			//call L6X(u)
			call UnitAddAbility(u, 'A021')
		endif
	else
		if GetUnitAbilityLevel(u, 'A29C') == 0 then
			call UnitAddAbility(u, 'A29C')
		endif
	endif
	call SetUnitPathingEx(u , LoadReal(L7, GetHandleId(u), 785) + 3 > (TimerGetElapsed(W)))
    if SuijiMode_HasAghanimState(ZX7) then
        set I2X=B287_GetUnitAbilityLevel(ZX7,'A0BG')*10+30
        call SetUnitImitateMoveSpeed(u, I2X, 0)
    endif
	set u=null
    set ZX7=null
endfunction
function HPI takes nothing returns nothing
 local trigger t= GetTriggeringTrigger()
 local integer h= GetHandleId(t)
 local group g
 local group g2= null
 local unit u
	if GetTriggerEventId() == EVENT_UNIT_DEATH then
		call WR7(LoadGroupHandle(TABLE_HY, h, 1))
		call FlushChildHashtable(TABLE_HY, h)
		call OZ7(t)
	else
		if LoadBoolean(TABLE_HY, h, 0) == false then
			set g=WS7()
			call SaveBoolean(TABLE_HY, h, 0, true)
			call SaveGroupHandle(TABLE_HY, h, 1, g)
		endif
		set u=LoadUnitHandle(TABLE_HY, h, 0)
		set g=LoadGroupHandle(TABLE_HY, h, 1)
		set g2=WS7()
		set IN4=u
		call GroupEnumUnitsInRange(g2, GetUnitX(u), GetUnitY(u), 900, Condition(function HJI))
		call GroupRemoveGroup(g2, g)
		set IN4=u
		call ForGroup(g, function HKII)
		call ForGroup(g2, function HMI)
		call GroupClear(g)
		call GroupAddGroup(g2, g)
		call WR7(g2)
		set g2=null
	endif
	set t=null
	set g=null
	set u=null
endfunction
function HQI takes nothing returns nothing
 local trigger t= CreateTrigger()
 local integer h= GetHandleId(t)
	call TriggerRegisterTimerEvent(t, .3, true)
	call TriggerRegisterUnitEvent(t, GetTriggerUnit(), EVENT_UNIT_DEATH)
	call TriggerAddCondition(t, Condition(function HPI))
	call SaveUnitHandle(TABLE_HY, h, 0, GetTriggerUnit())
	call SaveBoolean(TABLE_HY, h, 0, false)
	set t=null
endfunction
function HSI takes nothing returns nothing
	if GetUnitTypeId(GetTriggerUnit()) == 'o003' then
		call HQI()
	endif
endfunction
//蜘蛛网无视地形
function M6X takes nothing returns nothing
 local trigger t= CreateTrigger()
	call YDWETriggerRegisterEnterRectSimpleNull(t , GetWorldBounds())
	call TriggerAddCondition(t, Condition(function HSI))
	set t=null
endfunction
//蜘蛛网
function RQD takes nothing returns boolean
return B287_GetSpellAbilityId()=='A0BG'
endfunction
function RRD takes nothing returns nothing
local unit xv=GetTriggerUnit()
local unit xU=null
local integer OB7=0
local integer V77=0
local integer xV=0
local unit xw=null
local integer x=1
local integer number=0
if xv==null or GetUnitTypeId(xv)==0 then
set xv=null
return
endif
set xU=CreateUnit(GetOwningPlayer(xv), 'o003', GetSpellTargetX(), GetSpellTargetY(), 0)
set OB7=GetHandleId(xv)
set V77=B287_GetUnitAbilityLevel(xv,'A0BG')
set xV=OM7(OB7,"TotalWebs")
set xw=O77(OB7,"Web1")
set number=V77*2
if SuijiMode_HasAghanimState(xv) then
set number=number+8
endif
call SetUnitAnimation(xU, "birth")
call QueueUnitAnimation(xU, "stand")
set xV=xV+1
call SetUnitVertexColorBJ(xU,100,100,100,80)
call XF7(xU,'Aloc')
call NT7(OB7,"Web"+I2S(xV),xU)
if(xV>number)then
call KillUnit(xw)
loop
exitwhen x==xV
call NT7(OB7,"Web"+I2S(x),O77(OB7,"Web"+I2S(x+1)))
set x=x+1
endloop
set xV=xV-1
endif
call NP7(OB7,"TotalWebs",xV)
call SetUnitAbilityLevel(xU,'A0BF',V77)
set xU=null
set xv=null
set xw=null
endfunction
function HH8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function RQD))
call TriggerAddAction(t,function RRD)
set t=null
endfunction
function RSD takes unit xv returns nothing
local integer OB7=0
local integer V77=0
local integer xV=0
local integer x=1
local unit VX
if xv==null or GetUnitTypeId(xv)==0 then
set VX=null
return
endif
set OB7=GetHandleId(xv)
set V77=B287_GetUnitAbilityLevel(xv,'A0BG')
set xV=OM7(OB7,"TotalWebs")
loop
exitwhen x>xV
set VX=O77(OB7,"Web"+I2S(x))
if VX!=null and GetUnitTypeId(VX)!=0 then
call SetUnitAbilityLevel(VX,'A0BF',V77)
endif
set x=x+1
endloop
set VX=null
endfunction
function RTD takes nothing returns nothing
local unit RUD=O77(GetHandleId(GetTriggeringTrigger()),"Spider")
if RUD==null or GetUnitTypeId(RUD)==0 then
call FlushChildHashtable(L7,(GetHandleId(GetTriggeringTrigger())))
call OZ7(GetTriggeringTrigger())
else
if IsUnitType(RUD,UNIT_TYPE_HERO) then
if GetUnitAbilityLevel(RUD,'B01C')>0 then
call XF7(RUD,'A021')
else
call UnitRemoveAbility(RUD,'A021')
endif
else
if GetUnitAbilityLevel(RUD,'B01C')>0 then
call XF7(RUD,'A29C')
else
call UnitRemoveAbility(RUD,'A29C')
endif
endif
endif
set RUD=null
endfunction
function RVD takes unit ZX7 returns nothing
local integer OB7=0
local trigger t=null
if ZX7==null or GetUnitTypeId(ZX7)==0 then
return
endif
set OB7=GetHandleId(ZX7)
set t=LoadTriggerHandle(L7,OB7,StringHash("SpiderWebPeriodicTrigger"))
if t!=null and OZ7_IsQueued(t)==false then
set t=null
return
endif
set t=CreateTrigger()
call TriggerRegisterTimerEventPeriodic(t,1.5)
call TriggerAddAction(t,function RTD)
call NT7(GetHandleId(t),"Spider",ZX7)
call SaveTriggerHandle(L7,OB7,StringHash("SpiderWebPeriodicTrigger"),t)
set t=null
endfunction
function RWD takes nothing returns boolean
if GetUnitTypeId(GetSummonedUnit())=='n01E' or GetUnitTypeId(GetSummonedUnit())=='n019' then
call RVD(GetSummonedUnit())
endif
return false
endfunction
function RXD takes unit WI7,boolean UA9 returns nothing
local trigger t
if B287_GetUnitAbilityLevel(WI7,'A0BG')==1 or UA9 then
call RVD(WI7)
else
call RSD(WI7)
endif
if UA9 then
set t=LoadTriggerHandle(L7,GetHandleId(WI7),StringHash("SpiderWebPeriodicTrigger"))
set aj[GetPlayerId(GetOwningPlayer(WI7))]=t
endif
set t=null
endfunction
function SuijiMode_ClearSpiderWebState takes unit ZX7 returns nothing
local integer OB7=0
local integer total=0
local integer x=1
local unit Web=null
local trigger periodic=null
if ZX7==null then
return
endif
set OB7=GetHandleId(ZX7)
set total=OM7(OB7,"TotalWebs")
loop
exitwhen x>total
set Web=O77(OB7,"Web"+I2S(x))
if Web!=null then
call RemoveUnit(Web)
endif
call RemoveSavedHandle(L7,OB7,StringHash("Web"+I2S(x)))
set x=x+1
endloop
call NP7(OB7,"TotalWebs",0)
set periodic=LoadTriggerHandle(L7,OB7,StringHash("SpiderWebPeriodicTrigger"))
if periodic!=null then
if aj[GetPlayerId(GetOwningPlayer(ZX7))]==periodic then
set aj[GetPlayerId(GetOwningPlayer(ZX7))]=null
endif
call FlushChildHashtable(L7,GetHandleId(periodic))
call OZ7(periodic)
call RemoveSavedHandle(L7,OB7,StringHash("SpiderWebPeriodicTrigger"))
endif
set Web=null
set periodic=null
endfunction
function XXZZW2 takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
if ZX7==null or GetUnitTypeId(ZX7)==0 then
call FlushChildHashtable(L7,(I97))
call OZ7(t)
set t=null
set ZX7=null
return false
endif
call SuijiMode_ClearSpiderWebState(ZX7)
call FlushChildHashtable(L7,(I97))
call OZ7(t)
set t=null
set ZX7=null
return false
endfunction
