function KWG takes unit ZX7,integer I97,integer WF8 returns nothing
local group g1=WS7()
local group g2=WS7()
local integer i=0
set IN4=ZX7
loop
exitwhen i>WF8
call GroupEnumUnitsInRange(g2,ON7(I97,"X"+I2S(i)),ON7(I97,"Y"+I2S(i)),$E1,Condition(function AJ7_gai))
call GroupAddGroup(g2,g1)
call GroupClear(g2)
set i=i+1
endloop
