function FYD_TS takes nothing returns nothing
	local unit ZX7 = U22
	local unit IH7 = W22
    local unit u
	local integer h
	local integer level
    local integer times
    local group g
    local group g2
    local boolexpr spiritLanceBounceFilter=null
    local unit BB7
	if LoadUnitHandle(TABLE_P, GetHandleId(ZX7),'A10D'+ 1)!= null then
		set ZX7 = LoadUnitHandle(TABLE_P, GetHandleId(ZX7),'A10D'+ 1)
		call RemoveSavedHandle(TABLE_P, GetHandleId(ZX7),'A10D'+ 1)
	endif
    set h = GetHandleId(ZX7)
    set g = LoadGroupHandle(TABLE_P, h, 'A10D')
    set level = LoadInteger(TABLE_P, h, 10)
    set times = LoadInteger(TABLE_P, h, 20)
    call GroupAddUnit(g, IH7)
set BB7=CreateUnit(GetOwningPlayer(IH7),'e00E',GetUnitX(IH7),GetUnitY(IH7),0)
call XF7(BB7,'A10C')
call SetUnitAbilityLevel(BB7,'A10C',level)
    call IssueTargetOrderById(BB7,$D00DD,IH7)
    call CommonUnitAddStun(IH7,1.,false)
    call B67(ZX7,IH7,1,25+75*level)
    call FTD(GetOwningPlayer(ZX7),IH7,level)
    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\IllidanMissile\\IllidanMissile.mdl",IH7,"origin"))
    if times==3 then
        call LINGXIA(ZX7,IH7)
    endif



    if times>0 then
        set g2 = WS7()
        set U22=ZX7
        set spiritLanceBounceFilter=Condition(function DKX)
        call GroupEnumUnitsInRange(g2, GetUnitX(IH7), GetUnitY(IH7), 400, spiritLanceBounceFilter)
        call DestroyBoolExpr(spiritLanceBounceFilter)
        call GroupRemoveGroup(g, g2)
        set u=GroupPickRandomUnit(g2)
        if u!= null and WQ7(u)==false then
            call NHX_TANSHE(ZX7,IH7, u,'h06L', "FYD_TS", 1000, true, "")
            call SaveUnitHandle(TABLE_P, GetHandleId(IH7),'A10D'+ 1, ZX7)
            call SaveInteger(TABLE_P, h,20, times -1)
        else
            call WR7(g)
            call RemoveSavedHandle(TABLE_P, h,'A10D')
            call RemoveSavedInteger(TABLE_P, h,10)
            call RemoveSavedInteger(TABLE_P, h,20)
        endif
        call WR7(g2)
        set g2 = null
    else
        call WR7(g)
        call RemoveSavedHandle(TABLE_P, h,'A10D')
        call RemoveSavedInteger(TABLE_P, h,10)
        call RemoveSavedInteger(TABLE_P, h,20)
    endif



    set g=null
    set BB7=null
    set spiritLanceBounceFilter=null
	set ZX7 = null
	set IH7 = null
endfunction
function FYD takes nothing returns nothing
	local unit ZX7 = U22
	local unit IH7 = W22
	local integer h = GetHandleId(GetTriggeringTrigger())
	local integer level = LoadInteger(TABLE_HY, h, 10)
local unit BB7=CreateUnit(GetOwningPlayer(IH7),'e00E',GetUnitX(IH7),GetUnitY(IH7),0)
call XF7(BB7,'A10C')
call SetUnitAbilityLevel(BB7,'A10C',level)
    call IssueTargetOrderById(BB7,$D00DD,IH7)
    call CommonUnitAddStun(IH7,1.,false)
    call B67(ZX7,IH7,1,25+75*level)
    call FTD(GetOwningPlayer(ZX7),IH7,level)
    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\IllidanMissile\\IllidanMissile.mdl",IH7,"origin"))
    call LINGXIA(ZX7,IH7)
    set BB7=null
	set ZX7 = null
	set IH7 = null
endfunction
function FZD takes unit ZX7,unit IH7,integer BC7 returns nothing
	local trigger t
    if IsUnitIllusion(ZX7) then
        call NHX(ZX7, IH7,'h06L', "",1000, true,"")
    else
        if PhantomLancerSpiritLance_HasScepter(ZX7) then
            set t=NHX(ZX7, IH7,'h06L', "FYD_TS",1000, true,"")
            call SaveInteger(TABLE_P, GetHandleId(ZX7), 10, BC7)
            call SaveInteger(TABLE_P, GetHandleId(ZX7),20, 3)
            if LoadGroupHandle(TABLE_P, GetHandleId(ZX7),'A10D')!=null then
                call WR7(LoadGroupHandle(TABLE_P, GetHandleId(ZX7),'A10D'))
            endif
            call SaveGroupHandle(TABLE_P, GetHandleId(ZX7),'A10D', WS7())
        else
            set t=NHX(ZX7, IH7,'h06L', "FYD",1000, true,"")
            call SaveInteger(TABLE_HY, GetHandleId(t), 10, BC7)
        endif
    endif
	set t = null
	set ZX7 = null
	set IH7 = null
endfunction
function FAD takes nothing returns boolean
if IsUnitIllusion(GetFilterUnit()) and GetUnitTypeId(GetFilterUnit())=='Ogrh' and GetOwningPlayer(GetFilterUnit())==GetOwningPlayer(GetTriggerUnit()) then
call FZD(GetFilterUnit(),GetSpellTargetUnit(),B287_GetUnitAbilityLevel(GetTriggerUnit(),'A10D'))
endif
return false
endfunction
function FBD takes nothing returns nothing
local unit WI7=GetTriggerUnit()
local unit IH7=GetSpellTargetUnit()
local group g=WS7()
local boolexpr spiritLanceIllusionCastFilter=Condition(function FAD)
call GroupEnumUnitsInRange(g,GetUnitX(WI7),GetUnitY(WI7),750,spiritLanceIllusionCastFilter)
call DestroyBoolExpr(spiritLanceIllusionCastFilter)
call WR7(g)
set WI7=null
set IH7=null
set g=null
set spiritLanceIllusionCastFilter=null
endfunction
function F3D takes nothing returns boolean
if IsUnitIllusion(GetFilterUnit()) and GetUnitTypeId(GetFilterUnit())=='Ogrh' and GetOwningPlayer(GetFilterUnit())==GetOwningPlayer(GetTriggerUnit()) then
call SetUnitFacing(GetFilterUnit(),IJ4)
call SetUnitAnimation(GetFilterUnit(),"spell")
endif
return false
endfunction
function F6D takes nothing returns nothing
local unit WI7=GetTriggerUnit()
local group g=WS7()
local boolexpr spiritLanceIllusionFaceFilter=Condition(function F3D)
set IJ4=J77(GetUnitX(WI7),GetUnitY(WI7),GetUnitX(GetSpellTargetUnit()),GetUnitY(GetSpellTargetUnit()))
call GroupEnumUnitsInRange(g,GetUnitX(WI7),GetUnitY(WI7),750,spiritLanceIllusionFaceFilter)
call DestroyBoolExpr(spiritLanceIllusionFaceFilter)
call WR7(g)
set WI7=null
set g=null
set spiritLanceIllusionFaceFilter=null
endfunction
function FLD takes nothing returns boolean
if B287_GetSpellAbilityId()=='A10D' then
if GetTriggerEventId()==EVENT_PLAYER_UNIT_SPELL_EFFECT then
    if WQ7(GetSpellTargetUnit())==false then
call FZD(GetTriggerUnit(),GetSpellTargetUnit(),B287_GetUnitAbilityLevel(GetTriggerUnit(),'A10D'))
        call FBD()
    endif
else
call F6D()
endif
endif
return false
endfunction
function FC8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function FLD))
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_CAST)
call TriggerAddCondition(t,Condition(function FLD))
call X_7('A10C')
call X_7('A10H')
call X_7('A10G')
call X_7('A10I')
call X_7('A10F')
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SUMMON)
call TriggerAddCondition(t,Condition(function FRD))
set t=null
endfunction
function F1D takes nothing returns nothing
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local unit oA=CreateUnit(GetOwningPlayer(u),'e00E',GetUnitX(u),GetUnitY(u),0)
local integer skill
if GetPlayerController(p)==MAP_CONTROL_USER then
    set skill='A4G3'
else
    set skill='A0DC'
endif
call XF7(oA,skill)
call IssueTargetOrderById(oA,$D0132,u)
set u=null
set p=null
set oA=null
endfunction
function F0D takes nothing returns boolean
if B287_GetSpellAbilityId()=='A0D7' then
call F1D()
endif
return false
endfunction
function F38 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function F0D))
set t=null
endfunction
function FKSZ_Damage2 takes nothing returns boolean
    local trigger t=GetTriggeringTrigger()
    local integer OB7=GetHandleId(t)
    local unit ZX7=LoadUnitHandle(ExtraHT, OB7, 0)
    local unit IH7=LoadUnitHandle(ExtraHT, OB7, 1)
    local real n=LoadReal(ExtraHT, OB7, 0)
    local real DUR=LoadReal(ExtraHT, OB7, 1)
    local real YM7=LoadReal(ExtraHT, OB7, 10)
    if n>=DUR*10 or (n>1 and GetUnitAbilityLevel(IH7,'B0ER')==0) or GetTriggerEventId()==EVENT_UNIT_DEATH then
        call RemoveSavedHandle( ExtraHT, 'fksz', GetHandleId(IH7))
        call FlushChildHashtable(ExtraHT, OB7)
        call OZ7(t)
        set t=null
        set IH7=null
        return false
    elseif ModuloReal(n,10.)==0 then
        call B67(ZX7,IH7,1,YM7)
    endif
    call SaveReal(ExtraHT, OB7, 0, n+1)
    set t=null
    set ZX7=null
    set IH7=null
    return false
endfunction
function FKSZ_Damage takes unit ZX7,unit IH7,integer level returns nothing
    local trigger t
    local integer OB7
    local real DUR=2.+level
    local real YM7=100.
    if HaveSavedHandle(ExtraHT, 'fksz', GetHandleId(IH7)) then
	    set t=LoadTriggerHandle(ExtraHT, 'fksz', GetHandleId(IH7))
		set OB7=GetHandleId(t)
        call SaveReal(ExtraHT, OB7, 0, 0)
    else
        set t=CreateTrigger()
        set OB7=GetHandleId(t)
        call SaveUnitHandle(ExtraHT, OB7, 0, ZX7)
        call SaveUnitHandle(ExtraHT, OB7, 1, IH7)
        call SaveReal(ExtraHT, OB7, 0, 0)
        call SaveReal(ExtraHT, OB7, 1, DUR)
        call SaveReal(ExtraHT, OB7, 10, YM7)
        call SaveTriggerHandle(ExtraHT, 'fksz', GetHandleId(IH7), t)
        call TriggerRegisterTimerEvent(t,.1,true)
        call TriggerRegisterUnitEvent(t,IH7,EVENT_UNIT_DEATH)
        call TriggerAddCondition(t,Condition(function FKSZ_Damage2))
    endif
    set t=null
endfunction
function FKSZ_PD takes nothing returns boolean
if (IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==false and IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(IN4)) and GetUnitAbilityLevel(GetFilterUnit(),'A04R')==0 and IsHideUnit(GetFilterUnit())==false and IsUnitVisible(GetFilterUnit(),GetOwningPlayer(IN4)) and UnitAlive(GetFilterUnit()))!=null then
	call GroupAddUnit(FKSZGROUP,GetFilterUnit())
endif
return false
endfunction
function CLZY_PD takes nothing returns boolean
return UnitAlive(GetFilterUnit()) and GetUnitTypeId(GetFilterUnit())=='h0BT'
endfunction
function CLZY_ADD_UNIT takes nothing returns boolean
	local unit u=GetEnumUnit()
	local group g=WS7()
	set IN4=u
	call GroupEnumUnitsInRange(g,GetUnitX(u),GetUnitY(u),800,Condition(function FKSZ_PD))
	call WR7(g)
	set u=null
	set g=null
return false
endfunction
function FKSZ_TRI takes nothing returns boolean
	local unit u=GetEnumUnit()
local unit oA=CreateUnit(GetOwningPlayer(IN4),'e022',GetUnitX(u),GetUnitY(u),0)
call XF7(oA,'A06T')
call SetUnitAbilityLevel(oA,'A06T',AL4)
	call IssueTargetOrderById(oA,$D008A,u)	
	call FKSZ_Damage(IN4,u,AL4)
	if HaveDashuA then
		call DisarmUnitToTimed(u , 'A4LR' , 0 , 0 , 2+AL4)
	endif
	set u=null
	set oA=null
return false
endfunction
function F2D takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local group g=WS7()
local group g2=WS7()
local integer level=B287_GetUnitAbilityLevel(ZX7,'A07Z')
set HaveDashuA=false
if SuijiMode_HasAghanimState(ZX7) then
	set HaveDashuA=true
endif
set FKSZGROUP=g2
set IN4=ZX7
call GroupEnumUnitsInRange(g,GetUnitX(ZX7),GetUnitY(ZX7),800,Condition(function FKSZ_PD))
call GroupClear(g)
call GroupEnumUnitsOfPlayer(g,GetOwningPlayer(ZX7),Condition(function CLZY_PD))
if CountUnitsInGroup(g)>0 then
	set FKSZGROUP=g2
	call ForGroup(g,function CLZY_ADD_UNIT)
endif
set IN4=ZX7
set AL4=level
call ForGroup(g2,function FKSZ_TRI)
call WR7(g)
call WR7(g2)
set ZX7=null
set g=null
set g2=null
endfunction
function F5D takes nothing returns boolean
if B287_GetSpellAbilityId()=='A07Z' then
	call F2D()
endif
return false
endfunction
function F68 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function F5D))
set t=null
endfunction
function F_D takes unit p5,integer V77 returns nothing
local unit BB7=CreateUnit(GetOwningPlayer(p5),'e00E',GetUnitX(p5),GetUnitY(p5),0)
call XF7(BB7,'A1GB')
call SetUnitAbilityLevel(BB7,'A1GB',V77)
call IssueTargetOrderById(BB7,$D0065,p5)
call XF7(p5,'A23O')
call SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A23O',false)
set BB7=null
endfunction
function G4D takes nothing returns boolean
return GetUnitTypeId(GetFilterUnit())=='h0BT'
endfunction
function G7D takes unit G8D returns boolean
local group g=WS7()
local boolean G9D=false
call GroupEnumUnitsInRange(g,GetUnitX(G8D),GetUnitY(G8D),375,Condition(function G4D))
if FirstOfGroup(g)!=null then
set G9D=true
endif
call WR7(g)
set g=null
return G9D
endfunction
function GDD takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local integer B07=OM7(OB7,"TargetIndex")
local unit T37=TQ7(B07)
local integer SV9=OM7(OB7,"Count")
local integer V77=OM7(OB7,"Level")
local real ZV8=(LoadReal(L7,(OB7),(442)))
if GetTriggerEventId()!=EVENT_PLAYER_UNIT_ATTACKED and GetTriggerEventId()!=EVENT_PLAYER_UNIT_SPELL_EFFECT then
set SV9=SV9+1
call NP7(OB7,"Count",SV9)
elseif GetTriggerEventId()==EVENT_PLAYER_UNIT_SPELL_EFFECT and B287_GetSpellAbilityId()=='A01Z' and GetTriggerUnit()==T37 then
call SaveReal(L7,(OB7),(442),(((TimerGetElapsed(W))+1.)*1.))
call DisableTrigger(GetTriggeringTrigger())
call F_D(T37,V77)
call EnableTrigger(GetTriggeringTrigger())
call NP7(OB7,"Count",0)
endif
if nA(GetUnitX(T37),GetUnitY(T37),375)==false and G7D(T37)==false then
if ZV8<(TimerGetElapsed(W))or GetTriggerEvalCount(t)==1 then
call UnitRemoveAbility(T37,'B021')
call UnitRemoveAbility(T37,'A1GA')
call UnitRemoveAbility(T37,'A23O')
call UnitRemoveAbility(T37,'B0E9')
call NM7(OB7)
call OZ7(t)
endif
elseif(OO7(OB7,"NaturesGuise|Special")and SV9>($96*V77))then
call UnitRemoveAbility(T37,'B021')
call UnitRemoveAbility(T37,'A1GA')
call UnitRemoveAbility(T37,'A23O')
call UnitRemoveAbility(T37,'B0E9')
call NM7(OB7)
call OZ7(t)
elseif OO7(OB7,"NaturesGuise|Special") and GetUnitAbilityLevel(T37,'B021')==0 and GetUnitAbilityLevel(T37,'A1GA')>0 then
call SaveReal(L7,(OB7),(442),(((TimerGetElapsed(W))+1.)*1.))
call DisableTrigger(GetTriggeringTrigger())
call F_D(T37,V77)
call EnableTrigger(GetTriggeringTrigger())
elseif GetUnitAbilityLevel(T37,'B021')==0 then
call UnitRemoveAbility(T37,'B021')
call UnitRemoveAbility(T37,'A1GA')
call UnitRemoveAbility(T37,'A23O')
call UnitRemoveAbility(T37,'B0E9')
call NM7(OB7)
call OZ7(t)
else
call SaveReal(L7,(OB7),(442),(((TimerGetElapsed(W))+1.)*1.))
endif
set t=null
set T37=null
return false
endfunction
function GED takes nothing returns nothing
local unit T37=GetAttacker()
local integer T_7=GetHandleId(T37)
local trigger t=OE7(T_7,"Nature|Trg")
local integer VZ7=GetHandleId(t)
if OO7(VZ7,"NaturesGuise|Special")and GetAttacker()==T37 then
call UnitRemoveAbility(T37,'B021')
call UnitRemoveAbility(T37,'A1GA')
call NM7(VZ7)
call OZ7(t)
endif
set T37=null
set t=null
endfunction
function GFD takes nothing returns boolean
if GetUnitAbilityLevel(GetAttacker(),'B021')>0 or GetUnitAbilityLevel(GetAttacker(),'A1GA')>0 then
call GED()
endif
return false
endfunction
function GGD takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
if GetTriggerEventId()!=EVENT_WIDGET_DEATH then
if GetUnitAbilityLevel(ZX7,'B021')>0 then
call XF7(ZX7,'A1GA')
endif
endif
call FlushChildHashtable(L7,(I97))
call OZ7(t)
set t=null
set ZX7=null
return false
endfunction
function GHD takes nothing returns nothing
local trigger t
local integer OB7
set t=CreateTrigger()
set OB7=GetHandleId(t)
call NP7(OB7,"TargetIndex",TS7(GetSpellTargetUnit()))
call NP7(OB7,"Level",B287_GetUnitAbilityLevel(GetTriggerUnit(),'A01Z'))
call NP7(OB7,"Count",0)
call SaveReal(L7,(OB7),(442),(((TimerGetElapsed(W))+1.)*1.))
call TriggerAddCondition(t,Condition(function GDD))
call TriggerRegisterTimerEvent(t,.1,true)
call XF7(GetSpellTargetUnit(),'A23O')
call SetPlayerAbilityAvailable(GetOwningPlayer(GetSpellTargetUnit()),'A23O',false)
if GetTriggerUnit()==GetSpellTargetUnit()then
call NS7(OB7,"NaturesGuise|Special",true)
call NV7(GetHandleId(GetSpellTargetUnit()),"Nature|Trg",t)
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
set t=CreateTrigger()
call SaveUnitHandle(L7,(GetHandleId(t)),(2),(GetTriggerUnit()))
call TriggerAddCondition(t,Condition(function GGD))
call TriggerRegisterTimerEvent(t,2,false)
call TriggerRegisterDeathEvent(t,GetTriggerUnit())
endif
set t=null
endfunction
function GID takes nothing returns boolean
if B287_GetSpellAbilityId()=='A01Z' then
call GHD()
endif
return false
endfunction
function FL8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function GID))
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_ATTACKED)
call TriggerAddCondition(t,Condition(function GFD))
set t=null
endfunction
function GND takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit BB7=(LoadUnitHandle(L7,(I97),(19)))
local destructable IH7=(LoadDestructableHandle(L7,(I97),(20)))
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local integer WF8=LoadInteger(L7,I97,34)
local real DUR=LoadReal(L7,I97,1)
set WF8=WF8+1
call SaveInteger(L7,(I97),(34),(WF8))
if WF8>DUR or GetDestructableLife(IH7)<=0 or UnitAlive(BB7)==false then
call KillUnit(BB7)
call FlushChildHashtable(L7,(I97))
call OZ7(t)
endif
set t=null
set ZX7=null
set IH7=null
set BB7=null
return false
endfunction
function GOD takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local real x=GetSpellTargetX()
local real y=GetSpellTargetY()
local destructable IH7=GetDestructableInRange(x,y,125)
local unit BB7
local trigger t=CreateTrigger()
local integer I97=GetHandleId(t)
local real DUR=600
if GetOwningPlayer(ZX7)==GetLocalPlayer() then
call AddIndicator(IH7,255,255,0,255)
endif
set x=GetDestructableX(IH7)
set y=GetDestructableY(IH7)
set BB7=CreateUnit(GetOwningPlayer(ZX7),'h0BT',x,y,GetRandomReal(0,360))
call UnitApplyTimedLife(BB7,'BTLF',DUR)
if IsUnitAlly(ZX7, GetLocalPlayer()) then
	call MHUnit_EnableViewSkill(BB7 , GetLocalPlayer())
endif
// call SaveUnitHandle(TABLE_HY,GetHandleId(ZX7),'bird',GetHandleId(BB7))
call TriggerRegisterTimerEvent(t,.1,true)
call TriggerAddCondition(t,Condition(function GND))
