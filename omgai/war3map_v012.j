function ChenHandBuffCleanup takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit u=LoadUnitHandle(L7,I97,2)
local real expire=LoadReal(L7,I97,1)
if u!=null and LoadReal(L7,GetHandleId(u),StringHash("ChenHandBuff"))<=expire then
call RemoveSavedReal(L7,GetHandleId(u),StringHash("ChenHandBuff"))
endif
call FlushChildHashtable(L7,I97)
call OZ7(t)
set u=null
set t=null
return false
endfunction
function ChenApplyHandBuff takes unit u returns nothing
local trigger t
local integer I97
local real expire
if ChenIsPersuadedUnit(u) then
set t=CreateTrigger()
set I97=GetHandleId(t)
set expire=GetGameTime()+8.
call SaveReal(L7,GetHandleId(u),StringHash("ChenHandBuff"),expire)
call SaveReal(L7,I97,1,expire)
call SaveUnitHandle(L7,I97,2,u)
call TriggerRegisterTimerEvent(t,8.,false)
call TriggerAddCondition(t,Condition(function ChenHandBuffCleanup))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\InnerFire\\InnerFireTarget.mdl",u,"chest"))
endif
set t=null
endfunction
function ChenPersuadedOnDamage takes nothing returns boolean
local unit u=MHEvent_GetUnit()
local real expire=LoadReal(L7,GetHandleId(u),StringHash("ChenHandBuff"))
local real d=MHDamagingEvent_GetDamage()
if expire>GetGameTime() and d>0. and ChenIsPersuadedUnit(u) then
call MHDamagingEvent_SetDamage(d*.85)
elseif expire>0. then
call RemoveSavedReal(L7,GetHandleId(u),StringHash("ChenHandBuff"))
endif
set u=null
return false
endfunction
function ChenHandMulticastExtra takes unit WI7,integer extraCount returns nothing
local integer sr=0
local group LQ7=null
local unit PZ=null
if WI7==null or GetUnitTypeId(WI7)==0 or UnitAlive(WI7)==false or extraCount<=0 then
set WI7=null
return
endif
set sr=SuijiMode_GetPairCastLevel(WI7,'A0LT','A0LT','A1CS')
set LQ7=HW7(bj_mapInitialPlayableArea,Condition(function sq))
loop
set PZ=FirstOfGroup(LQ7)
exitwhen PZ==null
if IsUnitAlly(PZ,GetOwningPlayer(WI7)) then
call SetWidgetLife(PZ,GetUnitStateSwap(UNIT_STATE_LIFE,PZ)+(100+150*sr)*extraCount)
endif
call GroupRemoveUnit(LQ7,PZ)
endloop
call DestroyGroup(LQ7)
set WI7=null
set LQ7=null
set PZ=null
endfunction
function WJ9 takes nothing returns nothing
local unit WI7=GetTriggerUnit()
local integer handSkill=B287_GetSpellAbilityId()
local integer handHandle=GetHandleId(WI7)
local integer sr=SuijiMode_GetPairCastLevel(WI7,handSkill,'A0LT','A1CS')
local group LQ7=HW7(bj_mapInitialPlayableArea,Condition(function sq))
local unit PZ
if SUIJI_MODE then
if ON7(handHandle,"SuijiChenHandBlockUntil")>TimerGetElapsed(W) then
call DestroyGroup(LQ7)
set WI7=null
set LQ7=null
set PZ=null
return
endif
call NQ7(handHandle,"SuijiChenHandBlockUntil",TimerGetElapsed(W)+.20)
set TMPU3=WI7
set SUIJI_CHEN_HAND_CAST_SKILL=handSkill
call ExecuteFunc("SuijiMode_StartChenHandCooldownSync")
endif
loop
set PZ=FirstOfGroup(LQ7)
exitwhen PZ==null
if(IsUnitAlly(PZ,GetOwningPlayer(WI7)))then
call SetWidgetLife(PZ,GetUnitStateSwap(UNIT_STATE_LIFE,PZ)+100+150*sr)
call DestroyEffect(AddSpecialEffectTargetUnitBJ("chest",PZ,"Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl"))
endif
call GroupRemoveUnit(LQ7,PZ)
endloop
call DestroyGroup(LQ7)
set LQ7=HX7(bj_mapInitialPlayableArea,GetOwningPlayer(WI7))
loop
set PZ=FirstOfGroup(LQ7)
exitwhen PZ==null
if ChenIsPersuadedUnit(PZ) then
call SetUnitLifePercentBJ(PZ,100)
call ChenApplyHandBuff(PZ)
call DestroyEffect(AddSpecialEffectTargetUnitBJ("chest",PZ,"Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl"))
endif
call GroupRemoveUnit(LQ7,PZ)
endloop
call DestroyGroup(LQ7)
set WI7=null
set LQ7=null
set PZ=null
endfunction
