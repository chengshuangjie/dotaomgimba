loop
exitwhen i>40
set Z97=x+i*20
set ZD7=y+i*20
if IsPointInRegion(IU4,Z97,ZD7)==false then
return Location(Z97,ZD7)
endif
set Z97=x+i*20
set ZD7=y-i*20
if IsPointInRegion(IU4,Z97,ZD7)==false then
return Location(Z97,ZD7)
endif
set Z97=x-i*20
set ZD7=y+i*20
if IsPointInRegion(IU4,Z97,ZD7)==false then
return Location(Z97,ZD7)
endif
set Z97=x-i*20
set ZD7=y-i*20
if IsPointInRegion(IU4,Z97,ZD7)==false then
return Location(Z97,ZD7)
endif
set i=i+1
endloop
return Location(x,y)
endfunction
