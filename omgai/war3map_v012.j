function Continuous_Damage2 takes nothing returns boolean
    local trigger t=GetTriggeringTrigger()
    local integer OB7=GetHandleId(t)
    local unit ZX7=LoadUnitHandle(ExtraHT, OB7, 0)
    local unit IH7=LoadUnitHandle(ExtraHT, OB7, 1)
    local real n=LoadReal(ExtraHT, OB7, 0)
    local real DUR=LoadReal(ExtraHT, OB7, 1)
    local real YM7=LoadReal(ExtraHT, OB7, 10)
    if IH7==null or GetUnitTypeId(IH7)==0 or ZX7==null or GetUnitTypeId(ZX7)==0 then
        if IH7!=null and GetUnitTypeId(IH7)!=0 then
            call UnitRemoveAbility(IH7,'A4JL')
            call UnitRemoveAbility(IH7,'B028')
            call RemoveSavedHandle( ExtraHT, 'jdxx', GetHandleId(IH7))
        endif
        call FlushChildHashtable(ExtraHT, OB7)
        call OZ7(t)
        set t=null
        set ZX7=null
        set IH7=null
        return false
    endif
    if n>DUR*10 or (n>1 and GetUnitAbilityLevel(IH7,'B028')==0) or GetTriggerEventId()==EVENT_UNIT_DEATH then
        call UnitRemoveAbility(IH7,'A4JL')
        call UnitRemoveAbility(IH7,'B028')
        call RemoveSavedHandle( ExtraHT, 'jdxx', GetHandleId(IH7))
        call FlushChildHashtable(ExtraHT, OB7)
        call OZ7(t)
        set t=null
        set ZX7=null
        set IH7=null
        return false
    elseif n>0 and ModuloReal(n,10.)==0 then
        call B67(ZX7,IH7,1,YM7)
    endif
    call SaveReal(ExtraHT, OB7, 0, n+1)
    set t=null
    set ZX7=null
    set IH7=null
    return false
endfunction
function Continuous_Damage takes unit ZX7,unit IH7 returns nothing
    local trigger t
    local integer OB7
    local integer level=0
    local real DUR=0.
    local real YM7=0.
    if ZX7==null or IH7==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 then
        return
    endif
    set level=SuijiMode_GetPairCastLevel(ZX7,'A013','A013','A0A6')
    if SuijiMode_HasAghanimState(ZX7) then
        set DUR=8.+level*2
        set YM7=70.+30*level+GetUnitState(IH7,UNIT_STATE_MAX_LIFE)*0.01
    else
        set DUR=4.+level*2
        set YM7=70.+30*level
    endif
    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\ChimaeraAcidMissile\\ChimaeraAcidMissile.mdl",IH7,"chest"))
    if HaveSavedHandle(ExtraHT, 'jdxx', GetHandleId(IH7)) then
	    set t=LoadTriggerHandle(ExtraHT, 'jdxx', GetHandleId(IH7))
		set OB7=GetHandleId(t)
        call SaveUnitHandle(ExtraHT, OB7, 0, ZX7)
        call SaveReal(ExtraHT, OB7, 0, 0)
        call SaveReal(ExtraHT, OB7, 1, DUR)
        call SaveReal(ExtraHT, OB7, 10, YM7)
        if GetUnitAbilityLevel(IH7,'B028')==0 then
            call XF7(IH7,'A4JL')
        endif
    else
        set t=CreateTrigger()
        set OB7=GetHandleId(t)
        call SaveUnitHandle(ExtraHT, OB7, 0, ZX7)
        call SaveUnitHandle(ExtraHT, OB7, 1, IH7)
        call SaveReal(ExtraHT, OB7, 0, 0)
        call SaveReal(ExtraHT, OB7, 1, DUR)
        call SaveReal(ExtraHT, OB7, 10, YM7)
        call SaveTriggerHandle(ExtraHT, 'jdxx', GetHandleId(IH7), t)
        call TriggerRegisterTimerEvent(t,.1,true)
        call TriggerRegisterUnitEvent(t,IH7,EVENT_UNIT_DEATH)
        call TriggerAddCondition(t,Condition(function Continuous_Damage2))
        call XF7(IH7,'A4JL')
    endif
    set t=null
endfunction
