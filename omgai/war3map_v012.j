//禁止移动(计数)
function MHUnit_DisableMoveEx takes unit u,boolean b returns nothing
    local integer h= GetHandleId(u)
    local integer count= LoadInteger(ExtraHT, h, HTKEY_UNIT_MOVE_COUINT)
    if b then
        set count=count + 1
    else
        set count=count - 1
    endif
    if count<0 then
        return
    endif
    call SaveInteger(ExtraHT, h, HTKEY_UNIT_MOVE_COUINT, count)
    if b then
        call MHUnit_DisableMove(u, true)
    else
        call MHUnit_DisableMove(u, false)
    endif
endfunction
function FixUnitMove takes unit u returns nothing
    local integer h= GetHandleId(u)
    local integer count= LoadInteger(ExtraHT, h, HTKEY_UNIT_MOVE_COUINT)
    if count>0 then
    loop
    exitwhen count==0
    call MHUnit_DisableMove(u,false)
    set count=count-1
    endloop
    endif
    if count<0 then
    loop
    exitwhen count==0
    call MHUnit_DisableMove(u,true)
    set count=count+1
    endloop
    endif
    call SaveInteger(ExtraHT, h, HTKEY_UNIT_MOVE_COUINT, count)
endfunction
//暂停单位(计数)
function PauseUnitEx takes unit u,boolean b returns nothing
    local integer h= GetHandleId(u)
    local integer count= LoadInteger(ExtraHT, h, HTKEY_UNIT_PAUSE_COUINT)
    if b then
        set count=count + 1
    else
        set count=count - 1
    endif
    if count<0 then
        return
    endif
    call SaveInteger(ExtraHT, h, HTKEY_UNIT_PAUSE_COUINT, count)
    if b then
        call EXPauseUnit(u , true)
    else
        call EXPauseUnit(u, false)
    endif
endfunction
function FixUnitPause takes unit u,player p returns nothing
    local integer h= GetHandleId(u)
    local integer count= LoadInteger(ExtraHT, h, HTKEY_UNIT_PAUSE_COUINT)
    if count==0 then
        if GetPlayerId(p)>0 then
            call DisplayTextToPlayer(p,0,0, GetUnitName(u)+" 不满足修复条件")
        endif
        return
    endif
    if count>0 then
    loop
    exitwhen count==0
    call EXPauseUnit(u,false)
    set count=count-1
    endloop
    endif
    if count<0 then
    loop
    exitwhen count==0
    call EXPauseUnit(u,true)
    set count=count+1
    endloop
    endif
    call SaveInteger(ExtraHT, h, HTKEY_UNIT_PAUSE_COUINT, count)
    if GetPlayerId(p)>0 then
        call DisplayTextToPlayer(p,0,0, GetUnitName(u)+" 已完成修复")
    endif
endfunction
function IsUnitInvulncerable takes unit u returns boolean
	return LoadInteger(ExtraHT, GetHandleId(u), HTKEY_UNIT_INVELNERABLE_COUINT) > 0
endfunction
//单位无敌(计数)
function SetUnitInvulnerableEx takes unit u,boolean b returns nothing
    local integer h= GetHandleId(u)
    local integer count= LoadInteger(ExtraHT, h, HTKEY_UNIT_INVELNERABLE_COUINT)
    if b then
        set count=count + 1
    else
        set count=count - 1
    endif
    call SaveInteger(ExtraHT, h, HTKEY_UNIT_INVELNERABLE_COUINT, count)
    if count > 0 then
        call SetUnitInvulnerable(u, true)
    else
        call SetUnitInvulnerable(u, false)
    endif
endfunction
//单位沉默
function FixUnitSilence takes unit u returns nothing
    local integer count=MHUnit_GetSilenceCount(u)
    if count>0 then
    loop
    exitwhen count==0
    call MHUnit_Silence(u, false)
    set count=count-1
    endloop
    endif
    if count<0 then
    loop
    exitwhen count==0
    call MHUnit_Silence(u,true)
    set count=count+1
    endloop
    endif
endfunction
//判断是否是物理伤害
function YDWEIsEventPhysicalDamage takes nothing returns boolean
	return 0 != EXGetEventDamageData(1)
endfunction

//判断是否是攻击伤害
function YDWEIsEventAttackDamage takes nothing returns boolean
	return 0 != EXGetEventDamageData(2)
endfunction

//判断是否是范围伤害
function YDWEIsEventRangedDamage takes nothing returns boolean
	return 0 != EXGetEventDamageData(3)
endfunction

//判断伤害类型
function YDWEIsEventDamageType takes damagetype damageType returns boolean
	return damageType == ConvertDamageType(EXGetEventDamageData(4))
endfunction

//判断武器类型
function YDWEIsEventWeaponType takes weapontype weaponType returns boolean
	return weaponType == ConvertWeaponType(EXGetEventDamageData(5))
endfunction

//判断攻击类型
function YDWEIsEventAttackType takes attacktype attackType returns boolean
	return attackType == ConvertAttackType(EXGetEventDamageData(6))
endfunction
//设置伤害
function YDWESetEventDamage takes real amount returns boolean
	return EXSetEventDamage(amount)
endfunction

