function OL9 takes nothing returns nothing
local string modeCmd=GetEventPlayerChatString()
if YJ4=="omg" and (modeCmd=="-1" or modeCmd=="-2" or modeCmd=="-3" or modeCmd=="-4" or modeCmd=="-5") then
return
endif
call NP9(modeCmd,1)
endfunction
function OmgNengCommand_Action takes nothing returns boolean
local string s=StringCase(GetEventPlayerChatString(),false)
if s=="-neng" or s=="neng" then
if XM_MODE then
set XM_MODE=false
set XM_EXP=0
set XM_GOLD=0
set XM_CG=false
set CT=false
set WT=false
set DG0=false
call X37(GetTriggerPlayer(),"|c00FFCC00已关闭默认 OMG 中的 XM 难度，当前为普通 OMG 难度。|r")
else
call X37(GetTriggerPlayer(),"|c00FFCC00当前已是普通 OMG 难度。|r")
endif
endif
return false
endfunction
function OmgNengCommand_Init takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
exitwhen i>=12
call TriggerRegisterPlayerChatEvent(t,Player(i),"-neng",true)
call TriggerRegisterPlayerChatEvent(t,Player(i),"neng",true)
set i=i+1
endloop
call TriggerAddCondition(t,Condition(function OmgNengCommand_Action))
set t=null
endfunction
