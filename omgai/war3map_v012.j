function K8E takes nothing returns boolean
if B287_GetSpellAbilityId()=='A2KZ' then
call K7E(GetTriggerUnit(),GetSpellTargetUnit(),true)
elseif B287_GetSpellAbilityId()=='A4HW' then
call AOE_DY()
endif
return false
endfunction
function IX8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function K8E))
set t=null
endfunction
function K9E takes nothing returns nothing
local unit ZX7=GetSummoningUnit()
local unit VZ8=GetSummonedUnit()
call SelectUnitAddForPlayer(VZ8,GetOwningPlayer(ZX7))
call UnitAddAbility(VZ8,'A2KY')
call UnitRemoveAbility(VZ8,'A2KY')
call SetUnitState(VZ8,UNIT_STATE_LIFE,GetUnitState(VZ8,UNIT_STATE_MAX_LIFE))
call SetUnitPosition(VZ8,GetUnitX(VZ8),GetUnitY(VZ8))
set ZX7=null
set VZ8=null
endfunction
function KDE takes nothing returns boolean
if GetUnitAbilityLevel(GetSummonedUnit(),'B0EI')>0 then
call K9E()
endif
return false
endfunction
function KEE takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local unit BB7
local integer BC7=GetUnitAbilityLevel(ZX7,'A2KX')
if ZX7==null or GetUnitTypeId(ZX7)==0 then
set ZX7=null
return
endif
set BB7=CreateUnit(GetOwningPlayer(ZX7),'e00E',GetUnitX(ZX7),GetUnitY(ZX7),0)
call UnitApplyTimedLife(BB7,'BTLF',2.)
call XF7(BB7,'A08Q')
call SetUnitAbilityLevel(BB7,'A08Q',BC7)
call IssueTargetOrderById(BB7,$D0132,ZX7)
set ZX7=null
set BB7=null
endfunction
function KFE takes nothing returns boolean
if B287_GetSpellAbilityId()=='A2KX' and GetUnitTypeId(GetTriggerUnit())=='Eevi' then
call KEE()
endif
return false
endfunction
function IB8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function KFE))
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SUMMON)
call TriggerAddCondition(t,Condition(function KDE))
set t=null
endfunction
function CHWS_A2 takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit u=O77(OB7,"Source")
local unit m5=O77(OB7,"Target")
local real IPD=GetUnitX(u)
local real IQD=GetUnitY(u)
local real RK=(Atan2(GetUnitY(m5)-IQD,GetUnitX(m5)-IPD))*1.0
local real x=GetUnitX(m5)-10*Cos(RK)
local real y=GetUnitY(m5)-10*Sin(RK)
if((IPD-x)*(IPD-x))+((IQD-y)*(IQD-y))<100 then
set x=IPD
set y=IQD
endif
call SetUnitX(m5,x)
call SetUnitY(m5,y)
if GetTriggerEvalCount(t)==20 or GetTriggerEventId()==EVENT_UNIT_DEATH then
call NM7(OB7)
call OZ7(t)
endif
set t=null
set m5=null
return false
endfunction
function CHWS_A takes unit u,unit m5 returns nothing
local trigger t
local integer OB7
local real DUR=1.
set t=CreateTrigger()
set OB7=GetHandleId(t)
call TriggerRegisterTimerEvent(t,0.05,true)
call TriggerRegisterUnitEvent(t,m5,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function CHWS_A2))
call NT7(OB7,"Source",u)
call NT7(OB7,"Target",m5)
call CommonUnitAddStun(m5,DUR, true)
set t=null
endfunction
function KHE takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local unit IH7=(LoadUnitHandle(L7,(I97),(17)))
local lightning G9E=(LoadLightningHandle(L7,(I97),(20)))
local integer WF8=GetTriggerEvalCount(t)
local integer level=LoadInteger(L7,I97,10)
local integer DUR=0
local real YM7=0.
local real x=LoadReal(L7,I97,21)
local real y=LoadReal(L7,I97,22)
local real MAXLENGTH=800.
local integer suijiSpiritSiphonMulticastCount=LoadInteger(L7,I97,11)
if ZX7==null or IH7==null or G9E==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 then
if G9E!=null then
call DestroyLightning(G9E)
endif
call FlushChildHashtable(L7,I97)
call OZ7(t)
set t=null
set ZX7=null
set IH7=null
set G9E=null
return false
endif
if suijiSpiritSiphonMulticastCount<1 then
set suijiSpiritSiphonMulticastCount=1
endif
set DUR=level*100+400
set YM7=(GetUnitState(IH7,UNIT_STATE_MAX_LIFE)*0.02+level*5+10)*suijiSpiritSiphonMulticastCount
if IsUnitVisible(IH7,GetOwningPlayer(ZX7)) then
    call MoveLightning(G9E,true,GetUnitX(ZX7),GetUnitY(ZX7),GetUnitX(IH7),GetUnitY(IH7))
    call SaveReal(L7,I97,21,GetUnitX(IH7))
    call SaveReal(L7,I97,22,GetUnitY(IH7))
else
    call MoveLightning(G9E,true,GetUnitX(ZX7),GetUnitY(ZX7),x,y)
endif
if KF7(GetUnitX(ZX7),GetUnitY(ZX7),GetUnitX(IH7),GetUnitY(IH7))<MAXLENGTH-150 then
    call SetLightningColor(G9E,1,1,1,1)
else
    call SetLightningColor(G9E,1,1,1,0.5)
endif
if (KF7(GetUnitX(ZX7),GetUnitY(ZX7),GetUnitX(IH7),GetUnitY(IH7))>MAXLENGTH and WF8>1) or GetTriggerEventId()==EVENT_UNIT_DEATH or WF8>DUR then
    call DestroyLightning(G9E)
    call SaveInteger(TABLE_HY, GetHandleId(IH7)+GetPlayerId(GetOwningPlayer(ZX7)), 'CHWS', 0)
    call FlushChildHashtable(L7,(I97))
    call OZ7(t)
elseif ModuloInteger(WF8,25)==0 and IsUnitVisible(IH7,GetOwningPlayer(ZX7)) and WF7(IH7)==false and IsHideUnit(IH7)==false and GetUnitAbilityLevel(IH7,'A04R')==0 then
    call B67(ZX7,IH7,1,YM7*.25)
    call SetUnitState(ZX7,UNIT_STATE_LIFE,GetUnitState(ZX7,UNIT_STATE_LIFE)+YM7*.25*DGH_BUFF(ZX7))
endif
set t=null
set ZX7=null
set IH7=null
set G9E=null
return false
endfunction
function CHWS_TRI takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local unit IH7=GetSpellTargetUnit()
local integer level=GetUnitAbilityLevel(ZX7,'A1PH')+Labike_Multiple_Skill_Level(ZX7,'A1PH')
local trigger t
local integer I97
local lightning G9E
local integer OB7=Get_Multiple_Skill_Key(ZX7,'A1PH')
local integer N5E=(LoadInteger(MSK,(OB7),(30)))
local real WF8
local integer skill=(LoadInteger(MSK,(OB7),(N5E)))
local integer suijiSpiritSiphonMulticastCount=1
if SUIJI_MODE and LoadReal(L7,GetHandleId(ZX7),StringHash("SuijiSpiritSiphonUntil"))>=TimerGetElapsed(W) then
set suijiSpiritSiphonMulticastCount=LoadInteger(L7,GetHandleId(ZX7),StringHash("SuijiSpiritSiphonCount"))
if suijiSpiritSiphonMulticastCount<1 then
set suijiSpiritSiphonMulticastCount=1
endif
endif
if N5E>0 then
    set G9E=AddLightning("DRAB",true,GetUnitX(ZX7),GetUnitY(ZX7),GetUnitX(IH7),GetUnitY(IH7))
    set t=CreateTrigger()
    set I97=GetHandleId(t)
    call TriggerRegisterTimerEvent(t,.01,true)
    call TriggerRegisterUnitEvent(t,ZX7,EVENT_UNIT_DEATH)
    call TriggerRegisterUnitEvent(t,IH7,EVENT_UNIT_DEATH)
    call TriggerAddCondition(t,Condition(function KHE))
    call SaveUnitHandle(L7,(I97),(2),(ZX7))
    call SaveUnitHandle(L7,(I97),(17),(IH7))
    call SaveInteger(L7,I97,10,level)
    call SaveInteger(L7,I97,11,suijiSpiritSiphonMulticastCount)
    call SaveLightningHandle(L7,(I97),(20),(G9E))
    call SaveReal(L7,I97,21,GetUnitX(IH7))
    call SaveReal(L7,I97,22,GetUnitY(IH7))
    call SaveInteger(TABLE_HY, GetHandleId(IH7)+GetPlayerId(GetOwningPlayer(ZX7)), 'CHWS', 1)
    call UnitRemoveAbility(ZX7,skill)
    set N5E=N5E-1
    call SaveInteger(MSK,(OB7),(30),(N5E))
    set skill=(LoadInteger(MSK,(OB7),(N5E)))
    call XF7(ZX7,skill)
    call SetUnitAbilityLevel(ZX7,skill,level)
    call Reset_Skill_range(ZX7)
    if SuijiMode_HasAghanimState(ZX7) then
        call CHWS_A(ZX7,IH7)
    endif
    call LINGXIA(ZX7,IH7)
else
    call X377(GetOwningPlayer(ZX7),"无可用次数")
endif
if N5E==0 then
set WF8=(LoadReal(MSK,(OB7),(50)))
if WF8>0 then
call Japi_ReduceUnitAbilityCoolDown(ZX7,skill,WF8)
endif
endif
set ZX7=null
set IH7=null
set G9E=null
set t=null
endfunction
function CHWS takes nothing returns boolean
local unit suijiDeathProphetDrainTarget=GetSpellTargetUnit()
if (B287_GetSpellAbilityId()=='A4L2' or B287_GetSpellAbilityId()=='A4L3' or B287_GetSpellAbilityId()=='A4L4' or B287_GetSpellAbilityId()=='A4L5' or B287_GetSpellAbilityId()=='A4L6') and suijiDeathProphetDrainTarget!=null and GetUnitTypeId(suijiDeathProphetDrainTarget)!=0 and GetUnitTypeId(suijiDeathProphetDrainTarget)!='n00L' and WQ7(suijiDeathProphetDrainTarget)==false then
call CHWS_TRI()
endif
set suijiDeathProphetDrainTarget=null
return false
endfunction
function CHWS_PD takes nothing returns boolean
local unit suijiDeathProphetDrainCaster=GetTriggerUnit()
local unit suijiDeathProphetDrainTarget=GetSpellTargetUnit()
if (B287_GetSpellAbilityId()=='A4L2' or B287_GetSpellAbilityId()=='A4L3' or B287_GetSpellAbilityId()=='A4L4' or B287_GetSpellAbilityId()=='A4L5' or B287_GetSpellAbilityId()=='A4L6') and suijiDeathProphetDrainCaster!=null and suijiDeathProphetDrainTarget!=null and GetUnitTypeId(suijiDeathProphetDrainCaster)!=0 and GetUnitTypeId(suijiDeathProphetDrainTarget)!=0 and GetUnitTypeId(suijiDeathProphetDrainTarget)!='n00L' then
    if LoadInteger(TABLE_HY, GetHandleId(suijiDeathProphetDrainTarget)+GetPlayerId(GetOwningPlayer(suijiDeathProphetDrainCaster)), 'CHWS')==1 then
        call KR7(suijiDeathProphetDrainCaster)
        call X37(GetOwningPlayer(suijiDeathProphetDrainCaster),"无法对目标重复释放吸魂巫术")
    endif
endif
set suijiDeathProphetDrainCaster=null
set suijiDeathProphetDrainTarget=null
return false
endfunction
function XXCHWS takes nothing returns boolean
local unit u=GetTriggerUnit()
local integer OB7=GetHandleId(u)
if B287_GetLearnedSkill()=='A1PH' and IsUnitIllusion(u)==false then
if GetUnitAbilityLevel(u,'A1PH')==1 then
call SaveInteger(MSK,(OB7),(0),('A4L2'))
call SaveInteger(MSK,(OB7),(1),('A4L3'))
call SaveInteger(MSK,(OB7),(2),('A4L4'))
call SaveInteger(MSK,(OB7),(3),('A4L5'))
call SaveInteger(MSK,(OB7),(4),('A4L6'))
call Multiple_Skill(u,4,0,30.,'A1PH',0)
endif
endif
set u=null
return false
endfunction
