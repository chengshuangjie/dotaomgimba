	// 	set level=GetUnitAbilityLevel(ZX7, 'A03B')
	// 	if level > 0 and GetPrdRandom(ZX7 , 'A03B' , 30) then
	// 		set Damagerate=1.7
	// 		if ( value < Damagerate ) then
	// 			set value=Damagerate
	// 			set skill='A03B'
	// 		endif
	// 	endif
	// endif

	// 暴击数值 > 0. 则播放暴击动画
    

	// elseif not (HaveSavedHandle(ExtraHT, GetHandleId((ZX7)), HTKEY_UNIT_BREAK)) then
	// 	// 头狼和巨狼 20% 2
	// 	set level=GetUnitAbilityLevel(ZX7, 'ACct')
	// 	if level > 0 and GetPrdRandom(ZX7 , 'ACct' , 20) then
	// 		set Damagerate=2.
	// 		if ( value < Damagerate ) then
	// 			set value=Damagerate
	// 			set skill='ACct'
	// 		endif
	// 	endif
	// 	// 精灵狼 30% 1.7
	// 	set level=GetUnitAbilityLevel(ZX7, 'A03B')
	// 	if level > 0 and GetPrdRandom(ZX7 , 'A03B' , 30) then
	// 		set Damagerate=1.7
	// 		if ( value < Damagerate ) then
	// 			set value=Damagerate
	// 			set skill='A03B'
	// 		endif
	// 	endif
	// endif

	// 暴击数值 > 0. 则播放暴击动画
    

	// elseif not (HaveSavedHandle(ExtraHT, GetHandleId((ZX7)), HTKEY_UNIT_BREAK)) then
	// 	// 头狼和巨狼 20% 2
	// 	set level=GetUnitAbilityLevel(ZX7, 'ACct')
	// 	if level > 0 and GetPrdRandom(ZX7 , 'ACct' , 20) then
	// 		set Damagerate=2.
	// 		if ( value < Damagerate ) then
	// 			set value=Damagerate
	// 			set skill='ACct'
	// 		endif
	// 	endif
	// 	// 精灵狼 30% 1.7
	// 	set level=GetUnitAbilityLevel(ZX7, 'A03B')
	// 	if level > 0 and GetPrdRandom(ZX7 , 'A03B' , 30) then
