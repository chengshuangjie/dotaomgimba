call TriggerAddCondition(t,Condition(function XQG))
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_HERO_SKILL)
call TriggerAddCondition(t,Condition(function XTG))
set t=null
set DZ7[0]='A2JO'
set DZ7[1]='A2JQ'
set DZ7[2]='A2JP'
set DZ7[3]='A2JR'
endfunction
function XUG takes nothing returns boolean
