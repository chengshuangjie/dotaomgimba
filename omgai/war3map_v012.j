function R4E takes nothing returns nothing
local unit p5=E3
local unit m5=GetEnumUnit()
local integer V77=V3
local unit BB7
call QBE(p5,m5)
call B67(p5,m5,1,150+100*V77)
if SuijiMode_HasAghanimState(p5) then
set BB7=CreateUnit(GetOwningPlayer(p5),'e00E',GetUnitX(m5),GetUnitY(m5),0)
    call XF7(BB7,'A1MG')
    if ISLABIKE(p5) then
        call B287_SetUnitAbilityLevel(BB7,'A1MG',4)
    else
        call B287_SetUnitAbilityLevel(BB7,'A1MG',B287_GetUnitAbilityLevel(p5,'A1MG'))
    endif
    call IssueTargetOrderById(BB7,$D0278,m5)
