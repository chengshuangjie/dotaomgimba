function RMA takes nothing returns nothing
local unit ZX7 = U22
local unit IH7 = W22
local integer level = B287_GetUnitAbilityLevel(ZX7,'A046')
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Naga\\NagaDeath\\NagaDeath.mdl", IH7, "chest"))
call Z57(IH7,'A4FE', level, 4, 0)
call Z57(IH7,'A4FF', 1, 4,'BNab')
call B67(ZX7,IH7,1,25.+(75.*level))
call LINGXIA(ZX7,IH7)
set ZX7=null
set IH7=null
endfunction
function GushUpgraded_Actions takes nothing returns nothing
	local unit u = Wave_U
	local integer level = Wave_LV
	call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Naga\\NagaDeath\\NagaDeath.mdl", u, "origin"))
    call Z57(u,'A4FE', level, 4, 0)
    call Z57(u,'A4FF', 1, 4,'BNab')
	set u = null
endfunction
function JULANG takes nothing returns nothing
	local unit u = GetTriggerUnit()
	local integer level = B287_GetUnitAbilityLevel(u, 'A4FG')
	local real x = GetUnitX(u)
	local real y = GetUnitY(u)
	local real length
    local integer ZZMF_level=GetUnitAbilityLevel(u,'A4DJ')+GetUnitAbilityLevel(u,'A4DZ')
    local integer ZZMF=0
    if ZZMF_level>0 then
        set ZZMF=50*ZZMF_level
    endif
    if GetUnitAbilityLevel(u,'A2YK')>0 then
    set length=1460+ZZMF
    elseif GetUnitAbilityLevel(u,'A2YJ')>0 then
    set length=1410+ZZMF
    else
    set length=1260+ZZMF
    endif
	call Wave(u,'h0H2', 25 + 75 * level, length, 240, 240, x, y, GetSpellTargetX(), GetSpellTargetY(), 1500, 1, false, "GushUpgraded_Actions", level)
	set u = null
endfunction
