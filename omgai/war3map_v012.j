    function OMGAIEnemyState_OMGAI_EnemyStateInit takes nothing returns nothing
        call OMGAICore_OMGAI_SaveGlobalBool(GSLOT_INVIS_ENEMY, false)
        call OMGAILog_LOG_INFO("ENM", "OMGAIEnemyState 初始化完成")
    endfunction


