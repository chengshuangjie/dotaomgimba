if d>0 then
set BC7=BC7*d
endif
if UW9-UX9>BC7 and UY9==false and XH7(WI7)==false and ISPH(WI7)==false then
call NS7(GetHandleId(WI7),"JinadaActive",true)
call XF7(WI7,'A1VE')
