local real NRG
local real NSG
local real NTG
local real NUG
set NPG=N8G-NDG
set NQG=N9G-NEG
set NRG=-1*NQG
set NSG=NPG
set NTG=SquareRoot(NRG*NRG+NSG*NSG)
set NRG=NRG/ NTG
set NSG=NSG/ NTG
set NFG=N4G-N8G
set NGG=N7G-N9G
set NHG=SquareRoot(NFG*NFG+NGG*NGG)
set NIG=NFG/ NHG
set NJG=NGG/ NHG
set NUG=NFG*NRG+NGG*NSG
set NKG=-1*N4G+2*N8G+2*NRG*NUG
set NMG=-1*N7G+2*N9G+2*NSG*NUG
set NNG=NDG+N8G-NKG
set NOG=NEG+N9G-NMG
return NNG
endfunction
function NVG takes real N4G,real N7G,real N8G,real N9G,real NDG,real NEG returns real
local real NFG
local real NGG
local real NHG
local real NIG
local real NJG
local real NKG
local real NMG
local real NNG
local real NOG
local real NPG
local real NQG
local real NRG
local real NSG
local real NTG
local real NUG
set NPG=N8G-NDG
set NQG=N9G-NEG
set NRG=-1*NQG
set NSG=NPG
set NTG=SquareRoot(NRG*NRG+NSG*NSG)
set NRG=NRG/ NTG
set NSG=NSG/ NTG
set NFG=N4G-N8G
set NGG=N7G-N9G
set NHG=SquareRoot(NFG*NFG+NGG*NGG)
set NIG=NFG/ NHG
set NJG=NGG/ NHG
set NUG=NFG*NRG+NGG*NSG
set NKG=-1*N4G+2*N8G+2*NRG*NUG
set NMG=-1*N7G+2*N9G+2*NSG*NUG
set NNG=NDG+N8G-NKG
set NOG=NEG+N9G-NMG
return NOG
endfunction
function NWG takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit p5=(LoadUnitHandle(L7,(OB7),(2)))
local unit M9G=(LoadUnitHandle(L7,(OB7),(335)))
local real x0=(LoadReal(L7,(OB7),(282)))
local real y0=(LoadReal(L7,(OB7),(283)))
local real x1=GetUnitX(p5)
local real y1=GetUnitY(p5)
local real x2=GetUnitX(M9G)
local real y2=GetUnitY(M9G)
local real x3
local real y3
local real a
local group A1D=(LoadGroupHandle(L7,(OB7),($BB)))
local group g
local integer V77=B287_GetUnitAbilityLevel(p5,'A1A8')
local real NXG=(LoadReal(L7,(OB7),(342)))
local real CP7=(TimerGetElapsed(W))
local boolean suijiElderSpiritExtra=LoadBoolean(L7,OB7,StringHash("SuijiExtraAncestralSpirit"))
local boolean suijiElderSpiritPrimary=suijiElderSpiritExtra==false
if GetTriggerEventId()==EVENT_UNIT_DEATH then
call WR7(A1D)
call FlushChildHashtable(L7,(OB7))
call OZ7(t)
call ShowUnit(M9G,false)
call KillUnit(M9G)
if suijiElderSpiritPrimary then
call SaveInteger(L7,(GetHandleId((p5))),((4270)),(2))
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A1A8',true)
call SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A2NI',false)
endif
elseif GetTriggerEventId()==EVENT_UNIT_SPELL_EFFECT and suijiElderSpiritPrimary then
if B287_GetSpellAbilityId()=='A2NI' then
call IssueImmediateOrderById(M9G,$D0004)
call SaveBoolean(L7,(OB7),($F9),(true))
call SetUnitAnimationByIndex(M9G,3)
call M6G(GetTriggerUnit())
elseif B287_GetSpellAbilityId()=='A2LK' then
if IssueImmediateOrderById(p5,$D0265)then
call UnitRemoveAbility(M9G,'A2LK')
endif
endif
elseif KF7(x1,y1,x2,y2)<100 then
call M1G(p5,M9G,(LoadInteger(L7,(OB7),(344))),(LoadInteger(L7,(OB7),(345))),suijiElderSpiritPrimary)
call WR7(A1D)
call FlushChildHashtable(L7,(OB7))
call OZ7(t)
if suijiElderSpiritPrimary then
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A1A8',true)
call SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A2NI',false)
endif
elseif GetTriggerEvalCount(t)>400 or(LoadBoolean(L7,(OB7),($F9))) then
call XF7(M9G,'Aloc')
if GetTriggerEvalCount(t)==401 and(LoadBoolean(L7,(OB7),($F9)))==false then
call IssueImmediateOrderById(M9G,$D0004)
call SetUnitAnimationByIndex(M9G,3)
endif
set g=WS7()
set SH4=V77
set SI4=(LoadInteger(L7,(OB7),(344)))
set SJ4=(LoadInteger(L7,(OB7),(345)))
set SG4=80+40*V77
set SF4=p5
set IN4=p5
set M1=A1D
call GroupEnumUnitsInRange(g,GetUnitX(M9G),GetUnitY(M9G),300,Condition(function AJ7_gai))
call ForGroup(g,function M2G)
call WR7(g)
set g=null
call SaveInteger(L7,(OB7),(344),(SI4))
call SaveInteger(L7,(OB7),(345),(SJ4))
if((LoadInteger(L7,(GetHandleId((p5))),((4269))))==1)==false then
set a=Atan2(y1-y2,x1-x2)
call SetUnitFacing(M9G,a*bj_RADTODEG)
set x3=GetUnitX(M9G)+$C*Cos(a)
set y3=GetUnitY(M9G)+$C*Sin(a)
call SetUnitX(M9G,X17(x3))
call SetUnitY(M9G,X07(y3))
call SaveReal(L7,(OB7),(282),((x1)*1.))
call SaveReal(L7,(OB7),(283),((y1)*1.))
endif
else
call SetUnitMoveSpeed(M9G,GetUnitMoveSpeed(p5))
call UnitRemoveAbility(M9G,'Aloc')
set g=WS7()
set SH4=V77
set SI4=(LoadInteger(L7,(OB7),(344)))
set SJ4=(LoadInteger(L7,(OB7),(345)))
set SG4=80+40*V77
set SF4=p5
set IN4=p5
set M1=A1D
call GroupEnumUnitsInRange(g,GetUnitX(M9G),GetUnitY(M9G),300,Condition(function AJ7_gai))
call ForGroup(g,function M2G)
call WR7(g)
set g=null
call SaveInteger(L7,(OB7),(344),(SI4))
call SaveInteger(L7,(OB7),(345),(SJ4))
if x0!=x1 or y0!=y1 then
set NXG=CP7
call SaveReal(L7,(OB7),(342),((NXG)*1.))
endif
if((LoadInteger(L7,(GetHandleId((p5))),((4269))))==1)==false then
if NXG==CP7 then
set x3=M_G(x0,y0,x1,y1,x2,y2)
set y3=NVG(x0,y0,x1,y1,x2,y2)
set a=Atan2(y3-y2,x3-x2)*bj_RADTODEG
call SaveReal(L7,(OB7),(282),((x1)*1.))
call SaveReal(L7,(OB7),(283),((y1)*1.))
endif
if(NXG+.3)<CP7 then
call SaveInteger(L7,(OB7),(343),(1))
elseif(NXG+.3)>CP7 and(LoadInteger(L7,(OB7),(343)))==1 then
call SaveInteger(L7,(OB7),(343),(2))
elseif(LoadInteger(L7,(OB7),(343)))==3 then
call SaveInteger(L7,(OB7),(343),(1))
endif
else
call SaveInteger(L7,(OB7),(343),(3))
endif
endif
set t=null
set p5=null
set M9G=null
set A1D=null
return false
endfunction
function ElderTitanAncestralSpirit_Create takes unit suijiElderSpiritCaster,real suijiElderSpiritTargetX,real suijiElderSpiritTargetY,boolean suijiElderSpiritPrimary returns nothing
local trigger suijiElderSpiritTrigger=null
local integer suijiElderSpiritHandle=0
local real suijiElderSpiritCasterX=0.
local real suijiElderSpiritCasterY=0.
local real suijiElderSpiritAngle=0.
local real suijiElderSpiritDistance=0.
local real suijiElderSpiritSpawnX=0.
local real suijiElderSpiritSpawnY=0.
local unit suijiElderSpiritUnit=null
if suijiElderSpiritCaster==null or UnitAlive(suijiElderSpiritCaster)==false then
return
endif
set suijiElderSpiritCasterX=GetUnitX(suijiElderSpiritCaster)
set suijiElderSpiritCasterY=GetUnitY(suijiElderSpiritCaster)
if suijiElderSpiritPrimary==false and suijiElderSpiritTargetX==0. and suijiElderSpiritTargetY==0. then
set suijiElderSpiritTargetX=suijiElderSpiritCasterX+300.*Cos(GetUnitFacing(suijiElderSpiritCaster)*bj_DEGTORAD)
set suijiElderSpiritTargetY=suijiElderSpiritCasterY+300.*Sin(GetUnitFacing(suijiElderSpiritCaster)*bj_DEGTORAD)
endif
set suijiElderSpiritAngle=Atan2(suijiElderSpiritTargetY-suijiElderSpiritCasterY,suijiElderSpiritTargetX-suijiElderSpiritCasterX)
set suijiElderSpiritDistance=YK7(KF7(suijiElderSpiritCasterX,suijiElderSpiritCasterY,suijiElderSpiritTargetX,suijiElderSpiritTargetY),300)
set suijiElderSpiritSpawnX=X17(suijiElderSpiritCasterX+suijiElderSpiritDistance*Cos(suijiElderSpiritAngle))
set suijiElderSpiritSpawnY=X07(suijiElderSpiritCasterY+suijiElderSpiritDistance*Sin(suijiElderSpiritAngle))
set suijiElderSpiritUnit=CreateUnit(GetOwningPlayer(suijiElderSpiritCaster),'h07U',suijiElderSpiritSpawnX,suijiElderSpiritSpawnY,suijiElderSpiritAngle*bj_RADTODEG-180)
call SetUnitMoveSpeed(suijiElderSpiritUnit,GetUnitMoveSpeed(suijiElderSpiritCaster))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\AbsorbMana\\AbsorbManaBirthMissile.mdl",suijiElderSpiritUnit,"chest"))
if B287_GetUnitAbilityLevel(suijiElderSpiritCaster,'A1CD')>0 then
call XF7(suijiElderSpiritUnit,'A1CQ')
endif
if B287_GetUnitAbilityLevel(suijiElderSpiritCaster,'A1AA')==0 or suijiElderSpiritPrimary==false then
call UnitRemoveAbility(suijiElderSpiritUnit,'A2LK')
endif
if suijiElderSpiritPrimary then
call UnitAddAbility(suijiElderSpiritCaster,'A2NI')
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(suijiElderSpiritCaster),'A1A8',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(suijiElderSpiritCaster),'A2NI',true)
set SK4[GetPlayerId(GetOwningPlayer(suijiElderSpiritCaster))]=suijiElderSpiritUnit
call SaveInteger(L7,(GetHandleId((suijiElderSpiritCaster))),((4270)),(1))
endif
call XF7(suijiElderSpiritUnit,'Avul')
call XF7(suijiElderSpiritUnit,'Aetl')
set suijiElderSpiritTrigger=CreateTrigger()
set suijiElderSpiritHandle=GetHandleId(suijiElderSpiritTrigger)
if suijiElderSpiritPrimary and LoadBoolean(L7,(GetHandleId(suijiElderSpiritCaster)),(339)) then
call TriggerEvaluate((LoadTriggerHandle(L7,(suijiElderSpiritHandle),(338))))
endif
call TriggerRegisterTimerEvent(suijiElderSpiritTrigger,.02,true)
call TriggerRegisterUnitEvent(suijiElderSpiritTrigger,suijiElderSpiritCaster,EVENT_UNIT_DEATH)
if suijiElderSpiritPrimary then
call TriggerRegisterUnitEvent(suijiElderSpiritTrigger,suijiElderSpiritCaster,EVENT_UNIT_SPELL_EFFECT)
call TriggerRegisterUnitEvent(suijiElderSpiritTrigger,suijiElderSpiritUnit,EVENT_UNIT_SPELL_EFFECT)
else
call SaveBoolean(L7,suijiElderSpiritHandle,StringHash("SuijiExtraAncestralSpirit"),true)
endif
call TriggerAddCondition(suijiElderSpiritTrigger,Condition(function NWG))
call SaveUnitHandle(L7,(suijiElderSpiritHandle),(2),(suijiElderSpiritCaster))
call SaveUnitHandle(L7,(suijiElderSpiritHandle),(335),(suijiElderSpiritUnit))
call SaveReal(L7,(suijiElderSpiritHandle),(282),((suijiElderSpiritCasterX)*1.))
call SaveReal(L7,(suijiElderSpiritHandle),(283),((suijiElderSpiritCasterY)*1.))
call SaveGroupHandle(L7,(suijiElderSpiritHandle),($BB),(WS7()))
call SaveInteger(L7,(suijiElderSpiritHandle),(343),(2))
call SaveReal(L7,(suijiElderSpiritHandle),(342),(((TimerGetElapsed(W))-5)*1.))
call SaveBoolean(L7,(suijiElderSpiritHandle),($F9),(false))
set suijiElderSpiritUnit=null
set suijiElderSpiritTrigger=null
endfunction
