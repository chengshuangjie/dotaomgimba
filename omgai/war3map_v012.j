//驱散正面Buff
function RemoveUnitGoodBuff takes unit u,boolean b returns nothing
if OT7(u,"BorrowedTime|Active") then //回光期间无视驱散
	return
endif
if b then
call UnitRemoveBuffs(u,true,false) //秒杀召唤物和幻象
endif
call UnitRemoveAbility(u,'A1F6') //战吼
call UnitRemoveAbility(u,'A1F7')
call UnitRemoveAbility(u,'A1F3')
call UnitRemoveAbility(u,'A1F5')
call UnitRemoveAbility(u,'B0BV')
call UnitRemoveAbility(u,'Aetl')
call UnitRemoveAbility(u,'A2RY') //微光
call UnitRemoveAbility(u,'A2RZ') //微光
call UnitRemoveAbility(u,'A0VJ')
call UnitRemoveAbility(u,'A109')
call UnitRemoveAbility(u,'A4A8') //古尔丹之颅
call UnitRemoveAbility(u,'B0I4')
call UnitRemoveAbility(u,'A33F') //骨灰
call UnitRemoveAbility(u,'B0HW')
call UnitRemoveAbility(u,'A2YU') //大骨灰
call UnitRemoveAbility(u,'B0HZ')
call Remove_SYLL(u)  //授予力量
call UnitRemoveAbility(u,'B014') //全能套子
call UnitRemoveAbility(u,'A4HP') //疯脸
call UnitRemoveAbility(u,'B07S')
call UnitRemoveAbility(u,'A4HQ')
call UnitRemoveAbility(u,'B0J8')
call UnitRemoveAbility(u,'A4HU')
call UnitRemoveAbility(u,'B0K4')
call UnitRemoveAbility(u,'A4HV')
call UnitRemoveAbility(u,'Aetl') //虚无
call UnitRemoveAbility(u,'B01N')
call UnitRemoveAbility(u,'A1QB')
call UnitRemoveAbility(u,'B0CY')
call UnitRemoveAbility(u,'A1QC')
call UnitRemoveAbility(u,'B013') //冲刺
call UnitRemoveAbility(u,'A2R2') //蝴蝶
call UnitRemoveAbility(u,'B0GU') 
call REMOVE_SX_BUFF(u)
call REMOVE_KM_BUFF(u)
call Remove_SZAS_GoodBuff(u)      //霜之哀伤
call UnitRemoveAbility(u,'A4LW')  //奔腾
call UnitRemoveAbility(u,'B07W')  //奔腾
call UnitRemoveAbility(u,'A4MP')
call UnitRemoveAbility(u,'B0KV')
//大电不会被驱散
endfunction
