call KX7(QU8)
endif
if DXD>0 then
set QU8=UnitItemInSlot(S4,1)
call KX7(QU8)
endif
if DYD>0 then
set QU8=UnitItemInSlot(S4,2)
call KX7(QU8)
endif
if DZD>0 then
set QU8=UnitItemInSlot(S4,3)
call KX7(QU8)
endif
if Z6E>0 then
set QU8=UnitItemInSlot(S4,4)
call KX7(QU8)
endif
if ZLE>0 then
