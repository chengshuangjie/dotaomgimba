function Set_Unit_Shuxing_Time2 takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit m5=LoadUnitHandle(L7,OB7,17)
local integer skill=LoadInteger(L7,OB7,59)
// local integer skillbuff=LoadInteger(L7,OB7,60)
if TimerGetElapsed(W)>=LoadReal(L7,OB7,0) or GetTriggerEventId()==EVENT_WIDGET_DEATH or (GetUnitAbilityLevel(m5,skill)==0 and GetTriggerEvalCount(t)>1) then
    // call UnitRemoveAbility(m5,skillbuff)
    call UnitRemoveAbility(m5,skill)
    call FlushChildHashtable(L7,OB7)
    call OZ7(t)
    call RemoveSavedHandle(Dvv,GetHandleId(m5),0-skill)
endif
set t=null
set m5=null
return false
endfunction
//自定义属性 攻击力模板AIat
function Set_Unit_Shuxing_Time takes unit m5,integer skill,real d,real DUR returns nothing
local trigger t
local integer OB7
local real hyy
local real Hyy=TimerGetElapsed(W)+DUR
if XH7(m5)then
return
endif
if HaveSavedHandle(Dvv,GetHandleId(m5),0-skill)then
set t=LoadTriggerHandle(Dvv,GetHandleId(m5),0-skill)
set OB7=GetHandleId(t)
else
set t=CreateTrigger()
set OB7=GetHandleId(t)
call FlushChildHashtable(L7,OB7)
call SaveUnitHandle(L7,OB7,17,m5)
call SaveInteger(L7,OB7,59,skill)
// call SaveInteger(L7,OB7,60,skillbuff)
call SaveReal(L7,OB7,0,0)
call TriggerRegisterDeathEvent(t,m5)
call TriggerRegisterTimerEvent(t,.1,true)
call TriggerAddCondition(t,Condition(function Set_Unit_Shuxing_Time2))
call SaveTriggerHandle(Dvv,GetHandleId(m5),0-skill,t)
endif
set hyy=LoadReal(L7,OB7,0)
if hyy<Hyy then
call SaveReal(L7,OB7,0,Hyy)
endif
call XF7(m5,skill)
call MHAbility_SetCustomLevelDataReal(m5,skill,1,ABILITY_LEVEL_DEF_DATA_DATA_A,d)
call SetUnitAbilityLevel(m5,skill,2)
call SetUnitAbilityLevel(m5,skill,1)
set t=null
endfunction
