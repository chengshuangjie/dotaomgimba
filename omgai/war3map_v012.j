    function OMGAIIPlatformAPI___KKGetVoucherImpl takes integer playerId returns integer
        local string val = DzAPI_Map_GetServerString(Player(playerId - 1), OMGAI_VOUCHER_ITEM_KEY)
        if val == null or val == "" then
            return 0
        endif
        return S2I(val)
    endfunction

    function OMGAIIPlatformAPI___KKConsumeVoucherImpl takes integer playerId, integer count returns integer
        local integer current = OMGAIIPlatformAPI___KKGetVoucherImpl(playerId)
        if current < count then
            return 0
        endif
        set current = current - count
        call DzAPI_Map_SaveServerString(Player(playerId - 1), OMGAI_VOUCHER_ITEM_KEY, I2S(current))
        return 1
    endfunction

    function OMGAIIPlatformAPI___KKQuickBuyImpl takes integer playerId, string itemKey, integer count returns integer
        call DzAPI_Map_QuickBuy(Player(playerId - 1), itemKey)
        return 1
    endfunction

