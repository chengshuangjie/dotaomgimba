function SSTX2 takes nothing returns boolean
	local trigger t = GetTriggeringTrigger()
	local integer h = GetHandleId(t)
	local unit ZX7 = LoadUnitHandle(TABLE_HY, h, 10)
	local unit IH7 = LoadUnitHandle(TABLE_HY, h, 11)
	local real x = LoadReal(TABLE_HY, h, 1)
	local real y = LoadReal(TABLE_HY, h, 2)
	local real angle=AngleBetweenUnit(ZX7,IH7)
	if GetTriggerEvalCount(t)>=125 or GetTriggerEventId()==EVENT_UNIT_DEATH or (GetUnitAbilityLevel(IH7,'B0KF')== 0 and GetTriggerEvalCount(t)>2) or GetUnitAbilityLevel(IH7,'A04R')==1 then
        call UnitRemoveAbility(IH7,'A4K5')
        call UnitRemoveAbility(IH7,'B0KF')
		call FlushChildHashtable(TABLE_HY, h)
		call OZ7(t)
	else
        if KF7(x,y,GetUnitX(IH7),GetUnitY(IH7))<100 then
            call SetUnitX(IH7,x)
            call SetUnitY(IH7,y)
        endif
		if angle<0 then
			set angle=angle+360
		endif
        if GetUnitFacing(IH7)<angle-35 or GetUnitFacing(IH7)>angle+35 then
            call MHUnit_SetFacing(IH7,angle,true)
        endif
	endif
	set t = null
	set ZX7 = null
	set IH7 = null
	return false
endfunction
function SSTX takes unit ZX7,unit IH7 returns nothing
	local trigger t = CreateTrigger()
	local integer h = GetHandleId(t)
    call XF7(IH7,'A4K5')
	call SaveUnitHandle(TABLE_HY, h, 10, ZX7)
	call SaveUnitHandle(TABLE_HY, h, 11, IH7)
    call SaveReal(TABLE_HY, h, 1, GetUnitX(IH7))
    call SaveReal(TABLE_HY, h, 2, GetUnitY(IH7))
	call TriggerRegisterTimerEvent(t, 0.02, true)
    call TriggerRegisterUnitEvent(t,ZX7,EVENT_UNIT_DEATH)
    call TriggerRegisterUnitEvent(t,IH7,EVENT_UNIT_DEATH)
	call TriggerAddCondition(t, Condition(function SSTX2))
	set t = null
endfunction
function H0D takes nothing returns nothing
local unit p5=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local real YM7=30*B287_GetUnitAbilityLevel(p5,'A0K9')
local trigger t
local real x=GetUnitX(m5)-75*Cos(GetUnitFacing(m5)*bj_DEGTORAD)
local real y=GetUnitY(m5)-75*Sin(GetUnitFacing(m5)*bj_DEGTORAD)
call SetUnitX(p5,x)
call SetUnitY(p5,y)
call SetUnitFacing(p5,GetUnitFacing(m5))
call DestroyEffect(AddSpecialEffect("war3mapImported\\BlinkStrike.mdx",x,y))
if IsUnitEnemy(m5,GetOwningPlayer(p5))then
    call B67(p5,m5,1,YM7)
    call NS7(GetHandleId(p5),"Backstab|Free",true)
    call IssueTargetOrderById(p5,$D000F,m5)
    call LINGXIA(p5,m5)
    if(GetPlayerController(GetOwningPlayer(p5))!=MAP_CONTROL_USER)then
        call J_7(.01)
        call IssueTargetOrderById(p5,$D000F,m5)
    endif
    if UnitAlive(m5) and SuijiMode_HasAghanimState(p5) then
        call SSTX(p5,m5)
    endif
endif
set p5=null
set m5=null
set t=null
endfunction
