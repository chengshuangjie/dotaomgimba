call NP7(i,"id",P1)
endif
endif
endif
set G97[272+O5]=R2I(Bz)+$F
set GE7[$D0+O5]=false
call TriggerExecute(Q04[112+O5])
if(G97[432+O5]!=2)then
loop
call TriggerSleepAction(.2)
exitwhen Bz>G97[272+O5]
endloop
endif
return GE7[$D0+O5]
endfunction
function BOE takes integer O5,unit it,integer i1,boolean BPE returns boolean
local boolean BQE=MR7(it,ZU[i1])or MR7(KU4[32+O5],ZU[i1])or((KU4[32+O5]!=KU4[O5])and MR7(KU4[O5],ZU[i1]))
if OO7('CMis',I2S(GetHandleId(it))+"|"+I2S(i1)) then
set BPE=false
endif
if BPE and(IsItemOwned(bj_lastCreatedItem)or(not MS7(it)))then
if not((G97[O5]==i1 or G97[16+O5]==i1)and BQE)then
if G97[O5]==0 and G97[16+O5]!=i1 then
set G97[O5]=i1
elseif G97[16+O5]==0 and G97[O5]!=i1 then
set G97[16+O5]=i1
endif
if not BQE then
return B4E(O5,it,i1,true)
endif
endif
else
if BQE then
if(G97[O5]==i1)then
set G97[O5]=0
elseif(G97[16+O5]==i1)then
set G97[16+O5]=0
endif
endif
endif
return false
endfunction
function BRE takes integer O5 returns nothing
local integer i=0
local item KA7=null
local integer i1
loop
exitwhen i>5
set KA7=UnitItemInSlot(KU4[32+O5],i)
if KA7!=null then
set bj_forLoopAIndex=GetItemTypeId(KA7)
set i1=-1
if(bj_forLoopAIndex==ZU[G97[O5]])then
set i1=G97[O5]
set G97[O5]=0
elseif(bj_forLoopAIndex==ZU[G97[16+O5]])then
set i1=G97[16+O5]
set G97[16+O5]=0
elseif(bj_forLoopAIndex==ZU[YC])then
call ZAE(O5,M7[O5],KA7,YC)
endif
if i1!=-1 then
call NS7('CMis',I2S(GetHandleId(M7[O5]))+"|"+I2S(i1),true)
call ZAE(O5,M7[O5],KA7,i1)
endif
endif
set i=i+1
endloop
set KA7=null
endfunction
function BSE takes integer O5 returns boolean
local integer I97=GetHandleId(KU4[16+O5])
local integer i=0
if AISZ[O5]==1 or AISJ[O5]==1 then
return false
endif
if(Bz<hq[896+O5])or(not OO7(I97,"aiCrow|Alive"))then
return false
endif
if(KE7(M7[O5],h9[16+O5])<$4B0)then
return false
endif
if(OO7(I97,"aiCrow|Active"))and(KE7(KU4[16+O5],h9[16+O5])<800)and(Bz>ON7(I97,"aiCrow|Move"))then
call EM9(KU4[16+O5])
endif
set i=OM7(I97,"aiCrow|CurrentOwner")
if(OO7(I97,"aiCrow|Active"))then
if(i==O5)then
if OO7(I97,"aiCrow|Away")then
call IssueNeutralImmediateOrderById(Player(O5),KU4[16+O5],'h085')
else
call IssueImmediateOrderById(KU4[16+O5],$D0117)
endif
endif
return false
endif
if(i!=O5)and((not true)or((TV7(Player(O5))and(i!=GetPlayerId(Z7[0])))or(TW7(Player(O5))and(i!=GetPlayerId(A7[0])))))then
return false
endif
if(true)and(GetOwningPlayer(KU4[16+O5])!=Player(O5))then
call SetUnitOwner(KU4[16+O5],Player(O5),false)
endif
if IssueNeutralImmediateOrderById(Player(O5),KU4[16+O5],'h085') then
call NP7(I97,"aiCrow|CurrentOwner",O5)
call NS7(I97,"aiCrow|Active",true)
call NQ7(I97,"aiCrow|Move",Bz+$F)
call NS7(I97,"aiCrow|Away",true)
set GE7[$E0+O5]=true
set i=0
set LJ4=null
loop
exitwhen i>5
set LJ4=UnitItemInSlot(KU4[O5],i)
if LJ4!=null then
call UnitAddItem(KU4[16+O5],LJ4)
endif
set i=i+1
endloop
return true
endif
return false
endfunction
function BTE takes integer O5,boolean BUE returns boolean
return(GZ7 and(KU4[16+O5]!=null)and G97[432+O5]==0 and BUE and(GE7[$80+O5]or GE7[$90+O5]))
endfunction
function Enemy_Have_QuanNeng_PD takes nothing returns boolean
    return GetUnitTypeId(GetFilterUnit())=='Harf' and IsUnitType(GetFilterUnit(),UNIT_TYPE_HERO) and IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(IN4))
endfunction
function Enemy_Have_QuanNeng takes unit u returns boolean
    local player p
    local integer i=0
    local group g=WS7()
    local group g2=WS7()
    set Have_QuanNeng=false
    loop
    exitwhen i>12
    set p=Player(i)
    set IN4=u
    call GroupEnumUnitsOfPlayer(g, p, Condition(function Enemy_Have_QuanNeng_PD))
    if FirstOfGroup(g)!=null then
        call GroupAddGroup(g, g2)
    endif
    set i=i+1
    endloop
    if FirstOfGroup(g2)!=null then
        set Have_QuanNeng=true
    endif
    call WR7(g)
    call WR7(g2)
    set p=null
    set g=null
    set g2=null
    return Have_QuanNeng
endfunction
function GET_ITEM_2 takes integer id1,integer id2 returns integer
    local integer n=GetRandomInt(1,2)
    if n==1 then
        return id1
    else
        return id2
    endif
endfunction
function GET_ITEM_3 takes integer id1,integer id2,integer id3 returns integer
    local integer n=GetRandomInt(1,3)
    if n==1 then
        return id1
    elseif n==2 then
        return id2
    else
        return id3
    endif
endfunction
function GET_ITEM_4 takes integer id1,integer id2,integer id3,integer id4 returns integer
    local integer n=GetRandomInt(1,4)
    if n==1 then
        return id1
    elseif n==2 then
        return id2
    elseif n==3 then
        return id3
    else
        return id4
    endif
endfunction

function AISCZB takes unit it returns nothing
call RemoveItem(UnitItemInSlot(it,0))
call RemoveItem(UnitItemInSlot(it,1))
call RemoveItem(UnitItemInSlot(it,2))
call RemoveItem(UnitItemInSlot(it,3))
call RemoveItem(UnitItemInSlot(it,4))
call RemoveItem(UnitItemInSlot(it,5))
endfunction
