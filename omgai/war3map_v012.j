call SaveUnitHandle(L7,(I97),(2),(ZX7))
call SaveUnitHandle(L7,(I97),(17),(IH7))
call SaveEffectHandle(L7,(I97),(32),(AddSpecialEffectTarget("war3mapImported\\MagnetizeTargetOverhead.mdx",IH7,"origin")))
