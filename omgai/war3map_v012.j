// call UnitAddAbility(WI7,1093747287)
// call UnitMakeAbilityPermanent(WI7,true,1093747287)
// endif
if KZ7(GetManipulatedItem())==DK4 then
call UnitAddAbility(WI7,'A0PU')
call UnitMakeAbilityPermanent(WI7,true,'A0PU')
call UnitAddAbility(WI7,'A0TC')
call UnitMakeAbilityPermanent(WI7,true,'A0TC')
call UnitAddAbility(WI7,'A0UK')
call UnitMakeAbilityPermanent(WI7,true,'A0UK')
endif
if KZ7(GetManipulatedItem())==EZB then
call XF7(WI7,'A2T9')
if IsUnitType(WI7,UNIT_TYPE_MELEE_ATTACKER)==true then
call XF7(WI7,'A4AB')
call SetPlayerAbilityAvailable(GetOwningPlayer(WI7),'A4AB',false)
else
call XF7(WI7,'A2QS')
call SetPlayerAbilityAvailable(GetOwningPlayer(WI7),'A2QS',false)
endif
endif
if KZ7(GetManipulatedItem())==R16 and GetUnitTypeId(WI7)=='E032' then
call XF7(WI7,'A2SI')
call SetUnitAbilityLevel(WI7,'A2SI',GetUnitAbilityLevel(WI7,'A2E5')+GetUnitAbilityLevel(WI7,'A2SH'))
call SetPlayerAbilityAvailable(GetOwningPlayer(WI7),'A2SI',true)
endif
if KZ7(GetManipulatedItem())==it_zhzg then
call XF7(WI7,'A2YN')
call SetPlayerAbilityAvailable(GetOwningPlayer(WI7),'A2YN',false)
call UnitMakeAbilityPermanent(WI7,true,'A1VQ')
call UnitMakeAbilityPermanent(WI7,true,'A0IA')
call UnitMakeAbilityPermanent(WI7,true,'A2YM')
call UnitMakeAbilityPermanent(WI7,true,'AItc')
endif
if KZ7(GetManipulatedItem())==it_fls then
call XF7(WI7,'A4E5')
call SetPlayerAbilityAvailable(GetOwningPlayer(WI7),'A4E5',false)
call UnitMakeAbilityPermanent(WI7,true,'A2NH')
call UnitMakeAbilityPermanent(WI7,true,'A096')
call UnitMakeAbilityPermanent(WI7,true,'A2KW')
call UnitMakeAbilityPermanent(WI7,true,'A09X')
endif
//if KZ7(GetManipulatedItem())==U3 then
//call XF7(WI7,'A2XC')
//if IsUnitType(WI7,UNIT_TYPE_MELEE_ATTACKER)==true then
