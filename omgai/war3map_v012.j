function OZJYWMN takes nothing returns nothing
	local unit ZX7 = GetTriggerUnit()
	local unit IH7 = GetSpellTargetUnit()
	local group g = null
	local unit u2 = null
local integer BC7=B287_GetUnitAbilityLevel(ZX7,'Acdh')
local integer level=BC7-1+'A3PR'
	if WQ7(IH7) then
		set ZX7 = null
		set IH7 = null
		return
	endif
	call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\StrongDrink\\BrewmasterMissile.mdl", IH7, "origin"))
	set g = WS7()
	set IN4=ZX7
call GroupEnumUnitsInRange(g,GetUnitX(IH7),GetUnitY(IH7),400,Condition(function AR7_gai))
	loop
		set u2 = FirstOfGroup(g)
	exitwhen u2 == null
		call GroupRemoveUnit(g, u2)
call Z57(u2,level,1,5.,'BNdh')
call SaveInteger(L7,GetHandleId(u2),StringHash("BrewmasterCinderLevel"),BC7)
call SaveUnitHandle(L7,GetHandleId(u2),StringHash("BrewmasterCinderCaster"),ZX7)
call SaveReal(L7,GetHandleId(u2),StringHash("BrewmasterCinderExpire"),TimerGetElapsed(W)+5.)
call BrewmasterCinderBrew_StartCleanup(u2)
	endloop
call BrewmasterBrawler_SetBrewed(ZX7,5.)
	call WR7(g)
    call LINGXIA(ZX7,IH7)
	set g=null
set u2=null
	set ZX7 = null
	set IH7 = null
endfunction
