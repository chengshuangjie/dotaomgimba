//不需要卷轴时XAO为false，需要卷轴时为true
function XIO takes integer id, boolean XAO returns integer
	local integer i = 0
    //call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "|c00FF8000ITDM的id是|r"+I2S(id))
	loop
		if(XAO == false and FP4[i]== LoadInteger(TABLE_HY,'ITDB', id)) or(XAO and(FJ4[i]== id or FK4[i]== id or FM4[i]== id or FN4[i]== id or FO4[i]== id)) then
			return i
		endif
		set i = i + 1
	exitwhen i > FQ4
	endloop
	return -1
endfunction
function CHOUJIANG takes nothing returns nothing
local unit u=M7[GetPlayerId(GetOwningPlayer(GetTriggerUnit()))]
local player p=GetOwningPlayer(u)
local integer id=GetPlayerId(p)
local item it
local integer zb
local string name
local integer n=0
local integer CGDIFF=IMaxBJ(XM_EXP,XM_GOLD)
local integer CJ1
local integer CJ2
local integer array zb1
local integer array zb2
local integer array zb3
set zb1[1]=ZU[FV]
set zb1[2]=ZU[JV]
set zb1[3]=ZU[R11]
set zb1[4]=ZU[C3]
set zb1[5]=ZU[Z3]
set zb1[6]=ZU[A6]
set zb1[7]=ZU[DL]
set zb1[8]=ZU[HL]
set zb1[9]=ZU[DT4]
set zb1[10]=ZU[SV]
set zb1[11]=ZU[UV]
set zb1[12]=ZU[RX]
set zb1[13]=ZU[OV]
set zb1[14]=ZU[MV]
set zb1[15]=ZU[HY]
set zb1[16]=20000
set zb2[1]=ZU[LV]
set zb2[2]=ZU[UY]
set zb2[3]=ZU[UW]
set zb2[4]=ZU[NV]
set zb2[5]=ZU[ZA]
set zb2[6]=ZU[EZ]
set zb2[7]=ZU[BA]
set zb2[8]=ZU[AX]
set zb2[9]=ZU[GY]
set zb2[10]=ZU[ZY]
set zb2[11]=ZU[E_4]
set zb2[12]=ZU[EH4]
set zb2[13]=ZU[R35]
set zb2[14]=10000
set zb3[1]=ZU[TC]
set zb3[2]=ZU[EZY]
set zb3[3]=ZU[OC]
set zb3[4]=ZU[QC]
set zb3[5]=ZU[WC]
set zb3[6]=ZU[XC]
set zb3[7]=ZU[H3]
set zb3[8]=ZU[QW]
set zb3[9]=ZU[R02]
set zb3[10]=5000
set CJ1=5+CGDIFF*2
set CJ2=10+CGDIFF*3
if GetRandomInt(1,100)<=CJ1 then
    set zb=zb1[GetRandomInt(1,16)]
elseif GetRandomInt(1,100)<=CJ2 then
    set zb=zb2[GetRandomInt(1,14)]
else
    set zb=zb3[GetRandomInt(1,10)]
endif
if zb==5000 then
    set n=GetRandomInt(50,80)
elseif zb==10000 then
    set n=GetRandomInt(100,130)
elseif zb==20000 then
    set n=GetRandomInt(200,240)
endif
if n==0 then
    if UnitInventoryCount(u)<6 then
        set it=UnitAddItemById(u,zb)
    else
        set it=CreateItem(zb, GetUnitX(u), GetUnitY(u))
    endif
    call SetItemPlayer(it,p,true)
    call SetItemUserData(it,1)
    if zb==zb3[1] then
    call SetItemCharges(it,4)
    endif
    set name=GetItemName(it)
    set name=MHString_Sub(name , 0 , MHString_Find(name , "|n" , 0))
    call DisplayTimedTextToForce(GetPlayersAll(), 12.00, Q[id]+KZ4[id]+"|r 抽奖获得了: |cFF00FF00"+name+"|r")
else
    call SetPlayerState(p, PLAYER_STATE_RESOURCE_GOLD, GetPlayerState(p, PLAYER_STATE_RESOURCE_GOLD)+n)
    call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Transmute\\PileofGold.mdl",GetUnitX(u),GetUnitY(u)))
    call DisplayTimedTextToForce(GetPlayersAll(), 12.00, Q[id]+KZ4[id]+"|r 抽奖获得了: |cFF00FF00"+I2S(n)+"枚金币|r")
endif
set CHOUJIANGSTATE[GetPlayerId(p)]=0
call UnitRemoveAbility(SuijiTavernB295_GetEnergyCircle(GetPlayerId(p)),'A4DK')
set u=null
set p=null
set it=null
endfunction
function ZRF takes nothing returns nothing
local unit u=GetSoldUnit()
local player p=GetOwningPlayer(u)
local integer Y68=WD7(u)
local real x
local real y
local integer id=GetUnitTypeId(u)
local integer i
local integer O5=GetPlayerId(p)
//GetSoldUnit 哪个物品
//GetSellingUnit 哪个商店
//GetSoldUnit 哪个物品
//GetSellingUnit 哪个商店
//GetSoldUnit 哪个物品
//GetSellingUnit 哪个商店
if ZIF(GetSellingUnit(),u)then
call X37(p,GetObjectName('n02G'))
if IsUnitAlly(u,Z7[0])then
set p=A7[0]
else
set p=Z7[0]
endif
set x=ZPF(GetSellingUnit(),u)
set y=ZQF(GetSellingUnit(),u)
call X0F(SU[WD7(u)],x,y,p,true,Z98(WD7(u)))
elseif id=='h0F4' then
call CHIA_JUDGMENT(p)
elseif id=='h0F5' then
call CHIBS_JUDGMENT(p)
elseif id=='h0F6' then
call CHILLX_JUDGMENT(p)
elseif id=='h0F8' or id=='h0F9' then
call Download(p)
elseif id=='h0FK' then
call CHANGE_PIFU(p,0)
elseif id=='h0FB' then
call CHANGE_PIFU(p,1)
elseif id=='h0FC' then
call CHANGE_PIFU(p,2)
elseif id=='h0FD' then
call CHANGE_PIFU(p,3)
elseif id=='h0FE' then
call CHANGE_PIFU(p,4)
elseif id=='h0FF' then
call CHANGE_PIFU(p,5)
elseif id=='h0FG' then
call CHANGE_PIFU(p,6)
//elseif id=='h0FH' then
//call CHANGE_PIFU(p,3,1)
//elseif id=='h0FI' then
//call CHANGE_PIFU(p,3,2)
//elseif id=='h0FJ' then
//call CHANGE_PIFU(p,3,3)
//elseif id=='h0FH' then
//call CHANGE_PIFU(p,3,1)
//elseif id=='h0FI' then
//call CHANGE_PIFU(p,3,2)
//elseif id=='h0FJ' then
//call CHANGE_PIFU(p,3,3)
//elseif id=='h0FH' then
//call CHANGE_PIFU(p,3,1)
//elseif id=='h0FI' then
//call CHANGE_PIFU(p,3,2)
//elseif id=='h0FJ' then
//call CHANGE_PIFU(p,3,3)
else
call ZHF(p,Y38(Y68))
if ZU[Y68]==0 then
set i = XIO(Y68, false)
if i ==-1 then
call X37(p,GetObjectName('n02H'))
else
    set eH=GetSellingUnit()
    //call XOO(YLF(u,0), i, p)  //没有卷轴的直接购买成品
    call XOO(M7[GetPlayerId(p)], i, p)
endif
else
set x=ZMF(GetSellingUnit(),u)
set y=ZOF(GetSellingUnit(),u)
if Y68==CC then
call Y0F(p,u,GetSellingUnit(),Y38(Y68),x,y,2,0)
else
call Y0F(p,u,GetSellingUnit(),Y38(Y68),x,y,0,0)
endif
endif
endif
call UnitAddAbility(u,'Aloc')
call ShowUnit(u,true)
call UnitApplyTimedLife(u,'BTLF',2)
if ZU[Y68]!= 0 then
	if IsUnitType(M7[GetPlayerId(p)],UNIT_TYPE_RANGED_ATTACKER) then
	if Y68==BA then
		set Y68=GB
	elseif Y68==E_4 then
		set Y68=F44
	elseif Y68==EZ then
		set Y68=HZ
	endif
	endif
    if Y68==XZ then
        set Y68=IA
    endif
		// call SaveInteger(TABLE_P,'ITEM', GetPlayerId(p), ZU[Y68])
		// call SaveReal(TABLE_P,'ITEM', GetPlayerId(p), GetGameTime())
		// call SaveInteger(TABLE_P,'ITEM', GetPlayerId(p), ZU[Y68])
		// call SaveReal(TABLE_P,'ITEM', GetPlayerId(p), GetGameTime())
		// call SaveInteger(TABLE_P,'ITEM', GetPlayerId(p), ZU[Y68])
		// call SaveReal(TABLE_P,'ITEM', GetPlayerId(p), GetGameTime())
		call Record_Buy_Item(p,O5,Y68)
endif
set u=null
set p=null
endfunction
function ZSF takes nothing returns boolean
if VI4==false then
if GetUnitPointValue(GetSoldUnit())>=$C8 then
call ZRF()
if IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(GetSoldUnit()))or(V8 and(GetLocalPlayer()==KX4 or GetLocalPlayer()==KY4))then
if GetUnitTypeId(GetSoldUnit())=='h076' then
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,4,Q[GetPlayerId(GetOwningPlayer(GetSoldUnit()))]+KZ4[GetPlayerId(GetOwningPlayer(GetSoldUnit()))]+"|r |c00ffff00"+GetObjectName('n0KO')+"|r")
elseif GetUnitTypeId(GetSoldUnit())=='h02C' then
call PingMinimapEx(GetUnitX(GetSoldUnit()),GetUnitY(GetSoldUnit()),3,$FF,$FF,$FF,false)
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,4,Q[GetPlayerId(GetOwningPlayer(GetSoldUnit()))]+KZ4[GetPlayerId(GetOwningPlayer(GetSoldUnit()))]+"|r |c00ffff00"+GetObjectName('n0KP')+"|r")
elseif GetUnitTypeId(GetSoldUnit())=='h02D' then
call PingMinimapEx(GetUnitX(GetSoldUnit()),GetUnitY(GetSoldUnit()),3,$FF,$FF,$FF,false)
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,4,Q[GetPlayerId(GetOwningPlayer(GetSoldUnit()))]+KZ4[GetPlayerId(GetOwningPlayer(GetSoldUnit()))]+"|r |c00ffff00"+GetObjectName('n0KQ')+"|r")
elseif GetUnitTypeId(GetSoldUnit())=='h0BA' then
call PingMinimapEx(GetUnitX(GetSoldUnit()),GetUnitY(GetSoldUnit()),3,$FF,$FF,$FF,false)
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,4,Q[GetPlayerId(GetOwningPlayer(GetSoldUnit()))]+KZ4[GetPlayerId(GetOwningPlayer(GetSoldUnit()))]+"|r |c00ffff00"+GetObjectName('n0KT')+"|r")
elseif GetUnitTypeId(GetSoldUnit())=='h0G4' then
call PingMinimapEx(GetUnitX(GetSoldUnit()),GetUnitY(GetSoldUnit()),3,$FF,$FF,$FF,false)
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,4,Q[GetPlayerId(GetOwningPlayer(GetSoldUnit()))]+(KZ4[GetPlayerId((GetOwningPlayer(GetSoldUnit())))])+"|r |c00ffff00购买了魂之灵龛|r")
elseif GetUnitTypeId(GetSoldUnit())=='h01G' then
call PingMinimapEx(GetUnitX(GetSoldUnit()),GetUnitY(GetSoldUnit()),3,$FF,$FF,$FF,false)
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,4,Q[GetPlayerId(GetOwningPlayer(GetSoldUnit()))]+KZ4[GetPlayerId(GetOwningPlayer(GetSoldUnit()))]+"|r |c00ffff00"+GetObjectName('n0LB')+"|r")
elseif GetUnitTypeId(GetSoldUnit())=='h0D3' then
call PingMinimapEx(GetUnitX(GetSoldUnit()),GetUnitY(GetSoldUnit()),3,$FF,$FF,$FF,false)
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,4,Q[GetPlayerId(GetOwningPlayer(GetSoldUnit()))]+KZ4[GetPlayerId(GetOwningPlayer(GetSoldUnit()))]+"|r |c00ffff00"+GetObjectName('n0LP')+"|r")
endif
endif
else
call YXF()
endif
endif
return false
endfunction
function ZTF takes unit u returns boolean
local integer id=GetUnitTypeId(u)
return id=='Eevm' or id=='E02V' or id=='E02W' or id=='E02U'
endfunction
