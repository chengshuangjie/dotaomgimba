function QVD takes nothing returns boolean
return B287_GetSpellAbilityId()=='A0E2' or B287_GetSpellAbilityId()=='A1MR'
endfunction
function QWD takes nothing returns nothing
local unit WI7=GetTriggerUnit()
local unit IH7=GetSpellTargetUnit()
local real PLD=GetUnitState(IH7,UNIT_STATE_LIFE)
local integer BC7=B287_GetUnitAbilityLevel(WI7,'A0E2')
local unit BB7
local boolean QXD=false
local group g
local integer U43=250
local integer U53=325
local integer U63=400
local integer id=GetUnitTypeId(WI7)
local string tx
local string tx2
if id=='Zpgh' then
    set tx="model\\Hero_Axe_N9S_C_Target.mdl"
    set tx2="model\\Hero_Axe_N9S_C_Source.mdl"
elseif id=='Zpgi' then
    set tx="model\\Hero_Axe_N4S_C_Target.mdl"
    set tx2="model\\Hero_Axe_N4S_C_Source.mdl"
elseif id=='Zpgj' then
    set tx="AZModel\\AZ_AxeCold_C2.mdl"
    set tx2="AZModel\\AZ_AxeCold_C1.mdl"
else
    set tx="Abilities\\Weapons\\PhoenixMissile\\Phoenix_Missile.mdl"
    set tx2="war3mapImported\\AxeUltiMSFX_01.mdx"
endif
set R34=6
if BC7==0 then
set BC7=B287_GetUnitAbilityLevel(WI7,'A1MR')
    set QXD=true
    set U43=375
    set U53=500
    set U63=625
    set R34=10
endif
if(PLD<=U43 and BC7==1)or(PLD<=U53 and BC7==2)or(PLD<=U63 and BC7==3)then
else
    call LINGXIA(WI7,IH7)
endif
set PLD=GetUnitState(IH7,UNIT_STATE_LIFE)
if UnitAlive(IH7) and ((PLD<=U43 and BC7==1)or(PLD<=U53 and BC7==2)or(PLD<=U63 and BC7==3))then
    if IsUnitType(IH7,UNIT_TYPE_HERO)then
        if QXD then
call B287_UnitRemoveAbility(WI7,'A1MR')
call B287_UnitAddAbility(WI7,'A1MR')
call B287_SetUnitAbilityLevel(WI7,'A1MR',BC7)
        else
call B287_UnitRemoveAbility(WI7,'A0E2')
call B287_UnitAddAbility(WI7,'A0E2')
call B287_SetUnitAbilityLevel(WI7,'A0E2',BC7)
        endif
    endif
    call PlaySoundOnUnitBJ(YN,100,IH7)
    call YW7("斩杀!!!",4,WI7,.04,$FF,$FF,0,$FF)
    call DestroyEffect(AddSpecialEffectTarget(tx,IH7,"overhead"))
set BB7=CreateUnit(GetOwningPlayer(WI7),'e00E',0,0,0)
    call UnitRemoveBuffs(IH7,true,true)
call UnitRemoveAbility(IH7,'Aetl')
    call UnitDamageTarget(BB7,IH7,100000000.,true,false,ATTACK_TYPE_MELEE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
call UnitApplyTimedLife(BB7,'BTLF',1.)
    call DestroyEffect(AddSpecialEffectTarget(tx2,WI7,"origin"))
    call Add_EX_PlayerDamage(WI7,IH7,R2I(PLD))
    set g=WS7()
    call GroupEnumUnitsInRange(g,GetUnitX(WI7),GetUnitY(WI7),925,Condition(function B97))
    set U22=WI7
    call ForGroup(g,function QUD)
    call WR7(g)
    set g=null
endif
set WI7=null
set IH7=null
set BB7=null
endfunction
function G_8 takes nothing returns nothing
local trigger t=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function QVD))
call TriggerAddAction(t,function QWD)
set t=null
endfunction
function SuijiMode_ClearRhastaShackleResidue takes unit suijiRhastaShackleTarget returns nothing
if suijiRhastaShackleTarget==null then
return
endif
call UnitRemoveAbility(suijiRhastaShackleTarget,'B02F')
call UnitRemoveAbility(suijiRhastaShackleTarget,'BUsp')
call UnitRemoveAbility(suijiRhastaShackleTarget,'Bust')
call UnitRemoveAbility(suijiRhastaShackleTarget,'A2O9')
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(suijiRhastaShackleTarget),'A04Y',true)
call SetPlayerAbilityAvailable(GetOwningPlayer(suijiRhastaShackleTarget),'A2O9',false)
call SaveInteger(L7,GetHandleId(suijiRhastaShackleTarget),791,0)
endfunction
function QAD takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit m5=O77(OB7,"Target")
local unit p5=O77(OB7,"Source")
local player p=O97(OB7,"p")
local integer V77=OM7(OB7,"Level")
local unit oA
local boolean suijiRhastaShackleActive=LoadInteger(L7,GetHandleId(m5),791)==OB7
if GetUnitAbilityLevel(m5,'B02F')==0 then
if suijiRhastaShackleActive then
call SuijiMode_ClearRhastaShackleResidue(m5)
endif
call NM7(OB7)
call OZ7(t)
elseif GetTriggerEventId()==EVENT_UNIT_SPELL_ENDCAST then
if suijiRhastaShackleActive then
call SuijiMode_ClearRhastaShackleResidue(m5)
endif
call NM7(OB7)
call OZ7(t)
elseif GetTriggerEventId()==EVENT_UNIT_ATTACKED and GetTriggerUnit()==m5 then
if suijiRhastaShackleActive then
call SuijiMode_ClearRhastaShackleResidue(m5)
endif
if((IsUnitType(GetAttacker(),UNIT_TYPE_HERO))and(GetPlayerController(GetOwningPlayer(GetAttacker()))==MAP_CONTROL_COMPUTER))then
call IssuePointOrderById(GetAttacker(),$D0012,GetUnitX(GetAttacker())+GetRandomReal(0,150.)-75.,GetUnitY(GetAttacker())+GetRandomReal(0,150.)-75.)
else
set oA=CreateUnit(p,'e00E',GetUnitX(m5),GetUnitY(m5),0)
call XF7(oA,'A04Y')
call B287_SetUnitAbilityLevel(oA,'A04Y',V77)
call IssueTargetOrderById(oA,$D0103,GetAttacker())
call UnitApplyTimedLife(oA,'BTLF',2.)
call NM7(OB7)
call OZ7(t)
endif
elseif GetTriggerEventId()!=EVENT_UNIT_ATTACKED then
if GetUnitState(m5,UNIT_STATE_LIFE)>21 then
call SetUnitState(m5,UNIT_STATE_LIFE,GetUnitState(m5,UNIT_STATE_LIFE)-20)
else
if suijiRhastaShackleActive then
call SuijiMode_ClearRhastaShackleResidue(m5)
endif
call B67(p5,m5,1,50)
call NM7(OB7)
call OZ7(t)
endif
endif
set t=null
set p=null
set oA=null
set m5=null
set p5=null
return false
endfunction
function QBD takes nothing returns nothing
local unit p5=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
set OB7=GetHandleId(t)
call NT7(OB7,"Target",m5)
call NT7(OB7,"Source",p5)
call NZ7(OB7,"p",GetOwningPlayer(p5))
call NP7(OB7,"Level",B287_GetUnitAbilityLevel(p5,'A04Y'))
call SaveInteger(L7,GetHandleId(m5),791,OB7)
call TriggerRegisterUnitEvent(t,m5,EVENT_UNIT_ATTACKED)
call TriggerRegisterUnitEvent(t,p5,EVENT_UNIT_SPELL_ENDCAST)
call TriggerRegisterTimerEvent(t,1,true)
call TriggerAddCondition(t,Condition(function QAD))
if B287_GetUnitAbilityLevel(m5,'A04Y')>0 then
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(m5),'A04Y',false)
call XF7(m5,'A2O9')
call SetPlayerAbilityAvailable(GetOwningPlayer(m5),'A2O9',true)
endif
set V14=true
call B67(p5,m5,2,0)
set V14=false
set p5=null
set m5=null
set t=null
endfunction
function QCD takes nothing returns boolean
if B287_GetSpellAbilityId()=='A04Y' and ((KW7(GetSpellTargetUnit())==false and IsUnitAlly(GetSpellTargetUnit(),GetOwningPlayer(GetTriggerUnit()))) or WQ7(GetSpellTargetUnit())==false) then
call QBD()
endif
return false
endfunction
