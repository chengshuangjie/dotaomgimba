function I7G takes nothing returns nothing
local integer T8=0
local integer U8=5
local integer array I8G
local player array I9G
local integer Y68
local item Z4
local unit u=GetTriggerUnit()
local player p
local integer newitem
local integer skill=B287_GetSpellAbilityId()
local real d
local real cooldown
set I8G[0]=0
set I8G[1]=0
set I8G[2]=0
set I8G[3]=0
set I8G[4]=0
set I8G[5]=0
call DisableTrigger(H94)
call SaveReal(L7,(GetHandleId(u)),(785),(((TimerGetElapsed(W)-10.))*1.))
loop
exitwhen T8>U8
set Y68=KZ7(UnitItemInSlot(u,T8))
if Y68==D0 or Y68==E0 or Y68==J0 or Y68==N0 or Y68==O0 or Y68==R0 or Y68==J1 or Y68==R5 or Y68==S5 or Y68==it_silingshu3 or Y68==S6 or Y68==it_shuaxin or Y68==DD4 or Y68==F74 then
set I8G[T8]=GetItemTypeId(UnitItemInSlot(u,T8))
set I9G[T8]=GetItemPlayer(UnitItemInSlot(u,T8))
call RemoveItem(UnitItemInSlot(u,T8))
endif



if Y68==TW or Y68==it_sgban or Y68==it_xjsgban or Y68==it_sssgban then
    if Y68==TW then
        set newitem=RW
    elseif Y68==it_sgban then
        set newitem=it_sg
    elseif Y68==it_xjsgban then
        set newitem=it_xjsg
    elseif Y68==it_sssgban then
        set newitem=it_sssg
    endif
    set Z4=UnitItemInSlot(u,T8)
    set p=GetItemPlayer(Z4)
    call RemoveItem(Z4)
    set HA4=AY8(u,ZU[newitem],T8)
    call SetItemPlayer(HA4,p,false)
    call SetItemUserData(HA4,1)
    call DisableTrigger(H94)
endif



set T8=T8+1
endloop
call UnitResetCooldown(u)
set T8=0
set U8=5
loop
exitwhen T8>U8
if I8G[T8]>0 then
set Z4=CreateItem(I8G[T8],0,0)
call SetItemPlayer(Z4,I9G[T8],false)
call SetItemUserData(Z4,1)
call UnitAddItem(u,Z4)
set I9G[T8]=null
endif
set T8=T8+1
endloop
call EnableTrigger(H94)
call SaveInteger(TABLE_HY, GetHandleId(u), 'LXCD', 0)
call SaveReal(TABLE_HY, GetHandleId(u), 'link', 0)
if skill=='A4L1' then
    set cooldown=24-GetUnitAbilityLevel(u,'A4L1')*4
    set d=ReduceUnitAbilityCoolDownReal(u)
    if d>0 then
        set cooldown=cooldown*d
    endif
    call Japi_ReduceUnitAbilityCoolDown(u,'A4L1',cooldown)
endif
set Z4=null
set p=null
endfunction
