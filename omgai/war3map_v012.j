function GWQ takes nothing returns nothing
    local unit suijiBloodseekerCaster = U22
	local unit WLE = W22
    local integer h=GetHandleId(suijiBloodseekerCaster)
    local integer level=LoadInteger(TABLE_P, h,'A005')
    local real ZCE = .0
	call CommonUnitAddStun(WLE, 0.01, false)
	set ZCE = level*75+25
	call B67(suijiBloodseekerCaster, WLE, 1, ZCE)
    call LINGXIA(suijiBloodseekerCaster,WLE)
    call RemoveSavedInteger(TABLE_P, h,'A005')
    set suijiBloodseekerCaster=null
    set WLE=null
endfunction
function GWR takes nothing returns nothing
	local unit ZX7 = U22
	local unit IH7 = W22
	local group g
	local group g2
	local unit u
	local real ZCE = .0
	local integer level
	local integer h
    local integer times
    local integer max
	if LoadUnitHandle(TABLE_P, GetHandleId(ZX7),'A004'+ 1)!= null then
		set ZX7 = LoadUnitHandle(TABLE_P, GetHandleId(ZX7),'A004'+ 1)
		call RemoveSavedHandle(TABLE_P, GetHandleId(U22),'A004'+ 1)
	endif
	set h = GetHandleId(ZX7)
	set g = LoadGroupHandle(TABLE_P, h,'A004')
	set level = LoadInteger(TABLE_P, h,'A005')
    set times = LoadInteger(TABLE_P, h, 20)
    set max = LoadInteger(TABLE_P, h, 30)
	call CommonUnitAddStun(IH7, 0.01, false)
	call GroupAddUnit(g, IH7)
	set ZCE = level*75+25
	call B67(ZX7, IH7, 1, ZCE)
    if times==max then
        call LINGXIA(ZX7,IH7)
    endif



    if times >0 then
		set g2 = WS7()
        set U22=ZX7
		call GroupEnumUnitsInRange(g2, GetUnitX(IH7), GetUnitY(IH7), 400, Condition(function DKX))
		call GroupRemoveGroup(g, g2)
		set u=GroupPickRandomUnit(g2)
		if u!= null then
			call NHX_TANSHE(ZX7,IH7, u,'h0GH', "GWR", 1000, true, "")
			call SaveUnitHandle(TABLE_P, GetHandleId(IH7),'A004'+ 1, ZX7)
            call SaveInteger(TABLE_P, h,20, times -1)
		else
			call WR7(g)
			call RemoveSavedHandle(TABLE_P, h,'A004')
			call RemoveSavedInteger(TABLE_P, h,'A005')
            call RemoveSavedInteger(TABLE_P, h,20)
		endif
		call WR7(g2)
		set g2 = null
    endif
	set ZX7 = null
	set IH7 = null
	set u = null
	set g = null
endfunction
function TSFB3 takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local unit IH7=GetSpellTargetUnit()
    if SuijiMode_HasAghanimState(ZX7) then
		call NHX(ZX7, IH7,'h0GH', "GWR", 1000, true, "")
		if LoadGroupHandle(TABLE_P, GetHandleId(ZX7),'A004')!=null then
			call WR7(LoadGroupHandle(TABLE_P, GetHandleId(ZX7),'A004'))
		endif
		call SaveGroupHandle(TABLE_P, GetHandleId(ZX7),'A004', WS7())
		call SaveInteger(TABLE_P, GetHandleId(ZX7),'A005', B287_GetUnitAbilityLevel(ZX7,'A004'))
        call SaveInteger(TABLE_P, GetHandleId(ZX7),20, 3)
        call SaveInteger(TABLE_P, GetHandleId(ZX7),30, 3)
    else
        call NHX(ZX7, IH7,'h0GH', "GWQ", 1000, true, "")
        call SaveInteger(TABLE_P, GetHandleId(ZX7),'A005', B287_GetUnitAbilityLevel(ZX7,'A004'))
    endif
set ZX7=null
set IH7=null
endfunction
function TSFB2 takes nothing returns boolean
if B287_GetSpellAbilityId()=='A004' and WQ7(GetSpellTargetUnit())==false then
call TSFB3()
endif
return false
endfunction
