    call SetUnitAbilityLevel(p5,skill,V77)
    call DGBD(p5,m5)
else
    call X377(GetOwningPlayer(p5),"无可用次数")
endif
if N5E==0 then
    set WF8=(LoadReal(MSK,(OB7),(50)))
    if WF8>0 then
        call Japi_ReduceUnitAbilityCoolDown(p5,skill,WF8)
        call TimerStart(N84[GetPlayerId(GetOwningPlayer(p5))],WF8,false,null)
    endif
endif
set p5=null
set m5=null
set t=null
endfunction
