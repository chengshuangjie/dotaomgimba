//斗转星移
function V3G takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local unit IH7=GetSpellTargetUnit()
local integer HaveA
local integer VTG=(LoadInteger(L7,(GetHandleId(IH7)),(705)))
local integer skill=B287_GetSpellAbilityId()
local integer id=GetUnitTypeId(ZX7)
local string tx
if id=='Z02X' then
    set tx="model\\Hero_GrandMagus_N1S_Q_Missile.mdl"
else
    set tx="war3mapImported\\Nebula.mdx"
endif
if VTG!=0 then
set VTG=SuijiMode_NormalizeRecordedSkill(VTG)
call DestroyEffect(AddSpecialEffectTarget(tx,IH7,"origin"))
set HaveA=RX5(VTG)
if HaveA!=-1 then
if skill=='A27H' then
set VTG=YTI[HaveA]
else
set VTG=YRI[HaveA]
endif
endif
if VTG=='A065' then
    set VTG='A4L1'
endif
if XSID then
call DisplayTextToPlayer(GetOwningPlayer(ZX7),0,0, "窃取技能ID："+I2S(VTG))
endif
call VBG(ZX7,IH7,VTG,(LoadInteger(L7,(GetHandleId(IH7)),(712))))
endif
call LINGXIA(ZX7,IH7)
set ZX7=null
set IH7=null
endfunction
