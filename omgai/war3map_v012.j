call SaveReal(L7,(I97),(7),((GetSpellTargetY())*1.))
call SaveReal(L7,(I97),($BF),((GetUnitX(ZX7))*1.))
call SaveReal(L7,(I97),($C0),((GetUnitY(ZX7))*1.))
