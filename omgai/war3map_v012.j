call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function ZCSZQHTT2))
set t=null
endfunction
function SuijiMode_EarthshakerFissureEnemyFilter takes nothing returns boolean
return SuijiFissureEffectCaster!=null and IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(SuijiFissureEffectCaster)) and AU7()
endfunction
function SuijiMode_EarthshakerFissureEffect takes unit WI7,real hN,real ho returns nothing
local integer i=1
local real iN=GetUnitX(WI7)
local real io=GetUnitY(WI7)
local real x
local real y
local real a
local group g=WS7()
local group g2=WS7()
local integer length
local integer ZZMF_level=GetUnitAbilityLevel(WI7,'A4DJ')+GetUnitAbilityLevel(WI7,'A4DZ')
local integer ZZMF=0
local integer id=GetUnitTypeId(WI7)
local integer skill
local string skilltx=""
local integer randomtx=0
local integer fissureLevel=B287_GetUnitAbilityLevel(WI7,'A0SK')
local real fissureDamage=fissureLevel*50+60
local unit fissureTarget=null
local unit fissureDummy=null
local boolexpr fissureFilter=Condition(function SuijiMode_EarthshakerFissureEnemyFilter)
if id=='Z02X' then
    set randomtx=GetRandomInt(1,3)
endif
if id=='Ztch' or randomtx==1 then
    set skill='B00B'
    set skilltx="model\\Hero_EarthShaker_N3S_F_smoke.mdl"
elseif id=='Zuch' or randomtx==2 then
    set skill='B00C'
    set skilltx="model\\Hero_EarthShaker_N7S_F_smoke.mdl"
elseif id=='Zvch' or randomtx==3 then
    set skill='B00D'
else
    set skill='B000'
    set skilltx="Abilities\\Spells\\Other\\Volcano\\VolcanoDeath.mdl"
endif
if ZZMF_level==1 then
    set ZZMF=1
elseif ZZMF_level==2 or ZZMF_level==3 then
    set ZZMF=2
elseif ZZMF_level==4 then
    set ZZMF=3
endif
if GetUnitAbilityLevel(WI7,'A2YK')>0 or GetUnitAbilityLevel(WI7,'A2YJ')>0 then
set length=28+ZZMF
else
set length=25+ZZMF
endif
set a=bj_DEGTORAD*J77(iN,io,hN,ho)
set SuijiFissureEffectCaster=WI7
loop
exitwhen i>length
set x=X17(iN+i*60*Cos(a))
set y=X07(io+i*60*Sin(a))
call GroupEnumUnitsInRange(g2,x,y,$FA,fissureFilter)
call GroupAddGroup(g2,g)
call GroupClear(g2)
call ZN7(CreateDestructable(skill,x,y,GetRandomReal(0,360),.5,GetRandomInt(0,2)),8)
if id!='Zvch' and randomtx!=3 then
call DestroyEffect(AddSpecialEffect(skilltx,x,y))
endif
set i=i+1
endloop
loop
set fissureTarget=FirstOfGroup(g)
exitwhen fissureTarget==null
call GroupRemoveUnit(g,fissureTarget)
set fissureDummy=CreateUnit(GetOwningPlayer(WI7),'e00E',GetUnitX(fissureTarget),GetUnitY(fissureTarget),0)
call UnitApplyTimedLife(fissureDummy,'BTLF',2.)
call XF7(fissureDummy,'A0SJ')
call SetUnitAbilityLevel(fissureDummy,'A0SJ',fissureLevel)
call IssueTargetOrderById(fissureDummy,$D007F,fissureTarget)
call B67(WI7,fissureTarget,1,fissureDamage)
endloop
set SuijiFissureEffectCaster=null
call DestroyBoolExpr(fissureFilter)
call WR7(g)
call WR7(g2)
set WI7=null
set fissureTarget=null
set fissureDummy=null
set fissureFilter=null
set g=null
set g2=null
endfunction
function XQ9 takes nothing returns nothing
local unit WI7=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local location l=GetSpellTargetLoc()
local real hN=0.
local real ho=0.
if m5!=null then
set hN=GetUnitX(m5)
set ho=GetUnitY(m5)
else
set hN=GetLocationX(l)
set ho=GetLocationY(l)
endif
call SuijiMode_EarthshakerFissureEffect(WI7,hN,ho)
call RemoveLocation(l)
set WI7=null
set m5=null
set l=null
endfunction
