function AI_USE_TH_PD takes nothing returns nothing
local unit IH7=GetEnumUnit()
local integer I97=GetHandleId(IH7)
local integer O5=GetPlayerId(GetOwningPlayer(IH7))
    if IsUnitAlly(IH7,GetOwningPlayer(IN4)) and GetPlayerController(GetOwningPlayer(IH7))==MAP_CONTROL_COMPUTER  then
        if AI_SKILL_OK(IH7,'A29G') or AI_SKILL_OK(IH7,'A29H') then
            set GZ[O5]=true
            call J8(O5,N977(IH7,$D00C4,'A29G','A29H'))
        endif
        if AI_SKILL_OK(IH7,'A0H9') then
            call IssueImmediateOrderById(IH7,$D020A)
        endif
        if AI_SKILL_OK(IH7,'A0VG') and SuijiMode_HasAghanimState(IH7) then
if UG7(IH7,A_4,A_4,A_4,'A0VG') then
                call IssuePointOrderById(IH7,$D0079,GetUnitX(IH7),GetUnitY(IH7))
            endif
        endif
    endif
set IH7=null
endfunction
function AI_USE_TH_TRI takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer OB7=GetHandleId(t)
    local unit ZX7=O77(OB7,"Hero")
    local group g
    local integer n=OM7(OB7,"Counter")
    set n=n+1
    call NP7(OB7,"Counter",n)
    if n>20 then
        call PauseTimer(t)
        call FlushChildHashtable(L7,OB7)
        call DestroyTimer(t)
    elseif HMRS>0 then
        set g=WS7()
        call GroupAddGroup(PlayerUnitGroup,g)
        set IN4=ZX7
        call ForGroup(g,function AI_USE_TH_PD)
        call WR7(g)
        call PauseTimer(t)
        call FlushChildHashtable(L7,OB7)
        call DestroyTimer(t)
    endif
    set ZX7=null
    set g=null
    set t=null
endfunction
function AI_USE_TH takes unit ZX7 returns nothing
    local timer t=CreateTimer()
    local integer OB7=GetHandleId(t)
    call NT7(OB7,"Hero",ZX7)
    call NP7(OB7,"Counter",0)
    call TimerStart(t,.1,true,function AI_USE_TH_TRI)
    set t=null
endfunction
function SuijiMode_TideRavageMulticastCount takes unit u returns integer
local integer h=0
local integer r=1
if SUIJI_MODE==false or u==null or GetUnitTypeId(u)==0 or UnitAlive(u)==false then
return 1
endif
set h=GetHandleId(u)
if B287_GetUnitAbilityLevel(u,'A088')<=0 then
return 1
endif
if GetUnitTypeId(u)!='Hmkg' and SuijiMode_GetStableHeroIndex(u)!=18 and (OO7(h,"SuijiDone")==false or OO7(h,"SuijiMulticast")==false) then
return 1
endif
if OO7(h,"SuijiMulticastCasting") or ON7(h,"SuijiMulticastBlockUntil")>TimerGetElapsed(W) then
