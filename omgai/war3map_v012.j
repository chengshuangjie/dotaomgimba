set y=GetUnitY(VPE)+r*Sin(a*bj_DEGTORAD)
call SetUnitX(VPE,x)
call SetUnitY(VPE,y)
if BlockUnitPass(VPE) then
    call KillUnit(VPE)
    call ShowUnit(VPE,false)
    call DestroyEffect(AddSpecialEffect("war3mapImported\\Firaga_2.mdx",x,y))
    call FlushChildHashtable(L7,(I97))
    call OZ7(t)
elseif KF7(x,y,Y_7,Z47)<r*2 then
    call VNE(ZX7,VPE,D3E,BB7,IH7)
    call FlushChildHashtable(L7,(I97))
    call OZ7(t)
endif
set t=null
set ZX7=null
set IH7=null
set VPE=null
set BB7=null
return false
endfunction
function VQE takes unit ZX7,unit VPE,unit IH7,real D3E,unit BB7 returns nothing
local trigger t
local integer I97
if ZX7==IH7 then
call KillUnit(VPE)
call ShowUnit(VPE,false)
else
set t=CreateTrigger()
set I97=GetHandleId(t)
call SetUnitVertexColor(VPE,$FF,$FF,$FF,$FF)
call TriggerRegisterTimerEvent(t,.02,true)
call TriggerRegisterUnitEvent(t,ZX7,EVENT_UNIT_SPELL_EFFECT)
call TriggerRegisterUnitEvent(t,IH7,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function VOE))
call SaveUnitHandle(L7,(I97),(2),(ZX7))
call SaveUnitHandle(L7,(I97),(17),(IH7))
call SaveUnitHandle(L7,(I97),(393),(VPE))
call SaveReal(L7,(I97),(47),((GetSpellTargetX())*1.))
call SaveReal(L7,(I97),(48),((GetSpellTargetY())*1.))
call SaveReal(L7,(I97),(685),((D3E)*1.))
call SaveUnitHandle(L7,(I97),(19),(BB7))
endif
set t=null
endfunction
function VRE takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local integer WF8=(LoadInteger(L7,(I97),(34)))
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local real AQ9=GetUnitX(ZX7)
local real AR9=GetUnitY(ZX7)
local unit VSE=(LoadUnitHandle(L7,(I97),(393)))
local unit VTE=(LoadUnitHandle(L7,(I97),(394)))
local unit VUE=(LoadUnitHandle(L7,(I97),(395)))
local unit VVE=(LoadUnitHandle(L7,(I97),(396)))
local integer BC7=GetUnitAbilityLevel(ZX7,'A1YX')
local real a=GetUnitFacing(ZX7)
local real x
local real y
local real D4D=-1*360*.02/4
local real a2
local real P59
local real D3E=(LoadReal(L7,(I97),(685)))
local real VWE
local unit BB7=(LoadUnitHandle(L7,(I97),(19)))
local integer VXE=GetHandleId(ZX7)
local player pl=GetOwningPlayer(ZX7)
local integer VYE=800
local boolean HaveA=(LoadBoolean(L7,(I97),(99)))
if GetTriggerEventId()==EVENT_UNIT_SPELL_EFFECT then
if B287_GetSpellAbilityId()=='A1Z2' then
if XH7(VSE)==false then
call VQE(ZX7,VSE,GetSpellTargetUnit(),D3E,BB7)
call RemoveSavedHandle(L7,(I97),(393))
elseif XH7(VTE)==false then
call VQE(ZX7,VTE,GetSpellTargetUnit(),D3E,BB7)
call RemoveSavedHandle(L7,(I97),(394))
elseif XH7(VUE)==false then
call VQE(ZX7,VUE,GetSpellTargetUnit(),D3E,BB7)
call RemoveSavedHandle(L7,(I97),(395))
elseif XH7(VVE)==false then
call VQE(ZX7,VVE,GetSpellTargetUnit(),D3E,BB7)
call RemoveSavedHandle(L7,(I97),(396))
if(TZ7(pl))then
call NN7(VXE,"Bird4")
endif
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A1Z2',false)
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A1YX',true)
call FlushChildHashtable(L7,(I97))
call OZ7(t)
endif
elseif B287_GetSpellAbilityId()=='A1RK' and HaveA==false then
if VSE!=null and XH7(VSE)==false then
call VQE(ZX7,VSE,ZX7,D3E,BB7)
endif
if VTE!=null and XH7(VTE)==false then
call VQE(ZX7,VTE,ZX7,D3E,BB7)
endif
if VUE!=null and XH7(VUE)==false then
call VQE(ZX7,VUE,ZX7,D3E,BB7)
endif
if VVE!=null and XH7(VVE)==false then
call VQE(ZX7,VVE,ZX7,D3E,BB7)
endif
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A1Z2',false)
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A1YX',true)
call FlushChildHashtable(L7,(I97))
call OZ7(t)
if(TZ7(pl))then
call NN7(VXE,"Bird4")
call NP7(VXE,"BirdsCounter",0)
endif
endif
else
set WF8=WF8+1
call SaveInteger(L7,(I97),(34),(WF8))
if(TZ7(pl))then
call NP7(VXE,"BirdsCounter",WF8)
endif
if VSE!=null and XH7(VSE)==false then
set P59=360*4/4.
set a2=P59+D4D*WF8
set x=X17(AQ9+$C8*Cos(a2*bj_DEGTORAD))
set y=X07(AR9+$C8*Sin(a2*bj_DEGTORAD))
call SetUnitFacing(VSE,a2-90)
call SetUnitX(VSE,x)
call SetUnitY(VSE,y)
endif
if VTE!=null and XH7(VTE)==false then
set P59=360*3/4.
set a2=P59+D4D*WF8
set x=X17(AQ9+$C8*Cos(a2*bj_DEGTORAD))
set y=X07(AR9+$C8*Sin(a2*bj_DEGTORAD))
call SetUnitFacing(VTE,a2-90)
call SetUnitX(VTE,x)
call SetUnitY(VTE,y)
endif
if VUE!=null and XH7(VUE)==false then
set P59=360*2/4.
set a2=P59+D4D*WF8
set x=X17(AQ9+$C8*Cos(a2*bj_DEGTORAD))
set y=X07(AR9+$C8*Sin(a2*bj_DEGTORAD))
call SetUnitFacing(VUE,a2-90)
call SetUnitX(VUE,x)
call SetUnitY(VUE,y)
endif
if VVE!=null and XH7(VVE)==false then
set P59=360*1/4.
set a2=P59+D4D*WF8
set x=X17(AQ9+$C8*Cos(a2*bj_DEGTORAD))
set y=X07(AR9+$C8*Sin(a2*bj_DEGTORAD))
call SetUnitFacing(VVE,a2-90)
call SetUnitX(VVE,x)
call SetUnitY(VVE,y)
endif
if WF8>VYE or GetTriggerEventId()==EVENT_UNIT_DEATH then
if VSE!=null and XH7(VSE)==false then
call VQE(ZX7,VSE,ZX7,D3E,BB7)
endif
if VTE!=null and XH7(VTE)==false then
call VQE(ZX7,VTE,ZX7,D3E,BB7)
endif
if VUE!=null and XH7(VUE)==false then
call VQE(ZX7,VUE,ZX7,D3E,BB7)
endif
if VVE!=null and XH7(VVE)==false then
call VQE(ZX7,VVE,ZX7,D3E,BB7)
endif
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A1Z2',false)
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A1YX',true)
call FlushChildHashtable(L7,(I97))
call OZ7(t)
if(TZ7(pl))then
call NN7(VXE,"Bird4")
call NP7(VXE,"BirdsCounter",0)
endif
else
set D3E=RMinBJ(.25+.75*(I2R(WF8)/500.),1)
call SaveReal(L7,(I97),(685),((D3E)*1.))
set VWE=.25+(1-.2)*2.5
call SetUnitScale(VSE,VWE,VWE,VWE)
call SetUnitScale(VTE,VWE,VWE,VWE)
call SetUnitScale(VUE,VWE,VWE,VWE)
call SetUnitScale(VVE,VWE,VWE,VWE)
if WF8==(VYE-$AF)then
call ZT7(WB4,GetOwningPlayer(ZX7))
endif
if WF8>(VYE-$C8)then
if ModuloInteger(WF8,$A)==0 or ModuloInteger(WF8,$A)==1 or ModuloInteger(WF8,$A)==2 or ModuloInteger(WF8,$A)==3 or ModuloInteger(WF8,$A)==4 then
call SetUnitVertexColor(VSE,$FF,0,0,$FF)
call SetUnitVertexColor(VTE,$FF,0,0,$FF)
call SetUnitVertexColor(VUE,$FF,0,0,$FF)
call SetUnitVertexColor(VVE,$FF,0,0,$FF)
else
call SetUnitVertexColor(VSE,$FF,$FF,$FF,$FF)
call SetUnitVertexColor(VTE,$FF,$FF,$FF,$FF)
call SetUnitVertexColor(VUE,$FF,$FF,$FF,$FF)
call SetUnitVertexColor(VVE,$FF,$FF,$FF,$FF)
endif
endif
endif
endif
set t=null
set ZX7=null
set VSE=null
set VTE=null
set VUE=null
set VVE=null
set BB7=null
return false
endfunction
function VZE takes nothing returns nothing
local trigger t=CreateTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=GetTriggerUnit()
local real AQ9=GetUnitX(ZX7)
local real AR9=GetUnitY(ZX7)
local real x
local real y
local unit VSE
local unit VTE
local unit VUE
local unit VVE
local real a=GetUnitFacing(ZX7)
local unit BB7=null
local integer VXE=GetHandleId(ZX7)
local player pl=GetOwningPlayer(ZX7)
local boolean HaveA=false
if SuijiMode_HasAghanimState(ZX7) then
    set HaveA=true
endif
call ND7(BB7)
call UnitAddAbility(BB7,'A21U')
call SetUnitState(ZX7,UNIT_STATE_LIFE,GetUnitState(ZX7,UNIT_STATE_LIFE)-GetUnitState(ZX7,UNIT_STATE_LIFE)*.2)
call XF7(ZX7,'A1Z2')
call UnitMakeAbilityPermanent(ZX7,true,'A1Z2')
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A1Z2',true)
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A1YX',false)
set x=GetUnitX(ZX7)+$C8*Cos(bj_DEGTORAD*360*4/4.*-1.)
set y=GetUnitY(ZX7)+$C8*Sin(bj_DEGTORAD*360*4/4.*-1.)
set VSE=CreateUnit(GetOwningPlayer(ZX7),'h0CU',x,y,360*4/4.*-1.)
set x=GetUnitX(ZX7)+$C8*Cos(bj_DEGTORAD*360*3/4.*-1.)
set y=GetUnitY(ZX7)+$C8*Sin(bj_DEGTORAD*360*3/4.*-1.)
set VTE=CreateUnit(GetOwningPlayer(ZX7),'h0CU',x,y,360*3/4.*-1.)
set x=GetUnitX(ZX7)+$C8*Cos(bj_DEGTORAD*360*2/4.*-1.)
set y=GetUnitY(ZX7)+$C8*Sin(bj_DEGTORAD*360*2/4.*-1.)
set VUE=CreateUnit(GetOwningPlayer(ZX7),'h0CU',x,y,360*2/4.*-1.)
set x=GetUnitX(ZX7)+$C8*Cos(bj_DEGTORAD*360*1/4.*-1.)
set y=GetUnitY(ZX7)+$C8*Sin(bj_DEGTORAD*360*1/4.*-1.)
set VVE=CreateUnit(GetOwningPlayer(ZX7),'h0CU',x,y,360*1/4.*-1.)
call TriggerRegisterTimerEvent(t,.02,true)
call TriggerRegisterUnitEvent(t,ZX7,EVENT_UNIT_SPELL_EFFECT)
call TriggerRegisterUnitEvent(t,ZX7,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function VRE))
call SaveUnitHandle(L7,(I97),(2),(ZX7))
call SaveUnitHandle(L7,(I97),(393),(VSE))
call SaveUnitHandle(L7,(I97),(394),(VTE))
call SaveUnitHandle(L7,(I97),(395),(VUE))
call SaveUnitHandle(L7,(I97),(396),(VVE))
call SaveUnitHandle(L7,(I97),(19),(BB7))
call SaveBoolean(L7,(I97),(99),(HaveA))
if(TZ7(pl))then
call NT7(VXE,"Bird4",VVE)
endif
set ZX7=null
set VSE=null
set VTE=null
set VUE=null
set VVE=null
set BB7=null
endfunction
function VAE takes nothing returns boolean
if B287_GetSpellAbilityId()=='A1YX' then
call VZE()
endif
return false
endfunction
function N68 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function VAE))
set t=null
endfunction
function VBE takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local unit IH7=(LoadUnitHandle(L7,(I97),(17)))
local integer BC7=GetUnitAbilityLevel(ZX7,'A2L1')
if GetTriggerEventId()==EVENT_UNIT_DEATH or GetTriggerEvalCount(t)>4 then
call UnitRemoveAbility(IH7,'A2L8')
call OX7(IH7,"IcarusDive|Disarmed")
call DestroyEffect((LoadEffectHandle(L7,(I97),($B0))))
call FlushChildHashtable(L7,(I97))
call OZ7(t)
endif
call B67(ZX7,IH7,1,20*BC7)
set t=null
set ZX7=null
return false
endfunction
function VCE takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local unit IH7=GetEnumUnit()
local trigger t=CreateTrigger()
local integer I97=GetHandleId(t)
call TriggerRegisterTimerEvent(t,1,true)
call TriggerAddCondition(t,Condition(function VBE))
call TriggerRegisterDeathEvent(t,IH7)
call SaveUnitHandle(L7,(I97),(2),(ZX7))
call SaveUnitHandle(L7,(I97),(17),(IH7))
call SaveEffectHandle(L7,(I97),($B0),(AddSpecialEffectTarget("Environment\\LargeBuildingFire\\LargeBuildingFire1.mdl",IH7,"chest")))
call UnitAddAbility(IH7,'A2L8')
call UnitMakeAbilityPermanent(IH7,true,'A2L8')
call SetPlayerAbilityAvailable(GetOwningPlayer(IH7),'A2L8',false)
call OV7(IH7,"IcarusDive|Disarmed")
set ZX7=null
set IH7=null
set t=null
endfunction
function V3E takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local real x=GetSpellTargetX()
local real y=GetSpellTargetY()
local group g=WS7()
call DestroyEffect(AddSpecialEffect("Environment\\LargeBuildingFire\\LargeBuildingFire1.mdl",x,y))
call GroupEnumUnitsInRange(g,x,y,275+25,Condition(function AW7))
call ForGroup(g,function VCE)
call WR7(g)
set g=null
set ZX7=null
endfunction
function V6E takes nothing returns boolean
if B287_GetSpellAbilityId()=='A2L1' then
call V3E()
endif
return false
endfunction
function NC8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function V6E))
set t=null
endfunction
function VLE takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit hn=O77(OB7,"Hero")
local unit BB7=O77(OB7,"Caster")
call NM7(OB7)
call OZ7(t)
if GetTriggerEventId()==EVENT_WIDGET_DEATH then
call KillUnit(BB7)
endif
if GetUnitTypeId(hn)=='E015' then
//绑定单位会不生效
//call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\MarkOfChaos\\MarkOfChaosDone.mdl",hn,"origin"))
//call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\FeralSpirit\\feralspirittarget.mdl",hn,"origin"))
//绑定单位会不生效
//call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\MarkOfChaos\\MarkOfChaosDone.mdl",hn,"origin"))
//call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\FeralSpirit\\feralspirittarget.mdl",hn,"origin"))
//绑定单位会不生效
//call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\MarkOfChaos\\MarkOfChaosDone.mdl",hn,"origin"))
//call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\FeralSpirit\\feralspirittarget.mdl",hn,"origin"))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\MarkOfChaos\\MarkOfChaosDone.mdl",GetUnitX(hn),GetUnitY(hn)))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\FeralSpirit\\feralspirittarget.mdl",GetUnitX(hn),GetUnitY(hn)))
elseif GetUnitTypeId(hn)=='E115' then
call DestroyEffect(AddSpecialEffect("model\\hero_lycan_n4s_f_source_1.mdl",GetUnitX(hn),GetUnitY(hn)))
call DestroyEffect(AddSpecialEffect("model\\hero_lycan_n4s_f_source_2.mdl",GetUnitX(hn),GetUnitY(hn)))
elseif GetUnitTypeId(hn)=='E116' then
call DestroyEffect(AddSpecialEffect("model\\hero_lycan_n3s_f_source_1.mdl",GetUnitX(hn),GetUnitY(hn)))
call DestroyEffect(AddSpecialEffect("model\\hero_lycan_n3s_f_source_2.mdl",GetUnitX(hn),GetUnitY(hn)))
endif
call UnitRemoveAbility(hn,'A0ZC')
call UnitRemoveAbility(hn,'B00V')
if SUIJI_MODE and OO7(GetHandleId(hn),"SuijiDone") then
call UnitRemoveAbility(hn,'A2PX')
endif
call SetUnitImitateMoveSpeed(hn, 0, 0)
call C77(hn,0)
set t=null
set hn=null
set BB7=null
return false
endfunction
function SuijiMode_RestoreScriptedWolfForm takes unit u returns nothing
local integer h=0
local effect fx=null
if u==null then
return
endif
set h=GetHandleId(u)
if OO7(h,"SuijiScriptedWolfForm")==false then
return
endif
if GetUnitTypeId(u)!=0 then
call SetUnitState(u,UNIT_STATE_ATTACK1_COOL,ON7(h,"SuijiScriptedWolfBaseAttack"))
call UnitRemoveAbility(u,'ZWLA')
call UnitRemoveAbility(u,'ZWLS')
endif
set fx=LoadEffectHandle(L7,h,StringHash("SuijiScriptedWolfEffect"))
if fx!=null then
call DestroyEffect(fx)
call RemoveSavedHandle(L7,h,StringHash("SuijiScriptedWolfEffect"))
endif
call NS7(h,"SuijiScriptedWolfForm",false)
set fx=null
endfunction
function SuijiMode_ApplyScriptedWolfForm takes unit u returns nothing
local integer h=0
local integer currentType=0
if u==null or GetUnitTypeId(u)==0 then
return
endif
set h=GetHandleId(u)
if OO7(h,"SuijiScriptedWolfForm")==false then
return
endif
set currentType=GetUnitTypeId(u)
if currentType!=OM7(h,"SuijiScriptedWolfUnitType") then
call NP7(h,"SuijiScriptedWolfUnitType",currentType)
call NQ7(h,"SuijiScriptedWolfBaseAttack",GetUnitState(u,UNIT_STATE_ATTACK1_COOL))
endif
if GetUnitAbilityLevel(u,'ZWLA')==0 then
call XF7(u,'ZWLA')
call UnitMakeAbilityPermanent(u,true,'ZWLA')
endif
if GetUnitAbilityLevel(u,'ZWLS')==0 then
call XF7(u,'ZWLS')
call UnitMakeAbilityPermanent(u,true,'ZWLS')
endif
call SetUnitState(u,UNIT_STATE_ATTACK1_COOL,1.5)
endfunction
function SuijiMode_ScriptedWolfFormTick takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer timerHandle=GetHandleId(t)
local unit u=LoadUnitHandle(L7,timerHandle,0)
local integer serial=LoadInteger(L7,timerHandle,1)
local integer h=0
if u==null or GetUnitTypeId(u)==0 then
call FlushChildHashtable(L7,timerHandle)
call PauseTimer(t)
call DestroyTimer(t)
set u=null
set t=null
return
endif
set h=GetHandleId(u)
if serial!=OM7(h,"SuijiScriptedWolfSerial") then
call FlushChildHashtable(L7,timerHandle)
call PauseTimer(t)
call DestroyTimer(t)
set u=null
set t=null
return
endif
if UnitAlive(u)==false or TimerGetElapsed(W)>=LoadReal(L7,timerHandle,2) then
call SuijiMode_RestoreScriptedWolfForm(u)
call FlushChildHashtable(L7,timerHandle)
call PauseTimer(t)
call DestroyTimer(t)
else
call SuijiMode_ApplyScriptedWolfForm(u)
endif
set u=null
set t=null
endfunction
function SuijiMode_StartScriptedWolfForm takes unit u,real duration returns nothing
local integer h=0
local integer serial=0
local timer t=null
local effect fx=null
if u==null or GetUnitTypeId(u)==0 or duration<=0. then
return
endif
set h=GetHandleId(u)
if OO7(h,"SuijiScriptedWolfForm") then
call SuijiMode_RestoreScriptedWolfForm(u)
endif
set serial=OM7(h,"SuijiScriptedWolfSerial")+1
call NP7(h,"SuijiScriptedWolfSerial",serial)
call NP7(h,"SuijiScriptedWolfUnitType",0)
call NS7(h,"SuijiScriptedWolfForm",true)
set fx=AddSpecialEffectTarget("Abilities\\Spells\\Orc\\FeralSpirit\\feralspirittarget.mdl",u,"origin")
call SaveEffectHandle(L7,h,StringHash("SuijiScriptedWolfEffect"),fx)
call SuijiMode_ApplyScriptedWolfForm(u)
set t=CreateTimer()
call SaveUnitHandle(L7,GetHandleId(t),0,u)
call SaveInteger(L7,GetHandleId(t),1,serial)
call SaveReal(L7,GetHandleId(t),2,TimerGetElapsed(W)+duration)
call TimerStart(t,.10,true,function SuijiMode_ScriptedWolfFormTick)
set fx=null
set t=null
endfunction
function V1E takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit hn=O77(OB7,"Hero")
local unit BB7=O77(OB7,"Caster")
local real bl_time=ON7(OB7,"Dur")
local integer bl_level
call NM7(OB7)
call OZ7(t)
set bl_level=B287_GetUnitAbilityLevel(hn,'A093')+GetUnitAbilityLevel(hn,'X093')+GetUnitAbilityLevel(hn,'X193')
if SUIJI_MODE and OO7(GetHandleId(hn),"SuijiDone") and GetUnitAbilityLevel(hn,'A2PX')==0 then
call UnitAddAbility(hn,'A2PX')
call UnitMakeAbilityPermanent(hn,true,'A2PX')
call SetPlayerAbilityAvailable(GetOwningPlayer(hn),'A2PX',false)
endif
call SetUnitAbilityLevel(hn,'A2PX',bl_level)
call C77(hn,300+bl_level*100)
if GetUnitTypeId(hn)=='E015' then
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\MarkOfChaos\\MarkOfChaosDone.mdl",hn,"origin"))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\FeralSpirit\\feralspirittarget.mdl",hn,"origin"))
elseif GetUnitTypeId(hn)=='E115' then
call DestroyEffect(AddSpecialEffectTarget("model\\hero_lycan_n4s_f_source_1.mdl",hn,"origin"))
call DestroyEffect(AddSpecialEffectTarget("model\\hero_lycan_n4s_f_source_2.mdl",hn,"overhead"))
elseif GetUnitTypeId(hn)=='E116' then
call DestroyEffect(AddSpecialEffectTarget("model\\hero_lycan_n3s_f_source_1.mdl",hn,"origin"))
call DestroyEffect(AddSpecialEffectTarget("model\\hero_lycan_n3s_f_source_2.mdl",hn,"overhead"))
endif
set t=CreateTrigger()
set OB7=GetHandleId(t)
call TriggerRegisterTimerEvent(t,bl_time - .1,false)
call TriggerRegisterDeathEvent(t,hn)
call TriggerAddCondition(t,Condition(function VLE))
call NT7(OB7,"Hero",hn)
call NT7(OB7,"Caster",BB7)
call SetUnitImitateMoveSpeed(hn, 999, 650)
set t=null
set hn=null
set BB7=null
return false
endfunction
//变狼
function V0E takes nothing returns nothing
local trigger t=null
local integer OB7=0
local unit hn=GetTriggerUnit()
local unit V5E=null
local real V2E
if hn==null or GetUnitTypeId(hn)==0 then
set hn=null
return
endif
set t=CreateTrigger()
set OB7=GetHandleId(t)
set V5E=CreateUnit(GetOwningPlayer(hn),'e01V',0,0,0)
if V5E==null or GetUnitTypeId(V5E)==0 then
call NM7(OB7)
call OZ7(t)
set t=null
set V5E=null
set hn=null
return
endif
if SuijiMode_HasAghanimState(hn) then
set V2E=40
else
set V2E=20
endif
if GetSpellAbilityId()=='Y0BY' then
set V2E=V2E*SuijiMode_GetDurationMulticastCount(hn,'A093')
