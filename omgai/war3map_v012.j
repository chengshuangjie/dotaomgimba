function QV8 takes nothing returns nothing
local unit WI7=IN4
local integer i=1
local integer SAF
if GetUnitTypeId(WI7)!='H00U' and GetUnitTypeId(WI7)!='Z00U' and GetUnitTypeId(WI7)!='Z10U' and GetUnitTypeId(WI7)!='Z20U' then
set WI7=null
return
endif
loop
exitwhen i>$B
set SAF=BS[i]
call XF7(WI7,SAF)
call SetPlayerAbilityAvailable(GetOwningPlayer(WI7),SAF,false)
set i=i+1
endloop
set WI7=null
endfunction
function SBF takes nothing returns boolean
local integer id
if IsUnitIllusion(GetTriggerUnit())==false then
set id=GetUnitTypeId(GetTriggerUnit())
if IsUnitType(GetTriggerUnit(),UNIT_TYPE_HERO)then
if hZZ(id)==false then
call GroupAddUnit(Uz,GetTriggerUnit())
set IN4=GetTriggerUnit()
call ExecuteFunc("PWE")
elseif id=='H00M' then
call GroupAddUnit(Uz,GetTriggerUnit())
endif
endif
if GetUnitTypeId(GetTriggerUnit())=='H00U' or GetUnitTypeId(GetTriggerUnit())=='Z00U' or GetUnitTypeId(GetTriggerUnit())=='Z10U' or GetUnitTypeId(GetTriggerUnit())=='Z20U' then
set IN4=GetTriggerUnit()
call QV8()
elseif GetUnitTypeId(GetTriggerUnit())=='H00I' then
set IN4=GetTriggerUnit()
call ExecuteFunc("XUD")
endif
endif
return false
endfunction
function SCF takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit m5=O77(OB7,"Target")
call UnitRemoveAbility(m5,'A0VJ')
call UnitRemoveAbility(m5,'A109')
if GetUnitAbilityLevel(m5,'A0VJ')==0 or GetUnitAbilityLevel(m5,'A109')==0 then
call NM7(OB7)
call OZ7(t)
endif
set t=null
set m5=null
return false
endfunction
function S3F takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit m5=O77(OB7,"Target")
call DestroyEffect(OG7(OB7,"FX"))
call NM7(OB7)
call OZ7(t)
call UnitRemoveAbility(m5,'A0VJ')
call UnitRemoveAbility(m5,'A109')
if GetUnitAbilityLevel(m5,'A0VJ')>0 or GetUnitAbilityLevel(m5,'A109')>0 then
set t=CreateTrigger()
set OB7=GetHandleId(t)
call NT7(OB7,"Target",m5)
call TriggerRegisterTimerEvent(t,1,true)
call TriggerAddCondition(t,Condition(function SCF))
endif
set t=null
set m5=null
return false
endfunction
function S6F takes nothing returns nothing
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local unit WI7=GetTriggerUnit()
local integer SLF=GetHandleId(WI7)
local unit m5=GetSpellTargetUnit()
local integer S1F=OM7(SLF,"WexLevel")
local integer S0F=OM7(SLF,"ExortLevel")
local integer id=GetUnitTypeId(WI7)
local string tx
if id=='Z00U' then 
set tx="model\\hero_invoker_n4s_z_target1.mdl"
call YS7("model\\hero_invoker_n4s_z_target2.mdl",m5,"overhead",9)
elseif id=='Z10U' then 
set tx="model\\hero_invoker_n3s_z_target1.mdl"
call YS7("model\\hero_invoker_n3s_z_target2.mdl",m5,"overhead",9)
elseif id=='Z20U' then 
set tx="model\\hero_invoker_n2s_z_target1.mdl"
else
set tx="Abilities\\Spells\\Items\\AIsp\\SpeedTarget.mdl"
endif
call XF7(m5,'A0VJ')
call SetUnitAbilityLevel(m5,'A0VJ',S1F)
call XF7(m5,'A109')
call SetUnitAbilityLevel(m5,'A109',S0F)
call TriggerRegisterTimerEvent(t,9,false)
call TriggerAddCondition(t,Condition(function S3F))
call NT7(OB7,"Target",m5)
call NU7(OB7,"FX",AddSpecialEffectTarget(tx,m5,"origin"))
set t=null
set WI7=null
set m5=null
endfunction
function S5F takes nothing returns boolean
if B287_GetSpellAbilityId()=='A0VQ' then
call S6F()
endif
return false
endfunction
function S2F takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function S5F))
call Y97('A0VJ',GetRandomReal(1,25))
call Y97('A109',GetRandomReal(1,25))
set t=null
endfunction
function S_F takes unit p5 returns real
local integer length
local integer ZZMF_level=GetUnitAbilityLevel(p5,'A4DJ')+GetUnitAbilityLevel(p5,'A4DZ')
local integer ZZMF=0
if ZZMF_level>0 then
    set ZZMF=50*ZZMF_level
endif
if GetUnitAbilityLevel(p5,'A2YK')>0 then
set length=200
elseif GetUnitAbilityLevel(p5,'A2YJ')>0 then
set length=150
else
set length=0
endif
return 400+400.*(OM7(GetHandleId(p5),"WexLevel"))+length+ZZMF
endfunction
function T4F takes unit p5,unit m5,integer S1F,integer T7F returns nothing
local unit T8F=CreateUnit(GetOwningPlayer(p5),'e00E',GetUnitX(m5),GetUnitY(m5),0)
