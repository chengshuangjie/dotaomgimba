function ISLABIKE takes unit ZX7 returns boolean
return GetUnitTypeId(ZX7)=='E02X' or GetUnitTypeId(ZX7)=='Z02X'
endfunction
//熊灵
function AS7 takes unit K67 returns boolean
return GetUnitTypeId(K67)=='n004' or GetUnitTypeId(K67)=='n018' or GetUnitTypeId(K67)=='n01C' or GetUnitTypeId(K67)=='n01G'
endfunction
function DGH_BUFF takes unit u returns real
local integer O5=GetPlayerId(GetOwningPlayer(u))
local real d=1.
if IsUnitType(u,UNIT_TYPE_HERO)==false and AS7(u)==false then
    return d
endif
if DGH_BAD[O5]==1 then
    set d=.3
elseif DGH_GOOD[O5]==1 then
    set d=1.2
endif
if GetUnitAbilityLevel(u,'B0JZ')>0 then
    set d=d*.4
elseif GetUnitAbilityLevel(u,'B0HX')>0 then
    set d=d*.5
elseif GetUnitAbilityLevel(u,'Bcsd')>0 then
    set d=d*.8
endif
if GetUnitAbilityLevel(u,'A4H2')>0 then
    set d=d*1.4
endif
return d
endfunction
function ChangeUnitSkillHotKey takes unit u,integer skill,string old_str,string new_str,integer hotkey returns nothing
	local string VH
	local integer level=GetUnitAbilityLevel(u,skill)
    set VH=MHAbility_GetCustomLevelDataStr(u,skill,level,ABILITY_LEVEL_DEF_DATA_TIP)
	set VH=MHString_Replace(VH,old_str,new_str)
    call MHAbility_SetCustomLevelDataStr(u,skill,level,ABILITY_LEVEL_DEF_DATA_TIP,VH)
	call MHAbility_SetCustomDataInt(u,skill,ABILITY_DEF_DATA_HOTKEY,hotkey)
endfunction
function Click_CheckBox_Nothing takes player p, integer i returns nothing
	if GetLocalPlayer() == p then
		set UIFrame__IsCheckBoxEnable[i] = not UIFrame__IsCheckBoxEnable[i]
		call DzFrameShow(UIFrame__HighLight[i], UIFrame__IsCheckBoxEnable[i])
	endif
endfunction

function Set_CheckBox_Nothing takes player p, integer i , boolean b returns nothing
	if GetLocalPlayer() == p then
		set UIFrame__IsCheckBoxEnable[i] = b
		call DzFrameShow(UIFrame__HighLight[i], UIFrame__IsCheckBoxEnable[i])
	endif
endfunction
function Get_HP_High takes unit u returns real
	local real TXX=0
	if HaveSavedReal(TABLE_U, GetUnitTypeId(u),'HIGH')== false then
        set TXX = MHUnit_GetData(u,UNIT_DATA_HPBAR_HEIGHT)
        if TXX>0 then
		    call SaveReal(TABLE_U, GetUnitTypeId(u),'HIGH', TXX)
        else
            set TXX=0.
        endif
	else
		set TXX = LoadReal(TABLE_U, GetUnitTypeId(u),'HIGH')
	endif
	return TXX
endfunction
function Hide_HP takes unit u,boolean b returns nothing
local real z8=Get_HP_High(u)
    if z8==0 then
        return
    endif
    if b then
        call MHUnit_SetData(u,UNIT_DATA_HPBAR_HEIGHT,9999)
    else
        call MHUnit_SetData(u,UNIT_DATA_HPBAR_HEIGHT,z8)
    endif
endfunction
function Get_Unit_Scale takes unit u returns real
	local real TXX=0
	if HaveSavedReal(TABLE_U, GetUnitTypeId(u),'SIZE')== false then
        set TXX = MHUnit_GetDefDataReal(GetUnitTypeId(u),UNIT_DEF_DATA_SCALE)
        if TXX>0 then
		    call SaveReal(TABLE_U, GetUnitTypeId(u),'SIZE', TXX)
        else
            set TXX=1.
        endif
	else
		set TXX = LoadReal(TABLE_U, GetUnitTypeId(u),'SIZE')
	endif
	return TXX
endfunction
//英雄模型缩放 对应unitui.slk modelScale值
function XX7 takes unit u returns real
local integer z8=GetUnitTypeId(u)
if z8=='Ucrl' or z8=='U01X' or z8=='Zcrl' or z8=='Z01X' or z8=='Zdrl' or z8=='Z11X' or z8=='Zerl' or z8=='Z21X' then
    if z8=='Zcrl' or z8=='Z01X' then
return .5+.2*B287_GetUnitAbilityLevel(u,'A0CY')
    else
return .5+.25*B287_GetUnitAbilityLevel(u,'A0CY')
    endif
else
    return Get_Unit_Scale(u)
endif
endfunction
