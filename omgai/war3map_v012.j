call TriggerAddCondition(t,Condition(function UUD))
call TriggerAddAction(t,function UAD)
set t=null
endfunction
function YJHY3 takes nothing returns nothing
local unit u=GetTriggerUnit()
local integer OB7=GetHandleId(GetOwningPlayer(u))
local unit DA8=O77(OB7,"Kobold1")
local unit DB8=O77(OB7,"Kobold2")
local unit DC8=O77(OB7,"Kobold3")
local unit D38=O77(OB7,"Kobold4")



if DA8!=null and UnitAlive(DA8) then
    call IssueTargetOrderById(DA8,$D0249,u)
endif
if DB8!=null and UnitAlive(DB8) then
    call IssueTargetOrderById(DB8,$D0249,u)
endif
if DC8!=null and UnitAlive(DC8) then
    call IssueTargetOrderById(DC8,$D0249,u)
endif
if D38!=null and UnitAlive(D38) then
    call IssueTargetOrderById(D38,$D0249,u)
endif
set u=null
set D38=null
set DC8=null
set DB8=null
set DA8=null
endfunction
