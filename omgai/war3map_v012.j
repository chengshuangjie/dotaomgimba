call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,E9,20,Q[D5]+KZ4[GetPlayerId(Z7[T8])]+"|r "+GetObjectName('n08M')+" "+GetUnitName(M7[D5])+" ("+GetObjectName('n08L')+" "+I2S(GetUnitLevel(M7[D5]))+")"+M99(Z7[T8]))
