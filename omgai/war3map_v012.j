function KGF takes unit it returns integer
if B287_GetUnitAbilityLevel(it,'A28S')==0 then
return 150+150*B287_GetUnitAbilityLevel(it,'A28R')
else
return 160+180*B287_GetUnitAbilityLevel(it,'A28S')
endif
endfunction
function KHF takes unit it returns integer
local integer kt=GetHeroLevel(it)
if(D4 or RZ4)then
return(90*kt)
elseif(hG[GetPlayerId(GetOwningPlayer(it))]<5)then
return(45*kt)
elseif(hG[GetPlayerId(GetOwningPlayer(it))]<$B)then
return(75*kt)
elseif(hG[GetPlayerId(GetOwningPlayer(it))]<$F)then
return(105*kt)
else
return(120*kt)
endif
endfunction
function KIF takes unit it returns integer
local integer kc=B287_GetUnitAbilityLevel(it,'A0MU')
if kc==0 and B287_GetUnitAbilityLevel(it,'A0A2')>0 then
return B287_GetUnitAbilityLevel(it,'A0A2')
endif
return kc
endfunction
function KJF takes unit it returns integer
local integer i=GetPlayerId(GetOwningPlayer(it))
if GetUnitLevel(it)>15 then
return 99999
endif
if B287_GetUnitAbilityLevel(it,'A09W')==0 then
return 236+150*B287_GetUnitAbilityLevel(it,'A095')+R2I(SWYJ[i]*.75)
else
return 350+150*B287_GetUnitAbilityLevel(it,'A09W')+R2I(SWYJ[i]*.75)
endif
endfunction
function KKF takes unit it returns integer
if GetUnitLevel(it)>15 then
return 99999
endif
if B287_GetUnitAbilityLevel(it,'A09Z')==0 then
return 236+150*B287_GetUnitAbilityLevel(it,'A01P')
else
return 332+150*B287_GetUnitAbilityLevel(it,'A09Z')
endif
endfunction
function KMF takes unit it returns real
if((it==JW_1ZT)or(it==JW_2ZT)or(it==JW_3ZT)or(it==JW_4RT)or(it==JW_4LT)or(it==JW_1XT))then
return 50.
elseif((it==JW_1ST)or(it==JW_2ST)or(it==JW_3ST))then
return 100.
elseif((it==JW_2XT)or(it==JW_3XT))then
return 10.
elseif((it==TZ_2ZT)or(it==TZ_3ZT)or(it==TZ_4LT)or(it==TZ_4RT))then
return 230.
elseif((it==TZ_1XT)or(it==TZ_2XT)or(it==TZ_3XT))then
return 270.
elseif(it==TZ_3ST)then
return 150.
else
return 180.
endif
endfunction
function KNF takes unit it returns real
local real KOF=YK7(ON7(GetHandleId(it),"TLLife1"),1.)-GetUnitState(it,UNIT_STATE_LIFE)
local real KPF=GetUnitState(it,UNIT_STATE_MAX_LIFE)
if(KPF==0)then
return .0
else
return(KOF/KPF)*100.
endif
endfunction
