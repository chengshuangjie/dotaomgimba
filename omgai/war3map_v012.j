function COG_Damaging_EVENT takes nothing returns boolean
	local unit m5=MHEvent_GetUnit()
	local unit cogDamageSource=MHDamagingEvent_GetSource()
	local integer id=0
	if m5==null or cogDamageSource==null or GetUnitTypeId(m5)==0 or GetUnitTypeId(cogDamageSource)==0 then
		set m5=null
		set cogDamageSource=null
		return false
	endif
	set id=GetUnitTypeId(m5)
	if id=='u00S' and MHDamagingEvent_GetDamage()>0 and MHDamagingEvent_IsPhysical() then
		if GetOwningPlayer(cogDamageSource)==GetOwningPlayer(m5) then
			call MHDamagingEvent_SetDamage(0)
		else
			call MHDamagingEvent_SetDamage(1.)
		endif
	endif
	set m5=null
	set cogDamageSource=null
	return false
endfunction
function GearKickAction takes nothing returns nothing
local unit gear=U22
local unit target=GetEnumUnit()
local unit hero=IN4
local integer level=IH4
if GetUnitState(target, UNIT_STATE_MANA) > 0 and OT7(target, "PowerCogShocked") == false then
	if IsUnitInGroup(target,JQH)==false then
		call GroupAddUnit(JQH,target)
        call ApplyCogRebound(target, GetUnitX(gear), GetUnitY(gear), hero, level, true)
	endif
endif
set gear=null
set target=null
set hero=null
endfunction
function GearKickTimer takes nothing returns boolean
    local trigger t = GetTriggeringTrigger()
    local integer OB7 = GetHandleId(t)
    local unit gear = O77(OB7, "Gear")
    local real angle = ON7(OB7, "Angle")
    local real distLeft = ON7(OB7, "Dist")
    local real step = ON7(OB7, "Speed")
    local real x = GetUnitX(gear) + step * Cos(angle)
    local real y = GetUnitY(gear) + step * Sin(angle)
    local group g
	local group AlreadyDamagedGroup=OF7(OB7,"AlreadyDamaged")
    local unit hero = O77(OB7, "Owner")
    local integer level = OM7(OB7, "Level")
	set x=X17(x)
	set y=X07(y)
    if UnitAlive(gear)==false then
		call WR7(AlreadyDamagedGroup)
        call NM7(OB7)
        call OZ7(t)
		set gear = null
		set hero = null
		set AlreadyDamagedGroup = null
        return false
    endif


    set g = WS7()
	set IN4=hero
	set U22=gear
	set JQH=AlreadyDamagedGroup
	set IH4=level
    call GroupEnumUnitsInRange(g,x,y,150, Condition(function AJ7_gai))
	call ForGroup(g,function GearKickAction)
    call WR7(g)


	call SetUnitPosition(gear, x, y)
	call SetUnitX(gear,x)
	call SetUnitY(gear,y)
    set distLeft = distLeft - step
    call NQ7(OB7, "Dist", distLeft)


    if distLeft <= 0 then
		call MHUnit_SetModel(gear,"buildings\\other\\PowerGenerator\\PowerGenerator.mdl",false)
		call SetUnitScale(gear,XX7(gear),XX7(gear),XX7(gear))
		call KillUnit(gear)
		call WR7(AlreadyDamagedGroup)
        call NM7(OB7)
        call OZ7(t)
    endif


	set g = null
    set gear = null
    set hero = null
	set AlreadyDamagedGroup = null
    return false
endfunction
function KickGear takes unit gear, unit hero returns nothing
    local real angle = Atan2(GetUnitY(gear)-GetUnitY(hero), GetUnitX(gear)-GetUnitX(hero))
    local integer parentOB7 = OM7(GetHandleId(gear), "CogParent")
    local integer index = OM7(GetHandleId(gear), "CogIndex")
    local trigger t
    local integer OB7
local integer level=B287_GetUnitAbilityLevel(hero,'A0Z5')
	local real dist = 1000.
	local real speed = 18
    if parentOB7 != 0 and index > 0 then
        call NT7(parentOB7, "Cog"+I2S(index), null)
    endif
	call SetUnitInvulnerable(gear,true)
	if Clockwerk_HasScepter(hero) then
		set dist=1500
		set speed=27
		call MHUnit_SetModel(gear,"effects\\football.mdl",false)
		call SetUnitScale(gear,4.5,4.5,4.5)
		call SetUnitFlyHeight(gear,25,0)
	endif
    call OV7(gear, "PowerCogKicked")
	call NP7(GetHandleId(gear), "PowerCogUsed", 1)



    set t = CreateTrigger()
    set OB7 = GetHandleId(t)
    call NT7(OB7, "Gear", gear)
    call NQ7(OB7, "Angle", angle)
    call NQ7(OB7, "Dist", dist)
	call NQ7(OB7, "Speed", speed)
    call NT7(OB7, "Owner", hero)
	call NP7(OB7, "Level", level)
	call NB7(OB7,"AlreadyDamaged",WS7())
    call TriggerRegisterTimerEvent(t, 0.02, true)
    call TriggerAddCondition(t, Condition(function GearKickTimer))
    set t = null
endfunction
function COG_Damage_EVENT takes nothing returns boolean
    local unit gear = MHEvent_GetUnit()
    local unit attacker = MHDamageEvent_GetSource()
    if gear!=null and attacker!=null and GetUnitTypeId(gear)=='u00S' and GetUnitTypeId(attacker)!=0 and UnitAlive(gear) and GetOwningPlayer(attacker)==GetOwningPlayer(gear) and MHDamageEvent_IsPhysical() and OT7(gear, "PowerCogKicked") == false and OM7(GetHandleId(gear), "PowerCogUsed")==0 then
        call KickGear(gear, attacker)
    endif
    set gear = null
    set attacker = null
    return false
endfunction
