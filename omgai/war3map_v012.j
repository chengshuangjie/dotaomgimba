local unit suijiDemonicPurgeTarget=GetSpellTargetUnit()
if (B287_GetSpellAbilityId()=='A1SA' or B287_GetSpellAbilityId()=='A2ZU' or B287_GetSpellAbilityId()=='A2ZV' or B287_GetSpellAbilityId()=='A2ZW') and suijiDemonicPurgeCaster!=null and suijiDemonicPurgeTarget!=null and GetUnitTypeId(suijiDemonicPurgeCaster)!=0 and GetUnitTypeId(suijiDemonicPurgeTarget)!=0 then
    call QLG()
