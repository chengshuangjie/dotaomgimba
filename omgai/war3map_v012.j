call RAD()
endif
return false
endfunction
function HJ8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function RBD))
set t=null
endfunction
function RCD2 takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local unit IH7=(LoadUnitHandle(L7,(I97),(17)))
local real d=(LoadReal(L7,(I97),(20)))
if ZX7==null or IH7==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 or UnitAlive(ZX7)==false or UnitAlive(IH7)==false then
call FlushChildHashtable(L7,(I97))
call OZ7(t)
set t=null
set ZX7=null
set IH7=null
return false
endif
if GetTriggerEvalCount(t)>300 then
call FlushChildHashtable(L7,(I97))
call OZ7(t)
elseif GetUnitAbilityLevel(IH7,'B0E7')>0 then
call FlushChildHashtable(L7,(I97))
call OZ7(t)
call B67(ZX7, IH7, 1, d)
call LINGXIA(ZX7,IH7)
endif
set t=null
set ZX7=null
set IH7=null
return false
endfunction
function RCD takes nothing returns nothing
	local unit ZX7 = U22
	local unit IH7 = W22
