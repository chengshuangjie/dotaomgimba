function M_E takes nothing returns nothing
local unit u=GetTriggerUnit()
local player p=null
local integer id=0
local integer i
local integer k
local real a
local real x=0.
local real y=0.
local real r
local real length=800.
local integer C1D=18
if u==null or GetUnitTypeId(u)==0 then
set u=null
return
endif
set p=GetOwningPlayer(u)
set id=GetUnitTypeId(u)
call SuijiMode_StartPairCooldownSync(u,B287_GetSpellAbilityId(),'A013','A0A6',"SuijiPoisonNovaCooldown",140.,120.,100.,120.,90.,60.)
set x=GetUnitX(u)
set y=GetUnitY(u)
set a=360./(C1D*1.)
set i=1
set k=C1D
loop
exitwhen i>k
set r=i*a*bj_DEGTORAD
// call Wave(u,'h0HO', 0.01, length, 300, 300, x, y, x+50*Cos(r), y+50*Sin(r), 800, 1, false, "M_E_TRI", BC7)
call Wave(u,'h0HO', 0.01, length, 125, 125, x-100*Cos(r), y-100*Sin(r), x+50*Cos(r), y+50*Sin(r), 550, 1, false, "M_E_TRI", 1)
set i=i+1
endloop
set u=null
set p=null
endfunction
