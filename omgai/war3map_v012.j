call US9(p5,m5)
if IsUnitType(m5,UNIT_TYPE_HERO) and IsUnitEnemy(p5,GetOwningPlayer(m5)) then
call SJTQ(p5,m5)
endif
call NS7(GetHandleId(p5),"JinadaActive",false)
call NQ7(GetHandleId(p5),"LastUsed",TimerGetElapsed(W)*1.)
call UnitRemoveAbility(p5,'A1IS')
call UnitRemoveAbility(p5,'A1J4')
