call OZ7(t)
set t=null
set ZX7=null
set IH7=null
return false
endif
set d=DGH_BUFF(IH7)
call SetUnitState(IH7,UNIT_STATE_LIFE,GetUnitState(IH7,UNIT_STATE_LIFE)+.1*d*(20+GetUnitState(IH7,UNIT_STATE_MAX_LIFE)*(.02+.01*BC7)))
if GetTriggerEvalCount(t)>39 or GetTriggerEventId()==EVENT_UNIT_DEATH or(GetTriggerEvalCount(t)==1 and (IsUnitHidden(IH7) or IsHideUnit(IH7)))then
call PauseUnitEx(IH7,false)
