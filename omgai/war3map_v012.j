function XK9 takes nothing returns nothing
local real x=GetUnitX(GetEnumUnit())
local real y=GetUnitY(GetEnumUnit())
local integer id=GetPlayerId(GetOwningPlayer(SuijiEchoSlamEffectCaster))
if IsUnitType(GetEnumUnit(),UNIT_TYPE_HERO) or IsUnitIllusion(GetEnumUnit())==true then
call SetUnitX(YZ[id],x)
call SetUnitY(YZ[id],y)
if GetPlayerController(GetOwningPlayer(YZ[id]))==MAP_CONTROL_COMPUTER then
call UnitAddAbility(YZ[id],'A0DM')
call SetUnitAbilityLevel(YZ[id],'A0DM',ZZ)
endif
call IssueImmediateOrderById(YZ[id],$D022E)
endif
endfunction
function XM9 takes nothing returns boolean
return (GetUnitAbilityLevel(GetFilterUnit(),'A04R')==0 and IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==false and IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(SuijiEchoSlamEffectCaster)) and XH7(GetFilterUnit())==false)!=null
endfunction
function SuijiMode_ShouldBlockScepterPairReentry takes unit u,integer skill,integer normalSkill,integer aghSkill,string key,real duration returns boolean
local integer h=0
local integer lastSkill=0
local real now=0.
if SUIJI_MODE==false or u==null or GetUnitTypeId(u)==0 then
return false
endif
if skill!=normalSkill and skill!=aghSkill then
return false
endif
if GetUnitAbilityLevel(u,normalSkill)<=0 or GetUnitAbilityLevel(u,aghSkill)<=0 then
return false
endif
set h=GetHandleId(u)
set now=TimerGetElapsed(W)
set lastSkill=OM7(h,key+"LastSkill")
if lastSkill!=0 and lastSkill!=skill and ON7(h,key+"Until")>now then
return true
endif
call NP7(h,key+"LastSkill",skill)
call NQ7(h,key+"Until",now+duration)
return false
endfunction
function SuijiMode_PairCooldownSyncTick takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer timerHandle=GetHandleId(t)
local unit u=LoadUnitHandle(L7,timerHandle,2)
local integer normalSkill=LoadInteger(L7,timerHandle,3)
local integer aghSkill=LoadInteger(L7,timerHandle,4)
local integer normalPhysical=0
local integer aghPhysical=0
local integer casterHandle=LoadInteger(L7,timerHandle,8)
local integer left=LoadInteger(L7,timerHandle,6)
local real cooldown=LoadReal(L7,timerHandle,7)-TimerGetElapsed(W)
local ability normalAbility=null
local ability aghAbility=null
local string key=LoadStr(L7,timerHandle,19)
if u!=null and GetUnitTypeId(u)!=0 and left>0 and cooldown>.01 then
call SuijiMode_NormalizeNativePersistentAgh(u)
set normalPhysical=B287_GetPhysicalAbilityId(u,normalSkill)
set aghPhysical=B287_GetPhysicalAbilityId(u,aghSkill)
set normalAbility=EXGetUnitAbility(u,normalPhysical)
set aghAbility=EXGetUnitAbility(u,aghPhysical)
if normalAbility!=null then
call EXSetAbilityState(normalAbility,1,cooldown)
call MHAbility_SetCooldown(u,normalPhysical,cooldown)
endif
if aghAbility!=null then
call EXSetAbilityState(aghAbility,1,cooldown)
call MHAbility_SetCooldown(u,aghPhysical,cooldown)
endif
call SaveInteger(L7,timerHandle,6,left-1)
else
if key!="" then
call RemoveSavedHandle(L7,casterHandle,StringHash(key+"Trigger"))
endif
call NM7(timerHandle)
call OZ7(t)
endif
set key=""
set normalAbility=null
set aghAbility=null
set u=null
set t=null
return false
endfunction
function SuijiMode_StartPairCooldownSync takes unit u,integer skill,integer normalSkill,integer aghSkill,string key,real normal1,real normal2,real normal3,real agh1,real agh2,real agh3 returns nothing
local trigger t=null
local integer casterHandle=0
local integer timerHandle=0
local integer level=0
local integer normalPhysical=0
local integer aghPhysical=0
local real cooldown=0.
local real factor=0.
local ability normalAbility=null
local ability aghAbility=null
if SUIJI_MODE==false or u==null or GetUnitTypeId(u)==0 then
return
endif
if skill!=normalSkill and skill!=aghSkill then
return
endif
set casterHandle=GetHandleId(u)
if LoadTriggerHandle(L7,casterHandle,StringHash(key+"Trigger"))!=null then
return
endif
set level=SuijiMode_GetPairCastLevel(u,skill,normalSkill,aghSkill)
if level<1 then
set level=1
elseif level>3 then
set level=3
endif
if SuijiMode_HasAghanimState(u) then
if level==1 then
set cooldown=agh1
elseif level==2 then
set cooldown=agh2
else
set cooldown=agh3
endif
else
if level==1 then
set cooldown=normal1
elseif level==2 then
set cooldown=normal2
else
set cooldown=normal3
endif
endif
set factor=ReduceUnitAbilityCoolDownReal(u)
if factor>0. then
set cooldown=cooldown*factor
endif
call SuijiMode_NormalizeNativePersistentAgh(u)
set normalPhysical=B287_GetPhysicalAbilityId(u,normalSkill)
set aghPhysical=B287_GetPhysicalAbilityId(u,aghSkill)
set normalAbility=EXGetUnitAbility(u,normalPhysical)
set aghAbility=EXGetUnitAbility(u,aghPhysical)
if normalAbility!=null and cooldown>.01 then
call EXSetAbilityState(normalAbility,1,cooldown)
call MHAbility_SetCooldown(u,normalPhysical,cooldown)
endif
if aghAbility!=null and cooldown>.01 then
call EXSetAbilityState(aghAbility,1,cooldown)
call MHAbility_SetCooldown(u,aghPhysical,cooldown)
endif
set t=CreateTrigger()
set timerHandle=GetHandleId(t)
call SaveUnitHandle(L7,timerHandle,2,u)
call SaveInteger(L7,timerHandle,3,normalSkill)
call SaveInteger(L7,timerHandle,4,aghSkill)
call SaveInteger(L7,timerHandle,5,skill)
call SaveInteger(L7,timerHandle,6,30)
call SaveReal(L7,timerHandle,7,TimerGetElapsed(W)+cooldown)
call SaveInteger(L7,timerHandle,8,casterHandle)
call SaveReal(L7,timerHandle,10,normal1)
call SaveReal(L7,timerHandle,11,normal2)
call SaveReal(L7,timerHandle,12,normal3)
call SaveReal(L7,timerHandle,13,agh1)
call SaveReal(L7,timerHandle,14,agh2)
call SaveReal(L7,timerHandle,15,agh3)
call SaveStr(L7,timerHandle,19,key)
call SaveTriggerHandle(L7,casterHandle,StringHash(key+"Trigger"),t)
call TriggerRegisterTimerEvent(t,.10,true)
call TriggerAddCondition(t,Condition(function SuijiMode_PairCooldownSyncTick))
set t=null
set normalAbility=null
set aghAbility=null
set key=""
endfunction
function SuijiMode_StartStampedeCooldownSync takes nothing returns nothing
call SuijiMode_StartPairCooldownSync(TMPU3,'A2O6','A2O6','A2ZG',"SuijiStampedeCooldown",75.,60.,45.,75.,60.,45.)
endfunction
function SuijiMode_StartChenHandCooldownSync takes nothing returns nothing
call SuijiMode_StartPairCooldownSync(TMPU3,SUIJI_CHEN_HAND_CAST_SKILL,'A0LT','A1CS',"SuijiChenHandCooldown",160.,140.,120.,30.,30.,30.)
endfunction
function SuijiMode_EchoSlamEffect takes unit p5,integer suijiEchoSlamSkill,boolean suijiEchoSlamEnforceLock returns nothing
local real x=0.
local real y=0.
local group g=null
local integer id=0
local integer V77=0
local integer i1=0
local integer skill
local integer skill2
local integer randomtx=0
local integer suijiEchoSlamCasterHandle=0
local boolean suijiEchoSlamScepter=false
local boolexpr b=null
if p5==null or GetUnitTypeId(p5)==0 then
set p5=null
return
endif
set suijiEchoSlamCasterHandle=GetHandleId(p5)
if SUIJI_MODE and suijiEchoSlamEnforceLock then
if LoadReal(L7,suijiEchoSlamCasterHandle,StringHash("SuijiEchoSlamBlockUntil"))>TimerGetElapsed(W) then
set p5=null
return
endif
call SaveReal(L7,suijiEchoSlamCasterHandle,StringHash("SuijiEchoSlamBlockUntil"),TimerGetElapsed(W)+.75)
endif
set x=GetUnitX(p5)
set y=GetUnitY(p5)
set g=WS7()
set id=GetPlayerId(GetOwningPlayer(p5))
if suijiEchoSlamSkill=='A1OB' then
set suijiEchoSlamScepter=true
set V77=B287_GetUnitAbilityLevel(p5,'A1OB')
else
set V77=B287_GetUnitAbilityLevel(p5,'A0DH')
if SuijiMode_HasAghanimState(p5) then
set suijiEchoSlamScepter=true
endif
endif
if V77<=0 then
if suijiEchoSlamScepter then
set V77=B287_GetUnitAbilityLevel(p5,'A0DH')
else
set suijiEchoSlamScepter=true
set V77=B287_GetUnitAbilityLevel(p5,'A1OB')
endif
endif
if V77<=0 then
call WR7(g)
set p5=null
set g=null
set b=null
return
endif
set i1=GetUnitTypeId(p5)
if i1=='Z02X' then
    set randomtx=GetRandomInt(1,3)
endif
if i1=='Ztch' or randomtx==1 then
    set skill='X1H0'
    set skill2='X0DM'
    call DestroyEffect(AddSpecialEffect("model\\Hero_EarthShaker_N3S_C_source.mdl",GetUnitX(p5),GetUnitY(p5)))
elseif i1=='Zuch' or randomtx==2 then
    set skill='X2H0'
    set skill2='X1DM'
    call DestroyEffect(AddSpecialEffect("model\\Hero_EarthShaker_N7S_C_source.mdl",GetUnitX(p5),GetUnitY(p5)))
elseif i1=='Zvch' or randomtx==3 then
    set skill='X3H0'
    set skill2='X2DM'
    call DestroyEffect(AddSpecialEffect("AZModel\\AZ_ESFrost_C1_Caster.mdl",GetUnitX(p5),GetUnitY(p5)))
else
    set skill='A1H0'
set skill2='A0DM'
endif
set zZ[id]=CreateUnit(GetOwningPlayer(p5),'e00E',x,y,0)
set YZ[id]=CreateUnit(GetOwningPlayer(p5),'e00E',x,y,0)
set ZZ=V77
call UnitApplyTimedLife(zZ[id],'BTLF',2.)
call UnitApplyTimedLife(YZ[id],'BTLF',2.)
call XF7(zZ[id],skill)
call SetUnitAbilityLevel(zZ[id],skill,V77)
call IssueImmediateOrderById(zZ[id],$D022E)
call SetUnitScale(YZ[id],.25,.25,.25)
call XF7(YZ[id],skill2)
call SetUnitAbilityLevel(YZ[id],skill2,V77)
set SuijiEchoSlamEffectCaster=p5
set b=Condition(function XM9)
call GroupEnumUnitsInRange(g,x,y,600,b)
call ForGroup(g,function XJ9)
if suijiEchoSlamScepter then
call ForGroup(g,function XK9)
endif
call DestroyBoolExpr(b)
call WR7(g)
set SuijiEchoSlamEffectCaster=null
set p5=null
set g=null
set b=null
endfunction
function XN9 takes nothing returns nothing
call SuijiMode_EchoSlamEffect(GetTriggerUnit(),B287_GetSpellAbilityId(),true)
endfunction
function SuijiMode_EchoSlamMulticastExtra takes unit u,integer skill returns nothing
call SuijiMode_EchoSlamEffect(u,skill,false)
set u=null
endfunction
function SuijiMode_SetEchoCooldownState takes unit u,real cooldown returns nothing
local ability normalAbility=null
local ability aghAbility=null
if u==null or GetUnitTypeId(u)==0 or cooldown<=.01 then
return
endif
set normalAbility=EXGetUnitAbility(u,'A0DH')
set aghAbility=EXGetUnitAbility(u,'A1OB')
if normalAbility!=null then
call EXSetAbilityState(normalAbility,1,cooldown)
call B287_MHAbility_SetCooldown(u,'A0DH',cooldown)
endif
if aghAbility!=null then
call EXSetAbilityState(aghAbility,1,cooldown)
call B287_MHAbility_SetCooldown(u,'A1OB',cooldown)
endif
set normalAbility=null
set aghAbility=null
endfunction
function SuijiMode_ForceEchoCooldown takes unit u,integer skill returns nothing
local real cooldown=100.
local real factor=0.
if u==null or GetUnitTypeId(u)==0 then
return
endif
if skill=='A1OB' then
set cooldown=70.
endif
set factor=ReduceUnitAbilityCoolDownReal(u)
if factor>0. then
set cooldown=cooldown*factor
endif
call SuijiMode_SetEchoCooldownState(u,cooldown)
endfunction
function SuijiMode_EchoCooldownSyncTick takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer timerHandle=GetHandleId(t)
local unit u=LoadUnitHandle(L7,timerHandle,2)
local integer skill=LoadInteger(L7,timerHandle,3)
local integer casterHandle=0
local real cooldown=0.
local real factor=0.
local real maxCooldown=100.
if u!=null and GetUnitTypeId(u)!=0 then
set casterHandle=GetHandleId(u)
if skill=='A1OB' or SuijiMode_HasAghanimState(u) then
set maxCooldown=70.
endif
set factor=ReduceUnitAbilityCoolDownReal(u)
if factor>0. then
set maxCooldown=maxCooldown*factor
endif
set cooldown=MHAbility_GetCooldown(u,skill)
if cooldown<=.01 or cooldown>maxCooldown then
set cooldown=maxCooldown
endif
if cooldown>.01 then
call SuijiMode_SetEchoCooldownState(u,cooldown)
endif
call RemoveSavedHandle(L7,casterHandle,StringHash("SuijiEchoSlamCooldownTrigger"))
endif
call NM7(timerHandle)
call OZ7(t)
set u=null
set t=null
return false
endfunction
function SuijiMode_StartEchoCooldownSync takes unit u,integer skill returns nothing
local trigger t=null
local integer casterHandle=0
local integer timerHandle=0
if SUIJI_MODE==false or u==null or GetUnitTypeId(u)==0 then
return
endif
if skill!='A0DH' and skill!='A1OB' then
return
endif
call SuijiMode_NormalizeNativeEarthshakerAgh(u)
set casterHandle=GetHandleId(u)
if LoadTriggerHandle(L7,casterHandle,StringHash("SuijiEchoSlamCooldownTrigger"))!=null then
return
endif
set t=CreateTrigger()
set timerHandle=GetHandleId(t)
call SaveUnitHandle(L7,timerHandle,2,u)
call SaveInteger(L7,timerHandle,3,skill)
call SaveTriggerHandle(L7,casterHandle,StringHash("SuijiEchoSlamCooldownTrigger"),t)
call TriggerRegisterTimerEvent(t,.10,false)
call TriggerAddCondition(t,Condition(function SuijiMode_EchoCooldownSyncTick))
set t=null
endfunction
function SuijiMode_EchoMulticastCooldownGuardTick takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer timerHandle=GetHandleId(t)
local unit u=LoadUnitHandle(L7,timerHandle,0)
local integer casterHandle=LoadInteger(L7,timerHandle,1)
local integer left=LoadInteger(L7,timerHandle,2)
local real remaining=LoadReal(L7,timerHandle,3)-TimerGetElapsed(W)
if u==null or GetUnitTypeId(u)==0 or left<=0 or remaining<=.01 then
if casterHandle>0 then
call RemoveSavedHandle(L7,casterHandle,StringHash("SuijiEchoMulticastCooldownGuard"))
endif
call FlushChildHashtable(L7,timerHandle)
call PauseTimer(t)
call DestroyTimer(t)
else
call SuijiMode_SetEchoCooldownState(u,remaining)
call SaveInteger(L7,timerHandle,2,left-1)
endif
set u=null
set t=null
endfunction
function SuijiMode_StartEchoMulticastCooldownGuard takes unit u,integer skill returns nothing
local timer t=null
local timer oldTimer=null
local integer timerHandle=0
local integer oldTimerHandle=0
local integer casterHandle=0
local real cooldown=100.
local real factor=0.
if u==null or GetUnitTypeId(u)==0 or (skill!='A0DH' and skill!='A1OB') then
return
endif
set casterHandle=GetHandleId(u)
set oldTimer=LoadTimerHandle(L7,casterHandle,StringHash("SuijiEchoMulticastCooldownGuard"))
if oldTimer!=null then
set oldTimerHandle=GetHandleId(oldTimer)
call FlushChildHashtable(L7,oldTimerHandle)
call PauseTimer(oldTimer)
call DestroyTimer(oldTimer)
call RemoveSavedHandle(L7,casterHandle,StringHash("SuijiEchoMulticastCooldownGuard"))
endif
if skill=='A1OB' or SuijiMode_HasAghanimState(u) then
set cooldown=70.
endif
set factor=ReduceUnitAbilityCoolDownReal(u)
if factor>0. then
set cooldown=cooldown*factor
endif
call SuijiMode_SetEchoCooldownState(u,cooldown)
set t=CreateTimer()
set timerHandle=GetHandleId(t)
call SaveUnitHandle(L7,timerHandle,0,u)
call SaveInteger(L7,timerHandle,1,casterHandle)
call SaveInteger(L7,timerHandle,2,25)
call SaveReal(L7,timerHandle,3,TimerGetElapsed(W)+cooldown)
call SaveTimerHandle(L7,casterHandle,StringHash("SuijiEchoMulticastCooldownGuard"),t)
call TimerStart(t,.10,true,function SuijiMode_EchoMulticastCooldownGuardTick)
set oldTimer=null
set t=null
endfunction
function XO9 takes nothing returns boolean
if B287_GetSpellAbilityId()=='A0DH' or B287_GetSpellAbilityId()=='A1OB' then
call SuijiMode_StartEchoCooldownSync(GetTriggerUnit(),B287_GetSpellAbilityId())
call XN9()
endif
return false
endfunction
function EC8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function XO9))
set t=null
call X_7('A0DM')
endfunction
function Set_QHTT_Cooldown takes unit ZX7,boolean b returns nothing
    local real d=ReduceUnitAbilityCoolDownReal(ZX7)
    local real cooldown=5
    if PT4 then
        return
    endif
    if d>0 then
        set cooldown=cooldown*d
    endif
    if b then
		if GetUnitAbilityLevel(ZX7,'A4LZ')>0 then
        	call Japi_ReduceUnitAbilityCoolDown(ZX7,'A4LZ',cooldown)
		endif
    else
		if B287_GetUnitAbilityLevel(ZX7,'A0DL')>0 then
        	call Japi_ReduceUnitAbilityCoolDown(ZX7,'A0DL',cooldown)
		endif
    endif
endfunction
function QHTT takes unit u returns nothing
    local integer id=GetUnitTypeId(u)
    local integer level=B287_GetUnitAbilityLevel(u,'A0DL')
    local real d=0
    local integer skill
	if ISLABIKE(u) then
		set level=4
	endif
	set d=GetUnitState(u, UNIT_STATE_ATTACK1_DAMAGE_BASE) * level
    if id=='Ztch' then
        set skill='X0DL'
    elseif id=='Zuch' then
        set skill='X1DL'
    elseif id=='Zvch' then
        set skill='X2DL'
    else
        set skill='XADL'
    endif
    call Set_Unit_Shuxing_Time(u,'A4KU',d,14.)
    call Z57(u,skill, 1, 14.,'Broa')
endfunction
function ZCQHTT2 takes nothing returns boolean
if B287_GetSpellAbilityId()=='A0DL' then
call QHTT(GetTriggerUnit())
call Set_QHTT_Cooldown(GetTriggerUnit(),true)
endif
return false
endfunction
function XXQHTT takes nothing returns boolean
if B287_GetLearnedSkill()=='A0DL' and GetUnitAbilityLevel(GetTriggerUnit(),'A4LZ')>0 then
	call SetUnitAbilityLevel(GetTriggerUnit(),'A4LZ',B287_GetUnitAbilityLevel(GetTriggerUnit(),'A0DL'))
endif
return false
endfunction
function ZCQHTT takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function ZCQHTT2))
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_HERO_SKILL)
call TriggerAddCondition(t,Condition(function XXQHTT))
set t=null
endfunction
//余震
function YuZhen takes unit ZX7 returns nothing
local unit BB7=CreateUnit(GetOwningPlayer(ZX7),'e00E',GetUnitX(ZX7),GetUnitY(ZX7),0)
local integer id=GetUnitTypeId(ZX7)
local string tx
local integer level=B287_GetUnitAbilityLevel(ZX7,'A0DJ')
local integer h=GetHandleId(ZX7)
local integer randomtx=0
if id=='Z02X' then
    set randomtx=GetRandomInt(1,3)
endif
if level<=0 and OO7(h,"SuijiAftershock") then
    set level=OM7(h,"SuijiAftershockLevel")
endif
if ISLABIKE(ZX7) then
    set level=4
endif
if level<=0 then
    set level=1
endif
if id=='Ztch' or randomtx==1 then 
    set tx="model\\Hero_EarthShaker_N3S_A_source.mdl"
elseif id=='Zuch' or randomtx==2 then 
    set tx="model\\Hero_EarthShaker_N7S_A_source.mdl"
elseif id=='Zvch' or randomtx==3 then 
    set tx="AZModel\\AZ_ESFrost_A.mdl"
else
    set tx="Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl"
endif
call UnitAddAbility(BB7,'A0DI')
call SetUnitAbilityLevelSwapped('A0DI',BB7,level)
call IssueImmediateOrderById(BB7,$D009F)
call DestroyEffect(AddSpecialEffect(tx, GetUnitX(BB7), GetUnitY(BB7)))
set BB7=null
endfunction
function YuZhen_HasAftershock takes unit u returns boolean
if u==null then
return false
endif
return B287_GetUnitAbilityLevel(u,'A0DJ')>0 or OO7(GetHandleId(u),"SuijiAftershock")
endfunction
function YuZhen_IsTriggerSpell takes unit u,integer sid returns boolean
local item it=null
if u==null or sid=='A0DI' or sid=='A0DJ' or B291_IsRealSpellCast(u,sid)==false then
return false
endif
set it=MHAbility_GetSourceItem(u,sid)
if it!=null then
set it=null
return false
endif
set it=null
return true
endfunction
function Earthshaker_AI_AfterLeap takes unit u returns nothing
local integer O5
local unit m5=null
if u==null or GetPlayerController(GetOwningPlayer(u))!=MAP_CONTROL_COMPUTER then
return
endif
set O5=GetPlayerId(GetOwningPlayer(u))
set m5=h4[O5]
if m5!=null and M87(m5) and IsUnitType(m5,UNIT_TYPE_HERO) and IsUnitEnemy(m5,GetOwningPlayer(u)) and IsUnitVisible(m5,GetOwningPlayer(u)) then
set G0[32+O5]=false
set GZ[$A0+O5]=false
call IssueTargetOrderById(u,$D000F,m5)
elseif G0[32+O5] and GetUnitLifePercent(u)>80. and GetUnitManaPercent(u)>30. and (not ME7(u)) then
set G0[32+O5]=false
set GZ[$A0+O5]=false
call J3(u,true)
elseif (not G0[32+O5]) and K57(u) then
call J3(u,true)
endif
set m5=null
endfunction
function Earthshaker_EnchantTotemClearLeap takes timer t,unit u returns nothing
local integer h=GetHandleId(t)
if u!=null then
call SetUnitFlyHeight(u,GetUnitDefaultFlyHeight(u),0)
call SetUnitPathing(u,true)
call PauseUnitEx(u,false)
endif
call FlushChildHashtable(TABLE_HY,h)
call PauseTimer(t)
call DestroyTimer(t)
set t=null
set u=null
endfunction
function Earthshaker_EnchantTotemLeapTick takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer h=GetHandleId(t)
local unit u=LoadUnitHandle(TABLE_HY,h,0)
local integer step=LoadInteger(TABLE_HY,h,0)+1
local integer steps=LoadInteger(TABLE_HY,h,1)
local real sx=LoadReal(TABLE_HY,h,0)
local real sy=LoadReal(TABLE_HY,h,1)
local real tx=LoadReal(TABLE_HY,h,2)
local real ty=LoadReal(TABLE_HY,h,3)
local real p
local real x
local real y
if u==null or UnitAlive(u)==false then
call Earthshaker_EnchantTotemClearLeap(t,u)
set t=null
set u=null
return
endif
set p=I2R(step)/I2R(steps)
if p>1. then
set p=1.
endif
set x=X17(sx+(tx-sx)*p)
set y=X07(sy+(ty-sy)*p)
call SetUnitX(u,x)
call SetUnitY(u,y)
call SetUnitFlyHeight(u,850.*4.*p*(1.-p),0)
if step>=steps then
call SetUnitX(u,X17(tx))
call SetUnitY(u,X07(ty))
call Earthshaker_EnchantTotemClearLeap(t,u)
call SetUnitAnimation(u,"slam")
call QHTT(u)
if YuZhen_HasAftershock(u) or (ISLABIKE(u) and ISPH(u)==false) then
		call YuZhen(u)
	endif
	if PT4 then
		call IssueImmediateOrder(u,"stop")
	endif
	call Earthshaker_AI_AfterLeap(u)
else
call SaveInteger(TABLE_HY,h,0,step)
endif
set t=null
set u=null
endfunction
function SZQHTT takes nothing returns nothing
	local timer t=CreateTimer()
	local integer h=GetHandleId(t)
    local unit u=GetTriggerUnit()
    local integer id=GetUnitTypeId(u)
    local integer level=GetUnitAbilityLevel(u,'A4LZ')
	local real sx=GetUnitX(u)
	local real sy=GetUnitY(u)
	local real tx=GetSpellTargetX()
	local real ty=GetSpellTargetY()
	local location l_source=GetUnitLoc(u)
	local location l_target=GetSpellTargetLoc()
	local location l
	local real Angle=AngleBetweenPoints(l_source,l_target)
	local real d=750.+MHUnit_GetSpellRange(u)
	call RemoveLocation(l_source)
	call RemoveLocation(l_target)
	if KF7(sx,sy,tx,ty)>d then
		set tx=X17(sx+d*Cos(Angle*bj_DEGTORAD))
		set ty=X07(sy+d*Sin(Angle*bj_DEGTORAD))
	endif
	if IsPointInRegion(IU4,tx,ty) then
		set l=YV8(tx,ty)
		set tx=GetLocationX(l)
		set ty=GetLocationY(l)
		call RemoveLocation(l)
		set l=null
	endif
	call Set_QHTT_Cooldown(u,false)
	if KCD(u)==false then
call XF7(u,'Amrf')
call UnitRemoveAbility(u,'Amrf')
	endif
	call SetUnitPathing(u,false)
	call PauseUnitEx(u,true)
	// call SetUnitAnimation(u,"slam")
	// call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",sx,sy))
	// call SetUnitAnimation(u,"slam")
	// call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",sx,sy))
	// call SetUnitAnimation(u,"slam")
	// call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",sx,sy))
	call SaveUnitHandle(TABLE_HY,h,0,u)
	call SaveInteger(TABLE_HY,h,0,0)
	call SaveInteger(TABLE_HY,h,1,26)
	call SaveReal(TABLE_HY,h,0,sx)
	call SaveReal(TABLE_HY,h,1,sy)
	call SaveReal(TABLE_HY,h,2,tx)
	call SaveReal(TABLE_HY,h,3,ty)
	call TimerStart(t,.02,true,function Earthshaker_EnchantTotemLeapTick)
	if MHAbility_GetCastpoint(u,'A4LZ')!=.01 then
		call MHAbility_SetCastpoint(u,'A4LZ',.01)
	endif
	set l_source=null
	set l_target=null
    set u=null
	set t=null
endfunction
function ZCSZQHTT2 takes nothing returns boolean
if B287_GetSpellAbilityId()=='A4LZ' then
call SZQHTT()
endif
return false
endfunction
function ZCSZQHTT takes nothing returns nothing
