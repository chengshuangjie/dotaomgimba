function I9D takes nothing returns nothing
local integer id=GetUnitTypeId(RT4)
local string tx
if id=='Z00S' then
    set tx="model\\Hero_STormSpirit_N6S_R_Target.mdl"
elseif id=='Z10S' then
    set tx="model\\Hero_STormSpirit_N4S_R_Target.mdl"
elseif id=='Z20S' then
    set tx="model\\Hero_STormSpirit_N8S_R_Target.mdl"
else
