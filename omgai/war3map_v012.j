function DestructableInRange takes nothing returns nothing
local destructable W5I=GetEnumDestructable()
local real d
if VO7(W5I)and GetDestructableLife(W5I)>1 then
set d=KF7(GetDestructableX(W5I),GetDestructableY(W5I),IJ4,IK4)
if d<IM4 then
set IM4=d
set SB=W5I
endif
endif
set W5I=null
endfunction
function IsDestructableInRange takes real x,real y,real r returns boolean
local rect DB2=Rect(x-r,y-r,x+r,y+r)
local boolean destructableInRangeFound=false
set IM4=999999
set SB=null
set IJ4=x
set IK4=y
call EnumDestructablesInRect(DB2,Condition(function TO7),function DestructableInRange)
if SB !=null then
set destructableInRangeFound=true
endif
call RemoveRect(DB2)
set DB2=null
return destructableInRangeFound
endfunction
function GetDestructableInRange takes real x,real y,real r returns destructable
local rect DB2=Rect(x-r,y-r,x+r,y+r)
set IM4=999999
set SB=null
set IJ4=x
set IK4=y
call EnumDestructablesInRect(DB2,Condition(function TO7),function DestructableInRange)
call RemoveRect(DB2)
set DB2=null
return SB
endfunction
function TreeDance_Off_Move2 takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(TABLE_XJ,(OB7),(2)))
if ZX7==null or GetUnitTypeId(ZX7)==0 then
call FlushChildHashtable(TABLE_XJ,(OB7))
call OZ7(t)
set t=null
set ZX7=null
return
endif
call SetUnitPathingEx(ZX7,true)
call FlushChildHashtable(TABLE_XJ,(OB7))
call OZ7(t)
set t=null
set ZX7=null
endfunction
function TreeDance_Off_Move takes unit ZX7 returns nothing
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
call SetUnitPathingEx(ZX7,false)
call TriggerRegisterTimerEvent(t,0.5,false)
call TriggerAddCondition(t,Condition(function TreeDance_Off_Move2))
call SaveUnitHandle(TABLE_XJ,(OB7),(2),(ZX7))
set t=null
endfunction
function TreeDance_Off takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer HEI=GetHandleId(t)
local unit W4I=(LoadUnitHandle(TABLE_XJ,(HEI),(2)))
local destructable W5I=(LoadDestructableHandle(TABLE_XJ,(HEI),(17)))
local real x=(LoadReal(TABLE_XJ,(HEI),(6)))
local real y=(LoadReal(TABLE_XJ,(HEI),(7)))
local integer level=GetUnitAbilityLevel(W4I,'A4CP')
if W4I==null or W5I==null or GetUnitTypeId(W4I)==0 then
call DestroyEffect((LoadEffectHandle(TABLE_XJ,(HEI),(32))))
call FogModifierStop((LoadFogModifierHandle(TABLE_XJ,(HEI),(42))))
call DestroyFogModifier((LoadFogModifierHandle(TABLE_XJ,(HEI),(42))))
call FlushChildHashtable(TABLE_XJ,(HEI))
call OZ7(t)
set t=null
set W4I=null
set W5I=null
return false
endif
if RAbsBJ(x-GetUnitX(W4I))>=24 or RAbsBJ(y-GetUnitY(W4I))>=24 or GetDestructableLife(W5I)<=0 or XH7(W4I) then
call SetUnitFlyHeight(W4I,GetUnitDefaultFlyHeight(W4I),0)
call SetUnitPathing(W4I,true)
// if((LoadInteger(TABLE_XJ,(GetHandleId((W4I))),(('A4CP'))))==1)==false then
// call SetUnitPosition(W4I,x,y)
// endif
// if((LoadInteger(TABLE_XJ,(GetHandleId((W4I))),(('A4CP'))))==1)==false then
// call SetUnitPosition(W4I,x,y)
// endif
// if((LoadInteger(TABLE_XJ,(GetHandleId((W4I))),(('A4CP'))))==1)==false then
// call SetUnitPosition(W4I,x,y)
// endif
call SetPlayerAbilityAvailable(GetOwningPlayer(W4I),'A4CZ',false)
call XF7(W4I,'A4D4')
call SetPlayerAbilityAvailable(GetOwningPlayer(W4I),'A4D4',true)
call SetUnitAbilityLevel(W4I,'A4CZ',level)
call UnitRemoveAbility(W4I,'Abun')
call UnitRemoveAbility(W4I,'A0XB')
call DestroyEffect((LoadEffectHandle(TABLE_XJ,(HEI),(32))))
call FogModifierStop((LoadFogModifierHandle(TABLE_XJ,(HEI),(42))))
call DestroyFogModifier((LoadFogModifierHandle(TABLE_XJ,(HEI),(42))))
if GetDestructableLife(W5I)<=0 then
call CommonUnitAddStun(W4I, 4, true)
endif
call FlushChildHashtable(TABLE_XJ,(HEI))
call OZ7(t)
call TreeDance_Off_Move(W4I)
endif
set t=null
set W4I=null
set W5I=null
return false
endfunction
function TreeDance_On takes unit W4I,destructable W5I,real x,real y returns nothing
local trigger t=CreateTrigger()
local integer HEI=GetHandleId(t)
local string s=""
local fogmodifier FOGTMP
local real r=(LoadReal(TABLE_XJ,(GetHandleId(W4I)),('A4D1')))
if GetLocalPlayer()==GetOwningPlayer(W4I) or WG7(GetLocalPlayer())then
set s="tx\\qtds\\JumpAoE.mdx"
endif
set FOGTMP=CreateFogModifierRadius(GetOwningPlayer(W4I),FOG_OF_WAR_VISIBLE,x,y,r,false,true)
call FogModifierStart(FOGTMP)
call TriggerRegisterTimerEvent(t,0.2,true)
call TriggerAddCondition(t,Condition(function TreeDance_Off))
call SaveUnitHandle(TABLE_XJ,(HEI),(2),(W4I))
call SaveDestructableHandle(TABLE_XJ,(HEI),(17),(W5I))
call SaveReal(TABLE_XJ,(HEI),(6),((x)*1.0))
call SaveReal(TABLE_XJ,(HEI),(7),((y)*1.0))
call SaveEffectHandle(TABLE_XJ,(HEI),(32),(AddSpecialEffect(s,x,y)))
call SaveFogModifierHandle(TABLE_XJ,(HEI),(42),(FOGTMP))
call SaveTriggerHandle(TABLE_XJ,(GetHandleId(W4I)),('A4CP'),(t))
set t=null
set FOGTMP=null
endfunction
function TreeDance_Actions takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer HEI=GetHandleId(t)
local integer H5I=GetTriggerEvalCount(t)
local unit W4I=(LoadUnitHandle(TABLE_XJ,(HEI),(2)))
local destructable W5I=(LoadDestructableHandle(TABLE_XJ,(HEI),(17)))
local real x2=(LoadReal(TABLE_XJ,(HEI),(282)))
local real y2=(LoadReal(TABLE_XJ,(HEI),(283)))
local real x1=GetUnitX(W4I)
local real y1=GetUnitY(W4I)
local real UWO
local real P02
local real CR2
local real QPO
local real J9I
local real JAI
if W4I==null or W5I==null or GetUnitTypeId(W4I)==0 then
call DestroyEffect((LoadEffectHandle(TABLE_XJ,(HEI),(32))))
call DestroyEffect((LoadEffectHandle(TABLE_XJ,(HEI),(33))))
call DestroyEffect((LoadEffectHandle(TABLE_XJ,(HEI),(34))))
call DestroyEffect((LoadEffectHandle(TABLE_XJ,(HEI),(35))))
call DestroyEffect((LoadEffectHandle(TABLE_XJ,(HEI),(36))))
call FlushChildHashtable(TABLE_XJ,(HEI))
call OZ7(t)
set t=null
set W4I=null
set W5I=null
return false
endif
set UWO=AngleBetweenXY(x1,y1,x2,y2)
set P02=KF7(x1,y1,x2,y2)
set CR2=P02/IMaxBJ((51-H5I),1)
set QPO=0.68*(H5I-25)*(H5I-25)
set J9I=x1+CR2*Cos(UWO*bj_DEGTORAD)
set JAI=y1+CR2*Sin(UWO*bj_DEGTORAD)
if GetDestructableLife(W5I)<=0 or XH7(W4I) or IsHideUnit(W4I) then
call UnitRemoveAbility(W4I,'B0J2')
call DestroyEffect((LoadEffectHandle(TABLE_XJ,(HEI),(32))))
call DestroyEffect((LoadEffectHandle(TABLE_XJ,(HEI),(33))))
call DestroyEffect((LoadEffectHandle(TABLE_XJ,(HEI),(34))))
call DestroyEffect((LoadEffectHandle(TABLE_XJ,(HEI),(35))))
call DestroyEffect((LoadEffectHandle(TABLE_XJ,(HEI),(36))))
call SetUnitFlyHeight(W4I,GetUnitDefaultFlyHeight(W4I),0)
call SetUnitPathing(W4I,true)
call SetPlayerAbilityAvailable(GetOwningPlayer(W4I),'A4CZ',false)
call XF7(W4I,'A4D4')
call SetPlayerAbilityAvailable(GetOwningPlayer(W4I),'A4D4',true)
call SetUnitAbilityLevel(W4I,'A4CZ',GetUnitAbilityLevel(W4I,'A4CP'))
call UnitRemoveAbility(W4I,'Abun')
call UnitRemoveAbility(W4I,'A0XB')
call FlushChildHashtable(TABLE_XJ,(HEI))
call OZ7(t)
set t=null
set W4I=null
set W5I=null
return false
endif
if H5I<51 then
call SetUnitFlyHeight(W4I,625-QPO,0)
call SetUnitX(W4I,J9I)
call SetUnitY(W4I,JAI)
else
call SetUnitFlyHeight(W4I,200,0)
call UnitRemoveAbility(W4I,'B0J2')
call SetUnitX(W4I,x2)
call SetUnitY(W4I,y2)
if GetUnitTypeId(W4I)=='Z052' then
call SetUnitAnimationByIndex(W4I,6)
endif
call DestroyEffect((LoadEffectHandle(TABLE_XJ,(HEI),(32))))
call DestroyEffect((LoadEffectHandle(TABLE_XJ,(HEI),(33))))
call DestroyEffect((LoadEffectHandle(TABLE_XJ,(HEI),(34))))
call DestroyEffect((LoadEffectHandle(TABLE_XJ,(HEI),(35))))
call DestroyEffect((LoadEffectHandle(TABLE_XJ,(HEI),(36))))
call FlushChildHashtable(TABLE_XJ,(HEI))
call OZ7(t)
call IssueImmediateOrder(W4I,"holdposition") //防止自动攻击
call TreeDance_On(W4I,W5I,x2,y2)
endif
set t=null
set W4I=null
set W5I=null
return false
endfunction
function TreeDance_Main takes nothing returns nothing
local unit W4I=GetTriggerUnit()
local real x=GetSpellTargetX()
local real y=GetSpellTargetY()
local destructable W5I=GetDestructableInRange(x,y,150)
local integer level=GetUnitAbilityLevel(W4I,'A4CP')
local trigger t=(LoadTriggerHandle(TABLE_XJ,(GetHandleId(W4I)),('A4CP')))
local integer HEI=GetHandleId(t)
local unit u
if t !=null then
call DestroyEffect((LoadEffectHandle(TABLE_XJ,(HEI),(32))))
call FogModifierStop((LoadFogModifierHandle(TABLE_XJ,(HEI),(42))))
call DestroyFogModifier((LoadFogModifierHandle(TABLE_XJ,(HEI),(42))))
call SaveTriggerHandle(TABLE_XJ,(GetHandleId(W4I)),('A4CP'),(null))
call RemoveSavedHandle(TABLE_XJ,(GetHandleId(W4I)),('A4CP'))
call FlushChildHashtable(TABLE_XJ,(HEI))
call OZ7(t)
endif
set u=CreateUnit(GetOwningPlayer(W4I),'e00E',GetUnitX(W4I),GetUnitY(W4I),0)
call XF7(u,'A4D2')
call SetUnitAbilityLevel(u,'A4D2',1) //BUFF是B0J2
if IssueTargetOrder(u,"thunderbolt",W4I)then
set x=GetDestructableX(W5I)
set y=GetDestructableY(W5I)
call SetUnitPathing(W4I,false)
if KCD(W4I)==false then
call XF7(W4I,'Amrf')
call UnitRemoveAbility(W4I,'Amrf')
endif
if GetOwningPlayer(W4I)==GetLocalPlayer()then
call AddIndicator(W5I,255,255,0,255)
endif
call XF7(W4I,'Abun')
call XF7(W4I,'A0XB')
call XF7(W4I,'A4CZ')
call SetPlayerAbilityAvailable(GetOwningPlayer(W4I),'A4D4',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(W4I),'A4CZ',true)
call SetUnitAbilityLevel(W4I,'A4CZ',level)
set t=CreateTrigger()
set HEI=GetHandleId(t)
call SaveUnitHandle(TABLE_XJ,(HEI),(2),(W4I))
call SaveDestructableHandle(TABLE_XJ,(HEI),(17),(W5I))
call SaveEffectHandle(TABLE_XJ,(HEI),(32),(AddSpecialEffectTarget("Abilities\\Spells\\Human\\FlakCannons\\FlakTarget.mdl",W4I,"origin")))
call SaveEffectHandle(TABLE_XJ,(HEI),(33),(AddSpecialEffectTarget("tx\\qtds\\HeroMonkeyking_W4_Ribbon.MDX",W4I,"foot left")))
call SaveEffectHandle(TABLE_XJ,(HEI),(34),(AddSpecialEffectTarget("tx\\qtds\\HeroMonkeyking_W4_Ribbon.MDX",W4I,"foot right")))
call SaveEffectHandle(TABLE_XJ,(HEI),(35),(AddSpecialEffectTarget("tx\\qtds\\HeroMonkeyking_W4_Ribbon.MDX",W4I,"hand left")))
call SaveEffectHandle(TABLE_XJ,(HEI),(36),(AddSpecialEffectTarget("tx\\qtds\\HeroMonkeyking_W4_Ribbon.MDX",W4I,"hand right")))
call SaveReal(TABLE_XJ,(HEI),(282),((x)*1.0))
call SaveReal(TABLE_XJ,(HEI),(283),((y)*1.0))
call TriggerRegisterTimerEvent(t,0.02,true)
call TriggerAddCondition(t,Condition(function TreeDance_Actions))
endif
set t=null
set u=null
set W4I=null
set W5I=null
endfunction
function TreeDance_Cast takes nothing returns boolean
local unit suijiTreeDanceCastUnit=GetTriggerUnit()
if suijiTreeDanceCastUnit==null or GetUnitTypeId(suijiTreeDanceCastUnit)==0 then
set suijiTreeDanceCastUnit=null
return false
endif
if GetTriggerEventId()==EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER and (GetUnitAbilityLevel(suijiTreeDanceCastUnit,'A4CP')>0 and GetIssuedOrderId()==$D010E) then
    if GetUnitAbilityLevel(suijiTreeDanceCastUnit,'A0XB')>0 and KF7(GetUnitX(suijiTreeDanceCastUnit),GetUnitY(suijiTreeDanceCastUnit),GetOrderPointX(),GetOrderPointY())>(LoadReal(TABLE_XJ,(GetHandleId(suijiTreeDanceCastUnit)),('A4D1')))+MHUnit_GetSpellRange(suijiTreeDanceCastUnit) then
        call KR7(suijiTreeDanceCastUnit)
        call X377(GetOwningPlayer(suijiTreeDanceCastUnit),"超出树木范围")
    elseif IsDestructableInRange(GetOrderPointX(),GetOrderPointY(),150)==false then
        call KR7(suijiTreeDanceCastUnit)
        call X377(GetOwningPlayer(suijiTreeDanceCastUnit),"附近没有树木")
    endif
elseif GetTriggerEventId()==EVENT_PLAYER_UNIT_SPELL_EFFECT and B287_GetSpellAbilityId()=='A4CP' then
    call TreeDance_Main()
endif
set suijiTreeDanceCastUnit=null
return false
endfunction
function PrimalSpring_Damage takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer HEI=GetHandleId(t)
local integer H5I=GetTriggerEvalCount(t)
local unit W4I=(LoadUnitHandle(TABLE_XJ,(HEI),(2)))
local unit N4I=(LoadUnitHandle(TABLE_XJ,(HEI),(17)))
local integer V6I=(LoadInteger(TABLE_XJ,(HEI),(5)))
local integer WV2=(LoadInteger(TABLE_XJ,(HEI),(39)))
local real x2=(LoadReal(TABLE_XJ,(HEI),(282)))
local real y2=(LoadReal(TABLE_XJ,(HEI),(283)))
local real x1=GetUnitX(W4I)
local real y1=GetUnitY(W4I)
local real UWO
local real P02
local real CR2
local real QPO
local real J9I
local real JAI
local real Data_A
local real Data_C
if W4I==null or N4I==null or GetUnitTypeId(W4I)==0 or GetUnitTypeId(N4I)==0 or UnitAlive(W4I)==false then
if W4I!=null and GetUnitTypeId(W4I)!=0 then
call SetUnitFlyHeight(W4I,GetUnitDefaultFlyHeight(W4I),0)
call SetUnitPathing(W4I,true)
call UnitRemoveAbility(W4I,'B0J3')
call UnitRemoveAbility(W4I,'A4D3')
call UnitRemoveAbility(W4I,'Abun')
endif
if N4I!=null then
call KillUnit(N4I)
endif
call DestroyEffect((LoadEffectHandle(TABLE_XJ,(HEI),(32))))
call DestroyEffect((LoadEffectHandle(TABLE_XJ,(HEI),(33))))
call DestroyEffect((LoadEffectHandle(TABLE_XJ,(HEI),(34))))
call DestroyEffect((LoadEffectHandle(TABLE_XJ,(HEI),(35))))
call DestroyEffect((LoadEffectHandle(TABLE_XJ,(HEI),(36))))
call FlushChildHashtable(TABLE_XJ,(HEI))
call OZ7(t)
set t=null
set W4I=null
set N4I=null
return false
endif
set UWO=AngleBetweenXY(x1,y1,x2,y2)
set P02=KF7(x1,y1,x2,y2)
set CR2=P02/IMaxBJ((57-H5I),1)
set QPO=0.48*(H5I-25)*(H5I-25)
set J9I=x1+CR2*Cos(UWO*bj_DEGTORAD)
set JAI=y1+CR2*Sin(UWO*bj_DEGTORAD)
if H5I<57 then
if KCD(W4I)==false then
call SetUnitFlyHeight(W4I,500-QPO,0)
endif
if H5I==1 and GetUnitTypeId(W4I)=='Z052' then
call SetUnitAnimationByIndex(W4I,2)
endif
call SetUnitX(W4I,J9I)
call SetUnitY(W4I,JAI)
else
if KCD(W4I)==false then
call SetUnitFlyHeight(W4I,GetUnitDefaultFlyHeight(W4I),0)
endif
call UnitRemoveAbility(W4I,'B0J3')
call SetUnitX(W4I,x2)
call SetUnitY(W4I,y2)
call SetUnitPathing(W4I,true)
call SetUnitPosition(W4I,x2,y2)
call UnitRemoveAbility(W4I,'A4D3')
call UnitRemoveAbility(W4I,'Abun')
call XF7(W4I,'A4D4')
call SetPlayerAbilityAvailable(GetOwningPlayer(W4I),'A4D4',true)
call KillUnit(N4I)
call DestroyEffect(AddSpecialEffect("tx\\qtds\\HeroMonkeyking_W1.MDX",x2,y2))
call YT7("tx\\qtds\\HeroMonkeyking_W2_circle.MDX",x2,y2,3)
set N4I=CreateUnit(GetOwningPlayer(W4I),'e00E',x2,y2,bj_UNIT_FACING)
call XF7(N4I,'A4D5')  //雷霆一击，WV2最大值为5
set Data_A=(14+V6I*14)*WV2
set Data_C=V6I*WV2*0.04
call YDWESetUnitAbilityDataReal(N4I,'A4D5', 1, ABILITY_DATA_DATA_A, Data_A)
call YDWESetUnitAbilityDataReal(N4I,'A4D5', 1, ABILITY_DATA_DATA_C, Data_C)
call IssueImmediateOrder(N4I,"thunderclap")
call DestroyEffect((LoadEffectHandle(TABLE_XJ,(HEI),(32))))
call DestroyEffect((LoadEffectHandle(TABLE_XJ,(HEI),(33))))
call DestroyEffect((LoadEffectHandle(TABLE_XJ,(HEI),(34))))
call DestroyEffect((LoadEffectHandle(TABLE_XJ,(HEI),(35))))
call DestroyEffect((LoadEffectHandle(TABLE_XJ,(HEI),(36))))
call FlushChildHashtable(TABLE_XJ,(HEI))
call OZ7(t)
endif
set t=null
set W4I=null
set N4I=null
return false
endfunction
function PrimalSpring_Move takes unit W4I,unit N4I,effect fx,integer H5I,integer V6I,real x,real y returns nothing
local trigger t
local integer HEI
local unit u=CreateUnit(GetOwningPlayer(W4I),'e00E',GetUnitX(W4I),GetUnitY(W4I),0)
call XF7(u,'A4D2')
call SetUnitAbilityLevel(u,'A4D2',2) //BUFF是B0J3
if IssueTargetOrder(u,"thunderbolt",W4I)then
call SetUnitPathing(W4I,false)
if KCD(W4I)==false then
call XF7(W4I,'Amrf')
call UnitRemoveAbility(W4I,'Amrf')
endif
set t=CreateTrigger()
set HEI=GetHandleId(t)
call SaveUnitHandle(TABLE_XJ,(HEI),(2),(W4I))
call SaveUnitHandle(TABLE_XJ,(HEI),(17),(N4I))
call SaveEffectHandle(TABLE_XJ,(HEI),(32),(fx))
call SaveEffectHandle(TABLE_XJ,(HEI),(33),(AddSpecialEffectTarget("tx\\qtds\\HeroMonkeyking_W4_Ribbon.MDX",W4I,"foot left")))
call SaveEffectHandle(TABLE_XJ,(HEI),(34),(AddSpecialEffectTarget("tx\\qtds\\HeroMonkeyking_W4_Ribbon.MDX",W4I,"foot right")))
call SaveEffectHandle(TABLE_XJ,(HEI),(35),(AddSpecialEffectTarget("tx\\qtds\\HeroMonkeyking_W4_Ribbon.MDX",W4I,"hand left")))
call SaveEffectHandle(TABLE_XJ,(HEI),(36),(AddSpecialEffectTarget("tx\\qtds\\HeroMonkeyking_W4_Ribbon.MDX",W4I,"hand right")))
call SaveReal(TABLE_XJ,(HEI),(282),((x)*1.0))
call SaveReal(TABLE_XJ,(HEI),(283),((y)*1.0))
call SaveInteger(TABLE_XJ,(HEI),(5),(V6I))
call SaveInteger(TABLE_XJ,(HEI),(39),(H5I))
call TriggerRegisterTimerEvent(t,0.01,true)
call TriggerAddCondition(t,Condition(function PrimalSpring_Damage))
endif
set t=null
set u=null
endfunction
function PrimalSpring_Effect takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer HEI=GetHandleId(t)
local integer H5I=(LoadInteger(TABLE_XJ,(HEI),(34)))
local real x=(LoadReal(TABLE_XJ,(HEI),(6)))
local real y=(LoadReal(TABLE_XJ,(HEI),(7)))
local unit N4I=(LoadUnitHandle(TABLE_XJ,(HEI),(19)))
local unit HKI=(LoadUnitHandle(TABLE_XJ,(HEI),(14)))
local effect fx=(LoadEffectHandle(TABLE_XJ,(HEI),(32)))
local integer V6I=(LoadInteger(TABLE_XJ,(HEI),(5)))
if HKI==null or N4I==null or GetUnitTypeId(HKI)==0 or GetUnitTypeId(N4I)==0 or UnitAlive(HKI)==false then
if N4I!=null then
call KillUnit(N4I)
endif
call DestroyEffect(fx)
call FlushChildHashtable(TABLE_XJ,(HEI))
call OZ7(t)
set t=null
set N4I=null
set HKI=null
set fx=null
return false
endif
if((GetTriggerEventId()==EVENT_UNIT_SPELL_ENDCAST or GetTriggerEventId()==EVENT_UNIT_SPELL_FINISH)and B287_GetSpellAbilityId()=='A4CZ') or (GetTriggerEventId()==EVENT_UNIT_SPELL_EFFECT and B287_GetSpellAbilityId()=='A4D3')then
call FlushChildHashtable(TABLE_XJ,(HEI))
call OZ7(t)
call PrimalSpring_Move(HKI,N4I,fx,H5I,V6I,x,y)
else
call SaveInteger(TABLE_XJ,(HEI),(34),YG7((H5I+1),5))
endif
set t=null
set N4I=null
set HKI=null
set fx=null
return false
endfunction
function PrimalSpring_Main takes nothing returns nothing
local unit W4I=GetTriggerUnit()
local real x=GetSpellTargetX()
local real y=GetSpellTargetY()
local unit N4I
local integer V6I=GetUnitAbilityLevel(W4I,'A4CZ')
local string s=""
local trigger t=(LoadTriggerHandle(TABLE_XJ,(GetHandleId(W4I)),('A4CP')))
local integer HEI=GetHandleId(t)
if t !=null then
call DestroyEffect((LoadEffectHandle(TABLE_XJ,(HEI),(32))))
call FogModifierStop((LoadFogModifierHandle(TABLE_XJ,(HEI),(42))))
call DestroyFogModifier((LoadFogModifierHandle(TABLE_XJ,(HEI),(42))))
call SaveTriggerHandle(TABLE_XJ,(GetHandleId(W4I)),('A4CP'),(null))
call RemoveSavedHandle(TABLE_XJ,(GetHandleId(W4I)),('A4CP'))
call FlushChildHashtable(TABLE_XJ,(HEI))
call OZ7(t)
endif
set N4I=CreateUnit(GetOwningPlayer(W4I),'h0GO',x,y,bj_UNIT_FACING)
call SetUnitAnimation(N4I,"stand")
call UnitRemoveAbility(W4I,'A0XB')
if GetUnitTypeId(W4I)=='Z052' then
call SetUnitAnimationByIndex(W4I,3)
endif
if IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(W4I))==true or WG7(GetLocalPlayer())then
call SetUnitVertexColor(N4I,250,250,128,255)
set s="tx\\qtds\\HeroMonkeyking_W3_Gather.MDX"
else
call SetUnitVertexColor(N4I,250,250,0,0)
endif
set t=CreateTrigger()
set HEI=GetHandleId(t)
call SaveUnitHandle(TABLE_XJ,(HEI),(14),(W4I))
call SaveUnitHandle(TABLE_XJ,(HEI),(19),(N4I))
call SaveEffectHandle(TABLE_XJ,(HEI),(32),(AddSpecialEffect(s,x,y)))
call SaveInteger(TABLE_XJ,(HEI),(34),(1))
call SaveInteger(TABLE_XJ,(HEI),(5),(V6I))
call SaveReal(TABLE_XJ,(HEI),(6),((x)*1.0))
call SaveReal(TABLE_XJ,(HEI),(7),((y)*1.0))
call TriggerRegisterTimerEvent(t,0.3,true)
call TriggerRegisterUnitEvent(t,W4I,EVENT_UNIT_SPELL_FINISH)
call TriggerRegisterUnitEvent(t,W4I,EVENT_UNIT_SPELL_ENDCAST)
call TriggerRegisterUnitEvent(t,W4I,EVENT_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function PrimalSpring_Effect))
call SetPlayerAbilityAvailable(GetOwningPlayer(W4I),'A4CZ',false)
call XF7(W4I,'A4D3')
call SetPlayerAbilityAvailable(GetOwningPlayer(W4I),'A4D3',true)
set t=null
set W4I=null
set N4I=null
endfunction
function PrimalSpring_Cast takes nothing returns boolean
local unit suijiPrimalSpringCastUnit=GetTriggerUnit()
if suijiPrimalSpringCastUnit==null or GetUnitTypeId(suijiPrimalSpringCastUnit)==0 then
set suijiPrimalSpringCastUnit=null
return false
endif
if B287_GetSpellAbilityId()=='A4CZ' then
if GetTriggerEventId()==EVENT_PLAYER_UNIT_SPELL_EFFECT then
call PrimalSpring_Main()
elseif YL7(GetSpellTargetX(),GetSpellTargetY())==false then
call KR7(suijiPrimalSpringCastUnit)
call X377(GetOwningPlayer(suijiPrimalSpringCastUnit),"不能以那里为目标")
elseif KF7(GetUnitX(suijiPrimalSpringCastUnit),GetUnitY(suijiPrimalSpringCastUnit),GetSpellTargetX(),GetSpellTargetY())>(LoadReal(TABLE_XJ,(GetHandleId(suijiPrimalSpringCastUnit)),('A4D1')))+MHUnit_GetSpellRange(suijiPrimalSpringCastUnit)  then
call KR7(suijiPrimalSpringCastUnit)
call X377(GetOwningPlayer(suijiPrimalSpringCastUnit),"超出乾坤之跃范围")
endif
endif
set suijiPrimalSpringCastUnit=null
return false
endfunction
function TreeDance_OnCoolDown takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer HEI=GetHandleId(t)
local unit HKI=(LoadUnitHandle(TABLE_XJ,(HEI),(2)))
local boolean b=false
if HKI==null or GetUnitTypeId(HKI)==0 or (D4 and XH7(HKI)) then
call FlushChildHashtable(TABLE_XJ,(HEI))
call OZ7(t)
set t=null
set HKI=null
return false
endif
if(LoadReal(L7,(GetHandleId(HKI)),(785)))+3>(TimerGetElapsed(W))then
set b=true
endif
if b==true then
call SetPlayerAbilityAvailable(GetOwningPlayer(HKI),'A4CP',false)
call XF7(HKI,'A4D1')
else
call SetPlayerAbilityAvailable(GetOwningPlayer(HKI),'A4CP',true)
call UnitRemoveAbility(HKI,'A4D1')
endif
set t=null
set HKI=null
return false
endfunction
function TreeDance_CoolDown takes unit HKI returns nothing
local trigger t=CreateTrigger()
local integer HEI=GetHandleId(t)
call TriggerRegisterTimerEvent(t,0.33,true)
call TriggerAddCondition(t,Condition(function TreeDance_OnCoolDown))
call SaveUnitHandle(TABLE_XJ,(HEI),(2),(HKI))
set t=null
endfunction
function TreeDance_Learn takes nothing returns nothing
local unit suijiTreeDanceLearnUnit=GetTriggerUnit()
if suijiTreeDanceLearnUnit==null or GetUnitTypeId(suijiTreeDanceLearnUnit)==0 then
set suijiTreeDanceLearnUnit=null
return
endif
if(B287_GetLearnedSkill()=='A4CP')then
if(GetUnitAbilityLevel(suijiTreeDanceLearnUnit,'A4CP')==1 and IsUnitIllusion(suijiTreeDanceLearnUnit)==false)then
call XF7(suijiTreeDanceLearnUnit,'A4CZ')
call SetPlayerAbilityAvailable(GetOwningPlayer(suijiTreeDanceLearnUnit),'A4CZ',false)
call XF7(suijiTreeDanceLearnUnit,'A4D4')
call SetPlayerAbilityAvailable(GetOwningPlayer(suijiTreeDanceLearnUnit),'A4D4',true)
call SaveReal(TABLE_XJ,(GetHandleId(suijiTreeDanceLearnUnit)),('A4D1'),(1000))
call TreeDance_CoolDown(suijiTreeDanceLearnUnit)
else
call SetUnitAbilityLevel(suijiTreeDanceLearnUnit,'A4CZ',GetUnitAbilityLevel(suijiTreeDanceLearnUnit,'A4CP'))
call SetUnitAbilityLevel(suijiTreeDanceLearnUnit,'A4D4',GetUnitAbilityLevel(suijiTreeDanceLearnUnit,'A4CP'))
endif
endif
set suijiTreeDanceLearnUnit=null
endfunction
function QTDS2 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call YB7(t,EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER)
call TriggerAddCondition(t,Condition(function TreeDance_Cast))
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_CAST)
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function PrimalSpring_Cast))
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_HERO_SKILL)
call TriggerAddAction(t,function TreeDance_Learn)
set t=null
endfunction
