function SuijiAI_HasMappedOrder takes integer skill returns boolean
return SuijiAI_TargetOrderId(skill)!=0 or SuijiAI_PointOrderId(skill)!=0 or SuijiAI_ImmediateOrderId(skill)!=0
endfunction
function SuijiAI_IsChannelOrderText takes string suijiAIChannelOrderText returns boolean
return suijiAIChannelOrderText=="channel" or suijiAIChannelOrderText=="drain"
endfunction
function SuijiAI_IsBusyChannelingOrder takes integer suijiAIChannelOrderId returns boolean
return suijiAIChannelOrderId==852480 or suijiAIChannelOrderId==852487 or suijiAIChannelOrderId==852488 or suijiAIChannelOrderId==852188 or suijiAIChannelOrderId==$D0073 or suijiAIChannelOrderId==$D0131 or suijiAIChannelOrderId==$D0207 or suijiAIChannelOrderId==$D025E or suijiAIChannelOrderId==$D0278
endfunction
function SuijiAI_IsBusyChannelingUnit takes unit suijiAIChannelUnit returns boolean
if suijiAIChannelUnit==null then
return false
endif
return SuijiAI_IsBusyChannelingOrder(GetUnitCurrentOrder(suijiAIChannelUnit))
endfunction
function SuijiAI_CanPayAndCastNormally takes unit u,integer skill returns boolean
local integer physicalSkill=0
local integer level=0
local integer manaCost=0
if u==null or skill==0 then
return false
endif
if IsUnitPaused(u) or IsUnitType(u,UNIT_TYPE_STUNNED) or IsUnitType(u,UNIT_TYPE_POLYMORPHED) then
return false
endif
if MHUnit_GetSilenceCount(u)>0 then
return false
endif
set physicalSkill=B287_GetPhysicalAbilityId(u,skill)
set level=GetUnitAbilityLevel(u,physicalSkill)
if level<=0 then
return false
endif
if MHAbility_GetCooldown(u,physicalSkill)>0. then
return false
endif
set manaCost=MHAbility_GetLevelDefDataInt(physicalSkill,level,ABILITY_LEVEL_DEF_DATA_MANA_COST)
if manaCost>0 and GetUnitState(u,UNIT_STATE_MANA)+.01<I2R(manaCost) then
return false
endif
return true
endfunction
function SuijiAI_CanDirectCast takes unit u,unit target,integer skill,string order returns boolean
if u==null or target==null then
return false
endif
if skill==0 or order=="passive" then
return false
endif
if order=="" and not SuijiAI_HasMappedOrder(skill) and B287_MHAbility_IsPassive(u,skill) then
return false
endif
if UnitAlive(u)==false or UnitAlive(target)==false then
return false
endif
if SuijiAI_CanPayAndCastNormally(u,skill)==false then
return false
endif
if SUIJI_MODE and GetPlayerController(GetOwningPlayer(u))==MAP_CONTROL_COMPUTER and OO7(GetHandleId(u),"SuijiDone") and SuijiAI_IsBusyChannelingUnit(u) then
return false
endif
if SUIJI_MODE and GetPlayerController(GetOwningPlayer(u))==MAP_CONTROL_COMPUTER and OO7(GetHandleId(u),"SuijiDone") and (skill=='A03R' or skill=='A0AV') and LoadTriggerHandle(L7,GetHandleId(u),StringHash("SuijiFreezingFieldTrigger"))!=null then
return false
endif
if SUIJI_MODE and GetPlayerController(GetOwningPlayer(u))==MAP_CONTROL_COMPUTER and OO7(GetHandleId(u),"SuijiDone") and (skill=='A06R' or skill=='A1B4') and LoadTriggerHandle(L7,GetHandleId(u),StringHash("SuijiSandKingEpicenterTrigger"))!=null then
return false
endif
if SUIJI_MODE and GetPlayerController(GetOwningPlayer(u))==MAP_CONTROL_COMPUTER and OO7(GetHandleId(u),"SuijiDone") and (IsUnitType(target,UNIT_TYPE_HERO)==false or IsUnitIllusion(target) or IsUnitEnemy(target,GetOwningPlayer(u))==false) then
return false
endif
if IsUnitAlly(target,GetOwningPlayer(u)) or IsHideUnit(target) or IsUnitVisible(target,GetOwningPlayer(u))==false then
return false
endif
if (skill=='A0QR' or skill=='A1B3') and IsUnitInRange(u,target,600.)==false then
return false
endif
if skill=='A05V' and IsUnitInRange(u,target,500.)==false then
return false
endif
if skill=='A2IS' and IsUnitInRange(u,target,430.)==false then
return false
endif
return AI_SKILL_OK(u,skill)
endfunction
function SuijiAI_IssueMappedTarget takes unit u,unit target,integer X5 returns boolean
local integer O5=GetPlayerId(GetOwningPlayer(u))
local boolean done=false
if X5==0 or target==null then
return false
endif
call DisableTrigger(Q04[O5])
set done=IssueTargetOrderById(u,X5,target)
call EnableTrigger(Q04[O5])
return done
endfunction
function SuijiAI_IssueMappedPoint takes unit u,real x,real y,integer X5 returns boolean
local integer O5=GetPlayerId(GetOwningPlayer(u))
local boolean done=false
if X5==0 then
return false
endif
call DisableTrigger(Q04[O5])
set done=IssuePointOrderById(u,X5,x,y)
call EnableTrigger(Q04[O5])
return done
endfunction
function SuijiAI_IssueMappedImmediate takes unit u,integer X5 returns boolean
local integer O5=GetPlayerId(GetOwningPlayer(u))
local boolean done=false
if X5==0 then
return false
endif
call DisableTrigger(Q04[16+O5])
set done=IssueImmediateOrderById(u,X5)
call EnableTrigger(Q04[16+O5])
return done
endfunction
function SuijiAI_CastMappedOrder takes unit u,unit target,integer skill,string order returns boolean
local player p=null
local integer X5=0
if GetUnitAbilityLevel(u,skill)<=0 then
return false
endif
set p=GetOwningPlayer(u)
call SetPlayerAbilityAvailable(p,skill,true)
if SuijiAI_IsSelfTargetOrder(order) then
set X5=SuijiAI_TargetOrderId(skill)
if SuijiAI_IssueMappedTarget(u,u,X5) then
set p=null
return true
endif
elseif SuijiAI_IsPointOrder(order) then
set X5=SuijiAI_PointOrderId(skill)
if SuijiAI_IssueMappedPoint(u,GetUnitX(target),GetUnitY(target),X5) then
set p=null
return true
endif
set X5=SuijiAI_TargetOrderId(skill)
if SuijiAI_IssueMappedTarget(u,target,X5) then
set p=null
return true
endif
elseif SuijiAI_IsImmediateOrder(order) then
set X5=SuijiAI_ImmediateOrderId(skill)
if SuijiAI_IssueMappedImmediate(u,X5) then
set p=null
return true
endif
else
set X5=SuijiAI_TargetOrderId(skill)
if SuijiAI_IssueMappedTarget(u,target,X5) then
set p=null
return true
endif
endif
set X5=SuijiAI_PointOrderId(skill)
if SuijiAI_IssueMappedPoint(u,GetUnitX(target),GetUnitY(target),X5) then
set p=null
return true
endif
set X5=SuijiAI_ImmediateOrderId(skill)
if SuijiAI_IssueMappedImmediate(u,X5) then
set p=null
return true
endif
set X5=SuijiAI_TargetOrderId(skill)
if SuijiAI_IssueMappedTarget(u,target,X5) then
set p=null
return true
endif
set p=null
return false
endfunction
function SuijiAI_CastByOrder takes unit u,unit target,integer skill,string order returns boolean
local boolean done=false
if not SuijiAI_CanDirectCast(u,target,skill,order) then
return false
endif
call SuijiAI_RestoreVisibleSkills(u)
if SuijiAI_CastMappedOrder(u,target,skill,order) then
call SuijiTest_NotifyAICastSuccess(u,skill)
return true
endif
if order=="" then
return false
endif
if SuijiAI_IsSelfTargetOrder(order) then
set done=IssueTargetOrder(u,order,u)
if done then
call SuijiTest_NotifyAICastSuccess(u,skill)
return true
endif
endif
if SuijiAI_IsImmediateOrder(order) then
set done=IssueImmediateOrder(u,order)
if done then
call SuijiTest_NotifyAICastSuccess(u,skill)
endif
return done
endif
if SuijiAI_IsPointOrder(order) then
set done=IssuePointOrder(u,order,GetUnitX(target),GetUnitY(target))
if done then
call SuijiTest_NotifyAICastSuccess(u,skill)
return true
endif
set done=IssueTargetOrder(u,order,target)
if done then
call SuijiTest_NotifyAICastSuccess(u,skill)
endif
return done
endif
set done=IssueTargetOrder(u,order,target)
if done then
call SuijiTest_NotifyAICastSuccess(u,skill)
return true
endif
if order=="channel" then
set done=IssuePointOrder(u,order,GetUnitX(target),GetUnitY(target))
if done then
call SuijiTest_NotifyAICastSuccess(u,skill)
return true
endif
set done=IssueImmediateOrder(u,order)
if done then
call SuijiTest_NotifyAICastSuccess(u,skill)
endif
return done
endif
set done=IssuePointOrder(u,order,GetUnitX(target),GetUnitY(target))
if done then
call SuijiTest_NotifyAICastSuccess(u,skill)
endif
return done
endfunction
function SuijiAI_TemplateRange takes unit u,integer skill,real fallback returns real
local integer level=GetUnitAbilityLevel(u,skill)
local integer value=0
if level<1 then
return fallback
endif
if level>4 then
set level=4
endif
set value=LoadInteger(C_4,skill,7+level)
if value<=0 then
return fallback
endif
if value>1600 then
return 1600.
endif
return I2R(value)+75.
endfunction
function SuijiAI_TemplateInRange takes unit u,unit target,integer skill,real fallback returns boolean
return target!=null and IsUnitInRange(u,target,SuijiAI_TemplateRange(u,skill,fallback))
endfunction
function SuijiAI_TemplatePointCast takes unit u,unit target,integer skill,integer orderId,real fallback returns boolean
if orderId==0 or SuijiAI_TemplateInRange(u,target,skill,fallback)==false then
return false
endif
call SetPlayerAbilityAvailable(GetOwningPlayer(u),skill,true)
if SuijiAI_IssueMappedPoint(u,GetUnitX(target),GetUnitY(target),orderId) then
call SuijiTest_NotifyAICastSuccess(u,skill)
return true
endif
return false
endfunction
function SuijiAI_TemplateTargetCast takes unit u,unit target,integer skill,integer orderId,real fallback returns boolean
if orderId==0 or SuijiAI_TemplateInRange(u,target,skill,fallback)==false then
return false
endif
return M57(u,orderId,skill,target)
endfunction
function SuijiAI_TemplateImmediateCast takes unit u,unit target,integer skill,integer orderId,real fallback returns boolean
if orderId==0 then
return false
endif
if SuijiAI_TemplateInRange(u,target,skill,fallback)==false and MP7(450.,u,Condition(function k8))<=0 then
return false
endif
return N97(u,orderId,skill)
endfunction
function SuijiAI_TrySkillTemplateSpecial takes unit u,unit target,integer skill returns boolean
local player p=null
local boolean done=false
if skill=='A1SA' or skill=='A2ZU' or skill=='A2ZV' or skill=='A2ZW' then
if SuijiAI_TemplateInRange(u,target,skill,800.)==false then
return false
endif
set p=GetOwningPlayer(u)
call SetPlayerAbilityAvailable(p,'A2ZU',true)
call SetPlayerAbilityAvailable(p,'A2ZV',true)
call SetPlayerAbilityAvailable(p,'A2ZW',true)
set done=SuijiAI_IssueMappedTarget(u,target,852111)
if done then
call SuijiTest_NotifyAICastSuccess(u,skill)
endif
set p=null
return done
endif
if skill=='A0OJ' or skill=='A2ZY' or skill=='A2ZZ' then
if SuijiAI_TemplateInRange(u,target,skill,650.)==false then
return false
endif
set p=GetOwningPlayer(u)
call B287_SetPlayerAbilityAvailable(p,'A0OJ',true)
call SetPlayerAbilityAvailable(p,'A2ZY',true)
call SetPlayerAbilityAvailable(p,'A2ZZ',true)
set done=SuijiAI_IssueMappedTarget(u,target,852602)
if done then
call SuijiTest_NotifyAICastSuccess(u,skill)
endif
set p=null
return done
endif
if skill=='A4F4' or skill=='A4F5' or skill=='A4FU' then
if SuijiAI_TemplateInRange(u,target,skill,800.)==false then
return false
endif
set p=GetOwningPlayer(u)
call SetPlayerAbilityAvailable(p,'A4F4',true)
call SetPlayerAbilityAvailable(p,'A4F5',true)
call SetPlayerAbilityAvailable(p,'A4FU',true)
set done=SuijiAI_IssueMappedTarget(u,target,852231)
if done then
call SuijiTest_NotifyAICastSuccess(u,skill)
endif
set p=null
return done
endif
if skill=='A1T5' or skill=='A235' then
set done=SuijiAI_TemplatePointCast(u,target,skill,852089,900.)
if done==false and SuijiAI_TemplateInRange(u,target,skill,900.) then
set p=GetOwningPlayer(u)
call B287_SetPlayerAbilityAvailable(p,'A1T5',true)
call B287_SetPlayerAbilityAvailable(p,'A235',true)
set done=SuijiAI_IssueMappedPoint(u,GetUnitX(target),GetUnitY(target),852089)
if done then
call SuijiTest_NotifyAICastSuccess(u,skill)
endif
set p=null
endif
return done
endif
if skill=='A28Q' then
if GetUnitAbilityLevel(u,'B08A')==0 then
if GetUnitLifePercent(u)>35. and SuijiAI_TemplateInRange(u,target,skill,700.) then
return N97(u,852589,skill)
endif
else
if GetUnitLifePercent(u)<25. or target==null then
return N97(u,852590,skill)
endif
endif
return false
endif
if skill=='A1IN' then
if GetUnitLifePercent(u)<45. then
return N97(u,852129,skill)
endif
return false
endif
if skill=='A1T8' then
set done=N97(u,852526,skill)
if done then
call IssueImmediateOrderById(u,852490)
endif
return done
endif
return false
endfunction
function SuijiAI_TrySkillTemplateNormalFallback takes unit u,unit target,integer skill,string order returns boolean
local boolean done=false
if order=="" or target==null then
return false
endif
call SetPlayerAbilityAvailable(GetOwningPlayer(u),skill,true)
if SuijiAI_IsPointOrder(order) then
set done=IssuePointOrder(u,order,GetUnitX(target),GetUnitY(target))
elseif SuijiAI_IsImmediateOrder(order) then
set done=IssueImmediateOrder(u,order)
elseif SuijiAI_IsSelfTargetOrder(order) then
set done=IssueTargetOrder(u,order,u)
else
set done=IssueTargetOrder(u,order,target)
endif
if done then
call SuijiTest_NotifyAICastSuccess(u,skill)
endif
return done
endfunction
function SuijiAI_TrySkillTemplate takes unit u,unit target,integer skill,string order returns boolean
local integer targetOrder=SuijiAI_TargetOrderId(skill)
local integer pointOrder=SuijiAI_PointOrderId(skill)
local integer immediateOrder=SuijiAI_ImmediateOrderId(skill)
if not SuijiAI_CanDirectCast(u,target,skill,order) then
return false
endif
call SuijiAI_RestoreVisibleSkills(u)
if SuijiAI_TrySkillTemplateSpecial(u,target,skill) then
return true
endif
if order=="" and targetOrder==0 and pointOrder==0 and immediateOrder==0 then
return SuijiAI_TrySkillTemplateNormalFallback(u,target,skill,order)
endif
if SuijiAI_IsPointOrder(order) then
if SuijiAI_TemplatePointCast(u,target,skill,pointOrder,800.) then
return true
endif
if SuijiAI_TemplateTargetCast(u,target,skill,targetOrder,800.) then
return true
endif
elseif SuijiAI_IsImmediateOrder(order) then
if SuijiAI_TemplateImmediateCast(u,target,skill,immediateOrder,650.) then
return true
endif
if SuijiAI_TemplateTargetCast(u,target,skill,targetOrder,800.) then
return true
endif
elseif SuijiAI_IsSelfTargetOrder(order) then
if SuijiAI_TemplateTargetCast(u,u,skill,targetOrder,800.) then
return true
endif
else
if SuijiAI_TemplateTargetCast(u,target,skill,targetOrder,800.) then
return true
endif
if SuijiAI_TemplatePointCast(u,target,skill,pointOrder,800.) then
return true
endif
if SuijiAI_TemplateImmediateCast(u,target,skill,immediateOrder,650.) then
return true
endif
endif
return SuijiAI_TrySkillTemplateNormalFallback(u,target,skill,order)
endfunction
function SuijiAI_SoftCooldownDuration takes unit suijiAICoolUnit,integer suijiAICoolSkill,real suijiAICoolFallback returns real
local integer suijiAICoolLevel=0
local real suijiAICoolDuration=0.
local real suijiAICoolReduce=0.
if suijiAICoolUnit==null or suijiAICoolSkill==0 then
return suijiAICoolFallback
endif
set suijiAICoolLevel=GetUnitAbilityLevel(suijiAICoolUnit,suijiAICoolSkill)
if suijiAICoolLevel>0 then
set suijiAICoolDuration=MHAbility_GetLevelDefDataReal(suijiAICoolSkill,suijiAICoolLevel,ABILITY_LEVEL_DEF_DATA_COOLDOWN)
endif
if suijiAICoolDuration<=0. then
set suijiAICoolDuration=MHAbility_GetMaxCooldown(suijiAICoolUnit,suijiAICoolSkill)
endif
if suijiAICoolDuration<=0. then
set suijiAICoolDuration=suijiAICoolFallback
endif
set suijiAICoolReduce=ReduceUnitAbilityCoolDownReal(suijiAICoolUnit)
if suijiAICoolReduce>0. then
set suijiAICoolDuration=suijiAICoolDuration*suijiAICoolReduce
endif
if suijiAICoolDuration<.80 then
set suijiAICoolDuration=.80
endif
return suijiAICoolDuration
endfunction
function SuijiAI_SoftCooldownReady takes unit suijiAICoolUnit,string suijiAICoolMark returns boolean
if suijiAICoolUnit==null then
return false
endif
return ON7(GetHandleId(suijiAICoolUnit),"SuijiAI|Soft|"+suijiAICoolMark)<=TimerGetElapsed(W)
endfunction
function SuijiAI_SetSoftCooldown takes unit suijiAICoolUnit,string suijiAICoolMark,integer suijiAICoolSkill,real suijiAICoolFallback returns nothing
local real suijiAICoolDuration=0.
if SUIJI_MODE and suijiAICoolUnit!=null and suijiAICoolSkill!=0 and GetPlayerController(GetOwningPlayer(suijiAICoolUnit))==MAP_CONTROL_COMPUTER then
if suijiAICoolFallback<2. then
if suijiAICoolMark=="SuijiUlt" then
set suijiAICoolFallback=6.
else
set suijiAICoolFallback=3.
endif
endif
set suijiAICoolDuration=SuijiAI_SoftCooldownDuration(suijiAICoolUnit,suijiAICoolSkill,suijiAICoolFallback)
call NQ7(GetHandleId(suijiAICoolUnit),"SuijiAI|Soft|"+suijiAICoolMark,TimerGetElapsed(W)+suijiAICoolDuration)
endif
endfunction
function SuijiAI_TryOneGeneric takes unit u,unit target,string mark returns boolean
local integer h=GetHandleId(u)
local integer skill=OM7(h,mark+"Skill")
local integer helper=OM7(h,mark+"Helper")
local string order=OP7(h,mark+"Order")
local integer oldOrderId=SUIJI_AI_ORDER_ID
local integer oldSkillId=SUIJI_AI_SKILL_ID
local integer oldHelperId=SUIJI_AI_HELPER_ID
local integer oldTemplateId=SUIJI_AI_TEMPLATE_UNIT_ID
local boolean oldCasting=SUIJI_AI_CASTING
local boolean done=false
set SUIJI_AI_CASTING=true
set SUIJI_AI_ORDER_ID=0
set SUIJI_AI_SKILL_ID=skill
set SUIJI_AI_HELPER_ID=helper
set SUIJI_AI_TEMPLATE_UNIT_ID=OM7(h,mark+"SourceType")
set done=SuijiAI_TrySkillTemplate(u,target,skill,order)
if not done then
set done=SuijiAI_CastByOrder(u,target,skill,order)
endif
if done then
call SuijiAI_SetSoftCooldown(u,mark,skill,1.50)
endif
set SUIJI_AI_ORDER_ID=oldOrderId
set SUIJI_AI_SKILL_ID=oldSkillId
set SUIJI_AI_HELPER_ID=oldHelperId
set SUIJI_AI_TEMPLATE_UNIT_ID=oldTemplateId
set SUIJI_AI_CASTING=oldCasting
set order=""
return done
endfunction
function SuijiAI_IsHeroTarget takes unit u,unit target returns boolean
if u==null or target==null then
return false
endif
if GetWidgetLife(target)<=.405 then
return false
endif
if IsUnitType(target,UNIT_TYPE_HERO)==false or IsUnitIllusion(target) then
return false
endif
if IsUnitEnemy(target,GetOwningPlayer(u))==false then
return false
endif
if IsHideUnit(target) or IsUnitVisible(target,GetOwningPlayer(u))==false then
return false
endif
return true
endfunction
function SuijiAI_PickHeroTarget takes unit u,unit fallback returns unit
local group g=null
local unit t=null
local unit best=null
local real life=0.
local real bestLife=0.
if SuijiAI_IsHeroTarget(u,fallback) then
return fallback
endif
if u==null then
return null
endif
set g=WS7()
call GroupEnumUnitsInRange(g,GetUnitX(u),GetUnitY(u),1200.,Condition(function TO7))
loop
set t=FirstOfGroup(g)
exitwhen t==null
call GroupRemoveUnit(g,t)
if SuijiAI_IsHeroTarget(u,t) then
set life=GetWidgetLife(t)
if best==null or life<bestLife then
set best=t
set bestLife=life
endif
endif
endloop
call WR7(g)
set g=null
set t=null
if best!=null then
return best
endif
return null
endfunction
function SuijiAI_TryRandomGeneric takes unit u,unit target returns boolean
local unit castTarget=null
local boolean done=false
if u==null or target==null then
return false
endif
set castTarget=SuijiAI_PickHeroTarget(u,target)
if castTarget==null then
return false
endif
if SuijiAI_IsHeroTarget(u,castTarget)==false then
set castTarget=null
return false
endif
if SuijiAI_TryOneGeneric(u,castTarget,"SuijiUlt") then
set castTarget=null
return true
endif
if SuijiAI_TryOneGeneric(u,castTarget,"SuijiSmall") then
set castTarget=null
return true
endif
set done=SuijiAI_TryOneGeneric(u,castTarget,"SuijiUlt")
set castTarget=null
return done
endfunction
function SuijiAI_CanTryMark takes unit u,string mark,real delay returns boolean
local integer h=0
local integer skill=0
local string order=""
if u==null then
return false
endif
set h=GetHandleId(u)
if not SUIJI_MODE or not OO7(h,"SuijiDone") then
return false
endif
set skill=OM7(h,mark+"Skill")
set order=OP7(h,mark+"Order")
if skill==0 or order=="passive" then
return false
endif
if order=="" and not SuijiAI_HasMappedOrder(skill) and B287_MHAbility_IsPassive(u,skill) then
return false
endif
if not AI_SKILL_OK(u,skill) then
return false
endif
if not SuijiAI_SoftCooldownReady(u,mark) then
return false
endif
if ON7(h,"SuijiAI|"+mark)>TimerGetElapsed(W) then
return false
endif
call NQ7(h,"SuijiAI|"+mark,TimerGetElapsed(W)+delay)
return true
endfunction
function SuijiAI_CanPulseMark takes unit u,string mark,real delay returns boolean
local integer h=0
local integer skill=0
local string order=""
if u==null then
return false
endif
set h=GetHandleId(u)
if not SUIJI_MODE or not OO7(h,"SuijiDone") then
return false
endif
set skill=OM7(h,mark+"Skill")
set order=OP7(h,mark+"Order")
if skill==0 or order=="passive" then
return false
endif
if order=="" and not SuijiAI_HasMappedOrder(skill) and B287_MHAbility_IsPassive(u,skill) then
return false
endif
if not AI_SKILL_OK(u,skill) then
return false
endif
if not SuijiAI_SoftCooldownReady(u,mark) then
return false
endif
return ON7(h,"SuijiAI|Pulse|"+mark)<=TimerGetElapsed(W)
endfunction
function SuijiAI_TryPulseMark takes unit u,unit target,string mark,real delay returns boolean
local integer h=GetHandleId(u)
local integer skill=OM7(h,mark+"Skill")
local integer helper=OM7(h,mark+"Helper")
local string order=OP7(h,mark+"Order")
local integer oldOrderId=SUIJI_AI_ORDER_ID
local integer oldSkillId=SUIJI_AI_SKILL_ID
local integer oldHelperId=SUIJI_AI_HELPER_ID
local integer oldTemplateId=SUIJI_AI_TEMPLATE_UNIT_ID
local boolean done=false
if target==null or not SuijiAI_CanPulseMark(u,mark,delay) then
set order=""
return false
endif
set SUIJI_AI_ORDER_ID=0
set SUIJI_AI_SKILL_ID=skill
set SUIJI_AI_HELPER_ID=helper
set SUIJI_AI_TEMPLATE_UNIT_ID=OM7(h,mark+"SourceType")
set done=SuijiAI_TrySkillTemplate(u,target,skill,order)
if not done then
set done=SuijiAI_CastByOrder(u,target,skill,order)
endif
set SUIJI_AI_ORDER_ID=oldOrderId
set SUIJI_AI_SKILL_ID=oldSkillId
set SUIJI_AI_HELPER_ID=oldHelperId
set SUIJI_AI_TEMPLATE_UNIT_ID=oldTemplateId
if done then
call SuijiAI_SetSoftCooldown(u,mark,skill,1.50)
call NQ7(h,"SuijiAI|Pulse|"+mark,TimerGetElapsed(W)+delay)
set order=""
return true
endif
set order=""
return false
endfunction
function SuijiAI_TryPulseUnit takes unit u returns boolean
local unit target=null
local boolean done=false
if u==null or SUIJI_MODE==false or SUIJI_AI_CASTING then
return false
endif
if GetPlayerController(GetOwningPlayer(u))!=MAP_CONTROL_COMPUTER or OO7(GetHandleId(u),"SuijiDone")==false then
return false
endif
if UnitAlive(u)==false or IsUnitIllusion(u) or IsHideUnit(u) then
return false
endif
if SuijiAI_IsBusyChannelingUnit(u) then
return false
endif
set target=SuijiAI_PickHeroTarget(u,u)
if target==null then
return false
endif
set SUIJI_AI_CASTING=true
if GetRandomInt(1,2)==1 then
set done=SuijiAI_TryPulseMark(u,target,"SuijiSmall",.45)
if not done then
set done=SuijiAI_TryPulseMark(u,target,"SuijiUlt",.65)
endif
else
set done=SuijiAI_TryPulseMark(u,target,"SuijiUlt",.65)
if not done then
set done=SuijiAI_TryPulseMark(u,target,"SuijiSmall",.45)
endif
endif
call SuijiAI_RestoreVisibleSkills(u)
set SUIJI_AI_CASTING=false
set target=null
return done
endfunction
function SuijiAI_PulseRandomCasts takes nothing returns boolean
local integer i=0
loop
