call TriggerRegisterUnitEvent(t,BB7,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function Q6E))
call NT7(OB7,"Source",p5)
call NT7(OB7,"Caster",BB7)
call NB7(OB7,"ActiveGroup",WS7())
set p5=null
call RemoveLocation(l)
set l=null
set BB7=null
set t=null
endfunction
function Q0E takes nothing returns boolean
if B287_GetSpellAbilityId()=='A1HS' then
call Q1E()
endif
return false
endfunction
function NP8 takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
local player p
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function Q0E))
set t=null
loop
exitwhen i>5
set p=Z7[i]
call SetPlayerAbilityAvailable(p,'A1HZ',false)
call SetPlayerAbilityAvailable(p,'A1I4',false)
call SetPlayerAbilityAvailable(p,'A1I3',false)
call SetPlayerAbilityAvailable(p,'A1I6',false)
set p=A7[i]
call SetPlayerAbilityAvailable(p,'A1HZ',false)
call SetPlayerAbilityAvailable(p,'A1I4',false)
call SetPlayerAbilityAvailable(p,'A1I3',false)
call SetPlayerAbilityAvailable(p,'A1I6',false)
set i=i+1
endloop
set p=null
endfunction
function Q5E takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit p5=O77(OB7,"Source")
local unit m5=O77(OB7,"Target")
local real x=ON7(OB7,"x")
local real y=ON7(OB7,"y")
local integer V77=OM7(OB7,"Level")
local unit BB7
local real YM7=(100+50*V77)/4
if p5==null or m5==null or GetUnitTypeId(p5)==0 or GetUnitTypeId(m5)==0 or UnitAlive(p5)==false or UnitAlive(m5)==false then
call DestroyEffect(OG7(OB7,"FX"))
call DestroyEffect(OG7(OB7,"fx2"))
if m5!=null and GetUnitTypeId(m5)!=0 then
call UnitRemoveAbility(m5,'A1J9')
call UnitRemoveAbility(m5,'B0CC')
endif
call NM7(OB7)
call OZ7(t)
set t=null
set p5=null
set m5=null
set BB7=null
return false
endif
if GetTriggerEventId()==EVENT_UNIT_DEATH or KF7(x,y,GetUnitX(m5),GetUnitY(m5))>765 or GetUnitAbilityLevel(m5,'B0CC')==0 then
call DestroyEffect(OG7(OB7,"FX"))
call DestroyEffect(OG7(OB7,"fx2"))
call UnitRemoveAbility(m5,'A1J9')
call UnitRemoveAbility(m5,'B0CC')
call NM7(OB7)
call OZ7(t)
elseif GetTriggerEvalCount(t)==($A*.8)then
call DestroyEffect(OG7(OB7,"FX"))
call NU7(OB7,"FX",AddSpecialEffectTarget("war3mapImported\\ShivasEnchantment.mdx",m5,"overhead"))
call B67(p5,m5,1,YM7)
elseif GetTriggerEvalCount(t)==($A*1.7)then
call DestroyEffect(OG7(OB7,"FX"))
call NU7(OB7,"FX",AddSpecialEffectTarget("war3mapImported\\ShivasEnchantment.mdx",m5,"overhead"))
call B67(p5,m5,1,YM7)
elseif GetTriggerEvalCount(t)==($A*2.6)then
call DestroyEffect(OG7(OB7,"FX"))
call NU7(OB7,"FX",AddSpecialEffectTarget("war3mapImported\\ShivasEnchantment.mdx",m5,"overhead"))
call B67(p5,m5,1,YM7)
elseif GetTriggerEvalCount(t)==($A*3.5)then
call DestroyEffect(OG7(OB7,"FX"))
call B67(p5,m5,1,YM7)
elseif GetTriggerEvalCount(t)>($A*3.9)then
call DestroyEffect(OG7(OB7,"fx2"))
call UnitRemoveAbility(m5,'A1J9')
call UnitRemoveAbility(m5,'B0CC')
call NM7(OB7)
call OZ7(t)
set BB7=CreateUnit(GetOwningPlayer(m5),'e00E',GetUnitX(m5),GetUnitY(m5),0)
call XF7(BB7,'A1MJ')
call SetUnitAbilityLevel(BB7,'A1MJ',V77)
call IssueTargetOrderById(BB7,$D007F,m5)
call UnitApplyTimedLife(BB7,'BTLF',1.)
set BB7=null
endif
set t=null
set p5=null
set m5=null
return false
endfunction
function Q2E_A takes nothing returns boolean
return IsUnitEnemy(IN4,GetOwningPlayer(GetFilterUnit())) and GetUnitAbilityLevel(GetFilterUnit(),'A04R')==0 and (IsUnitType(GetFilterUnit(),UNIT_TYPE_HERO) or AS7(GetFilterUnit())) and UnitAlive(GetFilterUnit()) and WF7(GetFilterUnit())==false and IsHideUnit(GetFilterUnit())==false and IsUnitVisible(GetFilterUnit(),GetOwningPlayer(IN4))
endfunction
function Q2E takes nothing returns nothing
local unit p5=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local trigger t=null
local integer OB7=0
local integer V77=0
local string s="Doodads\\Cinematic\\GlowingRunes\\GlowingRunes4.mdl"
local group g
local unit BB7
local boolexpr q2eFilter=null
if p5==null or m5==null or GetUnitTypeId(p5)==0 or GetUnitTypeId(m5)==0 then
set p5=null
set m5=null
set t=null
set g=null
set BB7=null
set q2eFilter=null
return
endif
set t=CreateTrigger()
set OB7=GetHandleId(t)
set V77=B287_GetUnitAbilityLevel(p5,'A1MG')
call XF7(m5,'A1J9')
call NT7(OB7,"Source",p5)
call NT7(OB7,"Target",m5)
call NQ7(OB7,"x",GetUnitX(m5)*1.)
call NQ7(OB7,"y",GetUnitY(m5)*1.)
call NP7(OB7,"Level",V77)
call NU7(OB7,"FX",AddSpecialEffectTarget("war3mapImported\\ShivasEnchantment.mdx",m5,"overhead"))
call NU7(OB7,"fx2",AddSpecialEffect(s,GetUnitX(m5),GetUnitY(m5)))
call TriggerRegisterTimerEvent(t,.1,true)
call TriggerRegisterUnitEvent(t,m5,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function Q5E))
call LINGXIA(p5,m5)
if GetUnitTypeId(p5)!='e00E' and SuijiMode_HasAghanimState(p5) then
    set g=WS7()
    set IN4=p5
    set q2eFilter=Condition(function Q2E_A)
    call GroupEnumUnitsInRange(g,GetUnitX(m5),GetUnitY(m5),400,q2eFilter)
    call DestroyBoolExpr(q2eFilter)
    set q2eFilter=null
    call GroupRemoveUnit(g,m5)
    set m5=GroupPickRandomUnit(g)
    if m5!=null then
        if WQ7(m5) then
            call PLK(m5)
        else
set BB7=CreateUnit(GetOwningPlayer(p5),'e00E',GetUnitX(m5),GetUnitY(m5),0)
            call XF7(BB7,'A1MG')
            if ISLABIKE(p5) then
                call B287_SetUnitAbilityLevel(BB7,'A1MG',4)
            else
                call B287_SetUnitAbilityLevel(BB7,'A1MG',B287_GetUnitAbilityLevel(p5,'A1MG'))
            endif
            call IssueTargetOrderById(BB7,$D0278,m5)
            call UnitApplyTimedLife(BB7,'BTLF',1.)
        endif
    endif
    call WR7(g)
endif
set p5=null
set m5=null
set t=null
set g=null
set BB7=null
set q2eFilter=null
endfunction
function Q_E takes nothing returns boolean
local unit suijiColdFeetCaster=GetTriggerUnit()
local unit suijiColdFeetTarget=GetSpellTargetUnit()
if B287_GetSpellAbilityId()=='A1MG' and suijiColdFeetCaster!=null and suijiColdFeetTarget!=null and GetUnitTypeId(suijiColdFeetCaster)!=0 and GetUnitTypeId(suijiColdFeetTarget)!=0 and WQ7(suijiColdFeetTarget)==false then
call Q2E()
endif
set suijiColdFeetCaster=null
set suijiColdFeetTarget=null
return false
endfunction
