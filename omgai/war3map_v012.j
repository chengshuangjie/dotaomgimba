function JQR2 takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit WI7=O77(OB7,"Hero")
local real YM7=ON7(OB7,"YM7")
local real x0=ON7(OB7,"X")
local real y0=ON7(OB7,"Y")
local integer WF8=GetTriggerEvalCount(t)
if WF8>5 then
call NM7(OB7)
call OZ7(t)
else
call JQR3(WI7,x0,y0,YM7)
endif
set t=null
set WI7=null
return false
endfunction
function JQR takes nothing returns nothing
local unit WI7=GetTriggerUnit()
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local integer id=GetUnitTypeId(WI7)
local integer level=B287_GetUnitAbilityLevel(WI7,'A0BQ')
local real YM7=level*20
local real x0=GetSpellTargetX()
local real y0=GetSpellTargetY()
call TriggerRegisterTimerEvent(t,1.,true)
call TriggerRegisterTimerEvent(t,0,false)
call TriggerAddCondition(t,Condition(function JQR2))
call NT7(OB7,"Hero",WI7)
call NQ7(OB7,"YM7",YM7)
call NQ7(OB7,"X",x0)
call NQ7(OB7,"Y",y0)
set t=null
set WI7=null
endfunction
//机器人
function KZD takes nothing returns boolean
if B287_GetSpellAbilityId()=='A0BQ' then
call JQR()
endif
return false
endfunction
function GM8 takes nothing returns nothing
local trigger t=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function KZD))
set t=null
endfunction
function TSv takes nothing returns boolean
return (AR7() and IsUnitType(GetFilterUnit(),UNIT_TYPE_HERO) or IsUnitIllusion(GetFilterUnit()) and lWA(GetFilterUnit(),GetOwningPlayer(IN4)) and lZA(GetFilterUnit())==false and fWA(GetFilterUnit())==false and LoadInteger(L7,GetHandleId(GetFilterUnit()),'A2UR')!=1)!=null
endfunction

function LASER_TRI takes nothing returns nothing
	local unit ZX7 = U22
	local unit IH7 = W22
	local integer h = GetHandleId(GetTriggeringTrigger())
	local integer level = LoadInteger(TABLE_HY, h, 10)
	local real d
	set d =level*80
    call B67(ZX7, IH7, 3, d)
    call Z57(IH7,'A4J5',1,2.5+0.5*level,'B02P')
    if B287_GetUnitAbilityLevel(ZX7,'A049')>0 then
        call LINGXIA(ZX7,IH7)
    endif
	set ZX7 = null
	set IH7 = null
endfunction
function LASER_RANGE2 takes nothing returns nothing
    local unit ZX7=IN4
    local unit IH7=IP4
    local unit m5=GetEnumUnit()
    local trigger t
    local integer level=AL4
    if WQ7(m5)==false then
        set t=NHX_TANSHE(ZX7, IH7, m5,'h0HH', "LASER_TRI",2000, true, "war3mapImported\\laser.MDX")
        call SaveInteger(TABLE_HY, GetHandleId(t), 10, level)
    else
        call PLK(m5)
    endif
    set t=null
    set ZX7=null
    set IH7=null
    set m5=null
endfunction
function LASER_RANGE takes nothing returns nothing
	local unit ZX7 = U22
	local unit IH7 = W22
	local integer h = GetHandleId(GetTriggeringTrigger())
	local integer level = LoadInteger(TABLE_HY, h, 10)
	local real d
    local group g=WS7()
	set d =level*80
    set AL4=level
    set IN4=ZX7
    set IP4=IH7
    call GroupEnumUnitsInRange(g, GetUnitX(IH7), GetUnitY(IH7), 550, Condition(function AR7_HERO_Visible))
    call GroupRemoveUnit(g,IH7)
    call B67(ZX7, IH7, 3, d)
    call Z57(IH7,'A4J5',1,2.5+0.5*level,'B02P')
    call ForGroup(g,function LASER_RANGE2)
    call WR7(g)
    call LINGXIA(ZX7,IH7)
    set g = null
	set ZX7 = null
	set IH7 = null
endfunction
function KBD takes nothing returns nothing
    local unit ZX7=GetTriggerUnit()
    local unit IH7=GetSpellTargetUnit()
    local integer skill=B287_GetSpellAbilityId()
    local integer level=B287_GetUnitAbilityLevel(ZX7,skill)
    local trigger t
if skill=='A2UR' then
        set t=NHX(ZX7, IH7,'h0HH', "LASER_RANGE",2000, true, "war3mapImported\\laser.MDX")
    else
        set t=NHX(ZX7, IH7,'h0HH', "LASER_TRI",2000, true, "war3mapImported\\laser.MDX")
    endif
    call SaveInteger(TABLE_HY, GetHandleId(t), 10, level)
    call EnableAttackEffectByTime(14, 3.5 + level*.5)
    set ZX7=null
    set IH7=null
    set t=null
endfunction

function KAD takes nothing returns boolean
if (B287_GetSpellAbilityId()=='A049' or B287_GetSpellAbilityId()=='A2UR') and WQ7(GetSpellTargetUnit())==false then
        call KBD()
    endif
    return false
endfunction
function GN8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function KAD))
call YY8('B02P')
set t=null
endfunction
function UF3 takes nothing returns boolean
return WF7(GetFilterUnit())==false and IsUnitVisible(GetFilterUnit(),GetOwningPlayer(IN4)) and IsUnitEnemy(IN4,GetOwningPlayer(GetFilterUnit())) and GetUnitAbilityLevel(GetFilterUnit(),'A04R')==0 and IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==false and XH7(GetFilterUnit())==false and (IsUnitType(GetFilterUnit(),UNIT_TYPE_ANCIENT)==false or Z_7(GetFilterUnit()) and IsHeroUnitId(GetUnitTypeId(GetFilterUnit())))
endfunction
function UG3 takes nothing returns nothing
	local unit ZX7 = U22
	local unit IH7 = W22
	local integer h = GetHandleId(GetTriggeringTrigger())
	local integer level = LoadInteger(TABLE_HY, h, 10)
	local real d
	set d =50+75*level
    call B67(ZX7,IH7,1,d)
	set ZX7 = null
	set IH7 = null
endfunction
function UH3 takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local unit IH7=null
local group g=WS7()
local real x=GetUnitX(ZX7)
local real y=GetUnitY(ZX7)
local integer X87=2
local trigger t
local integer skill=B287_GetSpellAbilityId()
local integer level=B287_GetUnitAbilityLevel(ZX7,skill)
if B287_GetUnitAbilityLevel(ZX7,'A05E')==0 then
set X87=4
endif
set IN4=ZX7
call GroupEnumUnitsInRange(g,x,y,2500+25,Condition(function UF3))
loop
exitwhen FirstOfGroup(g)==null or X87==0
set IH7=M59(g,x,y)
set X87=X87-1
call GroupRemoveUnit(g,IH7)
set t=NHX(ZX7, IH7,'h0EU', "UG3",1000, true, "")
call SaveInteger(TABLE_HY, GetHandleId(t), 10, level)
endloop
call WR7(g)
set g=null
set IH7=null
set ZX7=null
set t=null
endfunction
function UI3 takes nothing returns boolean
if B287_GetSpellAbilityId()=='A05E' or B287_GetSpellAbilityId()=='A2US' then
call UH3()
endif
return false
endfunction
function JE1 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function UI3))
set t=null
endfunction
function K3D takes nothing returns nothing
if IsUnitType(GetEnumUnit(),UNIT_TYPE_STRUCTURE) then
call B67(PU,GetEnumUnit(),1,QU/3)
else
call B67(PU,GetEnumUnit(),1,QU)
endif
endfunction
function K6D takes unit ZX7,real x,real y,real r,real d returns nothing
local group g=WS7()
set IN4=ZX7
call GroupEnumUnitsInRange(g,x,y,r,Condition(function BI7))
set PU=ZX7
set QU=d
call ForGroup(g,function K3D)
call WR7(g)
set g=null
endfunction
function KLD takes nothing returns boolean
//return(AV7()and KW7(GetFilterUnit())==false and(IsUnitType(GetFilterUnit(),UNIT_TYPE_ANCIENT)==false or Z_7(GetFilterUnit())))!=null
return((AU7()and KW7(GetFilterUnit())==false)and (IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(IN4)) or OO7(GetHandleId(GetOwningPlayer(GetFilterUnit())),"DisableHelp")==false))!=null
endfunction
function K1D takes unit WI7 returns unit
local unit p5=null
local group g=WS7()
set IN4=WI7
call GroupEnumUnitsInRange(g,GetUnitX(WI7),GetUnitY(WI7),275+25,Condition(function KLD))
call GroupRemoveUnit(g,WI7)
// set p5=GroupPickRandomUnit(g)
set p5=M59(g,GetUnitX(WI7),GetUnitY(WI7))
call WR7(g)
set IN4=p5
set p5=null
set g=null
return IN4
endfunction
function K0D takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local integer iX=GetTriggerEvalCount(t)
local unit WI7=O77(OB7,"Hero")
local unit p5=O77(OB7,"Source")
local unit m5=O77(OB7,"Target")
local real K5D=ON7(OB7,"Tossx0")
local real K2D=ON7(OB7,"Tossy0")
local integer id=OM7(OB7,"id")
local integer level=OM7(OB7,"level")
local boolean HaveA=OO7(OB7,"HaveA")
local real x1=0.
local real y1=0.
local real x2=0.
local real y2=0.
local real RK
local real K_D
local real M4D
local real M7D
local real Il
local real IL
local location l
if WI7==null or p5==null or m5==null or GetUnitTypeId(WI7)==0 or GetUnitTypeId(p5)==0 or GetUnitTypeId(m5)==0 then
if p5!=null and GetUnitTypeId(p5)!=0 then
call PauseUnitEx(p5,false)
call SetUnitPathing(p5,true)
call OX7(p5,"Tossed")
endif
call DestroyEffect(OG7(OB7,"FX"))
call NM7(OB7)
call OZ7(t)
set t=null
set WI7=null
set p5=null
set m5=null
return false
endif
set x1=GetUnitX(p5)
set y1=GetUnitY(p5)
set x2=GetUnitX(m5)
set y2=GetUnitY(m5)
if KF7(K5D,K2D,x2,y2)>$3E8 then
set x2=K5D
set y2=K2D
endif
set RK=J77(x1,y1,x2,y2)
set K_D=KF7(x1,y1,x2,y2)
set M4D=K_D/(51-iX)
set M7D=(iX-25)*(iX-25)
set Il=x1+M4D*Cos(RK*bj_DEGTORAD)
set IL=y1+M4D*Sin(RK*bj_DEGTORAD)
if iX<51 then
if KCD(p5)==false then
call SetUnitFlyHeight(p5,775-M7D,0)
endif
call SetUnitPosition(p5,Il,IL)
else
if KCD(p5)==false then
call SetUnitFlyHeight(p5,GetUnitDefaultFlyHeight(p5),0)
endif
//call PauseUnit(p5,false)
call PauseUnitEx(p5,false)
call SetUnitPathing(p5,true)
call SetUnitPosition(p5,x2,y2)
call OX7(p5,"Tossed")
set l=Location(x2,y2)
call TerrainDeformationRippleBJ(.2,true,l,1.,300.,96.,1,64.)
call RemoveLocation(l)
call DestroyEffect(OG7(OB7,"FX"))
//落地特效
if id=='Zcrl' or id=='Z01X' then
call DestroyEffect(AddSpecialEffect("model\\hero_giantstone_n9s_t_ground.mdl",GetUnitX(p5),GetUnitY(p5)))
elseif id=='Zdrl' or id=='Z11X' then
call DestroyEffect(AddSpecialEffect("model\\hero_giantstone_n3s_t_ground.mdl",GetUnitX(p5),GetUnitY(p5)))
elseif id=='Zerl' or id=='Z21X' then
call DestroyEffect(AddSpecialEffect("model\\hero_giantstone_n6s_t_ground.mdl",GetUnitX(p5),GetUnitY(p5)))
else
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",GetUnitX(p5),GetUnitY(p5)))
endif
if IsUnitAlly(p5,GetOwningPlayer(WI7))then
else
if HaveA then
call B67(WI7,p5,1,(.2+.2*(B287_GetUnitAbilityLevel(WI7,'A0CY')+1))*75*level)
else
call B67(WI7,p5,1,(.2+.15*B287_GetUnitAbilityLevel(WI7,'A0CY'))*75*level)
endif
endif
call Y67(x2,y2,300)
call K6D(WI7,x2,y2,300,75*level)
call LINGXIA(WI7,m5)
call NM7(OB7)
call OZ7(t)
endif
set t=null
set WI7=null
set p5=null
set m5=null
set l=null
return false
endfunction
function SBMQ takes unit ZX7,unit p5 returns boolean
    local integer id1=GetPlayerId(GetOwningPlayer(ZX7))
    local integer id2=GetPlayerId(GetOwningPlayer(p5))
    if IsUnitAlly(p5,GetOwningPlayer(ZX7)) and SPEPLAYER[id2]==1 and id1!=id2 then
        return true
    endif
    return false
endfunction
function M8D takes nothing returns nothing
local unit WI7=GetTriggerUnit()
local unit p5=VJ4
local unit m5=GetSpellTargetUnit()
local trigger t=null
local integer OB7=0
local integer id=0
local integer level=0
local boolean HaveA=false
if WI7==null or p5==null or m5==null or GetUnitTypeId(WI7)==0 or GetUnitTypeId(p5)==0 or GetUnitTypeId(m5)==0 then
set WI7=null
set p5=null
set m5=null
return
endif
if SBMQ(WI7,p5) then
    set p5=WI7
    set WI7=VJ4
endif
if WI7==null or p5==null or GetUnitTypeId(WI7)==0 or GetUnitTypeId(p5)==0 then
set WI7=null
set p5=null
set m5=null
return
endif
set t=CreateTrigger()
set OB7=GetHandleId(t)
set id=GetUnitTypeId(WI7)
set level=B287_GetUnitAbilityLevel(WI7,'A0BZ')
if SuijiMode_HasAghanimState(WI7) then
    set HaveA=true
endif
call SetUnitAnimationByIndex(WI7,4)
//call PauseUnit(p5,true)
call PauseUnitEx(p5,true)
call SetUnitPathing(p5,false)
if KCD(p5)==false then
call XF7(p5,'Amrf')
call UnitRemoveAbility(p5,'Amrf')
endif
call OV7(p5,"Tossed")
call NT7(OB7,"Hero",WI7)
call NT7(OB7,"Source",p5)
call NT7(OB7,"Target",m5)
call NS7(OB7,"HaveA",HaveA)
if id=='Zcrl' or id=='Z01X' then
call NU7(OB7,"FX",AddSpecialEffectTarget("model\\hero_giantstone_n9s_t_ribbon.mdl",p5,"origin"))
call DestroyEffect(AddSpecialEffect("model\\hero_giantstone_n9s_t_smoke_target.mdx",GetUnitX(p5),GetUnitY(p5)))
call DestroyEffect(AddSpecialEffectTarget("model\\hero_giantstone_n9s_t_smoke_self.mdl",WI7,"origin"))
elseif id=='Zdrl' or id=='Z11X' then
call NU7(OB7,"FX",AddSpecialEffectTarget("model\\hero_giantstone_n3s_t_ribbon.mdl",p5,"origin"))
call DestroyEffect(AddSpecialEffect("model\\hero_giantstone_n3s_t_smoke_target.mdx",GetUnitX(p5),GetUnitY(p5)))
call DestroyEffect(AddSpecialEffectTarget("model\\hero_giantstone_n3s_t_smoke_self.mdl",WI7,"origin"))
elseif id=='Zerl' or id=='Z21X' then
call NU7(OB7,"FX",AddSpecialEffectTarget("model\\hero_giantstone_n6s_t_ribbon.mdl",p5,"origin"))
call DestroyEffect(AddSpecialEffect("model\\hero_giantstone_n6s_t_smoke_target.mdx",GetUnitX(p5),GetUnitY(p5)))
call DestroyEffect(AddSpecialEffectTarget("model\\hero_giantstone_n6s_t_smoke_self.mdl",WI7,"origin"))
else
call NU7(OB7,"FX",AddSpecialEffectTarget("Abilities\\Spells\\Human\\FlakCannons\\FlakTarget.mdl",p5,"origin"))
endif
call NQ7(OB7,"Tossx0",GetUnitX(m5))
call NQ7(OB7,"Tossy0",GetUnitY(m5))
call NP7(OB7,"id",id)
call NP7(OB7,"level",level)
call TriggerRegisterTimerEvent(t,.02,true)
call TriggerAddCondition(t,Condition(function K0D))
if IsUnitEnemy(p5,GetOwningPlayer(WI7))then
call IssueTargetOrderById(WI7,$D000F,p5)
endif
set WI7=null
set p5=null
set m5=null
set t=null
endfunction
function M9D takes nothing returns nothing
local unit WI7=GetTriggerUnit()
local unit p5=K1D(WI7)
local unit m5=GetSpellTargetUnit()
set VJ4=p5
if p5==null then
call KR7(WI7)
call X37(GetOwningPlayer(WI7),VU7('n0DA'))
elseif m5==WI7 then
call KR7(WI7)
call X37(GetOwningPlayer(WI7),VU7('n0CY'))
endif
set WI7=null
set p5=null
set m5=null
endfunction
function MDD takes nothing returns boolean
if B287_GetSpellAbilityId()=='A0BZ' then
if GetTriggerEventId()==EVENT_PLAYER_UNIT_SPELL_CAST then
call M9D()
else
call M8D()
endif
endif
return false
endfunction
function GR8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_CAST)
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function MDD))
set t=null
endfunction
function MED takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
call M_9('A2KK')
endfunction
function MFD takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=O77(I97,"Source")
local integer WF8
if GetTriggerEventId()==EVENT_UNIT_DAMAGED then
if GetEventDamageSource()==ZX7 and GetEventDamage()>20. then
set WF8=OM7(GetHandleId(ZX7),"WarClub_Count")
if OT7(ZX7,"WarClubState")==false then
call O37(ZX7,"WarClubState",.1)
call NP7(GetHandleId(ZX7),"WarClub_Count",(WF8+1))
endif
call FlushChildHashtable(L7,(I97))
call OZ7(t)
endif
else
call FlushChildHashtable(L7,(I97))
call OZ7(t)
endif
set ZX7=null
set t=null
return false
endfunction
function MGD takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer T_7=GetHandleId(t)
local unit CV7=O77(T_7,"Source")
local integer MHD=OM7(GetHandleId(CV7),"WarClub_Count")
call NP7(T_7,"WarClub_Cooldown",1)
call UnitRemoveAbility(CV7,'A1VG')
if(MV7(CV7,ZU[GB4])!=null)then
call XF7(CV7,'A1VH')
endif
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(CV7),'A1VH',true)
if MHD>5 then
call FlushChildHashtable(L7,T_7)
call OZ7(t)
endif
set CV7=null
set t=null
return false
endfunction
function MID takes nothing returns nothing
local trigger t
local unit CV7=GetAttacker()
local integer T_7=GetHandleId(CV7)
local integer MHD=OM7(T_7,"WarClub_Count")
if MHD<6 then
if not OT7(CV7,"WarClubState")then
set t=CreateTrigger()
call TriggerRegisterUnitEvent(t,GetTriggerUnit(),EVENT_UNIT_DAMAGED)
call TriggerRegisterTimerEvent(t,1.,false)
call TriggerAddCondition(t,Condition(function MFD))
call NT7(GetHandleId(t),"Source",CV7)
endif
else
call NP7(T_7,"WarClub_Count",(0))
call UnitRemoveAbility(CV7,'A1W1')
if(OM7(T_7,"WarClub_Cooldown"))==1 then
set t=OE7(T_7,"WarClub_EndTrig")
call FlushChildHashtable(L7,GetHandleId(t))
call OZ7(t)
endif
endif
set CV7=null
set t=null
endfunction
function MJD takes nothing returns boolean
if GetUnitAbilityLevel(GetAttacker(),'A1W1')>0 then
call MID()
endif
return false
endfunction
function MKD takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
if GetTriggerEvalCount(t)==1 then
call SetUnitTimeScalePercent(ZX7,$FA)
else
call SetUnitTimeScalePercent(ZX7,100)
call SetUnitAnimationByIndex(ZX7,$C)
call FlushChildHashtable(L7,(I97))
call OZ7(t)
endif
set t=null
set ZX7=null
return false
endfunction
function MMD takes nothing returns boolean
local trigger t
if B287_GetSpellAbilityId()=='A1VH' then
call O37(GetTriggerUnit(),"WarClubCastState",29.9)
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(GetTriggerUnit()),'A1VH',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(GetTriggerUnit()),'A1VG',true)
call XF7(GetTriggerUnit(),'A1VG')
call SetPlayerAbilityAvailable(GetOwningPlayer(GetTriggerUnit()),'A1W1',false)
call XF7(GetTriggerUnit(),'A1W1')
call IssueTargetOrderById(GetTriggerUnit(),$D021F,GetSpellTargetDestructable())
set t=CreateTrigger()
call TriggerRegisterTimerEvent(t,30,false)
call TriggerAddCondition(t,Condition(function MGD))
call NT7(GetHandleId(t),"Source",GetTriggerUnit())
call NV7(GetHandleId(GetTriggerUnit()),"WarClub_EndTrig",t)
call NP7(GetHandleId(GetTriggerUnit()),"WarClub_Cooldown",(0))
call NP7(GetHandleId(GetTriggerUnit()),"WarClub_Count",(0))
set t=null
elseif B287_GetSpellAbilityId()=='A2KA' then
call RemoveDestructable(GetSpellTargetDestructable())
call ShowUnit(GetTriggerUnit(),false)
call ShowUnit(GetTriggerUnit(),true)
call UnitRemoveAbility(GetTriggerUnit(),'Aloc')
call UnitAddAbility(GetTriggerUnit(),'A2KB')
call UnitRemoveAbility(GetTriggerUnit(),'A2KB')
call UnitAddAbility(GetTriggerUnit(),'A2KC')
call UnitRemoveAbility(GetTriggerUnit(),'A2KC')
call AddUnitAnimationProperties(GetTriggerUnit(),"upgrade",false)
endif
return false
endfunction
function MND takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
if(MV7((ZX7),ZU[GB4])!=null)then
if OT7(ZX7,"WarClubCastState")==false then
if B287_GetUnitAbilityLevel(ZX7,'A1VH')==0 and GetUnitAbilityLevel(ZX7,'A1VG')==0 then
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A1VH',true)
call XF7(ZX7,'A1VH')
endif
endif
else
call B287_UnitRemoveAbility(ZX7,'A1VH')
call UnitRemoveAbility(ZX7,'A1VG')
endif
set t=null
set ZX7=null
return false
endfunction
function KW9 takes nothing returns nothing
local unit p5=B2
local unit m5=C2
local unit BB7=O77(GetHandleId(p5),"GrowCaster")
call NT7(GetHandleId(m5),"GrowCaster",BB7)
call SetUnitOwner(BB7,GetOwningPlayer(m5),true)
set p5=null
set m5=null
set BB7=null
endfunction
function XG8 takes nothing returns nothing
local unit WI7=IT4
local unit BB7=O77(GetHandleId(WI7),"GrowCaster")
if BB7!=null and GetUnitTypeId(BB7)=='e01V' then
call RemoveUnit(BB7)
endif
if WI7!=null then
call RemoveSavedHandle(L7,GetHandleId(WI7),StringHash("GrowCaster"))
endif
set WI7=null
set BB7=null
endfunction
function MOD takes nothing returns boolean
return B287_GetLearnedSkill()=='A0CY' and IsUnitIllusion(GetTriggerUnit())==false
endfunction
function TinyGrow_GetScale takes unit u,integer level returns real
local integer id=GetUnitTypeId(u)
if id=='Zcrl' or id=='Z01X' then
return .5+.2*level
endif
if id=='Ucrl' or id=='U01X' or id=='Zdrl' or id=='Z11X' or id=='Zerl' or id=='Z21X' then
return .5+.25*level
endif
return Get_Unit_Scale(u)*(1.+.15*level)
endfunction
function MPD takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit MQD=O77(GetHandleId(GetTriggeringTrigger()),"Tiny")
local integer V77=B287_GetUnitAbilityLevel(MQD,'A0CY')
local unit BB7=null
local real scale=0.
if MQD==null or GetUnitTypeId(MQD)==0 or V77<=0 then
if MQD!=null then
set BB7=O77(GetHandleId(MQD),"GrowCaster")
if BB7!=null and GetUnitTypeId(BB7)!=0 then
call RemoveUnit(BB7)
endif
call RemoveSavedHandle(L7,GetHandleId(MQD),StringHash("GrowCaster"))
call RemoveSavedHandle(L7,GetHandleId(MQD),StringHash("TinyGrowScaleTimer"))
endif
call NM7(I97)
call OZ7(t)
elseif GetUnitState(MQD,UNIT_STATE_LIFE)>1 and GetUnitAbilityLevel(MQD,'B0J5')==0 then
set scale=TinyGrow_GetScale(MQD,V77)
call SetUnitScale(MQD,scale,scale,scale)
endif
set t=null
set MQD=null
set BB7=null
endfunction
function MRD takes nothing returns boolean
local integer V77
local unit u=GetTriggerUnit()
local real scale=0.
if IsUnitIllusion(u) and B287_GetUnitAbilityLevel(u,'A0CY')>0 then
set V77=B287_GetUnitAbilityLevel(u,'A0CY')
set scale=TinyGrow_GetScale(u,V77)
call SetUnitScale(u,scale,scale,scale)
endif
set u=null
return false
endfunction
function TinyGrow_SyncUnit takes unit MTD returns nothing
local trigger t
local integer BC7=B287_GetUnitAbilityLevel(MTD,'A0CY')
local unit BB7
local region MUD
local integer i=0
local real scale=0.
if MTD==null or GetUnitTypeId(MTD)==0 or BC7<=0 then
set MTD=null
return
endif
set i=GetPlayerId(GetOwningPlayer(MTD))
set BB7=O77(GetHandleId(MTD),"GrowCaster")
if BB7==null or GetUnitTypeId(BB7)==0 then
set BB7=CreateUnit(GetOwningPlayer(MTD),'e01V',0,0,0)
set xxzd[i]=BB7
call NT7(GetHandleId(MTD),"GrowCaster",BB7)
else
call SetUnitOwner(BB7,GetOwningPlayer(MTD),true)
endif
call UnitRemoveAbility(BB7,'A10B')
call UnitRemoveAbility(BB7,'A10A')
call UnitRemoveAbility(BB7,'A0ZS')
if BC7==1 then
call XF7(BB7,'A10B')
elseif BC7==2 then
call XF7(BB7,'A10A')
else
call XF7(BB7,'A0ZS')
endif
if OM7(GetHandleId(MTD),"SuijiSmallSkill")!='A0CY' and OM7(GetHandleId(MTD),"SuijiUltSkill")!='A0CY' then
call SetPlayerTechResearched(GetOwningPlayer(MTD),'R00E',BC7)
endif
set scale=TinyGrow_GetScale(MTD,BC7)
call SetUnitScale(MTD,scale,scale,scale)
set t=OE7(GetHandleId(MTD),"TinyGrowScaleTimer")
if t==null then
set t=CreateTrigger()
call TriggerAddAction(t,function MPD)
call TriggerRegisterTimerEvent(t,2.,true)
call NT7(GetHandleId(t),"Tiny",MTD)
call NV7(GetHandleId(MTD),"TinyGrowScaleTimer",t)
endif
if OO7(StringHash("TinyGrowGlobal"),"Init")==false then
call NS7(StringHash("TinyGrowGlobal"),"Init",true)
set t=CreateTrigger()
set MUD=CreateRegion()
call RegionAddRect(MUD,GetWorldBounds())
call TriggerRegisterEnterRegion(t,MUD,Condition(function TO7))
call TriggerAddCondition(t,Condition(function MRD))
set t=null
set MUD=null
endif
set MTD=null
set BB7=null
endfunction
function MSD takes nothing returns nothing
local unit MTD=GetTriggerUnit()
call TinyGrow_SyncUnit(MTD)
set MTD=null
endfunction
function GP8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_HERO_SKILL)
call TriggerAddCondition(t,Condition(function MOD))
call TriggerAddAction(t,function MSD)
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function MMD))
//call MED()
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_ATTACKED)
call TriggerAddCondition(t,Condition(function MJD))
set t=null
endfunction
function MVD takes nothing returns boolean
