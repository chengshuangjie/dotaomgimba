function B287_ShouldUseFixedClone takes integer logicalSkill returns boolean
if SUIJI_FIXED_CLONE_ENABLED==false then
return false
endif
if SUIJI_FIXED_CLONE_ALL then
return LoadInteger(SUIJI_FIXED_CLONE_TABLE,0,logicalSkill)!=0
endif
return B287_IsPhase2CloneSkill(logicalSkill) or B287_IsPhase3CloneSkill(logicalSkill) or B287_IsPhase4CloneSkill(logicalSkill) or B287_IsPhase5CloneSkill(logicalSkill) or B287_IsPhase6CloneSkill(logicalSkill) or B287_IsPhase7CloneSkill(logicalSkill) or B287_IsPhase8CloneSkill(logicalSkill) or B287_IsPhase9CloneSkill(logicalSkill) or B287_IsPhase10CloneSkill(logicalSkill) or B287_IsPhase11CloneSkill(logicalSkill) or B287_IsPhase12CloneSkill(logicalSkill) or B287_IsPhase13CloneSkill(logicalSkill) or B287_IsPhase14CloneSkill(logicalSkill) or B287_IsPhase15CloneSkill(logicalSkill) or B287_IsPhase16CloneSkill(logicalSkill)
endfunction

// Some OMG "passives" are implemented by attack-event scripts rather than
// Warcraft's passive ability flag.  A late UnitAddAbility on an illusion is
// not reliable for those abilities, so the script reads the stable hero's
// selected OMG slot at attack time instead.  Keep this whitelist explicit:
// an active skill must never be inherited through this bridge.
function SuijiMode_IsIllusionPassiveBridgeSkill takes integer skill returns boolean
if skill=='A0BK' or skill=='A022' or skill=='A0SS' or skill=='A4EU' or skill=='A0JJ' or skill=='A081' or skill=='A01K' or skill=='A09E' or skill=='A0G5' then
return true
endif
return skill=='ABcr' or skill=='A03Q' or skill=='A03N' or skill=='A00K' or skill=='A2PX' or skill=='A1OY'
endfunction
function SuijiMode_GetIllusionPassiveBridgeLevel takes unit u,integer skill returns integer
local unit source=null
local integer level=0
if u==null or GetUnitTypeId(u)==0 or skill==0 then
return 0
endif
set level=GetUnitAbilityLevel(u,B287_GetPhysicalAbilityId(u,skill))
if level>0 or IsUnitIllusion(u)==false or SuijiMode_IsIllusionPassiveBridgeSkill(skill)==false then
return level
endif
set source=M7[GetPlayerId(GetOwningPlayer(u))]
if source!=null and GetUnitTypeId(source)!=0 and LoadBoolean(L7,GetHandleId(source),StringHash("SuijiDone")) and (LoadInteger(L7,GetHandleId(source),StringHash("SuijiSmallSkill"))==skill or LoadInteger(L7,GetHandleId(source),StringHash("SuijiUltSkill"))==skill) then
set level=GetUnitAbilityLevel(source,B287_GetPhysicalAbilityId(source,skill))
endif
set source=null
return level
endfunction
function B287_GetUnitAbilityLevel takes unit u,integer logicalSkill returns integer
local integer level=0
if u==null or GetUnitTypeId(u)==0 or logicalSkill==0 then
return 0
endif
set level=GetUnitAbilityLevel(u,B287_GetPhysicalAbilityId(u,logicalSkill))
if level>0 then
return level
endif
// An existing illusion cannot reliably receive every OMG passive ability.
// The explicit bridge below is limited to selected attack-passive skills.
return SuijiMode_GetIllusionPassiveBridgeLevel(u,logicalSkill)
endfunction

function B287_SetUnitAbilityLevel takes unit u,integer logicalSkill,integer level returns integer
if u==null or GetUnitTypeId(u)==0 or logicalSkill==0 or level<=0 then
return 0
endif
return SetUnitAbilityLevel(u,B287_GetPhysicalAbilityId(u,logicalSkill),level)
endfunction

function B287_GetExpectedAbilityId takes unit u,integer logicalSkill returns integer
local integer cloneSkill=LoadInteger(SUIJI_FIXED_CLONE_TABLE,0,logicalSkill)
local integer h=0
if cloneSkill==0 or u==null or GetUnitTypeId(u)==0 then
return logicalSkill
endif
if GetUnitAbilityLevel(u,cloneSkill)>0 then
return cloneSkill
endif
if B287_ShouldUseFixedClone(logicalSkill) then
set h=GetHandleId(u)
if LoadInteger(L7,h,StringHash("SuijiSmallSkill"))==logicalSkill or LoadInteger(L7,h,StringHash("SuijiUltSkill"))==logicalSkill then
return cloneSkill
endif
endif
return logicalSkill
endfunction

function B287_UnitAddAbility takes unit u,integer logicalSkill returns boolean
return UnitAddAbility(u,B287_GetExpectedAbilityId(u,logicalSkill))
endfunction

function B287_UnitRemoveAbility takes unit u,integer logicalSkill returns boolean
return UnitRemoveAbility(u,B287_GetExpectedAbilityId(u,logicalSkill))
endfunction

function B287_UnitMakeAbilityPermanent takes unit u,boolean permanent,integer logicalSkill returns boolean
return UnitMakeAbilityPermanent(u,permanent,B287_GetExpectedAbilityId(u,logicalSkill))
endfunction

function B287_SetUnitAbilityAvailable takes unit u,integer logicalSkill,boolean available returns nothing
if u==null or GetUnitTypeId(u)==0 then
return
endif
call SetPlayerAbilityAvailable(GetOwningPlayer(u),B287_GetExpectedAbilityId(u,logicalSkill),available)
endfunction

function B287_IsStateReplaceBaseSkill takes integer logicalSkill returns boolean
return logicalSkill=='A0G8' or logicalSkill=='A1NI' or logicalSkill=='A085' or logicalSkill=='A07U' or logicalSkill=='A2SR' or logicalSkill=='A21F' or logicalSkill=='A21G' or logicalSkill=='A0R0' or logicalSkill=='A1MI' or logicalSkill=='A2SE' or logicalSkill=='A1RJ' or logicalSkill=='A1YY' or logicalSkill=='A1YX' or logicalSkill=='A4B6' or logicalSkill=='A11N' or logicalSkill=='A1A8' or logicalSkill=='A1TA'
endfunction

function B290_IsDisplacementSkill takes integer skill returns boolean
if skill=='AEbl' or skill=='A03I' or skill=='A07W' or skill=='A0ME' or skill=='A2FW' or skill=='A0K9' or skill=='A01O' then
return true
endif
if skill=='A06J' or skill=='A0FN' or skill=='A06O' or skill=='A4I2' then
return true
endif
if skill=='A0FS' or skill=='A0IT' or skill=='A0KE' or skill=='A0LK' or skill=='A0LN' or skill=='A4EX' or skill=='A4EY' or skill=='A4EZ' then
return true
endif
if skill=='A0ML' or skill=='A0PL' or skill=='A0QR' or skill=='A1B3' or skill=='A0RW' then
return true
endif
if skill=='A0Z8' or skill=='A1CV' or skill=='A14O' or skill=='A1J7' or skill=='A4BZ' or skill=='A4C1' then
return true
endif
if skill=='A1Q4' or skill=='A1RD' or skill=='A3RD' or skill=='A1RJ' or skill=='A1S7' or skill=='A2E3' then
return true
endif
if skill=='A0BZ' or skill=='A0QE' or skill=='A2V5' or skill=='A2V6' then
return true
endif
if skill=='A0IN' or skill=='A1AW' or skill=='A1SW' or skill=='A0G4' or skill=='A1D8' then
return true
endif
return skill=='A2V4' or skill=='A2V8' or skill=='A2VF' or skill=='A2VG' or skill=='A2VH' or skill=='A2VI' or skill=='A2VJ' or skill=='A2VK'
endfunction

function B290_IsBlinkDisplacementSkill takes integer skill returns boolean
return skill=='AEbl' or skill=='A03I' or skill=='A07W' or skill=='A0ME' or skill=='A2FW'
endfunction

function B290_GetDisplacementMulticastCount takes unit u,integer skill returns integer
return 1
endfunction

function B290_ApplyBlinkMulticastDistance takes unit u,integer skill,integer count returns nothing
local integer h=0
local real startX=0.
local real startY=0.
local real currentX=0.
local real currentY=0.
local real targetX=0.
local real targetY=0.
if u==null or GetUnitTypeId(u)==0 or count<=1 or B290_IsBlinkDisplacementSkill(skill)==false then
return
endif
set h=GetHandleId(u)
set startX=LoadReal(L7,h,StringHash("B290DisplacementStartX"))
set startY=LoadReal(L7,h,StringHash("B290DisplacementStartY"))
set currentX=GetUnitX(u)
set currentY=GetUnitY(u)
if (currentX-startX)*(currentX-startX)+(currentY-startY)*(currentY-startY)<1. then
return
endif
set targetX=startX+(currentX-startX)*count
set targetY=startY+(currentY-startY)*count
if targetX<GetRectMinX(bj_mapInitialPlayableArea)+32. then
set targetX=GetRectMinX(bj_mapInitialPlayableArea)+32.
elseif targetX>GetRectMaxX(bj_mapInitialPlayableArea)-32. then
set targetX=GetRectMaxX(bj_mapInitialPlayableArea)-32.
endif
if targetY<GetRectMinY(bj_mapInitialPlayableArea)+32. then
set targetY=GetRectMinY(bj_mapInitialPlayableArea)+32.
elseif targetY>GetRectMaxY(bj_mapInitialPlayableArea)-32. then
set targetY=GetRectMaxY(bj_mapInitialPlayableArea)-32.
endif
call SetUnitX(u,targetX)
call SetUnitY(u,targetY)
endfunction

function B287_SetPlayerAbilityAvailable takes player p,integer logicalSkill,boolean available returns nothing
local unit hero=null
local integer physicalSkill=logicalSkill
if p==null then
return
endif
set hero=M7[GetPlayerId(p)]
if hero!=null and GetUnitTypeId(hero)!=0 then
set physicalSkill=B287_GetExpectedAbilityId(hero,logicalSkill)
if B287_IsStateReplaceBaseSkill(logicalSkill) then
if available then
call RemoveSavedBoolean(L7,GetHandleId(hero),StringHash("B289StateReplaceBase")+logicalSkill)
else
call SaveBoolean(L7,GetHandleId(hero),StringHash("B289StateReplaceBase")+logicalSkill,true)
endif
endif
endif
call SetPlayerAbilityAvailable(p,physicalSkill,available)
set hero=null
endfunction

function B287_MHAbility_GetCooldown takes unit u,integer logicalSkill returns real
return MHAbility_GetCooldown(u,B287_GetPhysicalAbilityId(u,logicalSkill))
endfunction

function B287_MHAbility_SetCooldown takes unit u,integer logicalSkill,real duration returns boolean
