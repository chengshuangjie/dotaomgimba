call SaveInteger(L7,(OB7),(5),(V77))
call SaveBoolean(L7,OB7,15,SuijiMode_HasAghanimState(WI7))
call TimerStart(t,0.1,true,function T0D)
call RemoveLocation(m5)
set HGI=ya
set HHI=WI7
