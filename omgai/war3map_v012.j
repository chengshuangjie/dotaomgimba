endif
if AI_Send_BB and IS_HUMAN(IN4) and IS_AI(u) and IsUnitType(u, UNIT_TYPE_HERO) and UnitAlive(u)==false then
	set AI_Send_BB=false
	call Refresh_AI_Text_Skill_Cooldown(GetOwningPlayer(u))
