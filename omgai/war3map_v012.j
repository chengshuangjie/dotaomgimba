function VUF takes unit hn returns nothing
local integer OB7=GetHandleId(hn)
local integer VVF=OM7(OB7,"Invoker|Wex")
local integer VWF=OM7(OB7,"Invoker|Quas")
local integer VXF=OM7(OB7,"Invoker|Exort")
local integer S1F=B287_GetUnitAbilityLevel(hn,'A21X')
local integer T7F=B287_GetUnitAbilityLevel(hn,'A21W')
local integer S0F=B287_GetUnitAbilityLevel(hn,'A21V')
call UnitRemoveAbility(hn,'A0WD')
call UnitRemoveAbility(hn,'A0VE')
call UnitRemoveAbility(hn,'A0V7')
if VVF>0 then
call XF7(hn,'A0WD')
call XF7(hn,'A0VE')
call SetUnitAbilityLevel(hn,'A0WD',VVF*S1F)
call SetUnitAbilityLevel(hn,'A0VE',VVF*S1F)
call SetPlayerAbilityAvailable(GetOwningPlayer(hn),'A0WD',false)
endif
if VXF>0 then
call XF7(hn,'A0V7')
call SetUnitAbilityLevel(hn,'A0V7',VXF*S0F)
endif
endfunction
function VYF takes nothing returns boolean
if IsUnitIllusion(GetTriggerUnit())==false and (B287_GetLearnedSkill()=='A21X' or B287_GetLearnedSkill()=='A21W' or B287_GetLearnedSkill()=='A21V') then
call VUF(GetTriggerUnit())
if B287_GetLearnedSkill()=='A21X' then
call SetHeroAgi(GetTriggerUnit(),GetHeroAgi(GetTriggerUnit(),false)+2,true)
call NP7(GetHandleId(GetTriggerUnit()),"WexLevel",B287_GetUnitAbilityLevel(GetTriggerUnit(),'A21X'))
endif
if B287_GetLearnedSkill()=='A21W' then
call SetHeroStr(GetTriggerUnit(),GetHeroStr(GetTriggerUnit(),false)+2,true)
call NP7(GetHandleId(GetTriggerUnit()),"QuasLevel",B287_GetUnitAbilityLevel(GetTriggerUnit(),'A21W'))
if B287_GetUnitAbilityLevel(GetTriggerUnit(),'A21W')==1 then
        call VRF(GetTriggerUnit())
    endif
endif
if B287_GetLearnedSkill()=='A21V' then
call SetHeroInt(GetTriggerUnit(),GetHeroInt(GetTriggerUnit(),false)+2,true)
call NP7(GetHandleId(GetTriggerUnit()),"ExortLevel",B287_GetUnitAbilityLevel(GetTriggerUnit(),'A21V'))
call SET_TH_TIP()
endif
endif
return false
endfunction
function VZF takes unit hn returns nothing
