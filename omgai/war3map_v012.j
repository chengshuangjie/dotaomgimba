function Y3F takes nothing returns boolean
if IsUnitAlly(GetFilterUnit(),GetOwningPlayer(IN4)) and GetUnitAbilityLevel(GetFilterUnit(),'Aloc')==0 and UnitInventorySize(GetFilterUnit())>1 and GetUnitTypeId(GetFilterUnit())!='ncop' and GetPlayerAlliance(GetOwningPlayer(GetFilterUnit()),GetOwningPlayer(IN4),ALLIANCE_SHARED_CONTROL) and GetOwningPlayer(IN4)!=GetOwningPlayer(GetFilterUnit()) and IsUnitIllusion(GetFilterUnit())==false and XH7(GetFilterUnit())==false then
if KW7(GetFilterUnit()) then
set IH4=IH4+1
set IP4=GetFilterUnit()
endif
endif
return false
endfunction
function Y6F takes nothing returns boolean
if IsUnitAlly(GetFilterUnit(),GetOwningPlayer(IN4)) and GetUnitAbilityLevel(GetFilterUnit(),'Aloc')==0 and UnitInventorySize(GetFilterUnit())>1 and GetUnitTypeId(GetFilterUnit())!='ncop' and IsUnitIllusion(GetFilterUnit())==false and XH7(GetFilterUnit())==false then
if GetOwningPlayer(IN4)==GetOwningPlayer(GetFilterUnit())then
if IsUnitType(GetFilterUnit(),UNIT_TYPE_HERO) then
if GetUnitAbilityLevel(GetFilterUnit(),'A04R')==0 then
set IP4=GetFilterUnit()
endif
elseif IsUnitType(IP4,UNIT_TYPE_HERO)==false then
set IP4=GetFilterUnit()
endif
endif
endif
return false
endfunction
function YLF takes unit S4,integer Y1F returns unit
local group g=WS7()
set IN4=S4
set IP4=null
call GroupEnumUnitsInRange(g,GetUnitX(eH),GetUnitY(eH),$514+Y1F,Condition(function Y6F))
if IP4==null then
set IH4=0
call WR7(g)
set g=WS7()
call GroupEnumUnitsInRange(g,GetUnitX(eH),GetUnitY(eH),$44C+Y1F,Condition(function Y3F))
if IH4>1 then
set IP4=null
endif
endif
call WR7(g)
set g=null
return IP4
endfunction
function JJ_IN_QS takes player p returns unit
local region r
local unit ZX7 = LoadUnitHandle(TABLE_K, GetHandleId(p),'COUR')
if ZX7!=null and UnitAlive(ZX7) and YRE(ZX7)==0 then
    set ZX7=null
    return null
endif
set r=CreateRegion()
if TV7(GetOwningPlayer(ZX7))then
call RegionAddRect(r,OD)
else
call RegionAddRect(r,PD)
endif
if IsUnitInRegion(r,ZX7) and IsUnitInRegion(r,M7[GetPlayerId(p)]) then
    call RemoveRegion(r)
    set r=null
    set ZX7=null
    return LoadUnitHandle(TABLE_K, GetHandleId(p),'COUR')
endif
call RemoveRegion(r)
set r=null
set ZX7=null
return null
endfunction
function Y0F takes player p4,unit S4,unit Y5F,integer Y68,real x,real y,integer RTF,integer Y2F returns nothing
local unit Y_F
local item RJF=null
set eH=Y5F
if GetUnitPointValue(S4)==200 then
set Y_F=YLF(S4,0)
if Y_F==null then
set Y_F=YLF(S4,300)
endif
else
set Y_F=S4
endif
set GG7=Y68
set GF7=p4
if Y_F==null or YCF(p4,Y_F,Y38(Y68))==false or EL==false then
if Z88(Y38(Y68))then
if YRE(Y_F)==0 or Y_F==null then
call X0F(SU[Y68],x,y,p4,true,RTF)
else
set RJF=UnitAddItemById(Y_F,ZU[Y68])
call SetItemCharges(RJF,RTF)
call SetItemPlayer(RJF,p4,true)
call SetItemUserData(RJF,Y2F)
endif
elseif Z78(Y38(Y68))then
    if Y_F==null or(YRE(Y_F)==0 and MV7(Y_F,ZU[Y68])==null)then //格子满且为消耗品
        set Y_F=JJ_IN_QS(p4)
        if Y_F!=null then
            set RJF=CreateItem(SU[Y68],x,y)
            call SetItemPlayer(RJF,p4,true)
            call SetItemUserData(RJF,Y2F)
            call SetItemCharges(RJF,Z98(Y68))
            call UnitAddItem(Y_F,RJF)
        else
            call X0F(SU[Y68],x,y,p4,true,Z98(Y68))
        endif
    else
        set RJF=CreateItem(SU[Y68],x,y)
        call SetItemPlayer(RJF,p4,true)
        call SetItemUserData(RJF,Y2F)
        call SetItemCharges(RJF,Z98(Y68))
        call UnitAddItem(Y_F,RJF)
    endif
else
    if YRE(Y_F)==0 or Y_F==null then //格子满且非消耗品
        set Y_F=JJ_IN_QS(p4)
        if Y_F!=null then
            set RJF=UnitAddItemById(Y_F,ZU[Y68])
            call SetItemPlayer(RJF,p4,true)
            call SetItemUserData(RJF,0)   
        else
            call X0F(SU[Y68],x,y,p4,false,0)
        endif
    else
        set RJF=UnitAddItemById(Y_F,ZU[Y68])
        call SetItemPlayer(RJF,p4,true)
        call SetItemUserData(RJF,0)
    endif
endif
endif
if RJF!=null then
set G87[288+GetPlayerId(p4)]=RJF
endif
set Y_F=null
set RJF=null
endfunction
function Z4F takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit Z7F=O77(OB7,"Tower")
local integer WHO=OM7(OB7,"WHO")
if GetTriggerEventId()!=EVENT_UNIT_DEATH then
call UnitRemoveAbility(Z7F,'A17R')
call UnitRemoveAbility(Z7F,'A24F')
if WHO==1 then
call UnitRemoveAbility(JW_3ST,'A33G')
call UnitRemoveAbility(JW_3ZT,'A33G')
call UnitRemoveAbility(JW_3XT,'A33G')
call UnitRemoveAbility(JW_4LT,'A33G')
call UnitRemoveAbility(JW_4RT,'A33G')
elseif WHO==2 then
call UnitRemoveAbility(TZ_3ST,'A33H')
call UnitRemoveAbility(TZ_3ZT,'A33H')
call UnitRemoveAbility(TZ_3XT,'A33H')
call UnitRemoveAbility(TZ_4LT,'A33H')
call UnitRemoveAbility(TZ_4RT,'A33H')
endif
endif
call DestroyEffect(OG7(OB7,"FX"))
call NM7(OB7)
call OZ7(t)
set t=null
set Z7F=null
return false
endfunction
function Z4F_Timer takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer OB7=GetHandleId(t)
    local unit ZX7=LoadUnitHandle(TABLE_HY,OB7,0)
	local integer WHO=LoadInteger(TABLE_HY,OB7,1)
	call DestroyEffect(LoadEffectHandle(TABLE_HY,OB7,10))
call UnitRemoveAbility(ZX7,'A17R')
call UnitRemoveAbility(ZX7,'A24F')
	if WHO==1 then
		call UnitRemoveAbility(JW_3ST,'A33G')
		call UnitRemoveAbility(JW_3ZT,'A33G')
		call UnitRemoveAbility(JW_3XT,'A33G')
		call UnitRemoveAbility(JW_4LT,'A33G')
		call UnitRemoveAbility(JW_4RT,'A33G')
	elseif WHO==2 then
		call UnitRemoveAbility(TZ_3ST,'A33H')
		call UnitRemoveAbility(TZ_3ZT,'A33H')
		call UnitRemoveAbility(TZ_3XT,'A33H')
		call UnitRemoveAbility(TZ_4LT,'A33H')
		call UnitRemoveAbility(TZ_4RT,'A33H')
	endif
    call PauseTimer(t)
    call FlushChildHashtable(TABLE_HY,OB7)
    call DestroyTimer(t)
    set t=null
    set ZX7=null
endfunction
function Z8F takes nothing returns boolean
return (IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE) and GetUnitState(GetFilterUnit(),UNIT_STATE_LIFE)>.5 and IsUnitAlly(GetFilterUnit(),Sh) and GetOwningPlayer(GetFilterUnit())!=C7 and GetUnitTypeId(GetFilterUnit())!='ncop' and GetUnitTypeId(GetFilterUnit())!='n0FJ' and GetUnitTypeId(GetFilterUnit())!='n0FI' and GetUnitTypeId(GetFilterUnit())!='n0F6' and GetUnitTypeId(GetFilterUnit())!='n0FH' and GetUnitTypeId(GetFilterUnit())!='n1FJ' and GetUnitTypeId(GetFilterUnit())!='n1FI' and GetUnitTypeId(GetFilterUnit())!='n1F6' and GetUnitTypeId(GetFilterUnit())!='n1FH')!=null
endfunction
function Z9F takes nothing returns nothing
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local unit S4=GetEnumUnit()
local string s
local timer tt=CreateTimer()
local integer I97=GetHandleId(tt)
local real d=5
local effect fx
call UnitAddAbility(S4,'A17R')
call UnitAddAbility(S4,'A24F')
if TV7(Sh)then
call ZS7(THmp3)
set s="effects\\GlyphSent.mdx"
call NP7(OB7,"WHO",1)
call UnitAddAbility(JW_3ST,'A33G')
call UnitAddAbility(JW_3ZT,'A33G')
call UnitAddAbility(JW_3XT,'A33G')
call UnitAddAbility(JW_4LT,'A33G')
call UnitAddAbility(JW_4RT,'A33G')
else
call ZS7(NMmp3)
set s="effects\\GlyphScourge.mdx"
call NP7(OB7,"WHO",2)
call UnitAddAbility(TZ_3ST,'A33H')
call UnitAddAbility(TZ_3ZT,'A33H')
call UnitAddAbility(TZ_3XT,'A33H')
call UnitAddAbility(TZ_4LT,'A33H')
call UnitAddAbility(TZ_4RT,'A33H')
endif
set fx=AddSpecialEffectTarget(s,S4,"origin")
call NU7(OB7,"FX",fx)
call NT7(OB7,"Tower",S4)
call TriggerRegisterUnitEvent(t,S4,EVENT_UNIT_DEATH)
call TriggerRegisterTimerEvent(t,d,false)
call TriggerAddCondition(t,Condition(function Z4F))
call SaveUnitHandle(TABLE_HY,I97,0,S4)
call SaveEffectHandle(TABLE_HY,I97,10,fx)
if TV7(Sh)then
	call SaveInteger(TABLE_HY,I97,1,1)
else
	call SaveInteger(TABLE_HY,I97,1,2)
endif
call TimerStart(tt,5.1,false,function Z4F_Timer)
set t=null
set tt=null
set S4=null
set fx=null
endfunction
