function JYD takes nothing returns nothing
local unit WI7=GetTriggerUnit()
local player j8=GetOwningPlayer(WI7)
local location XX8
local boolexpr hP=Condition(function Vg)
local group LQ7=WS7()
local integer BC7=B287_GetUnitAbilityLevel(WI7,'A0A5')+GetUnitAbilityLevel(WI7,'A2SO')
local integer I97=GetHandleId(j8)
local integer Vh
local unit ZQ8
local real AE9
call GroupEnumUnitsOfPlayer(LQ7,GetOwningPlayer(WI7),hP)
call DestroyBoolExpr(hP)
if(BC7==1)then
call JXD()
endif
set Vh=CountUnitsInGroup(LQ7)
if(Vh==1)then
set ZQ8=FirstOfGroup(LQ7)
set AE9=GetUnitLifePercent(ZQ8)
set XX8=GetUnitLoc(ZQ8)
call ShowUnit(ZQ8,false)
    if(BC7==2)then
call CreateNUnitsAtLoc(1,'n018',GetOwningPlayer(GetTriggerUnit()),XX8,bj_UNIT_FACING)
        call DestroyEffect(AddSpecialEffectTargetUnitBJ("chest",bj_lastCreatedUnit,"Abilities\\Spells\\Orc\\FeralSpirit\\feralspiritdone.mdl"))
        call CHIYY_BEAR(bj_lastCreatedUnit)
        call JRD(bj_lastCreatedUnit)
    elseif(BC7==3)then
call CreateNUnitsAtLoc(1,'n01C',GetOwningPlayer(GetTriggerUnit()),XX8,bj_UNIT_FACING)
        call DestroyEffect(AddSpecialEffectTargetUnitBJ("chest",bj_lastCreatedUnit,"Abilities\\Spells\\Orc\\FeralSpirit\\feralspiritdone.mdl"))
        call CHIYY_BEAR(bj_lastCreatedUnit)
        call JRD(bj_lastCreatedUnit)
