call SetPlayerAbilityAvailable(GetOwningPlayer(WI7),'A1J4',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(WI7),'A1J3',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(WI7),'A1J5',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(WI7),'A1IU',false)
elseif UY9==false and GetUnitAbilityLevel(WI7,'B068')==0 then
call UnitRemoveAbility(WI7,'A1VE')
call UnitRemoveAbility(WI7,'A1J4')
call UnitRemoveAbility(WI7,'A1J3')
call UnitRemoveAbility(WI7,'A1J5')
call UnitRemoveAbility(WI7,'A1IU')
