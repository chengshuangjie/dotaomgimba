function CHIA_SKILL_OTHERS takes unit u,player p,integer id,boolean CHIA returns nothing
local integer i=GetPlayerId(p)
local unit m5=null
//德鲁伊
if CHIA==true then
if id=='N01O' or id=='N013' or id=='N014' or id=='N015' then
	set R6c=R6c+1
	set R6d[i]=R6d[i]+1
endif
endif
if id=='E032' then
call O37(u,"LUNZ",.1)
call XF7(u,'A2SI')
call SetUnitAbilityLevel(u,'A2SI',GetUnitAbilityLevel(u,'A2E5')+GetUnitAbilityLevel(u,'A2SH'))
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A2SI',true)
endif
//白虎星落
if id=='N01V' or id=='Z01V' or id=='Z11V' or id=='Z21V' or id=='Z31V' or id=='Z41V' then
	call XF7(u,'A3UG')
	call SetPlayerAbilityAvailable(p,'A3UG',false)
	call XF7(u,'A3UF')
	call XF7(u,'A4F2')
    call SetPlayerAbilityAvailable(p,'A4F2',false)
	if not HaveSavedHandle(TABLE_HY, GetHandleId(u),'A3UF') then
		set U22 = u
		call ExecuteFunc("XJVXX")
	endif
endif
//小黑分裂箭
if id=='Nbrn' then
	call XF7(u,'S3UR')
endif
//小狗
if id=='U00C' or id=='Z00C' then
	call XF7(u,'A194')
    call B287_SetPlayerAbilityAvailable(GetOwningPlayer(u),'A194',true)
    if id=='U00C' then
        call XF7(u,'A4EV')
        call XF7(u,'A4EW')
    endif
endif
//冰龙
if id=='N0M7' then
call XF7(u,'A2Y6')
call SetPlayerAbilityAvailable(p,'A2Y6',false)
call UnitMakeAbilityPermanent(u,true,'A2Y5')
call UnitMakeAbilityPermanent(u,true,'A3NF')
if GetUnitAbilityLevel(u,'A2NE')+GetUnitAbilityLevel(u,'A3NF')>0 then
call XF7(u,'A3NE')
call SetUnitAbilityLevel(u,'A3NE',GetUnitAbilityLevel(u,'A2NE')+GetUnitAbilityLevel(u,'A3NF'))
endif
endif
//火猫
if id=='N0M0' then
set DZ7[0]='A3JO'
set DZ7[1]='A3JQ'
set DZ7[2]='A3JP'
set DZ7[3]='A3JR'
set DZ7[4]='A3JS'
set DZ7[5]='A3JT'
call UnitMakeAbilityPermanent(u,true,'A2YY')
call HZYJ_SKILL(u,true)
endif
//DP
if id=='UC76' then
    call XF7(u,'A4L7')
endif
//土猫
if id=='N0MU' or id=='N0MV' then
call XF7(u,'A2VM')
call SetPlayerAbilityAvailable(p,'A2VM',true)
call UnitMakeAbilityPermanent(u,true,'A2Z4')
endif
if id=='H00V' or id=='H08D' or id=='H08C' or id=='H084' or id=='H08B' then
call UnitMakeAbilityPermanent(u,true,'A2ZE')
endif
//黑鸟
if id=='U00P' or id=='Z00P' then
call XF7(u,'A4A4')
call SetPlayerAbilityAvailable(p,'A4A4',false)
endif
if id=='Hblm' or id=='H06X' or id=='H06Y' or id=='H06W' or id=='H0BC' then
call UnitMakeAbilityPermanent(u,true,'A4AT')
endif
//幽鬼
if id=='E01B' or id=='Z01B' or id=='Z11B' or id=='Z21B' or id=='Z31B' then
call XF7(u,'A4B6')
call B287_SetPlayerAbilityAvailable(p,'A4B6',true)
endif
//炼金
if PDLJ(u) then
call CT7(p)
endif
//猛犸
if id=='UC11' or id=='ZC11' or id=='ZC12' then
call B287_MHAbility_SetCastpoint(u,'A3RD',.15)
call XF7(u,'A4FL')
call SetPlayerAbilityAvailable(p,'A4FL',false)
call UnitMakeAbilityPermanent(u,true,'A4FK')
endif
//火枪
if id=='Usyl' then
call B287_MHAbility_SetCastpoint(u,'A1AU',.3)
endif
//猴子
if id=='Ogrh' then
call XF7(u,'A0D7')
call SetPlayerAbilityAvailable(p,'A0D7',true)
endif
//潮汐
if id=='Ofar' then
call XF7(u,'A4GC')
call SetPlayerAbilityAvailable(p,'A4GC',false)
endif
//海民
if id=='E02I' then
    call XF7(u,'A4HI')
    call SetPlayerAbilityAvailable(p,'A4HI',true)
endif
//神牛
if id=='Otch' or id=='Ztch' or id=='Zuch' or id=='Zvch' then
    call XF7(u,'A4LZ')
    call SetPlayerAbilityAvailable(p,'A4LZ',true)
	call SetUnitAbilityLevel(u,'A4LZ',B287_GetUnitAbilityLevel(u,'A0DL'))
	call MHAbility_SetCastpoint(u,'A4LZ',.01)
endif
//亚巴顿
if id=='Udea' then
    call XF7(u,'A4LQ')
    call SetPlayerAbilityAvailable(p,'A4LQ',true)
endif
//大树
if id=='Hamg' then
    call XF7(u,'A1G7')
    call B287_SetPlayerAbilityAvailable(p,'A1G7',true)
endif
//巨魔
if id=='N016' or id=='N017' or id=='N200' or id=='N201' or id=='N02B' then
	call MHUnit_SetAttackSpeedLimit(u,8)
endif
//圣堂
if id=='E01Y' or id=='Z01Y' then
    call XF7(u,'A4KJ')
    call SetPlayerAbilityAvailable(p,'A4KJ',true)
endif
//大牛
if id=='O015' then
    call XF7(u,'A4KK')
    call SetPlayerAbilityAvailable(p,'A4KK',true)
    call MHAbility_SetCastpoint(u,'A4KK',.7)
endif
if id=='Eevi' or id=='Eevm' or id=='E02V' or id=='E02W' or id=='E02U' then
    call UnitMakeAbilityPermanent(u,true,'A4HX')
endif
//SVEN
if id=='H001' or id=='H0CQ' or id=='Z001' or id=='Z0CQ' then
call XF7(u,'A4IL')
call SetPlayerAbilityAvailable(p,'A4IL',true)
call SetUnitAbilityLevel(u,'A4IL',B287_GetUnitAbilityLevel(u,'A190'))
endif
//水人
if id=='O00P' then
    set m5=LoadUnitHandle(L7,(GetHandleId(u)),($E5))
    if m5!=null and UnitAlive(m5) then
        call B287_SetPlayerAbilityAvailable(p,'A0G8',false)
        call XF7(u,'A0GC')
        call SetPlayerAbilityAvailable(p,'A0GC',true)
    else
        call UnitRemoveAbility(u,'A0GC')
        call XF7(u,'A0G8')
        call B287_SetPlayerAbilityAvailable(p,'A0G8',true)
    endif
    set m5=null
endif
endfunction
function CHIA_SKILL takes unit playeru4,player p4 returns nothing
local integer A1E
local integer playeru4id=GetUnitTypeId(playeru4)
set A1E=F29(playeru4)
if A1E!=0 then
call UnitAddAbility(playeru4,A1E)
call UnitMakeAbilityPermanent(playeru4,true,A1E)
call SetPlayerAbilityAvailable(p4,A1E,false)
if playeru4id=='H00U' then
set IN4=playeru4
call ExecuteFunc("A0E")
elseif playeru4id=='Hmkg' then
set IN4=playeru4
call ExecuteFunc("E3D")
endif
endif
if playeru4id=='Emoo' then
call SetPlayerTechResearched(p4,'R00J',1)
elseif playeru4id=='H00I' then
set IN4=playeru4
if D4 then
call ExecuteFunc("XSD2")
else
call ExecuteFunc("XSD")
endif
elseif playeru4id=='Ucrl' then
call UnitAddAbility(playeru4,'A2KB')
call UnitRemoveAbility(playeru4,'A2KB')
call AddUnitAnimationProperties(playeru4,"upgrade",true)
call SetPlayerTechResearched(p4,'R00K',1)
elseif playeru4id=='Zcrl' then
call UnitAddAbility(playeru4,'X2KB')
call UnitRemoveAbility(playeru4,'X2KB')
call AddUnitAnimationProperties(playeru4,"upgrade",true)
call SetPlayerTechResearched(p4,'R00K',1)
elseif playeru4id=='Zdrl' then
call UnitAddAbility(playeru4,'X3KB')
call UnitRemoveAbility(playeru4,'X3KB')
call AddUnitAnimationProperties(playeru4,"upgrade",true)
call SetPlayerTechResearched(p4,'R00K',1)
elseif playeru4id=='Zerl' then
call UnitAddAbility(playeru4,'X4KB')
call UnitRemoveAbility(playeru4,'X4KB')
call AddUnitAnimationProperties(playeru4,"upgrade",true)
call SetPlayerTechResearched(p4,'R00K',1)
endif
call CHIA_SKILL_OTHERS(playeru4,p4,playeru4id,true)
call NagaSirenAghMirror_Update(playeru4)
call NagaSirenRipTide_Update(playeru4)
endfunction
function CHIA_TX takes unit playeru3,player p returns nothing
local integer tx
set tx=CHIA_TXCX(playeru3)
if tx>0 then
if tx==100 then
call XF7(playeru3,'A1RG')
call SetPlayerAbilityAvailable(p,'A1RG',false)
call XF7(playeru3,'A1RH')
call SetPlayerAbilityAvailable(p,'A1RH',false)
elseif tx==200 then
call XF7(playeru3,'A4CL')
call SetPlayerAbilityAvailable(p,'A4CL',false)
call XF7(playeru3,'A4CM')
call SetPlayerAbilityAvailable(p,'A4CM',false)
elseif tx=='A0PA' then
call UnitRemoveAbility(playeru3,'A0PA')
call UnitAddAbility(playeru3,'A0PA')
call UnitMakeAbilityPermanent(playeru3,true,'A1RG')
call SetPlayerAbilityAvailable(p,'A1RG',false)
else
call XF7(playeru3,tx)
call SetPlayerAbilityAvailable(p,tx,false)
endif
endif
endfunction
function FIND_SLOT takes unit playeru2,integer appointid returns integer
local integer i
local item ff
set i=0
loop
exitwhen i>5
set ff=UnitItemInSlot(playeru2,i)
if appointid==1 then
if(ff!=null)and(Y_82(ff))then
set ff=null
return i
endif
endif
if appointid==2 then
if(ff!=null)and(Y_8_BS(ff))then
set ff=null
return i
endif
endif
if appointid==3 then
if(ff!=null)and(Y_8_LLX(ff))then
set ff=null
return i
endif
endif
set i=i+1
endloop
set ff=null
return-1
endfunction
// Physical detector used by state synchronization. It deliberately ignores the cached state.
function SuijiMode_DetectAghanimState takes unit u returns boolean
local integer ownItemIndex=0
local integer nativeBook=0
if u==null or GetUnitTypeId(u)==0 then
return false
endif
set ownItemIndex=F59(u)
set nativeBook=F29(u)
return FIND_SLOT(u,1)>-1 or (ownItemIndex>=0 and MV7(u,ZU[ownItemIndex])!=null) or MV7(u,ZU[GX4])!=null or MV7(u,ZU[R1K])!=null or MV7(u,ZU[it_zhzg])!=null or CHIA[GetPlayerId(GetOwningPlayer(u))]==1 or GetUnitAbilityLevel(u,'A330')>0 or (nativeBook>0 and GetUnitAbilityLevel(u,nativeBook)>0)
endfunction
// Effect queries also accept the last synchronized state so native Aghanim spellbook normalization cannot suppress upgrades.
function SuijiMode_HasAghanimState takes unit u returns boolean
if u==null or GetUnitTypeId(u)==0 then
return false
endif
return LoadBoolean(L7,GetHandleId(u),StringHash("SuijiHasScepter")) or SuijiMode_DetectAghanimState(u)
endfunction
function SuijiMode_IsNativeEarthshaker takes unit u returns boolean
local integer id=0
if u==null or GetUnitTypeId(u)==0 then
return false
endif
set id=GetUnitTypeId(u)
return id=='Otch' or id=='Ztch' or id=='Zuch' or id=='Zvch'
endfunction
function SuijiMode_NormalizeNativeEarthshakerAgh takes unit u returns nothing
if SUIJI_MODE==false or SuijiMode_IsNativeEarthshaker(u)==false then
return
endif
if GetUnitAbilityLevel(u,'A1N0')>0 then
call UnitRemoveAbility(u,'A1N0')
endif
endfunction
function SuijiMode_IsNativeSandKing takes unit u returns boolean
local integer id=0
if u==null or GetUnitTypeId(u)==0 then
return false
endif
set id=GetUnitTypeId(u)
return id=='U00K' or id=='Z00K' or id=='Z10K'
endfunction
function SuijiMode_NormalizeNativeSandKingAgh takes unit u returns nothing
local integer level=0
local real cooldown=0.
local player p=null
if SUIJI_MODE==false or SuijiMode_IsNativeSandKing(u)==false then
return
endif
set p=GetOwningPlayer(u)
set level=B287_GetUnitAbilityLevel(u,'A1B4')
if level>0 then
set cooldown=B287_MHAbility_GetCooldown(u,'A1B4')
endif
if GetUnitAbilityLevel(u,'A1BC')>0 then
call UnitRemoveAbility(u,'A1BC')
endif
if SuijiMode_HasAghanimState(u) then
call B287_MHAbility_SetCustomLevelDataReal(u,'A06R',1,ABILITY_LEVEL_DEF_DATA_COOLDOWN,100.)
call B287_MHAbility_SetCustomLevelDataReal(u,'A06R',2,ABILITY_LEVEL_DEF_DATA_COOLDOWN,90.)
call B287_MHAbility_SetCustomLevelDataReal(u,'A06R',3,ABILITY_LEVEL_DEF_DATA_COOLDOWN,80.)
else
call B287_MHAbility_SetCustomLevelDataReal(u,'A06R',1,ABILITY_LEVEL_DEF_DATA_COOLDOWN,120.)
call B287_MHAbility_SetCustomLevelDataReal(u,'A06R',2,ABILITY_LEVEL_DEF_DATA_COOLDOWN,110.)
call B287_MHAbility_SetCustomLevelDataReal(u,'A06R',3,ABILITY_LEVEL_DEF_DATA_COOLDOWN,100.)
endif
if level>0 and B287_GetUnitAbilityLevel(u,'A06R')==0 then
call B287_UnitRemoveAbility(u,'A1B4')
call B287_UnitAddAbility(u,'A06R')
call B287_UnitMakeAbilityPermanent(u,true,'A06R')
call B287_SetUnitAbilityLevel(u,'A06R',level)
if cooldown>0. then
call B287_YDWESetUnitAbilityState(u,'A06R',1,cooldown)
call B287_MHAbility_SetCooldown(u,'A06R',cooldown)
endif
endif
call B287_SetPlayerAbilityAvailable(p,'A1B4',false)
set p=null
endfunction
function SuijiMode_IsNativeNevermore takes unit u returns boolean
local integer id=0
if u==null or GetUnitTypeId(u)==0 then
return false
endif
set id=GetUnitTypeId(u)
return id=='Nfir' or id=='Zfir' or id=='Zgir' or id=='Zhir'
endfunction
function SuijiMode_NormalizeNativeNevermoreAgh takes unit u returns nothing
local integer level=0
local real cooldown=0.
local player p=null
if SUIJI_MODE==false or SuijiMode_IsNativeNevermore(u)==false then
return
endif
set p=GetOwningPlayer(u)
set level=B287_GetUnitAbilityLevel(u,'A1MP')
if level>0 then
set cooldown=B287_MHAbility_GetCooldown(u,'A1MP')
endif
if GetUnitAbilityLevel(u,'A1MU')>0 then
call UnitRemoveAbility(u,'A1MU')
endif
if level>0 and B287_GetUnitAbilityLevel(u,'A29J')==0 then
call B287_UnitRemoveAbility(u,'A1MP')
call B287_UnitAddAbility(u,'A29J')
call B287_UnitMakeAbilityPermanent(u,true,'A29J')
call B287_SetUnitAbilityLevel(u,'A29J',level)
if cooldown>0. then
call B287_YDWESetUnitAbilityState(u,'A29J',1,cooldown)
call B287_MHAbility_SetCooldown(u,'A29J',cooldown)
endif
endif
call B287_SetPlayerAbilityAvailable(p,'A1MP',false)
set p=null
endfunction
function SuijiMode_IsFixedPersistentAghPair takes integer normalSkill,integer aghSkill returns boolean
if (normalSkill=='A06R' and aghSkill=='A1B4') or (normalSkill=='A0DH' and aghSkill=='A1OB') then
return true
endif
return (normalSkill=='A29G' and aghSkill=='A29H') or (normalSkill=='A03R' and aghSkill=='A0AV') or (normalSkill=='A07U' and aghSkill=='A2SR') or (normalSkill=='A054' and aghSkill=='A00U') or (normalSkill=='A2O6' and aghSkill=='A2ZG') or (normalSkill=='A11K' and aghSkill=='Z31K') or (normalSkill=='A03O' and aghSkill=='A3K8') or (normalSkill=='A1AO' and aghSkill=='A1UV') or (normalSkill=='A0NS' and aghSkill=='A1DA') or (normalSkill=='A1BX' and aghSkill=='A2SL') or (normalSkill=='A0L3' and aghSkill=='A2SU') or (normalSkill=='A1MI' and aghSkill=='A2SE') or (normalSkill=='A0G4' and aghSkill=='A1D8') or (normalSkill=='A21Y' and aghSkill=='A1GU') or (normalSkill=='A29J' and aghSkill=='A1MP') or (normalSkill=='A1W8' and aghSkill=='A1W9') or (normalSkill=='A0S8' and aghSkill=='A1QP') or (normalSkill=='A1T5' and aghSkill=='A235') or (normalSkill=='A1U6' and aghSkill=='A2UO') or (normalSkill=='A0MU' and aghSkill=='A0A2') or (normalSkill=='A2CI' and aghSkill=='A2SB') or (normalSkill=='A2BG' and aghSkill=='A2SA') or (normalSkill=='A0J1' and aghSkill=='A1D7') or (normalSkill=='A0CC' and aghSkill=='A02Z') or (normalSkill=='A02Q' and aghSkill=='A1D9') or (normalSkill=='S008' and aghSkill=='S00U') or (normalSkill=='A013' and aghSkill=='A0A6') or (normalSkill=='A0LT' and aghSkill=='A1CS')
endfunction
function SuijiMode_GetStableHeroIndex takes unit u returns integer
local integer h=0
local integer heroIndex=0
if u==null or GetUnitTypeId(u)==0 then
return 0
endif
set h=GetHandleId(u)
set heroIndex=LoadInteger(L7,h,StringHash("SuijiStableHeroIndex"))
if heroIndex>=KL4 and heroIndex<=K54 then
return heroIndex
endif
set heroIndex=GetUnitPointValue(u)
if heroIndex>=KL4 and heroIndex<=K54 then
call SaveInteger(L7,h,StringHash("SuijiStableHeroIndex"),heroIndex)
endif
return heroIndex
endfunction
function SuijiMode_GetFixedPersistentNativeAghBook takes unit u returns integer
local integer id=0
local integer source=0
if u==null or GetUnitTypeId(u)==0 then
return 0
endif
set id=GetUnitTypeId(u)
set source=SuijiMode_GetStableHeroIndex(u)
if source>=KL4 and source<=K54 and HQ4[source]!=0 and SuijiMode_IsFixedPersistentAghPair(HP4[source],HQ4[source]) then
return F29(u)
endif
if id=='Hmbr' then
return 'A0U1'
elseif id=='Hjai' or id=='Zjai' or id=='Zjaj' or id=='Zjak' then
return 'A0U3'
elseif id=='HC49' then
return 'A2SS'
elseif id=='E005' or id=='Z005' or id=='Z105' or id=='Z205' then
return 'A0UF'
elseif id=='H000' then
return 'A2ZI'
elseif id=='H06S' then
return 'A2XW'
elseif id=='U00A' or id=='Z00A' or id=='Z10A' then
return 'A2XZ'
elseif id=='E002' then
return 'A1UU'
elseif id=='Udea' then
return 'A1D3'
elseif id=='Uktl' or id=='Zktl' then
return 'A2SM'
elseif id=='N01A' then
return 'A2SV'
elseif id=='N0HP' then
return 'A2SF'
elseif id=='H00U' or id=='Z00U' or id=='Z10U' or id=='Z20U' or id=='Z02X' then
return 'A1BD'
endif
return 0
endfunction
function SuijiMode_NormalizeNativePersistentAgh takes unit u returns nothing
local integer book=0
if SUIJI_MODE==false then
return
endif
set book=SuijiMode_GetFixedPersistentNativeAghBook(u)
if book!=0 and GetUnitAbilityLevel(u,book)>0 then
call UnitRemoveAbility(u,book)
endif
endfunction
// OMG only: rawcode must match the hero's actual scepter state.
function SuijiMode_UsesAghPairVariant takes unit u,integer castSkill,integer normalSkill,integer aghSkill returns boolean
if u==null or GetUnitTypeId(u)==0 then
return false
endif
if castSkill!=normalSkill and castSkill!=aghSkill then
return false
endif
if SUIJI_MODE==false then
return true
endif
if SuijiMode_HasAghanimState(u) then
return castSkill==aghSkill
endif
return castSkill==normalSkill
endfunction
function CHIA_JUDGMENT takes player p2 returns nothing
local unit playeru=GetBuyingUnit()
local integer slot
local integer goldcost=2000
local string tx="Abilities\\Spells\\Items\\AIem\\AIemTarget.mdl"
local integer i1
if IsUnitType(playeru,UNIT_TYPE_HERO)==false then
set playeru=M7[GetPlayerId(GetOwningPlayer(playeru))]
endif
set slot=FIND_SLOT(playeru,1)
set i1=GetUnitTypeId(playeru)
if (i1=='N0MB' or i1=='N0MC' or i1=='N0MO' or i1=='N0MA') then
call X37(p2,"|c00FF0000开启严寒烧灼时无法购买|r")
set playeru=null
return
endif
if CHIA[GetPlayerId(p2)]==0 then
if slot>-1 then
call RemoveItem(UnitItemInSlot(playeru,slot))
call XF7(playeru,'A330')
call CHIA_TX(playeru,p2)
call DestroyEffect(AddSpecialEffectTarget(tx,playeru,"origin"))
set CHIA[GetPlayerId(p2)]=1
call CHIA_SKILL(playeru,p2)
set SUIJI_AGH_UPDATE_UNIT=playeru
call ExecuteFunc("SuijiMode_UpdateAghSkillsAfterBlessing")
else
call X37(p2,"|c00FF0000英雄未持有阿哈利姆神杖|r")
call AdjustPlayerStateBJ(goldcost,p2,PLAYER_STATE_RESOURCE_GOLD)
endif
else
call DisplayTextToPlayer(p2,0,0, "|c00FF0000你已经购买过阿哈利姆祝福，返还购买金钱|r")
call AdjustPlayerStateBJ(goldcost,p2,PLAYER_STATE_RESOURCE_GOLD)
call XF7(playeru,'A330')
call CHIA_SKILL(playeru,p2)
call CHIA_TX(playeru,p2)
set SUIJI_AGH_UPDATE_UNIT=playeru
call ExecuteFunc("SuijiMode_UpdateAghSkillsAfterBlessing")
call DestroyEffect(AddSpecialEffectTarget(tx,playeru,"origin"))
endif
set playeru=null
endfunction
function CHIBS_JUDGMENT takes player p2 returns nothing
local unit playeru=GetBuyingUnit()
local integer slot
local integer goldcost=2000
if IsUnitType(playeru,UNIT_TYPE_HERO)==false then
set playeru=M7[GetPlayerId(GetOwningPlayer(playeru))]
endif
set slot=FIND_SLOT(playeru,2)
if slot>-1 then
call RemoveItem(UnitItemInSlot(playeru,slot))
call XF7(playeru,'A332')
call UnitMakeAbilityPermanent(playeru,true,'A14K')
call SetPlayerAbilityAvailable(p2,'A332',false)
call XF7(playeru,'A26A')
call XF7(playeru,'A333')
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIem\\AIemTarget.mdl",playeru,"origin"))
if IsPlayerAlly(GetLocalPlayer(),p2) then
call PingMinimapEx(GetUnitX(playeru),GetUnitY(playeru),3,0,$FF,0,false)
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,4,Q[GetPlayerId(p2)]+(KZ4[GetPlayerId(p2)])+"|r |c00ffff00获得了真视之力|r")
endif
else
call X37(p2,"|c00FF0000英雄未持有真视宝石|r")
call AdjustPlayerStateBJ(goldcost,p2,PLAYER_STATE_RESOURCE_GOLD)
endif
set playeru=null
endfunction
function CHILLX_SKILL takes unit u,player p returns nothing
local integer id=GetUnitTypeId(u)
if id=='Ubal' or id=='Zbal' then
call XF7(u,'A33B')
call SetPlayerAbilityAvailable(p,'A33B',false)
endif
endfunction
function CHILLX_JUDGMENT takes player p2 returns nothing
local unit playeru=GetBuyingUnit()
local integer slot
local integer goldcost=2000
local string tx="Abilities\\Spells\\Items\\AIem\\AIemTarget.mdl"
if IsUnitType(playeru,UNIT_TYPE_HERO)==false then
set playeru=M7[GetPlayerId(GetOwningPlayer(playeru))]
endif
set slot=FIND_SLOT(playeru,3)
if CHILLX[GetPlayerId(p2)]==0 then
if slot>-1 then
call RemoveItem(UnitItemInSlot(playeru,slot))
call DestroyEffect(AddSpecialEffectTarget(tx,playeru,"origin"))
call XF7(playeru,'A334')
call XF7(playeru,'A2VW')
call CHILLX_SKILL(playeru,p2)
set CHILLX[GetPlayerId(p2)]=1
else
call X37(p2,"|c00FF0000英雄未持有玲珑心|r")
call AdjustPlayerStateBJ(goldcost,p2,PLAYER_STATE_RESOURCE_GOLD)
endif
else
call DisplayTextToPlayer(p2,0,0, "|c00FF0000你已经购买过玲珑心之力，返还购买金钱|r")
call AdjustPlayerStateBJ(goldcost,p2,PLAYER_STATE_RESOURCE_GOLD)
call XF7(playeru,'A2VW')
call XF7(playeru,'A334')
call CHILLX_SKILL(playeru,p2)
call DestroyEffect(AddSpecialEffectTarget(tx,playeru,"origin"))
endif
set playeru=null
endfunction
function XPE takes integer O5,integer o6,integer n6,integer XQE,integer XRE,integer XSE,integer XTE,integer XUE returns nothing
set eY[$80+O5]=o6
set eY[$90+O5]=n6
set eY[$A0+O5]=XQE
set eY[$AC+O5]=XRE
set eY[$BC+O5]=XSE
set hG[$90+O5]=XTE
set hG[$A0+O5]=XUE
endfunction
