function Test_Control takes nothing returns nothing
	local player p=GetTriggerPlayer()
	local integer id
	local integer i=0
    set id=GetPlayerId(p)
	loop
	exitwhen i>12
	if i!=id then
	call SetPlayerAlliance( Player(i), p , ALLIANCE_SHARED_CONTROL, true )
	endif
	set i=i+1
	endloop
	set p=null
endfunction
function Test_EnableEnemyAIControl takes player p returns nothing
local integer id=GetPlayerId(p)
local integer i=0
local player q=null
loop
exitwhen i>12
set q=Player(i)
if i!=id and ((TV7(p) and TW7(q)) or (TW7(p) and TV7(q))) then
call SetPlayerAlliance(q,p,ALLIANCE_PASSIVE,false)
call SetPlayerAlliance(p,q,ALLIANCE_PASSIVE,false)
call SetPlayerAlliance(q,p,ALLIANCE_HELP_REQUEST,false)
call SetPlayerAlliance(p,q,ALLIANCE_HELP_REQUEST,false)
call SetPlayerAlliance(q,p,ALLIANCE_HELP_RESPONSE,false)
call SetPlayerAlliance(p,q,ALLIANCE_HELP_RESPONSE,false)
call SetPlayerAlliance(q,p,ALLIANCE_SHARED_XP,false)
call SetPlayerAlliance(p,q,ALLIANCE_SHARED_XP,false)
call SetPlayerAlliance(q,p,ALLIANCE_SHARED_SPELLS,false)
call SetPlayerAlliance(p,q,ALLIANCE_SHARED_SPELLS,false)
call SetPlayerAlliance(q,p,ALLIANCE_SHARED_VISION,true)
call SetPlayerAlliance(q,p,ALLIANCE_SHARED_VISION_FORCED,true)
call SetPlayerAlliance(q,p,ALLIANCE_SHARED_CONTROL,false)
call SetPlayerAlliance(p,q,ALLIANCE_SHARED_CONTROL,false)
call SetPlayerAlliance(q,p,ALLIANCE_SHARED_ADVANCED_CONTROL,false)
call SetPlayerAlliance(p,q,ALLIANCE_SHARED_ADVANCED_CONTROL,false)
if M7[i]!=null then
call MHUnit_EnableViewSkill(M7[i],p)
endif
endif
set i=i+1
endloop
call DisplayTimedTextToPlayer(p,0,0,10.,"|cFF00FF00测试模式：已开放敌方AI视野和技能查看，敌对关系保持不变。|r")
set q=null
endfunction
