local item sourceItem=null
local boolean canTrigger=false
if skill!='A0N5' and B291_IsRealSpellCast(u,skill) and (B287_GetUnitAbilityLevel(u,'A0N5')>0 or (ISLABIKE(u) and ISPH(u)==false)) and UL7(skill) and B287_GetUnitAbilityLevel(u,skill)>0 then
set sourceItem=MHAbility_GetSourceItem(u,B287_GetPhysicalAbilityId(u,skill))
set canTrigger=sourceItem==null
endif
set sourceItem=null
set u=null
return canTrigger
endfunction
