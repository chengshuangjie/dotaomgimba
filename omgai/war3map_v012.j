function Have_Item takes unit it,integer Iz returns boolean
local integer I8=0
local item ja
loop
set ja=UnitItemInSlot(it,I8)
if((ja!=null)and(GetItemTypeId(ja)==Iz))then
set ja=null
return true
endif
set I8=I8+1
exitwhen I8>=bj_MAX_INVENTORY
endloop
set ja=null
return false
endfunction
function Have_Item_Quantity takes unit it,integer Iz returns integer
local integer I8=0
local item ja
local integer n=0
loop
set ja=UnitItemInSlot(it,I8)
if((ja!=null)and(KZ7(ja)==Iz))then
set n=n+1
endif
set I8=I8+1
exitwhen I8>=bj_MAX_INVENTORY
endloop
set ja=null
return n
endfunction
