function HYF_BUFF2 takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(TABLE_XJ,(OB7),(2)))
local player p=GetOwningPlayer(ZX7)
local integer WF8=(LoadInteger(TABLE_XJ,(OB7),(100)))
if GetTriggerEventId()==EVENT_UNIT_DEATH or WF8==30 then
    call RemoveSavedHandle(TABLE_HY, GetHandleId(ZX7),'A4KW')
    call DestroyEffect((LoadEffectHandle(TABLE_XJ,(OB7),(175))))
	call DestroyEffect((LoadEffectHandle(TABLE_XJ,(OB7),(176))))
	call DestroyEffect((LoadEffectHandle(TABLE_XJ,(OB7),(177))))
    call FlushChildHashtable(TABLE_XJ,(OB7))
    call OZ7(t)
elseif GetTriggerEventId()==EVENT_PLAYER_UNIT_SPELL_EFFECT or GetTriggerEventId()==EVENT_PLAYER_UNIT_SPELL_CAST then
    if GetSpellTargetUnit()==ZX7 and IsUnitEnemy(ZX7,GetOwningPlayer(GetTriggerUnit())) and GetUnitAbilityLevel(GetTriggerUnit(),'Aloc')==0 and GetUnitAbilityLevel(GetTriggerUnit(),'A04R')==0 then
        call KR7(GetTriggerUnit())
    endif
elseif GetTriggerEventId()==EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER then
    if GetOrderTargetUnit()==ZX7 and(GetIssuedOrderId()>= 852008 and GetIssuedOrderId()<= 852013)and IsUnitEnemy(ZX7,GetOwningPlayer(GetTriggerUnit())) and GetUnitAbilityLevel(GetTriggerUnit(),'Aloc')==0 and GetUnitAbilityLevel(GetTriggerUnit(),'A04R')==0 then
        call KR7(GetTriggerUnit())
    endif
else
    set WF8=WF8+1
    call SaveInteger(TABLE_XJ,(OB7),(100), WF8)
endif
set t=null
set ZX7=null
set p=null
return false
endfunction
function HYF_BUFF takes unit ZX7,unit u1,unit u2 returns nothing
local player p=GetOwningPlayer(ZX7)
local trigger t
local integer OB7
local string fx="effects\\huanyingfu.mdl"
local string fx2="effects\\huanyingfu.mdl"
if IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(ZX7))or WG7(GetLocalPlayer())then
    set fx2=""
endif
if HaveSavedHandle(TABLE_HY, GetHandleId(ZX7),'A4KW') then
    set t=LoadTriggerHandle(TABLE_HY, GetHandleId(ZX7),'A4KW')
    set OB7=GetHandleId(t)
    call SaveInteger(TABLE_XJ,(OB7),(100), 0)
else
    set t=CreateTrigger()
    set OB7=GetHandleId(t)
    call SaveTriggerHandle(TABLE_HY, GetHandleId(ZX7),'A4KW', t)
    call TriggerRegisterTimerEvent(t,0.1,true)
    call TriggerRegisterUnitEvent(t,ZX7,EVENT_UNIT_DEATH)
    call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call YB7(t,EVENT_PLAYER_UNIT_SPELL_CAST)
    call YB7(t,EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER)
    call SaveUnitHandle(TABLE_XJ,(OB7),(2),(ZX7))
    call SaveInteger(TABLE_XJ,(OB7),(100), 0)
    call SaveEffectHandle(TABLE_XJ,(OB7),(175),(AddSpecialEffectTarget(fx,ZX7,"chest")))
	call SaveEffectHandle(TABLE_XJ,(OB7),(176),(AddSpecialEffectTarget(fx2,u1,"chest")))
	call SaveEffectHandle(TABLE_XJ,(OB7),(177),(AddSpecialEffectTarget(fx2,u2,"chest")))
    call TriggerAddCondition(t,Condition(function HYF_BUFF2))
endif
set ZX7=null
set p=null
set t=null
endfunction
function Use_FSF2 takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local real x1=LoadReal(L7,(I97),(11))
local real y1=LoadReal(L7,(I97),(12))
local real x2=LoadReal(L7,(I97),(13))
local real y2=LoadReal(L7,(I97),(14))
local real x3=LoadReal(L7,(I97),(15))
local real y3=LoadReal(L7,(I97),(16))
local real damage
local real injured
local unit u1
local unit u2
local integer n=GetRandomInt(1,3)
local boolean b=LoadBoolean(L7,(I97),(10))
if IsUnitType(ZX7, UNIT_TYPE_MELEE_ATTACKER) then
	set damage=0.33
	if GetPlayerController(GetOwningPlayer(ZX7))==MAP_CONTROL_USER then
		set injured=2.3
	else
		set injured=3.5
	endif
else
	set damage=0.28
	if GetPlayerController(GetOwningPlayer(ZX7))==MAP_CONTROL_USER then
		set injured=2.6
	else
		set injured=4.
	endif
endif
call UnitCancelHide(ZX7)
call SetUnitInvulnerable(ZX7,false)
set u1=MHUnit_CreateIllusion(GetOwningPlayer(ZX7),ZX7,GetUnitX(ZX7),GetUnitY(ZX7))
call MHUnit_SetIllusionDamageDeal(u1,damage)
call MHUnit_SetIllusionDamageReceive(u1,injured)
call XF7(u1,'A4LB')
call UnitApplyTimedLife(u1,'BTLF',20)
call MHUnit_FlagTypeOperator(u1,FLAG_OPERATOR_REMOVE,UNIT_FLAG_TYPE_SUMMON)
set u2=MHUnit_CreateIllusion(GetOwningPlayer(ZX7),ZX7,GetUnitX(ZX7),GetUnitY(ZX7))
call MHUnit_SetIllusionDamageDeal(u2,damage)
call MHUnit_SetIllusionDamageReceive(u2,injured)
call XF7(u2,'A4LB')
call UnitApplyTimedLife(u2,'BTLF',20)
call MHUnit_FlagTypeOperator(u2,FLAG_OPERATOR_REMOVE,UNIT_FLAG_TYPE_SUMMON)
call CF_ADD_SPEED(u1)
call CF_ADD_SPEED(u2)
call FSTX(u1)
call FSTX(u2)
if MV7(ZX7,ZU[H2])!=null then
call Ohv(u1)
call Ohv(u2)
endif
if WQ7(ZX7) then
	call XF7(u1,'A4KS')
	call XF7(u2,'A4KS')
endif
if GetUnitAbilityLevel(ZX7,'BNms')>0 then
	call XF7(u1,'A4LC')
	call XF7(u2,'A4LC')
endif



if n==1 then
	call SetUnitPosition(ZX7,x1,y1)
	call SetUnitX(u1,x2)
	call SetUnitY(u1,y2)
	call SetUnitX(u2,x3)
	call SetUnitY(u2,y3)
elseif n==2 then
	call SetUnitPosition(ZX7,x2,y2)
	call SetUnitX(u1,x1)
	call SetUnitY(u1,y1)
	call SetUnitX(u2,x3)
	call SetUnitY(u2,y3)
else
	call SetUnitPosition(ZX7,x3,y3)
	call SetUnitX(u1,x1)
	call SetUnitY(u1,y1)
	call SetUnitX(u2,x2)
	call SetUnitY(u2,y2)
endif
if Ab[GetPlayerId(GetOwningPlayer(ZX7))]then
call SelectUnitAddForPlayer(u1,GetOwningPlayer(ZX7))
call SelectUnitAddForPlayer(u2,GetOwningPlayer(ZX7))
endif
if b then
	call HYF_BUFF(ZX7,u1,u2)
endif
call FlushChildHashtable(L7,(I97))
call OZ7(t)
set t=null
set ZX7=null
set u1=null
set u2=null
return false
endfunction
function Use_FSF takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local real face=GetUnitFacing(ZX7)
local real a
local trigger t
local integer I97
local real x=GetUnitX(ZX7)
local real y=GetUnitY(ZX7)
local real x1
local real y1
local real x2
local real y2
local real x3
local real y3
local real distance=125
local boolean b=false
if B287_GetSpellAbilityId()=='A4KW' then
	set b=true
endif
call Clear_FS(ZX7)
call YZ8(ZX7)
call YW8(ZX7,0,0)
// call IssueImmediateOrder(ZX7,"stop")
call UnitEnterHide(ZX7)
call SetUnitInvulnerable(ZX7,true)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageCaster.mdl",x,y))
set x1=x+(distance-25)*Cos(face*bj_DEGTORAD)
set y1=y+(distance-25)*Sin(face*bj_DEGTORAD)
set a=face+150
if a>=360 then
	set a=a-360
endif
set x2=x+distance*Cos(a*bj_DEGTORAD)
set y2=y+distance*Sin(a*bj_DEGTORAD)
set a=face-150
if a<0 then
	set a=a+360
endif
set x3=x+distance*Cos(a*bj_DEGTORAD)
set y3=y+distance*Sin(a*bj_DEGTORAD)
set t=CreateTrigger()
set I97=GetHandleId(t)
call TriggerRegisterTimerEvent(t,0.1,false)
call TriggerAddCondition(t,Condition(function Use_FSF2))
call SaveUnitHandle(L7,(I97),(2),(ZX7))
call SaveReal(L7,(I97),(11),(x1))
call SaveReal(L7,(I97),(12),(y1))
call SaveReal(L7,(I97),(13),(x2))
call SaveReal(L7,(I97),(14),(y2))
call SaveReal(L7,(I97),(15),(x3))
call SaveReal(L7,(I97),(16),(y3))
call SaveBoolean(L7,(I97),(10),(b))
set t=null
set ZX7=null
endfunction
//分身斧
function LCF takes nothing returns nothing
if B287_GetSpellAbilityId()=='A0B8' or B287_GetSpellAbilityId()=='A4KW' then
    call Use_FSF()
endif
endfunction
function L3F takes integer id returns boolean
return id=='ugho' or id=='unec' or id=='esen' or id=='edry' or id=='u001' or id=='u002' or id=='e00V' or id=='e00W' or id=='ebal' or id=='e026' or id=='umtw' or id=='u00R' or id=='n00D' or id=='n003' or id=='n00E'
endfunction
function L6F takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit p5=O77(OB7,"Source")
local unit m5=O77(OB7,"Target")
local integer O5=GetPlayerId(GetOwningPlayer(m5))
local integer WF8=LoadInteger(TABLE_HY,GetHandleId(m5),'A4DI')
set BANITEM[O5]=false
if GetTriggerEventId()==EVENT_UNIT_DEATH or WF8==0 or (GetTriggerEvalCount(t)>1 and GetUnitAbilityLevel(m5,'B0CG')==0) then
call UnitRemoveAbility(m5,'B0CG')
call UnitRemoveAbility(m5,'A4DI')
call DestroyEffect(OG7(OB7,"FX"))
call SaveInteger(TABLE_HY,GetHandleId(m5),'A4DI',0)
call NM7(OB7)
call OZ7(t)
elseif WF8>0 then
set WF8=WF8-1
call SaveInteger(TABLE_HY,GetHandleId(m5),'A4DI',WF8)
set BANITEM[O5]=true
if GetUnitAbilityLevel(m5,'B0CG')>0 then
if GetUnitState(m5,UNIT_STATE_LIFE)>(150./8.+.5)then
call B67(p5,m5,2,0.1)
call SetUnitState(m5,UNIT_STATE_LIFE,GetUnitState(m5,UNIT_STATE_LIFE)-150./8.)
call Add_EX_PlayerDamage(p5,m5,150./8.)
else
set V04[GetPlayerId(GetOwningPlayer(m5))]=true
set E97=true
call B67(p5,m5,1,50)
set V04[GetPlayerId(GetOwningPlayer(m5))]=false
set E97=false
endif
endif
endif
set t=null
set p5=null
set m5=null
return false
endfunction
function LLF takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit m5=O77(OB7,"Target")
local integer WF8=LoadInteger(TABLE_HY,GetHandleId(m5),'A33F')
if GetTriggerEventId()==EVENT_UNIT_DEATH or (GetTriggerEventId()==EVENT_UNIT_DAMAGED and (L3F(GetUnitTypeId(GetEventDamageSource()))==false and GetOwningPlayer(GetEventDamageSource())!=B7 or GetUnitTypeId(GetEventDamageSource())=='n00L' and GetEventDamage()>0) or V14) or WF8==0 then
call UnitRemoveAbility(m5,'B0HW')
call UnitRemoveAbility(m5,'A33F')
call DestroyEffect(OG7(OB7,"FX"))
call SaveInteger(TABLE_HY,GetHandleId(m5),'A33F',0)
call NM7(OB7)
call OZ7(t)
elseif WF8>0 then
set WF8=WF8-1
call SaveInteger(TABLE_HY,GetHandleId(m5),'A33F',WF8)
if GetUnitAbilityLevel(m5,'B0HW')>0 then
call SetUnitState(m5,UNIT_STATE_LIFE,GetUnitState(m5,UNIT_STATE_LIFE)+50)
if GetUnitState(m5,UNIT_STATE_LIFE)!=GetUnitState(m5,UNIT_STATE_MAX_LIFE) then
call HXXS("+50",1,m5,.03)
endif
endif
endif
set t=null
set m5=null
return false
endfunction
function L1F takes nothing returns nothing
local trigger t
local integer OB7
local unit p5=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local integer i=0
local boolean L0F=false
local boolean L5F=false
local integer VV8
if m5==null then
set m5=GetTriggerUnit()
endif
loop
exitwhen i>5 or L5F
if KZ7(UnitItemInSlot(p5,i))==DY4 then
set VV8=GetItemCharges(UnitItemInSlot(p5,i))
if VV8>0 then
set L0F=true
set VV8=VV8-1
call SaveInteger(TABLE_VV,'I0KY',GetPlayerId(GetOwningPlayer(p5)),VV8)
else
set L5F=true
set L0F=false
endif
endif
set i=i+1
endloop
if L0F then
set t=CreateTrigger()
set OB7=GetHandleId(t)
if IsUnitAlly(m5,GetOwningPlayer(p5)) then
if LoadInteger(TABLE_HY,GetHandleId(m5),'A33F')==0 then
call XF7(m5,'A33F')
call SaveInteger(TABLE_HY,GetHandleId(m5),'A33F',8)
call NT7(OB7,"Target",m5)
call NU7(OB7,"FX",AddSpecialEffectTarget("war3mapImported\\ShadowWordPurple.mdx",m5,"overhead"))
call TriggerRegisterTimerEvent(t,0,false)
call TriggerRegisterTimerEvent(t,1,true)
call TriggerRegisterUnitEvent(t,m5,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(t,m5,EVENT_UNIT_DAMAGED)
call TriggerAddCondition(t,Condition(function LLF))
else
call SaveInteger(TABLE_HY,GetHandleId(m5),'A33F',8)
endif
else
if LoadInteger(TABLE_HY,GetHandleId(m5),'A4DI')==0 then
call XF7(m5,'A4DI')
call SaveInteger(TABLE_HY,GetHandleId(m5),'A4DI',8)
call NT7(OB7,"Target",m5)
call NT7(OB7,"Source",p5)
call NU7(OB7,"FX",AddSpecialEffectTarget("war3mapImported\\Urn_Enemy.mdx",m5,"overhead"))
call TriggerRegisterTimerEvent(t,0,false)
call TriggerRegisterTimerEvent(t,1,true)
call TriggerRegisterUnitEvent(t,m5,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function L6F))
else
call SaveInteger(TABLE_HY,GetHandleId(m5),'A4DI',8)
endif
endif
endif
set p5=null
set m5=null
set t=null
endfunction
//骨灰
function L2F takes nothing returns nothing
if B287_GetSpellAbilityId()=='A1MO' then
	if IsUnitAlly(GetSpellTargetUnit(),GetOwningPlayer(GetTriggerUnit())) or WQ7(GetSpellTargetUnit())==false then
		call L1F()
	else
		call PLK(GetSpellTargetUnit())
	endif
endif
endfunction
function DAGUHUI2 takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit p5=O77(OB7,"Source")
local unit m5=O77(OB7,"Target")
local integer O5=GetPlayerId(GetOwningPlayer(m5))
local real d
local integer WF8=LoadInteger(TABLE_HY,GetHandleId(m5),'A2Z1')
set BANITEM[O5]=false
set DGH_BAD[O5]=0
if GetTriggerEventId()==EVENT_UNIT_DEATH or WF8==0 or (GetTriggerEvalCount(t)>1 and GetUnitAbilityLevel(m5,'B0I2')==0) then
	call UnitRemoveAbility(m5,'B0I2')
	call UnitRemoveAbility(m5,'A2Z1')
	call DestroyEffect(OG7(OB7,"FX"))
	call SaveInteger(TABLE_HY,GetHandleId(m5),'A2Z1',0)
	call NM7(OB7)
	call OZ7(t)
elseif WF8>0 then
	set WF8=WF8-1
	call SaveInteger(TABLE_HY,GetHandleId(m5),'A2Z1',WF8)
	set BANITEM[O5]=true
	set DGH_BAD[O5]=1
	if  GetUnitAbilityLevel(m5,'B0I2')>0 then
		set d=GetUnitState(m5,UNIT_STATE_LIFE)*.03
		if GetUnitState(m5,UNIT_STATE_LIFE)>d+20.5 then
			call B67(p5,m5,2,0.1)
			call SetUnitState(m5,UNIT_STATE_LIFE,GetUnitState(m5,UNIT_STATE_LIFE)-d-20)
			call Add_EX_PlayerDamage(p5,m5,d+20)
		else
			set V04[GetPlayerId(GetOwningPlayer(m5))]=true
			set E97=true
			call B67(p5,m5,1,50)
			set V04[GetPlayerId(GetOwningPlayer(m5))]=false
			set E97=false
		endif
	endif
endif
set t=null
set p5=null
set m5=null
return false
endfunction
function DAGUHUI1 takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit m5=O77(OB7,"Target")
local integer O5=GetPlayerId(GetOwningPlayer(m5))
local real d
local integer WF8=LoadInteger(TABLE_HY,GetHandleId(m5),'A2YU')
if GetTriggerEventId()==EVENT_UNIT_DEATH or (GetTriggerEventId()==EVENT_UNIT_DAMAGED and (L3F(GetUnitTypeId(GetEventDamageSource()))==false and GetOwningPlayer(GetEventDamageSource())!=B7 or GetUnitTypeId(GetEventDamageSource())=='n00L' and GetEventDamage()>0) or V14) or WF8==0 then
set DGH_GOOD[O5]=0
call UnitRemoveAbility(m5,'B0HZ')
call UnitRemoveAbility(m5,'A2YU')
call DestroyEffect(OG7(OB7,"FX"))
call SaveInteger(TABLE_HY,GetHandleId(m5),'A2YU',0)
call NM7(OB7)
call OZ7(t)
elseif WF8>0 then
set WF8=WF8-1
call SaveInteger(TABLE_HY,GetHandleId(m5),'A2YU',WF8)
set DGH_GOOD[O5]=1
if GetUnitAbilityLevel(m5,'B0HZ')>0  then
set d=GetUnitState(m5,UNIT_STATE_LIFE)*.01
call SetUnitState(m5,UNIT_STATE_LIFE,GetUnitState(m5,UNIT_STATE_LIFE)+d+35)
if GetUnitState(m5,UNIT_STATE_LIFE)!=GetUnitState(m5,UNIT_STATE_MAX_LIFE) then
call HXXS("+35",1,m5,.03)
call HXXS("+"+I2S(R2I(d)),1,m5,.03)
endif
endif
endif
set t=null
set m5=null
return false
endfunction
function DAGUHUIPD takes nothing returns nothing
local trigger t
local integer OB7
local unit p5=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local integer i=0
local boolean L0F=false
local boolean L5F=false
local integer VV8
local integer skill=B287_GetSpellAbilityId()
local real d
if m5==null then
set m5=GetTriggerUnit()
endif
if skill=='A4LE' then
	set L0F=true
else
	loop
		exitwhen i>5 or L5F
		if KZ7(UnitItemInSlot(p5,i))==it_dgh then
			set VV8=GetItemCharges(UnitItemInSlot(p5,i))
			if VV8>0 then
				set L0F=true
			else
				set L5F=true
				set L0F=false
			endif
		endif
		set i=i+1
	endloop
endif
if L0F then
	set t=CreateTrigger()
	set OB7=GetHandleId(t)
	if IsUnitAlly(m5,GetOwningPlayer(p5)) then
		if LoadInteger(TABLE_HY,GetHandleId(m5),'A2YU')==0 then
			call XF7(m5,'A2YU')
			call SaveInteger(TABLE_HY,GetHandleId(m5),'A2YU',8)
			call NT7(OB7,"Target",m5)
			call NU7(OB7,"FX",AddSpecialEffectTarget("war3mapImported\\ShadowWordPurple.mdx",m5,"overhead"))
			call TriggerRegisterTimerEvent(t,0,false)
			call TriggerRegisterTimerEvent(t,1,true)
			call TriggerRegisterUnitEvent(t,m5,EVENT_UNIT_DEATH)
			call TriggerRegisterUnitEvent(t,m5,EVENT_UNIT_DAMAGED)
			call TriggerAddCondition(t,Condition(function DAGUHUI1))
		else
			call SaveInteger(TABLE_HY,GetHandleId(m5),'A2YU',8) 
		endif
	else
		if LoadInteger(TABLE_HY,GetHandleId(m5),'A2Z1')==0 then
			call NT7(OB7,"Target",m5)
			call NT7(OB7,"Source",p5)
			call SaveInteger(TABLE_HY,GetHandleId(m5),'A2Z1',8)
			call XF7(m5,'A2Z1')
			call NU7(OB7,"FX",AddSpecialEffectTarget("war3mapImported\\Urn_Enemy.mdx",m5,"overhead"))
			call TriggerRegisterTimerEvent(t,0,false)
			call TriggerRegisterTimerEvent(t,1,true)
			call TriggerRegisterUnitEvent(t,m5,EVENT_UNIT_DEATH)
			call TriggerAddCondition(t,Condition(function DAGUHUI2))
		else
			call SaveInteger(TABLE_HY,GetHandleId(m5),'A2Z1',8) 
		endif
		if skill=='A4LE' then
			set d=7
			if GetUnitAbilityLevel(p5,'A2VW')>0 then
				set d=d*.75
			endif
			call Japi_ReduceUnitAbilityCoolDown(p5,skill,d)
		endif
	endif
endif
set p5=null
set m5=null
set t=null
endfunction
