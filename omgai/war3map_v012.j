function Marksmanship_HasScepter takes unit marksmanshipUnit returns boolean
if marksmanshipUnit==null then
return false
endif
return SuijiMode_HasAghanimState(marksmanshipUnit)
endfunction
function Marksmanship_UpdateScepterState takes unit marksmanshipUnit returns nothing
if marksmanshipUnit==null then
return
endif
if B287_GetUnitAbilityLevel(marksmanshipUnit,'A0VC')>0 and Marksmanship_HasScepter(marksmanshipUnit) then
if GetUnitAbilityLevel(marksmanshipUnit,'S3UR')==0 then
call XF7(marksmanshipUnit,'S3UR')
call UnitMakeAbilityPermanent(marksmanshipUnit,true,'S3UR')
endif
else
if GetUnitAbilityLevel(marksmanshipUnit,'S3UR')>0 then
call UnitRemoveAbility(marksmanshipUnit,'S3UR')
endif
endif
endfunction
function AWD takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local group g=WS7()
local integer BC7=B287_GetUnitAbilityLevel(ZX7,'A0VC')
call Marksmanship_UpdateScepterState(ZX7)
set IN4=ZX7
call GroupEnumUnitsInRange(g,GetUnitX(ZX7),GetUnitY(ZX7),450+25,Condition(function A_7))
if FirstOfGroup(g)==null and ISPH(ZX7)==false then
if GetUnitAbilityLevel(ZX7,'A2NX')!=BC7 then
call XF7(ZX7,'A2NX')
call SetUnitAbilityLevel(ZX7,'A2NX',BC7)
endif
else
if GetUnitAbilityLevel(ZX7,'A2NX')>0 then
call UnitRemoveAbility(ZX7,'A2NX')
endif
endif
call WR7(g)
set ZX7=null
set t=null
set g=null
return false
endfunction
function Marksmanship_RegisterAttackEvent takes nothing returns nothing
if SuijiMarksmanshipAttackEventReady==false then
call RegisterUnitAttackEvent("Marksmanship",1)
set SuijiMarksmanshipAttackEventReady=true
endif
endfunction
function SuijiMode_StartMarksmanshipTimer takes unit suijiMarksmanshipUnit returns nothing
local trigger suijiMarksmanshipTrigger=null
local integer suijiMarksmanshipUnitHandle=0
local integer suijiMarksmanshipTriggerHandle=0
if suijiMarksmanshipUnit==null then
return
endif
set suijiMarksmanshipUnitHandle=GetHandleId(suijiMarksmanshipUnit)
if OO7(suijiMarksmanshipUnitHandle,"SuijiA0VCInit") then
call Marksmanship_UpdateScepterState(suijiMarksmanshipUnit)
return
endif
call NS7(suijiMarksmanshipUnitHandle,"SuijiA0VCInit",true)
call Marksmanship_UpdateScepterState(suijiMarksmanshipUnit)
call Marksmanship_RegisterAttackEvent()
set suijiMarksmanshipTrigger=CreateTrigger()
set suijiMarksmanshipTriggerHandle=GetHandleId(suijiMarksmanshipTrigger)
call TriggerRegisterTimerEvent(suijiMarksmanshipTrigger,.1,true)
call TriggerAddCondition(suijiMarksmanshipTrigger,Condition(function AWD))
call SaveUnitHandle(L7,suijiMarksmanshipTriggerHandle,2,suijiMarksmanshipUnit)
set suijiMarksmanshipTrigger=null
endfunction
//小黑分裂箭
function MarksmanshipActions takes nothing returns nothing
	local unit target = W22
	local integer h = GetHandleId(GetTriggeringTrigger())
	call B67_DPS(LoadUnitHandle(TABLE_HY, h,'xhts'), target, 2, LoadReal(TABLE_HY, h,'xhts'))
	//call Z1I(LoadUnitHandle(TABLE_HY, h,'xhts'), target) //模拟攻击触发法球
	set target = null
endfunction

function Marksmanship_tsw takes unit u, unit u2, unit target, real damage returns nothing
	local trigger t = NHX_TANSHE(u, u2, target,'h30C', "MarksmanshipActions", 900, true, "")
	local integer h = GetHandleId(t)
	
	
	call SaveReal(TABLE_HY, h,'xhts', damage)
	call SaveUnitHandle(TABLE_HY, h,'xhts', u)
	set t = null
endfunction

function MarksmanshipEnumTarget takes nothing returns boolean
	return(IsUnitEnemy(U22, GetOwningPlayer(GetFilterUnit())) and IsAliveNotStrucNotWard(GetFilterUnit()) and lWA(GetFilterUnit(), GetOwningPlayer(U22)) ) != null
endfunction

function MarksmanshipEnum takes unit u, unit target returns nothing
	local unit fu
	local group g = WS7() 
	local real damage
	local integer i = 1
	set U22 = u
	call GroupEnumUnitsInRange(g, GetUnitX(target), GetUnitY(target), 425, Condition(function MarksmanshipEnumTarget))
	set damage = (GetUnitState(u, UNIT_STATE_ATTACK1_DAMAGE_BASE) + GetUnitState(u, UNIT_STATE_ATTACK1_DAMAGE_BONUS) )* 0.4
	loop
		set fu = GroupPickRandomUnit(g)
	exitwhen(fu == null or i > 2)
		if target != fu then
			call Marksmanship_tsw(u, target, fu, damage)
			
			
			
			set i = i + 1
		endif
		call GroupRemoveUnit(g, fu)
	endloop
	call WR7(g)
	set fu = null
	set g = null
endfunction

function Marksmanship takes nothing returns nothing
	if ISPH(WXX)==false and B287_GetUnitAbilityLevel(WXX,'A0VC')>0 and GetUnitAbilityLevel(WXX,'S3UR')>0 and Marksmanship_HasScepter(WXX) and (GetUnitTypeId(WXX)=='Nbrn' or (SUIJI_MODE and OO7(GetHandleId(WXX),"SuijiA0VCInit"))) and IsUnitEnemy(WXX, GetOwningPlayer(YXX)) then
		call MarksmanshipEnum(WXX, YXX)
	endif
endfunction
