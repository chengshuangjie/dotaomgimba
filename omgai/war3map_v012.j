function AI_USE_JSMJ takes unit u,unit IH7 returns boolean
	local integer orderid=$D0073
	if AI_SKILL_OK(u,'A00J')==false and AI_SKILL_OK(u,'A4K2')==false then
		return false
	endif
	if AI_SKILL_OK(u,'A4K2') then
		if IH7!=null then
			return M57(u,orderid,'A4K2',IH7)
		else
			return M57(u,orderid,'A4K2',u)
		endif
	else
		return N97(u,orderid,'A00J')
	endif
endfunction
