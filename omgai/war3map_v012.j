function Q4D takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit WX7=GetTriggerUnit()
local integer spellId=B287_GetSpellAbilityId()
local integer skill='A0NS'
local integer BC7=0
local integer BZ7=0
local boolean QXD=false
local real cooltime=60
local real d=ReduceUnitAbilityCoolDownReal(WX7)
local integer O5=GetPlayerId(GetOwningPlayer(WX7))
local real remaining=TimerGetRemaining(N84[O5])
if SuijiMode_HasAghanimState(WX7) then
set BC7=SuijiMode_GetPairCastLevel(WX7,spellId,'A0NS','A1DA')
set cooltime=40
set QXD=true
else
set BC7=SuijiMode_GetPairCastLevel(WX7,spellId,'A0NS','A1DA')
endif
set BZ7=4+BC7
if d>0 then
set cooltime=cooltime*d
endif
if GetGameTime()>HGFZ[O5] and OT7(WX7,"BorrowedTime|Active") then
	call OX7(WX7,"BorrowedTime|Active")
endif
if BC7>0 and OT7(WX7,"BorrowedTime|Active")==false and remaining<=0 and ((GetTriggerEventId()==EVENT_UNIT_SPELL_EFFECT and (spellId=='A0NS' or spellId=='A1DA')) or ((GetTriggerEventId()==EVENT_UNIT_DAMAGED and MHAbility_GetCooldown(WX7,skill)==0 and GetUnitState(WX7,UNIT_STATE_LIFE)<300+BC7*100) and GetEventDamage()<9999 and MRPH(WX7)==false)) then
call TimerStart(N84[GetPlayerId(GetOwningPlayer(WX7))],cooltime,false,null)
if B287_GetUnitAbilityLevel(WX7,'A0NS')>0 then
call B287_YDWESetUnitAbilityState(WX7, 'A0NS', 1, cooltime)
endif
if B287_GetUnitAbilityLevel(WX7,'A1DA')>0 then
call B287_YDWESetUnitAbilityState(WX7, 'A1DA', 1, cooltime)
endif
call HG_O37(WX7,"BorrowedTime|Active",BZ7)
set HGFZ[O5]=GetGameTime()+BZ7
call UnitRemoveBuffs(WX7,false,true)
call YW8(WX7,0,0)
// if GetTriggerEventId()==EVENT_UNIT_DAMAGED then
// call DisableTrigger(t)
// set DE7=true
