function SVF takes nothing returns boolean
local integer i1=B287_GetSpellAbilityId()
if i1=='A0AA' or i1=='A1EV' or i1=='A0SX' or i1=='A0GJ' or i1=='A0GE' or i1=='A0GS' or i1=='A0AB' or i1=='A1HR' or i1=='A1S5' or i1=='A1IN' or i1=='A1S8' or i1=='A0AC' or i1=='A0AD' or i1=='A0AE' or i1=='A1AO' or i1=='A1UV' or i1=='A1DJ' or i1=='A1U7' or i1=='A1S7' or i1=='A0X6' or i1=='A284' or i1=='A0HM' or i1=='X0HM' or (i1=='A07X' or i1=='A0AL') or i1=='A07T' or i1=='A0X6' or i1=='A0FZ' then
elseif i1=='A14Q' or i1=='X14Q' or i1=='X24Q' or i1=='X34Q' then
call KillUnit(GetTriggerUnit())
else
call B287_UnitRemoveAbility(GetTriggerUnit(),i1)
endif
return true
endfunction
function SWF takes nothing returns boolean
