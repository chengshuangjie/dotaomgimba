function U29 takes nothing returns boolean
local unit suijiWarpathUnit=GetTriggerUnit()
local integer suijiWarpathSkill=B287_GetSpellAbilityId()
local item suijiWarpathSourceItem=null
local boolean suijiWarpathCanTrigger=false
if suijiWarpathSkill=='A0GP' or suijiWarpathSkill=='A0FW' or suijiWarpathSkill=='A4E9' then
set suijiWarpathCanTrigger=true
elseif OO7(GetHandleId(suijiWarpathUnit),"SuijiWarpath") and UL7(suijiWarpathSkill) and LC7(suijiWarpathSkill)==false and L67(suijiWarpathSkill)==false and B287_GetUnitAbilityLevel(suijiWarpathUnit,suijiWarpathSkill)>0 then
set suijiWarpathSourceItem=MHAbility_GetSourceItem(suijiWarpathUnit,B287_GetPhysicalAbilityId(suijiWarpathUnit,suijiWarpathSkill))
set suijiWarpathCanTrigger=suijiWarpathSourceItem==null
endif
set suijiWarpathSourceItem=null
set suijiWarpathUnit=null
return suijiWarpathCanTrigger
endfunction
function U_9 takes integer V77,integer a returns integer
if a==0 then
return 1
else
return(V77-1)*5+1+a
endif
endfunction
