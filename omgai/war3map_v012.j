function IAG takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit m5=O77(OB7,"Target")
local image i=OK7(OB7,"i")
local real x=ON7(OB7,"x")
local real y=ON7(OB7,"y")
local unit ZX7=O77(OB7,"Source")
local integer sourceHandle=GetHandleId(ZX7)
local integer activeCount=0
local integer targetHandle=GetHandleId(m5)
local integer targetCount=0
if GetTriggerEventId()!=EVENT_UNIT_SPELL_EFFECT or (GetTriggerEventId()==EVENT_UNIT_SPELL_EFFECT and B287_GetSpellAbilityId()=='A13D') then
if GetTriggerEventId()!=EVENT_UNIT_DEATH and WF7(m5)==false then
call SetUnitPosition(m5,x,y)
endif
set activeCount=OM7(sourceHandle,"SuijiXMarkActiveCount")-1
if activeCount<0 then
set activeCount=0
endif
call NP7(sourceHandle,"SuijiXMarkActiveCount",activeCount)
if activeCount==0 then
call SuijiMode_RemoveIdleTransientButton(ZX7,'A13D')
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A11N',true)
else
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A13D',true)
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A11N',false)
endif
set targetCount=OM7(targetHandle,"XMarkedCount")-1
if targetCount<0 then
set targetCount=0
endif
call NP7(targetHandle,"XMarkedCount",targetCount)
call NS7(targetHandle,"XMarked",targetCount>0)
call DestroyEffect(OG7(OB7,"FX"))
call ShowImage(i,false)
call DestroyImage(i)
call NM7(OB7)
call OZ7(t)
endif
set t=null
set m5=null
set i=null
set ZX7=null
return false
endfunction
function KunkkaXMark_SyncReturnButton takes unit u returns nothing
if u==null or GetUnitTypeId(u)==0 or B287_GetUnitAbilityLevel(u,'A11N')<=0 or GetUnitAbilityLevel(u,'A13D')<=0 then
return
endif
call MHAbility_SetCustomDataInt(u,'A13D',ABILITY_DEF_DATA_BUTTON_X,B287_MHAbility_GetCustomDataInt(u,'A11N',ABILITY_DEF_DATA_BUTTON_X))
call MHAbility_SetCustomDataInt(u,'A13D',ABILITY_DEF_DATA_BUTTON_Y,B287_MHAbility_GetCustomDataInt(u,'A11N',ABILITY_DEF_DATA_BUTTON_Y))
call MHAbility_SetCustomDataInt(u,'A13D',ABILITY_DEF_DATA_UNBUTTON_X,B287_MHAbility_GetCustomDataInt(u,'A11N',ABILITY_DEF_DATA_UNBUTTON_X))
call MHAbility_SetCustomDataInt(u,'A13D',ABILITY_DEF_DATA_UNBUTTON_Y,B287_MHAbility_GetCustomDataInt(u,'A11N',ABILITY_DEF_DATA_UNBUTTON_Y))
call MHAbility_SetCustomDataInt(u,'A13D',ABILITY_DEF_DATA_HOTKEY,B287_MHAbility_GetCustomDataInt(u,'A11N',ABILITY_DEF_DATA_HOTKEY))
call MHAbility_SetCustomDataInt(u,'A13D',ABILITY_DEF_DATA_UNHOTKEY,B287_MHAbility_GetCustomDataInt(u,'A11N',ABILITY_DEF_DATA_UNHOTKEY))
endfunction
function X_texttag takes nothing returns nothing
	local trigger t = GetTriggeringTrigger()
	local integer h = GetHandleId(t)
	local unit tri_u = LoadUnitHandle(TABLE_HY, h, 0)
	local unit m5 = LoadUnitHandle(TABLE_HY, h, 1)
	local real V77 = LoadReal(TABLE_HY, h, 0)
	local real X_time = GetTriggerEvalCount(t)* .5
	local texttag tt
	if (GetTriggerEventId()==EVENT_UNIT_SPELL_EFFECT and B287_GetSpellAbilityId()=='A13D') or GetTriggerEventId()==EVENT_UNIT_DEATH or X_time >= V77 then
		call FlushChildHashtable(TABLE_HY, h)
		call OZ7(t)
	else
		set tt = CreateTextTag()
		call SetTextTagText(tt, R2SW(V77 -X_time, 1, 1), .03)
		call SetTextTagPosUnit(tt, m5, 0)
		call SetTextTagColorBJ(tt, 150, 0, 255, 15)
		call SetTextTagVelocity(tt, 0, .035)
		call SetTextTagFadepoint(tt, 3)
		call SetTextTagLifespan(tt, .5)
		call SetTextTagPermanent(tt, false)
		call SetTextTagVisibility(tt, IsUnitAlly(tri_u, GetLocalPlayer()) or WG7(GetLocalPlayer()))
	endif
	set tt = null
	set t = null
	set tri_u = null
	set m5 = null
endfunction
function IBG takes nothing returns nothing
local unit p5=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local real x=GetUnitX(m5)
local real y=GetUnitY(m5)
local real ICG=90
local image i=CreateImage("Fonts\\X.blp",ICG,ICG,0,x-ICG/ 2,y-ICG/ 2,0,0,0,0,2)
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local string fx=""
local real V77=4.
local trigger tt
local integer id=GetUnitTypeId(p5)
local integer sourceHandle=GetHandleId(p5)
local integer activeCount=OM7(sourceHandle,"SuijiXMarkActiveCount")
call O37(m5,"4401",5)
if activeCount<=0 then
call SuijiMode_RemoveIdleTransientButton(p5,'A13D')
endif
if GetUnitAbilityLevel(p5,'A13D')<=0 then
call XF7(p5,'A13D')
endif
call NP7(sourceHandle,"SuijiXMarkActiveCount",activeCount+1)
call KunkkaXMark_SyncReturnButton(p5)
call SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A13D',true)
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A11N',false)
if ISLABIKE(p5) then
    call ChangeUnitSkillHotKey(p5,'A13D',"X|","C|",OSKEY_C)
endif
call SetImageRenderAlways(i,true)
if IsUnitAlly(p5,GetOwningPlayer(m5))then
set V77=V77*2
endif
if IsUnitAlly(p5,GetOwningPlayer(m5))==false or IsUnitAlly(m5,GetLocalPlayer()) or WG7(GetLocalPlayer())then
set fx="effects\\BlackTide.mdx"
call ShowImage(i,true)
else
call ShowImage(i,false)
endif
call SetImageColor(i,$FF,0,0,$FF)
call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(p5),'o00G',x,y,0),'BTLF',5)
call TriggerRegisterTimerEvent(t,V77,false)
call TriggerRegisterUnitEvent(t,m5,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(t,p5,EVENT_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function IAG))
call NP7(GetHandleId(m5),"XMarkedCount",OM7(GetHandleId(m5),"XMarkedCount")+1)
call NS7(GetHandleId(m5),"XMarked",true)
call N57(OB7,"i",i)
call NT7(OB7,"Target",m5)
call NQ7(OB7,"x",x)
call NQ7(OB7,"y",y)
call NU7(OB7,"FX",AddSpecialEffectTarget(fx,m5,"overhead"))
call NT7(OB7,"Source",p5)
call NQ7(GetHandleId(m5),"AI|XMark|X",x)
call NQ7(GetHandleId(m5),"AI|XMark|Y",y)
set tt = CreateTrigger()
call TriggerRegisterTimerEvent(tt, .5, true)
call TriggerRegisterUnitEvent(tt, p5, EVENT_UNIT_SPELL_EFFECT)
call TriggerRegisterUnitEvent(tt,m5,EVENT_UNIT_DEATH)
call SaveUnitHandle(TABLE_HY, GetHandleId(tt), 0, p5)
call SaveUnitHandle(TABLE_HY, GetHandleId(tt), 1, m5)
call SaveReal(TABLE_HY, GetHandleId(tt), 0, V77+.5)	
call TriggerAddCondition(tt, Condition(function X_texttag))
set tt = null
set p5=null
set m5=null
set i=null
set t=null
endfunction
function I3G takes nothing returns boolean
if GetTriggerEventId()==EVENT_PLAYER_UNIT_SPELL_EFFECT then
if B287_GetSpellAbilityId()=='A11N' and (IsUnitAlly(GetSpellTargetUnit(),GetOwningPlayer(GetTriggerUnit())) or WQ7(GetSpellTargetUnit())==false) then
    call LINGXIA(GetTriggerUnit(),GetSpellTargetUnit())
    if UnitAlive(GetSpellTargetUnit()) then
        call IBG()
    endif
endif
else
if B287_GetLearnedSkill()=='A11N' then
call SetPlayerAbilityAvailable(GetOwningPlayer(GetTriggerUnit()),'A13D',false)
call XF7(GetTriggerUnit(),'A13D')
endif
endif
return false
endfunction
function I6G takes nothing returns boolean
if B287_GetSpellAbilityId()=='A11N' then
if OO7(GetHandleId(GetOwningPlayer(GetSpellTargetUnit())),"DisableHelp")and IsUnitAlly(GetSpellTargetUnit(),GetOwningPlayer(GetTriggerUnit())) then
call KR7(GetTriggerUnit())
call X37(GetOwningPlayer(GetTriggerUnit()),VU7('n038'))
endif
endif
return false
endfunction
function M_8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call YB7(t,EVENT_PLAYER_HERO_SKILL)
call TriggerAddCondition(t,Condition(function I3G))
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_CAST)
call TriggerAddCondition(t,Condition(function I6G))
set t=null
endfunction
//幽灵船
function DZR takes nothing returns boolean
	local trigger t = GetTriggeringTrigger()
	local integer h = GetHandleId(t)
	local integer BOX = 1
	local player p
	local real d
	local unit NWWE = LoadUnitHandle(TABLE_HY, h, 17)
	local integer D_R = LoadInteger(TABLE_HY, h,$88)
	local integer N5O = LoadInteger(TABLE_HY, h,$BC)
	if GetTriggerEventId()== EVENT_WIDGET_DEATH or GetTriggerEvalCount(t)> N5O then
		call FlushChildHashtable(TABLE_HY, h)
		call OZ7(t)
	else
		loop
		exitwhen BOX > D_R
			set p = LoadPlayerHandle(TABLE_HY, h,$514+ BOX)
			set d = LoadReal(TABLE_HY, h,$4B0+ BOX)
			if p == null then
				set BOX = D_R
			else
				call SetWidgetLife(NWWE, RMaxBJ(1, GetWidgetLife(NWWE)-d / N5O))
			endif
			set BOX = BOX + 1
		endloop
	endif
	set t = null
	set p = null
	set NWWE = null
	return false
endfunction
function D0R takes nothing returns boolean
	local trigger t = GetTriggeringTrigger()
	local integer h = GetHandleId(t)
	local unit NWWE = LoadUnitHandle(TABLE_HY, h, 17)
	local player p = LoadPlayerHandle(TABLE_HY, h, 54)
	local trigger D1R = LoadTriggerHandle(TABLE_HY, h,$87)
	local integer BOX = GetTriggerEvalCount(t)
	if GetTriggerEventId()==EVENT_UNIT_DEATH then
		call FlushChildHashtable(TABLE_HY, h)
		call OZ7(t)
		call FlushChildHashtable(TABLE_HY, GetHandleId(D1R))
		call OZ7(D1R)
	elseif GetTriggerEventId()!= EVENT_UNIT_DAMAGED then
		call FlushChildHashtable(TABLE_HY, h)
		call OZ7(t)
		call TriggerRegisterTimerEvent(D1R, 1, true)
		call TriggerAddCondition(D1R, Condition(function DZR))
		call UnitRemoveAbility(NWWE,'B09U')
	elseif FKK then
		set h = GetHandleId(D1R)
		call SavePlayerHandle(TABLE_HY, h,$514+ BOX, GetOwningPlayer(GetEventDamageSource()))
		call SaveReal(TABLE_HY, h,$4B0+ BOX, .5 * GetEventDamage()* 1.)
		call SaveInteger(TABLE_HY, h,$88, BOX)
	endif
	set t = null
	set NWWE = null
	set p = null
	set D1R = null
	return false
endfunction
function D2R takes nothing returns nothing
	local unit NWUE = HDV
	local unit NWWE = GetEnumUnit()
	local trigger t = CreateTrigger()
	local integer h = GetHandleId(t)
	local integer N5O =8
	local trigger D1R = CreateTrigger()
call Z67(NWWE,'A126',1,N5O)
call SetPlayerAbilityAvailable(GetOwningPlayer(NWWE),'A126',false)
	call TriggerRegisterTimerEvent(t, N5O + .01, false)
	call TriggerRegisterUnitEvent(t, NWWE, EVENT_UNIT_DAMAGED)
	call TriggerRegisterUnitEvent(t, NWWE, EVENT_UNIT_DEATH)
	call TriggerAddCondition(t, Condition(function D0R))
	call SavePlayerHandle(TABLE_HY, h, 54,(GetOwningPlayer(NWUE)))
	call SaveUnitHandle(TABLE_HY, h, 17,(NWWE))
	call SaveTriggerHandle(TABLE_HY, h,$87,(D1R))
	call SaveUnitHandle(TABLE_HY,(GetHandleId(D1R)), 17,(NWWE))
	call SaveInteger(TABLE_HY,(GetHandleId(D1R)),$BC,(N5O))
	set NWUE = null
	set NWWE = null
	set t = null
	set D1R = null
endfunction
function D3R takes nothing returns boolean
	if(IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO) and IsUnitEnemy(U22, GetOwningPlayer(GetFilterUnit()))== false and(IsAliveNotStrucNotWard(GetFilterUnit())) and DBX(GetFilterUnit())) and IsUnitInGroup(GetFilterUnit(), HCV)== false then
		call GroupAddUnit(HCV, GetFilterUnit())
		return true
	endif
	return false
endfunction
function D4R takes nothing returns nothing
	local unit NWUE = HDV
	local unit NWWE = GetEnumUnit()
	local integer ODX = HFV
	call BA7(NWUE,NWWE,1.4)
	call B67(NWUE, NWWE, 1, 200 + 100 * ODX)
	set NWUE = null
	set NWWE = null
endfunction
function YOI1 takes nothing returns boolean
	return(IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO) or IsUnitIllusion(GetFilterUnit()) ) and DCX() and IsHideUnit(GetFilterUnit())==false
endfunction
function D5R takes nothing returns boolean
	local trigger t = GetTriggeringTrigger()
	local integer h = GetHandleId(t)
	local unit NIX =(LoadUnitHandle(TABLE_HY, h, 45))
	local unit D6R
	local real a =(LoadReal(TABLE_HY, h, 13))
	local real NWYE = GetUnitX(NIX)
	local real NWZE = GetUnitY(NIX)
	local real NW_E =(LoadReal(TABLE_HY, h, 66))
	local real NW0E =(LoadReal(TABLE_HY, h, 67))
	local integer EVX = GetTriggerEvalCount(t)
	local real NBX = CoordinateX50(NW_E + 13.33 * EVX * Cos(a))
	local real NCX = CoordinateY50(NW0E + 13.33 * EVX * Sin(a))
	local integer level =(LoadInteger(TABLE_HY, h, 5))
	local group D7R =(LoadGroupHandle(TABLE_HY, h, 187))
	local group g
	local group g2
	local unit u
	local boolean b = LoadBoolean(TABLE_HY, h, 5)
    local integer c = LoadInteger(TABLE_HY, h, 6)
	local integer TYIPP
if BlockUnitPass(NIX) then
    set D6R =(LoadUnitHandle(TABLE_HY, h,$BA))
    call KillUnit(NIX)
    call KillUnit(D6R)
    call DestroyEffect(LoadEffectHandle(TABLE_HY,h,10))
    call WR7(D7R)
    call FlushChildHashtable(TABLE_HY, h)
    call OZ7(t)
	set t = null
	set NIX = null
	set D6R = null
	set D7R = null
	return false
endif
if EVX < c then
	if not b then
		if EVX < 19 then
			call SetUnitVertexColor(NIX, 255, 255, 255, 5 + EVX * 10)
			set D6R =(LoadUnitHandle(TABLE_HY, h,$BA))
			call SetUnitVertexColor(D6R, 255, 255, 255, 5 + EVX * 10)
		elseif EVX < 125 then
			call SetUnitVertexColor(NIX, 255, 255, 255,$BE)
		endif
	else
		if EVX < 12 then
			call SetUnitVertexColor(NIX, 255, 255, 255, 5 + EVX * 20)
			call SetUnitVertexColor(LoadUnitHandle(TABLE_HY, h, 186), 255, 255, 255, 5 + EVX * 20)
		elseif EVX < 74 then
			call SetUnitVertexColor(NIX, 255, 255, 255, 190)
		endif
	endif
	set g = WS7()
	set HCV = D7R
	set U22 = NIX
	set HDV = NIX
	set HFV = level
	call GroupEnumUnitsInRange(g, GetUnitX(NIX), GetUnitY(NIX), 425, Condition(function D3R))
	call ForGroup(g, function D2R)
	call WR7(g)
	call SetUnitX(NIX, NBX)
	call SetUnitY(NIX, NCX)
	if b then
		set g2 = WS7()
		set TYIPP = 84
		call GroupEnumUnitsInRange(g2, NBX, NCX, 225, Condition(function YOI1))
		loop
			set u = FirstOfGroup(g2)
		exitwhen u == null
			call SetUnitX(u, NBX)
			call SetUnitY(u, NCX)
			call GroupRemoveUnit(g2, u)
		endloop
		call WR7(g2)
		if ModuloInteger(EVX, 10) == 1 then
			call Y67(NBX, NCX, 325)
		endif
	else
		set TYIPP = 140
	endif
	if EVX == TYIPP then
		set D6R =(LoadUnitHandle(TABLE_HY, h,$BA))
		call KillUnit(D6R)
	elseif EVX < TYIPP then
		set D6R =(LoadUnitHandle(TABLE_HY, h,$BA))
		call SetUnitX(D6R, NBX)
		call SetUnitY(D6R, NCX)
	endif
endif
    if EVX == c then
        call DestroyEffect(LoadEffectHandle(TABLE_HY,h,10))
		set g = WS7()
		set U22 = NIX
		call GroupEnumUnitsInRange(g, NBX, NCX, 450, Condition(function DHX))
		call ForGroup(g, function D4R)
        call WR7(g)
		call WR7(D7R)
        call KillUnit(NIX)
		call FlushChildHashtable(TABLE_HY, h)
		call OZ7(t)
    endif
	set t = null
	set NIX = null
	set D6R = null
	set D7R = null
	set g = null
	set g2 = null
	set u = null
	return false
endfunction
function YYV takes nothing returns nothing
	local unit u = GetTriggerUnit()
	local real NWYE = 0.
	local real NWZE = 0.
	local real x0 = 0.
	local real y0 = 0.
	local real a
	local real x1
	local real y1
	local real x2
	local real y2
	local trigger t
	local integer h
	local integer level
	local unit NIX
	local unit D6R
	local string s = ""
local integer D8R ='h06U'
local boolean b = SuijiMode_HasAghanimState(u)
local integer c = 150
local integer id=0
if u==null or GetUnitTypeId(u)==0 then
set u=null
return
endif
if SuijiMode_ShouldBlockScepterPairReentry(u,B287_GetSpellAbilityId(),'A11K','Z31K',"SuijiKunkkaShipPair",.20) then
set u=null
return
endif
set NWYE=GetUnitX(u)
set NWZE=GetUnitY(u)
set x0=GetSpellTargetX()
set y0=GetSpellTargetY()
set id=GetUnitTypeId(u)
	if GetRandomInt(0, 5)== 0 then
		set D8R ='h0DJ'
	endif
	if IsPlayerAlly(GetOwningPlayer(u), GetLocalPlayer()) or WG7(GetLocalPlayer()) then
        if id=='Z02X' then
            set s = "model\\Hero_Kunkka_N8S_T_mark1.mdl"
        else            
		    set s = "war3mapImported\\Whirlpool.mdx"
        endif
	endif
	if x0 == GetUnitX(u) and y0 == GetUnitY(u) then
		set x0 = x0 + 50 * Cos(GetUnitFacing(u)* bj_DEGTORAD)
		set y0 = y0 + 50 * Sin(GetUnitFacing(u)* bj_DEGTORAD)
	endif
	set a = Atan2(y0 -NWZE, x0 -NWYE)
	if b then
		set x1 = NWYE -200 * Cos(a)
		set y1 = NWZE- 200 * Sin(a)
		set c = 90
	else
		set x1 = NWYE -1000 * Cos(a)
		set y1 = NWZE -1000 * Sin(a)
	endif
	set x2 = NWYE +$3E8* Cos(a)
	set y2 = NWZE +$3E8* Sin(a)
	set t = CreateTrigger()
	set h = GetHandleId(t)
	set level = SuijiMode_GetPairCastLevel(u,B287_GetSpellAbilityId(),'A11K','Z31K')
	set NIX = CreateUnit(GetOwningPlayer(u), D8R, x1, y1, Atan2(y0 -NWZE, x0 -NWYE)* bj_RADTODEG)
    if id=='Z02X' then
        call MHUnit_SetModel(NIX,"model\\Hero_Kunkka_N8S_T_ship1.mdl",false)
        call SetUnitScale(NIX,1.,1.,1.)
    endif
	set D6R = CreateUnit(GetOwningPlayer(u),'h06V', x1, y1, Atan2(y0 -NWZE, x0 -NWYE)* bj_RADTODEG)
	call SetUnitVertexColor(NIX, 255, 255, 255, 0)
	call SetUnitPathing(NIX, false)
	call SaveInteger(TABLE_HY, h, 5,(level))
	call SaveReal(TABLE_HY, h, 13,((a)* 1.))
	call SaveUnitHandle(TABLE_HY, h, 45,(NIX))
	call SaveUnitHandle(TABLE_HY, h,$BA,(D6R))
	call SaveReal(TABLE_HY, h, 66,((x1)* 1.))
	call SaveReal(TABLE_HY, h, 67,((y1)* 1.))
	call SaveGroupHandle(TABLE_HY, h, 187,WS7())
	call SaveBoolean(TABLE_HY, h, 5, b)
	call SaveInteger(TABLE_HY, h, 6, c)
    if id=='Z02X' then
        call SaveEffectHandle(TABLE_HY,h,10,AddSpecialEffect(s,CoordinateX50(x2),CoordinateY50(y2)))
    else
	    call DestroyEffect(AddSpecialEffect(s, CoordinateX50(x2), CoordinateY50(y2)))
    endif
	call TriggerRegisterTimerEvent(t, .02, true)
	call TriggerAddCondition(t, Condition(function D5R))
	set u = null
	set t = null
	set NIX = null
	set D6R = null
endfunction
