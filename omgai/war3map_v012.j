function OHO takes nothing returns nothing
	local timer t = GetExpiredTimer()
	local integer h = GetHandleId(t)
	local player p = LoadPlayerHandle(TABLE_HY, h, 0)
	local integer TME = GetPlayerId(p)
	local integer OJO = Get_Item_Price(LoadInteger(TABLE_HY, h, 1))/ 2
	if OJO > 0 then
		call DisplayTimedTextToPlayer(p, 0, 0, 5, "出售10秒内购入的物品,返还  |cfffffa00" + I2S(OJO)+ "|r 金钱.")
		call SetPlayerState(p, PLAYER_STATE_RESOURCE_GOLD, GetPlayerState(p, PLAYER_STATE_RESOURCE_GOLD)+ OJO)
		// call SaveInteger(TABLE_P,'ITEM', TME, 0)
		// call SaveReal(TABLE_P,'ITEM', TME, .0)
		// call SaveInteger(TABLE_P,'ITEM', TME, 0)
		// call SaveReal(TABLE_P,'ITEM', TME, .0)
	endif
	call PauseTimer(t)
	call DestroyTimer(t)
	set t = null
	set p = null
endfunction
function Alreay_Use takes item it returns boolean
local integer id=GetItemTypeId(it)
if id==ZU[TC] then
if GetItemCharges(it)!=4 then
return true
endif
endif
if id==ZU[CC] then
if GetItemCharges(it)!=2 then
return true
endif
endif
return false
endfunction
