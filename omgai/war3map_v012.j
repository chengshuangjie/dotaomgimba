set IW=KF7(GetUnitX(j5),GetUnitY(j5),GetUnitX(WX7),GetUnitY(WX7))
set kl=RAbsBJ(Atan2(GetLocationY(Hb)-GetUnitY(j5),GetLocationX(Hb)-GetUnitX(j5)))
