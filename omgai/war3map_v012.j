function N8F takes nothing returns nothing
local unit it=GetEnumUnit()
local integer O5=GetPlayerId(GetOwningPlayer(it))
local integer i=1
local real MH_time=TimerGetRemaining(U[O5])
if((IsUnitType(it,UNIT_TYPE_HERO))and(not IsUnitIllusion(it)))then
    if((GetPlayerController(GetOwningPlayer(it))==MAP_CONTROL_COMPUTER)and(GetWidgetLife(it)>.405)and(IsUnitType(it,UNIT_TYPE_DEAD)==false))then
        call ExecuteFunc("N9F")
    elseif IG4[O5]then
        set h4[O5]=null
        // if(((TimerGetRemaining(U[O5])>25. and LS)or(TimerGetRemaining(U[O5])>50. and LS==false))and(GetPlayerState(Player(O5),PLAYER_STATE_RESOURCE_GOLD)>5000)and(TimerGetElapsed(U[O5])>4.))then
		if ((PSR and MH_time>9) or (LS and MH_time>19) or (PDR and MH_time>80) or (PGR and MH_time>80) or (PSR==false and LS==false and PDR==false and PGR==false and MH_time>40)) and GetRandomInt(1,20)==1 and GetPlayerState(Player(O5),PLAYER_STATE_RESOURCE_GOLD)>5000 and TimerGetElapsed(U[O5])>2. then
            loop
            exitwhen NM4[i]==GetEnumUnit()or i>NP4
            set i=i+1
            endloop
if NM4[i]!=null and GetUnitAbilityLevel(KU4[O5],'A20U')==0 and HSS[O5]==false then
                call IssueImmediateOrderById(KU4[O5],W9[O5])
            endif
        endif
    endif
elseif Q87(it) and GetUnitTypeId(it)!='ncop' and M87(it) then
    set bj_lastLoadedUnit=GetEnumUnit()
    call ExecuteFunc("NDF")
endif
set it=null
endfunction
function NEF takes nothing returns boolean
