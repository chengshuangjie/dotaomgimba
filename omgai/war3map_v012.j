local integer OB7=GetHandleId(t)
local unit ZX7=O77(OB7,"Source")
local integer BC7=0
local group g
if ZX7==null or GetUnitTypeId(ZX7)==0 then
call NM7(OB7)
call OZ7(t)
set t=null
set ZX7=null
set g=null
return false
endif
set BC7=B287_GetUnitAbilityLevel(ZX7,'A21F')
if BC7!=0 then
if BC7==1 then
set Y94=100
elseif BC7==2 then
set Y94=130
else
set Y94=160
endif
else
set BC7=B287_GetUnitAbilityLevel(ZX7,'A21G')
if BC7==1 then
set Y94=160
elseif BC7==2 then
set Y94=190
else
set Y94=220
endif
endif
if GetTriggerEventId()==EVENT_WIDGET_DEATH or UnitAlive(ZX7)==false or GetUnitState(ZX7,UNIT_STATE_MANA)<0+20*BC7 or LoadInteger(L7,GetHandleId(ZX7),704)==-1 or (GetTriggerEventId()==EVENT_UNIT_SPELL_EFFECT and B287_GetSpellAbilityId()=='A21H') then
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A21F',true)
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A21G',true)
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A21H',false)
call UnitRemoveAbility(ZX7,'A4FX')
call UnitRemoveAbility(ZX7,'A4FY')
call UnitRemoveAbility(ZX7,'A4FZ')
call NM7(OB7)
call OZ7(t)
call OX7(ZX7,"AI|PulseNova")
elseif GetTriggerEventId()!=EVENT_UNIT_SPELL_EFFECT then
call SetUnitState(ZX7,UNIT_STATE_MANA,GetUnitState(ZX7,UNIT_STATE_MANA)-20*BC7)
set IN4=ZX7
set Y84=ZX7
set g=WS7()
call GroupEnumUnitsInRange(g,GetUnitX(ZX7),GetUnitY(ZX7),475,Condition(function AJ7_gai))
call ForGroup(g,function XYD)
call WR7(g)
set g=null
endif
set t=null
set ZX7=null
return false
endfunction
function XAD takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local trigger t=null
local integer OB7=0
local integer id=0
local string tx
if ZX7==null or GetUnitTypeId(ZX7)==0 then
set ZX7=null
return
endif
set t=CreateTrigger()
set OB7=GetHandleId(t)
set id=GetUnitTypeId(ZX7)
if id=='Zkee' then
    set tx="model\\Hero_TormentedSoul_N4S_V_Target.mdl"
    call XF7(ZX7,'A4FX')
elseif id=='Zkef' then
    set tx="model\\Hero_TormentedSoul_N3S_V_Target.mdl"
    call XF7(ZX7,'A4FY')
elseif id=='Zkeg' then
    set tx="model\\Hero_TormentedSoul_N2S_V_Target.mdl"
    call XF7(ZX7,'A4FZ')
else
    set tx="Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl"
endif
call DestroyEffect(AddSpecialEffectTarget(tx,ZX7,"origin"))
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A21F',false)
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A21G',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A21H',true)
call UnitAddAbility(ZX7,'A21H')
call TriggerRegisterTimerEvent(t,1,true)
call TriggerRegisterDeathEvent(t,ZX7)
call TriggerRegisterUnitEvent(t,ZX7,EVENT_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function XZD))
call NT7(OB7,"Source",ZX7)
call TriggerEvaluate(t)
call OV7(ZX7,"AI|PulseNova")
call SaveTriggerHandle(L7,(GetHandleId(ZX7)),('A21H'),(t))
set ZX7=null
set t=null
endfunction
