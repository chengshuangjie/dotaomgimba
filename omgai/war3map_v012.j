function ICD takes nothing returns nothing
local integer id=GetUnitTypeId(LZ)
local string tx
if id=='Z00S' then
    set tx="model\\Hero_STormSpirit_N6S_G_Target.mdl"
else
    set tx="Abilities\\Spells\\Human\\ManaFlare\\ManaFlareBoltImpact.mdl"
endif
if(LoadBoolean(L7,jZ,GetHandleId(GetEnumUnit()))==false)then
call SaveBoolean(L7,jZ,GetHandleId(GetEnumUnit()),true)
call B67(LZ,GetEnumUnit(),1,mZ*(JZ*4+6)/100)
call DestroyEffect(AddSpecialEffectTarget(tx,GetEnumUnit(),"origin"))
endif
endfunction
function I3D takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local integer V77=OM7(OB7,"Level")
local unit oA=O77(OB7,"Caster")
local unit p5=O77(OB7,"Source")
local unit I6D=O77(OB7,"Fake")
local integer u3=OM7(OB7,"Remaining")
local real hN=ON7(OB7,"x")
local real ho=ON7(OB7,"y")
local real u4=0.
local real u5=0.
local real RK=0.
local real Il=0.
local real IL=0.
local lightning MZ9=OH7(OB7,"Light")
local real ILD=ON7(OB7,"lx")
local real I1D=ON7(OB7,"ly")
local real T98=0.
//local real I0D=(25+25*V77)*(12+.007*GetUnitState(p5,UNIT_STATE_MAX_MANA))/100
local real I0D=0.
local group g=WS7()
local real I5D=ON7(OB7,"Traveled")
if p5==null or oA==null or I6D==null or GetUnitTypeId(p5)==0 or GetUnitTypeId(oA)==0 or GetUnitTypeId(I6D)==0 then
if MZ9!=null then
call DestroyLightning(MZ9)
endif
if p5!=null and GetUnitTypeId(p5)!=0 then
call SetUnitVertexColor(p5,$FF,$FF,$FF,$FF)
call SetUnitPathing(p5,true)
call SetUnitInvulnerable(p5,false)
endif
if oA!=null and GetUnitTypeId(oA)!=0 then
call RemoveUnit(oA)
endif
if I6D!=null and GetUnitTypeId(I6D)!=0 then
call RemoveUnit(I6D)
endif
call WR7(g)
call NM7(OB7)
call OZ7(t)
set t=null
set oA=null
set p5=null
set I6D=null
set MZ9=null
set g=null
return false
endif
set u4=GetUnitX(p5)
set u5=GetUnitY(p5)
set RK=Atan2(ho-u5,hN-u4)
set Il=CoordinateX50(u4+(25+25*V77)*Cos(RK))
set IL=CoordinateY50(u5+(25+25*V77)*Sin(RK))
set T98=GetUnitState(p5,UNIT_STATE_MANA)
set I0D=(25+25*V77)*(12+.006*GetUnitState(p5,UNIT_STATE_MAX_MANA))/100
set I5D=I5D+25+25*V77
call NQ7(OB7,"Traveled",I5D)
if GetTriggerEvalCount(t)>25 then
set ILD=ILD+(25+25*V77)*Cos(RK)
set I1D=I1D+(25+25*V77)*Sin(RK)
call NQ7(OB7,"lx",ILD)
call NQ7(OB7,"ly",I1D)
endif
call SetUnitState(p5,UNIT_STATE_MANA,RMaxBJ(T98-I0D,0))
call MoveLightning(MZ9,true,ILD,I1D,Il,IL)
call SetUnitX(p5,Il)
call SetUnitY(p5,IL)
call SetUnitPosition(oA,Il,IL)
call SetUnitPosition(I6D,Il,IL)
// call SetUnitX(oA,Il)
// call SetUnitY(oA,IL)
// call SetUnitX(I6D,Il)
// call SetUnitY(I6D,IL)
// call SetUnitX(oA,Il)
// call SetUnitY(oA,IL)
// call SetUnitX(I6D,Il)
// call SetUnitY(I6D,IL)
// call SetUnitX(oA,Il)
// call SetUnitY(oA,IL)
// call SetUnitX(I6D,Il)
// call SetUnitY(I6D,IL)
set IN4=p5
set LZ=p5
set jZ=OB7
set JZ=V77
set mZ=I5D
call GroupEnumUnitsInRange(g,Il,IL,75+75*V77,Condition(function AJ7_gai))
call ForGroup(g,function ICD)
call WR7(g)
set u3=u3-1
call NP7(OB7,"Remaining",u3)
if u3==0 or GetUnitState(p5,UNIT_STATE_MANA)<1 or IsHideUnit(p5) then
call DestroyLightning(MZ9)
call Y67(Il,IL,75)
call DestroyEffect(OG7(OB7,"FX"))
call RemoveUnit(oA)
call RemoveUnit(I6D)
call SetUnitVertexColor(p5,$FF,$FF,$FF,$FF)
call SetUnitPathing(p5,true)
call SetUnitInvulnerable(p5,false)
call NM7(OB7)
call OZ7(t)
else
call Y67(Il,IL,75)
endif
set t=null
set oA=null
set p5=null
set MZ9=null
set g=null
set I6D=null
return false
endfunction
function I2D takes nothing returns nothing
local unit p5=GetTriggerUnit()
local real iN=0.
local real io=0.
local unit oA
local unit I6D
local location l
local real x
local real y
local trigger t
local integer OB7
local lightning MZ9
local integer V77=0
local real T98=0.
local real I0D=0.
local integer id=0
local integer suijiDisplacementCount=B290_GetDisplacementMulticastCount(p5,'A14O')
if p5==null or GetUnitTypeId(p5)==0 then
set p5=null
return
endif
set iN=GetUnitX(p5)
set io=GetUnitY(p5)
set V77=B287_GetUnitAbilityLevel(p5,'A14O')
set T98=GetUnitState(p5,UNIT_STATE_MANA)
set I0D=30+.06*GetUnitState(p5,UNIT_STATE_MAX_MANA)
set id=GetUnitTypeId(p5)
call SetUnitState(p5,UNIT_STATE_MANA,RMaxBJ(T98-I0D,0))
if GetUnitState(p5,UNIT_STATE_MANA)>$A then
set t=CreateTrigger()
set OB7=GetHandleId(t)
set oA=CreateUnit(GetOwningPlayer(p5),'o010',iN,io,0)
if id=='Z00S' then
    call SetUnitScale(oA,XX7(p5),XX7(p5),XX7(p5))
    call MHUnit_SetModel(oA,"model\\Hero_STormSpirit_N6S_G_Missile.mdl",false)
elseif id=='Z10S' then
    call SetUnitScale(oA,XX7(p5),XX7(p5),XX7(p5))
    call MHUnit_SetModel(oA,"model\\Hero_STormSpirit_N4S_G_Missile.mdl",false)
elseif id=='Z20S' then
    call SetUnitScale(oA,XX7(p5),XX7(p5),XX7(p5))
    call MHUnit_SetModel(oA,"model\\Hero_STormSpirit_N8S_G_Missile.mdl",false)
endif
set I6D=CreateUnit(GetOwningPlayer(p5),'H07G',iN,io,0)
set MZ9=AddLightning("FORK",true,iN,io,iN,io)
if GetSpellTargetUnit()==null then
set l=GetSpellTargetLoc()
set x=GetLocationX(l)
set y=GetLocationY(l)
call RemoveLocation(l)
else
set x=GetUnitX(GetSpellTargetUnit())
set y=GetUnitY(GetSpellTargetUnit())
endif
set x=iN+(x-iN)*suijiDisplacementCount
set y=io+(y-io)*suijiDisplacementCount
call SetUnitVertexColor(p5,$FF,$FF,$FF,0)
call SetUnitVertexColor(I6D,$FF,$FF,$FF,0)
call SetUnitPathing(p5,false)
call SetUnitPathing(oA,false)
call SetUnitInvulnerable(p5,true)
call NT7(OB7,"Caster",oA)
call NT7(OB7,"Source",p5)
call NT7(OB7,"Fake",I6D)
call NW7(OB7,"Light",MZ9)
call NP7(OB7,"Level",V77)
call NQ7(OB7,"x",x)
call NQ7(OB7,"y",y)
call NQ7(OB7,"lx",iN)
call NQ7(OB7,"ly",io)
call NQ7(OB7,"Traveled",0)
call NP7(OB7,"Remaining",YH7(R2I(SquareRoot((x-iN)*(x-iN)+(y-io)*(y-io))/(25+25*V77)),1))
call NU7(OB7,"FX",AddSpecialEffectTarget("effects\\Lightning_Ball_Tail_FX.mdx",I6D,"origin"))
call TriggerRegisterTimerEvent(t,.04,true)
call TriggerAddCondition(t,Condition(function I3D))
call ShowUnit(p5,false)
call ShowUnit(p5,true)
call SelectUnitAddForPlayer(p5,GetOwningPlayer(p5))
endif
set p5=null
set oA=null
set I6D=null
set l=null
set t=null
set MZ9=null
endfunction
function I_D takes nothing returns boolean
if B287_GetSpellAbilityId()=='A14O' then
call I2D()
endif
return false
endfunction
function J4D takes nothing returns boolean
if B287_GetSpellAbilityId()=='A14O' then
if GetUnitState(GetTriggerUnit(),UNIT_STATE_MANA)<($F+.07*GetUnitState(GetTriggerUnit(),UNIT_STATE_MAX_MANA))then
call KR7(GetTriggerUnit())
call X37(GetOwningPlayer(GetTriggerUnit()),GetObjectName('n0G8'))
endif
endif
return false
endfunction
