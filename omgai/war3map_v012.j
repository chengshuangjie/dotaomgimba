function WYF takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit WX7=O77(I97,"Hero")
local integer WF8=(OM7(I97,"Count"))
local integer HaveA=(OM7(I97,"HaveA"))
local integer level=B287_GetUnitAbilityLevel(WX7,'A1WH')+GetUnitAbilityLevel(WX7,'X1WH')
local integer id=GetUnitTypeId(WX7)
local unit BSTX
set WF8=WF8+1
call NP7(I97,"Count",WF8)
if(WF8>1) or GetTriggerEventId()==EVENT_UNIT_DEATH then
call UnitRemoveAbility(WX7,'A0WO')
call UnitRemoveAbility(WX7,'A2SX')
call UnitRemoveAbility(WX7,'ZSVG')
call UnitRemoveAbility(WX7,'B009')
call UnitRemoveAbility(WX7,'B0DP')
call NM7(I97)
call OZ7(t)
else
if LoadBoolean(L7,I97,StringHash("ScriptedRandomGodStrength")) then
call XF7(WX7,'ZSVG')
call UnitMakeAbilityPermanent(WX7,true,'ZSVG')
endif
if id=='Z001' or id=='Z0CQ' then
call DestroyEffect(AddSpecialEffectTarget("model\\Hero_Sven_N7S_R_Caster_Point.mdl",WX7,"origin"))
set BSTX=CreateUnit(GetOwningPlayer(WX7),'h0GM',GetUnitX(WX7),GetUnitY(WX7),GetUnitFacing(WX7))
call KillUnit(BSTX)
set BSTX=null
else
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BattleCryCaster.mdx",WX7,"overhead"))
endif
if HaveA==1 then
call XF7(WX7,'A0WO')
call SetUnitAbilityLevel(WX7,'A0WO',level)
call UnitMakeAbilityPermanent(WX7,true,'A0WO')
call SetPlayerAbilityAvailable(GetOwningPlayer(WX7),'A0WO',false)
call XF7(WX7,'A2SX')
call SetUnitAbilityLevel(WX7,'A2SX',level)
call UnitMakeAbilityPermanent(WX7,true,'A2SX')
call SetPlayerAbilityAvailable(GetOwningPlayer(WX7),'A2SX',false)
else
call XF7(WX7,'A0WO')
call SetUnitAbilityLevel(WX7,'A0WO',level)
call UnitMakeAbilityPermanent(WX7,true,'A0WO')
call SetPlayerAbilityAvailable(GetOwningPlayer(WX7),'A0WO',false)
endif
endif
set t=null
set WX7=null
return false
endfunction
function WZF takes nothing returns nothing
local trigger t=CreateTrigger()
local integer I97=GetHandleId(t)
