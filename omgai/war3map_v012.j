function GlyphCoolDown_Actions takes nothing returns boolean
	local trigger t = GetTriggeringTrigger()
	local integer h = GetHandleId(t)
	local unit u = LoadUnitHandle(TABLE_HY, h, 1)
	local integer skill = LoadInteger(TABLE_HY, h, 2)
	local real cd
	set cd = YDWEGetUnitAbilityState(u, skill, 1)
	if IsPlayerAlly(GetOwningPlayer(u), GetLocalPlayer()) then
		if cd > 10 then
			call DzFrameSetText(GlyphFrame, I2S(R2I(cd)))
		elseif cd == 0 then
			call DzFrameSetText(GlyphFrame, " ")
		else
			call DzFrameSetText(GlyphFrame, R2SW(cd, 1, 1))
		endif
	endif
	if cd == 0 then
		call FlushChildHashtable(TABLE_HY, h)
		call OZ7(t)
	endif
	set t = null
	set u = null
	return false
endfunction
function GlyphCoolDown takes unit u returns nothing
	local trigger t = CreateTrigger()
	local integer skill
	if TV7(GetOwningPlayer(u)) then
		set skill='A141'
	else
		set skill='A1WI'
	endif
	call TriggerRegisterTimerEvent(t, 0.2, true)
	call TriggerRegisterTimerEvent(t, 0., false)
	call TriggerAddCondition(t, Condition(function GlyphCoolDown_Actions))
	call SaveUnitHandle(TABLE_HY, GetHandleId(t), 1, u)
	call SaveInteger(TABLE_HY, GetHandleId(t), 2, skill)
	set t = null
endfunction
function ZFF takes nothing returns nothing
local group g
local unit ZEF=GetTriggerUnit()
local player p=GetOwningPlayer(ZEF)
if(TV7(p)and Th==false)or(TV7(p)==false and Uh==false)then
set g=WS7()
set Sh=p
call GroupEnumUnitsInRange(g,0,0,$2EE0,Condition(function Z8F))
call ForGroup(g,function Z9F)
call WR7(g)
if TV7(p)then
set Th=true
call ZDF(ZEF,p)
set Th=false
call NQ7(R44,"AI|Glyph|Sent",Bz+300.)
else
set Uh=true
call ZDF(ZEF,p)
set Uh=false
call NQ7(R44,"AI|Glyph|Scrg",Bz+300.)
endif
call GlyphCoolDown(ZEF)
if(IsPlayerAlly(p, GetLocalPlayer()) or(V8 and WG7(GetLocalPlayer()))) and p != GetLocalPlayer() then
call DisplayTimedTextToPlayer(GetLocalPlayer(), 0, 0, 5, Q[GetPlayerId(p)]+ KZ4[GetPlayerId((p))]+ "|r 开启了防御符文")
endif
endif
set g=null
set ZEF=null
set p=null
endfunction
