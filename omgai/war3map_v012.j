local integer LED=0
local integer BC7=B287_GetUnitAbilityLevel(WX7,'A0BR')
if BC7==1 then
set LED=15
elseif BC7==2 then
set LED=22
elseif BC7==3 then
set LED=29
elseif BC7==4 then
set LED=36
endif
set LDD=IMaxBJ(IMinBJ(LDD,LED),0)
if GetUnitTypeId(WX7)=='Nfir' or GetUnitTypeId(WX7)=='Zfir' or GetUnitTypeId(WX7)=='Zgir' or GetUnitTypeId(WX7)=='Zhir' then
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,E9,10.,GetObjectName('n0KE')+" "+I2S(LDD)+"/"+I2S(LED))
endif
set WX7=null
return false
endfunction
