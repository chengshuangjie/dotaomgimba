set ZX7=null
set IH7=null
return
endif
call SaveReal(TABLE_XJ,suijiBedlamHandle,StringHash("SuijiBedlamBlockUntil"),TimerGetElapsed(W)+.60)
endif
set t=CreateTrigger()
set OB7=GetHandleId(t)
set x=GetUnitX(IH7)+200*Cos(bj_DEGTORAD*90*-1.0)
set y=GetUnitY(IH7)+200*Sin(bj_DEGTORAD*90*-1.0)
set u1=CreateUnit(GetOwningPlayer(ZX7),'h0HC',x,y,90*-1.0)
set u2=CreateUnit(GetOwningPlayer(ZX7),'h0HD',x,y,90*-1.0)
call SaveUnitHandle(TABLE_XJ,(OB7),(2),(ZX7))
call SaveUnitHandle(TABLE_XJ,(OB7),(3),(IH7))
call SaveUnitHandle(TABLE_XJ,(OB7),(17),(u1))
call SaveUnitHandle(TABLE_XJ,(OB7),(19),(u2))
call SaveInteger(TABLE_XJ,(OB7),(5),(level))
call TriggerRegisterTimerEvent(t,0.01,true)
call TriggerRegisterUnitEvent(t,IH7,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function Bedlam_Action))
set ZX7=null
set IH7=null
set u1=null
set u2=null
set t=null
endfunction
