if((K57(WX7))and(((IsUnitInRange(WX7,j5,750.))and(not WNE(WX7,j5,true)))or(not DDF(WX7)))and(KF7(GetUnitX(WX7),GetUnitY(WX7),GetUnitX(j5)+IW*Cos(kl),GetUnitY(j5)+IW*Sin(kl))<700.))then
