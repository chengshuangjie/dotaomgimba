function OXG takes nothing returns boolean
return (B287_GetLearnedSkill()=='A500' or B287_GetLearnedSkill()=='A501' or B287_GetLearnedSkill()=='A502' or B287_GetLearnedSkill()=='A503') and GetUnitAbilityLevel(GetTriggerUnit(),'A504')==0 and GetUnitAbilityLevel(GetTriggerUnit(),'A505')==0 and GetUnitAbilityLevel(GetTriggerUnit(),'A506')==0 and GetUnitAbilityLevel(GetTriggerUnit(),'A507')==0 and GetUnitAbilityLevel(GetTriggerUnit(),'A508')==0
endfunction
function OYG takes nothing returns boolean
return GetIssuedOrderId()==$D023F
endfunction
function OZG takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit OAG=O77(GetHandleId(t),"FormlessUnit")
local integer OBG
call IssueImmediateOrderById(OAG,$D0240)
if GetUnitAbilityLevel(OAG,'A504')>0 then
set OBG='A509'
elseif GetUnitAbilityLevel(OAG,'A505')>0 then
set OBG='A50A'
elseif GetUnitAbilityLevel(OAG,'A506')>0 then
set OBG='A50B'
elseif GetUnitAbilityLevel(OAG,'A507')>0 then
set OBG='A50C'
elseif GetUnitAbilityLevel(OAG,'A508')>0 then
set OBG=0
endif
call UnitRemoveAbility(OAG,'A509')
call UnitRemoveAbility(OAG,'A50A')
call UnitRemoveAbility(OAG,'A50B')
call UnitRemoveAbility(OAG,'A50C')
if OBG!=0 then
call UnitAddAbility(OAG,OBG)
call SetPlayerAbilityAvailable(GetOwningPlayer(OAG),OBG,false)
endif
call NM7(GetHandleId(t))
call DestroyTimer(t)
set t=null
set OAG=null
endfunction
function OCG takes nothing returns nothing
local unit OAG=GetTriggerUnit()
local timer t=CreateTimer()
call NT7(GetHandleId(t),"FormlessUnit",OAG)
call TimerStart(t,0,false,function OZG)
set OAG=null
set t=null
endfunction
function O3G takes nothing returns nothing
