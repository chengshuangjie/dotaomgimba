//call SetItemPawnable(GetManipulatedItem(),false)
//else
call SetItemPawnable(GetManipulatedItem(),true)
//endif
endfunction
function ARF takes nothing returns boolean
if GetItemType(GetManipulatedItem())==ITEM_TYPE_PERMANENT and APF(KZ7(GetManipulatedItem()))and KW7(GetTriggerUnit())then
call AQF()
endif
return false
endfunction
function ASF takes nothing returns boolean
local unit WI7=GetTriggerUnit()
local integer V77=1
local item it=GetManipulatedItem()
if MU7(WI7,ZU[FV],it)!=null or MU7(WI7,ZU[DS4],it)!=null or MU7(WI7,ZU[G6],it)!=null or MU7(WI7,ZU[H6],it)!=null or MU7(WI7,ZU[N6],it)!=null or MU7(WI7,ZU[F74],it)!=null or MU7(WI7,ZU[EC],it)!=null then
set V77=2
endif
if MU7(WI7,ZU[LB],it)!=null then
set V77=3
endif
if MU7(WI7,ZU[F6],it)!=null or MU7(WI7,ZU[FF6],it)!=null then
set V77=4
endif
if MU7(WI7,ZU[Q1],it)!=null or MU7(WI7,ZU[it_fzz],it)!=null then
call UnitAddAbility(WI7,'A4LA')
call SetUnitAbilityLevel(WI7,'A4LA',V77)
call UnitMakeAbilityPermanent(WI7,true,'A4LA')
else
call UnitRemoveAbility(WI7,'A4LA')
endif
set WI7=null
set it=null
return false
endfunction
//捡起丢弃物品属性相关
function AUF takes nothing returns nothing
local unit WI7=GetTriggerUnit()
if GetTriggerEventId()==EVENT_PLAYER_UNIT_DROP_ITEM or GetTriggerEventId()==EVENT_PLAYER_UNIT_PAWN_ITEM then
if KZ7(GetManipulatedItem())==DM4 then
call UnitRemoveAbility(WI7,'A0PU')
endif
// if KZ7(GetManipulatedItem())==it_sadan then
// call UnitRemoveAbility(WI7,1093747287)
// endif
// if KZ7(GetManipulatedItem())==it_sadan then
