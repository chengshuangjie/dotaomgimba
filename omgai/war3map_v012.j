call XF7(p5,'A1KS')
elseif NOE==3 then
call XF7(p5,'A1KQ')
elseif NOE==4 then
call XF7(p5,'A1KP')
endif
elseif V77==2 then
if NOE==1 then
call XF7(p5,'A1K1')
elseif NOE==2 then
call XF7(p5,'A1KW')
elseif NOE==3 then
call XF7(p5,'A1KX')
elseif NOE==4 then
call XF7(p5,'A1KY')
endif
elseif V77==3 then
if NOE==1 then
call XF7(p5,'A1L4')
elseif NOE==2 then
call XF7(p5,'A1L3')
elseif NOE==3 then
call XF7(p5,'A1L2')
elseif NOE==4 then
call XF7(p5,'A1L1')
endif
elseif V77==4 then
if NOE==1 then
call XF7(p5,'A1L8')
elseif NOE==2 then
call XF7(p5,'A1L7')
elseif NOE==3 then
call XF7(p5,'A1L9')
elseif NOE==4 then
call XF7(p5,'A1LB')
endif
endif
endfunction
function NRE takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit p5=O77(OB7,"Source")
local integer NOE=OM7(OB7,"ShellCounter")
local integer V77=0
local real interval=ON7(OB7,"interval")
local real cooldown=ON7(OB7,"cooldown")
if p5==null or GetUnitTypeId(p5)==0 or B287_GetUnitAbilityLevel(p5,'A0VX')<=0 then
    if p5!=null then
        call NP7(GetHandleId(p5),"ShellCache",0)
    endif
    call NM7(OB7)
    call OZ7(t)
    set t=null
    set p5=null
    return false
endif
set V77=B287_GetUnitAbilityLevel(p5,'A0VX')
if GetTriggerEventId()==EVENT_UNIT_DAMAGED then
    if GetEventDamage()>2 and GetEventDamageSource()!=p5 and TX7(GetOwningPlayer(GetEventDamageSource())) and NOE>0 then
        set NOE=YH7(NOE-1,0)
        call NP7(OB7,"ShellCounter",NOE)
        call NNE(p5,V77,NOE)
    endif
elseif NOE<4 then
    set cooldown=cooldown-.5
    call NQ7(OB7,"cooldown",cooldown)
    if cooldown<=0 then
        set NOE=YG7(NOE+1,4)
        call NP7(OB7,"ShellCounter",NOE)
        call NNE(p5,V77,NOE)
        if GetUnitAbilityLevel(p5,'A2VW')>0 then
            set interval=3
        else
            set interval=4
        endif
        call NQ7(OB7,"cooldown",interval)
    endif
endif
set t=null
set p5=null
return false
endfunction
function VisageGravekeeperCloak_InitUnit takes unit suijiVisageCloakUnit,integer suijiVisageCloakLevel returns nothing
local trigger suijiVisageCloakTrigger=null
local integer suijiVisageCloakTriggerHandle=0
local integer suijiVisageCloakUnitHandle=0
local integer suijiVisageCloakCache=0
if suijiVisageCloakUnit==null or IsUnitIllusion(suijiVisageCloakUnit) then
return
endif
if suijiVisageCloakLevel<=0 then
set suijiVisageCloakLevel=B287_GetUnitAbilityLevel(suijiVisageCloakUnit,'A0VX')
endif
if suijiVisageCloakLevel<=0 then
return
endif
set suijiVisageCloakUnitHandle=GetHandleId(suijiVisageCloakUnit)
set suijiVisageCloakCache=OM7(suijiVisageCloakUnitHandle,"ShellCache")
if suijiVisageCloakCache==0 then
set suijiVisageCloakTrigger=CreateTrigger()
set suijiVisageCloakTriggerHandle=GetHandleId(suijiVisageCloakTrigger)
call TriggerRegisterUnitEvent(suijiVisageCloakTrigger,suijiVisageCloakUnit,EVENT_UNIT_DAMAGED)
call TriggerRegisterTimerEvent(suijiVisageCloakTrigger,.5,true)
call TriggerAddCondition(suijiVisageCloakTrigger,Condition(function NRE))
call NT7(suijiVisageCloakTriggerHandle,"Source",suijiVisageCloakUnit)
call NP7(suijiVisageCloakTriggerHandle,"ShellCounter",4)
call NQ7(suijiVisageCloakTriggerHandle,"cooldown",4)
call NQ7(suijiVisageCloakTriggerHandle,"interval",4)
call NP7(suijiVisageCloakUnitHandle,"ShellCache",suijiVisageCloakTriggerHandle)
set suijiVisageCloakCache=suijiVisageCloakTriggerHandle
endif
call NNE(suijiVisageCloakUnit,suijiVisageCloakLevel,4)
call NP7(suijiVisageCloakCache,"ShellCounter",4)
set suijiVisageCloakTrigger=null
endfunction
