if (not mu_select_bool[pid])  and  IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) then
    return false
endif
if (not b) then
    return false
endif
if ((mu_select_hero[pid] == null)) then
    set mu_select_hero[pid] = CreateUnit( GetTriggerPlayer(), GetUnitTypeId(GetTriggerUnit()), O_4, P44, 0 )
    call UnitAddAbility( mu_select_hero[pid], 'Aloc' )
else
    call RemoveUnit(mu_select_hero[pid])
    set mu_select_hero[pid] = CreateUnit( GetTriggerPlayer(), GetUnitTypeId(GetTriggerUnit()), O_4, P44, 0 )
    call UnitAddAbility( mu_select_hero[pid], 'Aloc' )
endif
if ((IsPlayerEnemy(GetTriggerPlayer(), GetLocalPlayer()) == true)) then
    call ShowUnit(  mu_select_hero[pid], false )
else
    call ShowUnit(  mu_select_hero[pid], true  )
endif
set d=RMaxBJ(Get_Unit_Scale(mu_select_hero[pid])*0.7,0.5)
call SetUnitScale( mu_select_hero[pid], d, d, d )
call Set_Unit_Alpha(mu_select_hero[pid],150)
set i = 1
loop
exitwhen i > 5
if(GetPlayerId(Z7[i]) == pid)  then
    set a = i + 2
    set b2 = false
endif
if(GetPlayerId(A7[i]) == pid)  then
    set a = i + 2
    set b2 = true
endif
set i = i + 1
endloop
//若是天灾的玩家
if b2 then
    set d = 90
    call SetUnitPosition(mu_select_hero[pid],UJ0[a],UK0[a])
else
    set d =  270
    call SetUnitPosition(mu_select_hero[pid],UX0[a],UY0[a])
endif
    
    
    
call SetUnitFacing(mu_select_hero[pid], d)
call MHUnit_DisableMove(mu_select_hero[pid],true)
call MUShareVision(mu_select_hero[pid])
call SetUnitColor(mu_select_hero[pid], GetPlayerColor(GetTriggerPlayer()))
return false
endfunction
