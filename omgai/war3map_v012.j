function XLE takes nothing returns nothing
local string VH=GetEventPlayerChatString()
local player pl
if StringCase(VH,false)=="-re" or StringCase(VH,false)=="-airepick" then
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,10.,"请输入AI楼层，例如 |c00dd8dff-re2|r（1-5楼为近卫，6-10楼为天灾）")
set pl=null
return
endif
if StringCase(SubString(VH,0,3),false)=="-re" then
set pl=K27(S2I(SubString(VH,3,StringLength(VH))))
else
set pl=K27(S2I(SubString(VH,9,StringLength(VH))))
endif
if((pl!=null)and(TA7(pl))and(IsPlayerInForce(pl,QX4)))then
if((IsPlayerAlly(GetTriggerPlayer(),pl))or(NJ7(not IsPlayerAlly(GetTriggerPlayer(),Z7[0]))==null))then
if(M7[GetPlayerId(pl)]==null)then
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,10.,"不能重选")
elseif(SuijiSuperAI_HasPreset(GetPlayerId(pl)))then
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,10.,"本楼层出现超级AI，禁止重选")
elseif(Bz>AI_RE_TIME)then
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,10.,"太迟了不能重选")
else
call X3E(pl,false)
endif
else
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,10.,"不能让有人类队友的敌人重选")
endif
endif
set pl=null
endfunction
