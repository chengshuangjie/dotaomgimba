// call XF7(IH7,'A04R')
call XF7(IH7,'A4DE')
call XF7(IH7,'A4DF')
call MHUnit_Silence(IH7,true)
call SetUnitPathingEx(IH7,false)
// call SetUnitScale(IH7,0,0,0)
