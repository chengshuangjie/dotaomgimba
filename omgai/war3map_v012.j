endfunction
function Get_MNCF_Unit takes unit IH7 returns unit
    if HaveSavedHandle(TABLE_HY,'CFMJ', GetHandleId(IH7)) and UnitAlive(LoadUnitHandle(TABLE_HY,'CFMJ', GetHandleId(IH7))) then
        return LoadUnitHandle(TABLE_HY,'CFMJ', GetHandleId(IH7))
    endif
        return IH7
endfunction
function RegisterUnitAttackEvent takes string s, integer level returns nothing
	local integer i = 0
	loop
	exitwhen HaveSavedString(TABLE_Q,'DMGE'+ level, i)== false
		if LoadStr(TABLE_Q,'DMGE'+ level, i)== s then
			return
		endif
		set i = i + 1
	endloop
	call SaveStr(TABLE_Q,'DMGE'+ level, i, s)
endfunction
function SuijiMode_RegisterIllusionPassiveAttackInheritance takes unit u,integer skill returns nothing
local integer physicalSkill=0
if u==null or GetUnitTypeId(u)==0 or skill==0 then
return
endif
set physicalSkill=B287_GetPhysicalAbilityId(u,skill)
if B287_MHAbility_IsPassive(u,physicalSkill) or SuijiMode_IsIllusionPassiveBridgeSkill(skill) then
call RegisterUnitAttackEvent("SuijiMode_IllusionPassiveAttackFallback",0)
endif
endfunction

function ExecuteAttackEvent takes integer i returns nothing
	local integer k = 0
	loop
	exitwhen HaveSavedString(TABLE_Q,'DMGE'+ i, k)== false
		call ExecuteFunc(LoadStr(TABLE_Q,'DMGE'+ i, k))
		set k = k + 1
	endloop
endfunction
