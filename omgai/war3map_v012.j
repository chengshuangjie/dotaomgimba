call PauseTimer(t)
call FlushChildHashtable(L7,(OB7))
call DestroyTimer(t)
set t=null
set ya=null
set WI7=null
set T_D=null
set U4D=null
set LQ7=null
return
endif
if GetUnitTypeId(WI7)==0 or GetUnitTypeId(ya)==0 or UnitAlive(WI7)==false or UnitAlive(ya)==false then
set O5=GetPlayerId(GetOwningPlayer(WI7))
set GZ[384+O5]=false
set h4[16+O5]=null
if D9==false then
call ForGroup(T_D,function TLD)
endif
call WR7(T_D)
call RemoveUnit(ya)
call PauseTimer(t)
call FlushChildHashtable(L7,(OB7))
call DestroyTimer(t)
set t=null
set ya=null
set WI7=null
set T_D=null
set U4D=null
set LQ7=null
return
endif
set Y5=GetUnitX(ya)
set Z5=GetUnitY(ya)
set U4D=Condition(function TCD)
set LQ7=WS7()
set O5=GetPlayerId(GetOwningPlayer(WI7))
if suijiChronosphereScepter then
set BZ7=40+V77*10
endif
call ForGroup(T_D,function TLD)
set D8=WI7
call GroupEnumUnitsInRange(LQ7,Y5,Z5,475,U4D)
call GroupClear(T_D)
call GroupAddGroup(LQ7,T_D)
call ForGroup(LQ7,function T3D)
if(GetPlayerController(GetOwningPlayer(WI7))==MAP_CONTROL_COMPUTER)then
if(h4[16+O5]==null)then
set hS=null
set hx=WI7
call ForGroup(LQ7,function T5D)
set h4[16+O5]=hS
endif
if(h4[16+O5]!=null)then
if IsUnitAliveBJ(h4[16+O5]) and GetUnitAbilityLevel(h4[16+O5],'B02F')==0 then
if((not IsUnitInRange(WI7,h4[16+O5],300.))and(IsUnitType(h4[16+O5],UNIT_TYPE_HERO)))then
if(not IssueTargetOrderById(WI7,$D00FA,h4[16+O5]))then
call IssueTargetOrderById(WI7,$D000F,h4[16+O5])
endif
elseif(not MC7(WI7,ZU[P1]))then
call IssueTargetOrderById(WI7,$D000F,h4[16+O5])
endif
else
set h4[16+O5]=null
endif
endif
endif
call WR7(LQ7)
set T8=T8+1
call SaveInteger(L7,(OB7),(28),(T8))
if T8>BZ7 then
set GZ[384+O5]=false
set h4[16+O5]=null
if D9==false then
call ForGroup(T_D,function TLD)
endif
call RemoveUnit(ya)
call WR7(T_D)
call PauseTimer(t)
call FlushChildHashtable(L7,(OB7))
