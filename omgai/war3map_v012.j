	set VH4[GetPlayerId(W78)]=VH4[GetPlayerId(W78)]+$96
	set EV0[GetPlayerId(W78)]=EV0[GetPlayerId(W78)]+$96
	if TZ7(W78) and TY7(WO8) then
		call Send_Chat_Text(W78,Get_Chat_Text(W78,"FB"))
	endif
endif
call VV7(L8,TEXTDUR[GetPlayerId(GetLocalPlayer())],XJ8)
call ZS7(EX)
call OZ7(t)
set t=null
set W78=null
set WO8=null
