function SuijiMode_SkillClass takes integer skill returns integer
if skill==0 then
return 0
endif
if SuijiMode_IsPhysicalSkill(skill) then
return 1
endif
return 2
endfunction
function SuijiMode_IsAIPhysicalHeroType takes integer unitId returns boolean
local integer i=1
loop
exitwhen i>K_4
if K24[i]==unitId then
return true
endif
set i=i+1
endloop
set i=1
loop
exitwhen i>M74
if M44[i]==unitId then
return true
endif
set i=i+1
endloop
return false
endfunction
function SuijiMode_IsAISpellHeroType takes integer unitId returns boolean
local integer i=1
loop
exitwhen i>M94
if M84[i]==unitId then
return true
endif
set i=i+1
endloop
return false
endfunction
function SuijiMode_AIHeroSkillBias takes unit u returns integer
local integer unitId=0
if u==null or GetUnitTypeId(u)==0 then
return 0
endif
set unitId=GetUnitTypeId(u)
if SuijiMode_IsAISpellHeroType(unitId) then
return 2
endif
if SuijiMode_IsAIPhysicalHeroType(unitId) then
return 1
endif
if GetHeroInt(u,false)>GetHeroStr(u,false) and GetHeroInt(u,false)>GetHeroAgi(u,false) then
return 2
endif
return 1
endfunction
function SuijiMode_AISkillWeight takes unit u,integer skill returns integer
local integer bias=SuijiMode_AIHeroSkillBias(u)
local integer kind=SuijiMode_SkillClass(skill)
if bias==0 or kind==0 then
return 1
endif
if bias==kind then
return 4
endif
return 1
endfunction
function SuijiMode_AddRandomSmall takes unit u returns integer
if u==null or GetUnitTypeId(u)==0 then
return 0
endif
return SuijiMode_AddRandomSmallMark(u,"SuijiSmall")
endfunction
function SuijiMode_HasChosenMulticast takes integer h returns boolean
if h==0 then
return false
endif
if OM7(h,"SuijiUltSkill")=='A088' then
return true
endif
if OM7(h,"SuijiMainUSkill")=='A088' then
return true
endif
if OM7(h,"SuijiUltPending1Skill")=='A088' then
return true
endif
if OM7(h,"SuijiUltPending2Skill")=='A088' then
return true
endif
return false
endfunction
function SuijiMode_HumanMulticastQuota takes nothing returns integer
local integer i=0
local integer h=0
local integer quota=0
local unit hero=null
local player p=null
loop
exitwhen i>$B
set p=Player(i)
if GetPlayerSlotState(p)==PLAYER_SLOT_STATE_PLAYING and GetPlayerController(p)==MAP_CONTROL_USER then
set hero=M7[i]
if hero!=null and GetUnitTypeId(hero)!=0 then
set h=GetHandleId(hero)
if SuijiMode_HasChosenMulticast(h) then
set quota=quota+1
endif
endif
endif
set i=i+1
endloop
set hero=null
set p=null
return quota
endfunction
function SuijiMode_AIMulticastQuotaUsed takes nothing returns integer
local integer i=0
local integer h=0
local integer idx=0
local integer used=0
local unit hero=null
local player p=null
loop
exitwhen i>$B
set p=Player(i)
if IsPlayerInForce(p,QX4) and GetPlayerController(p)==MAP_CONTROL_COMPUTER then
set hero=M7[i]
if hero!=null and GetUnitTypeId(hero)!=0 then
set h=GetHandleId(hero)
set idx=SuijiMode_GetStableHeroIndex(hero)
if SuijiMode_HasChosenMulticast(h) or OO7(h,"SuijiAIMulticastReserved") or (idx>=KL4 and idx<=K54 and HP4[idx]=='A088') then
set used=used+1
endif
endif
endif
set i=i+1
endloop
set hero=null
set p=null
return used
endfunction
function SuijiMode_ShouldForceAIMulticast takes unit u returns boolean
local integer h=0
local integer idx=0
if u==null or GetUnitTypeId(u)==0 or GetPlayerController(GetOwningPlayer(u))!=MAP_CONTROL_COMPUTER then
return false
endif
set h=GetHandleId(u)
set idx=SuijiMode_GetStableHeroIndex(u)
if SuijiMode_HasChosenMulticast(h) or (idx>=KL4 and idx<=K54 and HP4[idx]=='A088') then
return false
endif
if OO7(h,"SuijiAIMulticastReserved") then
return true
endif
if SuijiMode_AIMulticastQuotaUsed()<SuijiMode_HumanMulticastQuota() then
call NS7(h,"SuijiAIMulticastReserved",true)
return true
endif
return false
endfunction
function SuijiMode_AddRandomUltimate takes unit u,integer level returns integer
if u==null or GetUnitTypeId(u)==0 or level<=0 then
return 0
endif
return SuijiMode_AddRandomUltimateMark(u,level,"SuijiUlt")
endfunction
function SuijiMode_IsChoiceDuplicate takes integer h,string mark,integer skill returns boolean
local integer i=1
local integer count=OM7(h,mark+"ChoiceCount")
loop
exitwhen i>count
if OM7(h,mark+"Choice"+I2S(i)+"Skill")==skill then
return true
endif
set i=i+1
endloop
return false
endfunction
function SuijiMode_SaveChoice takes integer h,string mark,integer pos,integer skill,integer helper,string order,integer source returns nothing
local string key=mark+"Choice"+I2S(pos)
set order=SuijiMode_RandomOrder(skill,order)
call NP7(h,key+"Skill",skill)
call NP7(h,key+"Helper",helper)
call NP7(h,key+"Source",source)
call NR7(h,key+"Order",order)
set key=""
endfunction
function SuijiTavern_PendingConflict takes integer h,integer skill,integer helper,string order returns boolean
local integer pendingSkill=0
local integer pendingHelper=0
local integer slot=1
local string pendingOrder=""
set order=SuijiMode_RandomOrder(skill,order)
loop
exitwhen slot>2
set pendingSkill=OM7(h,"SuijiUltPending"+I2S(slot)+"Skill")
if pendingSkill!=0 then
set pendingHelper=OM7(h,"SuijiUltPending"+I2S(slot)+"Helper")
set pendingOrder=OP7(h,"SuijiUltPending"+I2S(slot)+"Order")
set pendingOrder=SuijiMode_RandomOrder(pendingSkill,pendingOrder)
if pendingSkill==skill or (helper!=0 and pendingHelper==helper) or (order!="" and pendingOrder==order) then
set pendingOrder=""
return true
endif
endif
set slot=slot+1
endloop
set pendingOrder=""
return false
endfunction
function SuijiMode_PrepareSmallChoices takes unit u returns integer
local integer h=0
local integer tries=0
local integer idx=0
local integer slot=0
local integer skill=0
local integer helper=0
local integer count=0
local string order=""
if u==null or GetUnitTypeId(u)==0 then
return 0
endif
set h=GetHandleId(u)
call NP7(h,"SuijiSmallChoiceCount",0)
loop
exitwhen tries>=720 or count>=12
set tries=tries+1
set idx=GetRandomInt(KL4,SUIJI_POOL_MAX)
set slot=GetRandomInt(1,3)
if slot==1 then
set skill=HM4[idx]
set helper=HR4[idx]
set order=HW4[idx]
elseif slot==2 then
set skill=HN4[idx]
set helper=HS4[idx]
set order=HX4[idx]
else
set skill=HO4[idx]
set helper=HT4[idx]
set order=HY4[idx]
endif
if SuijiMode_CanUseSkill(u,skill,helper,order) and SuijiTavern_PendingConflict(h,skill,helper,order)==false and SuijiMode_IsChoiceDuplicate(h,"SuijiSmall",skill)==false then
set count=count+1
call SuijiMode_SaveChoice(h,"SuijiSmall",count,skill,helper,order,SuijiMode_GetPoolSource(idx))
call NP7(h,"SuijiSmallChoiceCount",count)
endif
endloop
return count
endfunction
function SuijiMode_PrepareUltChoices takes unit u returns integer
local integer h=0
local integer tries=0
local integer idx=0
local integer skill=0
local integer helper=0
local integer count=0
local string order=""
local boolean titled=false
if u==null or GetUnitTypeId(u)==0 then
return 0
endif
set h=GetHandleId(u)
set titled=false
call NP7(h,"SuijiUltChoiceCount",0)
loop
exitwhen tries>=720 or count>=12
set tries=tries+1
set idx=GetRandomInt(KL4,SUIJI_POOL_MAX+1)
if idx==SUIJI_POOL_MAX+1 then
set idx=50
set skill='A1YQ'
set helper=0
set order="berserk"
else
set skill=HP4[idx]
set helper=HU4[idx]
set order=HZ4[idx]
endif
if SuijiMode_CanUseSkill(u,skill,helper,order) and SuijiMode_IsChoiceDuplicate(h,"SuijiUlt",skill)==false then
set count=count+1
call SuijiMode_SaveChoice(h,"SuijiUlt",count,skill,helper,order,SuijiMode_GetPoolSource(idx))
call NP7(h,"SuijiUltChoiceCount",count)
endif
endloop
return count
endfunction
function SuijiMode_ApplyChoice takes unit u,string mark,integer choice,integer level returns integer
local integer h=0
local string key=mark+"Choice"+I2S(choice)
local integer skill=0
local integer helper=0
local integer source=0
local string order=""
if u==null or GetUnitTypeId(u)==0 then
set key=""
return 0
endif
set h=GetHandleId(u)
set skill=OM7(h,key+"Skill")
set helper=OM7(h,key+"Helper")
set source=OM7(h,key+"Source")
set order=OP7(h,key+"Order")
if skill==0 or (helper==0 and SuijiMode_CanSkipHelper(skill)==false) then
set key=""
set order=""
return 0
endif
if level<1 then
set level=1
endif
set key=""
return SuijiMode_AddSkill(u,skill,helper,order,level,source,mark)
endfunction
function SuijiMode_EnsureChoiceDialog takes integer pid returns dialog
if SUIJI_CHOICE_TRIGGER==null then
return null
endif
if SUIJI_CHOICE_DIALOG[pid]==null then
set SUIJI_CHOICE_DIALOG[pid]=DialogCreate()
call TriggerRegisterDialogEvent(SUIJI_CHOICE_TRIGGER,SUIJI_CHOICE_DIALOG[pid])
endif
return SUIJI_CHOICE_DIALOG[pid]
endfunction
function SuijiMode_FirstIcon takes string icon returns string
local integer i=0
if icon==null or icon=="" then
return""
endif
loop
exitwhen i>=StringLength(icon)
if SubString(icon,i,i+1)=="," then
return SubString(icon,0,i)
endif
set i=i+1
endloop
return icon
endfunction
function SuijiMode_ChoiceIconText takes integer skill returns string
local string icon=null
if skill==0 then
return""
endif
set icon=SuijiMode_FirstIcon(MHAbility_GetDefDataStr(skill,ABILITY_DEF_DATA_ART))
if icon==null or icon=="" then
return""
endif
return""
endfunction
function SuijiMode_ChoicePreviewIcon takes integer suijiChoicePreviewSkill returns string
local string suijiChoicePreviewIconPath=null
if suijiChoicePreviewSkill==0 then
return"UI\\Widgets\\Console\\Undead\\undead-inventory-slotfiller.blp"
endif
set suijiChoicePreviewIconPath=SuijiT4_NormalizeAbilityIcon(SuijiMode_FirstIcon(MHAbility_GetDefDataStr(suijiChoicePreviewSkill,ABILITY_DEF_DATA_ART)))
if suijiChoicePreviewIconPath==null or suijiChoicePreviewIconPath=="" then
return"ReplaceableTextures\\CommandButtons\\BTNCancel.blp"
endif
return suijiChoicePreviewIconPath
endfunction
function SuijiMode_ChoicePreviewLevel takes unit suijiChoicePreviewUnit,integer suijiChoicePreviewType,integer suijiChoicePreviewSkill returns integer
local integer suijiChoicePreviewLevel=1
local integer suijiChoicePreviewMaxLevel=0
if suijiChoicePreviewSkill!=0 then
set suijiChoicePreviewMaxLevel=MHAbility_GetDefDataInt(suijiChoicePreviewSkill,ABILITY_DEF_DATA_MAX_LEVEL)
endif
if suijiChoicePreviewType==2 then
set suijiChoicePreviewLevel=SuijiMode_UltLevel(suijiChoicePreviewUnit)
else
set suijiChoicePreviewLevel=SuijiMode_SmallLevel(suijiChoicePreviewUnit)
endif
if suijiChoicePreviewLevel<1 then
set suijiChoicePreviewLevel=1
endif
if suijiChoicePreviewMaxLevel>0 and suijiChoicePreviewLevel>suijiChoicePreviewMaxLevel then
set suijiChoicePreviewLevel=suijiChoicePreviewMaxLevel
endif
return suijiChoicePreviewLevel
endfunction
function SuijiMode_ChoiceButtonSummary takes integer suijiChoiceButtonSkill,integer suijiChoiceButtonLevel returns string
local string suijiChoiceButtonText=MHAbility_GetLevelDefDataStr(suijiChoiceButtonSkill,suijiChoiceButtonLevel,ABILITY_LEVEL_DEF_DATA_UBERTIP)
if suijiChoiceButtonText==null or suijiChoiceButtonText=="" then
set suijiChoiceButtonText=MHAbility_GetLevelDefDataStr(suijiChoiceButtonSkill,suijiChoiceButtonLevel,ABILITY_LEVEL_DEF_DATA_TIP)
endif
if suijiChoiceButtonText==null then
return""
endif
set suijiChoiceButtonText=MHString_Replace(suijiChoiceButtonText,"|n"," ")
set suijiChoiceButtonText=MHString_Replace(suijiChoiceButtonText,"|r","")
set suijiChoiceButtonText=MHString_Replace(suijiChoiceButtonText,"|R","")
set suijiChoiceButtonText=MHString_Replace(suijiChoiceButtonText,"|cff99ccff","")
set suijiChoiceButtonText=MHString_Replace(suijiChoiceButtonText,"|cffffcc00","")
set suijiChoiceButtonText=MHString_Replace(suijiChoiceButtonText,"|cffff0303","")
set suijiChoiceButtonText=MHString_Replace(suijiChoiceButtonText,"|c00fffc01","")
set suijiChoiceButtonText=MHString_Replace(suijiChoiceButtonText,"|c00ffff00","")
set suijiChoiceButtonText=MHString_Replace(suijiChoiceButtonText,"|cffffff00","")
if StringLength(suijiChoiceButtonText)>44 then
return SubString(suijiChoiceButtonText,0,44)+"..."
endif
return suijiChoiceButtonText
endfunction
function SuijiMode_ChoiceButtonText takes unit suijiChoiceButtonUnit,integer suijiChoiceButtonType,integer suijiChoiceButtonNumber,integer suijiChoiceButtonSkill returns string
local integer suijiChoiceButtonLevel=SuijiMode_ChoicePreviewLevel(suijiChoiceButtonUnit,suijiChoiceButtonType,suijiChoiceButtonSkill)
local string suijiChoiceButtonInfo=SuijiMode_ChoiceButtonSummary(suijiChoiceButtonSkill,suijiChoiceButtonLevel)
if suijiChoiceButtonInfo==null or suijiChoiceButtonInfo=="" then
return I2S(suijiChoiceButtonNumber)+". "+GetAbilityName(suijiChoiceButtonSkill)
endif
return I2S(suijiChoiceButtonNumber)+". "+GetAbilityName(suijiChoiceButtonSkill)+" - "+suijiChoiceButtonInfo
endfunction
function SuijiMode_DialogIconIndex takes integer suijiDialogIconPid,integer suijiDialogIconSlot returns integer
return suijiDialogIconPid*4+suijiDialogIconSlot
endfunction
function SuijiMode_DialogIconsEnsure takes nothing returns nothing
local integer suijiDialogIconPid=0
local integer suijiDialogIconSlot=1
local integer suijiDialogIconIndex=0
local integer suijiDialogIconParent=GameUI
local real suijiDialogIconY=0.
if SUIJI_CHOICE_DIALOG_ICON_READY then
return
endif
if suijiDialogIconParent==0 then
set suijiDialogIconParent=DzGetGameUI()
endif
loop
exitwhen suijiDialogIconPid>15
set suijiDialogIconSlot=1
loop
exitwhen suijiDialogIconSlot>4
set suijiDialogIconIndex=SuijiMode_DialogIconIndex(suijiDialogIconPid,suijiDialogIconSlot)
set SUIJI_CHOICE_DIALOG_ICON[suijiDialogIconIndex]=DzCreateFrameByTagName("BACKDROP",null,suijiDialogIconParent,"template",suijiDialogIconIndex)
set suijiDialogIconY=0.414-I2R(suijiDialogIconSlot-1)*0.036
call DzFrameSetSize(SUIJI_CHOICE_DIALOG_ICON[suijiDialogIconIndex],0.023,0.023)
call DzFrameClearAllPoints(SUIJI_CHOICE_DIALOG_ICON[suijiDialogIconIndex])
call DzFrameSetAbsolutePoint(SUIJI_CHOICE_DIALOG_ICON[suijiDialogIconIndex],4,0.545,suijiDialogIconY)
call DzFrameSetPriority(SUIJI_CHOICE_DIALOG_ICON[suijiDialogIconIndex],98)
call DzFrameShow(SUIJI_CHOICE_DIALOG_ICON[suijiDialogIconIndex],false)
set suijiDialogIconSlot=suijiDialogIconSlot+1
endloop
set suijiDialogIconPid=suijiDialogIconPid+1
endloop
set SUIJI_CHOICE_DIALOG_ICON_READY=true
endfunction
function SuijiMode_ChoicePreviewHide takes player suijiChoicePreviewPlayer returns nothing
local integer suijiChoicePreviewPid=0
if suijiChoicePreviewPlayer!=null then
set suijiChoicePreviewPid=GetPlayerId(suijiChoicePreviewPlayer)
endif
if SUIJI_CHOICE_PREVIEW_BOARD[suijiChoicePreviewPid]!=null then
call MultiboardDisplay(SUIJI_CHOICE_PREVIEW_BOARD[suijiChoicePreviewPid],false)
endif
endfunction
function SuijiMode_DialogIconsHide takes player suijiDialogIconPlayer returns nothing
local integer suijiDialogIconPid=0
local integer suijiDialogIconSlot=1
local integer suijiDialogIconIndex=0
if suijiDialogIconPlayer==null then
return
endif
call SuijiMode_DialogIconsEnsure()
set suijiDialogIconPid=GetPlayerId(suijiDialogIconPlayer)
loop
exitwhen suijiDialogIconSlot>4
set suijiDialogIconIndex=SuijiMode_DialogIconIndex(suijiDialogIconPid,suijiDialogIconSlot)
if GetLocalPlayer()==suijiDialogIconPlayer then
call DzFrameShow(SUIJI_CHOICE_DIALOG_ICON[suijiDialogIconIndex],false)
endif
set suijiDialogIconSlot=suijiDialogIconSlot+1
endloop
endfunction
function SuijiMode_DialogIconsShow takes player suijiDialogIconPlayer,unit suijiDialogIconUnit,string suijiDialogIconMark,integer suijiDialogIconCount returns nothing
local integer suijiDialogIconPid=0
local integer suijiDialogIconSlot=1
local integer suijiDialogIconIndex=0
local integer suijiDialogIconHandle=0
local integer suijiDialogIconSkill=0
local real suijiDialogIconY=0.
if suijiDialogIconPlayer==null or suijiDialogIconUnit==null or GetUnitTypeId(suijiDialogIconUnit)==0 then
return
endif
call SuijiMode_DialogIconsEnsure()
call SuijiMode_DialogIconsHide(suijiDialogIconPlayer)
set suijiDialogIconPid=GetPlayerId(suijiDialogIconPlayer)
set suijiDialogIconHandle=GetHandleId(suijiDialogIconUnit)
loop
exitwhen suijiDialogIconSlot>4
set suijiDialogIconIndex=SuijiMode_DialogIconIndex(suijiDialogIconPid,suijiDialogIconSlot)
if suijiDialogIconSlot<=suijiDialogIconCount then
set suijiDialogIconSkill=OM7(suijiDialogIconHandle,suijiDialogIconMark+"Choice"+I2S(suijiDialogIconSlot)+"Skill")
set suijiDialogIconY=0.414-I2R(suijiDialogIconSlot-1)*0.036
if GetLocalPlayer()==suijiDialogIconPlayer then
call DzFrameSetTexture(SUIJI_CHOICE_DIALOG_ICON[suijiDialogIconIndex],SuijiMode_ChoicePreviewIcon(suijiDialogIconSkill),0)
call DzFrameSetSize(SUIJI_CHOICE_DIALOG_ICON[suijiDialogIconIndex],0.023,0.023)
call DzFrameClearAllPoints(SUIJI_CHOICE_DIALOG_ICON[suijiDialogIconIndex])
call DzFrameSetAbsolutePoint(SUIJI_CHOICE_DIALOG_ICON[suijiDialogIconIndex],4,0.545,suijiDialogIconY)
call DzFrameSetPriority(SUIJI_CHOICE_DIALOG_ICON[suijiDialogIconIndex],98)
call DzFrameShow(SUIJI_CHOICE_DIALOG_ICON[suijiDialogIconIndex],true)
endif
endif
set suijiDialogIconSlot=suijiDialogIconSlot+1
endloop
endfunction
function SuijiMode_ShowChoiceDialog takes unit u,string mark,integer count,string title,integer choiceType returns nothing
local player p=null
local integer pid=0
local integer h=0
local dialog d=null
local integer shuffleLeft=0
if u==null or GetUnitTypeId(u)==0 then
return
endif
set p=GetOwningPlayer(u)
set pid=GetPlayerId(p)
set h=GetHandleId(u)
set d=SuijiMode_EnsureChoiceDialog(pid)
set shuffleLeft=OM7(h,mark+"ShuffleLeft")
if d==null or count<=0 then
set p=null
set d=null
return
endif
call DialogClear(d)
call DialogSetMessage(d,title)
set SUIJI_CHOICE_BUTTON1[pid]=null
set SUIJI_CHOICE_BUTTON2[pid]=null
set SUIJI_CHOICE_BUTTON3[pid]=null
set SUIJI_CHOICE_BUTTON4[pid]=null
set SUIJI_CHOICE_SHUFFLE_BUTTON[pid]=null
if count>=1 then
set SUIJI_CHOICE_BUTTON1[pid]=DialogAddButton(d,SuijiMode_ChoiceButtonText(u,choiceType,1,OM7(h,mark+"Choice1Skill"))+SuijiMode_ChoiceIconText(OM7(h,mark+"Choice1Skill")),0)
endif
if count>=2 then
set SUIJI_CHOICE_BUTTON2[pid]=DialogAddButton(d,SuijiMode_ChoiceButtonText(u,choiceType,2,OM7(h,mark+"Choice2Skill"))+SuijiMode_ChoiceIconText(OM7(h,mark+"Choice2Skill")),0)
endif
if count>=3 then
set SUIJI_CHOICE_BUTTON3[pid]=DialogAddButton(d,SuijiMode_ChoiceButtonText(u,choiceType,3,OM7(h,mark+"Choice3Skill"))+SuijiMode_ChoiceIconText(OM7(h,mark+"Choice3Skill")),0)
endif
if count>=4 then
set SUIJI_CHOICE_BUTTON4[pid]=DialogAddButton(d,SuijiMode_ChoiceButtonText(u,choiceType,4,OM7(h,mark+"Choice4Skill"))+SuijiMode_ChoiceIconText(OM7(h,mark+"Choice4Skill")),0)
endif
if ISTEST then
set SUIJI_CHOICE_SHUFFLE_BUTTON[pid]=DialogAddButton(d,"洗牌(测试无限)",0)
elseif shuffleLeft>0 then
set SUIJI_CHOICE_SHUFFLE_BUTTON[pid]=DialogAddButton(d,"洗牌50金(剩余"+I2S(shuffleLeft)+"次)",0)
endif
call SaveUnitHandle(L7,StringHash("SuijiChoiceUnit"),pid,u)
call SaveInteger(L7,StringHash("SuijiChoiceType"),pid,choiceType)
call DialogDisplay(p,d,true)
call SuijiMode_ChoicePreviewHide(p)
call SuijiMode_DialogIconsShow(p,u,mark,count)
set p=null
set d=null
endfunction
function SuijiMode_ShowSmallChoices takes unit u returns integer
local integer h=0
local integer count=0
if u==null or GetUnitTypeId(u)==0 or GetPlayerController(GetOwningPlayer(u))!=MAP_CONTROL_USER then
return 0
endif
if SUIJI_CHOICE_TRIGGER==null then
return 0
endif
set h=GetHandleId(u)
if OO7(h,"SuijiSmallShuffleInit")==false then
call NS7(h,"SuijiSmallShuffleInit",true)
call NP7(h,"SuijiSmallShuffleLeft",3)
endif
if OM7(h,"SuijiSmallSkill")!=0 or OO7(h,"SuijiSmallChoosing") then
return 0
endif
set count=SuijiMode_PrepareSmallChoices(u)
if count>0 then
call NS7(h,"SuijiSmallChoosing",true)
call SuijiMode_ShowChoiceDialog(u,"SuijiSmall",count,"请选择额外小技能",1)
endif
return count
endfunction
function SuijiMode_ShowUltChoices takes unit u returns integer
local integer h=0
local integer count=0
if u==null or GetUnitTypeId(u)==0 or GetPlayerController(GetOwningPlayer(u))!=MAP_CONTROL_USER then
return 0
endif
if SUIJI_CHOICE_TRIGGER==null then
return 0
endif
set h=GetHandleId(u)
if OO7(h,"SuijiUltShuffleInit")==false then
call NS7(h,"SuijiUltShuffleInit",true)
call NP7(h,"SuijiUltShuffleLeft",3)
endif
if OM7(h,"SuijiUltSkill")!=0 or OO7(h,"SuijiUltChoosing") then
return 0
endif
set count=SuijiMode_PrepareUltChoices(u)
if count>0 then
call NS7(h,"SuijiUltChoosing",true)
call SuijiMode_ShowChoiceDialog(u,"SuijiUlt",count,"请选择额外大招",2)
endif
return count
endfunction
function SuijiMode_OnChoice takes nothing returns boolean
local button b=GetClickedButton()
local integer pid=0
local integer choice=0
local integer choiceType=0
local unit u=null
local player p=null
local integer h=0
local integer skill=0
local boolean keepChoice=false
local integer shuffleLeft=0
local integer count=0
loop
exitwhen pid>15 or choice!=0
if b==SUIJI_CHOICE_BUTTON1[pid] then
set choice=1
elseif b==SUIJI_CHOICE_BUTTON2[pid] then
set choice=2
elseif b==SUIJI_CHOICE_BUTTON3[pid] then
set choice=3
elseif b==SUIJI_CHOICE_BUTTON4[pid] then
set choice=4
elseif b==SUIJI_CHOICE_SHUFFLE_BUTTON[pid] then
set choice=-1
else
set pid=pid+1
endif
endloop
if choice==0 then
set b=null
return false
endif
set p=Player(pid)
set u=LoadUnitHandle(L7,StringHash("SuijiChoiceUnit"),pid)
set choiceType=LoadInteger(L7,StringHash("SuijiChoiceType"),pid)
call DialogDisplay(p,SUIJI_CHOICE_DIALOG[pid],false)
call SuijiMode_ChoicePreviewHide(p)
call SuijiMode_DialogIconsHide(p)
if u!=null and GetUnitTypeId(u)!=0 and SUIJI_MODE and OO7(GetHandleId(u),"SuijiDone") then
set h=GetHandleId(u)
if choice==-1 then
if choiceType==1 and OM7(h,"SuijiSmallSkill")==0 then
set shuffleLeft=OM7(h,"SuijiSmallShuffleLeft")
if shuffleLeft>0 or ISTEST then
if ISTEST==false and GetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD)<50 then
call DisplayTimedTextToPlayer(p,0,0,8.,"|cFFFFCC00随机OMG：洗牌需要50金币|r")
call SuijiMode_ShowChoiceDialog(u,"SuijiSmall",OM7(h,"SuijiSmallChoiceCount"),"请选择额外小技能",1)
set keepChoice=true
else
if ISTEST==false then
call SetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD)-50)
call NP7(h,"SuijiSmallShuffleLeft",shuffleLeft-1)
endif
set count=SuijiMode_PrepareSmallChoices(u)
if count>0 then
call SuijiMode_ShowChoiceDialog(u,"SuijiSmall",count,"请选择额外小技能",1)
set keepChoice=true
else
call NS7(h,"SuijiSmallChoosing",false)
endif
endif
endif
elseif choiceType==2 and OM7(h,"SuijiUltSkill")==0 and OM7(h,"SuijiUltSelectedChoice")==0 then
set shuffleLeft=OM7(h,"SuijiUltShuffleLeft")
if shuffleLeft>0 or ISTEST then
if ISTEST==false and GetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD)<50 then
call DisplayTimedTextToPlayer(p,0,0,8.,"|cFFFFCC00随机OMG：洗牌需要50金币|r")
call SuijiMode_ShowChoiceDialog(u,"SuijiUlt",OM7(h,"SuijiUltChoiceCount"),"请选择额外大招",2)
set keepChoice=true
else
if ISTEST==false then
call SetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD)-50)
call NP7(h,"SuijiUltShuffleLeft",shuffleLeft-1)
endif
set count=SuijiMode_PrepareUltChoices(u)
if count>0 then
call SuijiMode_ShowChoiceDialog(u,"SuijiUlt",count,"请选择额外大招",2)
set keepChoice=true
else
call NS7(h,"SuijiUltChoosing",false)
endif
endif
endif
endif
elseif choiceType==1 then
if OM7(h,"SuijiSmallSkill")==0 then
set skill=SuijiMode_ApplyChoice(u,"SuijiSmall",choice,SuijiMode_SmallLevel(u))
if skill!=0 then
call SuijiMode_NotifyPickedSkill(u,skill,"额外小技能","选择了")
endif
endif
call NS7(h,"SuijiSmallChoosing",false)
if skill!=0 and OM7(h,"SuijiUltSkill")==0 and OM7(h,"SuijiUltSelectedChoice")==0 then
if SuijiMode_ShowUltChoices(u)>0 then
set keepChoice=true
endif
endif
elseif choiceType==2 then
if OM7(h,"SuijiUltSkill")==0 then
if SuijiMode_UltLevel(u)>0 then
set skill=SuijiMode_ApplyChoice(u,"SuijiUlt",choice,SuijiMode_UltLevel(u))
if skill!=0 then
call SuijiMode_NotifyPickedSkill(u,skill,"额外大招","选择了")
endif
else
call NP7(h,"SuijiUltSelectedChoice",choice)
set skill=OM7(h,"SuijiUltChoice"+I2S(choice)+"Skill")
if skill!=0 then
call SuijiMode_NotifyPickedSkill(u,skill,"额外大招","预选了")
endif
endif
endif
call NS7(h,"SuijiUltChoosing",false)
endif
call SuijiMode_UpdateAghSkills(u)
endif
if keepChoice==false then
call RemoveSavedHandle(L7,StringHash("SuijiChoiceUnit"),pid)
call SaveInteger(L7,StringHash("SuijiChoiceType"),pid,0)
endif
set b=null
set u=null
set p=null
return false
endfunction
function SuijiMode_ChoiceInit takes nothing returns nothing
if SUIJI_CHOICE_TRIGGER==null then
set SUIJI_CHOICE_TRIGGER=CreateTrigger()
call TriggerAddCondition(SUIJI_CHOICE_TRIGGER,Condition(function SuijiMode_OnChoice))
endif
endfunction
function SuijiTavern_ClearStock takes unit tavern returns nothing
local integer i=1
local integer h=0
local integer skill=0
if tavern==null or GetUnitTypeId(tavern)==0 then
return
endif
set h=GetHandleId(tavern)
loop
exitwhen i>12
set skill=LoadInteger(L7,h,i)
if skill!=0 then
call RemoveUnitFromStock(tavern,skill)
call SaveInteger(L7,h,i,0)
endif
set i=i+1
endloop
call NP7(h,"SuijiTavernCount",0)
endfunction
function SuijiTavern_Fill takes unit tavern,unit hero,integer kind returns integer
local integer i=1
local integer count=0
local integer skill=0
local integer th=0
local integer heroHandle=0
local string mark="SuijiSmall"
if tavern==null or hero==null or GetUnitTypeId(tavern)==0 or GetUnitTypeId(hero)==0 then
set mark=""
return 0
endif
call SuijiTavern_ClearStock(tavern)
set th=GetHandleId(tavern)
set heroHandle=GetHandleId(hero)
if kind==2 then
set mark="SuijiUlt"
set count=SuijiMode_PrepareUltChoices(hero)
else
set count=SuijiMode_PrepareSmallChoices(hero)
endif
loop
exitwhen i>count or i>12
set skill=OM7(heroHandle,mark+"Choice"+I2S(i)+"Skill")
if skill!=0 then
call SaveInteger(L7,th,i,skill)
call AddUnitToStock(tavern,skill,1,1)
endif
set i=i+1
endloop
call NP7(th,"SuijiTavernCount",count)
set mark=""
return count
endfunction
function SuijiTavern_HasStock takes unit tavern,integer skill returns boolean
local integer i=1
local integer h=0
if tavern==null or GetUnitTypeId(tavern)==0 or skill==0 then
return false
endif
set h=GetHandleId(tavern)
loop
exitwhen i>12
if LoadInteger(L7,h,i)==skill then
return true
endif
set i=i+1
endloop
return false
endfunction
function SuijiTavern_Remove takes integer pid,integer kind returns nothing
local unit tavern=null
if kind==2 then
set tavern=SUIJI_TAVERN_ULT[pid]
set SUIJI_TAVERN_ULT[pid]=null
else
set tavern=SUIJI_TAVERN_SMALL[pid]
set SUIJI_TAVERN_SMALL[pid]=null
endif
if tavern!=null and GetUnitTypeId(tavern)!=0 then
call SuijiTavern_ClearStock(tavern)
call FlushChildHashtable(L7,GetHandleId(tavern))
call RemoveUnit(tavern)
endif
set tavern=null
endfunction
function SuijiTavern_StopTimeout takes integer pid returns nothing
local timer t=SUIJI_TAVERN_TIMEOUT[pid]
set SUIJI_TAVERN_TIMEOUT[pid]=null
if t!=null then
call PauseTimer(t)
call FlushChildHashtable(L7,GetHandleId(t))
call DestroyTimer(t)
endif
set t=null
endfunction
function SuijiTavern_IsComplete takes unit hero returns boolean
local integer h=0
if hero==null or GetUnitTypeId(hero)==0 then
return false
endif
set h=GetHandleId(hero)
return OM7(h,"SuijiSmallPicked")>=4 and OM7(h,"SuijiUltPicked")>=2
endfunction
function SuijiTavern_FocusNext takes unit hero returns nothing
local player p=null
local integer pid=0
local unit next=null
if hero==null or GetUnitTypeId(hero)==0 then
return
endif
set p=GetOwningPlayer(hero)
set pid=GetPlayerId(p)
if OM7(GetHandleId(hero),"SuijiSmallSkill")==0 then
set next=SUIJI_TAVERN_SMALL[pid]
elseif OM7(GetHandleId(hero),"SuijiUltSkill")==0 and OM7(GetHandleId(hero),"SuijiTavernUltPendingSkill")==0 then
set next=SUIJI_TAVERN_ULT[pid]
endif
call ClearSelectionForPlayer(p)
if next!=null and GetUnitTypeId(next)!=0 then
call SelectUnitAddForPlayer(next,p)
call PanCameraToTimedForPlayer(p,GetUnitX(next),GetUnitY(next),.30)
else
call SuijiTavern_StopTimeout(pid)
call SelectUnitAddForPlayer(hero,p)
call PanCameraToTimedForPlayer(p,GetUnitX(hero),GetUnitY(hero),.30)
call DisplayTimedTextToPlayer(p,0,0,10.,"|cFF00FF00随机OMG：英雄、小技能和大招均已选择完成|r")
endif
set next=null
set p=null
endfunction
function SuijiTavern_FindChoice takes unit hero,string mark,integer skill returns integer
local integer i=1
local integer h=0
local integer count=0
if hero==null or GetUnitTypeId(hero)==0 then
return 0
endif
set h=GetHandleId(hero)
set count=OM7(h,mark+"ChoiceCount")
loop
exitwhen i>count or i>8
if OM7(h,mark+"Choice"+I2S(i)+"Skill")==skill then
return i
endif
set i=i+1
endloop
return 0
endfunction
function SuijiTavern_Choose takes unit hero,integer kind,integer skill returns integer
local player p=null
local integer pid=0
local integer h=0
local integer choice=0
local integer helper=0
local integer source=0
local integer result=0
local string mark="SuijiSmall"
local string order=""
local unit tavern=null
if hero==null or GetUnitTypeId(hero)==0 or skill==0 then
set mark=""
return 0
endif
set p=GetOwningPlayer(hero)
set pid=GetPlayerId(p)
set h=GetHandleId(hero)
if kind==2 then
set mark="SuijiUlt"
set tavern=SUIJI_TAVERN_ULT[pid]
else
set tavern=SUIJI_TAVERN_SMALL[pid]
endif
if SuijiTavern_HasStock(tavern,skill)==false then
set mark=""
set tavern=null
set p=null
return 0
endif
set choice=SuijiTavern_FindChoice(hero,mark,skill)
if choice<=0 then
call DisplayTimedTextToPlayer(p,0,0,8.,"|cFFFFCC00随机OMG：本次选择无效，当前酒馆候选保持不变|r")
set mark=""
set tavern=null
set p=null
return 0
endif
set helper=OM7(h,mark+"Choice"+I2S(choice)+"Helper")
set source=OM7(h,mark+"Choice"+I2S(choice)+"Source")
set order=OP7(h,mark+"Choice"+I2S(choice)+"Order")
if SuijiMode_CanUseSkill(hero,skill,helper,order)==false or (kind==1 and SuijiTavern_PendingConflict(h,skill,helper,order)) then
call DisplayTimedTextToPlayer(p,0,0,8.,"|cFFFFCC00随机OMG：该技能与当前英雄或另一项选择冲突，本次选择无效，酒馆不刷新|r")
set mark=""
set order=""
set tavern=null
set p=null
return 0
endif
if kind==2 and SuijiMode_UltLevel(hero)<=0 then
call NP7(h,"SuijiTavernUltPendingSkill",skill)
call NP7(h,"SuijiTavernUltPendingHelper",helper)
call NP7(h,"SuijiTavernUltPendingSource",source)
call NR7(h,"SuijiTavernUltPendingOrder",order)
set result=skill
call SuijiMode_NotifyPickedSkill(hero,skill,"额外大招","预选了")
else
if kind==2 then
set result=SuijiMode_AddSkill(hero,skill,helper,order,SuijiMode_UltLevel(hero),source,"SuijiUlt")
else
set result=SuijiMode_AddSkill(hero,skill,helper,order,SuijiMode_SmallLevel(hero),source,"SuijiSmall")
endif
if result!=0 then
if kind==2 then
call SuijiMode_NotifyPickedSkill(hero,result,"额外大招","选择了")
else
call SuijiMode_NotifyPickedSkill(hero,result,"额外小技能","选择了")
endif
endif
endif
if result!=0 then
call SuijiTavern_Remove(pid,kind)
call SuijiTavern_FocusNext(hero)
endif
set mark=""
set order=""
set tavern=null
set p=null
return result
endfunction
function SuijiTavern_ApplyPendingUlt takes unit hero returns integer
local integer h=0
local integer skill=0
local integer helper=0
local integer source=0
local integer result=0
local integer slot=1
local string order=""
local string mark=""
if hero==null or GetUnitTypeId(hero)==0 or SuijiMode_UltLevel(hero)<=0 then
return 0
endif
set h=GetHandleId(hero)
loop
exitwhen slot>2
set skill=OM7(h,"SuijiUltPending"+I2S(slot)+"Skill")
if skill!=0 then
set helper=OM7(h,"SuijiUltPending"+I2S(slot)+"Helper")
set source=OM7(h,"SuijiUltPending"+I2S(slot)+"Source")
set order=OP7(h,"SuijiUltPending"+I2S(slot)+"Order")
if slot==1 then
set mark="SuijiMainU"
else
set mark="SuijiUlt"
endif
set result=SuijiMode_AddSkill(hero,skill,helper,order,SuijiMode_UltLevel(hero),source,mark)
if result!=0 then
call NP7(h,"SuijiUltPending"+I2S(slot)+"Skill",0)
call NP7(h,"SuijiUltPending"+I2S(slot)+"Helper",0)
call NP7(h,"SuijiUltPending"+I2S(slot)+"Source",0)
call NR7(h,"SuijiUltPending"+I2S(slot)+"Order","")
call SuijiMode_NotifyPickedSkill(hero,result,"第"+I2S(slot)+"个大招","5级获得了")
endif
endif
set slot=slot+1
endloop
set order=""
return result
endfunction
function SuijiTavern_Timeout takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer th=GetHandleId(t)
local unit hero=LoadUnitHandle(L7,th,0)
local integer pid=LoadInteger(L7,th,1)
local integer skill=0
set SUIJI_TAVERN_TIMEOUT[pid]=null
if hero!=null and GetUnitTypeId(hero)!=0 then
if OM7(GetHandleId(hero),"SuijiSmallSkill")==0 and SUIJI_TAVERN_SMALL[pid]!=null then
set skill=LoadInteger(L7,GetHandleId(SUIJI_TAVERN_SMALL[pid]),1)
call SuijiTavern_Choose(hero,1,skill)
endif
if OM7(GetHandleId(hero),"SuijiUltSkill")==0 and OM7(GetHandleId(hero),"SuijiTavernUltPendingSkill")==0 and SUIJI_TAVERN_ULT[pid]!=null then
set skill=LoadInteger(L7,GetHandleId(SUIJI_TAVERN_ULT[pid]),1)
call SuijiTavern_Choose(hero,2,skill)
endif
call DisplayTimedTextToPlayer(Player(pid),0,0,8.,"|cFFFFCC00随机OMG：选择时间结束，未选项目已自动采用第一个候选|r")
endif
call FlushChildHashtable(L7,th)
call DestroyTimer(t)
set hero=null
set t=null
endfunction
function SuijiTavern_Start takes unit hero returns nothing
local player p=null
local integer pid=0
local real x=0.
local real y=0.
local boolean created=false
local timer t=null
if hero==null or GetUnitTypeId(hero)==0 then
return
endif
set p=GetOwningPlayer(hero)
set pid=GetPlayerId(p)
if GetPlayerController(p)!=MAP_CONTROL_USER then
set p=null
return
endif
set x=GetUnitX(hero)
set y=GetUnitY(hero)
if KU4[pid]!=null and GetUnitTypeId(KU4[pid])!=0 then
set x=GetUnitX(KU4[pid])
set y=GetUnitY(KU4[pid])
endif
if OM7(GetHandleId(hero),"SuijiSmallSkill")==0 and (SUIJI_TAVERN_SMALL[pid]==null or GetUnitTypeId(SUIJI_TAVERN_SMALL[pid])==0) then
set SUIJI_TAVERN_SMALL[pid]=CreateUnit(p,'nT91',x-180.,y,270.)
call SetUnitPathing(SUIJI_TAVERN_SMALL[pid],false)
call NP7(GetHandleId(SUIJI_TAVERN_SMALL[pid]),"SuijiTavernRefreshLeft",3)
call SuijiTavern_Fill(SUIJI_TAVERN_SMALL[pid],hero,1)
set created=true
endif
if OM7(GetHandleId(hero),"SuijiUltSkill")==0 and OM7(GetHandleId(hero),"SuijiTavernUltPendingSkill")==0 and (SUIJI_TAVERN_ULT[pid]==null or GetUnitTypeId(SUIJI_TAVERN_ULT[pid])==0) then
set SUIJI_TAVERN_ULT[pid]=CreateUnit(p,'nT92',x+180.,y,270.)
call SetUnitPathing(SUIJI_TAVERN_ULT[pid],false)
call NP7(GetHandleId(SUIJI_TAVERN_ULT[pid]),"SuijiTavernRefreshLeft",3)
call SuijiTavern_Fill(SUIJI_TAVERN_ULT[pid],hero,2)
set created=true
endif
if created and SUIJI_TAVERN_TIMEOUT[pid]==null then
set t=CreateTimer()
set SUIJI_TAVERN_TIMEOUT[pid]=t
call SaveUnitHandle(L7,GetHandleId(t),0,hero)
call SaveInteger(L7,GetHandleId(t),1,pid)
call TimerStart(t,90.,false,function SuijiTavern_Timeout)
endif
if created then
call ClearSelectionForPlayer(p)
if SUIJI_TAVERN_SMALL[pid]!=null then
call SelectUnitAddForPlayer(SUIJI_TAVERN_SMALL[pid],p)
call PanCameraToTimedForPlayer(p,GetUnitX(SUIJI_TAVERN_SMALL[pid]),GetUnitY(SUIJI_TAVERN_SMALL[pid]),.30)
else
call SelectUnitAddForPlayer(SUIJI_TAVERN_ULT[pid],p)
call PanCameraToTimedForPlayer(p,GetUnitX(SUIJI_TAVERN_ULT[pid]),GetUnitY(SUIJI_TAVERN_ULT[pid]),.30)
endif
call DisplayTimedTextToPlayer(p,0,0,15.,"|cFF00FF00随机OMG：请在小技能酒馆和大招酒馆各选择1项；每馆可花25金币无限刷新|r")
endif
set t=null
set p=null
endfunction
function SuijiTavern_Refresh takes unit tavern,unit hero,integer kind returns nothing
local player p=null
local integer h=0
local integer left=0
if tavern==null or hero==null or GetUnitTypeId(tavern)==0 or GetUnitTypeId(hero)==0 then
return
endif
set p=GetOwningPlayer(hero)
set h=GetHandleId(tavern)
if GetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD)<25 then
call DisplayTimedTextToPlayer(p,0,0,6.,"|cFFFFCC00随机OMG：刷新需要25金币|r")
set p=null
return
endif
call SetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD)-25)
call SuijiTavern_Fill(tavern,hero,kind)
call ClearSelectionForPlayer(p)
call SelectUnitAddForPlayer(tavern,p)
call DisplayTimedTextToPlayer(p,0,0,6.,"|cFF00FF00随机OMG：已花费25金币刷新候选，可无限刷新|r")
set p=null
endfunction
function SuijiTavern_OnEvent takes nothing returns boolean
local unit sold=null
local unit tavern=null
local unit hero=null
local integer pid=0
local integer skill=0
local integer spell=0
if SUIJI_MODE==false then
return false
endif
if GetTriggerEventId()==EVENT_PLAYER_UNIT_SELL then
set sold=GetSoldUnit()
set tavern=GetSellingUnit()
if sold!=null then
set pid=GetPlayerId(GetOwningPlayer(sold))
set skill=GetUnitTypeId(sold)
if tavern==SUIJI_TAVERN_SMALL[pid] then
call RemoveUnit(sold)
set hero=M7[pid]
call SuijiTavern_Choose(hero,1,skill)
elseif tavern==SUIJI_TAVERN_ULT[pid] then
call RemoveUnit(sold)
set hero=M7[pid]
call SuijiTavern_Choose(hero,2,skill)
endif
endif
else
set tavern=GetTriggerUnit()
set pid=GetPlayerId(GetOwningPlayer(tavern))
set hero=M7[pid]
set spell=B287_GetSpellAbilityId()
if tavern==SUIJI_TAVERN_SMALL[pid] and spell=='A4T1' then
call SuijiTavern_Refresh(tavern,hero,1)
elseif tavern==SUIJI_TAVERN_ULT[pid] and spell=='A4T2' then
call SuijiTavern_Refresh(tavern,hero,2)
endif
endif
set sold=null
set tavern=null
set hero=null
return false
endfunction
function SuijiTavernB295_ClearStock takes unit tavern returns nothing
local integer i=1
local integer h=0
local integer proxy=0
if tavern==null or GetUnitTypeId(tavern)==0 then
return
endif
set h=GetHandleId(tavern)
loop
exitwhen i>9
set proxy=LoadInteger(L7,h,80+i)
if proxy!=0 then
call RemoveUnitFromStock(tavern,proxy)
endif
call SaveInteger(L7,h,i,0)
call SaveInteger(L7,h,20+i,0)
call SaveInteger(L7,h,40+i,0)
call SaveStr(L7,h,60+i,"")
call SaveInteger(L7,h,80+i,0)
set i=i+1
endloop
call NP7(h,"SuijiTavernCount",0)
endfunction
function SuijiTavernB302_ProxyId takes integer kind,integer source,integer slot,integer skill returns integer
local integer proxyNumber=0
if skill=='A1YQ' then
set proxyNumber=990
elseif kind==2 then
set proxyNumber=500+source
else
set proxyNumber=source*3+slot
endif
return 'v000'+(proxyNumber/100)*65536+((proxyNumber/10)-((proxyNumber/100)*10))*256+proxyNumber-((proxyNumber/10)*10)
endfunction
function SuijiTavernB295_Lock takes unit tavern,integer kind returns nothing
local integer h=0
if tavern==null or GetUnitTypeId(tavern)==0 then
return
endif
set h=GetHandleId(tavern)
call SuijiTavernB295_ClearStock(tavern)
call NP7(h,"SuijiTavernLocked",1)
call NP7(h,"SuijiTavernRefreshLeft",0)
if kind==2 then
call UnitRemoveAbility(tavern,'A4T2')
else
call UnitRemoveAbility(tavern,'A4T1')
endif
endfunction
function SuijiTavernB295_HasChosen takes unit hero,integer kind returns boolean
local integer h=0
if hero==null or GetUnitTypeId(hero)==0 then
return false
endif
set h=GetHandleId(hero)
if kind==2 then
return OM7(h,"SuijiUltPicked")>=2
endif
return OM7(h,"SuijiSmallPicked")>=4
endfunction
function SuijiTavernB295_SyncLock takes unit hero,unit tavern,integer kind returns boolean
if SuijiTavernB295_HasChosen(hero,kind) then
call SuijiTavernB295_Lock(tavern,kind)
return true
endif
return false
endfunction
function SuijiTavernB295_Fill takes unit tavern,integer kind returns integer
local integer tries=0
local integer idx=0
local integer slot=0
local integer count=0
local integer skill=0
local integer helper=0
local integer proxy=0
local integer th=0
local integer pid=0
local boolean titled=false
local string order=""
local unit hero=null
if tavern==null or GetUnitTypeId(tavern)==0 then
return 0
endif
if OM7(GetHandleId(tavern),"SuijiTavernLocked")!=0 then
return 0
endif
call SuijiTavernB295_ClearStock(tavern)
set th=GetHandleId(tavern)
set pid=GetPlayerId(GetOwningPlayer(tavern))
set hero=M7[pid]
set titled=false
loop
exitwhen tries>=1200 or count>=12
set tries=tries+1
if kind==2 then
set idx=GetRandomInt(KL4,SUIJI_POOL_MAX+1)
if idx==SUIJI_POOL_MAX+1 then
set idx=50
set skill='A1YQ'
set helper=0
set order="berserk"
else
set skill=HP4[idx]
set helper=HU4[idx]
set order=HZ4[idx]
endif
else
set idx=GetRandomInt(KL4,SUIJI_POOL_MAX)
set slot=GetRandomInt(1,3)
if slot==1 then
set skill=HM4[idx]
set helper=HR4[idx]
set order=HW4[idx]
elseif slot==2 then
set skill=HN4[idx]
set helper=HS4[idx]
set order=HX4[idx]
else
set skill=HO4[idx]
set helper=HT4[idx]
set order=HY4[idx]
endif
endif
set order=SuijiMode_RandomOrder(skill,order)
if skill!=0 and order!="" and (helper!=0 or SuijiMode_CanSkipHelper(skill)) and SuijiTavern_HasStock(tavern,skill)==false and (hero==null or GetUnitTypeId(hero)==0 or SuijiMode_CanUseSkill(hero,skill,helper,order)) and (kind!=1 or hero==null or GetUnitTypeId(hero)==0 or SuijiTavern_PendingConflict(GetHandleId(hero),skill,helper,order)==false) then
set proxy=SuijiTavernB302_ProxyId(kind,idx,slot,skill)
set count=count+1
call SaveInteger(L7,th,count,skill)
call SaveInteger(L7,th,20+count,helper)
call SaveInteger(L7,th,40+count,SuijiMode_GetPoolSource(idx))
call SaveStr(L7,th,60+count,order)
call SaveInteger(L7,th,80+count,proxy)
call AddUnitToStock(tavern,proxy,1,1)
endif
endloop
call NP7(th,"SuijiTavernCount",count)
if hero!=null and GetUnitTypeId(hero)!=0 then
call SaveInteger(L7,th,100,GetHandleId(hero))
call SaveInteger(L7,th,101,OM7(GetHandleId(hero),"SuijiSmallPicked"))
call SaveInteger(L7,th,102,OM7(GetHandleId(hero),"SuijiUltPicked"))
else
call SaveInteger(L7,th,100,0)
call SaveInteger(L7,th,101,0)
call SaveInteger(L7,th,102,0)
endif
set order=""
set hero=null
return count
endfunction
function SuijiTavernB295_FindChoice takes unit tavern,integer skill returns integer
local integer i=1
local integer h=0
local integer count=0
if tavern==null or GetUnitTypeId(tavern)==0 then
return 0
endif
set h=GetHandleId(tavern)
set count=OM7(h,"SuijiTavernCount")
loop
exitwhen i>count or i>12
if LoadInteger(L7,h,i)==skill then
return i
endif
set i=i+1
endloop
return 0
endfunction
function SuijiTavernB295_FindChoiceByProxy takes unit tavern,integer proxy returns integer
local integer i=1
local integer h=0
local integer count=0
if tavern==null or GetUnitTypeId(tavern)==0 or proxy==0 then
return 0
endif
set h=GetHandleId(tavern)
set count=OM7(h,"SuijiTavernCount")
loop
exitwhen i>count or i>12
if LoadInteger(L7,h,80+i)==proxy then
return i
endif
set i=i+1
endloop
return 0
endfunction
function SuijiTavernB295_DiscardChoice takes unit tavern,integer choice returns nothing
local integer h=0
local integer skill=0
local integer proxy=0
if tavern==null or GetUnitTypeId(tavern)==0 or choice<=0 or choice>12 then
return
endif
set h=GetHandleId(tavern)
set skill=LoadInteger(L7,h,choice)
set proxy=LoadInteger(L7,h,80+choice)
if proxy!=0 then
call RemoveUnitFromStock(tavern,proxy)
endif
call SaveInteger(L7,h,choice,0)
call SaveInteger(L7,h,20+choice,0)
call SaveInteger(L7,h,40+choice,0)
call SaveStr(L7,h,60+choice,"")
call SaveInteger(L7,h,80+choice,0)
endfunction
function SuijiTavernB295_RestoreChoice takes unit tavern,integer choice returns nothing
local integer proxy=0
if tavern==null or GetUnitTypeId(tavern)==0 or choice<=0 or choice>12 then
return
endif
set proxy=LoadInteger(L7,GetHandleId(tavern),80+choice)
if proxy!=0 then
call RemoveUnitFromStock(tavern,proxy)
call AddUnitToStock(tavern,proxy,1,1)
endif
endfunction
function SuijiTavernB295_IsStale takes unit tavern,unit hero,integer kind returns boolean
local integer th=0
if tavern==null or GetUnitTypeId(tavern)==0 or hero==null or GetUnitTypeId(hero)==0 then
return false
endif
set th=GetHandleId(tavern)
if kind==2 then
return LoadInteger(L7,th,102)!=OM7(GetHandleId(hero),"SuijiUltPicked")
endif
return LoadInteger(L7,th,101)!=OM7(GetHandleId(hero),"SuijiSmallPicked")
endfunction
function SuijiTavernB295_FirstChoice takes unit tavern returns integer
local integer h=0
local integer i=1
local integer skill=0
if tavern==null or GetUnitTypeId(tavern)==0 then
return 0
endif
set h=GetHandleId(tavern)
loop
exitwhen i>9
set skill=LoadInteger(L7,h,i)
if skill!=0 then
return skill
endif
set i=i+1
endloop
return 0
endfunction
function SuijiTavernB295_FocusNext takes unit hero returns nothing
local player p=null
local integer pid=0
local integer phase=0
local unit next=null
if hero==null or GetUnitTypeId(hero)==0 then
return
endif
set p=GetOwningPlayer(hero)
set pid=GetPlayerId(p)
set phase=OM7(GetHandleId(hero),"SuijiPhase")
if phase==1 then
set next=SUIJI_TAVERN_SMALL[pid]
elseif phase==2 then
set next=SUIJI_TAVERN_ULT[pid]
endif
call ClearSelectionForPlayer(p)
if next!=null and GetUnitTypeId(next)!=0 then
call SelectUnitAddForPlayer(next,p)
call PanCameraToTimedForPlayer(p,-6880.,6784.,.30)
else
call SuijiTavern_StopTimeout(pid)
call SelectUnitAddForPlayer(hero,p)
call PanCameraToTimedForPlayer(p,GetUnitX(hero),GetUnitY(hero),.30)
call DisplayTimedTextToPlayer(p,0,0,10.,"|cFF00FF00随机OMG：英雄、小技能和大招均已选择完成|r")
endif
set next=null
set p=null
endfunction
function SuijiTavernB295_Choose takes unit hero,integer kind,integer skill returns integer
local player p=null
local integer pid=0
local integer h=0
local integer choice=0
local integer helper=0
local integer source=0
local integer result=0
local integer picked=0
local string order=""
local string mark=""
local unit tavern=null
if hero==null or GetUnitTypeId(hero)==0 or skill==0 then
return 0
endif
set p=GetOwningPlayer(hero)
set pid=GetPlayerId(p)
set h=GetHandleId(hero)
if kind==2 then
set tavern=SUIJI_TAVERN_ULT[pid]
else
set tavern=SUIJI_TAVERN_SMALL[pid]
endif
if tavern==null or GetUnitTypeId(tavern)==0 then
set p=null
return 0
endif
if SuijiTavernB295_SyncLock(hero,tavern,kind) then
if kind==2 then
call DisplayTimedTextToPlayer(p,0,0,6.,"|cFFFFCC00随机OMG：你已经选择了额外大招|r")
else
call DisplayTimedTextToPlayer(p,0,0,6.,"|cFFFFCC00随机OMG：你已经选择了额外小技能|r")
endif
set tavern=null
set p=null
return 0
endif
if OM7(GetHandleId(tavern),"SuijiTavernLocked")!=0 then
if kind==2 and OM7(h,"SuijiPhase")==1 then
call DisplayTimedTextToPlayer(p,0,0,6.,"|cFFFFCC00随机OMG：请先选满4个小技能|r")
else
call DisplayTimedTextToPlayer(p,0,0,6.,"|cFFFFCC00随机OMG：当前技能酒馆已经完成选择|r")
endif
set tavern=null
set p=null
return 0
endif
set choice=SuijiTavernB295_FindChoice(tavern,skill)
if choice<=0 then
call DisplayTimedTextToPlayer(p,0,0,8.,"|cFFFFCC00随机OMG：本次选择无效，当前酒馆候选保持不变|r")
set tavern=null
set p=null
return 0
endif
set helper=LoadInteger(L7,GetHandleId(tavern),20+choice)
set source=LoadInteger(L7,GetHandleId(tavern),40+choice)
set order=LoadStr(L7,GetHandleId(tavern),60+choice)
set order=SuijiMode_RandomOrder(skill,order)
if SuijiMode_IsNativeRegisteredSkill(hero,skill) then
call SuijiTavernB295_RestoreChoice(tavern,choice)
call DisplayTimedTextToPlayer(p,0,0,10.,"|cFFFFCC00随机OMG："+GetObjectName(skill)+" 与已选择英雄的原生技能重复，本次选择无效，酒馆不刷新|r")
set order=""
set tavern=null
set p=null
return 0
endif
if SuijiMode_CanUseSkill(hero,skill,helper,order)==false or (kind==1 and SuijiTavern_PendingConflict(h,skill,helper,order)) then
call SuijiTavernB295_RestoreChoice(tavern,choice)
call DisplayTimedTextToPlayer(p,0,0,8.,"|cFFFFCC00随机OMG：该技能与当前英雄或另一项选择冲突，本次选择无效，酒馆不刷新|r")
set order=""
set tavern=null
set p=null
return 0
endif
if kind==2 then
set picked=OM7(h,"SuijiUltPicked")+1
call NP7(h,"SuijiUltPicked",picked)
if picked==1 then
set mark="SuijiMainU"
else
set mark="SuijiUlt"
endif
if SuijiMode_UltLevel(hero)<=0 then
call NP7(h,"SuijiUltPending"+I2S(picked)+"Skill",skill)
call NP7(h,"SuijiUltPending"+I2S(picked)+"Helper",helper)
call NP7(h,"SuijiUltPending"+I2S(picked)+"Source",source)
call NR7(h,"SuijiUltPending"+I2S(picked)+"Order",order)
set result=skill
call SuijiMode_NotifyPickedSkill(hero,skill,mark+"(预选)","预选了")
else
set result=SuijiMode_AddSkill(hero,skill,helper,order,SuijiMode_UltLevel(hero),source,mark)
if result!=0 then
call SuijiMode_NotifyPickedSkill(hero,result,mark,"选择了")
endif
endif
if result!=0 then
if picked>=2 then
call NP7(h,"SuijiPhase",3)
call SuijiTavernB295_Lock(tavern,kind)
call SuijiTavern_StopTimeout(pid)
call DisplayTimedTextToPlayer(p,0,0,8.,"|cFF00FF00随机OMG：全部技能选择完成！|r")
else
call SuijiTavernB295_Fill(tavern,2)
call DisplayTimedTextToPlayer(p,0,0,6.,"|cFF00FF00随机OMG：已选择第"+I2S(picked)+"个大招，请继续选择第2个大招（可花50金币刷新）|r")
endif
call SuijiTavernB295_FocusNext(hero)
endif
else
set picked=OM7(h,"SuijiSmallPicked")+1
call NP7(h,"SuijiSmallPicked",picked)
if picked<=3 then
set mark="SuijiMainS"+I2S(picked)
else
set mark="SuijiSmall"
endif
set result=SuijiMode_AddSkill(hero,skill,helper,order,SuijiMode_SmallLevel(hero),source,mark)
if result!=0 then
call SuijiMode_NotifyPickedSkill(hero,result,mark,"选择了")
if picked>=4 then
call NP7(h,"SuijiPhase",2)
call SuijiTavernB295_Lock(tavern,1)
call SuijiTavernB295_UnlockUlt(hero)
else
call SuijiTavernB295_Fill(tavern,1)
call DisplayTimedTextToPlayer(p,0,0,6.,"|cFF00FF00随机OMG：已选择第"+I2S(picked)+"个小技能，请继续选择第"+I2S(picked+1)+"个（可花50金币刷新）|r")
endif
call SuijiTavernB295_FocusNext(hero)
endif
endif
set order=""
set tavern=null
set p=null
return result
endfunction
function SuijiTavernB295_Timeout takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer th=GetHandleId(t)
local unit hero=LoadUnitHandle(L7,th,0)
local integer pid=LoadInteger(L7,th,1)
local integer skill=0
local integer tries=0
local integer h=0
set SUIJI_TAVERN_TIMEOUT[pid]=null
if hero!=null and GetUnitTypeId(hero)!=0 then
set h=GetHandleId(hero)
call SuijiMode_RemoveNativeSkills(hero)
loop
exitwhen tries>=10 or (OM7(h,"SuijiSmallPicked")>=4 and OM7(h,"SuijiUltPicked")>=2)
set tries=tries+1
if OM7(h,"SuijiSmallPicked")<4 then
if SUIJI_TAVERN_SMALL[pid]!=null then
if SuijiTavernB295_IsStale(SUIJI_TAVERN_SMALL[pid],hero,1) then
call SuijiTavernB295_Fill(SUIJI_TAVERN_SMALL[pid],1)
endif
set skill=SuijiTavernB295_FirstChoice(SUIJI_TAVERN_SMALL[pid])
if SuijiTavernB295_Choose(hero,1,skill)!=0 then
call DisplayTimedTextToPlayer(Player(pid),0,0,8.,"|cFFFFCC00随机OMG：小技能选择时间结束，已自动采用候选|r")
endif
endif
elseif OM7(h,"SuijiUltPicked")<2 then
if SUIJI_TAVERN_ULT[pid]!=null and OM7(GetHandleId(SUIJI_TAVERN_ULT[pid]),"SuijiTavernLocked")==0 then
if SuijiTavernB295_IsStale(SUIJI_TAVERN_ULT[pid],hero,2) then
call SuijiTavernB295_Fill(SUIJI_TAVERN_ULT[pid],2)
endif
set skill=SuijiTavernB295_FirstChoice(SUIJI_TAVERN_ULT[pid])
if SuijiTavernB295_Choose(hero,2,skill)!=0 then
call DisplayTimedTextToPlayer(Player(pid),0,0,8.,"|cFFFFCC00随机OMG：大招选择时间结束，已自动采用候选|r")
endif
endif
endif
endloop
endif
call FlushChildHashtable(L7,th)
call DestroyTimer(t)
set hero=null
set t=null
endfunction
function SuijiTavernB295_Start takes unit hero returns nothing
local player p=null
local integer pid=0
local boolean first=false
local timer t=null
local integer h=0
if hero==null or GetUnitTypeId(hero)==0 then
return
endif
set p=GetOwningPlayer(hero)
set pid=GetPlayerId(p)
if GetPlayerController(p)!=MAP_CONTROL_USER then
set p=null
return
endif
set h=GetHandleId(hero)
call SuijiMode_RemoveNativeSkills(hero)
if OM7(h,"SuijiSmallPicked")<=0 and OM7(h,"SuijiUltPicked")<=0 then
call NP7(h,"SuijiSmallPicked",0)
call NP7(h,"SuijiUltPicked",0)
call NP7(h,"SuijiPhase",1)
endif
if SUIJI_TAVERN_SMALL[pid]==null or GetUnitTypeId(SUIJI_TAVERN_SMALL[pid])==0 then
call ExecuteFunc("SuijiTavernB295_CreateSelectionArea")
endif
if SUIJI_TAVERN_TIMEOUT[pid]==null and OM7(h,"SuijiSmallPicked")<4 then
set t=CreateTimer()
set SUIJI_TAVERN_TIMEOUT[pid]=t
call SaveUnitHandle(L7,GetHandleId(t),0,hero)
call SaveInteger(L7,GetHandleId(t),1,pid)
call TimerStart(t,90.,false,function SuijiTavernB295_Timeout)
endif
set first=OO7(h,"SuijiTavernStarted")==false
if first then
call NS7(h,"SuijiTavernStarted",true)
call ClearSelectionForPlayer(p)
call SelectUnitAddForPlayer(SUIJI_TAVERN_SMALL[pid],p)
call PanCameraToTimedForPlayer(p,-6880.,6784.,.30)
call DisplayTimedTextToPlayer(p,0,0,15.,"|cFF00FF00随机OMG：请选择4个小技能和2个大招；技能酒馆可花50金币无限刷新|r")
endif
set t=null
set p=null
endfunction
function SuijiTavernB295_Refresh takes unit tavern,unit hero,integer kind returns nothing
local player p=null
local integer h=0
local integer left=0
local integer cost=50
if tavern==null or GetUnitTypeId(tavern)==0 then
return
endif
set p=GetOwningPlayer(tavern)
set h=GetHandleId(tavern)
if OM7(h,"SuijiTavernLocked")!=0 then
call DisplayTimedTextToPlayer(p,0,0,6.,"|cFFFFCC00随机OMG：当前技能酒馆已经完成选择|r")
set p=null
return
endif
if hero!=null and GetUnitTypeId(hero)!=0 then
if kind==1 and OM7(GetHandleId(hero),"SuijiSmallPicked")>=4 then
call DisplayTimedTextToPlayer(p,0,0,6.,"|cFFFFCC00随机OMG：你已经选满了4个小技能|r")
set p=null
return
elseif kind==2 and OM7(GetHandleId(hero),"SuijiUltPicked")>=2 then
call DisplayTimedTextToPlayer(p,0,0,6.,"|cFFFFCC00随机OMG：你已经选满了2个大招|r")
set p=null
return
endif
endif
if GetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD)<cost then
call DisplayTimedTextToPlayer(p,0,0,6.,"|cFFFFCC00随机OMG：刷新需要"+I2S(cost)+"金币|r")
set p=null
return
endif
call SetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD)-cost)
call SuijiTavernB295_Fill(tavern,kind)
call ClearSelectionForPlayer(p)
call SelectUnitAddForPlayer(tavern,p)
call DisplayTimedTextToPlayer(p,0,0,6.,"|cFF00FF00随机OMG：已花费"+I2S(cost)+"金币刷新候选，可无限刷新|r")
set p=null
endfunction
function SuijiTavernB295_RemoveOldTopLeft takes nothing returns nothing
local integer i=1
local unit u=null
loop
exitwhen i>12
set u=BZ4[i]
if u!=null and GetUnitTypeId(u)!=0 then
call ShowUnit(u,false)
call RemoveUnit(u)
endif
set BZ4[i]=null
set i=i+1
endloop
set MP4=null
set MQ4=null
set MR4=null
set MS4=null
set MT4=null
set MU4=null
set MV4=null
set MW4=null
set MX4=null
set MY4=null
set MZ4=null
set MA4=null
set u=null
endfunction
function SuijiTavernB295_ReplaceHeroStore takes integer pid,real x,real y returns nothing
local player p=Player(pid)
local unit old=KU4[pid]
local unit tavern=null
local integer oldHandle=0
local integer newHandle=0
local integer heroType=0
local integer i=1
if old==null or GetUnitTypeId(old)==0 then
set old=null
set p=null
return
endif
set oldHandle=GetHandleId(old)
call SuijiTavernB316_LimitHeroChoices(old)
set tavern=CreateUnit(p,'nT90',x,y,270.)
set newHandle=GetHandleId(tavern)
call SetUnitPathing(tavern,false)
call SetUnitScale(tavern,.70,.70,.70)
loop
exitwhen i>6
set heroType=LoadInteger(TABLE_XJ,oldHandle,i)
if heroType!=0 then
call SaveInteger(TABLE_XJ,newHandle,i,heroType)
call AddUnitToStock(tavern,heroType,1,1)
call RemoveUnitFromStock(old,heroType)
endif
set i=i+1
endloop
call SaveInteger(TABLE_XJ,newHandle,100,LoadInteger(TABLE_XJ,oldHandle,100))
call UnitAddAbility(tavern,'A4DD')
call UnitAddAbility(tavern,'A4EP')
call ShowUnit(old,true)
set SUIJI_TAVERN_HERO[pid]=tavern
set old=null
set tavern=null
set p=null
endfunction
function SuijiTavernB295_CreateSelectionArea takes nothing returns nothing
local integer pid=1
local integer row=0
local player p=null
local real x=0.
local real y=0.
if SUIJI_TAVERN_AREA_READY then
return
endif
set SUIJI_TAVERN_AREA_READY=true
call SuijiTavernB295_RemoveOldTopLeft()
loop
exitwhen pid>11
if pid==6 then
set pid=7
endif
set p=Player(pid)
if GetPlayerSlotState(p)==PLAYER_SLOT_STATE_PLAYING and GetPlayerController(p)==MAP_CONTROL_USER then
if pid<=5 then
set row=pid-1
set x=-7424.
else
set row=pid-7
set x=-6912.
endif
set y=7104.-160.*I2R(row)
call SuijiTavernB295_ReplaceHeroStore(pid,x,y)
set SUIJI_TAVERN_SMALL[pid]=CreateUnit(p,'nT91',x+160.,y,270.)
call SetUnitPathing(SUIJI_TAVERN_SMALL[pid],false)
call SetUnitScale(SUIJI_TAVERN_SMALL[pid],.70,.70,.70)
call NP7(GetHandleId(SUIJI_TAVERN_SMALL[pid]),"SuijiTavernRefreshLeft",3)
call SuijiTavernB295_Fill(SUIJI_TAVERN_SMALL[pid],1)
set SUIJI_TAVERN_ULT[pid]=CreateUnit(p,'nT92',x+320.,y,270.)
call SetUnitPathing(SUIJI_TAVERN_ULT[pid],false)
call SetUnitScale(SUIJI_TAVERN_ULT[pid],.70,.70,.70)
call NP7(GetHandleId(SUIJI_TAVERN_ULT[pid]),"SuijiTavernRefreshLeft",3)
call SuijiTavernB295_Fill(SUIJI_TAVERN_ULT[pid],2)
call SuijiTavernB295_Lock(SUIJI_TAVERN_ULT[pid],2)
call ClearSelectionForPlayer(p)
if SUIJI_TAVERN_HERO[pid]!=null and GetUnitTypeId(SUIJI_TAVERN_HERO[pid])!=0 then
call SelectUnitAddForPlayer(SUIJI_TAVERN_HERO[pid],p)
endif
call PanCameraToTimedForPlayer(p,-6880.,6784.,.30)
call DisplayTimedTextToPlayer(p,0,0,15.,"|cFF00FF00随机OMG：左上角对应玩家颜色的一行三个酒馆；英雄酒馆每次显示4个英雄，依次选择原生英雄、小技能和大招|r")
endif
set pid=pid+1
endloop
set p=null
endfunction
function SuijiTavernB295_OnEvent takes nothing returns boolean
local unit sold=null
local unit tavern=null
local unit hero=null
local unit buyer=null
local player p=null
local integer pid=0
local integer shopPid=0
local integer skill=0
local integer proxy=0
local integer choice=0
local integer spell=0
if SUIJI_MODE==false then
return false
endif
if GetTriggerEventId()==EVENT_PLAYER_UNIT_SELECTED then
set tavern=GetTriggerUnit()
set p=GetTriggerPlayer()
set pid=GetPlayerId(p)
set hero=M7[pid]
set shopPid=GetPlayerId(GetOwningPlayer(tavern))
if tavern==SUIJI_TAVERN_SMALL[pid] then
if SuijiTavernB295_IsStale(tavern,hero,1) and OM7(GetHandleId(tavern),"SuijiTavernLocked")==0 then
call SuijiTavernB295_Fill(tavern,1)
endif
if SuijiTavernB295_HasChosen(hero,1)==false and OM7(GetHandleId(tavern),"SuijiTavernLocked")==0 and OM7(GetHandleId(tavern),"SuijiTavernCount")<=0 then
call SuijiTavernB295_Fill(tavern,1)
endif
elseif tavern==SUIJI_TAVERN_ULT[pid] then
if SuijiTavernB295_IsStale(tavern,hero,2) and OM7(GetHandleId(tavern),"SuijiTavernLocked")==0 then
call SuijiTavernB295_Fill(tavern,2)
endif
if SuijiTavernB295_HasChosen(hero,2)==false and OM7(GetHandleId(tavern),"SuijiTavernLocked")==0 and OM7(GetHandleId(tavern),"SuijiTavernCount")<=0 then
call SuijiTavernB295_Fill(tavern,2)
endif
elseif shopPid!=pid and (tavern==SUIJI_TAVERN_SMALL[shopPid] or tavern==SUIJI_TAVERN_ULT[shopPid] or tavern==SUIJI_TAVERN_HERO[shopPid]) then
call ClearSelectionForPlayer(p)
if tavern==SUIJI_TAVERN_SMALL[shopPid] and SUIJI_TAVERN_SMALL[pid]!=null then
call SelectUnitAddForPlayer(SUIJI_TAVERN_SMALL[pid],p)
elseif tavern==SUIJI_TAVERN_ULT[shopPid] and SUIJI_TAVERN_ULT[pid]!=null then
call SelectUnitAddForPlayer(SUIJI_TAVERN_ULT[pid],p)
elseif SUIJI_TAVERN_HERO[pid]!=null then
call SelectUnitAddForPlayer(SUIJI_TAVERN_HERO[pid],p)
endif
call DisplayTimedTextToPlayer(p,0,0,6.,"|cFFFFCC00随机OMG：只能查看和选择自己颜色对应的一行三个酒馆|r")
endif
elseif GetTriggerEventId()==EVENT_PLAYER_UNIT_SELL then
set sold=GetSoldUnit()
set tavern=GetSellingUnit()
if sold!=null then
set buyer=GetBuyingUnit()
if buyer!=null and GetUnitTypeId(buyer)!=0 then
set pid=GetPlayerId(GetOwningPlayer(buyer))
else
set pid=GetPlayerId(GetOwningPlayer(sold))
endif
set shopPid=GetPlayerId(GetOwningPlayer(tavern))
set proxy=GetUnitTypeId(sold)
if tavern==SUIJI_TAVERN_SMALL[shopPid] or tavern==SUIJI_TAVERN_ULT[shopPid] then
call RemoveUnit(sold)
if pid!=shopPid then
call AddUnitToStock(tavern,proxy,1,1)
call DisplayTimedTextToPlayer(Player(pid),0,0,8.,"|cFFFFCC00随机OMG：只能从自己颜色对应的技能酒馆选择|r")
else
set choice=SuijiTavernB295_FindChoiceByProxy(tavern,proxy)
if choice<=0 then
call AddUnitToStock(tavern,proxy,1,1)
call DisplayTimedTextToPlayer(Player(pid),0,0,8.,"|cFFFFCC00随机OMG：候选技能数据无效，本次选择无效，酒馆不刷新|r")
else
set skill=LoadInteger(L7,GetHandleId(tavern),choice)
set hero=M7[pid]
if hero==null or GetUnitTypeId(hero)==0 then
call AddUnitToStock(tavern,proxy,1,1)
call DisplayTimedTextToPlayer(Player(pid),0,0,8.,"|cFFFFCC00随机OMG：请先在英雄酒馆选择原生英雄|r")
elseif tavern==SUIJI_TAVERN_SMALL[pid] then
if SuijiTavernB295_HasChosen(hero,1) then
call DisplayTimedTextToPlayer(Player(pid),0,0,6.,"|cFFFFCC00随机OMG：你已经选满了4个小技能|r")
else
call SuijiTavernB295_Choose(hero,1,skill)
endif
else
if SuijiTavernB295_HasChosen(hero,2) then
call DisplayTimedTextToPlayer(Player(pid),0,0,6.,"|cFFFFCC00随机OMG：你已经选满了2个大招|r")
else
call SuijiTavernB295_Choose(hero,2,skill)
endif
endif
endif
endif
endif
endif
else
set tavern=GetTriggerUnit()
set pid=GetPlayerId(GetOwningPlayer(tavern))
set hero=M7[pid]
set spell=B287_GetSpellAbilityId()
if tavern==SUIJI_TAVERN_SMALL[pid] and spell=='A4T1' then
call SuijiTavernB295_Refresh(tavern,hero,1)
elseif tavern==SUIJI_TAVERN_ULT[pid] and spell=='A4T2' then
call SuijiTavernB295_Refresh(tavern,hero,2)
endif
endif
set sold=null
set tavern=null
set hero=null
set buyer=null
set p=null
return false
endfunction
function SuijiTest_RechooseUnlockTavern takes integer pid,integer kind returns nothing
local unit tavern=null
local integer h=0
if kind==2 then
set tavern=SUIJI_TAVERN_ULT[pid]
else
set tavern=SUIJI_TAVERN_SMALL[pid]
endif
if tavern!=null and GetUnitTypeId(tavern)!=0 then
set h=GetHandleId(tavern)
call SuijiTavernB295_ClearStock(tavern)
call NP7(h,"SuijiTavernLocked",0)
call NP7(h,"SuijiTavernRefreshLeft",3)
if kind==2 then
call UnitAddAbility(tavern,'A4T2')
else
call UnitAddAbility(tavern,'A4T1')
endif
call SuijiTavernB295_Fill(tavern,kind)
endif
set tavern=null
endfunction
function SuijiTest_PrepareUnlimitedRechoose takes nothing returns nothing
local player p=LoadPlayerHandle(L7,StringHash("SuijiTestRechoosePlayer"),0)
local integer pid=0
local integer heroIndex=0
local unit oldHero=null
local unit heroTavern=null
call RemoveSavedHandle(L7,StringHash("SuijiTestRechoosePlayer"),0)
if ISTEST==false or SUIJI_MODE==false or p==null then
set p=null
return
endif
set pid=GetPlayerId(p)
set oldHero=M7[pid]
if oldHero==null or GetUnitTypeId(oldHero)==0 then
call DisplayTimedTextToPlayer(p,0,0,6.,"|cFFFFCC00随机OMG：请先选择英雄后再使用 -rechoose|r")
set oldHero=null
set p=null
return
endif
set heroIndex=SuijiMode_GetStableHeroIndex(oldHero)
call SuijiTavern_StopTimeout(pid)
call SuijiTest_RechooseUnlockTavern(pid,1)
call SuijiTest_RechooseUnlockTavern(pid,2)
if heroIndex>=KL4 and heroIndex<=K54 then
set J[heroIndex]=false
set heroTavern=SUIJI_TAVERN_HERO[pid]
if heroTavern!=null and GetUnitTypeId(heroTavern)!=0 then
call AddUnitToStock(heroTavern,K34[heroIndex],1,1)
endif
endif
call YE7(oldHero)
set M7[pid]=null
set I[pid]=false
set W4[pid]=false
set oo[pid]=false
set P9[pid]=false
set G9=true
set T9=false
set F9=true
call ClearSelectionForPlayer(p)
if heroTavern!=null and GetUnitTypeId(heroTavern)!=0 then
call SelectUnitAddForPlayer(heroTavern,p)
call PanCameraToTimedForPlayer(p,GetUnitX(heroTavern),GetUnitY(heroTavern),.30)
endif
call DisplayTimedTextToPlayer(p,0,0,8.,"|cFF00FF00随机OMG测试：已重开英雄、小技能和大招选择，可再次使用 -rechoose|r")
set oldHero=null
set heroTavern=null
set p=null
endfunction
function SuijiTavern_Init takes nothing returns nothing
if SUIJI_TAVERN_TRIGGER==null then
set SUIJI_TAVERN_TRIGGER=CreateTrigger()
call YB7(SUIJI_TAVERN_TRIGGER,EVENT_PLAYER_UNIT_SELL)
call YB7(SUIJI_TAVERN_TRIGGER,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call YB7(SUIJI_TAVERN_TRIGGER,EVENT_PLAYER_UNIT_SELECTED)
call TriggerAddCondition(SUIJI_TAVERN_TRIGGER,Condition(function SuijiTavernB295_OnEvent))
endif
endfunction
function SuijiMode_EnsureManaRegenBonus takes unit suijiManaRegenUnit returns nothing
local integer suijiManaRegenHandle=0
local real suijiManaRegenBase=0.
local real suijiManaRegenCurrent=0.
if SUIJI_MODE==false or suijiManaRegenUnit==null then
return
endif
if IsUnitType(suijiManaRegenUnit,UNIT_TYPE_HERO)==false or IsUnitIllusion(suijiManaRegenUnit) or GetUnitTypeId(suijiManaRegenUnit)=='H00J' then
return
endif
set suijiManaRegenHandle=GetHandleId(suijiManaRegenUnit)
set suijiManaRegenCurrent=MHUnit_GetData(suijiManaRegenUnit,UNIT_DATA_MANA_REGEN)
if OO7(suijiManaRegenHandle,"SuijiManaRegenBonus")==false then
call NS7(suijiManaRegenHandle,"SuijiManaRegenBonus",true)
call NQ7(suijiManaRegenHandle,"SuijiManaRegenBase",suijiManaRegenCurrent)
call MHUnit_SetData(suijiManaRegenUnit,UNIT_DATA_MANA_REGEN,suijiManaRegenCurrent+2.)
return
endif
set suijiManaRegenBase=ON7(suijiManaRegenHandle,"SuijiManaRegenBase")
if suijiManaRegenCurrent<suijiManaRegenBase+1.99 then
call MHUnit_SetData(suijiManaRegenUnit,UNIT_DATA_MANA_REGEN,suijiManaRegenBase+2.)
endif
endfunction
function SuijiMode_InitLevelAttributeBonus takes unit suijiAttrUnit returns nothing
local integer suijiAttrHandle=0
if SUIJI_MODE==false or suijiAttrUnit==null then
return
endif
if IsUnitType(suijiAttrUnit,UNIT_TYPE_HERO)==false or IsUnitIllusion(suijiAttrUnit) or GetUnitTypeId(suijiAttrUnit)=='H00J' then
return
endif
set suijiAttrHandle=GetHandleId(suijiAttrUnit)
if LoadInteger(L7,suijiAttrHandle,StringHash("SuijiLevelAttrBonusLevel"))<=0 then
call SaveInteger(L7,suijiAttrHandle,StringHash("SuijiLevelAttrBonusLevel"),GetHeroLevel(suijiAttrUnit))
endif
endfunction
function SuijiMode_IsRegisteredSourceSkill takes integer suijiSkillSource,integer suijiOwnedSkill returns boolean
local integer suijiRegisteredSlot=1
if suijiSkillSource<=0 or suijiOwnedSkill==0 then
return false
endif
loop
exitwhen suijiRegisteredSlot>10
if LoadInteger(MSK,suijiSkillSource,suijiRegisteredSlot)==suijiOwnedSkill then
return true
endif
set suijiRegisteredSlot=suijiRegisteredSlot+1
endloop
return false
endfunction
function SuijiMode_IsAllowedOwnedPoolSkill takes unit suijiOwnedUnit,integer suijiOwnedSkill returns boolean
local integer suijiOwnedHandle=0
local integer suijiOwnedLogicalSkill=0
if suijiOwnedUnit==null or GetUnitTypeId(suijiOwnedUnit)==0 or suijiOwnedSkill==0 then
return false
endif
set suijiOwnedHandle=GetHandleId(suijiOwnedUnit)
set suijiOwnedLogicalSkill=SuijiMode_ToOriginalSkill(suijiOwnedSkill)
if suijiOwnedLogicalSkill==OM7(suijiOwnedHandle,"SuijiSmallSkill") then
return suijiOwnedSkill==OM7(suijiOwnedHandle,"SuijiSmallAbility")
endif
if suijiOwnedLogicalSkill==OM7(suijiOwnedHandle,"SuijiUltSkill") then
return suijiOwnedSkill==OM7(suijiOwnedHandle,"SuijiUltAbility")
endif
if SuijiMode_IsNativeRegisteredSkill(suijiOwnedUnit,suijiOwnedLogicalSkill) then
return true
endif
if SuijiMode_IsRegisteredSourceSkill(OM7(suijiOwnedHandle,"SuijiSmallSource"),suijiOwnedLogicalSkill) then
return true
endif
return SuijiMode_IsRegisteredSourceSkill(OM7(suijiOwnedHandle,"SuijiUltSource"),suijiOwnedLogicalSkill)
endfunction
function SuijiMode_RemoveUnexpectedPoolSkill takes unit suijiOwnedUnit,integer suijiOwnedSkill returns integer
local item suijiOwnedSourceItem=null
if suijiOwnedSkill==0 or GetUnitAbilityLevel(suijiOwnedUnit,suijiOwnedSkill)<=0 or SuijiMode_IsAllowedOwnedPoolSkill(suijiOwnedUnit,suijiOwnedSkill) then
return 0
endif
set suijiOwnedSourceItem=MHAbility_GetSourceItem(suijiOwnedUnit,suijiOwnedSkill)
if suijiOwnedSourceItem!=null then
set suijiOwnedSourceItem=null
return 0
endif
call UnitRemoveAbility(suijiOwnedUnit,suijiOwnedSkill)
set suijiOwnedSourceItem=null
return 1
endfunction
function SuijiMode_CleanupUnexpectedPoolSkills takes unit suijiOwnedUnit returns nothing
local integer suijiOwnedIndex=KL4
local integer suijiOwnedRemoved=0
if SUIJI_MODE==false or suijiOwnedUnit==null or GetUnitTypeId(suijiOwnedUnit)==0 or IsUnitType(suijiOwnedUnit,UNIT_TYPE_HERO)==false or IsUnitIllusion(suijiOwnedUnit) then
return
endif
if OO7(GetHandleId(suijiOwnedUnit),"SuijiDone")==false then
return
endif
loop
exitwhen suijiOwnedIndex>K54
set suijiOwnedRemoved=suijiOwnedRemoved+SuijiMode_RemoveUnexpectedPoolSkill(suijiOwnedUnit,HM4[suijiOwnedIndex])
set suijiOwnedRemoved=suijiOwnedRemoved+SuijiMode_RemoveUnexpectedPoolSkill(suijiOwnedUnit,SuijiMode_ToFixedClone(HM4[suijiOwnedIndex]))
set suijiOwnedRemoved=suijiOwnedRemoved+SuijiMode_RemoveUnexpectedPoolSkill(suijiOwnedUnit,HN4[suijiOwnedIndex])
set suijiOwnedRemoved=suijiOwnedRemoved+SuijiMode_RemoveUnexpectedPoolSkill(suijiOwnedUnit,SuijiMode_ToFixedClone(HN4[suijiOwnedIndex]))
set suijiOwnedRemoved=suijiOwnedRemoved+SuijiMode_RemoveUnexpectedPoolSkill(suijiOwnedUnit,HO4[suijiOwnedIndex])
set suijiOwnedRemoved=suijiOwnedRemoved+SuijiMode_RemoveUnexpectedPoolSkill(suijiOwnedUnit,SuijiMode_ToFixedClone(HO4[suijiOwnedIndex]))
set suijiOwnedRemoved=suijiOwnedRemoved+SuijiMode_RemoveUnexpectedPoolSkill(suijiOwnedUnit,HP4[suijiOwnedIndex])
set suijiOwnedRemoved=suijiOwnedRemoved+SuijiMode_RemoveUnexpectedPoolSkill(suijiOwnedUnit,SuijiMode_ToFixedClone(HP4[suijiOwnedIndex]))
set suijiOwnedRemoved=suijiOwnedRemoved+SuijiMode_RemoveUnexpectedPoolSkill(suijiOwnedUnit,HQ4[suijiOwnedIndex])
set suijiOwnedRemoved=suijiOwnedRemoved+SuijiMode_RemoveUnexpectedPoolSkill(suijiOwnedUnit,SuijiMode_ToFixedClone(HQ4[suijiOwnedIndex]))
set suijiOwnedIndex=suijiOwnedIndex+1
endloop
if suijiOwnedRemoved>0 and SUIJI_LOG then
call DisplayTimedTextToPlayer(GetOwningPlayer(suijiOwnedUnit),0,0,8.,"|cFFFFCC00随机OMG日志：|r已清理 "+I2S(suijiOwnedRemoved)+" 个未登记的残留技能。")
endif
endfunction
function SuijiMode_GrantLevelAttributeBonus takes unit suijiAttrUnit returns nothing
local integer suijiAttrHandle=0
local integer suijiAttrLevel=0
local integer suijiAttrLastLevel=0
local integer suijiAttrBonus=0
if SUIJI_MODE==false or suijiAttrUnit==null then
return
endif
if IsUnitType(suijiAttrUnit,UNIT_TYPE_HERO)==false or IsUnitIllusion(suijiAttrUnit) or GetUnitTypeId(suijiAttrUnit)=='H00J' then
return
endif
set suijiAttrHandle=GetHandleId(suijiAttrUnit)
if OO7(suijiAttrHandle,"SuijiDone")==false then
return
endif
set suijiAttrLevel=GetHeroLevel(suijiAttrUnit)
set suijiAttrLastLevel=LoadInteger(L7,suijiAttrHandle,StringHash("SuijiLevelAttrBonusLevel"))
if suijiAttrLastLevel<=0 then
set suijiAttrLastLevel=suijiAttrLevel-1
if suijiAttrLastLevel<1 then
set suijiAttrLastLevel=1
endif
endif
if suijiAttrLevel<=suijiAttrLastLevel then
call SaveInteger(L7,suijiAttrHandle,StringHash("SuijiLevelAttrBonusLevel"),suijiAttrLevel)
return
endif
set suijiAttrBonus=(suijiAttrLevel-suijiAttrLastLevel)*2
call SetHeroStr(suijiAttrUnit,GetHeroStr(suijiAttrUnit,false)+suijiAttrBonus,true)
call SetHeroAgi(suijiAttrUnit,GetHeroAgi(suijiAttrUnit,false)+suijiAttrBonus,true)
call SetHeroInt(suijiAttrUnit,GetHeroInt(suijiAttrUnit,false)+suijiAttrBonus,true)
call SaveInteger(L7,suijiAttrHandle,StringHash("SuijiLevelAttrBonusLevel"),suijiAttrLevel)
endfunction
function SuijiMode_UpdateLevels takes unit u returns nothing
local integer h=0
local integer level=0
local integer selected=0
local player p=null
local boolean human=false
local string mark=""
if u==null or GetUnitTypeId(u)==0 then
return
endif
set h=GetHandleId(u)
if SUIJI_MODE==false or OO7(h,"SuijiDone")==false then
return
endif
if OO7(h,"SuijiTransformRestoring") then
return
endif
call SuijiMode_CleanupUnexpectedPoolSkills(u)
call SuijiMode_EnsureManaRegenBonus(u)
call SuijiMode_RestoreBaseHeroSkills(u)
set p=GetOwningPlayer(u)
set human=GetPlayerController(p)==MAP_CONTROL_USER
if human and (OM7(h,"SuijiSmallPicked")<4 or OM7(h,"SuijiUltPicked")<2) then
call SuijiTavernB295_Start(u)
else
set level=SuijiMode_SmallLevel(u)
set mark="SuijiMainS1"
call SuijiMode_RestoreSkill(u,mark,level)
call SuijiMode_UpdateMarkLevel(u,mark,level)
set mark="SuijiMainS2"
call SuijiMode_RestoreSkill(u,mark,level)
call SuijiMode_UpdateMarkLevel(u,mark,level)
set mark="SuijiMainS3"
call SuijiMode_RestoreSkill(u,mark,level)
call SuijiMode_UpdateMarkLevel(u,mark,level)
set mark="SuijiSmall"
call SuijiMode_RestoreSkill(u,mark,level)
call SuijiMode_UpdateMarkLevel(u,mark,level)
set level=SuijiMode_UltLevel(u)
if level>0 then
call SuijiMode_EnsureAIOriginalUltimate(u,level)
if human then
set selected=SuijiTavern_ApplyPendingUlt(u)
else
if OM7(h,"SuijiMainUSkill")==0 then
if SuijiMode_HasForcedPreset(GetPlayerId(p)) then
call SuijiTest_AddPresetSkill(u,SuijiMode_ForcedUlt(GetPlayerId(p)),level,"SuijiMainU")
else
call SuijiMode_AddRandomUltimateMark(u,level,"SuijiMainU")
endif
endif
if OM7(h,"SuijiUltSkill")==0 then
if SuijiMode_HasForcedPreset(GetPlayerId(p)) then
call SuijiTest_AddPresetSkill(u,SuijiMode_ForcedUlt(GetPlayerId(p)),level,"SuijiUlt")
else
call SuijiMode_AddRandomUltimateMark(u,level,"SuijiUlt")
endif
endif
endif
set mark="SuijiMainU"
call SuijiMode_RestoreSkill(u,mark,level)
call SuijiMode_UpdateMarkLevel(u,mark,level)
set mark="SuijiUlt"
call SuijiMode_RestoreSkill(u,mark,level)
call SuijiMode_UpdateMarkLevel(u,mark,level)
endif
endif
call SuijiMode_AutoLearnYellowBonus(u)
call SuijiMode_UpdateAghSkills(u)
call SuijiMode_SyncRandomAttackRange(u)
call SuijiMode_ForcePassiveOrbs(u)
set p=null
endfunction
function SuijiMode_LevelSkillIntegrityTimer takes nothing returns nothing
local timer suijiLevelSkillTimer=GetExpiredTimer()
local integer suijiLevelSkillTimerHandle=GetHandleId(suijiLevelSkillTimer)
local unit suijiLevelSkillUnit=LoadUnitHandle(L7,suijiLevelSkillTimerHandle,0)
if suijiLevelSkillUnit!=null and GetUnitTypeId(suijiLevelSkillUnit)!=0 then
call SuijiMode_UpdateLevels(suijiLevelSkillUnit)
endif
call FlushChildHashtable(L7,suijiLevelSkillTimerHandle)
call DestroyTimer(suijiLevelSkillTimer)
set suijiLevelSkillUnit=null
set suijiLevelSkillTimer=null
endfunction
function SuijiMode_OnHeroLevelCurrent takes nothing returns nothing
local timer suijiLevelSkillTimer=null
call SuijiMode_GrantLevelAttributeBonus(SUIJI_LEVEL_UNIT)
if SUIJI_LEVEL_UNIT!=null and GetUnitTypeId(SUIJI_LEVEL_UNIT)!=0 then
call NS7(GetHandleId(SUIJI_LEVEL_UNIT),"SuijiAghForceUpdate",true)
call SuijiMode_MarkUnitVisibilityDirty(SUIJI_LEVEL_UNIT)
endif
call SuijiMode_UpdateLevels(SUIJI_LEVEL_UNIT)
if SUIJI_LEVEL_UNIT!=null and GetUnitTypeId(SUIJI_LEVEL_UNIT)!=0 then
set suijiLevelSkillTimer=CreateTimer()
call SaveUnitHandle(L7,GetHandleId(suijiLevelSkillTimer),0,SUIJI_LEVEL_UNIT)
call TimerStart(suijiLevelSkillTimer,.10,false,function SuijiMode_LevelSkillIntegrityTimer)
endif
set SUIJI_LEVEL_UNIT=null
set suijiLevelSkillTimer=null
endfunction
function SuijiMode_TryOpenAIRepickWindow takes nothing returns nothing
local integer i=0
local unit hero=null
local boolean hasAI=false
local boolean hasSuperAI=false
if SUIJI_MODE==false or SUIJI_AI_RE_WINDOW_STARTED then
return
endif
loop
exitwhen i>$B
if IsPlayerInForce(Player(i),QX4) and GetPlayerController(Player(i))==MAP_CONTROL_COMPUTER then
set hasAI=true
if SuijiSuperAI_HasPreset(i) then
set hasSuperAI=true
endif
set hero=M7[i]
if hero==null or GetUnitTypeId(hero)==0 or OO7(GetHandleId(hero),"SuijiDone")==false then
set hero=null
return
endif
endif
set i=i+1
endloop
if hasAI then
set SUIJI_AI_RE_WINDOW_STARTED=true
set AI_RE_TIME=Bz+60.
if QT4!=null then
if hasSuperAI then
call DisplayTimedTextToPlayer(QT4,0,0,12.,"AI英雄已选择完毕，60秒内可输入|c00dd8dff-re楼层|r让普通AI重选；超级AI楼层禁止重选。")
else
call DisplayTimedTextToPlayer(QT4,0,0,12.,"AI英雄已选择完毕，60秒内可输入|c00dd8dff-re楼层|r让AI重选，例如 |c00dd8dff-re2|r")
endif
endif
if QU4!=null then
if hasSuperAI then
call DisplayTimedTextToPlayer(QU4,0,0,12.,"AI英雄已选择完毕，60秒内可输入|c00dd8dff-re楼层|r让普通AI重选；超级AI楼层禁止重选。")
else
call DisplayTimedTextToPlayer(QU4,0,0,12.,"AI英雄已选择完毕，60秒内可输入|c00dd8dff-re楼层|r让AI重选，例如 |c00dd8dff-re7|r")
endif
endif
endif
set hero=null
endfunction
// ===== v0.12 全自选 4+2 新增函数 =====
function SuijiMode_RemoveNativeSkills takes unit u returns nothing
local integer idx=0
local integer h=0
if u==null or GetUnitTypeId(u)==0 then
return
endif
set h=GetHandleId(u)
if OO7(h,"SuijiNativeRemoved") then
return
endif
set idx=SuijiMode_GetStableHeroIndex(u)
if idx<KL4 or idx>K54 then
return
endif
call UnitRemoveAbility(u,HM4[idx])
call UnitRemoveAbility(u,HN4[idx])
call UnitRemoveAbility(u,HO4[idx])
call UnitRemoveAbility(u,HP4[idx])
call UnitRemoveAbility(u,HQ4[idx])
call NS7(h,"SuijiNativeRemoved",true)
endfunction
function SuijiMode_UpdateMarkLevel takes unit u,string mark,integer level returns nothing
local integer h=0
local integer skill=0
if u==null or GetUnitTypeId(u)==0 then
return
endif
set h=GetHandleId(u)
set skill=OM7(h,mark+"Skill")
if skill!=0 and SuijiMode_GetLogicalAbilityLevel(u,skill)<level then
call SuijiMode_SetLogicalAbilityLevel(u,skill,level)
endif
endfunction
function SuijiMode_AddRandomSmallMark takes unit u,string mark returns integer
local integer tries=0
local integer idx=0
local integer slot=0
local integer skill=0
local integer helper=0
local integer level=0
local integer weight=0
local integer total=0
local integer chosenSkill=0
local integer chosenHelper=0
local integer chosenSource=0
local integer available=0
local integer fallbackSkill=0
local integer fallbackHelper=0
local integer fallbackSource=0
local string fallbackOrder=""
local string chosenOrder=""
local string order=""
if u==null or GetUnitTypeId(u)==0 then
return 0
endif
set level=SuijiMode_SmallLevel(u)
loop
exitwhen tries>=120 or chosenSkill!=0
set tries=tries+1
set idx=GetRandomInt(KL4,SUIJI_POOL_MAX)
set slot=GetRandomInt(1,3)
if slot==1 then
set skill=HM4[idx]
set helper=HR4[idx]
set order=HW4[idx]
elseif slot==2 then
set skill=HN4[idx]
set helper=HS4[idx]
set order=HX4[idx]
else
set skill=HO4[idx]
set helper=HT4[idx]
set order=HY4[idx]
endif
if SuijiMode_CanUseSkill(u,skill,helper,order) then
set available=available+1
set weight=SuijiMode_AISkillWeight(u,skill)
set total=total+weight
if fallbackSkill==0 or GetRandomInt(1,total)<=weight then
set fallbackSkill=skill
set fallbackHelper=helper
set fallbackSource=SuijiMode_GetPoolSource(idx)
set fallbackOrder=order
endif
if GetRandomInt(1,4)<=weight then
set chosenSkill=skill
set chosenHelper=helper
set chosenSource=SuijiMode_GetPoolSource(idx)
set chosenOrder=order
endif
endif
endloop
if chosenSkill==0 and fallbackSkill!=0 then
set chosenSkill=fallbackSkill
set chosenHelper=fallbackHelper
set chosenSource=fallbackSource
set chosenOrder=fallbackOrder
endif
if chosenSkill!=0 then
return SuijiMode_AddSkill(u,chosenSkill,chosenHelper,chosenOrder,level,chosenSource,mark)
endif
return 0
endfunction
function SuijiMode_AddRandomUltimateMark takes unit u,integer level,string mark returns integer
local integer tries=0
local integer idx=0
local integer skill=0
local integer helper=0
local integer weight=0
local integer total=0
local integer chosenSkill=0
local integer chosenHelper=0
local integer chosenSource=0
local integer available=0
local integer fallbackSkill=0
local integer fallbackHelper=0
local integer fallbackSource=0
local string fallbackOrder=""
local string chosenOrder=""
local string order=""
if u==null or GetUnitTypeId(u)==0 or level<=0 then
return 0
endif
if SuijiMode_ShouldForceAIMulticast(u) then
set chosenSkill=SuijiMode_AddSkill(u,'A088',0,"passive",level,18,mark)
if chosenSkill!=0 then
call NS7(GetHandleId(u),"SuijiAIMulticastReserved",false)
return chosenSkill
endif
call NS7(GetHandleId(u),"SuijiAIMulticastReserved",false)
endif
loop
exitwhen tries>=120 or chosenSkill!=0
set tries=tries+1
set idx=GetRandomInt(KL4,SUIJI_POOL_MAX+1)
if idx==SUIJI_POOL_MAX+1 then
set idx=50
set skill='A1YQ'
set helper=0
set order="berserk"
else
set skill=HP4[idx]
set helper=HU4[idx]
set order=HZ4[idx]
if SuijiMode_HasScepter(u) and HQ4[idx]!=0 and (HV4[idx]!=0 or SuijiMode_CanSkipHelper(HQ4[idx])) then
set skill=HQ4[idx]
set helper=HV4[idx]
endif
endif
if SuijiMode_CanUseSkill(u,skill,helper,order) then
set available=available+1
set weight=SuijiMode_AISkillWeight(u,skill)
set total=total+weight
if fallbackSkill==0 or GetRandomInt(1,total)<=weight then
set fallbackSkill=skill
set fallbackHelper=helper
set fallbackSource=SuijiMode_GetPoolSource(idx)
set fallbackOrder=order
endif
if GetRandomInt(1,4)<=weight then
set chosenSkill=skill
set chosenHelper=helper
set chosenSource=SuijiMode_GetPoolSource(idx)
set chosenOrder=order
endif
endif
endloop
if chosenSkill==0 and fallbackSkill!=0 then
set chosenSkill=fallbackSkill
set chosenHelper=fallbackHelper
set chosenSource=fallbackSource
set chosenOrder=fallbackOrder
endif
if chosenSkill!=0 then
return SuijiMode_AddSkill(u,chosenSkill,chosenHelper,chosenOrder,level,chosenSource,mark)
endif
return 0
endfunction
function SuijiTavernB295_UnlockUlt takes unit hero returns nothing
local player p=null
local integer pid=0
local unit tavern=null
if hero==null or GetUnitTypeId(hero)==0 then
return
endif
set p=GetOwningPlayer(hero)
set pid=GetPlayerId(p)
set tavern=SUIJI_TAVERN_ULT[pid]
if tavern!=null and GetUnitTypeId(tavern)!=0 then
call NP7(GetHandleId(tavern),"SuijiTavernLocked",0)
call UnitAddAbility(tavern,'A4T2')
call SuijiTavernB295_Fill(tavern,2)
endif
call DisplayTimedTextToPlayer(p,0,0,8.,"|cFF00FF00随机OMG：小技能选择完成！现在开始选择2个大招（可花50金币刷新）|r")
set tavern=null
set p=null
endfunction
function SuijiMode_ApplyUnit takes unit u returns nothing
local integer h=0
local integer small=0
local integer ult=0
local integer ultLevel=0
local player p=null
if SUIJI_MODE==false then
call SuijiTest_DebugUnit(u,"AP0","进入ApplyUnit但SUIJI未开启，返回")
return
endif
if u==null then
call SuijiTest_DebugUnit(u,"AP1","进入ApplyUnit但unit为空，返回")
return
endif
call SuijiTest_DebugUnit(u,"AP2","进入ApplyUnit")
if IsUnitType(u,UNIT_TYPE_HERO)==false or IsUnitIllusion(u) or GetUnitTypeId(u)=='H00J' then
call SuijiTest_DebugUnit(u,"AP3","不是有效真实英雄，返回 type="+I2S(GetUnitTypeId(u)))
return
endif
set h=GetHandleId(u)
if GetUnitPointValue(u)>=KL4 and GetUnitPointValue(u)<=K54 then
call SaveInteger(L7,h,StringHash("SuijiStableHeroIndex"),GetUnitPointValue(u))
endif
call SuijiMode_InitLevelAttributeBonus(u)
if OO7(h,"SuijiDone") then
call SuijiTest_DebugUnit(u,"AP4","SuijiDone已为true，跳过")
return
endif
call SuijiTest_DebugUnit(u,"AP5","通过基础检查，准备分配随机技能")
call SuijiMode_RestoreBaseHeroSkills(u)
call SuijiMode_EnsureManaRegenBonus(u)
call SuijiTest_DebugUnit(u,"AP5B","初次基础技能恢复完成")
set p=GetOwningPlayer(u)
if GetPlayerController(p)==MAP_CONTROL_USER and SuijiMode_HasForcedPreset(GetPlayerId(p))==false then
call NS7(h,"SuijiDone",true)
call SuijiMode_FixInvokerNativeSkillVisibility(u)
call SuijiTavernB295_Start(u)
set p=null
return
endif
call NS7(h,"SuijiDone",true)
call SuijiMode_FixInvokerNativeSkillVisibility(u)
call SuijiMode_RemoveNativeSkills(u)
call NP7(h,"SuijiSmallPicked",4)
call NP7(h,"SuijiUltPicked",2)
call NP7(h,"SuijiPhase",3)
if SuijiMode_HasForcedPreset(GetPlayerId(p)) then
set small=SuijiTest_AddPresetSkill(u,SuijiMode_ForcedSmall(GetPlayerId(p)),SuijiMode_SmallLevel(u),"SuijiMainS1")
set ultLevel=SuijiMode_UltLevel(u)
if ultLevel>0 then
set ult=SuijiTest_AddPresetSkill(u,SuijiMode_ForcedUlt(GetPlayerId(p)),ultLevel,"SuijiMainU")
endif
else
set small=SuijiMode_AddRandomSmallMark(u,"SuijiMainS1")
endif
call SuijiTest_DebugUnit(u,"AP6","AddRandomSmall返回="+I2S(small))
if small==0 then
call NS7(h,"SuijiDone",false)
if SUIJI_LOG then
call VV7(bj_FORCE_ALL_PLAYERS,8.,"|cFFFFCC00随机OMG日志：|rAI "+Q[GetPlayerId(p)]+KZ4[GetPlayerId(p)]+"|r 的 "+GetUnitName(u)+" 本次没有抽到可用小技能，稍后自动重试。")
endif
set p=null
return
endif
call SuijiMode_AddRandomSmallMark(u,"SuijiMainS2")
call SuijiMode_AddRandomSmallMark(u,"SuijiMainS3")
call SuijiMode_AddRandomSmallMark(u,"SuijiSmall")
set ultLevel=SuijiMode_UltLevel(u)
if ultLevel>0 then
call SuijiTest_DebugUnit(u,"AP7","大招等级="+I2S(ultLevel)+"，开始抽大招")
if SuijiMode_HasForcedPreset(GetPlayerId(p)) then
call SuijiMode_AddRandomUltimateMark(u,ultLevel,"SuijiUlt")
else
set ult=SuijiMode_AddRandomUltimateMark(u,ultLevel,"SuijiMainU")
call SuijiMode_AddRandomUltimateMark(u,ultLevel,"SuijiUlt")
endif
else
call SuijiTest_DebugUnit(u,"AP7","当前等级未到额外大招条件")
endif
if small!=0 then
call SuijiMode_NotifyPickedSkill(u,small,"主位小技能","获得了")
endif
if ult!=0 then
call SuijiMode_NotifyPickedSkill(u,ult,"主位大招","获得了")
endif
if small!=0 and ult!=0 then
call SuijiSuperAI_Announce(u)
endif
if small==0 and ult==0 then
call DisplayTimedTextToPlayer(p,0,0,15.,"|cFFFFCC00随机OMG：没有找到可用的额外技能|r")
endif
call SuijiMode_TryOpenAIRepickWindow()
set p=null
endfunction
function SuijiMode_ApplyCurrent takes nothing returns nothing
call SuijiTest_DebugUnit(IN4,"CUR0","ExecuteFunc进入ApplyCurrent")
call SuijiMode_ApplyUnit(IN4)
endfunction
function SuijiMode_ApplyExisting takes nothing returns nothing
local integer i=0
local unit u=null
loop
exitwhen i>$B
set u=M7[i]
if u!=null then
call SuijiMode_ApplyUnit(u)
endif
set i=i+1
endloop
set u=null
endfunction
function SuijiMode_IsScanHero takes unit u returns boolean
if u==null then
return false
endif
if GetUnitTypeId(u)==0 then
return false
endif
return IsUnitType(u,UNIT_TYPE_HERO) and IsUnitIllusion(u)==false and GetUnitTypeId(u)!='H00J'
endfunction
function SuijiMode_ApplyMissingHeroes takes nothing returns nothing
local integer i=0
local integer pid=0
local player p=null
local group g=null
local unit u=null
local boolean seenMain=false
if SUIJI_MODE==false then
return
endif
set g=WS7()
loop
exitwhen i>$B
set p=Player(i)
if TA7(p) then
set pid=GetPlayerId(p)
set seenMain=false
if M7[pid]!=null and GetUnitTypeId(M7[pid])==0 then
set M7[pid]=null
endif
call GroupEnumUnitsOfPlayer(g,p,Condition(function TO7))
loop
set u=FirstOfGroup(g)
exitwhen u==null
call GroupRemoveUnit(g,u)
if SuijiMode_IsScanHero(u) then
if M7[pid]==null and GetUnitPointValue(u)>=KL4 and GetUnitPointValue(u)<=K54 then
set M7[pid]=u
call SuijiTest_DebugUnit(u,"SCAN1","扫描发现M7为空，补登记主英雄")
if SUIJI_LOG and GetPlayerController(p)==MAP_CONTROL_COMPUTER then
call VV7(bj_FORCE_ALL_PLAYERS,8.,"|cFF00FF00随机OMG日志：|r已补登记AI "+Q[pid]+KZ4[pid]+"|r 的 "+GetUnitName(u))
endif
endif
if u==M7[pid] then
set seenMain=true
if OO7(GetHandleId(u),"SuijiDone")==false then
call SuijiTest_DebugUnit(u,"SCAN2","扫描发现主英雄未随机，调用ApplyUnit")
call SuijiMode_ApplyUnit(u)
endif
endif
endif
endloop
if seenMain==false and M7[pid]!=null and SuijiMode_IsScanHero(M7[pid]) and OO7(GetHandleId(M7[pid]),"SuijiDone")==false then
call SuijiTest_DebugUnit(M7[pid],"SCAN3","M7主英雄不在枚举组但未随机，直接调用ApplyUnit")
call SuijiMode_ApplyUnit(M7[pid])
endif
endif
set i=i+1
endloop
call WR7(g)
set p=null
set u=null
set g=null
endfunction
function SuijiMode_RestoreExisting takes nothing returns nothing
local integer i=0
local unit u=null
call SuijiMode_ApplyMissingHeroes()
loop
exitwhen i>$B
set u=M7[i]
if u!=null and GetUnitTypeId(u)!=0 then
if OO7(GetHandleId(u),"SuijiDone") then
call SuijiMode_UpdateLevels(u)
endif
endif
set i=i+1
endloop
set u=null
endfunction
function SuijiMode_TransformBaseSkill takes integer heroIndex,integer slot returns integer
if heroIndex<KL4 or heroIndex>K54 then
return 0
endif
if slot==1 then
return HM4[heroIndex]
elseif slot==2 then
return HN4[heroIndex]
elseif slot==3 then
return HO4[heroIndex]
elseif slot==4 then
return HP4[heroIndex]
elseif slot==5 then
return HQ4[heroIndex]
endif
return 0
endfunction
function SuijiMode_RestoreScriptedDragonForm takes unit u returns nothing
local integer h=0
local effect fx=null
if u==null then
return
endif
set h=GetHandleId(u)
if OO7(h,"SuijiScriptedDragonForm")==false then
return
endif
if SuijiMode_ScriptedFlightActive(h,3) then
call SuijiMode_EndScriptedFlight(u,3)
endif
if GetUnitTypeId(u)!=0 then
call SetUnitState(u,UNIT_STATE_ATTACK1_RANGE,ON7(h,"SuijiScriptedDragonBaseRange"))
call SetUnitAcquireRange(u,ON7(h,"SuijiScriptedDragonBaseAcquire"))
call UnitRemoveAbility(u,'ZDKM')
call UnitRemoveAbility(u,'ZDKA')
call UnitRemoveAbility(u,'ZDKF')
call UnitRemoveAbility(u,'ZDKS')
call UnitRemoveAbility(u,'A0O4')
endif
set fx=LoadEffectHandle(L7,h,StringHash("SuijiScriptedDragonEffect"))
if fx!=null then
call DestroyEffect(fx)
call RemoveSavedHandle(L7,h,StringHash("SuijiScriptedDragonEffect"))
endif
call NS7(h,"SuijiScriptedDragonForm",false)
call NP7(h,"SuijiScriptedDragonLevel",0)
set fx=null
endfunction
function SuijiMode_ApplyScriptedDragonForm takes unit u returns nothing
local integer h=0
local integer currentType=0
local integer level=0
local real remaining=0.
if u==null or GetUnitTypeId(u)==0 then
return
endif
set h=GetHandleId(u)
if OO7(h,"SuijiScriptedDragonForm")==false then
return
endif
set currentType=GetUnitTypeId(u)
if currentType!=OM7(h,"SuijiScriptedDragonUnitType") then
call NP7(h,"SuijiScriptedDragonUnitType",currentType)
call NQ7(h,"SuijiScriptedDragonBaseRange",GetUnitState(u,UNIT_STATE_ATTACK1_RANGE))
call NQ7(h,"SuijiScriptedDragonBaseAcquire",GetUnitAcquireRange(u))
endif
set level=GetUnitAbilityLevel(u,'Y0BE')
if SuijiMode_HasAghanimState(u) then
set level=level+1
endif
if level<1 then
set level=1
elseif level>4 then
set level=4
endif
call NP7(h,"SuijiScriptedDragonLevel",level)
if GetUnitAbilityLevel(u,'ZDKM')==0 then
call XF7(u,'ZDKM')
call UnitMakeAbilityPermanent(u,true,'ZDKM')
endif
if GetUnitAbilityLevel(u,'ZDKA')==0 then
call XF7(u,'ZDKA')
call UnitMakeAbilityPermanent(u,true,'ZDKA')
endif
if GetUnitAbilityLevel(u,'ZDKS')==0 then
call XF7(u,'ZDKS')
call UnitMakeAbilityPermanent(u,true,'ZDKS')
endif
call SetUnitAbilityLevel(u,'ZDKS',level)
if GetUnitAbilityLevel(u,'A0O4')==0 then
call XF7(u,'A0O4')
call UnitMakeAbilityPermanent(u,true,'A0O4')
call MHAbility_SetCustomDataInt(u,'A0O4',ABILITY_DEF_DATA_BUTTON_X,-11)
call MHAbility_SetCustomDataInt(u,'A0O4',ABILITY_DEF_DATA_BUTTON_Y,-11)
endif
if level>=3 then
if GetUnitAbilityLevel(u,'ZDKF')==0 then
call XF7(u,'ZDKF')
call UnitMakeAbilityPermanent(u,true,'ZDKF')
endif
else
call UnitRemoveAbility(u,'ZDKF')
endif
if level>=4 and SuijiMode_ScriptedFlightActive(h,3)==false then
set remaining=ON7(h,"SuijiScriptedDragonEnd")-TimerGetElapsed(W)
if remaining>.1 then
call SuijiMode_StartScriptedFlight(u,3,remaining)
endif
elseif level<4 and SuijiMode_ScriptedFlightActive(h,3) then
call SuijiMode_EndScriptedFlight(u,3)
endif
if ON7(h,"SuijiScriptedDragonBaseRange")<500. then
call SetUnitState(u,UNIT_STATE_ATTACK1_RANGE,500.)
else
call SetUnitState(u,UNIT_STATE_ATTACK1_RANGE,ON7(h,"SuijiScriptedDragonBaseRange"))
endif
if ON7(h,"SuijiScriptedDragonBaseAcquire")<800. then
call SetUnitAcquireRange(u,800.)
else
call SetUnitAcquireRange(u,ON7(h,"SuijiScriptedDragonBaseAcquire"))
endif
endfunction
function SuijiMode_ScriptedDragonFormTick takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer timerHandle=GetHandleId(t)
local unit u=LoadUnitHandle(L7,timerHandle,0)
local integer serial=LoadInteger(L7,timerHandle,1)
local integer h=0
if u==null or GetUnitTypeId(u)==0 then
call FlushChildHashtable(L7,timerHandle)
call PauseTimer(t)
call DestroyTimer(t)
set u=null
set t=null
return
endif
set h=GetHandleId(u)
if serial!=OM7(h,"SuijiScriptedDragonSerial") then
call FlushChildHashtable(L7,timerHandle)
call PauseTimer(t)
call DestroyTimer(t)
set u=null
set t=null
return
endif
if UnitAlive(u)==false or TimerGetElapsed(W)>=ON7(h,"SuijiScriptedDragonEnd") then
call SuijiMode_RestoreScriptedDragonForm(u)
call FlushChildHashtable(L7,timerHandle)
call PauseTimer(t)
call DestroyTimer(t)
else
call SuijiMode_ApplyScriptedDragonForm(u)
endif
set u=null
set t=null
endfunction
function SuijiMode_StartScriptedDragonForm takes unit u returns nothing
local integer h=0
local integer serial=0
local integer count=1
local real duration=40.
local timer t=null
local effect fx=null
if u==null or GetUnitTypeId(u)==0 then
return
endif
set h=GetHandleId(u)
if OO7(h,"SuijiScriptedDragonForm") then
call SuijiMode_RestoreScriptedDragonForm(u)
endif
set count=SuijiMode_GetDurationMulticastCount(u,'A03G')
if count<1 then
set count=1
endif
set duration=40.*count
set serial=OM7(h,"SuijiScriptedDragonSerial")+1
call NP7(h,"SuijiScriptedDragonSerial",serial)
call NP7(h,"SuijiScriptedDragonUnitType",0)
call NP7(h,"SuijiScriptedDragonLevel",0)
call NQ7(h,"SuijiScriptedDragonEnd",TimerGetElapsed(W)+duration)
call NS7(h,"SuijiScriptedDragonForm",true)
set fx=AddSpecialEffectTarget("Abilities\\Spells\\Orc\\FeralSpirit\\feralspirittarget.mdl",u,"origin")
call SaveEffectHandle(L7,h,StringHash("SuijiScriptedDragonEffect"),fx)
call SuijiMode_ApplyScriptedDragonForm(u)
set t=CreateTimer()
call SaveUnitHandle(L7,GetHandleId(t),0,u)
call SaveInteger(L7,GetHandleId(t),1,serial)
call TimerStart(t,.10,true,function SuijiMode_ScriptedDragonFormTick)
set fx=null
set t=null
endfunction
