call NT7(OB7,"Source",p5)
call NP7(OB7,"TargetIndex",TS7(m5))
call NP7(OB7,"DamageType",BL7)
call NQ7(OB7,"Damage",YM7*1.)
call TriggerRegisterTimerEvent(t,Z27,false)
call TriggerAddCondition(t,Condition(function B17))
set t=null
endfunction
