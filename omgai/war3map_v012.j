//魂之挽歌
function I78 takes nothing returns nothing
local trigger t
if SUIJI_NEVERMORE_REQUIEM_INIT_READY then
return
endif
set SUIJI_NEVERMORE_REQUIEM_INIT_READY=true
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function C3D))
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_CHANNEL)
call TriggerAddCondition(t,Condition(function C3DD))
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_CHANNEL)
call TriggerAddCondition(t,Condition(function HZWG_AI_PD))
call TriggerAddAction(t,function HZWG_AI)
set t=null
endfunction
function R7p takes nothing returns boolean
return IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(IN4))and GZZ(GetFilterUnit())
endfunction
function R7q takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit p5=LoadUnitHandle(L7,I97,0)
local group R7l=LoadGroupHandle(L7,I97,1)
local group g=WS7()
local unit BB7=LoadUnitHandle(L7,I97,5)
local integer c=GetTriggerEvalCount(t)+1
local unit u2
local boolexpr suijiRequiemScepterFilter=null
if p5==null or R7l==null or BB7==null or GetUnitTypeId(p5)==0 or GetUnitTypeId(BB7)==0 then
if R7l!=null then
call WR7(R7l)
endif
if BB7!=null and GetUnitTypeId(BB7)!=0 then
call RemoveUnit(BB7)
endif
call WR7(g)
call FlushChildHashtable(L7,I97)
call OZ7(t)
set t=null
set p5=null
set R7l=null
set g=null
set BB7=null
return false
endif
set IN4=p5
set suijiRequiemScepterFilter=Condition(function R7p)
call GroupEnumUnitsInRange(g,LoadReal(L7,I97,$A),LoadReal(L7,I97,$B),70*c,suijiRequiemScepterFilter)
call DestroyBoolExpr(suijiRequiemScepterFilter)
call GroupRemoveGroup(R7l,g)
loop
set u2=FirstOfGroup(g)
exitwhen u2==null
call GroupAddUnit(R7l,u2)
call SetUnitX(BB7,GetUnitX(u2))
call SetUnitY(BB7,GetUnitY(u2))
if GetOwningPlayer(u2)!=GetOwningPlayer(BB7)then
call SetUnitOwner(BB7,GetOwningPlayer(u2),false)
endif
call IssueTargetOrderById(BB7,$D00DD,u2)
call GroupRemoveUnit(g,u2)
endloop
call WR7(g)
if c>=$C then
call WR7(R7l)
if BB7!=null then
call RemoveUnit(BB7)
endif
call FlushChildHashtable(L7,I97)
call OZ7(t)
endif
set t=null
set p5=null
set R7l=null
set g=null
set BB7=null
set suijiRequiemScepterFilter=null
return false
endfunction
function R7r takes nothing returns nothing
local unit p5=GetTriggerUnit()
local unit BB7
local trigger t=null
local integer I97=0
local group R7l=null
if p5==null or GetUnitTypeId(p5)==0 then
set p5=null
return
endif
if SUIJI_MODE and SuijiMode_HasAghanimState(p5)==false then
set p5=null
return
endif
set t=CreateTrigger()
set I97=GetHandleId(t)
set R7l=WS7()
call TriggerRegisterTimerEvent(t,.1,true)
set BB7=CreateUnit(GetOwningPlayer(p5),'e00E',GetUnitX(p5),GetUnitY(p5),0)
call UnitApplyTimedLife(BB7,'BTLF',3.)
call SaveUnitHandle(L7,I97,0,p5)
call SaveUnitHandle(L7,I97,5,BB7)
call XF7(BB7,'A0HH')
if SUIJI_MODE then
call SetUnitAbilityLevel(BB7,'A0HH',B287_GetUnitAbilityLevel(p5,'A1MP'))
else
call SetUnitAbilityLevel(BB7,'A0HH',B287_GetUnitAbilityLevel(p5,'A29J')+B287_GetUnitAbilityLevel(p5,'A1MP'))
endif
call SaveGroupHandle(L7,I97,1,R7l)
call SaveReal(L7,I97,$A,GetUnitX(p5))
call SaveReal(L7,I97,$B,GetUnitY(p5))
call TriggerAddCondition(t,Condition(function R7q))
set t=null
set R7l=null
set BB7=null
set p5=null
endfunction
function C5D takes nothing returns nothing
local integer I97=GetHandleId(GetTriggeringTrigger())
local unit ZX7=IP4
local unit IH7=IN4
local integer C1D=GetUnitAbilityLevel(ZX7,'A0CQ')
local integer C2D
local integer BC7=B287_GetUnitAbilityLevel(ZX7,'A0BR')
if BC7==1 then
set C2D=15
elseif BC7==2 then
set C2D=22
elseif BC7==3 then
set C2D=29
else
set C2D=36
endif
set C2D=C2D+1
if IsUnitType(IH7,UNIT_TYPE_HERO)==false then
set C1D=C1D+1
else
set C1D=C1D+$A
endif
set C1D=IMinBJ(C2D,C1D)
call SetUnitAbilityLevel(ZX7,'A0CQ',C1D)
call SetUnitAbilityLevel(ZX7,'A4CE',C1D)
call SaveInteger(L7,(GetHandleId(ZX7)),(710),(C1D))
set ZX7=null
endfunction
function C_D takes nothing returns nothing
local integer C1D
local integer BC7
local integer C2D
local trigger t
local integer I97
local unit ZX7=GetKillingUnit()
local integer id=GetUnitTypeId(ZX7)
local integer linghun
if GetUnitTypeId(ZX7)=='e00C' then
set ZX7=M7[GetPlayerId(GetOwningPlayer(GetKillingUnit()))]
endif
set C1D=GetUnitAbilityLevel(ZX7,'A0CQ')
set BC7=B287_GetUnitAbilityLevel(ZX7,'A0BR')
if BC7==1 then
set C2D=15
elseif BC7==2 then
set C2D=22
elseif BC7==3 then
set C2D=29
else
set C2D=36
endif
if C1D<=C2D then
if id=='Zfir' or id=='Zgir' then
	set linghun='h1CR'
elseif id=='Zhir' then
	set linghun='h2CR'
else
	set linghun='h0CR'
endif
set t=ZF7(GetTriggerUnit(),ZX7,linghun,"C5D",500)
set I97=GetHandleId(t)
set t=null
call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\ZigguratMissile\\ZigguratMissile.mdl",GetUnitX(GetTriggerUnit()),GetUnitY(GetTriggerUnit())))
endif
set ZX7=null
endfunction
function L4D takes nothing returns nothing
local integer L7D=(LoadInteger(L7,(GetHandleId(GetTriggerUnit())),(710)))
call SaveInteger(L7,GetHandleId(GetTriggerUnit()),710,R2I(GetUnitAbilityLevel(GetTriggerUnit(),'A0CQ')*.5)+1)
call SetUnitAbilityLevel(GetTriggerUnit(),'A0CQ',R2I(GetUnitAbilityLevel(GetTriggerUnit(),'A0CQ')*.5)+1)
call SetUnitAbilityLevel(GetTriggerUnit(),'A4CE',R2I(GetUnitAbilityLevel(GetTriggerUnit(),'A4CE')*.5)+1)
call C6D(GetTriggerUnit(),L7D-(LoadInteger(L7,(GetHandleId(GetTriggerUnit())),(710))))
endfunction
function L4DD takes nothing returns nothing
local integer L7D=(LoadInteger(L7,(GetHandleId(GetTriggerUnit())),(710)))
local integer L7DD=R2I(GetUnitAbilityLevel(GetTriggerUnit(),'A0CQ')*.5)+1
call C6D(GetTriggerUnit(),L7D-L7DD)
endfunction
function L8D takes nothing returns boolean
if B287_GetUnitAbilityLevel(GetKillingUnit(),'A0BR')>0 and IsUnitIllusion(GetTriggerUnit())==false then
call C_D()
elseif B287_GetUnitAbilityLevel(M7[GetPlayerId(GetOwningPlayer(GetKillingUnit()))],'A0BR')>0 and GetUnitTypeId(GetKillingUnit())=='e00C' then
call C_D()
endif
if B287_GetUnitAbilityLevel(GetTriggerUnit(),'A0BR')>0 and IsUnitIllusion(GetTriggerUnit())==false and SuijiMode_HasAghanimState(GetTriggerUnit())==false then
call L4D()
elseif B287_GetUnitAbilityLevel(GetTriggerUnit(),'A0BR')>0 and IsUnitIllusion(GetTriggerUnit())==false and SuijiMode_HasAghanimState(GetTriggerUnit()) then
call L4DD()
endif
return false
endfunction
