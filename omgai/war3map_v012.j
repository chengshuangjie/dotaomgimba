function GetIllusionPhysicalDamageUnit takes unit W4I,real x,real y,real a returns unit
set HZHS=MHUnit_CreateIllusion(GetOwningPlayer(W4I),W4I,x,y)
call MHUnit_SetIllusionDamageDeal(HZHS,1)
call MHUnit_SetAtkDataInt(HZHS,UNIT_ATK_DATA_TARGET_ALLOW1,TARGET_ALLOW_HERO)
call XF7(HZHS,'A4D9')  //猴子猴孙攻击标识
call SaveUnitHandle(TABLE_XJ,(GetHandleId(HZHS)),('A4D9'),(W4I))
call XF7(HZHS,'Aloc')
call XF7(HZHS,'A04R')
call SetUnitPathing(HZHS,false)
return HZHS
endfunction
function WukongsCommand_Remove takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer HEI=GetHandleId(t)
local unit W4I=(LoadUnitHandle(TABLE_XJ,(HEI),(2)))
local real x=0.
local real y=0.
local real XZI=(LoadReal(TABLE_XJ,(HEI),(6)))
local real XVI=(LoadReal(TABLE_XJ,(HEI),(7)))
local real r=(LoadReal(TABLE_XJ,(HEI),(193)))
local integer H5I=GetTriggerEvalCount(t)
local integer ZXI
local integer ZYI
local unit N4I
local integer HaveA=(LoadInteger(TABLE_XJ,(HEI),(111)))
local boolean wukongsCommandCasterInvalid=false
if W4I==null then
set wukongsCommandCasterInvalid=true
elseif GetUnitTypeId(W4I)==0 then
set wukongsCommandCasterInvalid=true
else
set x=GetUnitX(W4I)
set y=GetUnitY(W4I)
endif
if wukongsCommandCasterInvalid or KF7(XZI,XVI,x,y)>=r or H5I>R2I(13/0.5) or GetTriggerEventId()==EVENT_UNIT_DEATH then
if wukongsCommandCasterInvalid==false then
call UnitRemoveAbility(W4I,'A4D6')
call UnitRemoveAbility(W4I,'A4D7')
call UnitRemoveAbility(W4I,'A4D8')
endif
call RemoveUnit(LoadUnitHandle(TABLE_XJ,(HEI),(232)))
if HaveA==1 then
set ZXI=1
set ZYI=21
else
set ZXI=1
set ZYI=14
endif
loop
exitwhen ZXI>ZYI
set N4I=(LoadUnitHandle(TABLE_XJ,(HEI),(200+ZXI)))
if N4I!=null then
call DestroyEffect((AddSpecialEffect("Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageDeathCaster.mdl",GetUnitX(N4I),GetUnitY(N4I))))
call DestroyEffect((AddSpecialEffect("tx\\qtds\\HeroMonkeyking_R_End.mdx",GetUnitX(N4I),GetUnitY(N4I))))
call DestroyEffect((LoadEffectHandle(TABLE_XJ,(GetHandleId(N4I)),(32))))
call DestroyEffect((LoadEffectHandle(TABLE_XJ,(GetHandleId(N4I)),(33))))
call RemoveUnit(N4I)
call FlushChildHashtable(TABLE_XJ,(GetHandleId(N4I)))
endif
set ZXI=ZXI+1
endloop
set N4I=(LoadUnitHandle(TABLE_XJ,(HEI),(222)))
if N4I !=null and XH7(N4I)==false then
call DestroyEffect((AddSpecialEffect("Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageDeathCaster.mdl",GetUnitX(N4I),GetUnitY(N4I))))
call DestroyEffect((AddSpecialEffect("tx\\qtds\\HeroMonkeyking_R_End.mdx",GetUnitX(N4I),GetUnitY(N4I))))
call DestroyEffect((LoadEffectHandle(TABLE_XJ,(HEI),(233))))
call RemoveSavedHandle(TABLE_XJ,(HEI),(233))
call RemoveUnit(N4I)
endif
call FlushChildHashtable(TABLE_XJ,(HEI))
call OZ7(t)
elseif H5I>=2 then
set N4I=(LoadUnitHandle(TABLE_XJ,(HEI),(222)))
if N4I !=null and XH7(N4I)==false then
call DestroyEffect((AddSpecialEffect("Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageDeathCaster.mdl",GetUnitX(N4I),GetUnitY(N4I))))
call DestroyEffect((AddSpecialEffect("tx\\qtds\\HeroMonkeyking_R_End.mdx",GetUnitX(N4I),GetUnitY(N4I))))
call DestroyEffect((LoadEffectHandle(TABLE_XJ,(HEI),(233))))
call RemoveSavedHandle(TABLE_XJ,(HEI),(233))
call RemoveUnit(N4I)
endif
endif
set t=null
set W4I=null
set N4I=null
return false
endfunction
function WukongsCommand_Move takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer HEI=GetHandleId(t)
local unit W4I=(LoadUnitHandle(TABLE_XJ,(HEI),(2)))
local real x=0.
local real y=0.
local real XZI=(LoadReal(TABLE_XJ,(HEI),(6)))
local real XVI=(LoadReal(TABLE_XJ,(HEI),(7)))
local real J7I=650*0.05
local real J8I=(LoadReal(TABLE_XJ,(HEI),(13)))
local real UWO=0.
local real J9I=0.
local real JAI=0.
local boolean wukongsCommandMoveInvalid=false
if W4I==null then
set wukongsCommandMoveInvalid=true
elseif GetUnitTypeId(W4I)==0 then
set wukongsCommandMoveInvalid=true
endif
if wukongsCommandMoveInvalid then
call FlushChildHashtable(TABLE_XJ,(HEI))
call OZ7(t)
set t=null
set W4I=null
return false
endif
set x=GetUnitX(W4I)
set y=GetUnitY(W4I)
set UWO=AngleBetweenXY(x,y,XZI,XVI)
set J9I=CoordinateX50(x+J7I*Cos(UWO*bj_DEGTORAD))
set JAI=CoordinateY50(y+J7I*Sin(UWO*bj_DEGTORAD))
call SetUnitX(W4I,J9I)
call SetUnitY(W4I,JAI)
call SetUnitFacing(W4I,J8I)
if KF7(XZI,XVI,J9I,JAI)<=J7I or XH7(W4I) then
call PauseUnit(W4I,false)
if GetUnitTypeId(W4I)=='Z052' or GetUnitTypeId(W4I)=='Z053' then
call SetUnitAnimationByIndex(W4I,5)
endif
call SetUnitMoveSpeed(W4I,0)
call SaveEffectHandle(TABLE_XJ,(GetHandleId(W4I)),(32),(AddSpecialEffectTarget("tx\\qtds\\HeroMonkeyking_R2_Smallcircle.mdl",W4I,"origin")))
call SaveReal(TABLE_XJ,(GetHandleId(W4I)),('face'),((J8I)*1.0))
call UnitRemoveAbility(W4I,'Amov')
call FlushChildHashtable(TABLE_XJ,(HEI))
call OZ7(t)
endif
set t=null
set W4I=null
return false
endfunction
function WukongsCommand_Summon takes unit N4I returns nothing
local trigger t=null
local integer HEI=0
local real x=0.
local real y=0.
local real UWO=0.
if N4I==null or GetUnitTypeId(N4I)==0 then
set N4I=null
return
endif
set t=CreateTrigger()
set HEI=GetHandleId(t)
set x=LoadReal(TABLE_XJ,(GetHandleId(N4I)),(6))
set y=LoadReal(TABLE_XJ,(GetHandleId(N4I)),(7))
set UWO=LoadReal(TABLE_XJ,(GetHandleId(N4I)),(13))
call SaveEffectHandle(TABLE_XJ,(GetHandleId(N4I)),(33),(AddSpecialEffectTarget("tx\\qtds\\HeroMonkeyking_W4_Ribbon.MDX",N4I,"chest")))
call SetUnitVertexColor(N4I,150,150,150,153)
call PauseUnit(N4I,true)
call SetUnitAnimationByIndex(N4I,7)
call SaveUnitHandle(TABLE_XJ,(HEI),(2),(N4I))
call SaveReal(TABLE_XJ,(HEI),(6),(CoordinateX50(x)*1.0))
call SaveReal(TABLE_XJ,(HEI),(7),(CoordinateY50(y)*1.0))
call SaveReal(TABLE_XJ,(HEI),(13),((UWO)*1.0))
call TriggerRegisterTimerEvent(t,0.05,true)
call TriggerAddCondition(t,Condition(function WukongsCommand_Move))
set t=null
endfunction
function WukongsCommand_Main takes nothing returns nothing
local unit W4I=GetTriggerUnit()
local real x0=GetSpellTargetX()
local real y0=GetSpellTargetY()
local unit N4I
local integer V6I=0
local trigger t=null
local integer HEI=0
local integer ZXI
local integer ZYI
local real r=650
local real d
local real x
local real y
local unit u
local integer HaveA=0
if W4I==null or GetUnitTypeId(W4I)==0 then
set W4I=null
return
endif
set V6I=SuijiMode_GetPairCastLevel(W4I,B287_GetSpellAbilityId(),'A4CR','A4DA')
if V6I<=0 then
set W4I=null
return
endif
set t=CreateTrigger()
set HEI=GetHandleId(t)
if V6I==1 then
call XF7(W4I,'A4D6')
elseif V6I==2 then
call XF7(W4I,'A4D7')
elseif V6I==3 then
call XF7(W4I,'A4D8')
endif
set u=CreateUnit(GetOwningPlayer(W4I),'h0GP',x0,y0,270)
call XF7(u,'Aloc')
call XF7(u,'A04R')
call SetUnitPathing(u,false)
set ZXI=1
set ZYI=5
loop
exitwhen ZXI>ZYI
set d=ZXI/I2R(5)*360.0
set x=x0+300*Cos(d*bj_DEGTORAD)
set y=y0+300*Sin(d*bj_DEGTORAD)
set N4I=GetIllusionPhysicalDamageUnit(W4I,x0,y0,AngleBetweenXY(x0,y0,x,y))
call SaveReal(TABLE_XJ,(GetHandleId(N4I)),(6),(x)*1.0)
call SaveReal(TABLE_XJ,(GetHandleId(N4I)),(7),(y)*1.0)
call SaveReal(TABLE_XJ,(GetHandleId(N4I)),(13),(AngleBetweenXY(x0,y0,x,y)*1.0))
call SaveUnitHandle(TABLE_XJ,(HEI),(200+ZXI),(N4I))
call WukongsCommand_Summon(N4I)
set ZXI=ZXI+1
endloop
set ZXI=1
set ZYI=9
loop
exitwhen ZXI>ZYI
set d=ZXI/I2R(9)*360.0
set x=x0+650*Cos(d*bj_DEGTORAD)
set y=y0+650*Sin(d*bj_DEGTORAD)
set N4I=GetIllusionPhysicalDamageUnit(W4I,x0,y0,AngleBetweenXY(x0,y0,x,y))
call SaveReal(TABLE_XJ,(GetHandleId(N4I)),(6),(x)*1.0)
call SaveReal(TABLE_XJ,(GetHandleId(N4I)),(7),(y)*1.0)
call SaveReal(TABLE_XJ,(GetHandleId(N4I)),(13),(AngleBetweenXY(x0,y0,x,y)*1.0))
call SaveUnitHandle(TABLE_XJ,(HEI),(205+ZXI),(N4I))
call WukongsCommand_Summon(N4I)
set ZXI=ZXI+1
endloop
if SuijiMode_HasAghanimState(W4I) then
set HaveA=1
set r=1100
call SetUnitScale(u,1.46,1.46,1.46)
set ZXI=1
set ZYI=7
loop
exitwhen ZXI>ZYI
set d=ZXI/I2R(7)*360.0
set x=x0+1100*Cos(d*bj_DEGTORAD)
set y=y0+1100*Sin(d*bj_DEGTORAD)
set N4I=GetIllusionPhysicalDamageUnit(W4I,x0,y0,AngleBetweenXY(x0,y0,x,y))
call SaveReal(TABLE_XJ,(GetHandleId(N4I)),(6),(x)*1.0)
call SaveReal(TABLE_XJ,(GetHandleId(N4I)),(7),(y)*1.0)
call SaveReal(TABLE_XJ,(GetHandleId(N4I)),(13),(AngleBetweenXY(x0,y0,x,y)*1.0))
call SaveUnitHandle(TABLE_XJ,(HEI),(214+ZXI),(N4I))
call WukongsCommand_Summon(N4I)
set ZXI=ZXI+1
endloop
endif
if GetUnitTypeId(W4I)=='Z052' then
call SetUnitAnimationByIndex(W4I,3)
endif
set N4I=CreateUnit(GetOwningPlayer(W4I),'Z053',x0,y0,GetUnitFacing(W4I))
call SetUnitAnimationByIndex(N4I,3)
call SaveEffectHandle(TABLE_XJ,(HEI),(233),(AddSpecialEffectTarget("tx\\qtds\\HeroMonkeyking_R3_Gather.mdl",N4I,"origin")))
call XF7(N4I,'Aloc')
call XF7(N4I,'A04R')
call PauseUnit(N4I,true)
call SetUnitPathing(N4I,false)
call SetUnitX(N4I,x0)
call SetUnitY(N4I,y0)
call DestroyEffect((AddSpecialEffect("Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageCaster.mdl",GetUnitX(W4I),GetUnitY(W4I))))
call SaveUnitHandle(TABLE_XJ,(HEI),(2),(W4I))
call SaveUnitHandle(TABLE_XJ,(HEI),(222),(N4I))
call SaveUnitHandle(TABLE_XJ,(HEI),(232),(u))
call SaveReal(TABLE_XJ,(HEI),(6),((x0)*1.0))
call SaveReal(TABLE_XJ,(HEI),(7),((y0)*1.0))
call SaveReal(TABLE_XJ,(HEI),(193),((r)*1.0))
call SaveInteger(TABLE_XJ,(HEI),(111),((HaveA)))
call TriggerRegisterTimerEvent(t,0.5,true)
call TriggerRegisterUnitEvent(t,W4I,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function WukongsCommand_Remove))
set W4I=null
set N4I=null
set t=null
set u=null
endfunction
function WukongsCommand_Cast takes nothing returns boolean
if B287_GetSpellAbilityId()=='A4CR' or B287_GetSpellAbilityId()=='A4DA' then
call WukongsCommand_Main()
endif
return false
endfunction
