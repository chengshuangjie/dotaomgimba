function KVF_Range takes unit j5,unit m5,real d returns boolean //j5离m5距离d
local integer n
local boolean jR=false
local location b5=null
if(Q77(m5))then
return false
endif
if IsUnitInRange(j5,m5,200.) then
return false
endif
set n=Get_Tiaodao(j5)
if n>=0 then
    // call UnitUseItemPoint(j5,UnitItemInSlot(j5,n),GetUnitX(m5),GetUnitY(m5))
	set b5=kk(j5,RMaxBJ(KE7(j5,m5)-d,300),m5)
	if b5!=null then
		call UnitUseItemPointLoc(j5,UnitItemInSlot(j5,n),b5)
	else
		call UnitUseItemPoint(j5,UnitItemInSlot(j5,n),GetUnitX(m5),GetUnitY(m5))
	endif
    set jR=true
	set b5=null
endif
return jR
endfunction
