        function OMGAIBehaviors_OMGAI_ThinkWard takes unit u returns nothing
        local integer hid = GetHandleId(u)
        local real now = OMGAICore_OMGAI_GetGameTime()
        local real last = OMGAICore_OMGAI_LoadReal(hid, 98)
        local unit ward = null
        if now - last < 60.0 then
            return
        endif
        call OMGAICore_OMGAI_SaveReal(hid, 98, now)
        // ï¿½æ·´ï¿½Û£ï¿½ï¿½ï¿½ï¿½È¶ï¿½ï¿½ï¿½ 92 ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½Ê§Ð§ï¿½ò¶µµï¿½É¨ï¿½ï¿½
        set ward = OMGAICore_OMGAI_LoadUnitHandle(hid, 92)
        if ward == null or not (not IsUnitType(ward, UNIT_TYPE_DEAD) and GetWidgetLife(ward) > 0.405) or not IsUnitEnemy(ward, GetOwningPlayer(u)) then
            set ward = OMGAIStrategy_OMGAI_GetWardToDeWard(u)
        endif
        if ward != null then
            call IssueTargetOrder(u, "smart", ward)
            call OMGAILog_LOG_WARN("WARD", "ï¿½ï¿½ï¿½Û£ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½Ð·ï¿½ï¿½ï¿½ï¿½ï¿½ type=" + I2S(GetUnitTypeId(ward)))
        endif
        call OMGAILog_LOG_WARN("WARD", "ï¿½ï¿½Ò°ï¿½ï¿½ï¿½Ú£ï¿½ï¿½ï¿½ï¿½ï¿½/ï¿½ï¿½ï¿½ï¿½Ñ²ï¿½ï¿½")
    endfunction

//---------------------------------------------------------------------------
// 9. v0.9 ¸¨ÖúÕ½Êõ¶¯×÷£¨¿ªÎí±Æ½ü / Õ½ÂÔÑÛÎ» / ³ö×°Òýµ¼£©
//    ÓÉ Dispatcher TickUnit µÄ OMGAI_BehaviorsAuxTick µ÷ÓÃ£¬²»ÇÀÕ¼Ö÷ÐÐÎª
//---------------------------------------------------------------------------

    // ¿ªÎí±Æ½ü£ºÓÐÃëÉ±Ä¿±êÇÒÄ¿±ê²»¿É¼û -> Ö÷¶¯±Æ½ü£¨¾ºÈü¼¶×¥ÈËÒâÊ¶£©
    function OMGAIBehaviors_OMGAI_ThinkSmoke takes unit u returns nothing
        local unit target = OMGAICore_OMGAI_LoadUnitHandle(GetHandleId(u), 94)
        local integer hid = GetHandleId(u)
        local real now = OMGAICore_OMGAI_GetGameTime()
        local real last = OMGAICore_OMGAI_LoadReal(hid, 100)
        if target == null then
            return
        endif
        if now - last < 4.0 then
            return
        endif
        call OMGAICore_OMGAI_SaveReal(hid, 100, now)
        if not IsUnitVisible(target, GetOwningPlayer(u)) then
            call IssuePointOrder(u, "move", GetUnitX(target), GetUnitY(target))
            call OMGAILog_LOG_WARN("SMOKE", "SMOKE approach target=" + I2S(GetUnitTypeId(target)))
        endif
        set target = null
    endfunction

    // Õ½ÂÔÑÛÎ»Õ¾¸Ú£º¸¨Öú½ÇÉ«¶¨ÆÚÈ¥ºÓµÀ¹Ø¼üµãÕ¾¸Ú£¨ÊÓÒ°²¹Î»£¬²åÑÛÎïÆ·¶Ô½ÓÇ°ÖÃ£©
    function OMGAIBehaviors_OMGAI_ThinkWardPlace takes unit u returns nothing
        local integer hid = GetHandleId(u)
        local integer role = OMGAICore_OMGAI_LoadInt(hid, 86)
        local real now = OMGAICore_OMGAI_GetGameTime()
        local real last = OMGAICore_OMGAI_LoadReal(hid, 101)
        local real wx = 0.0
        local real wy = 0.0
        local rect world = GetWorldBounds()
        if role != 3 and role != 4 then
            return
        endif
        if now - last < 90.0 then
            return
        endif
        call OMGAICore_OMGAI_SaveReal(hid, 101, now)
        set wx = GetRectCenterX(world)
        set wy = GetRectCenterY(world)
        call IssuePointOrder(u, "move", wx, wy)
        call OMGAILog_LOG_WARN("WARD", "WARD post x=" + R2S(wx) + " y=" + R2S(wy))
        set world = null
    endfunction

    // ³ö×°Òýµ¼£º°´ CounterBuild Á÷ÅÉ½á¹ûÊä³öÕë¶Ô³ö×°½¨Òé£¨¹ºÂòÏµÍ³¶Ô½ÓÇ°ÖÃ£©
    function OMGAIBehaviors_OMGAI_BuyGuide takes unit u returns nothing
        local integer hid = GetHandleId(u)
        local integer cb = OMGAIStrategy_OMGAI_CounterBuild(u)
        local real now = OMGAICore_OMGAI_GetGameTime()
        local real last = OMGAICore_OMGAI_LoadReal(hid, 102)
        if now - last < 60.0 then
            return
        endif
        call OMGAICore_OMGAI_SaveReal(hid, 102, now)
        if cb == 1 then
            call OMGAILog_LOG_WARN("BUY", "BUY counter physical armor")
        elseif cb == 2 then
            call OMGAILog_LOG_WARN("BUY", "BUY counter magic resist")
        else
            call OMGAILog_LOG_WARN("BUY", "BUY balanced core build")
        endif
    endfunction

    // ¸¨Öú¶¯×÷¾ÛºÏ£¨ÓÉ Dispatcher TickUnit µ÷ÓÃ£©
    function OMGAIBehaviors_OMGAI_BehaviorsAuxTick takes unit u returns nothing
        call OMGAIBehaviors_OMGAI_ThinkSmoke(u)
        call OMGAIBehaviors_OMGAI_ThinkWardPlace(u)
        call OMGAIBehaviors_OMGAI_BuyGuide(u)
    endfunction

//---------------------------------------------------------------------------
// 8. ï¿½ï¿½ï¿½ï¿½
//---------------------------------------------------------------------------


    function OMGAIBehaviors_OMGAI_BehaviorsInit takes nothing returns nothing
        call OMGAILog_LOG_INFO("BEH", "OMGAIBehaviors ï¿½ï¿½Ê¼ï¿½ï¿½ï¿½ï¿½ï¿½")
    endfunction


//library OMGAIBehaviors ends
//library OMGAIDispatcher:

//---------------------------------------------------------------------------
// 1. 行为派发表（behaviorId → desire/think，函数来自 OMGAIBehaviors.j）
//---------------------------------------------------------------------------

    function OMGAIDispatcher___OMGAI_DispatchDesire takes integer b, unit u returns real
        if b == BEH_FARM then
            return OMGAIBehaviors_OMGAI_DesireFarm(u)
        elseif b == BEH_JUNGLE then
            return OMGAIBehaviors_OMGAI_DesireJungle(u)
        elseif b == BEH_GANK then
            return OMGAIBehaviors_OMGAI_DesireGank(u)
        elseif b == BEH_PUSH then
            return OMGAIBehaviors_OMGAI_DesirePush(u)
        elseif b == BEH_DEFEND then
            return OMGAIBehaviors_OMGAI_DesireDefend(u)
        elseif b == BEH_TEAM then
            return OMGAIBehaviors_OMGAI_DesireTeam(u)
        elseif b == BEH_RETREAT then
            return OMGAIBehaviors_OMGAI_DesireRetreat(u)
        elseif b == BEH_WARD then
            return OMGAIBehaviors_OMGAI_DesireWard(u)
        endif
        return 0.0
    endfunction

    function OMGAIDispatcher___OMGAI_DispatchThink takes integer b, unit u returns nothing
        if b == BEH_FARM then
            call OMGAIBehaviors_OMGAI_ThinkFarm(u)
        elseif b == BEH_JUNGLE then
            call OMGAIBehaviors_OMGAI_ThinkJungle(u)
        elseif b == BEH_GANK then
            call OMGAIBehaviors_OMGAI_ThinkGank(u)
        elseif b == BEH_PUSH then
            call OMGAIBehaviors_OMGAI_ThinkPush(u)
        elseif b == BEH_DEFEND then
            call OMGAIBehaviors_OMGAI_ThinkDefend(u)
        elseif b == BEH_TEAM then
            call OMGAIBehaviors_OMGAI_ThinkTeam(u)
        elseif b == BEH_RETREAT then
            call OMGAIBehaviors_OMGAI_ThinkRetreat(u)
        elseif b == BEH_WARD then
            call OMGAIBehaviors_OMGAI_ThinkWard(u)
        endif
    endfunction

//---------------------------------------------------------------------------
// 3. 硬规则状态机（死亡/回家/买活/集结/掉线接管）---- 高优短路
//    对应方案 §5.3
//---------------------------------------------------------------------------

    function OMGAIDispatcher___OMGAI_HardState takes unit u returns integer
        local integer hid = GetHandleId(u)
        // 死亡
        if not (not IsUnitType(u, UNIT_TYPE_DEAD) and GetWidgetLife(u) > 0.405) then
            return ST_DEAD
        endif
        // 掉线接管（由外部标记，槽 70）
        if OMGAICore_OMGAI_LoadBool(hid, 70) then
            return ST_TAKEOVER
        endif
        // 集结等待（复活后 8s 内，由外部设置，槽 71）
        if OMGAICore_OMGAI_LoadBool(hid, 71) then
            return ST_ASSEMBLE
        endif
        // 回家补给（血 < 25% 或 蓝 < 15%，无战斗）
        // TODO: 战斗状态判断（OMGAIEnemyState 提供）
        if GetUnitState(u, UNIT_STATE_LIFE) < GetUnitState(u, UNIT_STATE_MAX_LIFE) * 0.25 then
            return ST_HOME
        endif
        // 买活（死亡且队友团战，由外部决定，槽 72）
        if OMGAICore_OMGAI_LoadBool(hid, 72) then
            return ST_BUYBACK
        endif
        return 0
    endfunction

    function OMGAIDispatcher___OMGAI_RunHardState takes unit u, integer st returns nothing
        if st == ST_HOME then
            // 回泉水
            // TODO: 寻路到己方泉水坐标（OMGAIConfig 提供）
            call OMGAILog_LOG_INFO("DISP", "回家补给")
        elseif st == ST_ASSEMBLE then
            // 等队友到齐（集合点坐标）
            // TODO: 集结逻辑（队友到位后清标记）
            call OMGAILog_LOG_INFO("DISP", "集结等待")
        elseif st == ST_TAKEOVER then
            // 掉线接管：正常 AI 逻辑但装备锁定（由 SpellCast 检查）
            // TODO(骨架): 接管单位触发完整 tick（解除循环依赖，后续用事件/队列接入）
        elseif st == ST_BUYBACK then
            // TODO: 买活并回战场
            call OMGAICore_OMGAI_SaveBool(GetHandleId(u), 72, false)
        endif
    endfunction

//---------------------------------------------------------------------------
// 4. desire 竞选器（核心，方案 §5.2）
//---------------------------------------------------------------------------

    function OMGAIDispatcher___OMGAI_SelectBehavior takes unit u returns nothing
        local integer hid = GetHandleId(u)
        local integer b = 0
        local integer best = 0
        local real maxD = 0.0
        local real d = 0.0
        local real curD = 0.0
        local real now = 0.0

        // 遍历 8 个行为取 max
        set b = BEH_FARM
        loop
            set d = OMGAIDispatcher___OMGAI_DispatchDesire(b, u)
            if d > maxD then
                set maxD = d
                set best = b
            endif
            set b = b + 1
            exitwhen b > BEH_WARD
        endloop

        // 防抖：当前行为 desire 高于新 max×0.85 且距切换 < 0.8s → 保持
        set curD = OMGAICore_OMGAI_LoadReal(hid, 1)
        set now = OMGAICore_OMGAI_GetGameTime()
        if OMGAICore_OMGAI_LoadInt(hid, 0) > 0 then
            if curD >= maxD * (1.0 - DESIRE_HYSTERESIS) and (now - OMGAICore_OMGAI_LoadReal(hid, 2)) < BEHAVIOR_MIN_HOLD then
                return
            endif
        endif

        // 切换行为
        call OMGAICore_OMGAI_SaveInt(hid, 0, best)
        call OMGAICore_OMGAI_SaveReal(hid, 1, maxD)
        call OMGAICore_OMGAI_SaveReal(hid, 2, now)
        call OMGAILog_LOG_DEBUG("DISP", "行为切换 → " + I2S(best) + " desire=" + R2S(maxD))
    endfunction

    function OMGAIDispatcher___OMGAI_AntiIdle takes unit u returns nothing
        local integer hid = GetHandleId(u)
        local real now = OMGAICore_OMGAI_GetGameTime()
        // GetUnitCurrentOrder 为 0 = idle
        if GetUnitCurrentOrder(u) == 0 then
            // 距上次空闲开始
            if OMGAICore_OMGAI_LoadReal(hid, 3) == 0.0 then
                call OMGAICore_OMGAI_SaveReal(hid, 3, now)
            endif
            if now - OMGAICore_OMGAI_LoadReal(hid, 3) > IDLE_TIMEOUT then
                call OMGAILog_LOG_WARN("DISP", "发呆超时，强制换行为")
                // 强制切到对线/跟随（BEH_FARM）
                call OMGAICore_OMGAI_SaveInt(hid, 0, BEH_FARM)
                call OMGAICore_OMGAI_SaveReal(hid, 3, 0.0)
            endif
        else
            call OMGAICore_OMGAI_SaveReal(hid, 3, 0.0)
        endif
    endfunction

//---------------------------------------------------------------------------
// 6. 心跳主循环（方案 §5.1）
//---------------------------------------------------------------------------

    function OMGAIDispatcher___OMGAI_TickUnit takes unit u returns nothing
        local integer hid = GetHandleId(u)
        local integer st = 0
        if not (not IsUnitType(u, UNIT_TYPE_DEAD) and GetWidgetLife(u) > 0.405) then
            return
        endif
        set st = OMGAIDispatcher___OMGAI_HardState(u)
        if st != 0 then
            call OMGAIDispatcher___OMGAI_RunHardState(u, st)
        else
            // V2: 战术层周期（秒杀目标/蹲守/团战标记，2s 节流在 StrategyTick 内部）
            call OMGAIStrategy_OMGAI_StrategyTick(u)
            call OMGAIDispatcher___OMGAI_AntiIdle(u)
            call OMGAIDispatcher___OMGAI_SelectBehavior(u)
            call OMGAIDispatcher___OMGAI_DispatchThink(OMGAICore_OMGAI_LoadInt(hid, 0), u)
            call OMGAIBehaviors_OMGAI_BehaviorsAuxTick(u)
        endif
    endfunction

    function OMGAIDispatcher___OMGAI_Tick takes unit u returns nothing
        call OMGAIDispatcher___OMGAI_TickUnit(u)
    endfunction

    // 全局 tick（注册单位循环）
    function OMGAIDispatcher___OMGAI_TickAll takes nothing returns nothing
        local integer i = 0
        local unit u = null
        loop
            exitwhen i >= MAX_AI_UNITS
            set u = OMGAICore_OMGAICore_GetUnitTable(i)
            if u != null then
                // V2.1：每 5 tick 崩溃防护巡检（简化：每单位每 tick 调一次）
                if ModuloInteger(i, 5) == 0 then
                    call OMGAIGuard_OMGAI_GuardInspect(u)
                endif
                call OMGAIDispatcher___OMGAI_TickUnit(u)
            endif
            set i = i + 1
        endloop
        // 全局巡检（低频）
        call OMGAIGuard_OMGAI_GuardGlobalInspect()
        set u = null
    endfunction

//---------------------------------------------------------------------------
// 7. 初始化（地图初始化时调用；注册心跳 timer）
//---------------------------------------------------------------------------

    function OMGAIDispatcher_OMGAIDispatcher_Init takes nothing returns nothing
        call OMGAICore_OMGAICore_Init()
        set TICK_TIMER = CreateTimer()
        call TimerStart(TICK_TIMER, AI_TICK_INTERVAL, true, function OMGAIDispatcher___OMGAI_TickAll)
        call OMGAILog_LOG_INFO("DISP", "OMGAIDispatcher 心跳启动 tick=" + R2S(AI_TICK_INTERVAL))
    endfunction

    // 外部：注册一个 AI 单位
    function OMGAIDispatcher_OMGAIDispatcher_RegisterAIUnit takes unit u returns nothing
        if u == null then
            return
        endif
        call OMGAICore_OMGAICore_RegisterUnit(u)
        call OMGAICore_OMGAI_SaveReal(GetHandleId(u), 2, 0.0) // switchTime 初始化
        call OMGAILog_LOG_INFO("DISP", "注册 AI 单位: " + I2S(GetHandleId(u)))
    endfunction


//library OMGAIDispatcher ends
//library OMGAISuperAIInit:

//---------------------------------------------------------------------------
// 统一初始化（地图初始化时调用一次）
//   [可选] OMGAI_InitAllEx(boolean enableLearning) 可关自学习（测试期）
//---------------------------------------------------------------------------

    function OMGAISuperAIInit_OMGAI_InitAll takes nothing returns nothing
        // 1) 核心数据（最优先）
        call OMGAICore_OMGAICore_Init()
        // 2) 日志（其余库打日志依赖它）
        call OMGAILog_OMGAILog_Init()
        call OMGAILog_OMGAILog_InitCache()
        // V2.3: 游戏内查日志指令（-omgai_log）
        call OMGAILog_OMGAILog_ChatCommandInit()
        // 3) 崩溃防护（P9 自检：失败则降档，但继续初始化，保证单局不崩全场）
        call OMGAIGuard_OMGAI_GuardInit()
        // 4) 数据/执行层
        call OMGAIActionMask_OMGAI_MaskInit()
        call OMGAITargetSel_OMGAI_TargetSelInit()
        call OMGAISpellCast_OMGAI_SpellCastInit()
        // 5) 感知层
        call OMGAIEnemyState_OMGAI_EnemyStateInit()
        // 6) 行为层
        call OMGAIBehaviors_OMGAI_BehaviorsInit()
        // 7) 战术意识层（V2.2 新增：流派/定位/秒人/蹲人/视野）
        call OMGAIStrategy_OMGAIStrategy_Init()
        // 8) 自学习（可选开关）
        call OMGAILearn_OMGAI_LearnInit()
        // 9) 调度器（最后：启动心跳）
        call OMGAIDispatcher_OMGAIDispatcher_Init()
        // 10) 必崩图自检（P9）：失败 → 本局 AI 降档保局
        if not OMGAIGuard_OMGAI_GuardSelfCheck() then
            call OMGAIGuard_OMGAI_GuardDegrade()
        endif
    endfunction

//---------------------------------------------------------------------------
// 注册一名 AI 英雄（地图生成 AI 英雄/掉线接管时调用）
//   注册后立即做战术初始化（流派识别 + 团战定位）
//---------------------------------------------------------------------------

    function OMGAISuperAIInit_OMGAI_AddHero takes unit u returns nothing
        call OMGAIDispatcher_OMGAIDispatcher_RegisterAIUnit(u)
        call OMGAIStrategy_OMGAI_StrategyInitHero(u)
    endfunction


//library OMGAISuperAIInit ends
// ===== OMGAI_Config.j =====
// ===========================================================================
// OMGAIConfig.j
// ---------------------------------------------------------------------------
// DOTA1 OMG AI 地图 - 全局配置常量
// 技术方案 T01 基础设施 - 配置层（数据驱动基础）
// ---------------------------------------------------------------------------
// 说明：
//   * 所有 OMGAI 模块用 OMGAI_ 前缀避免与 vcccv 现有库冲突
//   * 本文件只定义常量，不含运行时逻辑
//   * 修改行为改这里，不改业务代码（数据驱动原则）
// ===========================================================================
// ===== OMGAI_Globals.j =====
// ===========================================================================
// OMGAIGlobals.j
// ---------------------------------------------------------------------------
// DOTA1 OMG AI 地图 - 全局变量（运行时状态）
// 技术方案 T01 基础设施
// ---------------------------------------------------------------------------
// 设计原则：
//   * vcccv 现有 war3map.j 已有大量全局（PlayerSkillIndices 等），不修改其结构
//   * 本文件仅放 OMGAI 新增的运行时句柄与计数器
//   * 模块内的 struct 实例放 struct 内部，不放此处
// ===========================================================================
// ===== OMGAI_Logger.j =====
// ===========================================================================
// OMGAILogger.j
// ---------------------------------------------------------------------------
// DOTA1 OMG AI 地图 - 日志与崩溃上报接口
// 技术方案 T01 基础设施
// ---------------------------------------------------------------------------
// 功能：
//   * 开发期： BJDebugMsg 屏幕实时打印 + 写入日志环形缓冲
//   * P2：崩溃日志上报（KKAPI 服务端 / Preload 文件兜底）
//   * 等级：DEBUG / INFO / WARN / ERROR / FATAL
//   * 防爆：ERROR 累计上限 50 条触发降级（仅 FATAL 通过屏幕）
// ===========================================================================
// ===== OMGAI_EventDispatcher.j =====
// ===========================================================================
// OMGAIEventDispatcher.j
// ---------------------------------------------------------------------------
// DOTA1 OMG AI 地图 - 内部事件总线
// 技术方案 T01 基础设施
// ---------------------------------------------------------------------------
// 设计：
//   * 用 trigger 数组按事件类型注册（OMGAI_EventTriggers[OMGAI_EVT_*]）
//   * fireEvent 触发对应 trigger，把 payload 通过全局变量传递
//   * payload 用 OMGAI_EvtPayload* 全局变量传值（vJASS 限制：trigger 不能带参）
//   * 注册与触发均线程安全（JASS 单线程，无需锁）
// ===========================================================================
// ===== OMGAI_TimerService.j =====
// ===========================================================================
// OMGAITimerService.j
// ---------------------------------------------------------------------------
// DOTA1 OMG AI 地图 - 主心跳定时器服务
// 技术方案 T01 基础设施
// ---------------------------------------------------------------------------
// 功能：
//   * 0.1s 周期全局心跳（OMGAI_MainTimer）
//   * 周期性触发 OMGAI_EVT_AI_HEARTBEAT 事件给 AI 控制器
//   * 周期任务注册（最多 32 个，timer -> trigger 映射执行回调）
//   * AI Watchdog 周期检查（每 tick 检查 AI 心跳超时）
// 注意：YDWE pjass 禁止 code 数组/参数，故周期回调用 trigger + TriggerEvaluate
// ===========================================================================

// ===== OMGAI_PlatformFactory.j =====
// ===========================================================================
// OMGAIPlatformFactory.j
// ---------------------------------------------------------------------------
// DOTA1 OMG AI 地图 - 平台检测与抽象层入口
// 技术方案 T01 基础设施 / T03 平台抽象层
// ---------------------------------------------------------------------------
// 设计：
//   * 运行时探测 KKAPI 是否可用
//   * 探测成功 → 调用 OMGAIKKPlatformAPI.Install 注册 KK 实现
//   * 探测失败 → 调用 OMGAIPlatform11API.Install 注册 11 降级实现
// ===========================================================================
// ===== OMGAI_Init.j =====
// ===========================================================================
// OMGAIInit.j
// ---------------------------------------------------------------------------
// DOTA1 OMG AI 地图 - 模块初始化入口
// 技术方案 T01 基础设施
// ---------------------------------------------------------------------------
// 调用顺序（依赖关系）：
//   1) OMGAIPlatformFactory.Init     - 平台探测（无依赖）
//   2) OMGAITimerService.Init        - 主心跳（依赖 Logger + EventDispatcher）
//   3) 后续 T02-T05 的子模块 Init 由各模块的 initializer 自行触发
// ---------------------------------------------------------------------------
// 接入主入口：
//   由 war3map.j 的某个 init trigger 在地图加载时调用 OMGAIInit.Initialize
//   或通过 YDWE 的 initializer 机制自动调用（推荐）
// ===========================================================================
// ===== OMGAI_SkillTag.j =====
// ===========================================================================
// OMGAISkillTag.j
// ---------------------------------------------------------------------------
// DOTA1 OMG AI 地图 - 技能标签枚举与位掩码
// 技术方案 T02 技能系统 / PRD 4.3.2 SkillDef AI 标签字段
// ---------------------------------------------------------------------------
// 用途：
//   * 为每个技能打标签，AI 运行时读取标签生成 SkillProfile
//   * SkillDef.tags 用位掩码 OR 组合多个标签
//   * 例：标签 = STAG_BURST_HIGH or STAG_CONTROL_STUN or STAG_PASSIVE
// 设计：
//   * 用全局整数常量代替 enum（vJASS enum 走 array 不便 OR）
//   * 每个标签是 2 的整数次幂，最多 32 位
// ===========================================================================
// ===== OMGAI_SkillTable.j =====
// ===========================================================================
// OMGAI_SkillTable.j -- 基图 OMG 技能池全集常量表（自动生成，勿手改）
//   来源：基图 war3map.j HM4/HN4/HO4/HP4/HQ4 技能池（随机OMG模式 -suiji）
//   用途：英雄实际技能枚举（GetUnitAbility 匹配）+ 流派识别数据源
//   生成时间：2026-10-16
// ===========================================================================

// ===== OMGAI_ConflictRule.j =====
// ===========================================================================
// OMGAIConflictRule.j
// ---------------------------------------------------------------------------
// DOTA1 OMG AI 地图 - 技能冲突规则定义
// 技术方案 T02 技能系统 / PRD 4.4 技能冲突规则
// ---------------------------------------------------------------------------
// 借鉴竞品踩坑（PRD 4.4.1 冲突规则表）：
//   * 法球/攻击特效组：同组单生效（取优先级最高）
//   * 变身组：同组禁选第二个
//   * 重击组：同组单生效
//   * 切换型技能：架构预防（不能选了用不了）
//   * 卡尔元素/地卜师大招：特殊处理
// 设计：
//   * 冲突组用 integer id 标识
//   * policy: 0=同组单生效  1=同组全禁选  2=特殊处理
//   * members: 技能 ID 数组（最长 16）
//   * 用全局数组+计数方式实现（与 vcccv 风格一致）
// ===========================================================================
// ===== OMGAI_SkillDef.j =====
// ===========================================================================
// OMGAISkillDef.j
// ---------------------------------------------------------------------------
// DOTA1 OMG AI 地图 - 技能定义（核心数据结构，数据驱动）
// 技术方案 T02 技能系统 / PRD 4.3.2 AI 标签字段
// ---------------------------------------------------------------------------
// 设计：
//   * 用全局数组 + integer 索引方式实现（与 vcccv 风格一致，避免 vJASS struct 实例数限制）
//   * 每个技能定义为 SkillDef[i]，i=1..N
//   * 数据通过 SkillData.j 的 RegisterSkill 初始化
// ===========================================================================
// ===== OMGAI_SkillProfile.j =====
// ===========================================================================
// OMGAISkillProfile.j
// ---------------------------------------------------------------------------
// DOTA1 OMG AI 地图 - 技能画像（SkillDef 标签汇总）
// 技术方案 T02 技能系统 / PRD 4.3.3 SkillProfile
// ---------------------------------------------------------------------------
// 用途：
//   * AIController 在英雄完成 4+2 选技能后，调用 BuildFromSkills 生成画像
//   * AIEvaluator 根据 5 个分数匹配 ArchetypeStrategy
//   * SkillProfile 是数据中转，无副作用
// ===========================================================================
// ===== OMGAI_SkillPool.j =====
// ===========================================================================
// OMGAISkillPool.j
// ---------------------------------------------------------------------------
// DOTA1 OMG AI 地图 - 技能总池（小池 + 大池）构建
// 技术方案 T02 技能系统 / PRD 4.1.3 技能池=所有英雄技能汇总
// ---------------------------------------------------------------------------
// 职责：
//   * BuildSmallPool(): 遍历 SkillDef，把 slot=1（小技能）的 ID 收集进 SmallPool
//   * BuildBigPool():   遍历 SkillDef，把 slot=2（大招）的 ID 收集进 BigPool
//   * GetRandomOffers(): 从指定池随机抽 N 个，过滤禁选+排除已选+冲突校验
// 设计：
//   * 池为数组 + count 计数
//   * GetRandomOffers 用 Fisher-Yates 洗牌子集
// ===========================================================================
// ===== OMGAI_SkillOfferGenerator.j =====
// ===========================================================================
// OMGAISkillOfferGenerator.j
// ---------------------------------------------------------------------------
// DOTA1 OMG AI 地图 - 选技能面板生成器（8选1）
// 技术方案 T02 技能系统 / PRD 4.1 4+2 分阶段流程
// ---------------------------------------------------------------------------
// 用途：
//   * 4+2 分阶段流程调用此生成器拿 8 个待选技能 ID
//   * 内部：构建排除集（已选+固定） → SkillPool.GetRandomOffers → 冲突校验
// ===========================================================================
// ===== OMGAI_SkillConflictResolver.j =====
// ===========================================================================
// OMGAISkillConflictResolver.j
// ---------------------------------------------------------------------------
// DOTA1 OMG AI 地图 - 技能冲突校验封装
// 技术方案 T02 技能系统 / PRD 4.4 冲突校验时机
// ---------------------------------------------------------------------------
// 职责：
//   * 提供统一接口：candidate vs 已选技能是否冲突
//   * 处理特殊规则（卡尔/地卜师）的二次校验
//   * 在 SkillPool.GetRandomOffers 内部已校验，但选技能赋予与转技能时需再次校验
// 设计：
//   * 此结构对应 PRD 4.4.3 "选技能赋予：再次校验已选技能与待选是否冲突"
// ===========================================================================
// ===== OMGAI_SkillData.j =====
// ===========================================================================
// OMGAISkillData.j
// ---------------------------------------------------------------------------
// DOTA1 OMG AI 地图 - 技能数据初始化（数据驱动核心）
// 技术方案 T02 技能系统 / 技术方案 7.1 技能 ID 命名
// ---------------------------------------------------------------------------
// 用途：
//   * 注册 MVP 起步的技能定义（先放约 25 个示例占位，T05 阶段扩展到 60-80）
//   * 注册冲突规则（法球、变身、重击、切换型）
//   * SkillData 是数据层，新增技能只改这里，不改业务逻辑
// ---------------------------------------------------------------------------
// rawcode 说明：原版技能用 4 字符码（如 AHfa=影魔被动），存为 integer
// 实际工程中用 'AHfa' 字面量即可被 jasshelper 解释为整数 rawcode
// ===========================================================================
// ===== OMGAI_IPlatformAPI.j =====
// ===========================================================================
// OMGAIIPlatformAPI.j
// ---------------------------------------------------------------------------
// DOTA1 OMG AI 地图 - 平台抽象接口
// 技术方案 T03 / PRD 5.4 跨平台降级
// ---------------------------------------------------------------------------
// 设计：
//   * 业务代码只依赖 IPlatformAPI 全局函数（不直接调 DzAPI_*）
//   * KKPlatformAPI.j 注册 KK 完整版（存档+商城+付费）
//   * Platform11API.j 注册 11 降级版（免费无限转）
//   * 通过 Install 设置 IPlatformAPI_Active 切换实现
//   * 注意：YDWE jasshelper 不支持 code 变量点语法（.execute/.evaluate），
//     故不使用函数指针，改为平台状态变量 + 库内实现分支
// ===========================================================================

// ===== OMGAI_KKPlatformAPI.j =====
// ===========================================================================
// OMGAIKKPlatformAPI.j
// ---------------------------------------------------------------------------
// DOTA1 OMG AI 地图 - KK 平台 API 实现（完整商业化）
// 技术方案 T03 / PRD 4.2 转技能券付费机制
// ---------------------------------------------------------------------------
// 用法：
//   * OMGAIPlatformFactory.Init 探测到 KK 后调用 OMGAIKKPlatformAPI.Install
//   * 实现代码集中在 OMGAIIPlatformAPI（YDWE jasshelper 不支持 code 指针点语法）
//   * 所有 DzAPI_* 调用都在 OMGAIIPlatformAPI 内，业务代码不直接调
// ===========================================================================

// ===== OMGAI_Platform11API.j =====
// ===========================================================================
// OMGAIPlatform11API.j
// ---------------------------------------------------------------------------
// DOTA1 OMG AI 地图 - 11 平台 API 实现（免费降级）
// 技术方案 T03 / PRD 5.4 跨平台降级
// ---------------------------------------------------------------------------
// 策略（PRD 4.2.3 11平台降级方案）：
//   * IsCommercialEnabled -> false
//   * GetVoucherBalance -> 999999（无限）
//   * ConsumeVoucher -> true（永远成功）
//   * QuickBuy -> false（不弹框）
//   * SaveServerData / LoadServerData -> 占位
// 实现集中在 OMGAIIPlatformAPI（YDWE jasshelper 不支持 code 指针点语法）
// ===========================================================================

// ===== OMGAI_StateCleaner.j =====
// ===========================================================================
// OMGAIStateCleaner.j
// ---------------------------------------------------------------------------
// DOTA1 OMG AI 地图 - 状态清理器（架构预防竞品踩坑）
// 技术方案 T03 / PRD 4.4 借鉴竞品 -fixskill/-fixstun/-fixstate 等坑
// ---------------------------------------------------------------------------
// 设计原则：
//   * 竞品用修复命令兜底，说明运行时难根治
//   * 本模块在架构层通过"主动清理 + 周期巡检 + buff 来源校验"
//     让问题不发生而非发生后修复
// 功能：
//   * CleanForSkillRemoval(u, rawCode): 移除技能前清理关联 buff
//   * PeriodicSweep(): 主心跳周期调用，扫描异常状态
//   * 注册到 OMGAI_EVT_UNIT_TRANSFORM/Illusion 守卫
// ===========================================================================
// ===== OMGAI_HeroSkillManager.j =====
// ===========================================================================
// OMGAIHeroSkillManager.j
// ---------------------------------------------------------------------------
// DOTA1 OMG AI 地图 - 英雄技能赋予管理
// 技术方案 T03 / PRD 4.1.2 4+2 流程
// ---------------------------------------------------------------------------
// 关键函数：
//   * GrantSkill(unit, rawCode) - 赋予技能（含冲突保护）
//   * RemoveSkill(unit, rawCode) - 移除技能（含状态清理）
//   * HandlePassiveRebirth(unit, oldRawCode, newRawCode) - 转技能被动重生
// 注意：vcccv 现有 PlayerSkillIndices 全局供参考，本模块独立工作
// ===========================================================================
// ===== OMGAI_PlayerSkillState.j =====
// ===========================================================================
// OMGAIPlayerSkillState.j
// ---------------------------------------------------------------------------
// DOTA1 OMG AI 地图 - 玩家技能状态机（4+2 分阶段）
// 技术方案 T03 / PRD 4.1 4+2 分阶段流程
// ---------------------------------------------------------------------------
// 字段（PRD 4.1.3 + 技术方案 3.2 PlayerSkillState）：
//   * playerId, heroId, heroUnit
//   * fixedSkills[4]: 固定技能 rawcode（3小+1大）
//   * extraSmall, extraBig: 已选额外技能 rawcode
//   * smallOffers[8], bigOffers[8]: 当前阶段下发的待选池
//   * smallPhaseRespinUsed, bigPhaseRespinUsed: 本阶段已用免费转次数
//   * phase: INIT → SELECT_SMALL → SELECT_BIG → DONE
// 设计：用全局数组 + playerId 索引（与 vcccv PlayerSkillIndices 风格一致）
// ===========================================================================
// ===== OMGAI_PlayerSaveData.j =====
// ===========================================================================
// OMGAIPlayerSaveData.j
// ---------------------------------------------------------------------------
// DOTA1 OMG AI 地图 - 玩家服务器存档数据结构（KKAPI 持久化）
// 技术方案 T03 / PRD 5.4 跨平台降级
// ---------------------------------------------------------------------------
// 字段（PRD 6.2）：
//   * totalRespinVouchers: 累计转技能券（KK 服务器存档）
//   * totalRespinUsed:    累计消耗
//   * currentVoucherBalance: 当前余额（= total - used）
//   * customSkillIds:    玩家解锁的定制技能 ID（V2.0）
//   * customHeroIds:     玩家解锁的定制英雄 ID（V2.0）
//   * stats: 战绩统计
// 设计：KK 平台调 IPlatformAPI.SaveServerData/LoadServerData
// ===========================================================================
// ===== OMGAI_GameMode.j =====
// ===========================================================================
// OMGAIGameMode.j
// ---------------------------------------------------------------------------
// DOTA1 OMG AI 地图 - 模式与命令入口
// 技术方案 T03' / PRD 4.5 外观定制借鉴竞品命令
// ---------------------------------------------------------------------------
// 借鉴竞品机制（PRD 4.4.5）：
//   * -omgai 启动 OMG AI 模式（替代 -nengap）
//   * -cg X 设置 AI 难度（X=1-1000，借鉴竞品 -cg X 机制，T05 阶段实现）
//   * -neng 切回正常 AI（无加成）
//   * -tx X 设置武器/身体特效（外观定制，P1 级）
//   * -cb X 设置翅膀外观（P1 级）
//   * -fixskill/-fixstun 等修复命令：本项目架构预防不提供（PRD 4.4.1）
// ---------------------------------------------------------------------------
// 简化实现：先做基础模式开关，命令解析复用 vcccv 已有 ChatCommands 系统
// ===========================================================================
