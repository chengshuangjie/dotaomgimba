function Clear_FSPD takes nothing returns boolean
local unit u=GetFilterUnit()
if UnitAlive(u) and IsUnitIllusion(u) and GetUnitAbilityLevel(u,'A4LB')>0 then
    call GroupAddUnit(IQ4,u)
endif
set u=null
return false
endfunction
function Clear_FS2 takes nothing returns boolean
    call KillUnit(GetEnumUnit())
return false
endfunction
function Clear_FS takes unit ZX7 returns nothing
    local group g=WS7()
    local group g2=WS7()
    set IQ4=g2
    call GroupEnumUnitsOfPlayer(g,GetOwningPlayer(ZX7),Condition(function Clear_FSPD))
    if CountUnitsInGroup(g2)>2 then
        call ForGroup(g2,function Clear_FS2)
    endif
    call WR7(g)
    call WR7(g2)
    set g=null
    set g2=null
endfunction
