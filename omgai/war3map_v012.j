function sa takes nothing returns nothing
set DO=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(DO,EVENT_PLAYER_UNIT_SPELL_CHANNEL)
call TriggerAddCondition(DO,Condition(function HYE))
call TriggerAddAction(DO,function HAE)
endfunction
function H6E takes nothing returns boolean
return GetUnitTypeId(GetFilterUnit())=='e00Q' or GetUnitTypeId(GetFilterUnit())=='e11Q'
endfunction
// function ScarabsFilter takes nothing returns boolean
// return(GetUnitTypeId(GetFilterUnit())==1966092594)or(GetUnitTypeId(GetFilterUnit())==1966092595)
// endfunction
// function FilterEidolons takes nothing returns boolean
// return(GetUnitTypeId(GetFilterUnit())==1752654196)or(GetUnitTypeId(GetFilterUnit())==1752658994)or(GetUnitTypeId(GetFilterUnit())==1752658995)or(GetUnitTypeId(GetFilterUnit())==1747988534)
// endfunction
function HLE takes nothing returns nothing
call RemoveUnit(GetEnumUnit())
endfunction
function H1E takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local group g=OF7(OB7,"g")
local unit WX7=O77(OB7,"Hero")
local integer i=0
if WX7!=null and GetUnitTypeId(WX7)!=0 then
set i=GetPlayerId(GetOwningPlayer(WX7))
endif
if WX7!=null and GetUnitTypeId(WX7)!=0 and OT7(WX7,"Sandstorm")==false then
call UnitRemoveAbility(WX7,'B04R')
endif
if g!=null then
call ForGroup(g,function HLE)
call DestroyGroup(g)
endif
//删除沙尘暴特效
if OG7(OB7,"FX")!=null then
call DestroyEffect(OG7(OB7,"FX"))
endif
//////
call NM7(OB7)
call OZ7(t)
set t=null
set g=null
set WX7=null
return false
endfunction
function H0E takes nothing returns nothing
local unit HCE=GetTriggerUnit()
local group LQ7
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local integer i=GetPlayerId(GetOwningPlayer(HCE))
//转存沙尘暴特效
if OG7(SK_TX[i],"FX")!=null then
call NU7(OB7,"FX",OG7(SK_TX[i],"FX"))
endif
////////
call OX7(HCE,"Sandstorm")
set LQ7=HZ7(GetOwningPlayer(HCE),Condition(function H6E))
call NB7(OB7,"g",LQ7)
call NT7(OB7,"Hero",HCE)
call TriggerRegisterTimerEvent(t,.3+B287_GetUnitAbilityLevel(HCE,'A0H0')*.3,false)
call TriggerAddCondition(t,Condition(function H1E))
set t=null
set HCE=null
set LQ7=null
endfunction
function sB takes nothing returns nothing
set Dp=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(Dp,EVENT_PLAYER_UNIT_SPELL_ENDCAST)
call TriggerAddCondition(Dp,Condition(function HYE))
call TriggerAddAction(Dp,function H0E)
endfunction
function XCA takes nothing returns boolean
	if(IsMagicImmuneUnit(GetFilterUnit())== false and IsUnitEnemy(IN4, GetOwningPlayer(GetFilterUnit())) and(IsAliveNotStrucNotWard(GetFilterUnit())))!= null then
		call B67(IN4, GetFilterUnit(), 1, IJ4)
		call Z57(GetFilterUnit(),'A4I4', 1, 2,'B0K5')
		call YS7("Abilities\\Spells\\Human\\slow\\slowtarget.mdl",GetFilterUnit(),"chest",2)
	endif
	return false
endfunction
function XGA takes unit ZX7, unit SZX, integer level, boolean XHA returns nothing
	local group g = WS7()
	local real ZCE = 50 + 40 * level
    local integer id=GetUnitTypeId(ZX7)
    local string tx
    if id=='Z00K' then
        set tx="model\\hero_sandking_n11s_l_boom.mdl"
    elseif id=='Z10K' then
        set tx="AZModel\\AZ_SKcrystal_L2_blast.mdl"
    else
        set tx="Abilities\\Spells\\Undead\\PlagueCloud\\PlagueCloudCaster.mdl"
    endif
	if level == 4 or ISLABIKE(ZX7) then
		set ZCE = 220
	endif
	if XHA then
		set ZCE = ZCE / 2
	endif
    call YS7(tx,SZX,"chest",1)
	set IN4 = ZX7
	set IJ4 = ZCE
	call GroupEnumUnitsInRange(g, GetUnitX(SZX), GetUnitY(SZX), 425, Condition(function XCA))
	call WR7(g)
	set g = null
endfunction
function XJA takes nothing returns nothing
	local trigger t = GetTriggeringTrigger()
	local integer h = GetHandleId(t)
	local unit SZX = LoadUnitHandle(TABLE_HY, h, 1)
	local unit ZX7 = LoadUnitHandle(TABLE_HY, h, 0)
	local integer level = LoadInteger(TABLE_HY, h, 0)
	if ZX7==null or SZX==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(SZX)==0 then
		if SZX!=null and GetUnitTypeId(SZX)!=0 then
			call UnitRemoveAbility(SZX,'A4I3')
			call UnitRemoveAbility(SZX,'B03F')
			call RemoveSavedHandle(TABLE_HY, GetHandleId(SZX),'CFNL')
			call RemoveSavedBoolean(TABLE_HY, GetHandleId(SZX),'CFNL')
		endif
		call DestroyEffect(LoadEffectHandle(TABLE_HY, h, 10))
		call FlushChildHashtable(TABLE_HY, h)
		call OZ7(t)
		set t = null
		set ZX7 = null
		set SZX = null
		return
	endif
	if GetTriggerEventId()== EVENT_WIDGET_DEATH then
		call XGA(ZX7, SZX, level, false)
        call UnitRemoveAbility(SZX,'A4I3')
        call UnitRemoveAbility(SZX,'B03F')
		call DestroyEffect(LoadEffectHandle(TABLE_HY, h, 10))
		call FlushChildHashtable(TABLE_HY, h)
		call OZ7(t)
		call RemoveSavedHandle(TABLE_HY, GetHandleId(SZX),'CFNL')
		call RemoveSavedBoolean(TABLE_HY, GetHandleId(SZX),'CFNL')
	elseif GetTriggerEventId()== EVENT_GAME_TIMER_EXPIRED then
		if GetGameTime()>=LoadReal(TABLE_HY, h, 0) or GetUnitAbilityLevel(SZX,'B03F')==0 then
            if GetUnitAbilityLevel(SZX,'B03F')>0 then
			    call XGA(ZX7, SZX, level, true)
            endif
			call UnitRemoveAbility(SZX,'A4I3')
			call UnitRemoveAbility(SZX,'B03F')
			call DestroyEffect(LoadEffectHandle(TABLE_HY, h, 10))
			call FlushChildHashtable(TABLE_HY, h)
			call OZ7(t)
			call RemoveSavedHandle(TABLE_HY, GetHandleId(SZX),'CFNL')
			call RemoveSavedBoolean(TABLE_HY, GetHandleId(SZX),'CFNL')
		endif
	endif
	set t = null
	set ZX7 = null
	set SZX = null
endfunction
function XKA takes unit ZX7, unit WLE returns nothing
	local trigger t
	local integer h
	local integer ht = GetHandleId(WLE)
    local integer id = GetUnitTypeId(ZX7)
    local string tx
    if id=='Z00K' then
        set tx="model\\hero_sandking_n11s_l_target.mdl"
    elseif id=='Z10K' then
        set tx="AZModel\\AZ_SKcrystal_L1_BUFF.mdl"
    else
        set tx="Abilities\\Spells\\Other\\AcidBomb\\BottleImpact.mdl"
    endif
	if LoadBoolean(TABLE_HY, ht,'CFNL')==false then
		set t = CreateTrigger()
		set h = GetHandleId(t)
		call TriggerRegisterDeathEvent(t, WLE)
		call TriggerRegisterTimerEvent(t, 1, true)
		call TriggerAddCondition(t, Condition(function XJA))
		call SaveBoolean(TABLE_HY, ht,'CFNL', true)
		call SaveTriggerHandle(TABLE_HY, ht,'CFNL', t)
		call SaveUnitHandle(TABLE_HY, h, 1, WLE)
		call SaveEffectHandle(TABLE_HY, h, 10, AddSpecialEffectTarget(tx, WLE, "chest"))
		call XF7(WLE,'A4I3')
        call SaveReal(TABLE_HY, h, 0, GetGameTime()+ 6)
        call SaveInteger(TABLE_HY, h, 0, B287_GetUnitAbilityLevel(ZX7,'A0FA'))
        call SaveUnitHandle(TABLE_HY, h, 0, ZX7)
	endif
	set t = null
endfunction
function SJA takes nothing returns nothing
	if B287_GetUnitAbilityLevel(WXX,'A0FA')> 0 and ISPH(WXX)==false then
		call XKA(WXX, YXX)
	endif
endfunction
function SJA_JDCC takes nothing returns nothing
	if B287_GetUnitAbilityLevel(FSDSOURCE,'A0FA')> 0 or ISLABIKE(FSDSOURCE) then
		call XKA(FSDSOURCE, FSDTARGET)
	endif
endfunction
function H5E takes nothing returns nothing
local unit BB7
local unit IH7=GetEnumUnit()
local integer id=GetUnitTypeId(m0)
local integer level=B287_GetUnitAbilityLevel(m0,'A034')
if B287_GetUnitAbilityLevel(m0,'A2YG')>0 and (id=='E02X' or id=='Z02X') then
    if GetUnitLevel(m0)>=16 then
        set level=3
    elseif GetUnitLevel(m0)>=11 then
        set level=2
    else
        set level=1
    endif
endif
if UnitAlive(IH7) and B287_GetUnitAbilityLevel(m0,'A2YG')>0 and level>0 then
set BB7=CreateUnit(GetOwningPlayer(m0),'e00E',GetUnitX(IH7),GetUnitY(IH7),0)
call UnitApplyTimedLife(BB7,'BTLF',1.)
call XF7(BB7,'A4EQ')
call SetUnitAbilityLevel(BB7,'A4EQ',level)
call IssueTargetOrderById(BB7,$D00B5,IH7)
endif
call B67(m0,IH7,2,50+50*M0)
set IH7=null
set BB7=null
endfunction
function H2E takes nothing returns nothing
local unit p5=GetTriggerUnit()
local real x=GetUnitX(p5)
local real y=GetUnitY(p5)
local unit BB7=CreateUnit(GetOwningPlayer(p5),'e00E',x,y,0)
local group g=WS7()
local integer V77=0
local integer HaveA=0
call UnitApplyTimedLife(BB7,'BTLF',1.)
set V77=SuijiMode_GetPairCastLevel(p5,B287_GetSpellAbilityId(),'A29K','A2YG')
if B287_GetSpellAbilityId()=='A2YG' then
set HaveA=100
call XF7(BB7,'A2YE')
call SetUnitAbilityLevel(BB7,'A2YE',V77)
call IssueImmediateOrderById(BB7,$D0080)
call XF7(BB7,'A2YF')
call SetUnitAbilityLevel(BB7,'A2YF',V77)
call IssueImmediateOrderById(BB7,$D009F)
else
call XF7(BB7,'A0M9')
call SetUnitAbilityLevel(BB7,'A0M9',V77)
call IssueImmediateOrderById(BB7,$D0080)
call XF7(BB7,'A01W')
call SetUnitAbilityLevel(BB7,'A01W',V77)
call IssueImmediateOrderById(BB7,$D009F)
endif
set m0=p5
set M0=V77
call GroupEnumUnitsInRange(g,x,y,350+25+HaveA,Condition(function AW7_gai))
call ForGroup(g,function H5E)
call WR7(g)
set p5=null
set BB7=null
set g=null
endfunction
function DYCC2 takes nothing returns nothing
	local trigger t = GetTriggeringTrigger()
	local integer h = GetHandleId(t)
	local unit u = LoadUnitHandle(TABLE_HY, h, 0)
	local integer hu = GetHandleId(u)
	local real X_A = LoadReal(TABLE_HY, h, 0)
	if GetTriggerEventId()== EVENT_WIDGET_DEATH or(GetUnitAbilityLevel(u,'B013')== 0 and GetTriggerEvalCount(t)> 2) or GetGameTime()>= X_A then
		call RemoveSavedHandle(TABLE_HY, hu,'A05C')
		call SetUnitPhaseMove( u, false )
		call FlushChildHashtable(TABLE_HY, h)
		call OZ7(t)
	endif
	set t = null
	set u = null
endfunction
function DYCC takes nothing returns nothing
	local unit u = GetTriggerUnit()
	local trigger t
	local integer h
	local integer hu = GetHandleId(u)
	if HaveSavedHandle(TABLE_HY, hu,'A05C') then
		set t = LoadTriggerHandle(TABLE_HY, hu,'A05C')
		set h = GetHandleId(t)
	else
		set t = CreateTrigger()
		set h = GetHandleId(t)
		call SetUnitPhaseMove( u, true )
		call TriggerRegisterTimerEvent(t, .02, true)
		call TriggerRegisterDeathEvent(t, u)
		call TriggerAddCondition(t, Condition(function DYCC2))
		call SaveTriggerHandle(TABLE_HY, hu,'A05C', t)
		call SaveUnitHandle(TABLE_HY, h, 0, u)
	endif
	call SaveReal(TABLE_HY, h, 0, GetGameTime()+ 12.)
	set u = null
	set t = null
endfunction
function H_E takes nothing returns boolean
if B287_GetSpellAbilityId()=='A29K' or B287_GetSpellAbilityId()=='A2YG' then
call H2E()
endif
if B287_GetSpellAbilityId()=='A05C' then
call DYCC()
endif
return false
endfunction
function IR8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function H_E))
set t=null
endfunction
function SHJS3 takes nothing returns nothing
	local unit ZX7 = GetTriggerUnit()
    local unit IH7 = GetSpellTargetUnit()
    call LINGXIA(ZX7,IH7)
	set ZX7 = null
	set IH7 = null
endfunction
function SHJS2 takes nothing returns boolean
if B287_GetSpellAbilityId()=='A034' and WQ7(GetSpellTargetUnit())==false then
call SHJS3()
endif
return false
endfunction
function SHJS takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function SHJS2))
set t=null
endfunction
function I4E takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer OB7=GetHandleId(t)
local unit WI7=O77(OB7,"UnitVar")
local unit I7E=O77(OB7,"Owner")
local unit BB7
local real Z27=ON7(OB7,"Duration")
local integer V77=B287_GetUnitAbilityLevel(I7E,'A0HW')
local real I8E=ON7(OB7,"x")
local real I9E=ON7(OB7,"y")
local real BV9=GetUnitX(WI7)
local real BW9=GetUnitY(WI7)
local integer skillmj
set skillmj='h002'
if(BV9-I8E)*(BV9-I8E)+(BW9-I9E)*(BW9-I9E)>900 then
set BB7=CreateUnit(GetOwningPlayer(I7E),skillmj,GetUnitX(WI7),GetUnitY(WI7),0)
call SetUnitAbilityLevel(BB7,'A0I2',V77)
call SetUnitAbilityLevel(BB7,'A0HY',V77)
call UnitApplyTimedLife(BB7,'BTLF',7)
call NQ7(OB7,"x",(BV9)*1.)
call NQ7(OB7,"y",(BW9)*1.)
endif
set Z27=Z27+.2
call NQ7(OB7,"Duration",(Z27)*1.)
if Z27>7 or GetUnitState(WI7,UNIT_STATE_LIFE)<1 then
call PauseTimer(t)
call NM7(OB7)
endif
set t=null
set WI7=null
set I7E=null
set BB7=null
endfunction
function IDE takes nothing returns nothing
local unit m5=GetEnumUnit()
local sound Y07
local timer t
local integer OB7
set Fe=true
call UnitDamageTarget(D8,m5,F8,true,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
set Fe=false
call GroupAddUnit(R8,m5)
if IsUnitType(m5,UNIT_TYPE_HERO) then
set t=CreateTimer()
set OB7=GetHandleId(t)
set Y07=CreateSound("Sounds\\Spectral Dagger.mp3",false,true,true,$A,$A,"DefaultEAXON")
call SetSoundPosition(Y07,GetUnitX(m5),GetUnitY(m5),0)
call SetSoundDistanceCutoff(Y07,700)
call StartSound(Y07)
call KillSoundWhenDone(Y07)
call NT7(OB7,"UnitVar",m5)
call NT7(OB7,"Owner",D8)
call NQ7(OB7,"x",(GetUnitX(m5))*1.)
call NQ7(OB7,"y",(GetUnitY(m5))*1.)
call TimerStart(t,.2,true,function I4E)
endif
set m5=null
set t=null
set Y07=null
endfunction
function IEE takes nothing returns boolean
return (IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(D8)) and IsUnitInGroup(GetFilterUnit(),R8)==false and GetUnitAbilityLevel(GetFilterUnit(),'A04R')==0 and GetUnitState(GetFilterUnit(),UNIT_STATE_LIFE)>1 and IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==false)!=null
endfunction
function IFE takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer OB7=GetHandleId(t)
local group T69=OF7(OB7,"AlreadyDamaged")
local group LQ7=WS7()
local boolexpr U4D=Condition(function IEE)
local unit WI7=O77(OB7,"Hero")
local unit BU7=O77(OB7,"Projectile")
local integer B07=OM7(OB7,"TargetIndex")
local unit m5=TQ7(B07)
local real Y5=0.
local real Z5=0.
local real t5=0.
local real w5=0.
local real l4=0.
local real BV9=0.
local real BW9=0.
local unit BB7
local integer V77=0
local integer skillmj
if WI7==null or BU7==null or m5==null or GetUnitTypeId(WI7)==0 or GetUnitTypeId(BU7)==0 or GetUnitTypeId(m5)==0 then
call PauseTimer(t)
call TP7(B07)
call NM7(OB7)
if BU7!=null then
call KillUnit(BU7)
endif
if T69!=null then
call WR7(T69)
endif
call WR7(LQ7)
call DestroyBoolExpr(U4D)
set t=null
set T69=null
set LQ7=null
set U4D=null
set WI7=null
set BU7=null
set m5=null
set BB7=null
return
endif
set Y5=GetUnitX(m5)
set Z5=GetUnitY(m5)
set t5=GetUnitX(BU7)
set w5=GetUnitY(BU7)
set l4=Atan2(Z5-w5,Y5-t5)
set BV9=X17(GetUnitX(BU7)+30*Cos(l4))
set BW9=X07(GetUnitY(BU7)+30*Sin(l4))
set V77=B287_GetUnitAbilityLevel(WI7,'A0HW')
set skillmj='h002'
if OO7(OB7,"TrailNext")then
call NS7(OB7,"TrailNext",false)
set BB7=CreateUnit(GetOwningPlayer(WI7),skillmj,t5,w5,0)
call SetUnitAbilityLevel(BB7,'A0I2',V77)
call SetUnitAbilityLevel(BB7,'A0HY',V77)
call UnitApplyTimedLife(BB7,'BTLF',7)
else
call NS7(OB7,"TrailNext",true)
endif
call SetUnitX(BU7,BV9)
call SetUnitY(BU7,BW9)
call SetUnitFacing(BU7,l4*bj_RADTODEG)
set R8=T69
set D8=WI7
set F8=50+50*B287_GetUnitAbilityLevel(WI7,'A0HW')
call GroupEnumUnitsInRange(LQ7,BV9,BW9,175,U4D)
call ForGroup(LQ7,function IDE)
call WR7(LQ7)
if(BV9-Y5)*(BV9-Y5)+(BW9-Z5)*(BW9-Z5)<1600 or BlockUnitPass(BU7) then
call PauseTimer(t)
call TP7(B07)
call NM7(OB7)
call KillUnit(BU7)
call WR7(T69)
endif
set t=null
set T69=null
set LQ7=null
call DestroyBoolExpr(U4D)
set U4D=null
set WI7=null
set BU7=null
set m5=null
set BB7=null
endfunction
