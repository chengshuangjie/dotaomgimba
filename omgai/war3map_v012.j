function F71 takes unit WI7,integer U9I returns boolean
local item AW8
local boolean F81=false
local boolean F91=true
set AW8=CreateItem(U9I,GetUnitX(WI7),GetUnitY(WI7))
if GetUnitAbilityLevel(WI7,'AInv')==0 then
set F81=true
call XF7(WI7,'AInv')
endif
if UnitAddItem(WI7,AW8)==false then
call RemoveItem(AW8)
set F91=false
elseif GetWidgetLife(AW8)>0 then
call RemoveItem(AW8)
set F91=false
endif
if F81 then
call UnitRemoveAbility(WI7,'AInv')
endif
set AW8=null
return F91
endfunction
