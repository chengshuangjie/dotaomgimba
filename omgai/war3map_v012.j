function LHGD2 takes nothing returns nothing
	local timer t = GetExpiredTimer()
	local integer h = GetHandleId(t)
	local unit ZX7 =(LoadUnitHandle(TABLE_HY, h, 2))
	local unit IH7 =(LoadUnitHandle(TABLE_HY, h, 17))
	local real SourceLife = GetUnitLifePercent(ZX7)
	local real TargetLife = GetUnitLifePercent(IH7)
	local integer level = LoadInteger(TABLE_HY, h, 5)
	local real d=DGH_BUFF(ZX7)
	local real SourceRetain=(20.+level*10)*d
	local real TargetRetain=40.-level*10
	local real Now_TargetLife=GetUnitState(IH7,UNIT_STATE_LIFE)
	local real After_TargetLife
    if SBMQ(ZX7,IH7) and SourceLife<TargetLife then
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Monsoon\\MonsoonBoltTarget.mdl",ZX7,"origin"))
        call KillUnit(ZX7)
        call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "|c00FF0000"+GetUnitName(ZX7)+" 竟然妄图陷害作者，被雷劈死了|r")
    else
        call SetWidgetLife(ZX7, RMaxBJ(GetUnitState(ZX7, UNIT_STATE_MAX_LIFE)* TargetLife * 0.01, GetUnitState(ZX7, UNIT_STATE_MAX_LIFE)* SourceRetain *0.01))
        call SetUnitLifePercentBJ(IH7, SourceLife)
        if GetUnitLifePercent(IH7)< TargetRetain and GetWidgetLife(IH7)> 1 then
            call SetUnitLifePercentBJ(IH7, TargetRetain)  
        endif
        if MV7(ZX7,ZU[it_dby])!=null and IsUnitEnemy(IH7,GetOwningPlayer(ZX7)) and GetUnitLifePercent(IH7)>50. then
            call SetUnitLifePercentBJ(IH7, 60.)
        endif
        set After_TargetLife=GetUnitState(IH7,UNIT_STATE_LIFE)
        if Now_TargetLife-After_TargetLife>0 then
            call Add_EX_PlayerDamage(ZX7,IH7,Now_TargetLife-After_TargetLife)
        endif
    endif
    call LINGXIA(ZX7,IH7)
    call PauseTimer(t)
	call FlushChildHashtable(TABLE_HY, h)
	call DestroyTimer(t)
	set ZX7 = null
	set IH7 = null
	set t = null
endfunction
function LHGD takes nothing returns nothing
	local timer t = CreateTimer()
	local integer h = GetHandleId(t)
	local unit u = GetTriggerUnit()
    call MA9("FADE",u,GetSpellTargetUnit(),1,1,1,1,.3)
	call SaveInteger(TABLE_HY, h, 5, B287_GetUnitAbilityLevel(u,'A07Q'))
	call SaveUnitHandle(TABLE_HY, h, 17, GetSpellTargetUnit())
	// if GetUnitTypeId(u)=='e00E' then
	// 	set u = LoadUnitHandle(TABLE_HY, GetHandleId(u), 0)
	// endif
	// if GetUnitTypeId(u)=='e00E' then
	// 	set u = LoadUnitHandle(TABLE_HY, GetHandleId(u), 0)
	// endif
	call SaveUnitHandle(TABLE_HY, h, 2,(u))
	call TimerStart(t, 0., false, function LHGD2)
	set t = null
	set u = null
endfunction
