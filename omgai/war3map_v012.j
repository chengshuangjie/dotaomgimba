function Remove_Append_skill takes unit u,integer skill  returns nothing
if skill=='A21F' or skill=='A21G' then
    call SaveInteger(L7,(GetHandleId(u)),(704),(-1))
call UnitRemoveAbility(u,'A21H')
    call B287_UnitRemoveAbility(u,'A21F')
    call B287_UnitRemoveAbility(u,'A21G')
elseif skill=='A11N' then
call UnitRemoveAbility(u,'A13D')
    call UnitRemoveAbility(u,skill)
elseif skill=='A1A8' then
call UnitRemoveAbility(u,'A2NI')
    call UnitRemoveAbility(u,skill)
elseif skill=='A1TA' then
call UnitRemoveAbility(u,'A1TU')
    call UnitRemoveAbility(u,skill)
elseif skill=='A1NI' then
call UnitRemoveAbility(u,'A1NH')
    call UnitRemoveAbility(u,skill)
