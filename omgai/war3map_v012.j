endfunction
function SuijiMode_BeastmasterMulticastExtraBear takes unit suijiBearExtraCaster returns nothing
local integer suijiBearExtraLevel=0
local unit suijiBearExtraUnit=null
local real suijiBearExtraAngle=0.
local real suijiBearExtraDistance=0.
local real suijiBearExtraX=0.
local real suijiBearExtraY=0.
if suijiBearExtraCaster==null or UnitAlive(suijiBearExtraCaster)==false then
return
endif
set suijiBearExtraLevel=B287_GetUnitAbilityLevel(suijiBearExtraCaster,'A0A5')+GetUnitAbilityLevel(suijiBearExtraCaster,'A2SO')
if suijiBearExtraLevel<1 then
set suijiBearExtraLevel=1
elseif suijiBearExtraLevel>4 then
set suijiBearExtraLevel=4
endif
set suijiBearExtraAngle=GetRandomReal(0.,360.)
set suijiBearExtraDistance=GetRandomReal(90.,150.)
set suijiBearExtraX=X17(GetUnitX(suijiBearExtraCaster)+suijiBearExtraDistance*Cos(suijiBearExtraAngle*bj_DEGTORAD))
set suijiBearExtraY=X07(GetUnitY(suijiBearExtraCaster)+suijiBearExtraDistance*Sin(suijiBearExtraAngle*bj_DEGTORAD))
set suijiBearExtraUnit=CreateUnit(GetOwningPlayer(suijiBearExtraCaster),SuijiMode_BeastmasterExtraBearType(suijiBearExtraLevel),suijiBearExtraX,suijiBearExtraY,GetUnitFacing(suijiBearExtraCaster))
call NS7(GetHandleId(suijiBearExtraUnit),"SuijiMulticastExtraBear",true)
call UnitApplyTimedLife(suijiBearExtraUnit,'BTLF',60.)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\FeralSpirit\\feralspiritdone.mdl",suijiBearExtraUnit,"chest"))
call CHIYY_BEAR(suijiBearExtraUnit)
call JRD(suijiBearExtraUnit)
call SetUnitAbilityLevel(suijiBearExtraUnit,'A09Y',suijiBearExtraLevel)
if IsUnitAlly(suijiBearExtraUnit,GetLocalPlayer()) then
call MHUnit_EnableViewSkill(suijiBearExtraUnit,GetLocalPlayer())
endif
set suijiBearExtraUnit=null
endfunction
function SuijiMode_BeastmasterCallWildMulticastExtra takes unit caster returns nothing
local player owner=null
local integer level=0
local real x=0.
local real y=0.
local real casterSpeed=0.
local real summonSpeed=0.
local unit hawk=null
local unit boar=null
if caster==null or GetUnitTypeId(caster)==0 or UnitAlive(caster)==false then
return
endif
set level=B287_GetUnitAbilityLevel(caster,'A0OO')
if level<1 then
return
elseif level>4 then
set level=4
endif
set owner=GetOwningPlayer(caster)
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set casterSpeed=GetUnitDefaultMoveSpeed(caster)+I2R(U3V(caster))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\FeralSpirit\\feralspiritdone.mdl",x,y))
if level==1 then
set hawk=CreateUnit(owner,'n01Q',x,y,270.)
call UnitApplyTimedLife(hawk,'BTLF',60.)
elseif level==2 then
set hawk=CreateUnit(owner,'n01Q',x,y,270.)
call UnitApplyTimedLife(hawk,'BTLF',70.)
set boar=CreateUnit(owner,'n01M',x,y,270.)
call UnitApplyTimedLife(boar,'BTLF',70.)
elseif level==3 then
set hawk=CreateUnit(owner,'n01R',x,y,270.)
call UnitApplyTimedLife(hawk,'BTLF',80.)
set boar=CreateUnit(owner,'n01M',x,y,270.)
call UnitApplyTimedLife(boar,'BTLF',80.)
else
set hawk=CreateUnit(owner,'n01R',x,y,270.)
call UnitApplyTimedLife(hawk,'BTLF',80.)
set boar=CreateUnit(owner,'n01S',x,y,270.)
call UnitApplyTimedLife(boar,'BTLF',90.)
endif
if hawk!=null then
call NS7(GetHandleId(hawk),"SuijiMulticastExtraSummon",true)
if level>=3 and GetPlayerController(owner)==MAP_CONTROL_USER and PVP==false then
call XF7(hawk,'A0M5')
endif
set summonSpeed=GetUnitDefaultMoveSpeed(hawk)
if casterSpeed>summonSpeed then
call SetUnitMoveSpeed(hawk,R2I(casterSpeed))
endif
call IssueTargetOrderById(hawk,851986,caster)
endif
if boar!=null then
call NS7(GetHandleId(boar),"SuijiMulticastExtraSummon",true)
set summonSpeed=GetUnitDefaultMoveSpeed(boar)
if casterSpeed>summonSpeed then
call SetUnitMoveSpeed(boar,R2I(casterSpeed))
endif
call IssueTargetOrderById(boar,851971,caster)
endif
set hawk=null
set boar=null
set owner=null
endfunction
