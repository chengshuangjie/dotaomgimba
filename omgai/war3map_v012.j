call CreateUnitAtLoc(A7[x],'n00C',LV7,bj_UNIT_FACING)
endif
set x=x+1
endloop
call RemoveLocation(LV7)
call RemoveLocation(LW7)
set LV7=null
set LW7=null
endfunction
function SELL_HERO_PD takes nothing returns boolean
	return((IsUnitType(GetSoldUnit(), UNIT_TYPE_HERO)))
endfunction
function BP_BAN_HERO takes integer id returns nothing
call SetPlayerTechMaxAllowed(Z7[1],id,0)
call SetPlayerTechMaxAllowed(Z7[2],id,0)
call SetPlayerTechMaxAllowed(Z7[3],id,0)
call SetPlayerTechMaxAllowed(Z7[4],id,0)
call SetPlayerTechMaxAllowed(Z7[5],id,0)
call SetPlayerTechMaxAllowed(A7[1],id,0)
call SetPlayerTechMaxAllowed(A7[2],id,0)
call SetPlayerTechMaxAllowed(A7[3],id,0)
call SetPlayerTechMaxAllowed(A7[4],id,0)
call SetPlayerTechMaxAllowed(A7[5],id,0)
set J[GetUnitPointValueByType(id)]=true
endfunction
function BAN_HERO_ACTION takes nothing returns boolean
	local unit u=GetTriggerUnit()
	local player p=GetOwningPlayer(u)
	local integer id
	if B287_GetSpellAbilityId()=='A4LX' then
    	set id=LoadInteger(TABLE_HY,GetHandleId(u),1)
		if J[GetUnitPointValueByType(id)]==false then
			call DisplayTimedTextToForce(GetPlayersAll(), 10.00, Q[GetPlayerId(p)]+GetPlayerName(p)+"|r 禁用了英雄 |c00FF0000"+GetObjectName(id)+"|r")	
			set BAN_HERO_NUMBER[GetPlayerId(p)]=BAN_HERO_NUMBER[GetPlayerId(p)]+1
			call BP_BAN_HERO(id)
			call ClearSelectionForPlayer(p)
			call SelectUnitAddForPlayer(LoadUnitHandle(TABLE_HY,GetHandleId(u),0),p)
			call FlushChildHashtable(TABLE_HY, GetHandleId(u))
			call RemoveUnit(u)
		else
			call X377(p,GetObjectName(id)+" 已被其他玩家禁用，请重新选择")
			call ClearSelectionForPlayer(p)
			call SelectUnitAddForPlayer(LoadUnitHandle(TABLE_HY,GetHandleId(u),0),p)
			call FlushChildHashtable(TABLE_HY, GetHandleId(u))
			call RemoveUnit(u)
		endif
	endif
	set u=null
	set p=null
return false
endfunction
function PlayerPickHero takes integer uid, player p, unit CHOOSE_JG returns nothing
	local integer O5=GetPlayerId(p)
	if JGMJ[O5]!=null then
		call FlushChildHashtable(TABLE_HY, GetHandleId(JGMJ[O5]))
		call RemoveUnit(JGMJ[O5])
	endif
	set JGMJ[O5]= CreateUnit( p ,'hhoo', GetRectMaxX(bj_mapInitialPlayableArea), GetRectMinY(bj_mapInitialPlayableArea), .0)
	call SaveUnitHandle(TABLE_HY, GetHandleId(JGMJ[O5]), 0, CHOOSE_JG)
	call SaveInteger(TABLE_HY, GetHandleId(JGMJ[O5]), 1, uid)
	call TriggerRegisterUnitEvent(BAN_HERO_TRI,JGMJ[O5],EVENT_UNIT_SPELL_EFFECT)
	call MHUnit_SetModel(JGMJ[O5],MHUnit_GetDefDataStr(uid,UNIT_DEF_DATA_MODEL),false)
	call ResetUnitVertexColor(JGMJ[O5],uid)
	call ClearSelectionForPlayer( p )
	call SelectUnitAddForPlayer(JGMJ[O5],  p )
endfunction
function SELL_HERO_ACTION takes nothing returns nothing
	local unit SELL_HERO = GetSoldUnit()
	local unit CHOOSE_JG = GetSellingUnit()
	local player p = GetOwningPlayer(SELL_HERO)
	call RemoveUnit(SELL_HERO)
	call SetPlayerState( p , PLAYER_STATE_RESOURCE_GOLD, GetPlayerState( p , PLAYER_STATE_RESOURCE_GOLD)+ 250 )
	if BAN_HERO_NUMBER[GetPlayerId(p)]<2 then
		call PlayerPickHero(GetUnitTypeId(SELL_HERO), p, CHOOSE_JG)
	else
		call X377(p,"你已经禁用了2个英雄")
	endif
	set SELL_HERO = null
	set CHOOSE_JG = null
	set p=null
endfunction
function End_BP takes nothing returns nothing
if SUIJI_MODE==false then
call ShowUnit(MP4,true)
call ShowUnit(MQ4,true)
call ShowUnit(MR4,true)
call ShowUnit(MS4,true)
call ShowUnit(MT4,true)
call ShowUnit(MU4,true)
call ShowUnit(MV4,true)
call ShowUnit(MW4,true)
call ShowUnit(MX4,true)
call ShowUnit(MY4,true)
call ShowUnit(MZ4,true)
call ShowUnit(MA4,true)
endif
call XC7(GetLocalPlayer(),"Sound\\Interface\\Rescue.wav")
call MHFrame_Destroy(BAN_HERO_TIP)
call MHFrame_Destroy(BAN_HERO_COUNTDOWN)
call FlushChildHashtable(L7,GetHandleId(BAN_HERO_TRI))
call OZ7(BAN_HERO_TRI)
call FlushChildHashtable(L7,GetHandleId(SELL_HERO_TRI))
call OZ7(SELL_HERO_TRI)
call FlushChildHashtable(L7,GetHandleId(BAN_ESC_TRI))
call OZ7(BAN_ESC_TRI)
call FlushChildHashtable(L7,GetHandleId(LOCK_CAMAERA_TRI))
call PauseTimer(LOCK_CAMAERA_TRI)
call DestroyTimer(LOCK_CAMAERA_TRI)
call EnableTrigger(PlayerBugHero)
call EnableTrigger(UnitEnterRect)
call EnableTrigger(SBF_TRI)
call EnableTrigger(XXE_TRI)
call EnableTrigger(T78_TRI)
call ExecuteFunc("Execute_AI_TRI")
set IS_BP_ING=false
set BAN_HERO_TRI=null
set SELL_HERO_TRI=null
set BAN_ESC_TRI=null
set LOCK_CAMAERA_TRI=null
endfunction
function CHANGE_COUNTDOWN takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer I97=GetHandleId(t)
local integer n=LoadInteger(L7,I97,0)
local integer i=1
local player p
set n=n-1
call SaveInteger(L7,I97,0,n)
if n>=0 then
	call MHFrame_SetText(BAN_HERO_COUNTDOWN,"剩 余 时 间 :  "+I2S(n))
elseif n==-1 then
	call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "|c00FF0000禁选阶段结束|r")
	call DisplayTimedTextToForce(GetPlayersAll(), 10.00, " ")
	loop
	exitwhen i>11
		set p=Player(i)
		if JGMJ[GetPlayerId(p)]!=null then
			call FlushChildHashtable(TABLE_HY, GetHandleId(JGMJ[GetPlayerId(p)]))
			call RemoveUnit(JGMJ[GetPlayerId(p)])
		endif
		call ClearSelection()
		set i=i+1
	endloop
	call ShowUnit(MP4,false)
	call ShowUnit(MQ4,false)
	call ShowUnit(MR4,false)
	call ShowUnit(MS4,false)
	call ShowUnit(MT4,false)
	call ShowUnit(MU4,false)
	call ShowUnit(MV4,false)
	call ShowUnit(MW4,false)
	call ShowUnit(MX4,false)
	call ShowUnit(MY4,false)
	call ShowUnit(MZ4,false)
	call ShowUnit(MA4,false)
	call XC7(GetLocalPlayer(),"Sound\\Interface\\Rescue.wav")
	call MHFrame_SetText(BAN_HERO_TIP,"禁选阶段结束")
	call MHFrame_SetText(BAN_HERO_COUNTDOWN,"请等待 3 秒进入选人阶段")
	call MHFrame_SetTextAlign(BAN_HERO_COUNTDOWN,TEXT_VERTEX_ALIGN_CENTER,TEXT_HORIZON_ALIGN_CENTER)
	call MHFrame_SetRelativePoint(BAN_HERO_COUNTDOWN,ANCHOR_CENTER,MHUI_GetGameUI(),ANCHOR_CENTER,0,-0.02)
call MHFrame_SetTextColor(BAN_HERO_COUNTDOWN,TEXT_COLOR_NORMAL,$FFAA66FF)
call MHFrame_SetGradient(BAN_HERO_COUNTDOWN,$FF7733CC,$FFCC99FF,$FF5522AA,$FFFFCC33,2,0)
elseif n==-2 then
	call MHFrame_SetText(BAN_HERO_COUNTDOWN,"请等待 2 秒进入选人阶段")
elseif n==-3 then
	call MHFrame_SetText(BAN_HERO_COUNTDOWN,"请等待 1 秒进入选人阶段")
elseif n<=-4 then
	call End_BP()
	call FlushChildHashtable(L7,I97)
	call PauseTimer(t)
	call DestroyTimer(t)
endif
set t=null
set p=null
endfunction
function BAN_LOCK_CAMERA takes nothing returns nothing
	call PanCameraToTimed(-6990.,6840,0)
endfunction
function Start_BP takes nothing returns nothing
	local timer t=CreateTimer()
	local integer I97=GetHandleId(t)
	call XC7(GetLocalPlayer(),"Sound\\Interface\\Rescue.wav")
	// BAN提示
	call MHFrame_SetText(BAN_HERO_TIP,"当前为禁选阶段，你可以禁用2个英雄")
call MHFrame_SetTextColor(BAN_HERO_TIP,TEXT_COLOR_NORMAL,$FF0000)
call MHFrame_SetGradient(BAN_HERO_TIP,$FFFF2200,$FFFFAA00,$FFCC0000,$FFFFCC33,1,0)
	call MHFrame_SetWidth(BAN_HERO_COUNTDOWN,.2)
	call MHFrame_SetText(BAN_HERO_COUNTDOWN,"剩 余 时 间 :  20")
call MHFrame_SetTextColor(BAN_HERO_COUNTDOWN,TEXT_COLOR_NORMAL,$FF33CCFF)
call MHFrame_SetGradient(BAN_HERO_COUNTDOWN,$FF0066FF,$FF88DDFF,$FF0033AA,$FFCCEEFF,1,0)
	call MHFrame_SetTextAlign(BAN_HERO_COUNTDOWN,TEXT_VERTEX_ALIGN_CENTER,TEXT_HORIZON_ALIGN_LEFT)
	call MHFrame_SetRelativePoint(BAN_HERO_COUNTDOWN,ANCHOR_CENTER,MHUI_GetGameUI(),ANCHOR_CENTER,0.06,-0.02)
	call SaveInteger(L7,I97,0,20)
	call TimerStart(t,1,true,function CHANGE_COUNTDOWN)
	set t=null
endfunction
function BAN_HERO_START takes nothing returns boolean
	local trigger t=GetTriggeringTrigger()
	call Start_BP()
	call FlushChildHashtable(L7,GetHandleId(t))
	call OZ7(t)
	set t=null
	return false
endfunction
function BAN_ESC_ACTION takes nothing returns nothing
	local unit u=MHPlayer_GetSelectUnit()
	local integer id=GetUnitTypeId(u)
	if id=='hhoo' then
		if GetTriggerPlayer()==GetLocalPlayer() then
			call ClearSelectionForPlayer(GetTriggerPlayer())
			call SelectUnitAddForPlayer(LoadUnitHandle(TABLE_HY, GetHandleId(u), 0), GetTriggerPlayer())
		endif
	endif
	set u=null
endfunction
//BP模式
function X01 takes nothing returns nothing
local location LV7=GetRectCenter(pr)
local location LW7=GetRectCenter(qr)
local integer x=1
local trigger t
call DisableTrigger(PlayerBugHero)
call DisableTrigger(UnitEnterRect)
call DisableTrigger(SBF_TRI)
call DisableTrigger(XXE_TRI)
call DisableTrigger(T78_TRI)
call OZ7(AI_TRI_INIT)
set P4=true
set BP_MODE=true
set IS_BP_ING=true
set QD4=140
set AI_RE_TIME=93.
set BPAIYC_TIME=13.
set BAN_HERO_TRI=CreateTrigger()
call TriggerAddCondition(BAN_HERO_TRI,Condition(function BAN_HERO_ACTION))
set SELL_HERO_TRI=CreateTrigger()
call YB7(SELL_HERO_TRI, EVENT_PLAYER_UNIT_SELL)
call TriggerAddCondition(SELL_HERO_TRI, Condition(function SELL_HERO_PD))
call TriggerAddAction(SELL_HERO_TRI, function SELL_HERO_ACTION)
set BAN_ESC_TRI=CreateTrigger()
call ZC_Player_Event(BAN_ESC_TRI, EVENT_PLAYER_END_CINEMATIC)
call TriggerAddCondition(BAN_ESC_TRI, Condition(function BAN_ESC_ACTION))
set t=CreateTrigger()
call TriggerRegisterTimerEvent(t,15-GetGameTime(),false)
call TriggerAddCondition(t,Condition(function BAN_HERO_START))
set BAN_HERO_TIP = MHFrame_CreateEx("TEXT","TooltipText","",MHUI_GetGameUI(),0,0)
call MHFrame_SetTextFlag(BAN_HERO_TIP,TEXT_FLAG_NO_WRAP)
call MHFrame_SetWidth(BAN_HERO_TIP,.5)
call MHFrame_SetText(BAN_HERO_TIP,"即将进入禁选阶段")
call MHFrame_SetFont(BAN_HERO_TIP,"Fonts\\dfst-m3u.ttf",1,TEXT_TYPE_NORMAL)
call MHFrame_SetTextColor(BAN_HERO_TIP,TEXT_COLOR_NORMAL,$FFFF0000)
call MHFrame_SetGradient(BAN_HERO_TIP,$FFCC0000,$FFFF6600,$FF990000,$FFFFAA00,1,0)
call MHFrame_SetOutline(BAN_HERO_TIP,$FF000000,1)
call MHFrame_SetTextAlign(BAN_HERO_TIP,TEXT_VERTEX_ALIGN_CENTER,TEXT_HORIZON_ALIGN_CENTER)
call MHFrame_SetRelativePoint(BAN_HERO_TIP,ANCHOR_CENTER,MHUI_GetGameUI(),ANCHOR_CENTER,0,0.1)
call MHFrame_Disable(BAN_HERO_TIP,true)
set BAN_HERO_COUNTDOWN = MHFrame_CreateEx("TEXT","TooltipText","",MHUI_GetGameUI(),0,0)
call MHFrame_SetTextFlag(BAN_HERO_COUNTDOWN,TEXT_FLAG_NO_WRAP)
call MHFrame_SetWidth(BAN_HERO_COUNTDOWN,.5)
call MHFrame_SetText(BAN_HERO_COUNTDOWN,"在禁选阶段你可以禁用两个英雄")
call MHFrame_SetFont(BAN_HERO_COUNTDOWN,"Fonts\\dfst-m3u.ttf",1,TEXT_TYPE_NORMAL)
call MHFrame_SetTextColor(BAN_HERO_COUNTDOWN,TEXT_COLOR_NORMAL,$FF66CCFF)
call MHFrame_SetGradient(BAN_HERO_COUNTDOWN,$FF2288CC,$FFAAEEFF,$FF0066AA,$FFCCF5FF,1,0)
call MHFrame_SetOutline(BAN_HERO_COUNTDOWN,$FF000000,1)
call MHFrame_SetTextAlign(BAN_HERO_COUNTDOWN,TEXT_VERTEX_ALIGN_CENTER,TEXT_HORIZON_ALIGN_CENTER)
call MHFrame_SetRelativePoint(BAN_HERO_COUNTDOWN,ANCHOR_CENTER,MHUI_GetGameUI(),ANCHOR_CENTER,0,-0.02)
call MHFrame_Disable(BAN_HERO_COUNTDOWN,true)
call PanCameraToTimed(-6990.,6840,0)
set LOCK_CAMAERA_TRI=CreateTimer()
call TimerStart(LOCK_CAMAERA_TRI,.01,true,function BAN_LOCK_CAMERA)
loop
exitwhen x>5
if TA7(Z7[x])then
call CreateUnitAtLoc(Z7[x],'n00C',LW7,bj_UNIT_FACING)
endif
if TA7(A7[x])then
call CreateUnitAtLoc(A7[x],'n00C',LV7,bj_UNIT_FACING)
endif
set x=x+1
endloop
call RemoveLocation(LV7)
call RemoveLocation(LW7)
set LV7=null
set LW7=null
set t=null
endfunction
