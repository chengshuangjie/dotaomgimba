set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_CAST)
call TriggerAddCondition(t,Condition(function JSMJ_AI_PD))
call TriggerAddAction(t,function JSMJ_AI)
set t=null
endfunction
