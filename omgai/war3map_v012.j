function ChenPersuadedOrderTimer takes nothing returns boolean
local integer i=0
local unit st
local group g
local unit u
loop
exitwhen i>11
set st=M7[i]
if ChenIsHero(st) and GetWidgetLife(st)>.405 then
set g=WS7()
call GroupEnumUnitsOfPlayer(g,GetOwningPlayer(st),Condition(function DWR))
loop
set u=FirstOfGroup(g)
exitwhen u==null
call GroupRemoveUnit(g,u)
if GetUnitCurrentOrder(u)==0 and IsUnitInRange(u,st,700.)==false then
call IssuePointOrderById(u,851986,GetUnitX(st),GetUnitY(st))
endif
endloop
call WR7(g)
set g=null
endif
set i=i+1
endloop
set st=null
set u=null
return false
endfunction
