local unit DZ8=O77(OB7,"Kobold0")
local unit DA8=O77(OB7,"Kobold1")
local unit DB8=O77(OB7,"Kobold2")
local unit DC8=O77(OB7,"Kobold3")
local unit D38=O77(OB7,"Kobold4")
local unit D68
local real x=GetUnitX(DZ8)
local real y=GetUnitY(DZ8)
local trigger t
if OB4==false then
if TV7(GetOwningPlayer(DZ8))then
set x=GetRectCenterX(ED)
set y=GetRectCenterY(ED)
else
set x=GetRectCenterX(L9)
set y=GetRectCenterY(L9)
endif
else
set t=CreateTrigger()
call TriggerRegisterTimerEvent(t,2.,false)
call TriggerAddCondition(t,Condition(function DL8))
endif
set D68=DZ8
if D68!=null and D08!=D68 then
call ReviveHero(D68,x,y,false)
call SetUnitX(D68,x)
call SetUnitY(D68,y)
call DP8(D68)
call SetUnitPathing(D68,true)
call SetUnitState(D68,UNIT_STATE_MANA,$2710)
endif
set D68=DA8
if D68!=null and D08!=D68 then
call ReviveHero(D68,x,y,false)
call SetUnitX(D68,x)
call SetUnitY(D68,y)
call DP8(D68)
call SetUnitPathing(D68,true)
call SetUnitState(D68,UNIT_STATE_MANA,$2710)
endif
set D68=DB8
if D68!=null and D08!=D68 then
call ReviveHero(D68,x,y,false)
call SetUnitX(D68,x)
call SetUnitY(D68,y)
call DP8(D68)
call SetUnitPathing(D68,true)
call SetUnitState(D68,UNIT_STATE_MANA,$2710)
endif
set D68=DC8
if D68!=null and D08!=D68 then
call ReviveHero(D68,x,y,false)
call SetUnitX(D68,x)
call SetUnitY(D68,y)
call DP8(D68)
call SetUnitPathing(D68,true)
call SetUnitState(D68,UNIT_STATE_MANA,$2710)
endif
set D68=D38
if D68!=null and D08!=D68 then
call ReviveHero(D68,x,y,false)
call SetUnitX(D68,x)
call SetUnitY(D68,y)
call DP8(D68)
call SetUnitPathing(D68,true)
call SetUnitState(D68,UNIT_STATE_MANA,$2710)
endif
set t=null
set D68=null
set DC8=null
set DB8=null
set DA8=null
set DZ8=null
endfunction
function SuijiMode_ShouldGlobalLockHeroInit takes integer suijiGlobalInitSource returns boolean
if suijiGlobalInitSource==1 or suijiGlobalInitSource==2 or suijiGlobalInitSource==3 or suijiGlobalInitSource==5 or suijiGlobalInitSource==6 or suijiGlobalInitSource==7 or suijiGlobalInitSource==8 or suijiGlobalInitSource==9 then
return true
endif
if suijiGlobalInitSource==10 or suijiGlobalInitSource==11 or suijiGlobalInitSource==13 or suijiGlobalInitSource==14 or suijiGlobalInitSource==16 or suijiGlobalInitSource==17 or suijiGlobalInitSource==18 or suijiGlobalInitSource==19 then
return true
endif
if suijiGlobalInitSource==20 or suijiGlobalInitSource==21 or suijiGlobalInitSource==22 or suijiGlobalInitSource==23 or suijiGlobalInitSource==24 or suijiGlobalInitSource==25 or suijiGlobalInitSource==26 or suijiGlobalInitSource==28 then
return true
endif
if suijiGlobalInitSource==29 or suijiGlobalInitSource==30 or suijiGlobalInitSource==31 or suijiGlobalInitSource==32 or suijiGlobalInitSource==33 or suijiGlobalInitSource==34 or suijiGlobalInitSource==36 or suijiGlobalInitSource==37 then
return true
endif
if suijiGlobalInitSource==38 or suijiGlobalInitSource==39 or suijiGlobalInitSource==40 or suijiGlobalInitSource==41 or suijiGlobalInitSource==42 or suijiGlobalInitSource==43 or suijiGlobalInitSource==44 or suijiGlobalInitSource==45 then
return true
endif
if suijiGlobalInitSource==46 or suijiGlobalInitSource==47 or suijiGlobalInitSource==48 or suijiGlobalInitSource==49 or suijiGlobalInitSource==50 or suijiGlobalInitSource==51 or suijiGlobalInitSource==52 or suijiGlobalInitSource==53 then
return true
endif
if suijiGlobalInitSource==54 or suijiGlobalInitSource==55 or suijiGlobalInitSource==56 or suijiGlobalInitSource==57 or suijiGlobalInitSource==59 or suijiGlobalInitSource==60 or suijiGlobalInitSource==61 or suijiGlobalInitSource==62 then
return true
endif
if suijiGlobalInitSource==63 or suijiGlobalInitSource==64 or suijiGlobalInitSource==65 or suijiGlobalInitSource==66 or suijiGlobalInitSource==67 or suijiGlobalInitSource==68 or suijiGlobalInitSource==69 or suijiGlobalInitSource==70 then
return true
endif
if suijiGlobalInitSource==72 or suijiGlobalInitSource==74 or suijiGlobalInitSource==75 or suijiGlobalInitSource==76 or suijiGlobalInitSource==83 or suijiGlobalInitSource==84 or suijiGlobalInitSource==85 or suijiGlobalInitSource==86 then
return true
endif
if suijiGlobalInitSource==87 or suijiGlobalInitSource==88 or suijiGlobalInitSource==89 or suijiGlobalInitSource==92 or suijiGlobalInitSource==93 or suijiGlobalInitSource==96 or suijiGlobalInitSource==100 or suijiGlobalInitSource==101 then
return true
endif
if suijiGlobalInitSource==102 or suijiGlobalInitSource==105 or suijiGlobalInitSource==106 or suijiGlobalInitSource==107 or suijiGlobalInitSource==108 or suijiGlobalInitSource==111 or suijiGlobalInitSource==112 then
return true
endif
if suijiGlobalInitSource==103 or suijiGlobalInitSource==109 or suijiGlobalInitSource==110 or suijiGlobalInitSource==113 or suijiGlobalInitSource==114 or suijiGlobalInitSource==115 then
return true
endif
return false
endfunction
function SuijiMode_LockGlobalHeroInit takes integer suijiGlobalInitSource returns boolean
if SuijiMode_ShouldGlobalLockHeroInit(suijiGlobalInitSource)==false then
return true
endif
if OO7(StringHash("SuijiGlobalHeroInitLock"),I2S(suijiGlobalInitSource)) then
return false
endif
call NS7(StringHash("SuijiGlobalHeroInitLock"),I2S(suijiGlobalInitSource),true)
return true
endfunction
