call ExecuteFunc("InitHeroSkillsData")
//额外触发器
set tt = CreateTimer()
call TimerStart(tt, 0.00, false, function Init_ExtraTriggers)
set tt = null
call PM9("textures\\Watermark.blp",250,166,-7067,-6864,0,true,255,255,255)
call PM9("textures\\Watermark.blp",250,166,6495,5761,0,true,255,255,255)
call ExecuteFunc("OMGAIGameMode___OnInit")
call ExecuteFunc("OMGAIStateCleaner_Init")
call ExecuteFunc("OMGAISkillData___Init")
call ExecuteFunc("OMGAIInit___OnInit")
call OMGAISuperAIInit_OMGAI_InitAll()
endfunction
function config takes nothing returns nothing
