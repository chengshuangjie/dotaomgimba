//双头龙
function BU9 takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit p5=O77(OB7,"Source")
local integer V77=OM7(OB7,"Level")
local real a=ON7(OB7,"a")
local real x=ON7(OB7,"x")
local real y=ON7(OB7,"y")
local integer id=GetPlayerId(GetOwningPlayer(p5))
local integer U38=GetTriggerEvalCount(t)
local unit caster=O77(OB7,"Caster")
local real BV9=x+$96*U38*Cos(a)
local real BW9=y+$96*U38*Sin(a)
local integer length=OM7(OB7,"length")
if GetPlayerController(GetOwningPlayer(caster))==MAP_CONTROL_COMPUTER then
call UnitAddAbility(caster,'A0OE')
call SetUnitAbilityLevel(caster,'A0OE',V77)
endif
call IssuePointOrderById(caster,$D0208,BV9,BW9)
if U38==(length)then
if RW4[id]==caster then
set RW4[id]=null
endif
if caster!=null then
call KillUnit(caster)
endif
call NM7(OB7)
call OZ7(t)
call SetUnitAnimation(p5,"stand")
endif
set t=null
set p5=null
set caster=null
return false
endfunction
function BY9 takes nothing returns nothing
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local unit p5=GetTriggerUnit()
local location l=GetSpellTargetLoc()
local real x=GetLocationX(l)
local real y=GetLocationY(l)
local real a=Atan2(y-GetUnitY(p5),x-GetUnitX(p5))
local integer V77=B287_GetUnitAbilityLevel(p5,'A0O5')
local integer o6='A0OE'
local integer length
local integer ZZMF_level=GetUnitAbilityLevel(p5,'A4DJ')+GetUnitAbilityLevel(p5,'A4DZ')
local integer ZZMF=0
if ZZMF_level==1 or ZZMF_level==2 then
    set ZZMF=0
elseif ZZMF_level==3 or ZZMF_level==4 then
    set ZZMF=1
endif
if GetUnitAbilityLevel(p5,'A2YK')>0 or GetUnitAbilityLevel(p5,'A2YJ')>0 then
set length=9+ZZMF
else
set length=8+ZZMF
endif
if V77==0 then
set V77=B287_GetUnitAbilityLevel(p5,'A1B1')
set o6='A1B2'
set length=length+5
endif
call RemoveLocation(l)
call SetUnitAnimation(p5,"spell")
set RW4[GetPlayerId(GetOwningPlayer(p5))]=CreateUnit(GetOwningPlayer(p5),'e00E',x,y,0)
call UnitApplyTimedLife(RW4[GetPlayerId(GetOwningPlayer(p5))],'BTLF',5.)
call XF7(RW4[GetPlayerId(GetOwningPlayer(p5))],o6)
call SetUnitAbilityLevel(RW4[GetPlayerId(GetOwningPlayer(p5))],o6,V77)
call NP7(OB7,"Level",V77)
call NP7(OB7,"length",length)
call NQ7(OB7,"x",(GetUnitX(p5))*1.)
call NQ7(OB7,"y",(GetUnitY(p5))*1.)
call NQ7(OB7,"a",(a)*1.)
call NT7(OB7,"Source",p5)
call NT7(OB7,"Caster",RW4[GetPlayerId(GetOwningPlayer(p5))])
if o6=='A0OE' then
call TriggerRegisterTimerEvent(t,.1,true)
else
call TriggerRegisterTimerEvent(t,.05,true)
endif
call TriggerAddCondition(t,Condition(function BU9))
set t=null
set p5=null
set l=null
endfunction
