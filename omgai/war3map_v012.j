return true
endif
return false
endfunction
function SuijiMode_MulticastHasSafeEffectRepeat takes integer skill returns boolean
if skill=='A0DH' or skill=='A1OB' or skill=='A06R' or skill=='A1B4' or skill=='A29J' or skill=='A1MP' then
return true
endif
if skill=='A06I' or skill=='A2S1' then
return true
endif
