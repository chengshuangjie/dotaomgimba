function LHF takes nothing returns nothing
local unit u=GetTriggerUnit()
local integer i=0
local item QU8
local integer id=GetPlayerId(GetOwningPlayer(u))
local region r=CreateRegion()
if TV7(GetOwningPlayer(u))then
call RegionAddRect(r,OD)
else
