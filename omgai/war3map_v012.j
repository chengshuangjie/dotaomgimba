call x7(T4,15,row,.1)
call x7(T4,16,row,.1)
call x7(T4,17,row,.1)
call x7(T4,18,row,.1)
call x7(T4,19,row,.1)
call s6(T4,14,row,false,false)
call s6(T4,15,row,false,false)
call s6(T4,16,row,false,false)
call s6(T4,17,row,false,false)
call s6(T4,18,row,false,false)
call s6(T4,19,row,false,false)
call l6(T4,14,1," ")
endif
endfunction
