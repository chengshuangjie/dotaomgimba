function HVD takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit p5=O77(OB7,"Source")
local integer V77=B287_GetUnitAbilityLevel(p5,'A064')
local real x1=ON7(OB7,"x")
local real y1=ON7(OB7,"y")
local integer BC7=OM7(OB7,"Level")
local unit BB7=CreateUnit(GetOwningPlayer(p5),'e00E',x1,y1,0)
local real x2
local real y2
local real d
local real a
local integer i
call XF7(BB7,'A19F')
call SetUnitAbilityLevel(BB7,'A19F',BC7)
if GetTriggerEvalCount(t)==1 then
call UnitApplyTimedLife(BB7,'BTLF',.6)
set i=1
loop
exitwhen i>$A
set d=GetRandomReal(0,450)
set a=GetRandomReal(0,360)
set x2=x1+d*Cos(a*bj_DEGTORAD)
set y2=y1+d*Sin(a*bj_DEGTORAD)
set BB7=CreateUnit(GetOwningPlayer(p5),'e00J',GetUnitX(p5),GetUnitY(p5),90)
call IssuePointOrderById(BB7,$D0010,x2,y2)
call UnitApplyTimedLife(BB7,'BTLF',.5)
set i=i+1
endloop
else
call UnitApplyTimedLife(BB7,'BTLF',12.)
call NM7(OB7)
call OZ7(t)
set t=CreateTrigger()
set OB7=GetHandleId(t)
call NT7(OB7,"Source",p5)
call NT7(OB7,"Caster",BB7)
call NQ7(OB7,"x",(x1)*1.)
call NQ7(OB7,"y",(y1)*1.)
call NP7(OB7,"Level",BC7)
call TriggerRegisterTimerEvent(t,1,true)
call TriggerAddCondition(t,Condition(function HUD))
call TriggerEvaluate(t)
endif
set p5=null
set BB7=null
set t=null
return false
endfunction
function HWD takes nothing returns nothing
local trigger t=CreateTrigger()
local integer I97=GetHandleId(t)
local unit p5=GetTriggerUnit()
local integer OB7=Get_Multiple_Skill_Key(p5,'A064')
local location l=GetSpellTargetLoc()
local real x=GetLocationX(l)
local real y=GetLocationY(l)
local integer N5E=(LoadInteger(MSK,(OB7),(30)))
local real WF8
local integer skill=(LoadInteger(MSK,(OB7),(N5E)))
