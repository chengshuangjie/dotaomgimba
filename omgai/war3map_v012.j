function LKF takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(OB7),(2)))
local unit IH7
local real d=GetEventDamage()
local boolean b=LoadBoolean(L7,(OB7),(0))
local integer WF8=(LoadInteger(L7,(OB7),(100)))
if GetTriggerEventId()==EVENT_PLAYER_UNIT_SPELL_EFFECT then
    if GetSpellTargetUnit()==ZX7 and IsUnitEnemy(ZX7,GetOwningPlayer(GetTriggerUnit())) and JINGHUA_SKILL(B287_GetSpellAbilityId()) and OT7(ZX7,"BorrowedTime|Active")==false then
		call RemoveSavedHandle(TABLE_HY, GetHandleId(ZX7),'A4GA')
        call UnitRemoveAbility(ZX7,'A4GA')
        call NM7(OB7)
        call OZ7(t)
    endif
elseif GetTriggerEventId()==EVENT_UNIT_DEATH or MRPH(ZX7) then
	call RemoveSavedHandle(TABLE_HY, GetHandleId(ZX7),'A4GA')
    call UnitRemoveAbility(ZX7,'A4GA')
    call NM7(OB7)
    call OZ7(t)
elseif GetTriggerEventId()==EVENT_UNIT_DAMAGED then
    if C677(d)and IsUnitAlly(GetEventDamageSource(),GetOwningPlayer(ZX7))==false and IsUnitType(GetEventDamageSource(),UNIT_TYPE_STRUCTURE)==false and p3==false then
        if IsUnitType(GetEventDamageSource(),UNIT_TYPE_HERO)or GetUnitAbilityLevel(GetEventDamageSource(),'A04R')==0 then
            set IH7=GetEventDamageSource()
        else 
            set IH7=M7[GetPlayerId(GetOwningPlayer(GetEventDamageSource()))]
        endif
        // if GetUnitAbilityLevel(ZX7,'A4H9')>0 or GetUnitAbilityLevel(ZX7,'B0BQ')>0 or GetUnitAbilityLevel(ZX7,'B0KI')>0 or GetUnitAbilityLevel(ZX7,'B0KJ')>0 then //被净化时反弹伤害减半
        //     set d=d*0.2
        // endif
        // if GetUnitAbilityLevel(ZX7,'A4H9')>0 or GetUnitAbilityLevel(ZX7,'B0BQ')>0 or GetUnitAbilityLevel(ZX7,'B0KI')>0 or GetUnitAbilityLevel(ZX7,'B0KJ')>0 then //被净化时反弹伤害减半
        //     set d=d*0.2
        // endif
        // if GetUnitAbilityLevel(ZX7,'A4H9')>0 or GetUnitAbilityLevel(ZX7,'B0BQ')>0 or GetUnitAbilityLevel(ZX7,'B0KI')>0 or GetUnitAbilityLevel(ZX7,'B0KJ')>0 then //被净化时反弹伤害减半
        //     set d=d*0.2
        // endif
        call DisableTrigger(t)
        set p3=true
        call B67(ZX7,IH7,3,d)
        set p3=false
        call EnableTrigger(t)
    endif
else
    set WF8=WF8+1
    call SaveInteger(L7,(OB7),(100), WF8)
	if (b and WF8>=55) or (b==false and WF8>=45) then
    	call UnitRemoveAbility(ZX7,'A4GA')
		if b then
			call YZ8(ZX7)
			call YW8(ZX7,0,0)
		endif
		call RemoveSavedHandle(TABLE_HY, GetHandleId(ZX7),'A4GA')
    	call NM7(OB7)
    	call OZ7(t)
	endif
endif
set t=null
set ZX7=null
set IH7=null
return false
endfunction
function LMF takes integer skill returns nothing
local trigger t
local integer OB7
local unit p5=GetTriggerUnit()
local boolean b=false
if skill=='A4G8' then
    set b=true
endif
if HaveSavedHandle(TABLE_HY, GetHandleId(p5),'A4GA') then
	set t=LoadTriggerHandle(TABLE_HY, GetHandleId(p5),'A4GA')
    set OB7=GetHandleId(t)
    call SaveInteger(L7,(OB7),(100), 0)
else
	set t=CreateTrigger()
	set OB7=GetHandleId(t)
	call SaveTriggerHandle(TABLE_HY, GetHandleId(p5),'A4GA', t)
	call SaveBoolean(L7,(OB7),(0),(b))
	call SaveUnitHandle(L7,(OB7),(2),(p5))
	call SaveInteger(L7,(OB7),(100), 0)
	call TriggerRegisterUnitEvent(t,p5,EVENT_UNIT_DAMAGED)
	call TriggerRegisterUnitEvent(t,p5,EVENT_UNIT_DEATH)
	call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
	call TriggerRegisterTimerEvent(t,0.1,true)
	call TriggerAddCondition(t,Condition(function LKF))
	call XF7(p5,'A4GA')
endif
set t=null
set p5=null
endfunction
