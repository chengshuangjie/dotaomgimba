set J4=N97(it,852100,'A0KY')
elseif i1=='H071' then  //小鱼
    set J4=IssueImmediateOrderById(it,$D022E)
elseif i1=='Ogrh' then  //猴子
    set x=GetUnitX(it)+(450+B287_GetUnitAbilityLevel(it,'A2W7'))*Cos(RadianBetweenUnit(it,GetQSMJ(it)))
    set y=GetUnitY(it)+(450+B287_GetUnitAbilityLevel(it,'A2W7'))*Sin(RadianBetweenUnit(it,GetQSMJ(it)))
    set J4=IssuePointOrderById(it,$D00F9,x,y)
endif
if(not J4)and((GetUnitLifePercent(it)<60)or(ME7(it)))then
if(not J4)and(MR7(it,ZU[Q1]))and(GetUnitLifePercent(it)<50)then
set J4=UnitUseItemTarget(it,bj_lastCreatedItem,it)
endif
if(not J4)and(MR7(it,ZU[it_fzz]))and(GetUnitLifePercent(it)<50)then
set J4=UnitUseItemTarget(it,bj_lastCreatedItem,it)
endif
endif
if(not J4)and(h4[O5]!=null or ME7(it))then
if(not J4)and(MZ7(it,ZU[Y0]))then
set J4=UnitUseItem(it,bj_lastCreatedItem)
endif
endif
if J4 then
set h4[352+O5]=m5
endif
endif
return J4
endfunction
