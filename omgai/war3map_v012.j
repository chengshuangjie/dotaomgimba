//
function Get_Multiple_Skill_Pointer takes unit ZX7,integer skill returns integer
if skill=='A4EX' or skill=='A4EY' or skill=='A4EZ' or skill=='A0LN' or skill=='A4F0' then //白虎跳
return 10000
elseif skill=='A4F3' or skill=='A4F4' or skill=='A4F5' or skill=='A4FU' or skill=='A0LH' or skill=='A2Z9' then  //血魔大
return 20000
elseif skill=='A4BP' or skill=='A4BQ' or skill=='A01I' or skill=='A4BT' or skill=='A4BU' then  //火焰雨
return 30000
elseif skill=='A064' or skill=='A2ZR' or skill=='A2ZQ' or skill=='A2ZO' or skill=='A2ZP' then  //散弹
return 40000
elseif skill=='A4BV' or skill=='A4BW' or skill=='A1J7' or skill=='A4BZ' or skill=='A4C1' then  //小鱼跳
return 50000
elseif skill=='A4A1' or skill=='A4A2' or skill=='A0OJ' or skill=='A2ZY' or skill=='A2ZZ' then  //黑鸟关
return 60000
elseif skill=='A2ZM' or skill=='A2ZN' or skill=='A1SA' or skill=='A2ZU' or skill=='A2ZV' or skill=='A2ZW' then  //毒狗大
return 70000
elseif skill=='A1PH' or skill=='A4L2' or skill=='A4L3' or skill=='A4L4' or skill=='A4L5' or skill=='A4L6' then  //吸魂巫术
return 80000
endif
return 0
endfunction
function Get_Multiple_Skill_Key takes unit ZX7,integer skill returns integer
local integer pointer=Get_Multiple_Skill_Pointer(ZX7,skill)
if pointer>0 then
return 0-GetHandleId(ZX7)-pointer
endif
return GetHandleId(ZX7)
endfunction
function Multiple_Skill_Level takes unit u,integer old_skill,integer new_skill returns integer
local integer level=B287_GetUnitAbilityLevel(u,old_skill)+B287_GetUnitAbilityLevel(u,new_skill)
local integer pointer=Get_Multiple_Skill_Pointer(u,old_skill)
if level>0 then
return level
elseif pointer==10000 then
return B287_GetUnitAbilityLevel(u,'A0LN')+B287_GetUnitAbilityLevel(u,'A4F0')
elseif pointer==20000 then
return B287_GetUnitAbilityLevel(u,'A0LH')+B287_GetUnitAbilityLevel(u,'A2Z9')
elseif pointer==30000 then
return B287_GetUnitAbilityLevel(u,'A01I')+B287_GetUnitAbilityLevel(u,'A4BT')+B287_GetUnitAbilityLevel(u,'A4BU')
elseif pointer==40000 then
return B287_GetUnitAbilityLevel(u,'A064')
elseif pointer==50000 then
return B287_GetUnitAbilityLevel(u,'A4BV')+B287_GetUnitAbilityLevel(u,'A4BW')
elseif pointer==60000 then
return B287_GetUnitAbilityLevel(u,'A0OJ')+B287_GetUnitAbilityLevel(u,'A2ZY')+B287_GetUnitAbilityLevel(u,'A2ZZ')
elseif pointer==70000 then
return B287_GetUnitAbilityLevel(u,'A1SA')+B287_GetUnitAbilityLevel(u,'A2ZU')+B287_GetUnitAbilityLevel(u,'A2ZV')+B287_GetUnitAbilityLevel(u,'A2ZW')
elseif pointer==80000 then
return B287_GetUnitAbilityLevel(u,'A1PH')
endif
return 0
endfunction
function Multiple_Skill_ButtonSource takes unit u,integer skill returns integer
local integer pointer=Get_Multiple_Skill_Pointer(u,skill)
if pointer==10000 then
return 'A0LN'
elseif pointer==20000 then
return 'A0LH'
elseif pointer==30000 then
return 'A01I'
elseif pointer==40000 then
return 'A064'
elseif pointer==50000 then
return 'A4BV'
elseif pointer==60000 then
return 'A0OJ'
elseif pointer==70000 then
return 'A1SA'
elseif pointer==80000 then
return 'A1PH'
endif
return skill
endfunction
function Multiple_Skill_SyncButton takes unit u,integer skill returns nothing
local integer source=Multiple_Skill_ButtonSource(u,skill)
if u==null or skill==0 or source==0 then
return
endif
call MHAbility_SetCustomDataInt(u,skill,ABILITY_DEF_DATA_BUTTON_X,B287_MHAbility_GetCustomDataInt(u,source,ABILITY_DEF_DATA_BUTTON_X))
call MHAbility_SetCustomDataInt(u,skill,ABILITY_DEF_DATA_BUTTON_Y,B287_MHAbility_GetCustomDataInt(u,source,ABILITY_DEF_DATA_BUTTON_Y))
call MHAbility_SetCustomDataInt(u,skill,ABILITY_DEF_DATA_UNBUTTON_X,B287_MHAbility_GetCustomDataInt(u,source,ABILITY_DEF_DATA_UNBUTTON_X))
call MHAbility_SetCustomDataInt(u,skill,ABILITY_DEF_DATA_UNBUTTON_Y,B287_MHAbility_GetCustomDataInt(u,source,ABILITY_DEF_DATA_UNBUTTON_Y))
call MHAbility_SetCustomDataInt(u,skill,ABILITY_DEF_DATA_HOTKEY,B287_MHAbility_GetCustomDataInt(u,source,ABILITY_DEF_DATA_HOTKEY))
call MHAbility_SetCustomDataInt(u,skill,ABILITY_DEF_DATA_UNHOTKEY,B287_MHAbility_GetCustomDataInt(u,source,ABILITY_DEF_DATA_UNHOTKEY))
endfunction
function Set_Labike_Multiple_Skill takes unit ZX7,string VH returns nothing
local trigger t=null
local integer OB7=GetHandleId(ZX7)
local integer POINTER
local integer i=1
local integer Multiple_Skill_Number=8 //定义充能技能种类
loop
exitwhen i>Multiple_Skill_Number
set POINTER=0-OB7-10000*i
set t=LoadTriggerHandle(MSK,(POINTER),(0))
if VH=="clear" and t!=null then
call FlushChildHashtable(MSK,(GetHandleId(t)))
call FlushChildHashtable(MSK,(POINTER))
call OZ7(t)
elseif VH=="refresh" and t!=null then
if IsTriggerEnabled(t) then
call SaveInteger(MSK,(POINTER),(500),(1))
endif
endif
set i=i+1
endloop
set t=null
endfunction
function Multiple_Skill_Tip takes integer skill returns string
local string VH1="|n|n|c00fffc01神杖升级：充能点数+1|r"
local string VH2="|n|n|c00fffc01神杖升级：充能点数+2|r"
local string VH3="|n|n|c00fffc01神杖升级：充能点数+1，增加最大距离|r"
if skill=='A2ZU' or skill=='A4F4' then
	return VH2
elseif skill=='A2ZY' or skill=='A4BT' or skill=='A4EY' then
	return VH1
elseif skill=='A4BZ' then
	return VH3
endif
return null
endfunction
function Multiple_Skill_Interval takes integer skill,integer level returns real
if skill=='A4A1' then
    return 25.-3*level
elseif skill=='A4BV' then
    return 24.-4*level
elseif skill=='A0LN' then
    return 24.-3*level
endif
return 0.
endfunction
function Multiple_Skill_Tri takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit u=(LoadUnitHandle(MSK,(I97),(2)))
local integer id=GetUnitTypeId(u)
local integer OB7=(LoadInteger(MSK,(I97),(5)))
local integer MAX=(LoadInteger(MSK,(OB7),(20)))  //读取最大充能次数
local integer MAX_A=(LoadInteger(MSK,(OB7),(21)))  //读取神杖最大充能次数
local integer tmp1
local integer N5E=(LoadInteger(MSK,(OB7),(30)))  //读取当前可用次数
local integer skill=(LoadInteger(MSK,(OB7),(N5E)))  //读取对应技能
local real interval=(LoadReal(MSK,(OB7),(40)))  //读取充能间隔
local real cooldown=(LoadReal(MSK,(OB7),(50)))  //读取充能倒计时
local integer old_skill=(LoadInteger(MSK,(OB7),(70)))   //读取未升级技能
local integer new_skill=(LoadInteger(MSK,(OB7),(80)))   //读取神杖升级技能
local integer skill_level
local integer level=Multiple_Skill_Level(u,old_skill,new_skill)
local real d=ReduceUnitAbilityCoolDownReal(u)
local string VH
local string VH2
local boolean b=false
if id=='E02X' or id=='Z02X' then //如果是拉比克则增加偏移量，重新读取技能等级
set level=(LoadInteger(MSK,(OB7),(90)))
if GetUnitAbilityLevel(u,skill)==0 then
call XF7(u,skill)
if N5E==0 then
call Japi_ReduceUnitAbilityCoolDown(u,skill,cooldown)
endif
endif
//call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "|c00FF8000当前偏移量为|r"+I2S(OB7)+" 可用次数为"+I2S(N5E)+" 等级"+I2S(level))
endif
//扔掉A时要更换充能技能，因为所有有神杖效果的技能，没有神杖时次数只有1次，可以通过当前次数判断
if SuijiMode_HasAghanimState(u)==false and MAX_A>0 and N5E>1 then //如果当前技能可用次数大于1，会重置为可用次数为1次的技能(等于1或等于0都没事)
call UnitRemoveAbility(u,skill)
set N5E=1
call SaveInteger(MSK,(OB7),(30),(N5E)) //保存可用次数
set skill=(LoadInteger(MSK,(OB7),(N5E)))  //重新读取技能
call XF7(u,skill)   //添加次数为1次的技能
endif
//同步当前技能等级
set skill_level=GetUnitAbilityLevel(u,skill)
if skill_level!=level then
call SetUnitAbilityLevel(u,skill,level)
call Reset_Skill_range(u)
endif
//判断是否增加技能提示，只增加没有神杖并且可用次数为1的技能提示，值1为修改过，否则为未修改
if SuijiMode_HasAghanimState(u)==false and MAX_A>0 and N5E==1 and (LoadInteger(MSK,(OB7),(100+level)))!=1 then
set VH=LoadStr(MSK,(skill),(100+level)) //如果表里为空再从物编读取
if VH==null then
set VH=YDWEGetUnitAbilityDataString(u,skill,level,ABILITY_DATA_UBERTIP)
endif
set VH2=Multiple_Skill_Tip(skill)
call YDWESetUnitAbilityDataString(u,skill,level,ABILITY_DATA_UBERTIP,VH+VH2)
call SaveStr(MSK,(skill),(100+level),(VH))  //记录相应等级原本的技能提示
call SaveInteger(MSK,(OB7),(100+level),(1)) //记录相应等级技能已修改
endif
//判断是否还原技能提示，只还原有神杖并且可用次数为1的技能提示，值1为修改过，否则为未修改
if SuijiMode_HasAghanimState(u) and MAX_A>0 and N5E==1 and (LoadInteger(MSK,(OB7),(100+level)))==1 then
set VH=LoadStr(MSK,(skill),(100+level))
set VH2=Multiple_Skill_Tip(skill)
if GetLocalPlayer()==GetOwningPlayer(u) then //其他玩家的提示不还原
set VH2=""
endif
call YDWESetUnitAbilityDataString(u,skill,level,ABILITY_DATA_UBERTIP,VH+VH2)
call SaveInteger(MSK,(OB7),(100+level),(0)) //记录相应等级技能未修改
endif
//判断是否有神杖并设置当前最大充能次数
if SuijiMode_HasAghanimState(u) and (MAX_A>0) then //如果有神杖并且神杖充能次数大于0
set tmp1=MAX_A
else
set tmp1=MAX
endif
if LoadInteger(MSK,(OB7),(500))==1 then //是否刷新技能
call SaveInteger(MSK,(OB7),(500),(0))
set b=true
endif
if PT4 then    //是否WTF模式
set b=true
endif
if N5E<tmp1 then  //可用次数小于当前最大充能次数，倒计时就每次减0.5
    set cooldown=cooldown-0.5
    if b then
    set cooldown=0
    endif    
    call SaveReal(MSK,(OB7),(50),(cooldown))
	if cooldown<=0 then      //当倒计时小于等于0的时候
		call UnitRemoveAbility(u,skill)  //删除当前的充能技能
		//如果充能间隔interval为1，表示非固定充能间隔
		if interval==1 then
			set interval=Multiple_Skill_Interval(old_skill,level)
		endif
		if d>0 then
			set cooldown=interval*d
		else
			set cooldown=interval
		endif
		call SaveReal(MSK,(OB7),(50),(cooldown)) //充能倒计时重新计算
		set N5E=N5E+1  //设置可用次数加1
		call SaveInteger(MSK,(OB7),(30),(N5E)) //保存可用次数
		set skill=(LoadInteger(MSK,(OB7),(N5E)))  //重新读取技能
		call XF7(u,skill)  //添加+1级的充能技能
		call SetUnitAbilityLevel(u,skill,level)
		call Multiple_Skill_SyncButton(u,skill)
		call Reset_Skill_range(u)
	endif
endif
set t=null
set u=null
return false
endfunction

//充能技能(用于可变身单位会出BUG)
//单位，最大充能次数，神杖最大充能次数，充能时间(非固定时间填1)，未升级技能，神杖升级技能
function Multiple_Skill takes unit u,integer MAX,integer MAX_A,real interval,integer old_skill,integer new_skill returns nothing
local trigger t=CreateTrigger()
local integer I97=GetHandleId(t)
local integer OB7=Get_Multiple_Skill_Key(u,old_skill)
local integer N5E
local real cooldown=interval
local integer skill  //读取充能技能整数
local integer id=GetUnitTypeId(u)
local real d=ReduceUnitAbilityCoolDownReal(u)
local integer sourceKey=GetHandleId(u)
local integer copyIndex=0
local integer copySkill=0
loop
exitwhen copyIndex>6
set copySkill=LoadInteger(MSK,sourceKey,copyIndex)
if copySkill!=0 then
call SaveInteger(MSK,OB7,copyIndex,copySkill)
endif
set copyIndex=copyIndex+1
endloop
if SuijiMode_HasAghanimState(u) and (MAX_A>0) then //如果有神杖并且神杖充能次数大于0
set N5E=MAX_A
else
set N5E=MAX
endif
if interval==1. then //如果充能时间为非固定时间，设置充能倒计时
if id=='E02X' or id=='Z02X' then
set cooldown=Multiple_Skill_Interval(old_skill,(LoadInteger(MSK,(OB7),(90))))
else
set cooldown=Multiple_Skill_Interval(old_skill,1)
endif
endif
if d>0 then
set cooldown=cooldown*d
endif
set skill=(LoadInteger(MSK,(OB7),(N5E)))
call XF7(u,skill)    //英雄添加最大次数的充能技能
call SetUnitAbilityLevel(u,skill,Multiple_Skill_Level(u,old_skill,new_skill))
call Multiple_Skill_SyncButton(u,skill)
call Reset_Skill_range(u) //重置施法距离
call TriggerRegisterTimerEvent(t,0,false)
call TriggerRegisterTimerEvent(t,0.5,true)  //每0.5秒判断一次
call TriggerAddCondition(t,Condition(function Multiple_Skill_Tri))
call SaveUnitHandle(MSK,(I97),(2),(u))   //保存触发单位
call SaveInteger(MSK,(I97),(5),(OB7))   //保存触发单位句柄
call SaveInteger(MSK,(OB7),(20),(MAX))   //保存最大充能次数
call SaveInteger(MSK,(OB7),(21),(MAX_A))   //保存神杖最大充能次数
call SaveInteger(MSK,(OB7),(30),(N5E))   //保存当前可用次数
call SaveReal(MSK,(OB7),(40),(interval))   //保存充能间隔
call SaveReal(MSK,(OB7),(50),(cooldown))   //保存充能倒计时
call SaveInteger(MSK,(OB7),(70),(old_skill))   //保存未升级技能
call SaveInteger(MSK,(OB7),(80),(new_skill))   //保存神杖升级技能
call SaveBoolean(MSK,(OB7),(1),(false)) //未修改可用次数为1的提示
call SaveTriggerHandle(MSK,(OB7),(0),(t))
set u=null
set t=null
endfunction
