if B287_GetLearnedSkill()=='A0RO' and IsUnitIllusion(GetTriggerUnit())==false then
call O9D()
endif
return false
endfunction
function M98 takes nothing returns nothing
local trigger t=CreateTrigger()
set LNZR_GROUP=WS7()
call YB7(t,EVENT_PLAYER_HERO_SKILL)
call TriggerAddCondition(t,Condition(function ODD))
set t=null
endfunction
function OED takes unit WI7 returns nothing
local unit WX7=M7[GetPlayerId(GetOwningPlayer(WI7))]
local integer OB7=0
local integer w3
local integer i
local integer x
local integer L33
local unit w4
local boolean templarTrapRemoved=false
if WX7==null then
return
endif
set OB7=GetHandleId(WX7)
set w3=(LoadInteger(L7,(OB7),(348)))
set i=1
loop
exitwhen i>w3
set L33=(LoadInteger(L7,(OB7),(7000+i)))
set w4=TQ7(L33)
if w4==WI7 then
set templarTrapRemoved=true
set x=i
loop
exitwhen x==w3
call SaveInteger(L7,(OB7),(7000+x),((LoadInteger(L7,(OB7),(7000+x+1)))))
set x=x+1
endloop
set i=w3
endif
set i=i+1
endloop
if templarTrapRemoved then
call SaveInteger(L7,(OB7),(348),(w3-1))
endif
set w4=null
set WX7=null
endfunction
function OGD takes unit WI7 returns nothing
local unit WX7=M7[GetPlayerId(GetOwningPlayer(WI7))]
local integer OB7=GetHandleId(WX7)
local integer w3=(LoadInteger(L7,(OB7),(348)))
call SaveReal(L7,(GetHandleId(WI7)),(786),(((TimerGetElapsed(W)))*1.))
set w3=w3+1
call SaveInteger(L7,(OB7),(7000+w3),(TS7(WI7)))
call SaveInteger(L7,(OB7),(348),(w3))
if Ab[GetPlayerId(GetOwningPlayer(WX7))]then
call SelectUnitAddForPlayer(WI7,GetOwningPlayer(WX7))
endif
set WX7=null
endfunction
function OID takes unit WI7 returns nothing
local integer w8=B287_GetUnitAbilityLevel(WI7,'A0RP')*3+2
local integer w3=GetHandleId(WI7)
local integer i=(LoadInteger(L7,(w3),(348)))
local integer x=(LoadInteger(L7,(w3),(7001)))
local unit WX7=TQ7(x)
if i>=w8 then
call OED(WX7)
call RemoveUnit(WX7)
endif
set WX7=null
endfunction
//触发陷阱
function OKD takes nothing returns nothing
local unit p5=GetTriggerUnit()
local real x=GetUnitX(p5)
local real y=GetUnitY(p5)
local group g=WS7()
local real VM8=(LoadReal(L7,(GetHandleId(p5)),(786)))
local real OMD=(TimerGetElapsed(W))-VM8
local integer w3=1
local integer K2v
local integer BC7
local unit u
local unit BB7
if OMD>4 then
set w3=5
elseif OMD>3 then
set w3=4
elseif OMD>2 then
set w3=3
elseif OMD>1 then
set w3=2
endif
if w3>4 then
set K2v='A2W8'
set BC7=1
else
set K2v='A0RU'
set BC7=w3
endif
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Items\\TomeOfRetraining\\TomeOfRetrainingCaster.mdl",x,y))
set IN4=p5
call GroupEnumUnitsInRange(g,x,y,400,Condition(function AR7_gai))
loop
set u=FirstOfGroup(g)
exitwhen u==null
set BB7=CreateUnit(GetOwningPlayer(p5),'e00E',GetUnitX(u),GetUnitY(u),0)
call XF7(BB7,K2v)
call SetUnitAbilityLevel(BB7,K2v,BC7)
call IssueTargetOrderById(BB7,$D006B,u)
call UnitApplyTimedLife(BB7,'BTLF',1.)
set BB7=null
call GroupRemoveUnit(g,u)
endloop
call WR7(g)
call OED(p5)
call KillUnit(p5)
call SetUnitAnimationByIndex(p5,3)
set g=null
set p5=null
endfunction
function OOD takes nothing returns boolean
return GetOwningPlayer(GetFilterUnit())==IR4 and GetUnitTypeId(GetFilterUnit())=='e020' and XH7(GetFilterUnit())==false
endfunction
function OPD takes nothing returns nothing
local real OQD=KF7(GetUnitX(GetEnumUnit()),GetUnitY(GetEnumUnit()),IJ4,IK4)
local real ORD=KF7(GetUnitX(IN4),GetUnitY(IN4),IJ4,IK4)
if OQD<ORD then
set IN4=GetEnumUnit()
endif
endfunction
function OSD takes nothing returns nothing
local group g=WS7()
set IR4=GetOwningPlayer(GetTriggerUnit())
call GroupEnumUnitsInRange(g,GetUnitX(GetTriggerUnit()),GetUnitY(GetTriggerUnit()),9000,Condition(function OOD))
set IN4=FirstOfGroup(g)
set IJ4=GetUnitX(GetTriggerUnit())
set IK4=GetUnitY(GetTriggerUnit())
call ForGroup(g,function OPD)
call IssueImmediateOrderById((IN4),$D024C)
call WR7(g)
set g=null
endfunction
function OUD takes nothing returns nothing
local location l=GetSpellTargetLoc()
call B287_MHAbility_SetCastpoint(GetTriggerUnit(),'A0RP',.01)
call XF7(GetTriggerUnit(),'A0RT')
call MHAbility_SetCastpoint(GetTriggerUnit(),'A0RT',.01)
call OID(GetTriggerUnit())
call OGD(CreateUnit(GetOwningPlayer(GetTriggerUnit()),'e020',GetLocationX(l),GetLocationY(l),0))
call RemoveLocation(l)
set l=null
endfunction
function OVD takes nothing returns boolean
if B287_GetSpellAbilityId()=='A0RP' then
call OUD()
endif
if B287_GetSpellAbilityId()=='A0RT' then
call OSD()
endif
return false
endfunction
function OWD takes nothing returns boolean
if B287_GetSpellAbilityId()=='A0RQ' then
call OKD()
endif
return false
endfunction
function OXD takes nothing returns boolean
if B287_GetLearnedSkill()=='A0RP' and IsUnitIllusion(GetTriggerUnit())==false and B287_GetUnitAbilityLevel(GetTriggerUnit(),'A0RP')==1 then
call B287_MHAbility_SetCastpoint(GetTriggerUnit(),'A0RP',.01)
call XF7(GetTriggerUnit(),'A0RT')
call MHAbility_SetCastpoint(GetTriggerUnit(),'A0RT',.01)
endif
return false
endfunction
function OYD takes nothing returns boolean
if GetUnitTypeId(GetDyingUnit())=='e020' then
call OED(GetTriggerUnit())
endif
return false
endfunction
function MD8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function OVD))
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function OYD))
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function OWD))
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_HERO_SKILL)
call TriggerAddCondition(t,Condition(function OXD))
set t=null
endfunction
function CQLL_ZHDD takes unit ZX7 returns nothing
local real x=GetUnitX(ZX7)
local real y=GetUnitY(ZX7)
local unit BB7=CreateUnit(GetOwningPlayer(ZX7),'e00E',x,y,0)
local integer level=B287_GetUnitAbilityLevel(ZX7,'A03Y')
if ISLABIKE(ZX7) then
    set level=4
endif
call XF7(BB7,'A4JM')
call SetUnitAbilityLevel(BB7,'A4JM',level)
call IssueImmediateOrderById(BB7,$D0080)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",x,y))
set ZX7=null
set BB7=null
endfunction
function ZHDD3 takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local real x=GetUnitX(ZX7)
local real y=GetUnitY(ZX7)
local unit BB7=CreateUnit(GetOwningPlayer(ZX7),'e00E',x,y,0)
local integer level=B287_GetUnitAbilityLevel(ZX7,'A03Y')
call XF7(BB7,'A4JN')
call SetUnitAbilityLevel(BB7,'A4JN',level)
call IssueImmediateOrderById(BB7,$D0080)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",x,y))
set ZX7=null
set BB7=null
endfunction
//震撼大地
function ZHDD2 takes nothing returns boolean
if B287_GetSpellAbilityId()=='A03Y' then
call ZHDD3()
endif
return false
endfunction
function ZHDD takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function ZHDD2))
set t=null
endfunction
function OZD takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit p5=O77(OB7,"Source")
if GetTriggerEventId()==EVENT_UNIT_DEATH then
call UnitRemoveAbility(p5,'A1N3')
call UnitRemoveAbility(p5,'A1N6')
call UnitRemoveAbility(p5,'A1N7')
call UnitRemoveAbility(p5,'B0CH')
call NM7(OB7)
call OZ7(t)
elseif GetTriggerEventId()==EVENT_PLAYER_UNIT_SPELL_EFFECT then
if GetTriggerUnit()==p5 and B287_GetSpellAbilityId()=='A1P9' and TimerGetElapsed(W)>ON7(OB7,"OriginalTime") then
call NM7(OB7)
call OZ7(t)
elseif JINGHUA_SKILL(B287_GetSpellAbilityId())and p5==GetSpellTargetUnit()then
call UnitRemoveAbility(p5,'A1N3')
call UnitRemoveAbility(p5,'A1N6')
call UnitRemoveAbility(p5,'A1N7')
call UnitRemoveAbility(p5,'B0CH')
call NM7(OB7)
call OZ7(t)
endif
else
call UnitRemoveAbility(p5,'A1N3')
call UnitRemoveAbility(p5,'A1N6')
call UnitRemoveAbility(p5,'A1N7')
call UnitRemoveAbility(p5,'B0CH')
call NM7(OB7)
call OZ7(t)
endif
set t=null
set p5=null
return false
endfunction
function OAD takes nothing returns nothing
local unit p5=GetAttacker()
local integer OB7=GetHandleId(p5)
local integer V77=B287_GetUnitAbilityLevel(p5,'A1P9')
local integer SV9=OM7(OB7,"Count")
local integer MAX=2+V77
local trigger t=null
if SuijiMode_HasAghanimState(p5) then
    set MAX=MAX*2
    if GetPrdRandom(p5,'A03Y',30) then
        call CQLL_ZHDD(p5)
    endif
endif
set SV9=SV9+1
call NP7(OB7,"Count",SV9)
if SV9>=MAX then
call UnitRemoveAbility(p5,'A1N3')
call UnitRemoveAbility(p5,'A1N6')
call UnitRemoveAbility(p5,'A1N7')
call UnitRemoveAbility(p5,'B0CH')
set t=OE7(OB7,"OverpowerEndTrig")
call NM7(GetHandleId(t))
call OZ7(t)
set t=null
endif
set p5=null
endfunction
function OCD takes nothing returns boolean
if GetUnitAbilityLevel(GetAttacker(),'B0CH')>0 then
call OAD()
endif
return false
endfunction
function O3D takes nothing returns nothing
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local unit p5=GetTriggerUnit()
local integer V77=B287_GetUnitAbilityLevel(p5,'A1P9')
call XF7(p5,'A1N3')
call XF7(p5,'A1N6')
call XF7(p5,'A1N7')
call SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A1N6',false)
call TriggerRegisterTimerEvent(t,10.,false)
call TriggerRegisterUnitEvent(t,p5,EVENT_UNIT_DEATH)
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function OZD))
call NV7(GetHandleId(p5),"OverpowerEndTrig",t)
call NP7(GetHandleId(p5),"Count",0)
call NT7(OB7,"Source",p5)
call NQ7(OB7,"OriginalTime",(TimerGetElapsed(W)+1)*1.)
set t=null
set p5=null
endfunction
//超强力量
function O6D takes nothing returns boolean
if B287_GetSpellAbilityId()=='A1P9' then
call O3D()
endif
return false
endfunction
function GT8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function O6D))
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_ATTACKED)
call TriggerAddCondition(t,Condition(function OCD))
call X_7('A1N3')
call MHAbility_SetHookOrder('A1P9',852599)
call MHAbility_SetHookOrder('A0LC',856196)
call MHAbility_SetHookOrder('A4CB',856196)
set t=null
endfunction
//激怒
function OLD takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=O77(I97,"Source")
local integer BC7=OM7(I97,"Level")
if GetTriggerEventId()==EVENT_UNIT_DEATH or GetUnitAbilityLevel(ZX7,'B02H')==0 then
call NM7(I97)
call OZ7(t)
call UnitRemoveAbility(ZX7,'B02H')
call SetUnitVertexColor(ZX7,$FF,$FF,$FF,$FF)
call OX7(ZX7,"JINU")
elseif GetTriggerEventId()==EVENT_UNIT_DAMAGED and C677(GetEventDamage()) then
call YN7(ZX7,.8*GetEventDamage())
endif
set t=null
set ZX7=null
return false
endfunction
function O0D takes nothing returns nothing
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local integer skill=B287_GetSpellAbilityId()
local unit ZX7=GetTriggerUnit()
local integer level=B287_GetUnitAbilityLevel(ZX7,skill)
call YZ8(ZX7)
call YW8(ZX7,0,0)
call SetUnitVertexColor(GetTriggerUnit(),200,0,0,$FF)
call TriggerRegisterTimerEvent(t,.1,true)
call TriggerRegisterUnitEvent(t,ZX7,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(t,ZX7,EVENT_UNIT_DAMAGED)
call TriggerAddCondition(t,Condition(function OLD))
call NT7(OB7,"Source",ZX7)
call NP7(OB7,"Skill",skill)
call NP7(OB7,"Level",level)
call O37(ZX7,"JINU",4.)
set t=null
set ZX7=null
endfunction
