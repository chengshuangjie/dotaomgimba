endfunction
function AK7 takes unit u returns boolean
return GetUnitAbilityLevel(u,'B068')>0 or GetUnitAbilityLevel(u,'B07T')>0 or GetUnitAbilityLevel(u,'B076')>0 or GetUnitAbilityLevel(u,'BOwk')>0 or GetUnitAbilityLevel(u,'B04R')>0 or GetUnitAbilityLevel(u,'B0A5')>0 or GetUnitAbilityLevel(u,'B01Q')>0 or GetUnitAbilityLevel(u,'B006')>0 or GetUnitAbilityLevel(u,'Binv')>0 or GetUnitAbilityLevel(u,'Apiv')>0 or GetUnitAbilityLevel(u,'A021')>0 or GetUnitAbilityLevel(u,'A0K4')>0 or GetUnitAbilityLevel(u,'A0XB')>0 or GetUnitAbilityLevel(u,'A0Z2')>0 or GetUnitAbilityLevel(u,'A1GA')>0 or GetUnitAbilityLevel(u,'A1HW')>0 or GetUnitAbilityLevel(u,'A1HX')>0 or GetUnitAbilityLevel(u,'A0MB')>0 or GetUnitAbilityLevel(u,'B08K')>0 or GetUnitAbilityLevel(u,'B08X')>0 or GetUnitAbilityLevel(u,'B039')>0 or GetUnitAbilityLevel(u,'B00K')>0 or GetUnitAbilityLevel(u,'BHfs')>0 or GetUnitAbilityLevel(u,'A140')>0 or GetUnitAbilityLevel(u,'B021')>0 or GetUnitAbilityLevel(u,'A0ZD')>0 or GetUnitAbilityLevel(u,'A0KT')>0 or GetUnitAbilityLevel(u,'B0G8')>0 or GetUnitAbilityLevel(u,'B0GS')>0 or GetUnitAbilityLevel(u,'A2RZ')>0
endfunction
//隐身且不可见
function AM7 takes unit u,player p returns boolean
return AK7(u) and IsUnitVisible(u,p)==false
endfunction
function NOX takes nothing returns boolean
	local trigger t = GetTriggeringTrigger()
	local integer h = GetHandleId(t)
	local unit targetUnit
	local unit sourceUnit
	local real speed
	local unit missileDummy
	local real x
	local real y
	local real W_E
	local real W0E
	local real NAX
	local real NNX
	local real NBX
	local real NCX
    local boolean canDodge=LoadBoolean(TABLE_HY, h,-3)
	if GetTriggerEventId()== EVENT_UNIT_SPELL_EFFECT then
		if OXX(B287_GetSpellAbilityId()) then
			call SaveBoolean(TABLE_HY, h,-1, true)
			call SaveReal(TABLE_HY, h,-1, GetUnitX(GetTriggerUnit()))
			call SaveReal(TABLE_HY, h,-2, GetUnitY(GetTriggerUnit()))
		endif
	else
		set targetUnit = LoadUnitHandle(TABLE_HY, h, 30)
		set sourceUnit = LoadUnitHandle(TABLE_HY, h, 43)
		set speed =(LoadReal(TABLE_HY, h, 44))
		set missileDummy =(LoadUnitHandle(TABLE_HY, h, 45))
		set x = GetUnitX(missileDummy)
		set y = GetUnitY(missileDummy)
		set W_E = GetUnitX(targetUnit)
		set W0E = GetUnitY(targetUnit)
		set NAX = speed * .03
		if(LoadBoolean(TABLE_HY, h,-1)) then
			set W_E = LoadReal(TABLE_HY, h,-1)
			set W0E = LoadReal(TABLE_HY, h,-2)
		endif
		set NNX = AngleBetweenXY(x, y, W_E, W0E)
		set NBX = x + NAX * Cos(NNX * bj_DEGTORAD)
		set NCX = y + NAX * Sin(NNX * bj_DEGTORAD)
		call SetUnitX(missileDummy, NBX)
		call SetUnitY(missileDummy, NCX)
		call EXSetUnitFacing(missileDummy, NNX)
		if not UnitAlive(targetUnit) or BlockUnitPass(missileDummy) then
			call KillUnit(missileDummy)
			call FlushChildHashtable(TABLE_HY, h)
			call OZ7(t)
		elseif KF7(W_E, W0E, NBX, NCX)<= NAX then
            if canDodge and AM7(targetUnit,GetOwningPlayer(sourceUnit)) then  //隐身躲避
                call SaveBoolean(TABLE_HY, h,-1, true)
            else
            endif
			call KillUnit(missileDummy)
			set U22 = sourceUnit
			set W22 = targetUnit
			if LoadBoolean(TABLE_HY, h,-1)==false then
				if HaveSavedString(TABLE_HY, h, 46) then
					call ExecuteFunc(LoadStr(TABLE_HY, h, 46))
				endif
			endif
			call FlushChildHashtable(TABLE_HY, h)
			call OZ7(t)
		endif
	endif
	set t = null
	set targetUnit = null
	set sourceUnit = null
	set missileDummy = null
	return false
endfunction
function ChangeMissileDummy takes unit source,unit u,string DiffMissile returns nothing
    call SetUnitScale(u,XX7(source),XX7(source),XX7(source))
    call MHUnit_SetModel(u,DiffMissile,false)
endfunction
function NHX takes unit sourceUnit, unit targetUnit, integer unitTypeId, string callback, real speed, boolean canDodge, string DiffMissile returns trigger
	local trigger t = CreateTrigger()
	local integer h = GetHandleId(t)
	local real NWYE = GetUnitX(sourceUnit)
	local real NWZE = GetUnitY(sourceUnit)
	local real NMX = GetUnitFacing(sourceUnit)
    local unit missileDummy
	call TriggerRegisterTimerEvent(t, .03, true)
	call TriggerAddCondition(t, Condition(function NOX))
	call SaveReal(TABLE_HY, h, 44,((speed)* 1.))
	call SaveUnitHandle(TABLE_HY, h, 30,((targetUnit)))
	call SaveStr(TABLE_HY, h, 46,(callback))
	call SaveUnitHandle(TABLE_HY, h, 43,((sourceUnit)))
	call SaveBoolean(TABLE_HY, h,-1, false)
    call SaveBoolean(TABLE_HY, h,-3, canDodge)
	if canDodge and IsUnitEnemy(targetUnit,GetOwningPlayer(sourceUnit)) then
		call SaveReal(TABLE_HY, h,-1, 0)
		call SaveReal(TABLE_HY, h,-2, 0)
		call TriggerRegisterUnitEvent(t, targetUnit, EVENT_UNIT_SPELL_EFFECT)
	endif
    set missileDummy=CreateUnit(GetOwningPlayer(sourceUnit), unitTypeId, NWYE, NWZE, NMX)
    if DiffMissile !="" then
        call ChangeMissileDummy(sourceUnit,missileDummy,DiffMissile)
    endif
    call SaveUnitHandle(TABLE_HY, h, 45,missileDummy)
	// if IsUnitOwnedByPlayer(sourceUnit, B7) then
		// call SaveUnitHandle(TABLE_HY, h, 45,(CreateUnit(GetOwningPlayer(sourceUnit), unitTypeId, NWYE, NWZE, NMX)))
	// else
		// call SaveUnitHandle(TABLE_HY, h, 45,(CreateUnit(GetOwningPlayer(targetUnit), unitTypeId, NWYE, NWZE, NMX)))
	// endif
	// if IsUnitOwnedByPlayer(sourceUnit, B7) then
		// call SaveUnitHandle(TABLE_HY, h, 45,(CreateUnit(GetOwningPlayer(sourceUnit), unitTypeId, NWYE, NWZE, NMX)))
	// else
		// call SaveUnitHandle(TABLE_HY, h, 45,(CreateUnit(GetOwningPlayer(targetUnit), unitTypeId, NWYE, NWZE, NMX)))
	// endif
	// if IsUnitOwnedByPlayer(sourceUnit, B7) then
		// call SaveUnitHandle(TABLE_HY, h, 45,(CreateUnit(GetOwningPlayer(sourceUnit), unitTypeId, NWYE, NWZE, NMX)))
	// else
		// call SaveUnitHandle(TABLE_HY, h, 45,(CreateUnit(GetOwningPlayer(targetUnit), unitTypeId, NWYE, NWZE, NMX)))
	// endif
	set V33 = t
	set t = null
	return V33
endfunction
function NHX_TANSHE takes unit skillsource,unit sourceUnit, unit targetUnit, integer unitTypeId, string callback, real speed, boolean canDodge, string DiffMissile returns trigger
	local trigger t = CreateTrigger()
	local integer h = GetHandleId(t)
	local real NWYE = GetUnitX(sourceUnit)
	local real NWZE = GetUnitY(sourceUnit)
	local real NMX = GetUnitFacing(sourceUnit)
    local unit missileDummy
	call TriggerRegisterTimerEvent(t, .03, true)
	call TriggerAddCondition(t, Condition(function NOX))
	call SaveReal(TABLE_HY, h, 44,((speed)* 1.))
	call SaveUnitHandle(TABLE_HY, h, 30,((targetUnit)))
	call SaveStr(TABLE_HY, h, 46,(callback))
	call SaveUnitHandle(TABLE_HY, h, 43,((skillsource)))
	call SaveBoolean(TABLE_HY, h,-1, false)
	if canDodge and IsUnitEnemy(targetUnit,GetOwningPlayer(skillsource)) then
		call SaveReal(TABLE_HY, h,-1, 0)
		call SaveReal(TABLE_HY, h,-2, 0)
		call TriggerRegisterUnitEvent(t, targetUnit, EVENT_UNIT_SPELL_EFFECT)
	endif
    set missileDummy=CreateUnit(GetOwningPlayer(skillsource), unitTypeId, NWYE, NWZE, NMX)
    if DiffMissile !="" then
        call ChangeMissileDummy(skillsource,missileDummy,DiffMissile)
    endif
    call SaveUnitHandle(TABLE_HY, h, 45,missileDummy)
	set V33 = t
	set t = null
	return V33
endfunction
function I1X_tmp takes nothing returns nothing
	local timer t = GetExpiredTimer()
	local integer h = GetHandleId(t)
	local unit u = LoadUnitHandle(TABLE_HY, h, 0)
	local real I2X = I2R(LoadInteger(TABLE_HY, h, 0))
	local integer WOV = LoadInteger(TABLE_HY, h, 1)
	local real x
	local real y
	local real dx
	local real dy
	local real I3X
	local real sp
	local real d
	local real I4X = GetUnitDefaultMoveSpeed(u)+ I2R(U3V(u))
	local real I5X
	local integer I6X
	local integer c = LoadInteger(TABLE_HY, h,-1)+ 1
	if WOV == 0 then
		set WOV = 9999
	endif
	set I5X = RMinBJ(I4X *(100. + I2X)/ 100., WOV)-GetUnitMoveSpeed(u)
	set I5X = RMinBJ(I5X,1044-GetUnitMoveSpeed(u)) //限制移速最大值
	call SaveInteger(TABLE_HY, h,-1, c)
	call SaveReal(TABLE_K, GetHandleId(u), 99, R2I(I5X))
	if I5X > 0 and UnitAlive(u) then
		set x = GetUnitX(u)
		set y = GetUnitY(u)
		set dx = LoadReal(TABLE_HY, h, 10)
		set dy = LoadReal(TABLE_HY, h, 11)
		set d = KF7(dx, dy, x, y)
		if LoadBoolean(TABLE_K, GetHandleId(u), 99)== false then
			set I6X = GetUnitCurrentOrder(u)
			if(d < 100  and d > 1) and I6X !=$D0019 and I6X !=$D0004 and I6X !=$D0005 then
				set I3X = Atan2(y -dy, x -dx)
				set sp = I5X * YNN
				call SaveReal(TABLE_K, GetHandleId(u), 99, R2I(sp / YNN))
				call SetUnitX(u, CoordinateX50(x + sp * Cos(I3X)))
				call SetUnitY(u, CoordinateY50(y + sp * Sin(I3X)))
			endif
		else
			call SaveBoolean(TABLE_K, GetHandleId(u), 99, false)
		endif
		call SaveReal(TABLE_HY, h, 10, GetUnitX(u))
		call SaveReal(TABLE_HY, h,$B, GetUnitY(u))
	endif
    if UnitAlive(u)==false then
        call PauseTimer(t)
        call FlushChildHashtable(TABLE_HY,h)
        call FlushChildHashtable(TABLE_K,GetHandleId(u))
        call DestroyTimer(t)     
    endif
	set t = null
	set u = null
endfunction
function SetUnitImitateMoveSpeed_tmp takes unit u, integer I2X, integer WOV returns nothing
	local timer t
	local integer h
	if HaveSavedHandle(TABLE_K, GetHandleId(u),'MVSP')== false then
		set t = CreateTimer()
		set h = GetHandleId(t)
		call TimerStart(t, YNN, true, function I1X_tmp)
		set RRR = RRR + 1
		call SaveUnitHandle(TABLE_HY, h, 0, u)
		call SaveReal(TABLE_HY, h, 10, GetUnitX(u))
		call SaveReal(TABLE_HY, h,$B, GetUnitY(u))
		call SaveBoolean(TABLE_HY, h, 100, true)
		call SaveTimerHandle(TABLE_K, GetHandleId(u),'MVSP', t)
	else
		set t = LoadTimerHandle(TABLE_K, GetHandleId(u),'MVSP')
		set h = GetHandleId(t)
	endif
	if I2X == LoadInteger(TABLE_HY, h, 0) and WOV == LoadInteger(TABLE_HY, h, 1) then
		set t = null
		return
	endif
	call SaveInteger(TABLE_HY, h, 1, WOV)
	call SaveInteger(TABLE_HY, h, 0, I2X)
	if I2X == 0 then
		call PauseTimer(t)
		set RRR = RRR -1
		call SaveReal(TABLE_K, GetHandleId(u), 99, 0)
		call SaveBoolean(TABLE_HY, h, 100, false)
	elseif LoadBoolean(TABLE_HY, h, 100)== false then
		call TimerStart(t, YNN, true, function I1X_tmp)
		set RRR = RRR + 1
		call SaveBoolean(TABLE_HY, h, 100, true)
	endif
	set t = null
endfunction
