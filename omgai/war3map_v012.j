call SaveUnitHandle(L7,(I97),(19),(BB7))
call SaveInteger(L7,(I97),(5),(BC7))
call SaveInteger(L7,(I97),(6),(id))
call SaveBoolean(L7,(I97),(11),(b))
call SaveBoolean(L7,(I97),(12),(b2))
call SaveBoolean(L7,(I97),(21),(ISDN))
