call NM7(IID)
call NM7(UB9)
call OZ7(t1)
call OZ7(t2)
set t1=null
set t2=null
set p5=null
return false
endif
set id=GetUnitTypeId(p5)
if id=='Z00R' or id=='Z07I' then
set skillmj='h17Y'
else
set skillmj='h07Y'
endif
if(GetTriggerEventId()==EVENT_UNIT_DEATH and GetTriggerUnit()==p5)or(GetTriggerEventId()!=EVENT_UNIT_DAMAGED and GetTriggerEventId()!=EVENT_UNIT_DEATH)then
call C77(p5,0)
