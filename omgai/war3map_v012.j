function ZHR takes integer ZJR returns real
	if ZJR <= 1 then
		return .01
	elseif ZJR == 2 then
		return .5
	elseif ZJR == 3 then
		return 1.
	elseif ZJR == 4 then
		return 1.5
	elseif ZJR == 5 then
		return 2.
	elseif ZJR == 6 then
		return 2.5
	elseif ZJR == 7 then
		return 3.
	elseif ZJR == 8 then
		return 3.5
	elseif ZJR == 9 then
		return 4.
	elseif ZJR == 10 then
		return 4.5
	else
		return 5.
	endif
	return .0
endfunction
