    if  ThreeSkill[GetPlayerId(GetOwningPlayer(GetTriggerUnit()))]==1 or GetPlayerController(GetOwningPlayer(GetTriggerUnit()))==MAP_CONTROL_COMPUTER then
        call VAF()
    else
        call VAF2()
    endif
endif
return false
endfunction
