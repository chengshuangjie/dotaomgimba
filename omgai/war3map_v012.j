if IsUnitType(u,UNIT_TYPE_HERO) or GetUnitAbilityLevel(u,'A04R')>0 then
return d>5
endif
return true
endfunction
function D_9 takes unit u returns unit
local group g
if GetUnitAbilityLevel(u,'A04R')==0 then
return u
endif
set IN4=VU4
set g=WS7()
call GroupEnumUnitsInRange(g,GetUnitX(u),GetUnitY(u),900,Condition(function AJ7_gai))
set VT4=FirstOfGroup(g)
call WR7(g)
set g=null
return VT4
endfunction
function E49 takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit BB7
local unit p5
if GetTriggerEventId()== EVENT_GAME_TIMER_EXPIRED or GetTriggerEventId()==EVENT_WIDGET_DEATH then
    call UnitRemoveAbility(O77(OB7,"Target"),'A4JA')
    call OX7(O77(OB7,"Target"),"StaticChargeActive")
    call NM7(OB7)
    call OZ7(t)
elseif GetTriggerEventId()==EVENT_UNIT_DAMAGED and D29(GetEventDamageSource(),GetEventDamage())and GetRandomInt(1,100)<21 and OT7(GetTriggerUnit(),"E79")==false then
    set p5=O77(OB7,"Source")
set BB7=CreateUnit(GetOwningPlayer(p5),'e00E',GetUnitX(GetTriggerUnit()),GetUnitY(GetTriggerUnit()),0)
call UnitAddAbility(BB7,'A0K6')
    set VU4=p5
    if IssueTargetOrderById(BB7,$D026B,D_9(GetEventDamageSource()))then
        call O37(GetTriggerUnit(),"E79",.5)
    endif
endif
set t=null
set BB7=null
set p5=null
endfunction
function E79 takes nothing returns nothing
local unit p5=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local trigger t
local integer OB7
if m5==null then
set m5=p5
endif
if OT7(m5,"StaticChargeActive")==false then
    set t=CreateTrigger()
    set OB7=GetHandleId(t)
    call OV7(m5,"StaticChargeActive")
    call TriggerRegisterTimerEvent(t,20.,false)
    call TriggerRegisterDeathEvent(t,m5)
    call TriggerRegisterUnitEvent(t,m5,EVENT_UNIT_DAMAGED)
    call TriggerAddCondition(t,Condition(function E49))
    call XF7(m5,'A4JA')
    call NT7(OB7,"Source",p5)
    call NT7(OB7,"Target",m5)
endif
set t=null
set p5=null
set m5=null
endfunction
function E99 takes nothing returns nothing
if B287_GetSpellAbilityId()=='A0JL' then
    call E79()
endif
endfunction
function ED9 takes integer i returns boolean
return i=='I006' or i=='I008' or i=='I00J' or i=='I00K' or i=='I007' or i=='I0PJ' or i=='I0Q5' or i=='I0X5'
endfunction
function ED99 takes integer i returns boolean
return i=='I0X5'
endfunction
