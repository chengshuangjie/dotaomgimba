function SuijiMode_ShouldSkipLunaBeamDuplicate takes unit suijiLunaBeamCaster,unit suijiLunaBeamTarget returns boolean
local integer suijiLunaBeamCasterHandle=0
local integer suijiLunaBeamTargetHandle=0
local timer suijiLunaBeamTimer=null
if SuijiMode_IsLunaBeamRandomCaster(suijiLunaBeamCaster)==false or suijiLunaBeamTarget==null then
return false
endif
set suijiLunaBeamCasterHandle=GetHandleId(suijiLunaBeamCaster)
set suijiLunaBeamTargetHandle=GetHandleId(suijiLunaBeamTarget)
if OO7(suijiLunaBeamCasterHandle,"SuijiLunaBeamLocked") then
return true
endif
call NS7(suijiLunaBeamCasterHandle,"SuijiLunaBeamLocked",true)
call NP7(suijiLunaBeamCasterHandle,"SuijiLunaBeamTarget",suijiLunaBeamTargetHandle)
set suijiLunaBeamTimer=CreateTimer()
call NT7(GetHandleId(suijiLunaBeamTimer),"Caster",suijiLunaBeamCaster)
call TimerStart(suijiLunaBeamTimer,.25,false,function SuijiMode_LunaBeamUnlock)
set suijiLunaBeamTimer=null
return false
endfunction
function C_9 takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit WI7=O77(OB7,"Hero")
local integer L49=OM7(OB7,"LucentLevel")
local integer Tq=OM7(OB7,"Limit")
local integer L79=OM7(OB7,"TargetLimit")
local integer id=OM7(OB7,"ID")
local group g=WS7()
local real x=0.
local real y=0.
local unit m5
local real r1=GetRandomInt($C8,350)
local real r2=GetRandomInt($C8,350)
local string tx
local boolexpr suijiLunaEclipseEnemyFilter=null
if WI7==null or UnitAlive(WI7)==false then
call WR7(g)
if WI7!=null then
call NS7(GetHandleId(WI7),"SuijiLunaEclipseActive",false)
endif
call NM7(OB7)
call OZ7(t)
set t=null
set WI7=null
set g=null
set m5=null
return false
endif
set x=GetUnitX(WI7)
set y=GetUnitY(WI7)
if id=='Z005' then
	set tx="model\\Hero_MoonRider_N3S_C_Continue.mdl"
elseif id=='Z105' then
	set tx="model\\Hero_MoonRider_N2S_C_Continue.mdl"
elseif id=='Z205' then
	set tx="model\\Hero_MoonRider_N1S_C_Continue.mdl"
else
	set tx="effects\\Eclipse.mdl"
endif
if GetRandomInt(1,2)==1 then
set r1=-1*r1
set r2=-1*r2
endif
set IN4=WI7
set IH4=L79
set tl=GetHandleId(t)
set suijiLunaEclipseEnemyFilter=Condition(function C29)
call GroupEnumUnitsInRange(g,x,y,725,suijiLunaEclipseEnemyFilter)
call DestroyBoolExpr(suijiLunaEclipseEnemyFilter)
set m5=GroupPickRandomUnit(g)
call WR7(g)
if XH7(WI7)==false and m5!=null and C59(m5)==false then
call SaveInteger(L7,tl,GetHandleId(m5),LoadInteger(L7,tl,GetHandleId(m5))+1)
if id=='Z005' or id=='Z105' or id=='Z205' then
call YT7(tx,GetUnitX(m5),GetUnitY(m5),1)
else
call YS7(tx,m5,"origin",3)
endif
if GetPlayerController(GetOwningPlayer(WI7))==MAP_CONTROL_COMPUTER then
call B67(WI7,m5,1,L49*75)
else
call B67(WI7,m5,7,L49*75)
endif
elseif XH7(WI7)==false then
set x=x+GetRandomInt(-350,350)
set y=y+GetRandomInt(-350,350)
call YT7(tx,x,y,1.5)
endif
if(GetTriggerEvalCount(t)+1)==Tq then
call UnitRemoveAbility(WI7,'A4CA')
call NS7(GetHandleId(WI7),"SuijiLunaEclipseActive",false)
call NM7(OB7)
call OZ7(t)
endif
set t=null
set WI7=null
set g=null
set m5=null
set suijiLunaEclipseEnemyFilter=null
return false
endfunction
function L89 takes nothing returns nothing
local unit WX7=GetTriggerUnit()
local trigger t=null
local integer OB7=0
local integer Tq
local integer L49=0
local integer L79
local unit BB7=null
local real d
local integer id=0
local integer suijiLunaEclipseCasterHandle=0
local boolean suijiLunaEclipseRandomCaster=false
local boolean suijiLunaEclipseScepter=false
local integer suijiLunaEclipseLevel=0
if WX7==null or GetUnitTypeId(WX7)==0 then
set WX7=null
return
endif
set L49=B287_GetUnitAbilityLevel(WX7,'A042')
set id=GetUnitTypeId(WX7)
set suijiLunaEclipseCasterHandle=GetHandleId(WX7)
set suijiLunaEclipseRandomCaster=SuijiMode_IsLunaEclipseRandomCaster(WX7)
if suijiLunaEclipseRandomCaster and OO7(suijiLunaEclipseCasterHandle,"SuijiLunaEclipseActive") then
set WX7=null
set t=null
set BB7=null
return
endif
if suijiLunaEclipseRandomCaster then
call NS7(suijiLunaEclipseCasterHandle,"SuijiLunaEclipseActive",true)
endif
set t=CreateTrigger()
set OB7=GetHandleId(t)
set BB7=CreateUnit(GetOwningPlayer(WX7),'e00E',GetUnitX(WX7),GetUnitY(WX7),0)
call XF7(WX7,'A4CA')
if L49==0 then
set L49=4
endif
call XF7(BB7,'A1T6')
set suijiLunaEclipseLevel=SuijiMode_GetPairCastLevel(WX7,B287_GetSpellAbilityId(),'A054','A00U')
set suijiLunaEclipseScepter=SuijiMode_HasAghanimState(WX7)
if suijiLunaEclipseScepter==false then
set Tq=2+3*suijiLunaEclipseLevel
set L79=60
set d=.6
else
set Tq=3+4*suijiLunaEclipseLevel
set L79=60
set d=.3
endif
call UnitApplyTimedLife(BB7,'BTLF',I2R(Tq)*d+2.)
call NP7(OB7,"LucentLevel",L49)
call NP7(OB7,"Limit",Tq)
call NP7(OB7,"TargetLimit",L79)
call NT7(OB7,"Hero",WX7)
call NP7(OB7,"ID",id)
call TriggerRegisterTimerEvent(t,d,true)
call TriggerAddCondition(t,Condition(function C_9))
call TriggerEvaluate(t)
call IssueImmediateOrderById(BB7,$D028D)
set t=null
set WX7=null
set BB7=null
endfunction
