				if ( value < Damagerate ) then
					set value=Damagerate
					set skill='A03N'
				endif
			endif
    
    
    
		endif

		// 海象神拳

		// 海象神拳

		// 海象神拳
		if OT7(ZX7,"WalrusPunch|Active") and OE7(GetHandleId(ZX7),"WalrusPunch|Clear")!=null then
			set value=3.5
			set skill='A1YQ'
		endif

        //物品暴击

        //物品暴击

        //物品暴击
        if MRPH(ZX7)==false and YSBJ_HERO(ZX7)==false then
            //水晶剑/血棘(20) * (1.75)
            set rate=XJBJ_RATE(ZX7)*100.
            if rate>0 and GetPrdRandom(ZX7 , 'I0TE' , rate) then
                set Damagerate=1.75
                if ( value < Damagerate ) then
                    set value=Damagerate
                    set skill='I0TE'
                endif
            endif
            //大炮(30) * (2.4)
            set rate=DPBJ_RATE(ZX7)*100.
            if rate>0 and GetPrdRandom(ZX7 , 'I0A3' , rate) then
                set Damagerate=2.4
                if ( value < Damagerate ) then
                    set value=Damagerate
                    set skill='I0A3'
                endif
            endif   
        endif
    

	// elseif not (HaveSavedHandle(ExtraHT, GetHandleId((ZX7)), HTKEY_UNIT_BREAK)) then
	// 	// 头狼和巨狼 20% 2
	// 	set level=GetUnitAbilityLevel(ZX7, 'ACct')
	// 	if level > 0 and GetPrdRandom(ZX7 , 'ACct' , 20) then
	// 		set Damagerate=2.
	// 		if ( value < Damagerate ) then
	// 			set value=Damagerate
	// 			set skill='ACct'
	// 		endif
	// 	endif
