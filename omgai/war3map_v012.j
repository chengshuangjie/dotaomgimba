//library OMGAIBaseSkillTable ends
//library OMGAIConflictRule:

    // ---- 冲突策略枚举 ----------------------------------------------------

    // ---- 冲突规则全局表（数据驱动）--------------------------------------
    // 最多 64 个冲突组，每组最多 16 个成员

    // 注册一条冲突规则
    // groupId - 冲突组 ID（自定义）
    // policy  - CONFLICT_POLICY_*
    function OMGAIConflictRule_Register takes integer groupId, integer policy returns integer
        set ConflictRule_Count = ConflictRule_Count + 1
        set ConflictRule_GroupId[ConflictRule_Count] = groupId
        set ConflictRule_Policy[ConflictRule_Count] = policy
        set ConflictRule_MemberCount[ConflictRule_Count] = 0
        return ConflictRule_Count
    endfunction

    // 向某冲突组追加成员技能
    // ruleIndex - Register 返回的索引
    // skillId   - 成员技能 rawCode
    // priority  - 优先级（同组单生效时取最高）
    function OMGAIConflictRule_AddMember takes integer ruleIndex, integer skillId, integer priority returns nothing
        local integer memberIdx
        if ruleIndex < 1 or ruleIndex > ConflictRule_Count then
            call OMGAILogger_E("ConflictRule", "AddMember: invalid ruleIndex=" + I2S(ruleIndex))
            return
        endif
        if ConflictRule_MemberCount[ruleIndex] >= 16 then
            call OMGAILogger_E("ConflictRule", "AddMember: group " + I2S(ConflictRule_GroupId[ruleIndex]) + " max 16 members")
            return
        endif
        set ConflictRule_MemberCount[ruleIndex] = ConflictRule_MemberCount[ruleIndex] + 1
        set memberIdx = (ruleIndex - 1) * 16 + ConflictRule_MemberCount[ruleIndex]
        set ConflictRule_MemberId[memberIdx]   = skillId
        set ConflictRule_PriorityA[memberIdx]  = priority
    endfunction

    // 查询某个技能属于哪个冲突组（返回 ruleIndex，0 表示无冲突）
    function OMGAIConflictRule_FindRuleOfSkill takes integer skillId returns integer
        local integer i
        local integer j
        local integer memberIdx
        set i = 1
        loop
            exitwhen i > ConflictRule_Count
            set j = 1
            loop
                exitwhen j > ConflictRule_MemberCount[i]
                set memberIdx = (i - 1) * 16 + j
                if ConflictRule_MemberId[memberIdx] == skillId then
                    return i
                endif
                set j = j + 1
            endloop
            set i = i + 1
        endloop
        return 0
    endfunction

    // 检测待选技能与当前已选技能是否冲突
    // candidateId  - 待校验技能
    // currentSkills - 当前已选技能 ID 数组（含固定技能）
    // currentCount   - 数组有效长度
        function OMGAIConflictRule_IsConflictWith takes integer candidateId, integer currentCount returns boolean
        local integer ruleIdx = OMGAIConflictRule_FindRuleOfSkill(candidateId)
        local integer i
        local integer curRuleIdx
        if ruleIdx == 0 then
            return false
        endif
        // read current skills from ConflictRule_CheckList (pre-filled by caller)
        if ConflictRule_Policy[ruleIdx] == CONFLICT_POLICY_MUTUAL_EXCLUSIVE then
            set i = 1
            loop
                exitwhen i > currentCount
                if ConflictRule_CheckList[i] != 0 then
                    set curRuleIdx = OMGAIConflictRule_FindRuleOfSkill(ConflictRule_CheckList[i])
                    if curRuleIdx == ruleIdx then
                        return true
                    endif
                endif
                set i = i + 1
            endloop
            return false
        endif

        if ConflictRule_Policy[ruleIdx] == CONFLICT_POLICY_SINGLE_ACTIVE then
            set i = 1
            loop
                exitwhen i > currentCount
                if ConflictRule_CheckList[i] != 0 then
                    set curRuleIdx = OMGAIConflictRule_FindRuleOfSkill(ConflictRule_CheckList[i])
                    if curRuleIdx == ruleIdx then
                        return true
                    endif
                endif
                set i = i + 1
            endloop
            return false
        endif

        // special handle: default no conflict, resolved by SkillConflictResolver
        return false
    endfunction

    // query group policy (public access for SkillConflictResolver)
    function OMGAIConflictRule_GetPolicy takes integer ruleIndex returns integer
        if ruleIndex < 1 or ruleIndex > ConflictRule_Count then
            return -1
        endif
        return ConflictRule_Policy[ruleIndex]
    endfunction


//library OMGAIConflictRule ends
//library OMGAIEventDispatcher:

    // ---- Payload 全局变量（事件触发前填充，回调中读取）-----------------------

    // 注册事件回调
    // eventType - OMGAI_EVT_*
    // callback  - 一个 takes nothing returns nothing 的函数
    function OMGAIEventDispatcher_On takes integer eventType, code callback returns nothing
        if eventType < 1 or eventType > 31 then
            call OMGAILogger_E("EvtDisp", "On: invalid eventType=" + I2S(eventType))
            return
        endif
        if OMGAI_EventTriggers[eventType] == null then
            set OMGAI_EventTriggers[eventType] = CreateTrigger()
        endif
        call TriggerAddCondition(OMGAI_EventTriggers[eventType], Condition(callback))
    endfunction

    // 触发事件（payload 在调用前填入全局变量）
    function OMGAIEventDispatcher_Fire takes integer eventType returns nothing
        if eventType < 1 or eventType > 31 then
            call OMGAILogger_E("EvtDisp", "Fire: invalid eventType=" + I2S(eventType))
            return
        endif
        if OMGAI_EventTriggers[eventType] == null then
            return
        endif
        call TriggerEvaluate(OMGAI_EventTriggers[eventType])
    endfunction

    // 清空 payload（回调结束后调用，避免脏读）
    function OMGAIEventDispatcher_ClearPayload takes nothing returns nothing
        set OMGAI_EvtPayloadInt1   = 0
        set OMGAI_EvtPayloadInt2   = 0
        set OMGAI_EvtPayloadUnit    = null
        set OMGAI_EvtPayloadPlayer = null
        set OMGAI_EvtPayloadStr    = ""
    endfunction


//library OMGAIEventDispatcher ends
