call GroupEnumUnitsOfPlayer(g,p,Condition(function U3F))
call ForGroup(g,function UCF)
call WR7(g)
set g=null
endfunction
function ULF takes nothing returns nothing
local unit p5=GetTriggerUnit()
local unit oA
local integer T7F=(OM7(GetHandleId(p5),"QuasLevel"))
local integer S0F=(OM7(GetHandleId(p5),"ExortLevel"))
local integer id=GetUnitTypeId(p5)
local integer skillmj
local string skilltx
local real d
local real d2=GetUnitDefaultMoveSpeed(p5)+I2R(U3V(p5))
if id=='Z10U' then
set skillmj='n127'
set skilltx="model\\hero_invoker_n3s_f_effect.mdl"
elseif id=='Z20U' then
set skillmj='n027'
set skilltx="model\\hero_invoker_n2s_f_effect.mdl"
else
set skillmj='n027'
set skilltx="Abilities\\Spells\\Orc\\FeralSpirit\\feralspiritdone.mdl"
endif
if SUIJI_MODE==false then
call U6F(GetOwningPlayer(p5))
endif
set oA=CreateUnit(GetOwningPlayer(p5),skillmj,GetUnitX(p5),GetUnitY(p5),GetUnitFacing(p5))
set d=GetUnitDefaultMoveSpeed(oA)
if d2>d then
call SetUnitMoveSpeed(oA,R2I(d2))
endif
call SetUnitColor(oA,GetPlayerColor(Z7[0]))
call DestroyEffect(AddSpecialEffectTarget(skilltx,oA,"chest"))
call UnitApplyTimedLife(oA,'BTLF',10+10*T7F)
call SetUnitAbilityLevel(oA,'A0VV',S0F)
call UBF(oA)
if Ab[GetPlayerId(GetOwningPlayer(p5))]then
call SelectUnitAddForPlayer(oA,GetOwningPlayer(p5))
endif
if T7F>3 and S0F>3 then
set oA=CreateUnit(GetOwningPlayer(p5),skillmj,GetUnitX(p5),GetUnitY(p5),GetUnitFacing(p5))
set d=GetUnitDefaultMoveSpeed(oA)
if d2>d then
call SetUnitMoveSpeed(oA,R2I(d2))
endif
call SetUnitColor(oA,GetPlayerColor(Z7[0]))
call DestroyEffect(AddSpecialEffectTarget(skilltx,oA,"chest"))
call UnitApplyTimedLife(oA,'BTLF',10+10*T7F)
call SetUnitAbilityLevel(oA,'A0VV',S0F)
call UBF(oA)
if Ab[GetPlayerId(GetOwningPlayer(p5))]then
call SelectUnitAddForPlayer(oA,GetOwningPlayer(p5))
endif
endif
call SetPlayerTechResearched(GetOwningPlayer(p5),'R00G',S0F)
call SetPlayerTechResearched(GetOwningPlayer(p5),'R00H',T7F)
set p5=null
set oA=null
endfunction
