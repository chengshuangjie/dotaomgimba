function VEF takes nothing returns nothing
local unit u=GetEnumUnit()
if GetPlayerController(GetOwningPlayer(u))==MAP_CONTROL_COMPUTER and IsUnitType(u, UNIT_TYPE_HERO) and HTMD then
    call MSF(u,IN4,1)
endif
call B67(IN4,u,7,IJ4)
if AI_Send_Msg and IS_AI(IN4) and IS_HUMAN(u) and IsUnitType(u, UNIT_TYPE_HERO) and UnitAlive(u)==false then
	set AI_Send_Msg=false
