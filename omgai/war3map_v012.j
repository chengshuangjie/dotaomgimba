function EED takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local real x=0.
local real y=0.
local unit BB7=(LoadUnitHandle(L7,(I97),(19)))
local integer level=(LoadInteger(L7,(I97),(20)))
local integer songSkill=(LoadInteger(L7,(I97),(21)))
local real songStart=(LoadReal(L7,(I97),(22)))
local real songCooldown=(LoadReal(L7,(I97),(23)))
local real songCooldownLeft=0.
local group g
local group BQ9=(LoadGroupHandle(L7,(I97),($BB)))
local boolexpr suijiNagaSongEnemyFilter=null
local boolexpr suijiNagaSongScepterFilter=null
if ZX7==null or BB7==null or BQ9==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(BB7)==0 then
if BQ9!=null then
call WR7(BQ9)
endif
if BB7!=null and GetUnitTypeId(BB7)!=0 then
call RemoveUnit(BB7)
endif
call FlushChildHashtable(L7,(I97))
call OZ7(t)
set t=null
set ZX7=null
set BB7=null
set BQ9=null
set suijiNagaSongEnemyFilter=null
set suijiNagaSongScepterFilter=null
return false
endif
set x=GetUnitX(ZX7)
set y=GetUnitY(ZX7)
if GetTriggerEvalCount(t)==$A then
call XF7(ZX7,'A24E')
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A07U',false)
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A2SR',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A24E',true)
endif
if GetTriggerEventId()==EVENT_WIDGET_DEATH or GetTriggerEvalCount(t)>80+level*20 or (GetTriggerEventId()==EVENT_UNIT_SPELL_EFFECT and B287_GetSpellAbilityId()=='A24E') then
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A07U',true)
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A2SR',true)
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A24E',false)
if songSkill=='A07U' or songSkill=='A2SR' then
set songCooldownLeft=songCooldown-(TimerGetElapsed(W)-songStart)
if songCooldownLeft>0. then
call MHAbility_SetCooldown(ZX7,songSkill,songCooldownLeft)
endif
endif
call ForGroup(BQ9,function E9D)
call WR7(BQ9)
call RemoveUnit(BB7)
call DestroyEffect((LoadEffectHandle(L7,(I97),(32))))
if SUIJI_MODE then
call RemoveSavedHandle(L7,GetHandleId(ZX7),StringHash("SuijiNagaSongTrigger"))
call RemoveSavedReal(L7,GetHandleId(ZX7),StringHash("SuijiNagaSongActiveUntil"))
endif
call FlushChildHashtable(L7,(I97))
call OZ7(t)
else
set g=WS7()
set IN4=ZX7
set YN4=ZX7
set YO4=BB7
set YP4=BQ9
set suijiNagaSongEnemyFilter=Condition(function A77)
call GroupEnumUnitsInRange(g,x,y,$4E2+25,suijiNagaSongEnemyFilter)
call DestroyBoolExpr(suijiNagaSongEnemyFilter)
call ForGroup(g,function EDD)
set YQ4=g
set YR4=WS7()
call ForGroup(BQ9,function E8D)
call GroupRemoveGroup(YR4,BQ9)
if SuijiMode_HasAghanimState(ZX7) then
set suijiNagaSongScepterFilter=Condition(function XYI)
call GroupEnumUnitsInRange(g,x,y,$4E2+25,suijiNagaSongScepterFilter)
call DestroyBoolExpr(suijiNagaSongScepterFilter)
call ForGroup(g,function XWI)
endif
call WR7(g)
call WR7(YR4)
endif
set t=null
set g=null
set ZX7=null
set BQ9=null
set BB7=null
set suijiNagaSongEnemyFilter=null
set suijiNagaSongScepterFilter=null
return false
endfunction
function EFD takes nothing returns nothing
local trigger t=null
local integer I97=0
local unit ZX7=GetTriggerUnit()
local real x=0.
local real y=0.
local unit BB7=null
local integer level=0
local integer songSkill=B287_GetSpellAbilityId()
local integer songCooldownSkill=0
local real songCooldown=0.
local real songCooldownFactor=0.
local integer suijiNagaSongCasterHandle=0
if ZX7==null or GetUnitTypeId(ZX7)==0 then
set ZX7=null
return
endif
set level=SuijiMode_GetPairCastLevel(ZX7,songSkill,'A07U','A2SR')
if level<1 then
set level=1
elseif level>3 then
set level=3
endif
if SUIJI_MODE then
set suijiNagaSongCasterHandle=GetHandleId(ZX7)
if LoadTriggerHandle(L7,suijiNagaSongCasterHandle,StringHash("SuijiNagaSongTrigger"))!=null or LoadReal(L7,suijiNagaSongCasterHandle,StringHash("SuijiNagaSongActiveUntil"))>TimerGetElapsed(W) then
set ZX7=null
return
endif
call SaveReal(L7,suijiNagaSongCasterHandle,StringHash("SuijiNagaSongActiveUntil"),TimerGetElapsed(W)+8.)
endif
set x=GetUnitX(ZX7)
set y=GetUnitY(ZX7)
set t=CreateTrigger()
set I97=GetHandleId(t)
set BB7=CreateUnit(GetOwningPlayer(ZX7),'e00E',x,y,0)
call UnitApplyTimedLife(BB7,'BTLF',9.)
if SuijiMode_HasAghanimState(ZX7) then
set songCooldownSkill='A2SR'
else
set songCooldownSkill='A07U'
endif
set songCooldown=MHAbility_GetLevelDefDataReal(songCooldownSkill,level,ABILITY_LEVEL_DEF_DATA_COOLDOWN)
set songCooldownFactor=ReduceUnitAbilityCoolDownReal(ZX7)
if songCooldownFactor>0. and songCooldown>0. then
set songCooldown=songCooldown*songCooldownFactor
endif
call UnitAddAbility(BB7,'A07T')
call TriggerRegisterTimerEvent(t,.05,true)
call TriggerRegisterDeathEvent(t,ZX7)
call TriggerRegisterUnitEvent(t,ZX7,EVENT_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function EED))
call SaveGroupHandle(L7,(I97),($BB),(WS7()))
call SaveUnitHandle(L7,(I97),(2),(ZX7))
call SaveUnitHandle(L7,(I97),(19),(BB7))
call SaveInteger(L7,(I97),(20),(level))
call SaveInteger(L7,(I97),(21),(songSkill))
call SaveReal(L7,(I97),(22),(TimerGetElapsed(W)))
call SaveReal(L7,(I97),(23),(songCooldown))
call SaveEffectHandle(L7,(I97),(32),(AddSpecialEffectTarget("war3mapImported\\SongOfTheSiren_2.mdx",ZX7,"origin")))
if SUIJI_MODE then
call SaveTriggerHandle(L7,suijiNagaSongCasterHandle,StringHash("SuijiNagaSongTrigger"),t)
endif
set t=null
set ZX7=null
set BB7=null
endfunction
