function OmgSkipLoadPressAnyKey takes nothing returns nothing
local timer t=GetExpiredTimer()
if GetLocalPlayer()!=null then
call ForceUICancel()
endif
call DestroyTimer(t)
set t=null
endfunction

globals
//globals from OMGAIConfig:
constant boolean LIBRARY_OMGAIConfig=true
    // ---- 版本与模式 ----------------------------------------------------------
    constant string  OMGAI_VERSION               = "0.1.0-mvp"
    constant boolean OMGAI_DEBUG                 = true        // 开发期开启详细日志
    constant boolean OMGAI_CRASHLOG_ENABLED      = false       // 崩溃日志 P2 上线，先留桩

    // ---- 玩家槽位 -----------------------------------------------------------
    // 1-5 天灾，6-10 近卫（人类槽位）；11-12 留观战；16-26 AI 槽位
    constant integer OMGAI_MAX_HUMAN_PLAYERS     = 10
    constant integer OMGAI_AI_SLOT_START         = 16          // 与 vcccv 工程 AI 习惯对齐

    // ---- 4+2 技能系统（PRD 4.1.3 关键规则）----------------------------------
    constant integer OMGAI_HERO_FIXED_SKILL_COUNT = 4           // 英雄固定技能数（3小+1大）
    constant integer OMGAI_HERO_FIXED_SMALL_COUNT = 3
    constant integer OMGAI_HERO_FIXED_BIG_COUNT   = 1
    constant integer OMGAI_EXTRA_SMALL_COUNT      = 1           // 额外选 1 小
    constant integer OMGAI_EXTRA_BIG_COUNT        = 1           // 额外选 1 大
    constant integer OMGAI_TOTAL_SKILL_SLOTS      = 6           // 4小+2大 = 6 槽
    constant integer OMGAI_OFFER_COUNT            = 8           // 每次随机发 8 个

    // ---- 转技能次数（PRD 4.1.2 / 4.2）--------------------------------------
    constant integer OMGAI_FREE_RESPIN_PER_PHASE = 3           // 每阶段免费 3 次/局
    constant string  OMGAI_VOUCHER_ITEM_KEY      = "omgai_reskin_voucher"  // KK 商城道具 key

    // ---- 技能池规模（T02 起步）-----------------------------------------------
    constant integer OMGAI_SKILL_POOL_MVP_SIZE   = 80           // MVP 起步 60-80 个技能

    // ---- 时序与心跳 ---------------------------------------------------------
    constant real    OMGAI_TIMER_TICK_INTERVAL   = 0.10         // 全局心跳周期（秒）
    constant real    OMGAI_AI_HEARTBEAT_INTERVAL = 0.10         // AI 决策频率
    constant real    OMGAI_AI_WATCHDOG_TIMEOUT    = 5.00         // AI 卡死超时（借鉴竞品 -aiunstuck）
    constant real    OMGAI_SELECT_PHASE_TIMEOUT  = 120.0        // 选技能每阶段超时（秒）

    // ---- 内存与性能 ---------------------------------------------------------
    constant real    OMGAI_LEAK_CHECK_INTERVAL  = 60.0         // 内存泄漏扫描周期
    constant integer OMGAI_MAX_CONCURRENT_GAMES  = 10           // 连续运行验证局数

    // ---- 平台类型枚举（用整数代替真实 enum，避免 vJASS 限制）--------------
    constant integer OMGAI_PLATFORM_UNKNOWN     = 0
    constant integer OMGAI_PLATFORM_KK          = 1
    constant integer OMGAI_PLATFORM_11         = 2

    // ---- AI 原型枚举 --------------------------------------------------------
    constant integer OMGAI_ARCH_NONE           = 0
    constant integer OMGAI_ARCH_BURST_MAGE     = 1
    constant integer OMGAI_ARCH_TANK_CONTROL  = 2
    constant integer OMGAI_ARCH_CORE_SUSTAIN  = 3
    constant integer OMGAI_ARCH_ROAM_ASSASSIN = 4
    constant integer OMGAI_ARCH_SUPPORT_CTRL   = 5

    // ---- SelectPhase 状态枚举 ----------------------------------------------
    constant integer OMGAI_PHASE_INIT         = 0
    constant integer OMGAI_PHASE_SELECT_SMALL = 1
    constant integer OMGAI_PHASE_SELECT_BIG   = 2
    constant integer OMGAI_PHASE_DONE        = 3

    // ---- 事件类型常量（OMGAI 内部事件总线）----------------------------------
    constant integer OMGAI_EVT_SKILL_GRANTED     = 1   // 技能赋予完成
    constant integer OMGAI_EVT_RESPIN_DONE       = 2   // 转技能完成
    constant integer OMGAI_EVT_SELECT_DONE       = 3   // 整个 4+2 选技能完成
    constant integer OMGAI_EVT_AI_HEARTBEAT     = 4   // AI 心跳
    constant integer OMGAI_EVT_AI_STUCK          = 5   // AI 卡死警告
    constant integer OMGAI_EVT_UNIT_TRANSFORM    = 6   // 单位变身（守卫触发）
    constant integer OMGAI_EVT_UNIT_ILLUSION     = 7   // 单位分身（守卫触发）
    constant integer OMGAI_EVT_PURCHASE_OK       = 8   // 充值成功
    constant integer OMGAI_EVT_PURCHASE_CANCEL   = 9   // 取消充值

    // ---- KKAPI 接口探测 -----------------------------------------------------
    // 运行时若 DzAPI_Map_SaveServerData 等函数符号存在则判定为 KK 平台
    // 探测通过 try-catch（vJASS 不支持，用 SystemError 是否抛出来判定）
    // 简化方案：用内存特征检测 - DzGetClientPlayerId 在 KK 平台返回有效玩家 ID
    constant integer OMGAI_PLATFORM_PROBE_PLAYER = 0  // 占位，OMGAIPlatformFactory 运行时填充
//endglobals from OMGAIConfig
//globals from OMGAICore:
constant boolean LIBRARY_OMGAICore=true
    constant integer BEH_FARM     = 1
    constant integer BEH_JUNGLE   = 2
    constant integer BEH_GANK     = 3
    constant integer BEH_PUSH     = 4
    constant integer BEH_DEFEND   = 5
    constant integer BEH_TEAM     = 6
    constant integer BEH_RETREAT  = 7
    constant integer BEH_WARD     = 8
    constant integer BEH_SHOP     = 9

    // 高优硬状态（不进 desire 竞选，直接短路）
    constant integer ST_DEAD      = 10
    constant integer ST_HOME      = 11
    constant integer ST_BUYBACK   = 12
    constant integer ST_ASSEMBLE  = 13
    constant integer ST_TAKEOVER  = 14

    // 技能 targetType（8 类，对应方案 §4.3 / §7.3）
    constant integer TT_POINT     = 1
    constant integer TT_AREA      = 2
    constant integer TT_UNIT      = 3
    constant integer TT_NO_TARGET = 4
    constant integer TT_ALLY      = 5
    constant integer TT_SELF      = 6
    constant integer TT_CORPSE    = 7
    constant integer TT_TOGGLE    = 8

    // 职业分类（对应 D1 aiGetClass 6 类）
    constant integer CLS_CARRY    = 0
    constant integer CLS_FIGHTER  = 1
    constant integer CLS_TANKER   = 2
    constant integer CLS_SUPPORT  = 3
    constant integer CLS_NUKER    = 4
    constant integer CLS_PUSHER   = 5

    // AI 单位上限（护栏 8：单位数治理）
    constant integer MAX_AI_UNITS = 12
    // 单 tick 枚举上限（护栏 2 / P2）
    constant integer GUARD_ENUM_MAX = 256
    // 递归深度上限（P2）
    constant integer GUARD_RECUR_MAX = 8

    // 心跳周期（秒）
    constant real    AI_TICK_INTERVAL  = 0.40
    // desire 防抖滞回带（方案 §5.2）
    constant real    DESIRE_HYSTERESIS = 0.15
    // 行为最小持续时长（秒）
    constant real    BEHAVIOR_MIN_HOLD = 0.80
    // 发呆看门狗阈值（秒）
    constant real    IDLE_TIMEOUT      = 2.50

//---------------------------------------------------------------------------
// 1. 全局 handle 表
//   主表 OMGAI_H 为 AI 数据唯一载体（hashtable），key 分配见方案 §4.1
//---------------------------------------------------------------------------

    hashtable OMGAI_H = null
    boolean   inited = false

    // 单位表（AI 登记的英雄列表）
    unit array AIUnitTable

    // 数组访问校验计数（P3 观测用）
    integer array arrGuardHits

//---------------------------------------------------------------------------
// 2. AIHeroState struct（方案 §4.2）
//   实际落地：hashtable 为主载体（1.27 无原生 struct 持久化），
//   struct 仅作编译期类型组织；读写全部走 OMGAI_Load/Save 函数。
//---------------------------------------------------------------------------

    constant integer GSLOT_MATCHMODE    = 0
    constant integer GSLOT_DIFFICULTY   = 1
    constant integer GSLOT_INVIS_ENEMY  = 2
    constant integer GSLOT_THREAT_SORT  = 3   // 敌方威胁排序缓存（5 个 heroId 从 3 起连续 5 槽）
    constant integer GSLOT_GUARD_ENUM   = 9   // 枚举计数
    constant integer GSLOT_GUARD_RECUR  = 10  // 递归深度
    constant integer GSLOT_CRASH_FLAG   = 11  // 崩溃转储标记

//---------------------------------------------------------------------------
// 4. 主表初始化
//---------------------------------------------------------------------------

    timer CORE_TIMER = null

//endglobals from OMGAICore
//globals from OMGAIGlobals:
constant boolean LIBRARY_OMGAIGlobals=true

        // ---- 平台检测结果（OMGAIPlatformFactory.init 后填充）-----------------
        integer OMGAI_CurrentPlatform       = OMGAI_PLATFORM_UNKNOWN
        boolean OMGAI_IsCommercialEnabled   = false        // 商业化是否启动（11平台 false）

        // ---- 模块初始化状态 -------------------------------------------------
        boolean OMGAI_Initialized           = false

        // ---- 主心跳定时器句柄 -----------------------------------------------
        timer OMGAI_MainTimer               = null
        integer OMGAI_TickCount             = 0          // 总心跳计数（10Hz，约 0.1s/tick）

        // ---- 事件分发器句柄（OMGAIEventDispatcher 用）-----------------------
        trigger array OMGAI_EventTriggers    // 每个事件类型一个 trigger（OMGAI_EVT_*，上限 32）

        // ---- 选技能阶段超时句柄 ---------------------------------------------
        timer OMGAI_SelectPhaseTimer        = null
        boolean OMGAI_SelectPhaseTimedOut   = false

        // ---- AI 心跳注册表 --------------------------------------------------
        // 每个 AI 单位注册一个 heartbeat，watchdog 周期检查
        unit   array OMGAI_AIUnits           // index 1..24
        real   array OMGAI_AIHeartbeats      // 上次心跳时间戳
        integer OMGAI_AICount                = 0

        // ---- 内存泄漏审计 ---------------------------------------------------
        integer OMGAI_HandleCreated         = 0     // 开发期统计
        integer OMGAI_HandleDestroyed      = 0
        integer OMGAI_LeakCheckCounter      = 0

        // ---- 调试与崩溃日志 ------------------------------------------------
        integer OMGAI_ErrorCount            = 0
        string array OMGAI_LastErrors      // 环形缓冲，最近 8 条
        integer OMGAI_LastErrorIndex        = 0

//endglobals from OMGAIGlobals
//globals from OMGAILog:
constant boolean LIBRARY_OMGAILog=true
constant integer LOG_LV_DEBUG = 0
constant integer LOG_LV_INFO  = 1
constant integer LOG_LV_WARN  = 2
constant integer LOG_LV_ERROR = 3
constant integer LOG_LV_FATAL = 4

    // 生产环境日志级别（调参/测试可改 LOG_INFO 或 LOG_DEBUG）
    constant integer LOG_LEVEL_PROD = LOG_LV_WARN

    // 环形缓冲大小
    constant integer LOG_RING_SIZE = 128

    // 环形缓冲
    string  array LOG_MSG
    integer array LOG_LV
    real    array LOG_TIME
    integer LOG_HEAD = 0
    integer LOG_TAIL = 0
    integer LOG_COUNT = 0

    // 崩溃转储阈值：连续 ERROR 数
    constant integer CRASH_ERROR_THRESHOLD = 3

    // 游戏时间获取：统一用 OMGAICore 的 OMGAI_GetGameTime()（1.27 兼容）

//---------------------------------------------------------------------------
// 2. 初始化
//---------------------------------------------------------------------------

    gamecache LOG_CACHE = null

//endglobals from OMGAILog
//globals from OMGAISkillTag:
constant boolean LIBRARY_OMGAISkillTag=true
        // ---- 伤害维度标签（位掩码）-------------------------------------
        constant integer STAG_DMG_PHYSICAL = 0x00000001   // 1
        constant integer STAG_DMG_MAGICAL  = 0x00000002   // 2
        constant integer STAG_DMG_PURE      = 0x00000004   // 4
        constant integer STAG_BURST_HIGH   = 0x00000008   // 8  爆发高分
        constant integer STAG_SUSTAIN_HIGH = 0x00000010   // 16 持续输出高分

        // ---- 控制维度标签 -----------------------------------------------
        constant integer STAG_CTRL_STUN     = 0x00000020   // 32  眩晕
        constant integer STAG_CTRL_SLOW     = 0x00000040   // 64  减速
        constant integer STAG_CTRL_SILENCE  = 0x00000080   // 128 沉默
        constant integer STAG_CTRL_ROOT     = 0x00000100   // 256 缠绕
        constant integer STAG_CTRL_DISARM  = 0x00000200   // 512 缴械
        constant integer STAG_CTRL_FEAR     = 0x00000400   // 1024 恐惧

