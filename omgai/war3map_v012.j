function LK_CHECK2 takes nothing returns nothing
local unit ZX7=GetEnumUnit()
local integer OB7=GetHandleId(ZX7)
local real d
local real cooldown=13.
if (IsUnitType(ZX7,UNIT_TYPE_HERO) or AS7(ZX7)) and GetUnitTypeId(ZX7)!='H00J' and IsUnitIllusion(ZX7)==false and GetUnitAbilityLevel(ZX7,'A2RV')>0 and OO7(GetHandleId(ZX7),"FSING")==false then
    if WQ7(ZX7)==false then
        set d=LoadReal(TABLE_HY, OB7, 'link')
        if GetUnitAbilityLevel(ZX7,'A2VW')>0 then
            set cooldown=cooldown*.75
        endif
        if d==0 and LoadBoolean(TABLE_HY, OB7, 'link') then
            call Japi_ReduceUnitAbilityCoolDown(ZX7,'A2RV',cooldown)
            call SaveReal(TABLE_HY, OB7, 'link', cooldown)
            call SaveBoolean(TABLE_HY, OB7, 'link', false)
            call UnitRemoveAbility(ZX7,'A4KS')
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\DispelMagic\\DispelMagicTarget.mdl",ZX7,"origin"))
        elseif d>0 then
            set d=RMaxBJ(d-0.1,0)
            call SaveReal(TABLE_HY, OB7, 'link', d)
        elseif d==0 and LoadBoolean(TABLE_HY, OB7, 'link')==false then
call F71(ZX7,'I0HM')
            call XF7(ZX7,'A4KS')
            call SaveBoolean(TABLE_HY, OB7, 'link', true)
        endif
    endif
endif
set ZX7=null
endfunction
function LK_CHECK takes nothing returns boolean
    local group g=WS7()
    call GroupAddGroup(PlayerUnitGroup,g)
    call ForGroup(g,function LK_CHECK2)
    call WR7(g)
    set g=null
    return false
endfunction
