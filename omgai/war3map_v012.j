//---------------------------------------------------------------------------
// 0. 全局常量
//---------------------------------------------------------------------------

    // 行为 ID（L2 行为模块）
    struct AIHeroState
        integer heroId          // GetHandleId(unit)
        integer behaviorId      // 当前行为 BEH_*
        real    behaviorDesire  // 当前行为 desire
        real    switchTime      // 距上次切换（游戏时间）
        real    idleTimer       // 发呆计时
        integer cancelCount     // 施法取消计数
        real    softCooldown    // 单位级软冷却截止时间
        real    lastHurtTime    // 受击时间戳
        boolean assembling      // 集结等待
        integer currentTarget   // 最近目标（handle id）
        integer focusTarget     // 集火目标（handle id）
        integer posW1
        integer posW2
        integer posW3
        integer posW4
        integer posW5
        integer classId         // CLS_*
        integer lanePlan        // 分路计划（1 上 / 2 中 / 3 下）
        integer hurtBy          // 当前仇恨对象（handle id）
    endstruct

//---------------------------------------------------------------------------
// 3. hashtable key 分配（方案 §4.1，保持与文档一致）
//   主键 = 单位 handle id
//   二级 key = 槽位：
//   0..4   行为状态（0=behaviorId 1=behaviorDesire 2=switchTime 3=idleTimer 4=cancelCount）
//   5       软冷却截止时间
//   6       受击时间戳
//   7       集结标记
//   8       最近目标
//   9       集火目标
//   10      位置权重数组起点（10..14）
//   15      职业 / 16 分路
//   17      仇恨对象
//   二级主键 = 全局索引（0 固定全局，1..5 玩家槽，6=护盾计数 7=枚举计数 8=递归深度）
//---------------------------------------------------------------------------

    // 全局槽（二级主键 0）
    function OMGAICore_OMGAICore_Init takes nothing returns boolean
        if inited then
            return true
        endif
        set OMGAI_H = InitHashtable()
        if OMGAI_H == null then
            return false
        endif
        // 统一游戏时间源（供全部 AI 库使用，避免各自 null timer）
        set CORE_TIMER = CreateTimer()
        call TimerStart(CORE_TIMER, 999999.0, false, null)
        set inited = true
        return true
    endfunction

    function OMGAICore_OMGAICore_IsInited takes nothing returns boolean
        return inited
    endfunction

    // 统一游戏时间（秒）：所有 AI 库的时间戳应使用本函数
    function OMGAICore_OMGAI_GetGameTime takes nothing returns real
        if CORE_TIMER == null then
            return 0.0
        endif
        return TimerGetElapsed(CORE_TIMER)
    endfunction

    // 主表公开 getter（供 OMGAIEnemyState/OMGAIGuard 等做 FlushChildHashtable）
    function OMGAICore_OMGAI_GetHash takes nothing returns hashtable
        return OMGAI_H
    endfunction

//---------------------------------------------------------------------------
// 5. 状态读写封装（全部走 hashtable，P3 数组/索引越界统一校验入口）
//---------------------------------------------------------------------------

    function OMGAICore_OMGAI_LoadInt takes integer heroId, integer slot returns integer
        if heroId == 0 or OMGAI_H == null then
            return 0
        endif
        return LoadInteger(OMGAI_H, heroId, slot)
    endfunction

    function OMGAICore_OMGAI_SaveInt takes integer heroId, integer slot, integer value returns nothing
        if heroId == 0 or OMGAI_H == null then
            return
        endif
        call SaveInteger(OMGAI_H, heroId, slot, value)
    endfunction

    function OMGAICore_OMGAI_LoadReal takes integer heroId, integer slot returns real
        if heroId == 0 or OMGAI_H == null then
            return 0.0
        endif
        return LoadReal(OMGAI_H, heroId, slot)
    endfunction

    function OMGAICore_OMGAI_SaveReal takes integer heroId, integer slot, real value returns nothing
        if heroId == 0 or OMGAI_H == null then
            return
        endif
        call SaveReal(OMGAI_H, heroId, slot, value)
    endfunction

    function OMGAICore_OMGAI_LoadBool takes integer heroId, integer slot returns boolean
        if heroId == 0 or OMGAI_H == null then
            return false
        endif
        return LoadBoolean(OMGAI_H, heroId, slot)
    endfunction

    function OMGAICore_OMGAI_SaveBool takes integer heroId, integer slot, boolean value returns nothing
        if heroId == 0 or OMGAI_H == null then
            return
        endif
        call SaveBoolean(OMGAI_H, heroId, slot, value)
    endfunction

    // ---- V2: unit handle 存取（战术层秒杀目标/蹲守目标恢复用）----
    function OMGAICore_OMGAI_SaveUnitHandle takes integer heroId, integer slot, unit u returns nothing
        if heroId == 0 or OMGAI_H == null then
            return
        endif
        call SaveUnitHandle(OMGAI_H, heroId, slot, u)
    endfunction

    function OMGAICore_OMGAI_LoadUnitHandle takes integer heroId, integer slot returns unit
        if heroId == 0 or OMGAI_H == null then
            return null
        endif
        return LoadUnitHandle(OMGAI_H, heroId, slot)
    endfunction

    // 全局槽读写（二级主键 = GLOBAL_KEY）
    function OMGAICore_OMGAI_LoadGlobalInt takes integer slot returns integer
        if OMGAI_H == null then
            return 0
        endif
        return LoadInteger(OMGAI_H, 0, slot)
    endfunction

    function OMGAICore_OMGAI_SaveGlobalInt takes integer slot, integer value returns nothing
        if OMGAI_H == null then
            return
        endif
        call SaveInteger(OMGAI_H, 0, slot, value)
    endfunction

    function OMGAICore_OMGAI_LoadGlobalBool takes integer slot returns boolean
        if OMGAI_H == null then
            return false
        endif
        return LoadBoolean(OMGAI_H, 0, slot)
    endfunction

    function OMGAICore_OMGAI_SaveGlobalBool takes integer slot, boolean value returns nothing
        if OMGAI_H == null then
            return
        endif
        call SaveBoolean(OMGAI_H, 0, slot, value)
    endfunction

//---------------------------------------------------------------------------
// 6. 单位表管理（护栏 8 + P1 句柄清理配合）
//---------------------------------------------------------------------------

    function OMGAICore_OMGAICore_RegisterUnit takes unit u returns integer
        local integer i = 0
        if u == null then
            return -1
        endif
        loop
            exitwhen i >= MAX_AI_UNITS
            if AIUnitTable[i] == null then
                set AIUnitTable[i] = u
                return i
            endif
            set i = i + 1
        endloop
        return -1
    endfunction

    function OMGAICore_OMGAICore_UnregisterUnit takes unit u returns nothing
        local integer i = 0
        if u == null then
            return
        endif
        loop
            exitwhen i >= MAX_AI_UNITS
            if AIUnitTable[i] == u then
                // P1：清理该单位全部 hashtable 条目（句柄生命周期）
                call FlushChildHashtable(OMGAI_H, GetHandleId(u))
                set AIUnitTable[i] = null
                return
            endif
            set i = i + 1
        endloop
    endfunction

    function OMGAICore_OMGAICore_GetUnitTable takes integer index returns unit
        if index < 0 or index >= MAX_AI_UNITS then
            return null
        endif
        return AIUnitTable[index]
    endfunction

