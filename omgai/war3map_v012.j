function IDD takes nothing returns boolean
local trigger t2=GetTriggeringTrigger()
local integer IED=GetHandleId(t2)
local trigger t1=OE7(IED,"t1")
local integer IFD=GetHandleId(t1)
local unit IGD=O77(IED,"Remnant")
local unit p5=O77(IED,"HERO")
local group g
local integer BC7=OM7(IED,"Level")
local integer id=OM7(IED,"ID")
if GetTriggerEventId()==EVENT_UNIT_DEATH then
call ShowUnit(IGD,false)
call KillUnit(IGD)
call NM7(IFD)
call OZ7(t1)
call NM7(IED)
call OZ7(t2)
elseif IsUnitEnemy(GetTriggerUnit(),GetOwningPlayer(IGD)) and IsUnitType(GetTriggerUnit(),UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(GetTriggerUnit(),'A04R')==0 then
set g=WS7()
set IN4=IGD
set RT4=p5
set RU4=100+40*BC7
call GroupEnumUnitsInRange(g,GetUnitX(IGD),GetUnitY(IGD),285,Condition(function AJ7_gai))
call ForGroup(g,function I9D)
call WR7(g)
call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\Bolt\\BoltImpact.mdl",GetUnitX(IGD),GetUnitY(IGD)))
call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\Bolt\\BoltImpact.mdl",GetUnitX(IGD),GetUnitY(IGD)))
call ShowUnit(IGD,false)
call KillUnit(IGD)
call NM7(IFD)
call OZ7(t1)
call NM7(IED)
call OZ7(t2)
endif
set t1=null
set t2=null
set IGD=null
set g=null
return false
endfunction
function IHD takes nothing returns boolean
local trigger t1=GetTriggeringTrigger()
local integer IID=GetHandleId(t1)
local trigger t2
local integer UB9
local unit IJD
local integer V77
local real x=ON7(IID,"x")
local real y=ON7(IID,"y")
local real IKD
local integer U38=GetTriggerEvalCount(t1)
local integer id=OM7(IID,"ID")
local string tx
local unit u=O77(IID,"Source")
if U38==1 then
call DestroyEffect(OG7(IID,"FX1"))
elseif U38==2 then
call DestroyEffect(OG7(IID,"FX2"))
set t2=CreateTrigger()
set UB9=GetHandleId(t2)
set V77=OM7(IID,"Level")
set IKD=ON7(IID,"Facing")
set IJD=CreateUnit(GetOwningPlayer(u),'h07F',x,y,IKD)
if id=='Z00S' then
call MHUnit_SetModel(IJD,"model\\Hero_STormSpirit_N6S_R_Hero.mdl",false)
set tx="model\\Hero_STormSpirit_N6S_R_Start_3.mdl"
elseif id=='Z10S' then
call MHUnit_SetModel(IJD,"model\\Hero_STormSpirit_N4S_R_Hero.mdl",false)
set tx="model\\Hero_STormSpirit_N4S_R_Start_3.mdl"
elseif id=='Z20S' then
call MHUnit_SetModel(IJD,"model\\Hero_STormSpirit_N8S_R_Hero.mdl",false)
set tx="model\\Hero_STormSpirit_N8S_R_Start_3.mdl"
else
call SetUnitVertexColor(IJD,$FF,$FF,$FF,100)
set tx="effects\\ManaFlareBoltImpact_NoSound.mdx"
endif
call UnitApplyTimedLife(IJD,'BTLF',12)
call NT7(IID,"Remnant",IJD)
call NT7(UB9,"Remnant",IJD)
call NT7(UB9,"HERO",u)
call NV7(UB9,"t1",t1)
call NP7(UB9,"Level",V77)
call NP7(UB9,"ID",id)
call TriggerRegisterUnitInRange(t2,IJD,235,Condition(function TO7))
call TriggerRegisterUnitEvent(t2,IJD,EVENT_UNIT_DEATH)
call TriggerAddCondition(t2,Condition(function IDD))
call DestroyEffect(AddSpecialEffectTarget(tx,IJD,"origin"))
elseif U38>2 then
set IJD=O77(IID,"Remnant")
call DestroyEffect(AddSpecialEffectTarget(tx,IJD,"origin"))
endif
set t1=null
set t2=null
set IJD=null
set u=null
return false
endfunction
function IMD takes nothing returns nothing
local unit p5=GetTriggerUnit()
local trigger t1=CreateTrigger()
local integer IID=GetHandleId(t1)
local real x=GetUnitX(p5)
local real y=GetUnitY(p5)
local integer id=GetUnitTypeId(p5)
local string tx
local string tx2
call TriggerRegisterTimerEvent(t1,.5,true)
call TriggerAddCondition(t1,Condition(function IHD))
call NQ7(IID,"x",(x)*1.)
call NQ7(IID,"y",(y)*1.)
call NP7(IID,"Level",B287_GetUnitAbilityLevel(p5,'A14P'))
call NP7(IID,"ID",id)
call NT7(IID,"Source",p5)
call NQ7(IID,"Facing",GetUnitFacing(p5)*1.)
if id=='Z00S' then
set tx="model\\Hero_STormSpirit_N6S_R_Start_1.mdl"
set tx2="model\\Hero_STormSpirit_N6S_R_Start_2.mdl"
elseif id=='Z10S' then
set tx="model\\Hero_STormSpirit_N4S_R_Start_1.mdl"
set tx2="model\\Hero_STormSpirit_N4S_R_Start_2.mdl"
elseif id=='Z20S' then
set tx="model\\Hero_STormSpirit_N8S_R_Start_1.mdl"
set tx2="model\\Hero_STormSpirit_N8S_R_Start_2.mdl"
else
set tx="Abilities\\Spells\\Orc\\LightningShield\\LightningShieldTarget.mdl"
set tx2="effects\\Static_Remnant_FX.mdx"
endif
call NU7(IID,"FX1",AddSpecialEffect(tx,x,y))
call NU7(IID,"FX2",AddSpecialEffect(tx2,x,y))
set p5=null
set t1=null
endfunction
function IND takes nothing returns boolean
if B287_GetSpellAbilityId()=='A14P' then
call IMD()
endif
return false
endfunction
function K08 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function IND))
set t=null
endfunction
function IOD takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit m5=O77(OB7,"Target")
local real RK=ON7(OB7,"Angle")
local real x=GetUnitX(m5)-5*Cos(RK)
local real y=GetUnitY(m5)-5*Sin(RK)
local integer V77=OM7(OB7,"Level")
local real IPD=ON7(OB7,"x")
local real IQD=ON7(OB7,"y")
if((IPD-x)*(IPD-x))+((IQD-y)*(IQD-y))<100 then
set x=IPD
set y=IQD
endif
call SetUnitX(m5,x)
call SetUnitY(m5,y)
if GetTriggerEvalCount(t)==(20+$A*V77)or GetTriggerEventId()==EVENT_UNIT_SPELL_ENDCAST then
call NM7(OB7)
call OZ7(t)
if GetTriggerEventId()==EVENT_UNIT_SPELL_ENDCAST then
call KillUnit(GetTriggerUnit())
endif
endif
set t=null
set m5=null
return false
endfunction
function IRD takes unit u,real IPD,real IQD,integer V77,unit m5 returns boolean
local trigger t
local integer OB7
local unit oA=CreateUnit(GetOwningPlayer(u),'u00X',IPD,IQD,0)
local integer id=GetUnitTypeId(u)
local integer skill
local boolean b=false
if WQ7(m5) then
    set b=true
endif
if id=='Z00S' then
    set skill='X14Q'
    call YT7_by_scale("model\\Hero_STormSpirit_N4S_E_Source.mdl",GetUnitX(u),GetUnitY(u),1.5,2)
elseif id=='Z10S' then
    set skill='X24Q'
    call YT7_by_scale("model\\Hero_STormSpirit_N4S_E_Source.mdl",GetUnitX(u),GetUnitY(u),1.5,2)
elseif id=='Z20S' then
    set skill='X34Q'
    call YT7_by_scale("model\\Hero_STormSpirit_N8S_E_Source.mdl",GetUnitX(u),GetUnitY(u),1.5,2)
else
    set skill='A14Q'
endif
call UnitApplyTimedLife(oA,'BTLF',1+0.5*V77)
call UnitAddAbility(oA,skill)
call SetUnitAbilityLevel(oA,skill,V77)
call UnitRemoveAbility(m5,'B0AD')
call IssueTargetOrderById(oA,$D0200,m5)
if b==false then
set t=CreateTrigger()
set OB7=GetHandleId(t)
call TriggerRegisterTimerEvent(t,0.05,true)
call TriggerRegisterUnitEvent(t,oA,EVENT_UNIT_SPELL_ENDCAST)
call TriggerAddCondition(t,Condition(function IOD))
call NT7(OB7,"Target",m5)
call NQ7(OB7,"Angle",((Atan2(GetUnitY(m5)-IQD,GetUnitX(m5)-IPD))*1.0))
call NP7(OB7,"Level",V77)
call NQ7(OB7,"x",IPD)
call NQ7(OB7,"y",IQD)
call CommonUnitAddStun(m5,1+0.5*V77, true)
call LINGXIA(u,m5)
endif
set t=null
set oA=null
return true
endfunction
function IRD0_PD takes nothing returns boolean
return DCX() and IsUnitVisible(GetFilterUnit(),GetOwningPlayer(U22))
endfunction
function IRD0 takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit IH7=GetSpellTargetUnit()
local integer V77=B287_GetUnitAbilityLevel(u,'A2Z6')
local real IPD=GetUnitX(u)
local real IQD=GetUnitY(u)
local group g=WS7()
local unit u2
local boolean b=false
if V77>0 then
set U22=u
call GroupEnumUnitsInRange(g,GetUnitX(IH7),GetUnitY(IH7),275+25,Condition(function IRD0_PD))
else
set V77=B287_GetUnitAbilityLevel(u,'A14R')
call GroupAddUnit(g,IH7)
endif
loop
set u2=FirstOfGroup(g)
exitwhen u2==null
call GroupRemoveUnit(g,u2)
if IRD(u,IPD,IQD,V77,u2)and not b then
call Z57(u,'A14S',1,2.,'B0AF')
set b=true
endif
endloop
call WR7(g)
set u=null
set IH7=null
set g=null
endfunction
function ISD takes nothing returns boolean
if (B287_GetSpellAbilityId()=='A14R' or B287_GetSpellAbilityId()=='A2Z6') and GetUnitTypeId(GetSpellTargetUnit())!='n00L' and WQ7(GetSpellTargetUnit())==false then
call IRD0()
endif
return false
endfunction
