call O37(u,"4409",1)
if AX3 then
call SetUnitPosition(u,GetUnitX(st),GetUnitY(st))
else
call SetUnitPosition(u,x,y)
endif
endif
if OO7(GetHandleId(u),"Grapple")then
call X37(GetOwningPlayer(st),GetObjectName('n036'))
endif
call NM7(OB7)
call OZ7(t)
set t=null
set st=null
set u=null
return false
endfunction
function WN9 takes unit u,unit WO9,integer WP9,real x,real y returns nothing
