function InitDate takes nothing returns nothing
local trigger t
set CurrentMonth=MHTool_GetLocalTime(SYSTEM_TIME_MONTH)
// 改世界树模型 
if CurrentMonth > 10 then
    call MHUnit_SetModel(JW_JD,"effects\\TreeOfLifeNewYear.mdx",false)
    call SetUnitScale(JW_JD,5.,5.,5.)
	// call EXSetUnitString('etol', UNIT_STRING_MODEL_PATH, "effects\\TreeOfLifeNewYear.mdx")
	// call EXSetUnitString('etol', UNIT_STRING_MODEL_PORTRAIT_PATH, "effects\\TreeOfLifeNewYear_portrait.mdx")
    // call EXSetUnitReal('etol', UNIT_REAL_MODEL_SCALE, 5.)
	// call EXSetUnitString('etol', UNIT_STRING_MODEL_PATH, "effects\\TreeOfLifeNewYear.mdx")
	// call EXSetUnitString('etol', UNIT_STRING_MODEL_PORTRAIT_PATH, "effects\\TreeOfLifeNewYear_portrait.mdx")
    // call EXSetUnitReal('etol', UNIT_REAL_MODEL_SCALE, 5.)
endif
if CurrentMonth > 10 then
    call EnableWeatherEffect(bo,true)
    call EnableWeatherEffect(Bo,false)
    call EnableWeatherEffect(fL,false)
    call EnableWeatherEffect(FL,false)
endif
if CurrentMonth==12 or CurrentMonth==2 then
    set t=CreateTrigger()
    call YB7(t,EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(t,Condition(function Bingo))
endif
if CurrentMonth==12 then
    call AddSpecialEffectTarget("effects\\santahat.mdl", V4, "head")
endif
set t=null
endfunction
