    call UnitRemoveAbility(IH7,'A4M0')
    call UnitRemoveAbility(IH7,'A4M1')
    call UnitRemoveAbility(IH7,'A4M2')
    call UnitRemoveAbility(IH7,'A4M3')
    call UnitRemoveAbility(IH7,'B016')
endfunction
function REMOVE_SX_BUFF takes unit IH7 returns nothing
    call UnitRemoveAbility(IH7,'A4I6')
    call UnitRemoveAbility(IH7,'A4I7')
    call UnitRemoveAbility(IH7,'A4I8')
    call UnitRemoveAbility(IH7,'A4I9')
    call UnitRemoveAbility(IH7,'Bblo')
    call UnitRemoveAbility(IH7,'A4IA')
endfunction
function ADD_SX_BUFF takes unit IH7,integer skillbuff,real duration returns nothing
    call REMOVE_SX_BUFF(IH7)
    call Z57(IH7,skillbuff, 1, duration,'Bblo')
    call Z57(IH7,'A4IA', 1, duration,0)
endfunction
