call B67(ZX7,IH7,1,SWYJ[i]+575+150*BC7)
call TimerStart(t,.25,false,function SXI)
call SaveUnitHandle(L7,I97,0,ZX7)
call SaveUnitHandle(L7,I97,1,IH7)
call SaveInteger(L7,I97,0,BC7)
call LINGXIA(ZX7,IH7)
set t=null
set ZX7=null
set IH7=null
endfunction
