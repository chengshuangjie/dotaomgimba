call MoveLocation(Ha,GetUnitX(it)+HHF*Cos(GetUnitFacing(it)*bj_DEGTORAD),GetUnitY(it)+HHF*Sin(GetUnitFacing(it)*bj_DEGTORAD))
return MO7(260.,Ha,Ig)>0
