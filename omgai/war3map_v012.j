function VF8 takes unit VE8 returns boolean
local integer OB7=GetHandleId(GetOwningPlayer(VE8))
local unit DZ8=O77(OB7,"Kobold0")
local unit DA8=O77(OB7,"Kobold1")
local unit DB8=O77(OB7,"Kobold2")
local unit DC8=O77(OB7,"Kobold3")
local unit D38=O77(OB7,"Kobold4")
if GetUnitAbilityLevel(DZ8,'A0OV')!=0 or GetUnitAbilityLevel(DA8,'A0OV')!=0 or GetUnitAbilityLevel(DB8,'A0OV')!=0 or GetUnitAbilityLevel(DC8,'A0OV')!=0 or GetUnitAbilityLevel(D38,'A0OV')!=0 then
return true
endif
set DZ8=null
set DA8=null
set DB8=null
set DC8=null
set D38=null
return false
endfunction
