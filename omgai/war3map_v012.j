call XF7(IH7,'Amrf')
call UnitRemoveAbility(IH7,'Amrf')
endif
call SetUnitFlyHeight(IH7,600,0)
call MHUnit_SetModel(oA,EXGetUnitString(GetUnitTypeId(IH7), UNIT_STRING_MODEL_PATH),false)
call ResetUnitVertexColor(oA,GetUnitTypeId(IH7))
call MHUnit_SetTeamColor(oA,ConvertPlayerColor(GetPlayerId(GetOwningPlayer(IH7))))
call MHUnit_SetTeamGlow(oA,ConvertPlayerColor(GetPlayerId(GetOwningPlayer(IH7))))
set d=XX7(IH7)
call SetUnitScale(oA,d,d,d)
call SetUnitPathing(oA,false)
call SetUnitPathing(BB7,false)
call MHUnit_SetFacing(oA,Face,true)
call SetUnitFlyHeight(oA,500,3000)
if GetUnitTypeId(IH7)=='U00P' then
call SetUnitAnimation(oA,"stand alternate")
endif
call TriggerRegisterTimerEvent(t,0.02,true)
call TriggerRegisterUnitEvent(t, IH7, EVENT_UNIT_ISSUED_ORDER)
call TriggerRegisterUnitEvent(t, IH7, EVENT_UNIT_ISSUED_TARGET_ORDER)
call TriggerRegisterUnitEvent(t, IH7, EVENT_UNIT_ISSUED_POINT_ORDER)
call TriggerRegisterUnitEvent(t,BB7,EVENT_UNIT_ISSUED_POINT_ORDER)
call TriggerRegisterUnitEvent(t,BB7,EVENT_UNIT_SELECTED)
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function MNCF2))
call SaveUnitHandle(L7,(OB7),(1),(IH7))
call SaveUnitHandle(L7,(OB7),(2),(BB7))
call SaveUnitHandle(L7,(OB7),(3),(oA))
call SaveReal(L7,(OB7),(4),(Face))
call SaveUnitHandle(TABLE_HY,'CFMJ', GetHandleId(IH7), BB7)
set cbtx=LoadInteger(TABLE_Z, GetPlayerId(GetOwningPlayer(IH7)),0)
if cbtx!=0 then
call UnitRemoveAbility(IH7,cbtx)
endif
set t=null
set ZX7=null
set IH7=null
set BB7=null
set oA=null
endfunction
function Get_MNCF_UNIT takes unit ZX7 returns unit
local group g=WS7()
local real x=GetSpellTargetX()
local real y=GetSpellTargetY()
    set U22=ZX7
    call GroupEnumUnitsInRange(g,x,y,300,Condition(function BGX))
    set VJ4=Get_LowHP_Friend_PD(g)
    call WR7(g)
    set g=null
    return VJ4
endfunction
function MNCF_PD takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local unit IH7=GetSpellTargetUnit()
local integer skill=B287_GetSpellAbilityId()
if IH7==null then
    if GetSpellTargetItem()!=null then
        set IH7=ZX7
    else
        set IH7=Get_MNCF_UNIT(ZX7)
    endif
endif
if IH7==null then
    call KR7(ZX7)
    call X37(GetOwningPlayer(ZX7),"附近没有友方英雄")
    call Japi_ReduceUnitAbilityCoolDown(ZX7,skill,0.)
    set ZX7=null
    return
endif
if UnitAlive(IH7)==false or (skill!='A1T7' and skill!='A4DG') then
    set ZX7=null
    set IH7=null
    return
endif
if (IsUnitEnemy(IH7,GetOwningPlayer(ZX7)))==false then
    if skill=='A1T7' then
        call MNXCF(ZX7,IH7,'h0GS',2.5,true)
    else
        call MNCF(ZX7,IH7)
    endif
elseif WF7(IH7) then
    call KR7(ZX7)
call X37(GetOwningPlayer(ZX7),GetObjectName('n0LR'))
    call Japi_ReduceUnitAbilityCoolDown(ZX7,skill,0.)
elseif WQ7(IH7) then
    call PLK(IH7)
else
    call MNXCF(ZX7,IH7,'h0GS',2.5,true)
endif
set ZX7=null
set IH7=null
endfunction
function SNF takes integer WF8,unit ZX7,unit IH7 returns nothing
