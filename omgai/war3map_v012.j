//library OMGAISkillData:

    // ---- 冲突组 ID 常量（自定义）----------------------------------------

    function OMGAISkillData___Init takes nothing returns nothing
        local integer ruleIdx

        // ============== 1. 注册冲突规则 ==============
        // 法球组（同组单生效）
        set ruleIdx = OMGAIConflictRule_Register(CGROUP_ORB_EFFECT, CONFLICT_POLICY_SINGLE_ACTIVE)

        // 变身组（互斥禁选，借鉴竞品踩坑）
        set ruleIdx = OMGAIConflictRule_Register(CGROUP_TRANSFORM, CONFLICT_POLICY_MUTUAL_EXCLUSIVE)

        // 重击组（同组单生效）
        set ruleIdx = OMGAIConflictRule_Register(CGROUP_BASH, CONFLICT_POLICY_SINGLE_ACTIVE)

        // 切换型组（架构预防，互斥禁选）
        set ruleIdx = OMGAIConflictRule_Register(CGROUP_TOGGLE, CONFLICT_POLICY_MUTUAL_EXCLUSIVE)

        call OMGAILogger_I("SkillData", "Conflict rules registered: " + I2S(ConflictRule_Count))

        // ============== 2. 注册 MVP 起步技能（约 25 个示例占位）==============
        // 注：以下 rawcode 为示意值，工程落地时需对照 war3map.w3a 物编实际 ID 替换
        // 字段顺序：rawCode, name, sourceHero, slot, tags, dmgType, dmgScale,
        //          ctrlMask, ctrlDuration, healScale, isPassive, isTransform, isDash,
        //          rangeCat, cooldownTier, conflictGroup

        // ---- 例：影魔·魔王降临（个人标记，简化为占位）-------------------
        call OMGAISkillDef_Register('ANcl', "魔王降临", 1, 1, STAG_DMG_MAGICAL + STAG_BURST_HIGH, 2, 8.0, 0, 0.0, 0.0, false, false, false, SRANGE_SHORT, SCOOLDOWN_MID, 0)

        // ---- 例：火女·龙破斩（爆发法师代表）----------------------------
        call OMGAISkillDef_Register('AHfs', "龙破斩", 2, 1, STAG_DMG_MAGICAL + STAG_BURST_HIGH, 2, 7.5, 0, 0.0, 0.0, false, false, false, SRANGE_LONG, SCOOLDOWN_MID, 0)

        // ---- 例：火女·神灭斩（大招，爆发）-----------------------------
        call OMGAISkillDef_Register('AHfa', "神灭斩", 2, 2, STAG_DMG_MAGICAL + STAG_BURST_HIGH + STAG_ULTIMATE, 2, 10.0, STAG_CTRL_STUN, 1.0, 0.0, false, false, false, SRANGE_LONG, SCOOLDOWN_HUGE, 0)

        // ---- 例：谜团·黑洞（大招，控）---------------------------------
        call OMGAISkillDef_Register('AEnf', "黑洞", 3, 2, STAG_CTRL_STUN + STAG_ULTIMATE, 0, 4.0, STAG_CTRL_STUN, 4.0, 0.0, false, false, false, SRANGE_SHORT, SCOOLDOWN_HUGE, 0)

        // ---- 例：钢背兽·刚毛（AOE）-----------------------------------
        call OMGAISkillDef_Register('Abrg', "刚毛飞射", 4, 1, STAG_DMG_PHYSICAL + STAG_SUSTAIN_HIGH + STAG_AOE, 1, 5.0, 0, 0.0, 0.0, false, false, false, SRANGE_SHORT, SCOOLDOWN_SHORT, 0)

        // ---- 例：火枪手·爆头（重击组）---------------------------------
        call OMGAISkillDef_Register('AHeh', "爆头", 5, 1, STAG_DMG_PHYSICAL + STAG_BURST_HIGH + STAG_PASSIVE, 1, 6.0, 0, 0.0, 0.0, true, false, false, SRANGE_LONG, SCOOLDOWN_NONE, CGROUP_BASH)

        // ---- 例：虚空·时间锁定（重击组）-------------------------------
        call OMGAISkillDef_Register('A0LK', "时间锁定", 6, 1, STAG_DMG_PHYSICAL + STAG_CTRL_STUN + STAG_PASSIVE, 1, 4.0, STAG_CTRL_STUN, 0.4, 0.0, true, false, false, SRANGE_MELEE, SCOOLDOWN_NONE, CGROUP_BASH)

        // ---- 例：龙骑·真龙形态（变身组，互斥禁选）---------------------
        call OMGAISkillDef_Register('AEdk', "真龙形态", 7, 2, STAG_TRANSFORM + STAG_DMG_PHYSICAL + STAG_DURABILITY + STAG_ULTIMATE, 1, 6.0, 0, 0.0, 3.0, true, true, false, SRANGE_MELEE, SCOOLDOWN_HUGE, CGROUP_TRANSFORM)

        // ---- 例：德鲁伊·熊形态（变身组，互斥禁选）---------------------
        call OMGAISkillDef_Register('Aelf', "熊形态", 8, 2, STAG_TRANSFORM + STAG_DURABILITY + STAG_ULTIMATE, 0, 0.0, 0, 0.0, 5.0, true, true, false, SRANGE_MELEE, SCOOLDOWN_HUGE, CGROUP_TRANSFORM)

        // ---- 例：智慧之刃（法球组）------------------------------------
        call OMGAISkillDef_Register('Aslw', "智慧之刃", 9, 1, STAG_DMG_PURE + STAG_PASSIVE + STAG_ORB_EFFECT, 3, 5.0, 0, 0.0, 0.0, true, false, false, SRANGE_SHORT, SCOOLDOWN_NONE, CGROUP_ORB_EFFECT)

        // ---- 例：法力损毁（法球组）------------------------------------
        call OMGAISkillDef_Register('Aamn', "法力损毁", 10, 1, STAG_DMG_MAGICAL + STAG_PASSIVE + STAG_ORB_EFFECT, 2, 4.0, 0, 0.0, 0.0, true, false, false, SRANGE_SHORT, SCOOLDOWN_NONE, CGROUP_ORB_EFFECT)

        // ---- 例：敌法师·闪烁（机动）-----------------------------------
        call OMGAISkillDef_Register('Ablk', "闪烁", 11, 1, STAG_BLINK + STAG_ESCAPE, 0, 0.0, 0, 0.0, 0.0, false, false, true, SRANGE_GLOBAL, SCOOLDOWN_MID, 0)

        // ---- 例：辅助·治疗术（治疗）----------------------------------
        call OMGAISkillDef_Register('Ahea', "治疗术", 12, 1, STAG_HEAL, 0, 0.0, 0, 0.0, 8.0, false, false, false, SRANGE_LONG, SCOOLDOWN_MID, 0)

        // ---- 例：水晶室女·光辉之环（光环）----------------------------
        call OMGAISkillDef_Register('Aaur', "光辉光环", 13, 1, STAG_AURA, 0, 0.0, 0, 0.0, 4.0, true, false, false, SRANGE_GLOBAL, SCOOLDOWN_NONE, 0)

        call OMGAILogger_I("SkillData", "Skills registered: " + I2S(SkillDef_Count))

        // ============== 3. 构建小池/大池 ==============
        call OMGAISkillPool_BuildPools()
    endfunction


//library OMGAISkillData ends
//library OMGAISkillOfferGenerator:


    // 生成 8 个待选 SkillDef index，填入 outArray[1..8]
    // phase: OMGAI_PHASE_SELECT_SMALL / OMGAI_PHASE_SELECT_BIG
    // fixedSkillRawCodes: 当前英雄固定技能 rawcode 数组
    // fixedCount: 数组有效长度
    // extraSelectedRawCodes: 已选的额外技能（重新随机也要排除）
    // extraCount: 数组有效长度
    // 返回实际填充数量
        function OMGAISkillOfferGenerator_Generate takes integer phase, integer fixedCount, integer extraCount returns integer
        local integer poolType
        local integer totalExclude = 0
        local integer i
        local integer got

        // select pool
        if phase == OMGAI_PHASE_SELECT_SMALL then
            set poolType = 1
        elseif phase == OMGAI_PHASE_SELECT_BIG then
            set poolType = 2
        else
            call OMGAILogger_E("OfferGen", "Generate: invalid phase=" + I2S(phase))
            return 0
        endif

        // build exclude list (fixed + extra)
        set i = 1
        loop
            exitwhen i > fixedCount
            set totalExclude = totalExclude + 1
            set OMGAI_TmpExcludeRawCodes[totalExclude] = OMGAI_TmpFixedRawCodes[i]
            set i = i + 1
        endloop
        set i = 1
        loop
            exitwhen i > extraCount
            set totalExclude = totalExclude + 1
            set OMGAI_TmpExcludeRawCodes[totalExclude] = OMGAI_TmpExtraRawCodes[i]
            set i = i + 1
        endloop

        // fill SkillPool input channel
        set i = 1
        loop
            exitwhen i > totalExclude
            set SkillPool_ExcludeRawCodes[i] = OMGAI_TmpExcludeRawCodes[i]
            set i = i + 1
        endloop

        // call SkillPool random offers (with conflict check inside)
        set got = OMGAISkillPool_GetRandomOffers(poolType, OMGAI_OFFER_COUNT, totalExclude)

        // copy output to this library channel
        set i = 1
        loop
            exitwhen i > got
            set OMGAI_TmpOutOffers[i] = SkillPool_OutIndices[i]
            set i = i + 1
        endloop
        return got
    endfunction


//library OMGAISkillOfferGenerator ends
//library OMGAIInit:

    function OMGAIInit___OnInit takes nothing returns nothing
        // 1) 日志先启动
        call OMGAILogger_I("Init", "===== OMGAI v" + OMGAI_VERSION + " init start =====")

        // 2) 平台探测
        call OMGAIPlatformFactory_Init()

        // 3) 主心跳
        call OMGAITimerService_Init()

        // 4) 标记初始化完成（后续模块检查此标记防止重入）
        set OMGAI_Initialized = true
        call OMGAILogger_I("Init", "===== OMGAI init done, platform=" + I2S(OMGAI_CurrentPlatform) + "" + " =====")
    endfunction


//library OMGAIInit ends
//library OMGAIPlayerSkillState:


    // 计算玩家固定技能在 PSS_FixedSkills_RawCode 数组中的起始位置
    function OMGAIPlayerSkillState_GetFixedSkillRawCode takes integer playerId, integer slot returns integer
        return PSS_FixedSkills_RawCode[(playerId - 1) * 4 + slot]
    endfunction

    function OMGAIPlayerSkillState_SetFixedSkillRawCode takes integer playerId, integer slot, integer rawCode returns nothing
        set PSS_FixedSkills_RawCode[(playerId - 1) * 4 + slot] = rawCode
    endfunction

    // 初始化玩家技能状态（英雄出生时调用）
        function OMGAIPlayerSkillState_Init takes integer playerId, integer heroId, unit heroUnit returns nothing
        set PSS_HeroId[playerId]    = heroId
        set PSS_HeroUnit[playerId]  = heroUnit
        set PSS_Phase[playerId]    = OMGAI_PHASE_INIT
        set PSS_ExtraSmall[playerId] = 0
        set PSS_ExtraBig[playerId]   = 0
        set PSS_SmallPhaseRespinUsed[playerId] = 0
        set PSS_BigPhaseRespinUsed[playerId]   = 0
        // fixed skills must be pre-written by caller via SetFixedSkillRawCode
        call OMGAILogger_I("PSS", "init player=" + I2S(playerId) + " hero=" + I2S(heroId) + " phase=INIT")
    endfunction

    // 进入选小技能阶段：生成 8 个待选
        function OMGAIPlayerSkillState_StartSelectSmallPhase takes integer playerId returns nothing
        local integer got
        local integer i
        // exclude list: hero fixed 4 skills -> fill Generate input channel
        set i = 1
        loop
            exitwhen i > 4
            set OMGAI_TmpFixedRawCodes[i] = OMGAIPlayerSkillState_GetFixedSkillRawCode(playerId, i)
            set i = i + 1
        endloop
        // generate
        set got = OMGAISkillOfferGenerator_Generate(OMGAI_PHASE_SELECT_SMALL, 4, 0)
        if got == 0 then
            call OMGAILogger_E("PSS", "StartSelectSmallPhase: 0 offers")
            return
        endif
        set i = 1
        loop
            exitwhen i > 8
            set PSS_SmallOffers[(playerId - 1) * 8 + i] = OMGAI_TmpOutOffers[i]
            set i = i + 1
        endloop
        set PSS_Phase[playerId] = OMGAI_PHASE_SELECT_SMALL
        call OMGAILogger_D("PSS", "player=" + I2S(playerId) + " entered SELECT_SMALL, offers=" + I2S(got))
    endfunction

    // 占位辅助移除：用 PSS_EmptyArray 全局变量替代返回 array

    // 进入选大技能阶段
        function OMGAIPlayerSkillState_StartSelectBigPhase takes integer playerId returns nothing
        local integer got
        local integer i
        // exclude list: fixed 4 + selected small 1 -> fill Generate input channel
        set i = 1
        loop
            exitwhen i > 4
            set OMGAI_TmpFixedRawCodes[i] = OMGAIPlayerSkillState_GetFixedSkillRawCode(playerId, i)
            set i = i + 1
        endloop
        set OMGAI_TmpExtraRawCodes[1] = PSS_ExtraSmall[playerId]
        set got = OMGAISkillOfferGenerator_Generate(OMGAI_PHASE_SELECT_BIG, 4, 1)
        if got == 0 then
            call OMGAILogger_E("PSS", "StartSelectBigPhase: 0 offers")
            return
        endif
        set i = 1
        loop
            exitwhen i > 8
            set PSS_BigOffers[(playerId - 1) * 8 + i] = OMGAI_TmpOutOffers[i]
            set i = i + 1
        endloop
        set PSS_Phase[playerId] = OMGAI_PHASE_SELECT_BIG
    endfunction

    // 玩家选某技能：从当前阶段 offers 中选第几个
    // offerIndex: 1..8
    // 返回 true 成功
    function OMGAIPlayerSkillState_SelectOffer takes integer playerId, integer offerIndex returns boolean
        local integer skillIdx
        local integer rawCode
        if offerIndex < 1 or offerIndex > OMGAI_OFFER_COUNT then
            return false
        endif
        if PSS_Phase[playerId] == OMGAI_PHASE_SELECT_SMALL then
            set skillIdx = PSS_SmallOffers[(playerId - 1) * 8 + offerIndex]
            set rawCode = SkillDef_RawCode[skillIdx]
            set PSS_ExtraSmall[playerId] = rawCode
            call OMGAIHeroSkillManager_GrantSkill(PSS_HeroUnit[playerId], rawCode)
            call OMGAILogger_D("PSS", "player=" + I2S(playerId) + " selected small skill rawCode=" + I2S(rawCode))
            // 赋予技能（HeroSkillManager 在 T03 后续实现，先直接调）
            set PSS_Phase[playerId] = OMGAI_PHASE_SELECT_BIG
            return true
        elseif PSS_Phase[playerId] == OMGAI_PHASE_SELECT_BIG then
            set skillIdx = PSS_BigOffers[(playerId - 1) * 8 + offerIndex]
            set rawCode = SkillDef_RawCode[skillIdx]
            set PSS_ExtraBig[playerId] = rawCode
            call OMGAIHeroSkillManager_GrantSkill(PSS_HeroUnit[playerId], rawCode)
            call OMGAILogger_D("PSS", "player=" + I2S(playerId) + " selected big skill rawCode=" + I2S(rawCode))
            set PSS_Phase[playerId] = OMGAI_PHASE_DONE
            // 触发选技能完成事件（让 AI Controller 监听生成画像）
            call OMGAIEventDispatcher_ClearPayload()
            set OMGAI_EvtPayloadPlayer = Player(playerId - 1)
            call OMGAIEventDispatcher_Fire(OMGAI_EVT_SELECT_DONE)
            return true
        endif
        return false
    endfunction

    // 是否完成全部 4+2 选技能
    function OMGAIPlayerSkillState_IsComplete takes integer playerId returns boolean
        return PSS_Phase[playerId] == OMGAI_PHASE_DONE
    endfunction

    // 当前阶段已用免费转次数
    function OMGAIPlayerSkillState_GetRespinUsed takes integer playerId, integer phase returns integer
        if phase == OMGAI_PHASE_SELECT_SMALL then
            return PSS_SmallPhaseRespinUsed[playerId]
        elseif phase == OMGAI_PHASE_SELECT_BIG then
            return PSS_BigPhaseRespinUsed[playerId]
        endif
        return 0
    endfunction

    // 增加当前阶段免费转次数计数
    function OMGAIPlayerSkillState_IncrementRespinUsed takes integer playerId, integer phase returns nothing
        if phase == OMGAI_PHASE_SELECT_SMALL then
            set PSS_SmallPhaseRespinUsed[playerId] = PSS_SmallPhaseRespinUsed[playerId] + 1
        elseif phase == OMGAI_PHASE_SELECT_BIG then
            set PSS_BigPhaseRespinUsed[playerId] = PSS_BigPhaseRespinUsed[playerId] + 1
        endif
    endfunction

    // 取当前 phase 下的小/大技能 offers index
    function OMGAIPlayerSkillState_GetSmallOfferIdx takes integer playerId, integer offerIndex returns integer
        return PSS_SmallOffers[(playerId - 1) * 8 + offerIndex]
    endfunction

    function OMGAIPlayerSkillState_GetBigOfferIdx takes integer playerId, integer offerIndex returns integer
        return PSS_BigOffers[(playerId - 1) * 8 + offerIndex]
    endfunction


//library OMGAIPlayerSkillState ends
//library OMGAIStrategy:

// ---- 基图运行时函数对接（native 声明：编译期不检查，运行时真实调用基图函数）----
// 签名来源：基图 war3map.j（SuijiMode 随机OMG模块）
    native SuijiMode_GetStableHeroIndex takes unit u returns integer
    native SuijiMode_SkillClass takes integer skill returns integer
    native SuijiMode_IsPhysicalSkill takes integer skill returns boolean

//---------------------------------------------------------------------------
// 1. 流派与定位（对应 6A.1 / 6A.2）
//---------------------------------------------------------------------------


//---------------------------------------------------------------------------
// 2. 流派识别（对应 6A.1）——双通道：基图物理/魔法分类 + SkillDef 控制/生存/功能标签
//---------------------------------------------------------------------------

    // 判断 value 的 bit 位是否置位（bit = 1/2/4/8/16...）
    function OMGAIStrategy___BitIsSet takes integer value, integer bit returns boolean
        return ModuloInteger(value, bit * 2) >= bit
    endfunction

    // 单个技能 -> 流派位掩码（可多标签叠加；基于 OMGAI SkillDef 标签）
    function OMGAIStrategy_OMGAI_GetSkillArchetype takes integer abilityId returns integer
        local integer idx = OMGAISkillDef_FindByRawCode(abilityId)
        local integer tags = 0
        local integer arch = 0
        if idx == 0 then
            return 0
        endif
        set tags = SkillDef_Tags[idx]
        // 伤害维度
        if OMGAISkillTag_HasTag(tags, STAG_DMG_PHYSICAL) then
            set arch = arch + ARCH_PHYSICAL
        endif
        if OMGAISkillTag_HasTag(tags, STAG_DMG_MAGICAL) or OMGAISkillTag_HasTag(tags, STAG_DMG_PURE) then
            set arch = arch + ARCH_MAGIC
        endif
        // 控制维度
        if OMGAISkillTag_HasTag(tags, STAG_CTRL_STUN) or OMGAISkillTag_HasTag(tags, STAG_CTRL_SLOW) or OMGAISkillTag_HasTag(tags, STAG_CTRL_SILENCE) or OMGAISkillTag_HasTag(tags, STAG_CTRL_ROOT) or OMGAISkillTag_HasTag(tags, STAG_CTRL_DISARM) or OMGAISkillTag_HasTag(tags, STAG_CTRL_FEAR) then
            set arch = arch + ARCH_CONTROL
        endif
        // 生存维度
        if OMGAISkillTag_HasTag(tags, STAG_HEAL) or OMGAISkillTag_HasTag(tags, STAG_SHIELD) or OMGAISkillTag_HasTag(tags, STAG_LIFESTEAL) or OMGAISkillTag_HasTag(tags, STAG_DURABILITY) then
            set arch = arch + ARCH_SURVIVE
        endif
        // 功能维度
        if OMGAISkillTag_HasTag(tags, STAG_SUMMON) or OMGAISkillTag_HasTag(tags, STAG_AURA) then
            set arch = arch + ARCH_UTILITY
        endif
        return arch
    endfunction

    // 枚举英雄实际技能（基图已授予的 OMG 技能池技能）-> 写入 PSS 4+2 槽
    // 基图技能池 = HM4/HN4/HO4（小技能）+ HP4/HQ4（大招），英雄基础技能也在池内
    // 返回收集到的技能数
    function OMGAIStrategy_OMGAI_EnumerateHeroSkills takes unit u returns integer
        local integer pid = GetPlayerId(GetOwningPlayer(u)) + 1
        local integer i = 1
        local integer count = 0
        local integer slot = 1
        local integer raw = 0
        loop
            exitwhen i > BASE_SKILL_COUNT or slot > 6
            set raw = BASE_SKILL_TABLE[i]
            if GetUnitAbilityLevel(u, raw) > 0 then
                if slot <= 4 then
                    call OMGAIPlayerSkillState_SetFixedSkillRawCode(pid, slot, raw)
                elseif slot == 5 then
                    set PSS_ExtraSmall[pid] = raw
                else
                    set PSS_ExtraBig[pid] = raw
                endif
                set slot = slot + 1
                set count = count + 1
            endif
            set i = i + 1
        endloop
        if count > 0 then
            call OMGAILog_LOG_INFO("STRAT", "技能枚举 pid=" + I2S(pid) + " count=" + I2S(count))
        endif
        return count
    endfunction

    // 4+2 综合：从 PSS 技能槽读实际技能，双通道分类 -> 判流派
    function OMGAIStrategy_OMGAI_ComputeBuild takes unit u returns integer
        local integer pid = GetPlayerId(GetOwningPlayer(u)) + 1
        local integer i = 0
        local integer abilityId = 0
        local integer arch = 0
        local integer cls = 0
        local integer phys = 0
        local integer magic = 0
        local integer ctrl = 0
        local integer surv = 0
        local integer util = 0
        // 4 固定槽
        loop
            exitwhen i >= 4
            set abilityId = OMGAIPlayerSkillState_GetFixedSkillRawCode(pid, i + 1)
            if abilityId != 0 then
                set cls = SuijiMode_SkillClass(abilityId)
                if cls == 1 then
                    set phys = phys + 1
                elseif cls == 2 then
                    set magic = magic + 1
                endif
                set arch = OMGAIStrategy_OMGAI_GetSkillArchetype(abilityId)
                if OMGAIStrategy___BitIsSet(arch, ARCH_CONTROL) then
                    set ctrl = ctrl + 1
                endif
                if OMGAIStrategy___BitIsSet(arch, ARCH_SURVIVE) then
                    set surv = surv + 1
                endif
                if OMGAIStrategy___BitIsSet(arch, ARCH_UTILITY) then
                    set util = util + 1
                endif
            endif
            set i = i + 1
        endloop
        // 额外小技能
        set abilityId = PSS_ExtraSmall[pid]
        if abilityId != 0 then
            set cls = SuijiMode_SkillClass(abilityId)
            if cls == 1 then
                set phys = phys + 1
            elseif cls == 2 then
                set magic = magic + 1
            endif
            set arch = OMGAIStrategy_OMGAI_GetSkillArchetype(abilityId)
            if OMGAIStrategy___BitIsSet(arch, ARCH_CONTROL) then
                set ctrl = ctrl + 1
            endif
            if OMGAIStrategy___BitIsSet(arch, ARCH_SURVIVE) then
                set surv = surv + 1
            endif
            if OMGAIStrategy___BitIsSet(arch, ARCH_UTILITY) then
                set util = util + 1
            endif
        endif
        // 额外大技能
        set abilityId = PSS_ExtraBig[pid]
        if abilityId != 0 then
            set cls = SuijiMode_SkillClass(abilityId)
            if cls == 1 then
                set phys = phys + 1
            elseif cls == 2 then
                set magic = magic + 1
            endif
            set arch = OMGAIStrategy_OMGAI_GetSkillArchetype(abilityId)
            if OMGAIStrategy___BitIsSet(arch, ARCH_CONTROL) then
                set ctrl = ctrl + 1
            endif
            if OMGAIStrategy___BitIsSet(arch, ARCH_SURVIVE) then
                set surv = surv + 1
            endif
            if OMGAIStrategy___BitIsSet(arch, ARCH_UTILITY) then
                set util = util + 1
            endif
        endif
        // 综合评分（缓存）
        call OMGAICore_OMGAI_SaveInt(GetHandleId(u), 81, phys)
        call OMGAICore_OMGAI_SaveInt(GetHandleId(u), 82, magic)
        call OMGAICore_OMGAI_SaveInt(GetHandleId(u), 83, ctrl)
        call OMGAICore_OMGAI_SaveInt(GetHandleId(u), 84, surv)
        call OMGAICore_OMGAI_SaveInt(GetHandleId(u), 85, util)
        // 流派判定（肉/控制优先，其次物理/魔法）
        if surv >= 2 then
            call OMGAICore_OMGAI_SaveInt(GetHandleId(u), 80, BUILD_TANK)
            return BUILD_TANK
        elseif ctrl >= 2 then
            call OMGAICore_OMGAI_SaveInt(GetHandleId(u), 80, BUILD_CTRL)
            return BUILD_CTRL
        elseif phys >= 2 and magic <= 1 then
            call OMGAICore_OMGAI_SaveInt(GetHandleId(u), 80, BUILD_PHYS)
            return BUILD_PHYS
        elseif magic >= 2 and phys <= 1 then
            call OMGAICore_OMGAI_SaveInt(GetHandleId(u), 80, BUILD_MAGIC)
            return BUILD_MAGIC
        endif
        call OMGAICore_OMGAI_SaveInt(GetHandleId(u), 80, BUILD_MIXED)
        return BUILD_MIXED
    endfunction

    function OMGAIStrategy_OMGAI_GetBuild takes unit u returns integer
        return OMGAICore_OMGAI_LoadInt(GetHandleId(u), 80)
    endfunction

    // 流派 -> 装备栏位选择（对应 4.6 多维装备"流派"维度）
    function OMGAIStrategy_OMGAI_BuildItemColumn takes unit u returns integer
        local integer b = OMGAIStrategy_OMGAI_GetBuild(u)
        if b == BUILD_PHYS then
            return 1
        endif
        if b == BUILD_MAGIC then
            return 2
        endif
        if b == BUILD_TANK then
            return 3
        endif
        if b == BUILD_CTRL then
            return 4
        endif
        return 0
    endfunction

//---------------------------------------------------------------------------
// 3. 团战定位（对应 6A.2）
//---------------------------------------------------------------------------

    function OMGAIStrategy_OMGAI_AssignRole takes unit u returns integer
        local integer b = OMGAIStrategy_OMGAI_GetBuild(u)
        local integer role = ROLE_DPS
        if b == BUILD_TANK then
            set role = ROLE_VANGUARD
        elseif b == BUILD_MAGIC then
            set role = ROLE_NUKER
        elseif b == BUILD_CTRL then
            set role = ROLE_SUPPORT
        elseif b == BUILD_PHYS then
            set role = ROLE_DPS
        else
            set role = ROLE_DPS
        endif
        call OMGAICore_OMGAI_SaveInt(GetHandleId(u), 86, role)
        return role
    endfunction

    function OMGAIStrategy_OMGAI_GetRole takes unit u returns integer
        return OMGAICore_OMGAI_LoadInt(GetHandleId(u), 86)
    endfunction

    // 站位距离计算：按定位返回理想团战距离
    function OMGAIStrategy_OMGAI_ComputeStandPos takes unit u, unit enemyCore returns real
        local integer role = OMGAIStrategy_OMGAI_GetRole(u)
        if role == ROLE_VANGUARD then
            return VANGUARD_RANGE
        elseif role == ROLE_NUKER then
            return NUKER_RANGE
        elseif role == ROLE_SUPPORT then
            return SUPPORT_RANGE
        endif
        return DPS_RANGE
    endfunction

    // 团战 desire 加减权（肉不逃跑/前排顶着，辅助保命优先）
    function OMGAIStrategy_OMGAI_RoleDesireBias takes unit u, integer behaviorId returns real
        local integer role = OMGAIStrategy_OMGAI_GetRole(u)
        if behaviorId == BEH_RETREAT and role == ROLE_VANGUARD then
            return -0.4
        endif
        if behaviorId == BEH_RETREAT and role == ROLE_SUPPORT then
            return 0.2
        endif
        return 0.0
    endfunction

//---------------------------------------------------------------------------
// 4. 秒人判断（对应 6A.3）——爆发估算
//    规则：爆发预估 >= 血量*1.1 且 有控制链配合 -> gank/团战 desire +0.5 + focusTarget 写入
//    数据：缓存 = 英雄 hid，槽 87 = 当前秒杀目标（handle id）
//---------------------------------------------------------------------------

    // 估算当前 4+2 技能爆发：
    //   SkillDef 已注册技能：DmgScale*60*1.3（技能等级加成）
    //   未注册技能：物理按 (力量+敏捷*1.5)，魔法按 智力*3（近似，后续用 w3a 精修）
    function OMGAIStrategy_OMGAI_EstimateBurst takes unit u returns real
        local integer pid = GetPlayerId(GetOwningPlayer(u)) + 1
        local integer i = 0
        local integer abilityId = 0
        local integer idx = 0
        local real total = 0.0
        local real scale = 0.0
        local integer cls = 0
        loop
            exitwhen i >= 4
            set abilityId = OMGAIPlayerSkillState_GetFixedSkillRawCode(pid, i + 1)
            if abilityId != 0 then
                set idx = OMGAISkillDef_FindByRawCode(abilityId)
                if idx != 0 then
                    set scale = SkillDef_DmgScale[idx]
                    if scale > 0.0 then
                        set total = total + scale * 60.0 * 1.3
                    endif
                else
                    set cls = SuijiMode_SkillClass(abilityId)
                    if cls == 1 then
                        set total = total + (GetHeroStr(u, true) + GetHeroAgi(u, true) * 1.5) * 1.2
                    elseif cls == 2 then
                        set total = total + GetHeroInt(u, true) * 3.0
                    endif
                endif
            endif
            set i = i + 1
        endloop
        set abilityId = PSS_ExtraSmall[pid]
        if abilityId != 0 then
            set idx = OMGAISkillDef_FindByRawCode(abilityId)
            if idx != 0 then
                set scale = SkillDef_DmgScale[idx]
                if scale > 0.0 then
                    set total = total + scale * 60.0 * 1.3
                endif
            else
                set cls = SuijiMode_SkillClass(abilityId)
                if cls == 1 then
                    set total = total + (GetHeroStr(u, true) + GetHeroAgi(u, true) * 1.5) * 1.2
                elseif cls == 2 then
                    set total = total + GetHeroInt(u, true) * 3.0
                endif
            endif
        endif
        set abilityId = PSS_ExtraBig[pid]
        if abilityId != 0 then
            set idx = OMGAISkillDef_FindByRawCode(abilityId)
            if idx != 0 then
                set scale = SkillDef_DmgScale[idx]
                if scale > 0.0 then
                    set total = total + scale * 60.0 * 1.3
                endif
            else
                set cls = SuijiMode_SkillClass(abilityId)
                if cls == 1 then
                    set total = total + (GetHeroStr(u, true) + GetHeroAgi(u, true) * 1.5) * 1.2
                elseif cls == 2 then
                    set total = total + GetHeroInt(u, true) * 3.0
                endif
            endif
        endif
        return total
    endfunction

    // 秒杀判断：爆发 >= 最近敌人血量*1.1 -> 锁定为目标（否则 0）
    function OMGAIStrategy_OMGAI_FindKillTarget takes unit u returns integer
        local integer hid = GetHandleId(u)
        local unit target = OMGAITargetSel_OMGAI_GetClosestEnemy(u)
        local real burst = 0.0
        local real hp = 0.0
        if target == null then
            call OMGAICore_OMGAI_SaveInt(hid, 87, 0)
            call OMGAICore_OMGAI_SaveUnitHandle(hid, 94, null)
            return 0
        endif
        set burst = OMGAIStrategy_OMGAI_EstimateBurst(u)
        set hp = GetUnitState(target, UNIT_STATE_LIFE)
        if burst >= hp * BURST_MULT then
            call OMGAICore_OMGAI_SaveInt(hid, 87, GetHandleId(target))
            call OMGAICore_OMGAI_SaveUnitHandle(hid, 94, target)
            return GetHandleId(target)
        endif
        call OMGAICore_OMGAI_SaveInt(hid, 87, 0)
        call OMGAICore_OMGAI_SaveUnitHandle(hid, 94, null)
        return 0
    endfunction

    // 秒杀通道：desire 注入（有锁定目标 -> gank/团战 desire 加成）
    function OMGAIStrategy_OMGAI_KillDesireBonus takes unit u returns real
        if OMGAICore_OMGAI_LoadInt(GetHandleId(u), 87) != 0 then
            return SECURE_DESIRE_BONUS
        endif
        return 0.0
    endfunction

//---------------------------------------------------------------------------
// 5. 蹲守针对（对应 6A.4）
//---------------------------------------------------------------------------

    function OMGAIStrategy_OMGAI_AmbushThink takes unit u returns integer
        local integer hid = GetHandleId(u)
        local unit keyHero = OMGAIEnemyState_OMGAI_GetTopThreat()
        local integer st = 0
        if keyHero == null then
            return AMBUSH_IDLE
        endif
        if (not IsUnitType(keyHero, UNIT_TYPE_DEAD) and GetWidgetLife(keyHero) > 0.405) then
            set st = AMBUSH_PRESS
        elseif IsUnitVisible(keyHero, GetOwningPlayer(u)) then
            if GetUnitState(keyHero, UNIT_STATE_LIFE) < GetUnitState(keyHero, UNIT_STATE_MAX_LIFE) * KEY_HERO_HP_PRESS then
                set st = AMBUSH_PRESS
            else
                set st = AMBUSH_ENGAGE
            endif
        else
            set st = AMBUSH_IDLE
        endif
        call OMGAICore_OMGAI_SaveInt(hid, 88, st)
        return st
    endfunction

    // 蹲守 desire 加成：ENGAGE/PRESS 时注入集火欲望
    function OMGAIStrategy_OMGAI_AmbushDesireBonus takes unit u returns real
        local integer st = OMGAICore_OMGAI_LoadInt(GetHandleId(u), 88)
        if st == AMBUSH_ENGAGE or st == AMBUSH_PRESS then
            return SECURE_DESIRE_BONUS
        endif
        return 0.0
    endfunction

    // 蹲守克制：敌不可见时降低 gank/推塔欲望（不贸然暴露）
    function OMGAIStrategy_OMGAI_AmbushRestraint takes unit u, integer behaviorId returns real
        local integer st = OMGAICore_OMGAI_LoadInt(GetHandleId(u), 88)
        if st == AMBUSH_IDLE then
            if behaviorId == BEH_GANK then
                return -0.3
            endif
            if behaviorId == BEH_PUSH then
                return -0.2
            endif
        endif
        return 0.0
    endfunction

    // 针对出装：按 EnemyState 对位 Build 返回反制装备栏位（出装系统对接后启用）
    function OMGAIStrategy_OMGAI_CounterBuild takes unit u returns integer
        local player p = GetOwningPlayer(u)
        local group g = CreateGroup()
        local unit e = null
        local integer phys = 0
        local integer mag = 0
        local integer b = 0
        // 统计周围 2000 码敌方英雄流派
        call GroupEnumUnitsInRange(g, GetUnitX(u), GetUnitY(u), 2000.0, null)
        set e = FirstOfGroup(g)
        loop
            exitwhen e == null
            if IsUnitType(e, UNIT_TYPE_HERO) and (not IsUnitType(e, UNIT_TYPE_DEAD) and GetWidgetLife(e) > 0.405) and IsUnitEnemy(e, p) then
                set b = OMGAIStrategy_OMGAI_GetBuild(e)
                if b == BUILD_PHYS then
                    set phys = phys + 1
                elseif b == BUILD_MAGIC then
                    set mag = mag + 1
                endif
            endif
            call GroupRemoveUnit(g, e)
            set e = FirstOfGroup(g)
        endloop
        call DestroyGroup(g)
        set g = null
        set e = null
        // 克制决策：敌方物理流多 -> 1(物理抗性)；法师流多 -> 2(法抗)；均衡 -> 0(默认)
        if phys >= mag and phys > 0 then
            return 1
        elseif mag > phys then
            return 2
        endif
        return 0
    endfunction

//---------------------------------------------------------------------------
// 6. 视野博弈（对应 6A.5）
//---------------------------------------------------------------------------

    // 标记可疑守卫：敌方英雄在我方附近停留过 -> 记录
    function OMGAIStrategy_OMGAI_MarkSuspiciousWard takes unit wardLoc, unit enemyNear returns nothing
        call OMGAICore_OMGAI_SaveReal(GetHandleId(wardLoc), 92, 1.0)
        call OMGAICore_OMGAI_SaveInt(GetHandleId(wardLoc), 93, GetHandleId(enemyNear))
    endfunction

    // 反眼目标：返回视野内最近的敌方守卫（守卫类型库对接后启用；V2.4 保守返回 null）
    function OMGAIStrategy_OMGAI_GetWardToDeWard takes unit u returns unit
        local player p = GetOwningPlayer(u)
        local group g = CreateGroup()
        local unit ward = null
        local unit tmp = null
        // 扫描 1400 码：敌方、存活、非英雄非建筑、带守卫特征技能 A04R
        call GroupEnumUnitsInRange(g, GetUnitX(u), GetUnitY(u), 1400.0, null)
        set tmp = FirstOfGroup(g)
        loop
            exitwhen tmp == null
            if not IsUnitType(tmp, UNIT_TYPE_HERO) and not IsUnitType(tmp, UNIT_TYPE_STRUCTURE) and (not IsUnitType(tmp, UNIT_TYPE_DEAD) and GetWidgetLife(tmp) > 0.405) and IsUnitEnemy(tmp, p) and GetUnitAbilityLevel(tmp, 'A04R') > 0 then
                set ward = tmp
                exitwhen true
            endif
            call GroupRemoveUnit(g, tmp)
            set tmp = FirstOfGroup(g)
        endloop
        call DestroyGroup(g)
        set g = null
        set tmp = null
        return ward
    endfunction

    // 反眼链路：扫描附近敌守卫 -> 存槽 92（AI 英雄），ThinkWard 消费
    function OMGAIStrategy_OMGAI_DetectWards takes unit u returns nothing
        local integer hid = GetHandleId(u)
        local player p = GetOwningPlayer(u)
        local group g = CreateGroup()
        local unit tmp = null
        local unit ward = null
        call GroupEnumUnitsInRange(g, GetUnitX(u), GetUnitY(u), 1400.0, null)
        set tmp = FirstOfGroup(g)
        loop
            exitwhen tmp == null
            if not IsUnitType(tmp, UNIT_TYPE_HERO) and not IsUnitType(tmp, UNIT_TYPE_STRUCTURE) and (not IsUnitType(tmp, UNIT_TYPE_DEAD) and GetWidgetLife(tmp) > 0.405) and IsUnitEnemy(tmp, p) and GetUnitAbilityLevel(tmp, 'A04R') > 0 then
                set ward = tmp
                exitwhen true
            endif
            call GroupRemoveUnit(g, tmp)
            set tmp = FirstOfGroup(g)
        endloop
        call DestroyGroup(g)
        if ward != null then
            call OMGAICore_OMGAI_SaveUnitHandle(hid, 92, ward)
            call OMGAILog_LOG_WARN("WARD", "发现敌方守卫 type=" + I2S(GetUnitTypeId(ward)))
        else
            call OMGAICore_OMGAI_SaveUnitHandle(hid, 92, null)
        endif
        set g = null
        set tmp = null
        set ward = null
    endfunction

    // 开雾判断：有秒杀目标且目标不可见 -> 建议开雾
    function OMGAIStrategy_OMGAI_ShouldUseSmoke takes unit u returns boolean
        local integer kill = OMGAICore_OMGAI_LoadInt(GetHandleId(u), 87)
        if kill != 0 then
            return true
        endif
        return false
    endfunction

//---------------------------------------------------------------------------
// 7. 初始化与自检
//---------------------------------------------------------------------------

    // 注册：AI 英雄出生后调用 -> 枚举技能 + 流派识别 + 定位分配
    function OMGAIStrategy_OMGAI_StrategyInitHero takes unit u returns nothing
        local integer pid = GetPlayerId(GetOwningPlayer(u)) + 1
        // 初始化 PSS 状态（电脑侧无 UI 流程，直接进入完成态）
        call OMGAIPlayerSkillState_Init(pid, GetUnitTypeId(u), u)
        // 枚举英雄实际技能 -> 写 PSS 4+2 槽
        call OMGAIStrategy_OMGAI_EnumerateHeroSkills(u)
        call OMGAIStrategy_OMGAI_ComputeBuild(u)
        call OMGAIStrategy_OMGAI_AssignRole(u)
        call OMGAILog_LOG_INFO("STRAT", "英雄战术初始化: build=" + I2S(OMGAIStrategy_OMGAI_GetBuild(u)) + " role=" + I2S(OMGAIStrategy_OMGAI_GetRole(u)))
    endfunction

    // 每 tick：刷新秒杀目标 + 蹲守状态（行为层 Desire/Think 前调用）
    function OMGAIStrategy_OMGAI_StrategyTick takes unit u returns nothing
        local integer hid = GetHandleId(u)
        local real now = OMGAICore_OMGAI_GetGameTime()
        local real last = OMGAICore_OMGAI_LoadReal(hid, 99)
        // V2.6: 2s 节流（FindKillTarget/AmbushThink 内部有枚举，避免每 tick 重算）
        if now - last < 2.0 then
            return
        endif
        call OMGAICore_OMGAI_SaveReal(hid, 99, now)
        call OMGAIStrategy_OMGAI_FindKillTarget(u)
        call OMGAIStrategy_OMGAI_AmbushThink(u)
        call OMGAIStrategy_OMGAI_DetectWards(u)
        // 团战标记（槽 93 = 1 团战中）：供 Behaviors DesireTeam 读取，避免高频枚举
        if OMGAITargetSel_OMGAI_IsTeamFight(u) then
            call OMGAICore_OMGAI_SaveInt(hid, 93, 1)
        else
            call OMGAICore_OMGAI_SaveInt(hid, 93, 0)
        endif
    endfunction

    function OMGAIStrategy_OMGAIStrategy_Init takes nothing returns nothing
        call OMGAILog_LOG_INFO("STRAT", "OMGAIStrategy 战术意识层初始化完成（V2.4 基图运行时对接）")
    endfunction



