function DJE takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit p5=O77(I97,"Source")
local unit m5=O77(I97,"Target")
if p5==null or m5==null or GetUnitTypeId(p5)==0 or GetUnitTypeId(m5)==0 then
call DestroyEffect(OG7(I97,"FX"))
if m5!=null and GetUnitTypeId(m5)!=0 then
call UnitRemoveType(m5,UNIT_TYPE_PEON)
endif
call OZ7(t)
call FlushChildHashtable(L7,(I97))
elseif (GetTriggerEventId()==EVENT_UNIT_DEATH and GetTriggerUnit()==m5) or XH7(m5)then
call DestroyEffect(OG7(I97,"FX"))
call OZ7(t)
call FlushChildHashtable(L7,(I97))
call UnitRemoveType(m5,UNIT_TYPE_PEON)
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A0R0',true)
call SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A2MB',false)
call X37(GetOwningPlayer(p5),GetObjectName('n03F'))
elseif (GetTriggerEventId()==EVENT_UNIT_DEATH and GetTriggerUnit()==p5) or p5==null or XH7(p5)then
call DestroyEffect(OG7(I97,"FX"))
call OZ7(t)
call FlushChildHashtable(L7,(I97))
call UnitRemoveType(m5,UNIT_TYPE_PEON)
call X37(GetOwningPlayer(p5),GetObjectName('n03G'))
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A0R0',true)
call SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A2MB',false)
elseif GetTriggerEventId()==EVENT_UNIT_SPELL_EFFECT then
if B287_GetSpellAbilityId()=='A2MB' then
call DestroyEffect(OG7(I97,"FX"))
call OZ7(t)
call FlushChildHashtable(L7,(I97))
call UnitRemoveType(m5,UNIT_TYPE_PEON)
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A0R0',true)
call SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A2MB',false)
endif
else
call DestroyEffect(OG7(I97,"FX"))
call OZ7(t)
call FlushChildHashtable(L7,(I97))
call UnitRemoveType(m5,UNIT_TYPE_PEON)
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A0R0',true)
call SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A2MB',false)
call DIE(p5,m5)
endif
set t=null
set p5=null
set m5=null
return false
endfunction
