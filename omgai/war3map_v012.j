call SaveReal(L7,(OB7),(7),((GetUnitY(p5))*1.0))
call SaveReal(L7,(OB7),(8),GetGameTime()+12.)
call TriggerRegisterTimerEvent(t,0.015,true)
call TriggerAddCondition(t,Condition(function WW24))
set t=null
endfunction
