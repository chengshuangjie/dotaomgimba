if x5==null then
return-2
endif
set o5=GetItemTypeId(x5)
loop
exitwhen i>EV
if SU[i]==o5 or ZU[i]==o5 or BU[i]==o5 then
return i
endif
set i=i+1
endloop
return-1
endfunction
