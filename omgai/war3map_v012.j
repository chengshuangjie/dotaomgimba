function BXD_EXPIRE_TRI takes nothing returns nothing
    local unit WI7=GetEnumUnit()
    local integer OB7
    local trigger t
    call DisableTrigger(H94)
    call C27("AegisOff",GetPlayerId(GetOwningPlayer(WI7)))
    call UnitRemoveAbility(WI7,'A2YV')
    call UnitRemoveAbility(WI7,'A2YW')
    call UnitRemoveAbility(WI7,'B0I1')
    set OB7=GetHandleId(WI7)
    set t=LoadTriggerHandle(L7,OB7,'A2YV')
	call RemoveSavedHandle(L7,OB7,'A2YV')
	if t!=null then
		call OZ7(t)
	endif
    call I6O(WI7)
    call EnableTrigger(H94)
    set WI7=null
    set t=null
endfunction 
