function H9D takes nothing returns nothing
local unit suijiSilencerCaster=GetTriggerUnit()
local location XX8=null
local trigger t=null
local integer suijiSilencerLevel=0
local boolean suijiSilencerScepter=false
if suijiSilencerCaster==null or GetUnitTypeId(suijiSilencerCaster)==0 then
set suijiSilencerCaster=null
return
endif
if SuijiMode_ShouldBlockScepterPairReentry(suijiSilencerCaster,B287_GetSpellAbilityId(),'A0L3','A2SU',"SuijiSilencerGlobalPair",.60) then
set suijiSilencerCaster=null
return
endif
set suijiSilencerScepter=SuijiMode_HasAghanimState(suijiSilencerCaster)
set suijiSilencerLevel=SuijiMode_GetPairCastLevel(suijiSilencerCaster,B287_GetSpellAbilityId(),'A0L3','A2SU')
call SuijiMode_StartPairCooldownSync(suijiSilencerCaster,B287_GetSpellAbilityId(),'A0L3','A2SU',"SuijiSilencerGlobalCooldown",130.,115.,100.,130.,115.,100.)
set XX8=GetUnitLoc(suijiSilencerCaster)
set t=CreateTrigger()
if suijiSilencerScepter then
call DZZ()
endif
call TriggerRegisterTimerEvent(t,suijiSilencerLevel+3,false)
call TriggerAddCondition(t,Condition(function H8D))
call CreateNUnitsAtLoc(1,'e00E',GetOwningPlayer(suijiSilencerCaster),XX8,bj_UNIT_FACING)
call ShowUnitHide(bj_lastCreatedUnit)
call UnitApplyTimedLifeBJ(5.,'BTLF',bj_lastCreatedUnit)
call UnitAddAbility(bj_lastCreatedUnit,'A0L2')
call SetUnitAbilityLevelSwapped('A0L2',bj_lastCreatedUnit,suijiSilencerLevel)
call IssuePointOrderByIdLoc(bj_lastCreatedUnit,$D0270,XX8)
call VolumeGroupSetVolume(SOUND_VOLUMEGROUP_UNITSOUNDS,.0)
