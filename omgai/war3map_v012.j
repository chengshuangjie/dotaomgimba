function MR_chongjibo takes nothing returns nothing
	local unit u = GetTriggerUnit()
	local real x = GetUnitX(u)
	local real y = GetUnitY(u)
	local real length
    local integer ZZMF_level=GetUnitAbilityLevel(u,'A4DJ')+GetUnitAbilityLevel(u,'A4DZ')
    local integer ZZMF=0
    if ZZMF_level>0 then
        set ZZMF=50*ZZMF_level
    endif
    if GetUnitAbilityLevel(u,'A2YK')>0 then
    set length=1200+ZZMF
    elseif GetUnitAbilityLevel(u,'A2YJ')>0 then
    set length=1150+ZZMF
    else
    set length=1000+ZZMF
    endif
	call Wave(u,'h0H3', 250., length, 150, 150, x, y, GetSpellTargetX(), GetSpellTargetY(), 1050, 1, false, "", 1)
	set u = null
endfunction
function YG_chongjibo takes nothing returns nothing
	local unit u = GetTriggerUnit()
	local real x = GetUnitX(u)
	local real y = GetUnitY(u)
	local real length
    set length=800
	call Wave(u,'h0H3', 150., length, 150, 150, x, y, GetSpellTargetX(), GetSpellTargetY(), 1050, 1, false, "", 1)
	set u = null
endfunction
