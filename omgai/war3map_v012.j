call UnitRemoveAbility(p5,'A1J5')
call UnitRemoveAbility(p5,'A1IU')
call TP7(B07)
call NM7(OB7)
call OZ7(t)
endif
else
call TP7(B07)
call NM7(OB7)
call OZ7(t)
endif
set t=null
set p5=null
set m5=null
return false
endfunction
