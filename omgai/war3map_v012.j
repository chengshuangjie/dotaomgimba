function AIZB takes unit it,player p,integer zbbh returns nothing
local item zb
set zb=UnitAddItemById(it,ZU[zbbh])
call SetItemPlayer(zb,p,true)
call SetItemUserData(zb,1)
if zbbh==DI4 then
call SetItemCharges(zb,20)
call SaveInteger(TABLE_VV,'I0BK',GetPlayerId(GetOwningPlayer(it)),20)
endif
set zb=null
endfunction
function AIPD takes unit it,integer O5 returns boolean
if XM_MODE and GetUnitLevel(it)>=25 and AISZ[O5]==0 and GBAISZ==false then
return true
endif
return false
endfunction
function AISJPD takes unit it,integer O5 returns boolean
local real Time1
//XM 非死亡 非掉落 最晚40分钟最早30分钟
set Time1=RMinBJ(2400.-XM_EXP*30.,2400.)
set Time1=RMaxBJ(Time1,1800.)
if XM_MODE and (not D4 and not R4) and GetUnitLevel(it)>=25 and AISZ[O5]==1 and AISJ[O5]==0 and GBAISZ==false and (TimerGetElapsed(W)-M_4)>Time1 then
return true
endif
return false
endfunction
function AIXLPD takes unit it,integer O5 returns boolean
if XM_MODE and GetUnitLevel(it)>=25 and AIXLSZ[O5]==0 and GBAISZ==false then
return true
endif
return false
endfunction
function AIXLHZB2 takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local player p=O97(OB7,"Player")
local unit it=O77(OB7,"Source")
local integer O5=OM7(OB7,"O5")
local unit u
local integer n=GetTriggerEvalCount(t)
if n==1 then
set GE7[112+O5]=true
call IssueImmediateOrderById(it,$D0272)
endif
if n==2 then
set u=ZHE(O5,it,false)
if u!=null and AIXLSZ[O5]==0 then
set GE7[$C0+O5]=true
set AIBRZB[O5]=1
call AISCZB(u)
call AIZB(u,p,EZB)
call AIZB(u,p,H2)
call AIZB(u,p,it_qiangxi)
call AIZB(u,p,it_bingjia)
call AIZB(u,p,it_jm)
call AIZB(u,p,R2)
call ZJE(O5,u) //同步熊灵装备
call XF7(u,'A2Q5')
call XF7(u,'A2Q3')
set CHIYYBEAR[O5]=1
set AIXLSZ[O5]=1
set AIBRZB[O5]=0
endif
call NM7(OB7)
call OZ7(t)
endif
set t=null
set it=null
set u=null
set p=null
return false
endfunction
function AIXLHZB takes integer O5,integer i1,unit it,player p returns nothing
local trigger t
local integer OB7
if i1=='N01O' or i1=='N013' or i1=='N014' or i1=='N015' then
call UnitResetCooldown(it)
if B287_GetUnitAbilityLevel(it,'A0A5')!=4 then
call SelectHeroSkill(it,'A0A5')
call SelectHeroSkill(it,'A0A5')
call SelectHeroSkill(it,'A0A5')
call SelectHeroSkill(it,'A0A5')
endif
set t=CreateTrigger()
set OB7=GetHandleId(t)
call TriggerRegisterTimerEvent(t,1,true)
call TriggerAddCondition(t,Condition(function AIXLHZB2))
call NZ7(OB7,"Player",p)
call NT7(OB7,"Source",it)
call NP7(OB7,"O5",O5)
set t=null
endif
endfunction
