function ShuangXiongTime2 takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit HKI=(LoadUnitHandle(TABLE_XJ,(OB7),(14)))
local real N2I=(LoadReal(TABLE_XJ,(OB7),(232)))
local unit u=(LoadUnitHandle(TABLE_XJ,(OB7),(231)))
local integer H5I=GetTriggerEvalCount(t)
local real r=0
local integer i=0
local real x=0
local real y=0
if HKI==null or u==null or GetUnitTypeId(HKI)==0 or GetUnitTypeId(u)==0 or N2I<=0 then
call FlushChildHashtable(TABLE_XJ,(OB7))
call OZ7(t)
if u!=null and GetUnitTypeId(u)!=0 then
call ShowUnit(u,false)
call RemoveUnit(u)
endif
set t=null
set u=null
set HKI=null
return false
endif
set r=YK7(N2I-H5I*0.05,0)
set i=YH7(R2I((r/N2I)*50),2)
set x=GetUnitX(HKI)
set y=GetUnitY(HKI)
call SetUnitX(u,x)
call SetUnitY(u,y)
call SetUnitFlyHeight(u,160,0)
call SetUnitAnimationByIndex(u,i)
if r==0 or GetTriggerEventId()==EVENT_UNIT_DEATH or UnitAlive(HKI)==false then
call FlushChildHashtable(TABLE_XJ,(OB7))
call OZ7(t)
call ShowUnit(u,false)
call RemoveUnit(u)
endif
set t=null
set u=null
set HKI=null
return false
endfunction
function ShuangXiongTime takes unit HKI,real N2I returns nothing
local trigger t=null
local integer OB7=0
local unit u=null
local integer r=0
local integer g=0
local integer b=0
local integer a=0
if HKI==null or GetUnitTypeId(HKI)==0 then
set HKI=null
return
endif
set t=CreateTrigger()
set OB7=GetHandleId(t)
set u=CreateUnit(GetOwningPlayer(HKI),'h0HP',GetUnitX(HKI),GetUnitY(HKI),bj_UNIT_FACING)
set r=KA4[GetPlayerId(GetOwningPlayer(HKI))]
set g=KB4[GetPlayerId(GetOwningPlayer(HKI))]
set b=KC4[GetPlayerId(GetOwningPlayer(HKI))]
if u==null or GetUnitTypeId(u)==0 then
call FlushChildHashtable(TABLE_XJ,(OB7))
call OZ7(t)
set HKI=null
set u=null
set t=null
return
endif
if IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(HKI)) or WG7(GetLocalPlayer())then
call SetUnitVertexColor(u,r,g,b,255)
else
call SetUnitVertexColor(u,r,g,b,a)
endif
call UnitAddAbility(u,'Amrf')
call UnitRemoveAbility(u,'Amrf')
call SetUnitFlyHeight(u,160,0)
call SetUnitAnimationByIndex(u,52)
call PauseUnit(u,true)
call SaveUnitHandle(TABLE_XJ,(OB7),(14),(HKI))
call SaveUnitHandle(TABLE_XJ,(OB7),(231),(u))
call SaveReal(TABLE_XJ,(OB7),(232),((N2I)*1.0))
call TriggerRegisterTimerEvent(t,0.05,true)
call TriggerRegisterUnitEvent(t,HKI,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function ShuangXiongTime2))
set u=null
set t=null
endfunction
