if N5E>0 then
call Y57(GetOwningPlayer(p5),10.4,x,y,360)
call TriggerRegisterTimerEvent(t,.4,true)
call TriggerAddCondition(t,Condition(function HVD))
call NT7(I97,"Source",p5)
call NQ7(I97,"x",(x)*1.)
call NQ7(I97,"y",(y)*1.)
call NP7(I97,"Level",(BC7))
call RemoveLocation(l)
call UnitRemoveAbility(p5,skill)
set N5E=N5E-1
call SaveInteger(MSK,(OB7),(30),(N5E))
set skill=(LoadInteger(MSK,(OB7),(N5E)))
call XF7(p5,skill)
call SetUnitAbilityLevel(p5,skill,BC7)
call Reset_Skill_range(p5)
else
call RemoveLocation(l)
call OZ7(t)
call X377(GetOwningPlayer(p5),"无可用次数")
endif
if N5E==0 then
set WF8=(LoadReal(MSK,(OB7),(50)))
if WF8>0 then
call Japi_ReduceUnitAbilityCoolDown(p5,skill,WF8)
endif
endif
set t=null
set p5=null
set l=null
endfunction
