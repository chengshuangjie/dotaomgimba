function SuijiMode_LycanWolvesMulticastExtra takes unit suijiLycanWolfCaster returns nothing
local player j8=null
local integer id=0
local integer V77=0
local real x=0.
local real y=0.
local real x1=0.
local real y1=0.
local real x2=0.
local real y2=0.
