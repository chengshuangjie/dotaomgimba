function SuijiMode_MidnightPulseEffect takes unit ZX7,real x,real y returns nothing
local location Sa=null
local integer kt=0
local unit BB7=null
local integer id=0
local integer skill
local integer suijiA0B1CasterHandle=0
local boolean suijiA0B1RandomCaster=false
if ZX7==null or GetUnitTypeId(ZX7)==0 then
set ZX7=null
return
endif
set Sa=Location(x,y)
set kt=B287_GetUnitAbilityLevel(ZX7,'A0B1')
set BB7=CreateUnitAtLoc(GetOwningPlayer(ZX7),'e00E',Sa,0)
set id=GetUnitTypeId(ZX7)
set suijiA0B1CasterHandle=GetHandleId(ZX7)
if id=='Zktl' then
    set skill='A4GN'
    call YT7("model\\Hero_Enigma_N1S_D_Circle.mdl",x,y,11.)
else
set skill='A0B2'
endif
if SUIJI_MODE and LoadBoolean(L7,suijiA0B1CasterHandle,StringHash("SuijiDone")) and (LoadInteger(L7,suijiA0B1CasterHandle,StringHash("SuijiSmallSkill"))=='A0B1' or LoadInteger(L7,suijiA0B1CasterHandle,StringHash("SuijiUltSkill"))=='A0B1') then
set suijiA0B1RandomCaster=true
endif
call ShowUnitHide(BB7)
call UnitApplyTimedLifeBJ(11.,'BTLF',BB7)
call UnitAddAbility(BB7,skill)
call SetUnitAbilityLevelSwapped(skill,BB7,kt)
call IssuePointOrderByIdLoc(BB7,$D00FD,Sa)
if(GetPlayerController(GetOwningPlayer(ZX7))!=MAP_CONTROL_USER and suijiA0B1RandomCaster==false)then
loop
call J_7(.9)
exitwhen(IsUnitDeadBJ(BB7))
if(GetUnitCurrentOrder(BB7)!=$D00FD)then
call UnitRemoveAbility(BB7,skill)
call UnitAddAbility(BB7,skill)
call SetUnitAbilityLevelSwapped(skill,BB7,kt)
call IssuePointOrderByIdLoc(BB7,$D00FD,Sa)
endif
endloop
endif
call RemoveLocation(Sa)
set ZX7=null
set BB7=null
set Sa=null
endfunction
