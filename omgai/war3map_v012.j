if GetRandomInt(1,100)<=40 and m9(WI7,x9,$578)then
call SetUnitState(WI7,UNIT_STATE_MANA,GetUnitState(WI7,UNIT_STATE_MANA)+(.05*sr+.05)*GetUnitState(WI7,UNIT_STATE_MAX_MANA))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\ReplenishMana\\ReplenishManaCasterOverhead.mdl",WI7,"overhead"))
