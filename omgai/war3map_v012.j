set AL4=BC7
call GroupEnumUnitsInRange(g,GetUnitX(IH7),GetUnitY(IH7),700+25,Condition(function AJ7_gai))
call GroupRemoveUnit(g,IH7)
call ForGroup(g,function S7F)
call WR7(g)
set g=null
