if B287_GetSpellAbilityId()=='A15W' or B287_GetSpellAbilityId()=='A4G8'  then
call LMF(B287_GetSpellAbilityId())
endif
endfunction

function QTYUW takes nothing returns nothing
	local timer t = GetExpiredTimer()
	local integer h = GetHandleId(t)
	local unit WEEUQ = LoadUnitHandle(TABLE_HY, h, 0)
	local unit WWUTQ = LoadUnitHandle(TABLE_HY, h, 1)
	if UnitAlive(WEEUQ) and UnitAlive(WWUTQ) then
		call IssueTargetOrderById(WEEUQ, 851983, WWUTQ)
	endif
	call PauseTimer(t)
	call FlushChildHashtable(TABLE_HY, GetHandleId(t))
	call DestroyTimer(t)
	set WEEUQ = null
	set WWUTQ = null
	set t = null
endfunction

function QTUQW takes unit WEEUQ, unit WWUTQ returns nothing
	local integer h = TimerStartSingle(0.02, function QTYUW)
	call SaveUnitHandle(TABLE_HY, h, 0, WEEUQ)
	call SaveUnitHandle(TABLE_HY, h, 1, WWUTQ)
endfunction

function QTUEW takes nothing returns nothing
	local trigger t = GetTriggeringTrigger()
	local integer h = GetHandleId(t)
	local unit u = LoadUnitHandle(TABLE_HY, h, 0)
	local unit target = LoadUnitHandle(TABLE_HY, h, 1)
	local integer hu = GetHandleId(u) 
	local integer int = LoadInteger(TABLE_HY, h, 10)
	local integer id
	if LoadReal(TABLE_HY, hu,'A3UC')> 0 then
		if GetTriggerEventId()== EVENT_UNIT_ACQUIRED_TARGET then
			call QTUWW(u, GetEventTargetUnit() == target)
		else
			set id = GetIssuedOrderId()
			if id == 851983 or (id == 851971 and GetOrderTargetUnit()== target)  then 
				call QTUWW(u, GetOrderTargetUnit()== target)
				set int = int + 1
				call SaveInteger(TABLE_HY, h, 10, int)
			endif
		endif
	endif
	if int == 4 or GetTriggerEventId()== EVENT_GAME_TIMER_EXPIRED then
		call FlushChildHashtable(TABLE_HY, h)
		call OZ7(t)
		call QTUWW(u, false)
		if GetUnitAbilityLevel(u,'A3UC')> 0 then
			call UnitRemoveAbility(u,'A3UC')
			call UnitRemoveAbility(u,'B0KU')
		endif
	endif
	set target = null
	set u = null
	set t = null
endfunction
function QTURW takes unit u, unit target returns nothing
	local trigger t = CreateTrigger()
	local integer h = GetHandleId(t)
	call QTUWW(u, true)
	call SaveInteger(TABLE_HY, h, 10, 0)
	call SaveUnitHandle(TABLE_HY, h, 0, u)
	call SaveUnitHandle(TABLE_HY, h, 1, target)
	call TriggerRegisterTimerEvent(t, 5., false)
	call TriggerRegisterUnitEvent(t, u, EVENT_UNIT_ISSUED_TARGET_ORDER)
	call TriggerRegisterUnitEvent(t, u, EVENT_UNIT_ISSUED_POINT_ORDER)
	call TriggerRegisterUnitEvent(t, u, EVENT_UNIT_ACQUIRED_TARGET)
	call TriggerAddCondition(t, Condition(function QTUEW))
	set t = null
endfunction
function YRQEQ takes player p, player t returns nothing
	call SaveReal(TABLE_HY, GetHandleId(t), GetPlayerId(p)+'buff', GetGameTime())
endfunction
function QTRUW takes unit u returns boolean
	return OT7(u,"4306") or OT7(u,"4307") or OT7(u,"4324") or OT7(u,"HideUnit")
endfunction
function QTTQW takes nothing returns boolean
	local trigger t = GetTriggeringTrigger()
	local integer h = GetHandleId(t)
    local unit WWETQ =(LoadUnitHandle(TABLE_HY, h, 16))
	local unit WWUTQ =(LoadUnitHandle(TABLE_HY, h, 17))
	local real TWQUQ =(LoadReal(TABLE_HY, h, 137))
	local real RTRWQ =(LoadReal(TABLE_HY, h, 138))
	local real dx
	local real dy
	local integer c = GetTriggerEvalCount(t)
	local integer hu = GetHandleId(WWUTQ)
	if c == 11 or GetTriggerEventId()== EVENT_WIDGET_DEATH or LoadInteger(TABLE_HY, hu, 4260)== 1 or LoadInteger(TABLE_HY, hu,'ublo')== 1 then
        if LoadBoolean(TABLE_HY, h, 99) then //3秒视野马甲
            call KillUnit(CreateUnit(GetOwningPlayer(WWETQ),'e12C',GetUnitX(WWUTQ),GetUnitY(WWUTQ),0))
        endif
        call FlushChildHashtable(TABLE_HY,h)
		call OZ7(t)
	else
		if(not QTRUW(WWUTQ)) then
			//call H5O(WWUTQ,4414,0.1)
			set dx = CoordinateX50(GetUnitX(WWUTQ)+ RTRWQ / 10. * Cos(TWQUQ * bj_DEGTORAD))
			set dy = CoordinateY50(GetUnitY(WWUTQ)+ RTRWQ / 10. * Sin(TWQUQ * bj_DEGTORAD))
			call DestroyEffect(AddSpecialEffect(LoadStr(TABLE_HY, h, 12), dx, dy))
			call SetUnitX(WWUTQ, dx)
			call SetUnitY(WWUTQ, dy)
		endif
	endif
    set WWETQ = null
	set WWUTQ = null
	set t = null
	return false
endfunction
function QTTWW takes unit WEEUQ, unit WWUTQ, real TWRRQ, real QEEQQ, unit QTTEW returns nothing
	local trigger t
	local integer h
	local real x
	local real y
	local real RTRWQ
	local real TWQUQ
	local integer i =-1
	local real QTTRW
	local real QTTTW
	local real dx
	local real dy
	if GetUnitAbilityLevel(WWUTQ,'A32U')!= 0 then
		return
	endif
	set t = CreateTrigger()
	set h = GetHandleId(t)
	if WWUTQ == null and GetSpellTargetItem()!= null then
		set WWUTQ = WEEUQ
	endif
	if QTTEW != null then
		set TWQUQ = AngleBetweenUnit(WEEUQ, WWUTQ)
		if WEEUQ == WWUTQ then
			set TWQUQ = AngleBetweenUnit(QTTEW, WEEUQ)
		endif
	else
		set TWQUQ = GetUnitFacing(WWUTQ)
	endif
	set QTTRW = Cos(TWQUQ * bj_DEGTORAD)
	set QTTTW = Sin(TWQUQ * bj_DEGTORAD)
	set dx = GetUnitX(WWUTQ)
	set dy = GetUnitY(WWUTQ)
	set x = CoordinateX50(dx +(TWRRQ -i * 25)* QTTRW)
	set y = CoordinateY50(dy +(TWRRQ -i * 25)* QTTTW)
	if IsUnitAlly(WWUTQ, GetOwningPlayer(GetTriggerUnit())) then
		if IsUnitType(WWUTQ, UNIT_TYPE_HERO) then
			call YRQEQ(GetOwningPlayer(GetTriggerUnit()), GetOwningPlayer(WWUTQ))
		endif
    else
        if MV7(WEEUQ,ZU[it_bfcj])!=null then
            call SaveBoolean(TABLE_HY, h, 99,true)
        endif
	endif
	set RTRWQ = SquareRoot((x -GetUnitX(WWUTQ))*(x -GetUnitX(WWUTQ))+(y -GetUnitY(WWUTQ))*(y -GetUnitY(WWUTQ)))
	call TriggerRegisterTimerEvent(t, QEEQQ / 10., true)
	call TriggerRegisterDeathEvent(t, WWUTQ)
	call TriggerAddCondition(t, Condition(function QTTQW))
    call SaveUnitHandle(TABLE_HY, h, 16,(WEEUQ))
	call SaveUnitHandle(TABLE_HY, h, 17,(WWUTQ))
	call SaveReal(TABLE_HY, h, 137,((TWQUQ)* 1.0))
	call SaveReal(TABLE_HY, h, 138,((RTRWQ)* 1.0))
	call SaveStr(TABLE_HY, h, 12, "Abilities\\Spells\\Human\\FlakCannons\\FlakTarget.mdl")
	set WWUTQ = null
	set t = null
endfunction

//大推推 目标敌人
function QTUTW takes nothing returns nothing
	local unit u = GetTriggerUnit()
	local unit WWUTQ = GetSpellTargetUnit()
	local integer h
	if GetUnitTypeId(u)!='e00E'then
			call QTTWW(u, WWUTQ, 450., 0.2, WWUTQ)
			call QTTWW(u, u, 450., 0.2, WWUTQ)
	else
		set u = LoadUnitHandle(TABLE_HY, GetHandleId(u), 0)
	endif
	set h = GetHandleId(u)
	if u != null then
		call Z57(u,'A3UC', 1, 5.,'B0KU')
		call SaveReal(TABLE_HY, h,'A3UC', GetGameTime()+ 5.)
		if not IsUnitType(u, UNIT_TYPE_MELEE_ATTACKER) then
			call QTUQW(u, WWUTQ)
			call QTURW(u, WWUTQ)
		endif
		call SaveInteger(TABLE_HY, h,'A3UC', 5)
		call SaveUnitHandle(TABLE_HY, h,'A3UC', WWUTQ)
	endif
	set u = null
	set WWUTQ = null
endfunction
//小推推
function LOF takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit m5=O77(OB7,"Target")
local real a=ON7(OB7,"a")
local real d=ON7(OB7,"d")
local real x=X17(GetUnitX(m5)+d/ $A*Cos(a*bj_DEGTORAD))
local real y=X07(GetUnitY(m5)+d/ $A*Sin(a*bj_DEGTORAD))
if GetTriggerEvalCount(t)==$B or GetTriggerEventId()==EVENT_UNIT_DEATH or OT7(m5,"PowerCogShocked") then
call NM7(OB7)
call OZ7(t)
else
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\FlakCannons\\FlakTarget.mdl",x,y))
if QTRUW(m5)==false and GetUnitAbilityLevel(m5,'B08V')==0 and GetUnitAbilityLevel(m5,'B0FG')==0 then
call Y67(x,y,$96)
call SetUnitX(m5,x)
call SetUnitY(m5,y)
endif
endif
set m5=null
set t=null
return false
endfunction
function LPF takes nothing returns nothing
local unit m5=GetSpellTargetUnit()
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local real x
local real y
local real d
local real a
local integer i=-1
local boolean LQF=false
if GetSpellTargetItem()!=null then
set m5=GetTriggerUnit()
endif
call O37(m5,"4414",3)
set a=GetUnitFacing(m5)
loop
exitwhen LQF or i==23
set i=i+1
set x=X17(GetUnitX(m5)+(600-i*25)*Cos(a*bj_DEGTORAD))
set y=X07(GetUnitY(m5)+(600-i*25)*Sin(a*bj_DEGTORAD))
if(IsPointInRegion(IU4,((x)*1.),((y)*1.)))==false then
set LQF=true
endif
endloop
set d=KF7(x,y,GetUnitX(m5),GetUnitY(m5))
call TriggerRegisterTimerEvent(t,.04,true)
call TriggerRegisterUnitEvent(t,m5,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function LOF))
call NT7(OB7,"Target",m5)
call NQ7(OB7,"a",(a)*1.)
call NQ7(OB7,"d",(d)*1.)
call NS7(OB7,"AI",(TZ7(GetOwningPlayer(m5)))and(IsUnitAlly(m5,GetOwningPlayer(GetTriggerUnit()))))
set m5=null
set t=null
endfunction
function LRF takes nothing returns nothing
if B287_GetSpellAbilityId()=='A19M' and GetUnitTypeId(GetSpellTargetUnit())!='n00L' then
	if IsUnitEnemy(GetSpellTargetUnit(),GetOwningPlayer(GetTriggerUnit())) then
		if WF7(GetSpellTargetUnit()) then
			call KR7(GetTriggerUnit())
call X37(GetOwningPlayer(GetTriggerUnit()),GetObjectName('n0LR'))
			call Japi_ReduceUnitAbilityCoolDown(GetTriggerUnit(),'A19M',0.)
			return
		endif
		if WQ7(GetSpellTargetUnit()) then
			return
		endif
	endif
if IsUnitEnemy(GetSpellTargetUnit(),GetOwningPlayer(GetTriggerUnit())) or OO7(GetHandleId(GetOwningPlayer(GetSpellTargetUnit())),"DisableHelp")==false or GetSpellTargetUnit()==GetTriggerUnit() then
call LPF()
endif
endif
endfunction
function LRFF takes nothing returns nothing
local unit IH7=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
if B287_GetSpellAbilityId()=='A3U8' and GetUnitTypeId(m5)!='n00L' then
	if IsUnitEnemy(m5,GetOwningPlayer(IH7)) then
		if WQ7(GetSpellTargetUnit()) then
			set IH7=null
			set m5=null
			return
		endif
	endif
if IsUnitAlly(m5,GetOwningPlayer(IH7)) and OO7(GetHandleId(GetOwningPlayer(m5)),"DisableHelp")==true then
set IH7=null
set m5=null
return
endif
if IsUnitAlly(m5,GetOwningPlayer(IH7)) or m5==IH7 or GetSpellTargetItem()!=null then
//小推推
call LPF()
else
//大推推
call QTUTW()
endif
endif
set IH7=null
set m5=null
endfunction
function LSF takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit p5=O77(OB7,"Source")
if GetTriggerEvalCount(t)>40 or GetTriggerEventId()==EVENT_UNIT_DEATH or WF7(p5)or OT7(p5,"Teleporting")then
call UnitRemoveAbility(p5,'Aetl')
call NM7(OB7)
call OZ7(t)
endif
set p5=null
set t=null
return false
endfunction
function LTF takes nothing returns nothing
local unit p5=GetTriggerUnit()
local trigger t
local integer I97
if KW7(p5)==false then
set t=CreateTrigger()
set I97=GetHandleId(t)
call UnitAddAbility(p5,'Aetl')
call UnitMakeAbilityPermanent(p5,true,'Aetl')
call SetPlayerAbilityAvailable(GetOwningPlayer(p5),'Aetl',false)
call TriggerRegisterTimerEvent(t,.1,true)
call TriggerRegisterUnitEvent(t,p5,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function LSF))
call NT7(I97,"Source",p5)
endif
set p5=null
set t=null
endfunction
function LUF takes nothing returns nothing
if B287_GetSpellAbilityId()=='A1AC' and WF7(GetTriggerUnit())==false then
call LTF()
endif
endfunction
function LVF takes nothing returns nothing
local unit p5=GetTriggerUnit()
local real x
local real y
if KV7(p5) then
if TW7(GetOwningPlayer(p5))then
set x=JY4+200.
set y=JZ4+200.
else
set x=IX4-200.
set y=IY4-200.
endif
else
if TV7(GetOwningPlayer(p5))then
set x=GetRectCenterX(ED)
set y=GetRectCenterY(ED)
else
set x=GetRectCenterX(L9)
set y=GetRectCenterY(L9)
endif
endif
call IssuePointOrderById(p5,$D0012,x,y)
set p5=null
endfunction
function LWF takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local real x
local real y
if TV7(GetOwningPlayer(ZX7))then
set x=-4533
set y=$486
else
set x=$C76
set y=-35
endif
call IssuePointOrderById(ZX7,$D0012,x,y)
set ZX7=null
endfunction
function LXF takes nothing returns nothing
if B287_GetSpellAbilityId()=='A1AS' then
call LVF()
elseif B287_GetSpellAbilityId()=='A2KS' then
call LWF()
endif
endfunction
function LYF takes nothing returns nothing
if OT7(GetEnumUnit(),"PipeOfInsightOn") then
call X37(GetOwningPlayer(GetEnumUnit()),GetObjectName('n02M'))
else
if IsUnitType(GetEnumUnit(),UNIT_TYPE_HERO) then
call O37(GetEnumUnit(),"PipeOfInsightOn",50)
endif
if GetUnitAbilityLevel(GetEnumUnit(),'B0BT')==0 and GetUnitAbilityLevel(GetEnumUnit(),'B0BU')==0 then
call IssueTargetOrderById(Mw,$D00DA,GetEnumUnit())
endif
endif
endfunction
function LZF takes nothing returns nothing
local unit p5=GetTriggerUnit()
local group g=WS7()
set Mw=CreateUnit(GetOwningPlayer(p5),'e00E',GetUnitX(p5),GetUnitY(p5),0)
call UnitAddAbility(Mw,'A1EV')
call GroupEnumUnitsInRange(g,GetUnitX(p5),GetUnitY(p5),925,Condition(function BN7))
call ForGroup(g,function LYF)
call WR7(g)
set p5=null
set g=null
endfunction
function LAF takes nothing returns nothing
if B287_GetSpellAbilityId()=='A1EW' then
call LZF()
endif
endfunction
