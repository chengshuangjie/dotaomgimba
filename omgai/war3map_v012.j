if KZ7(GetManipulatedItem())==it_zhzg then
call UnitRemoveAbility(WI7,'A2YN')
endif
if KZ7(GetManipulatedItem())==it_fls then
call UnitRemoveAbility(WI7,'A4E5')
endif
endif
if GetTriggerEventId()==EVENT_PLAYER_UNIT_PICKUP_ITEM then
if KZ7(GetManipulatedItem())==DM4 then
call UnitAddAbility(WI7,'A0PU')
call UnitMakeAbilityPermanent(WI7,true,'A0PU')
endif
// if KZ7(GetManipulatedItem())==it_sadan then
