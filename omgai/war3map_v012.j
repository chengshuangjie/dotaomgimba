if u==null or GetUnitTypeId(u)==0 or UnitAlive(u)==false then
if tt!=null then
call SetTextTagVisibility(tt,false)
call DestroyTextTag(tt)
endif
call FlushChildHashtable(TABLE_HY,h)
call FlushChildHashtable(L7,((h)))
call OZ7(t)
set u=null
set tt=null
set t=null
return
endif
set hu=GetHandleId(u)
set d=SquareRoot((GetUnitX(u)-(LoadReal(L7,(h),($688DFB59))))*(GetUnitX(u)-(LoadReal(L7,(h),($688DFB59))))+(GetUnitY(u)-(LoadReal(L7,(h),(-$5F89FBF))))*(GetUnitY(u)-(LoadReal(L7,(h),(-$5F89FBF)))))
set value=(LoadReal(L7,(hu),(-$58A9EA4D)))
if IsUnitAliveBJ(u)then
if GetUnitAbilityLevel(u,'B0KC')==0 and ISPH(u)==false then
if d<=75 then
set value=RMinBJ(value+d*.05,100)
call SaveReal(L7,(hu),(-$58A9EA4D),((value)*1.))
call SetTextTagTextBJ(tt,I2S(R2I(value)),16)
if value>=100 then
call Gc(u)
else
call SetTextTagColor(tt,$FF,$FF,$FF,$FF)
if GetOwningPlayer(u)==GetLocalPlayer()then
call SetTextTagVisibility(tt,true)
else
call SetTextTagVisibility(tt,false)
endif
endif
endif
else
call SetTextTagTextBJ(tt,I2S(R2I((LoadReal(L7,(hu),(-$67ECD9A8))))),16)
if GetOwningPlayer(u)==GetLocalPlayer()then
call SetTextTagVisibility(tt,true)
else
call SetTextTagVisibility(tt,false)
endif
call SetTextTagColor(tt,0,$FF,$FF,$FF)
endif
call SetTextTagPos(tt,GetUnitX(u),GetUnitY(u),60)
else
call SetTextTagVisibility(tt,false)
endif
call SaveReal(L7,(h),($688DFB59),((GetUnitX(u))*1.))
call SaveReal(L7,(h),(-$5F89FBF),((GetUnitY(u))*1.))
if u==null then
call DestroyTextTag(tt)
call FlushChildHashtable(TABLE_HY,h)
call FlushChildHashtable(L7,((h)))
call OZ7(t)
endif
set u=null
set tt=null
endfunction
function LKZD_TRI takes unit u returns nothing
local integer h
local trigger t
local texttag tt=CreateTextTag()
if GetOwningPlayer(u)==GetLocalPlayer()then
call SetTextTagVisibility(tt,true)
else
call SetTextTagVisibility(tt,false)
endif
set t=CreateTrigger()
set h=GetHandleId(t)
call TriggerAddAction(t,function LKZD_TRI2)
call TriggerRegisterTimerEvent(t,.03,true)
call SaveUnitHandle(L7,(h),(-$3CFCF863),(u))
call SaveTextTagHandle(TABLE_HY,h,0,tt)
call SaveTextTagHandle(TABLE_HY,GetHandleId(u),-$5E692E6,tt)
call SaveReal(L7,(h),($688DFB59),((GetUnitX(u))*1.))
call SaveReal(L7,(h),(-$5F89FBF),((GetUnitY(u))*1.))
set t=null
set tt=null
endfunction
function LKZD_Z07 takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit m5=LoadUnitHandle(L7,OB7,17)
local integer o6=LoadInteger(L7,OB7,59)
local integer Z17=LoadInteger(L7,OB7,60)
if TimerGetElapsed(W)>=LoadReal(L7,OB7,0)or GetTriggerEventId()==EVENT_WIDGET_DEATH or LoadBoolean(L7,OB7,0) then
    if TimerGetElapsed(W)>=LoadReal(L7,OB7,0) and Have_Item(m5, ZU[ANEW39]) and GetRandomInt(1,100)<=50 then
        call YZ8(m5)
        call YW8(m5,0,0)
        call YS7("Abilities\\Spells\\Orc\\Disenchant\\DisenchantSpecialArt.mdl",m5,"overhead",1)
    endif
    call SaveBoolean(L7,OB7,0,true)
    call UnitRemoveAbility(m5,Z17)
    call UnitRemoveAbility(m5,o6)
    call FlushChildHashtable(L7,OB7)
    call OZ7(t)
    call RemoveSavedHandle(Dvv,GetHandleId(m5),0-o6)
elseif GetUnitAbilityLevel(m5,o6)==0 and GetTriggerEvalCount(t)>1 then
    if Have_Item(m5, ZU[ANEW39]) and GetRandomInt(1,100)<=50 then
        call YZ8(m5)
        call YW8(m5,0,0)
        call YS7("Abilities\\Spells\\Orc\\Disenchant\\DisenchantSpecialArt.mdl",m5,"overhead",1)
    endif
    call SaveBoolean(L7,OB7,0,true)
    call UnitRemoveAbility(m5,Z17)
    call UnitRemoveAbility(m5,o6)
    call FlushChildHashtable(L7,OB7)
    call OZ7(t)
    call RemoveSavedHandle(Dvv,GetHandleId(m5),0-o6)
endif
set m5=null
set t=null
return false
endfunction
function LKZD_Z57 takes unit m5,integer o6,integer V77,real Z27,integer Z17 returns nothing
local trigger t
local integer OB7
local real hyy
local real Hyy=TimerGetElapsed(W)+Z27
if XH7(m5)then
return
endif
if HaveSavedHandle(Dvv,GetHandleId(m5),0-o6)then
set t=LoadTriggerHandle(Dvv,GetHandleId(m5),0-o6)
set OB7=GetHandleId(t)
else
set t=CreateTrigger()
set OB7=GetHandleId(t)
call FlushChildHashtable(L7,OB7)
call SaveUnitHandle(L7,OB7,17,m5)
call SaveInteger(L7,OB7,59,o6)
call SaveInteger(L7,OB7,60,Z17)
call SaveReal(L7,OB7,0,0)
call TriggerRegisterDeathEvent(t,m5)
call TriggerRegisterTimerEvent(t,.1,true)
call TriggerAddCondition(t,Condition(function LKZD_Z07))
call SaveTriggerHandle(Dvv,GetHandleId(m5),0-o6,t)
endif
call SaveBoolean(L7,OB7,0,false)
set hyy=LoadReal(L7,OB7,0)
if hyy<Hyy then
call SaveReal(L7,OB7,0,Hyy)
endif
set t=null
call R1T(m5,o6,V77)
endfunction
function LKZD_HD takes nothing returns nothing
local unit WI7=GetTriggerUnit()
local real YM7=GetEventDamage()
local integer id=GetUnitTypeId(WI7)
local boolean b=false
local real r1
local real d
if GetOwningPlayer(GetEventDamageSource())!=Z7[0] and GetOwningPlayer(GetEventDamageSource())!=A7[0] and(LoadReal(L7,(GetHandleId(WI7)),(-$58A9EA4D)))>=100 and YM7>2 and ISPH(WI7)==false then
call SaveReal(L7,(GetHandleId(WI7)),(-$58A9EA4D),((0)*1.))
call DestroyEffect(LoadEffectHandle(TABLE_HY,GetHandleId(WI7),-$5A98E05F))
call LKZD_Z57(WI7,'A4IY',1,2,'B0KC')
set d=100.+20*GetHeroLevel(WI7)
if Have_Item(WI7, ZU[ANEW39]) then
    set d=d*2
endif
call SaveReal(L7,(GetHandleId(WI7)),(-$67ECD9A8),(d)) //护盾值
set b=true
endif
if (GetUnitAbilityLevel(WI7,'A4IY')>0 or b) and ISPH(WI7)==false then
    set r1=(LoadReal(L7,(GetHandleId(WI7)),(-$67ECD9A8)))
    if r1>YM7 then
        call YN7(WI7,YM7)
        call SaveReal(L7,(GetHandleId(WI7)),(-$67ECD9A8),((r1-YM7)*1.))
    else
        call YN7(WI7,r1)
        call SaveReal(L7,(GetHandleId(WI7)),(-$67ECD9A8),(0.))
        call UnitRemoveAbility(WI7,'A4IY')
        call UnitRemoveAbility(WI7,'B0KC')
    endif
endif
set WI7=null
endfunction
function ZCLKZD takes nothing returns nothing
local trigger t
local unit u=IN4
if GetUnitTypeId(u)!='Z060' then
    set u=null
    return
endif
set t=CreateTrigger()
call TriggerRegisterUnitEvent(t,u,EVENT_UNIT_DAMAGED)
call TriggerAddAction(t,function LKZD_HD)
call LKZD_TRI(u)
set t=null
set u=null
endfunction





