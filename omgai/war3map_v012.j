function YU takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit WI7=(LoadUnitHandle(L7,(OB7),($E)))
local integer V77=(LoadInteger(L7,(OB7),(5)))
local group g
local unit u
local real d
local real a
local real XVD
local real XWD
local unit BB7=(LoadUnitHandle(L7,(OB7),(19)))
local integer id=(LoadInteger(L7,(OB7),(10)))
local string tx
if id=='Zkee' then
    set tx="model\\Hero_TormentedSoul_N4S_C_Target.mdl"
elseif id=='Zkef' then
    set tx="model\\Hero_TormentedSoul_N3S_C_Target.mdl"
elseif id=='Zkeg' then
    set tx="model\\Hero_TormentedSoul_N2S_C_Target.mdl"
else
    set tx="Abilities\\Weapons\\SteamTank\\SteamTankImpact.mdl"
endif
if GetTriggerEvalCount(t)>40 then
call FlushChildHashtable(L7,(OB7))
call OZ7(t)
else
set g=WS7()
set IN4=WI7
call GroupEnumUnitsInRange(g,GetUnitX(WI7),GetUnitY(WI7),500,Condition(function Yu))
set u=GroupPickRandomUnit(g)
if u==null then
set d=GetRandomReal($AF,400)
set a=GetRandomReal(0,6)
set XVD=GetUnitX(WI7)+d*Cos(a)
set XWD=GetUnitY(WI7)+d*Sin(a)
call DestroyEffect(AddSpecialEffect(tx,XVD,XWD))
else
call DestroyEffect(AddSpecialEffectTarget(tx,u,"origin"))
if IsUnitType(u,UNIT_TYPE_STRUCTURE)then
call B67(BB7,u,2,9*V77*1.4)
else
call B67(BB7,u,2,9*V77)
endif
endif
call WR7(g)
endif
set u=null
set g=null
set t=null
set WI7=null
set BB7=null
return false
endfunction
function Yv takes nothing returns nothing
