endfunction
function B291_IsToggleOrStateSkill1 takes integer id returns boolean
return id=='A21V' or id=='A21W' or id=='A21X' or id=='A21Y' or id=='A1GU' or id=='Aamk' or id=='A0NR' or id=='A02T' or id=='A0GC' or id=='A0HA' or id=='A0RT' or id=='A0SA' or id=='A121' or id=='A13D' or id=='A1MN' or id=='A1NH' or id=='A1S9' or id=='A1TU' or id=='A1WF' or id=='A1Z2' or id=='A1Z3' or id=='A205' or id=='A20N' or id=='A21H' or id=='A24A' or id=='A24B' or id=='A24E' or id=='A2MB' or id=='A2NI' or id=='A4HF'
endfunction
function B291_IsToggleOrStateSkill2 takes integer id returns boolean
return id=='Abbk' or id=='A2YR' or id=='A4HR' or id=='A4HS' or id=='A05Z' or id=='A0FP' or id=='A0QY' or id=='A06X' or id=='A0AQ' or id=='A12W' or id=='Aeat' or id=='A0JY' or id=='A0FO' or id=='A1NI' or id=='A1MI' or id=='A2SE' or id=='A1Q8' or id=='A2R8' or id=='A1RA' or id=='A1QV' or id=='A1YY' or id=='A0DY' or id=='A1WB' or id=='A0LZ' or id=='X0OI' or id=='A2XO'
endfunction
function B291_IsRealSpellCast takes unit u,integer id returns boolean
local integer physicalId
local integer level
if u==null or id==0 or LC7(id) or L67(id) or B287_IsPhase16CloneSkill(id) then
return false
endif
if B291_IsToggleOrStateSkill1(id) or B291_IsToggleOrStateSkill2(id) then
return false
endif
set physicalId=B287_GetPhysicalAbilityId(u,id)
set level=GetUnitAbilityLevel(u,physicalId)
if physicalId==0 or level<=0 then
return false
endif
return MHAbility_GetLevelDefDataInt(physicalId,level,ABILITY_LEVEL_DEF_DATA_MANA_COST)>0
endfunction
