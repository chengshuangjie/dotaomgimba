//library OMGAIGuard ends
//library OMGAILearn:

//---------------------------------------------------------------------------
// 1. 常量与状态
//---------------------------------------------------------------------------


    // 字符串工具：找字符位置（1.27 无 Find）
    function OMGAILearn___LEARN_FindChar takes string s, string c returns integer
        local integer i = 0
        loop
            exitwhen i >= StringLength(s)
            if SubString(s, i, i + 1) == c then
                return i
            endif
            set i = i + 1
        endloop
        return -1
    endfunction

//---------------------------------------------------------------------------
// 2. key 生成与场景编码
//---------------------------------------------------------------------------

    function OMGAILearn___LEARN_MakeKey takes string heroName, integer abilityId, integer context returns string
        return "OMGAI:" + heroName + ":" + I2S(abilityId) + ":" + I2S(context)
    endfunction

    // 上下文特征编码（TODO: 由 OMGAIConfig/EnemyState 填充）
    function OMGAILearn_OMGAI_LearnContext takes unit u returns integer
        // 位 0 = 近战；位 1 = 远程
        // 位 2..3 = 敌方主威胁类型
        // 位 4..5 = 己方阵容职责位
        return 0
    endfunction

//---------------------------------------------------------------------------
// 3. 存档读写（gamecache，"SCO|NBS|MIS"）
//---------------------------------------------------------------------------

    function OMGAILearn_OMGAI_LearnLoad takes string key, real sco, integer nbs, integer mis returns nothing
        local string s = ""
        local integer i1 = 0
        local integer i2_learn = 0
        local string tail = ""
        set s = GetStoredString(LEARN_CACHE, "learn", key)
        if s != "" then
            set i1 = OMGAILearn___LEARN_FindChar(s, "|")
            if i1 > 0 then
                set sco = S2R(SubString(s, 0, i1))
                set tail = SubString(s, i1 + 1, StringLength(s))
                set i2_learn = OMGAILearn___LEARN_FindChar(tail, "|")
                if i2_learn > 0 then
                    set nbs = S2I(SubString(tail, 0, i2_learn))
                    set mis = S2I(SubString(tail, i2_learn + 1, StringLength(tail)))
                endif
            endif
        endif
    endfunction

    function OMGAILearn_OMGAI_LearnSave takes string key, real sco, integer nbs, integer mis returns nothing
        if LEARN_CACHE == null then
            return
        endif
        call StoreString(LEARN_CACHE, "learn", key, R2S(sco) + "|" + I2S(nbs) + "|" + I2S(mis))
        // 同步到 KK 服务器存档（§12.3）
        // TODO: call DzAPI_Map_SaveServerValue(Player(0), key, R2S(sco)+"|"+I2S(nbs)+"|"+I2S(mis))
    endfunction

//---------------------------------------------------------------------------
// 4. bandit 更新（移动均值 + miss 重置）
//---------------------------------------------------------------------------

    function OMGAILearn_OMGAI_LearnUpdate takes string key, real delta returns nothing
        local real sco = 0.0
        local integer nbs = 0
        local integer mis = 0
        // 读取当前
        call OMGAILearn_OMGAI_LearnLoad(key, sco, nbs, mis)
        // miss 重置检查
        if mis >= LEARN_MISS_RESET then
            set sco = REWARD_WASTE
            set nbs = 1
            set mis = 0
            call OMGAILog_LOG_INFO("LEARN", "miss reset: " + key)
        else
            // SCO = (SCO*NBS + delta)/(NBS+1)
            set sco = (sco * I2R(nbs) + delta) / I2R(nbs + 1)
            set nbs = nbs + 1
            if delta < 0.0 then
                set mis = mis + 1
            else
                set mis = 0
            endif
        endif
        call OMGAILearn_OMGAI_LearnSave(key, sco, nbs, mis)
    endfunction

//---------------------------------------------------------------------------
// 5. 延迟结算（D2 OpenAI-Lite：释放后等 ΔT 按奖励权重结算）
//---------------------------------------------------------------------------

    // 施法事件登记（由 SpellCast.CastAbility 成功分支挂钩）
    function OMGAILearn_OMGAI_LearnOnCast takes unit u, integer abilityId, unit target returns nothing
        local string key = OMGAILearn___LEARN_MakeKey("hero", abilityId, OMGAILearn_OMGAI_LearnContext(u))
        if PENDING_N >= PENDING_MAX then
            return
        endif
        set PENDING_KEY[PENDING_N] = key
        set PENDING_U[PENDING_N] = u
        set PENDING_T[PENDING_N] = target
        set PENDING_N = PENDING_N + 1
    endfunction

    // 结算：击杀+100 / 造成伤害+25 / 空放-10
    function OMGAILearn_OMGAI_LearnSettle takes string key, unit u, unit target returns nothing
        local real delta = REWARD_WASTE
        if target != null then
            if GetWidgetLife(target) <= 0.405 or IsUnitType(target, UNIT_TYPE_DEAD) then
                set delta = REWARD_KILL
            elseif GetUnitState(target, UNIT_STATE_MAX_LIFE) > 0.0 then
                set delta = REWARD_HERODMG
            endif
        endif
        call OMGAILearn_OMGAI_LearnUpdate(key, delta)
    endfunction

    // 周期结算（2s）：扫描 PENDING 队列
    function OMGAILearn___LEARN_SettleTick takes nothing returns nothing
        local integer i = 0
        local string key = ""
        loop
            exitwhen i >= PENDING_N
            set key = PENDING_KEY[i]
            call OMGAILearn_OMGAI_LearnSettle(key, PENDING_U[i], PENDING_T[i])
            set PENDING_U[i] = null
            set PENDING_T[i] = null
            set PENDING_KEY[i] = ""
            set i = i + 1
        endloop
        set PENDING_N = 0
    endfunction

//---------------------------------------------------------------------------
// 6. 初始化（注册周期结算 timer）
//---------------------------------------------------------------------------

    function OMGAILearn_OMGAI_LearnInit takes nothing returns nothing
        if LEARN_INITED then
            return
        endif
        set LEARN_CACHE = InitGameCache("OMGAI_Learn")
        set LEARN_INITED = true
        set LEARN_SETTLE_TIMER = CreateTimer()
        call TimerStart(LEARN_SETTLE_TIMER, SETTLE_DELAY, true, function OMGAILearn___LEARN_SettleTick)
        call OMGAILog_LOG_INFO("LEARN", "OMGAI learn init done")
    endfunction

//---------------------------------------------------------------------------
// 7. 行为参数自适应（技能×场景评分 → 优先级修正）
//    供 OMGAIActionMask/SpellCast 读取：某技能在 context 下评分低 → 降优先级
//---------------------------------------------------------------------------

    function OMGAILearn_OMGAI_LearnPriorityBias takes string key returns real
        local real sco = 0.0
        local integer nbs = 0
        local integer mis = 0
        local real bias = 0.0
        call OMGAILearn_OMGAI_LearnLoad(key, sco, nbs, mis)
        if nbs <= 0 then
            return 0.0
        endif
        if sco > 100.0 then
            set sco = 100.0
        endif
        if sco < -100.0 then
            set sco = -100.0
        endif
        set bias = (sco - 50.0) / 100.0
        return bias
    endfunction

    // v0.11: 施法决策查询——拼 key 返回 bias（供 SpellCast 消费）
    function OMGAILearn_OMGAI_LearnBiasForCast takes unit u, integer abilityId returns real
        local string key = OMGAILearn___LEARN_MakeKey("hero", abilityId, OMGAILearn_OMGAI_LearnContext(u))
        return OMGAILearn_OMGAI_LearnPriorityBias(key)
    endfunction

//---------------------------------------------------------------------------
// 8. 崩溃上报（§12.3 ④：FATAL 转储写 KK）
//---------------------------------------------------------------------------

    function OMGAILearn_OMGAILearn_ReportCrash takes string crashKey, string summary returns nothing
        // TODO: call DzAPI_Map_SaveServerValue(Player(0), crashKey, summary)
        call OMGAILog_LOG_ERROR("LEARN", "crash report: " + crashKey)
    endfunction


//library OMGAILearn ends
//library OMGAILogger:

    // ---- 日志级别常量 ------------------------------------------------------

    // 把日志级别转字符串
    function OMGAILogger___LevelToStr takes integer lvl returns string
        if lvl == LL_DEBUG then
            return "DEBUG"
        elseif lvl == LL_INFO then
            return "INFO"
        elseif lvl == LL_WARN then
            return "WARN"
        elseif lvl == LL_ERROR then
            return "ERROR"
        elseif lvl == LL_FATAL then
            return "FATAL"
        endif
        return "?"
    endfunction

    // 把日志级别转颜色（用于屏幕显示）
    function OMGAILogger___LevelToColor takes integer lvl returns string
        if lvl == LL_DEBUG then
            return "|cff808080"          // 灰
        elseif lvl == LL_INFO then
            return "|cffc0c0c0"          // 浅灰
        elseif lvl == LL_WARN then
            return "|cffffff00"          // 黄
        elseif lvl == LL_ERROR then
            return "|cffff6060"          // 红
        elseif lvl == LL_FATAL then
            return "|cffff0000"          // 亮红
        endif
        return "|cffffffff"
    endfunction

    // 环形缓冲：写最近 8 条
    function OMGAILogger___PushLastError takes string msg returns nothing
        set OMGAI_LastErrorIndex = ModuloInteger(OMGAI_LastErrorIndex + 1, 8)
        set OMGAI_LastErrors[OMGAI_LastErrorIndex] = msg
    endfunction

    // 主日志函数
    // level - 日志级别
    // tag   - 模块标签（如 "SkillPool"）
    // msg   - 消息
    function OMGAILogger_Log takes integer lvl, string tag, string msg returns nothing
        local string formatted
        local string full

        // 降级：ERROR 超过 50 条后只放行 FATAL
        if lvl < LL_FATAL and OMGAI_ErrorCount >= 50 then
            return
        endif

        set formatted = "[" + OMGAILogger___LevelToStr(lvl) + "][" + tag + "] " + msg
        set full      = OMGAILogger___LevelToColor(lvl) + formatted + "|r"

        // DEBUG 仅在调试模式输出
        if lvl == LL_DEBUG and not OMGAI_DEBUG then
            return
        endif

        // ERROR/FATAL 写入环形缓冲
        if lvl >= LL_ERROR then
            set OMGAI_ErrorCount = OMGAI_ErrorCount + 1
            call OMGAILogger___PushLastError(formatted)
        endif

        // 屏幕实时打印（永远只对本地玩家）
        call BJDebugMsg(full)

        // 崩溃日志上报（P2 上线，先留桩）
        if lvl == LL_FATAL and OMGAI_CRASHLOG_ENABLED then
            // TODO P2: 接入 KKAPI 服务端 上报 或 Preload 文件兜底
        endif
    endfunction

    // 便捷封装
    function OMGAILogger_D takes string tag, string msg returns nothing
        call OMGAILogger_Log(LL_DEBUG, tag, msg)
    endfunction
    function OMGAILogger_I takes string tag, string msg returns nothing
        call OMGAILogger_Log(LL_INFO, tag, msg)
    endfunction
    function OMGAILogger_W takes string tag, string msg returns nothing
        call OMGAILogger_Log(LL_WARN, tag, msg)
    endfunction
    function OMGAILogger_E takes string tag, string msg returns nothing
        call OMGAILogger_Log(LL_ERROR, tag, msg)
    endfunction
    function OMGAILogger_F takes string tag, string msg returns nothing
        call OMGAILogger_Log(LL_FATAL, tag, msg)
    endfunction

    // 取最近错误（用于排查）
    function OMGAILogger_GetRecentErrors takes nothing returns string
        local string out = ""
        local integer i = 0
        loop
            exitwhen i >= 8
            if OMGAI_LastErrors[i] != null and OMGAI_LastErrors[i] != "" then
                set out = out + OMGAI_LastErrors[i] + "\n"
            endif
            set i = i + 1
        endloop
        return out
    endfunction


//library OMGAILogger ends
