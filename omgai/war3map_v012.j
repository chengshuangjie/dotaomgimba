function xF takes nothing returns nothing
local trigger t=CreateTrigger()
local integer I97=GetHandleId(t)
local unit WX7=GetTriggerUnit()
local integer BC7=B287_GetUnitAbilityLevel(WX7,'A0I6')
local group g=WS7()
local integer id=GetUnitTypeId(WX7)
local string tx
local real DUR=1.6+0.4*BC7
if id=='Zpgh' then
    set tx="model\\Hero_Axe_N9S_E_Source.mdl"
    set TX_FWE='A4KX'
    // set TX_FWE="model\\Hero_Axe_N9S_E_Target.mdl"
elseif id=='Zpgi' then
    set tx="model\\Hero_Axe_N4S_E_Source.mdl"
    set TX_FWE='A4KY'
    // set TX_FWE="model\\Hero_Axe_N4S_E_Target.mdl"
elseif id=='Zpgj' then
    set tx="AZModel\\AZ_AxeCold_E.mdl"
    set TX_FWE='A4KZ'
    // set TX_FWE="AZModel\\AZ_AxeCold_E_BUFF.mdl"
else
    set tx="Abilities\\Spells\\NightElf\\BattleRoar\\RoarCaster.mdl"
    set TX_FWE='A4L0'
    // set TX_FWE="Abilities\\Weapons\\LavaSpawnMissile\\LavaSpawnBirthMissile.mdl"
endif
call DestroyEffect(AddSpecialEffectTarget(tx,WX7,"origin"))
call XF7(WX7,'A0I5')
call SetUnitAbilityLevel(WX7,'A0I5',BC7)
set IN4=WX7
set DG7=WX7
// set IH4=0
// set tl=I97
// set IH4=0
// set tl=I97
// set IH4=0
// set tl=I97
set IJ4=DUR
call GroupEnumUnitsInRange(g,GetUnitX(WX7),GetUnitY(WX7),325,Condition(function xC))
call ForGroup(g,function xf)
call ForGroup(g,function QSD)
// call SaveInteger(L7,(I97),(365),IH4)
call SaveUnitHandle(L7,(I97),($E),WX7)
call SaveGroupHandle(L7,(I97),($DC),g)
call SaveInteger(L7,(I97),(5),(BC7))
call SaveInteger(L7,(I97),(34),(0))
call TriggerRegisterTimerEvent(t,.2,true)
call TriggerRegisterUnitEvent(t,WX7,EVENT_UNIT_DEATH)
call YB7(t,EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER)
call YB7(t,EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER)
call YB7(t,EVENT_PLAYER_UNIT_ISSUED_ORDER)
call TriggerAddCondition(t,Condition(function xE))
set t=null
set g=null
set WX7=null
endfunction
