local item suijiChihunSourceItem=MHAbility_GetSourceItem(suijiChihunUnit,B287_GetPhysicalAbilityId(suijiChihunUnit,suijiChihunSkill))
if SUIJI_MODE and ISPH(suijiChihunUnit)==false and SuijiMode_IsChihunRandomCaster(suijiChihunUnit) and suijiChihunSourceItem==null and B287_GetUnitAbilityLevel(suijiChihunUnit,suijiChihunSkill)>0 and SuijiMode_CanChihunProcBySkill(suijiChihunSkill) then
call K9G()
endif
set suijiChihunUnit=null
set suijiChihunSourceItem=null
return false
endfunction
