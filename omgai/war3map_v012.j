function SuijiMode_EnableFromOmg takes nothing returns nothing
if SUIJI_MODE then
call SuijiTest_DebugAll("OMG1","SUIJI已经开启，跳过-omg初始化")
return
endif
call SuijiMode_FixedCloneMapInit()
set SUIJI_MODE=true
call SuijiMode_AddAllCourierWardSkills()
call B287_ToggleStateInit()
set SUIJI_ALLOW=false
set QD4=QD4+60
set BPAIYC_TIME=BPAIYC_TIME+60.
call SuijiMode_ExtendOmgPrepCountdown()
call SuijiTest_DebugAll("OMG0","-omg已启用，开始初始化随机模式")
call SuijiMode_RestoreAfterSpellInit()
call SuijiAI_PulseInit()
call SuijiMode_MulticastInit()
call SuijiMode_ChannelEndInit()
call ExecuteFunc("V1G")
call SuijiMode_AghItemInit()
call SuijiMode_ChihunRandomInit()
call SuijiMode_YellowBonusInit()
call SuijiMode_IllusionPassiveInit()
call SuijiMode_ChoiceInit()
call SuijiTavern_Init()
call SuijiTavernB295_CreateSelectionArea()
call VV7(bj_FORCE_ALL_PLAYERS,12.,"|cFF00FF00-omg 随机OMG模式已开启：基础模式等同 -1；每个英雄额外获得1个小技能，5级后获得1个额外大招。|r")
call SuijiMode_ApplyExisting()
call SuijiMode_ApplyMissingHeroes()
call TimerStart(SUIJI_RESTORE_TIMER,5.,true,function SuijiMode_RestoreExisting)
endfunction
function SuijiMode_Command takes nothing returns nothing
local player p=GetTriggerPlayer()
call SuijiTest_DebugAll("CMD0","收到-suiji命令 player="+I2S(GetPlayerId(p)))
if p!=Le then
call SuijiTest_DebugAll("CMD1","不是主机，返回")
call DisplayTimedTextToPlayer(p,0,0,8.,"|cFFFFCC00只有主机可以开启 -suiji 模式|r")
set p=null
return
endif
if SUIJI_MODE then
call SuijiTest_DebugAll("CMD3","SUIJI已经开启，返回")
call DisplayTimedTextToPlayer(p,0,0,8.,"|cFF00FF00随机OMG模式已经开启|r")
set p=null
return
endif
call SuijiTest_DebugAll("CMD2","-suiji已关闭，请使用-omg")
call DisplayTimedTextToPlayer(p,0,0,8.,"|cFFFFCC00-suiji 已关闭；随机OMG模式已默认开启|r")
set p=null
endfunction
