endfunction
//马甲释放技能
function MJ_USE_SKILL takes unit ZX7,unit IH7,integer skill,integer orderid returns nothing
local unit BB7=CreateUnit(GetOwningPlayer(ZX7),'e00E',GetUnitX(IH7),GetUnitY(IH7),0)
call XF7(BB7,skill)
call IssueTargetOrderById(BB7,orderid,IH7)
call UnitApplyTimedLife(BB7,'BTLF',1.)
set BB7=null
endfunction
//多重物品
function MUL_ITEM takes integer r,unit ZX7,unit IH7,integer skill returns nothing
local group g
local unit m5
local integer D1G
local integer n=1
local string VH
if r==2 then
call YW7(GetObjectName('n0K7'),5,ZX7,.03,255,0,0,255)
elseif r==3 then
call YW7(GetObjectName('n0JT'),5,ZX7,.03,255,0,0,255)
elseif r==4 then
call YW7(GetObjectName('n0K8'),5,ZX7,.03,255,0,0,255)
elseif r==5 then
call YW7(GetObjectName('n0JO'),5,ZX7,.03,255,0,0,255)
endif
set r=r-1
if skill=='A02O' or skill=='A08Y' or skill=='A08Z' or skill=='A090' or skill=='A092' then
set D1G=DLG_level(skill)
set VH="dagen"
elseif skill=='AChx' then
set VH="yangdao"
elseif skill=='A0FD' then
set VH="ziyuan"
elseif skill=='A32X' then
set VH="xueji"
elseif skill=='A1QD' then
set VH="xulingdao"
elseif skill=='A2EA' then
set VH="atuosi"
elseif skill=='A4DN' then
set VH="foujue"
elseif skill=='AIpg' then
set VH="sanshi"
elseif skill=='A4DT' then
set VH="shj"
endif
set g=WS7()
set IN4=ZX7
call GroupEnumUnitsInRange(g,GetUnitX(IH7),GetUnitY(IH7),450,Condition(function AX7))
call GroupRemoveUnit(g,IH7)
loop
set m5=GroupPickRandomUnit(g)
call GroupRemoveUnit(g,m5)
exitwhen n>r or m5==null
if UnitAlive(m5) and IsMagicImmuneUnit(m5)==false then
    if WQ7(m5) then
        call PLK(m5)
    else
        if VH=="dagen" then
            call D6G(D1G,ZX7,m5)
        elseif VH=="yangdao" then
            call MJ_USE_SKILL(ZX7,m5,'AChx',$D0216)
        elseif VH=="ziyuan" then
            call MJ_USE_SKILL(ZX7,m5,'A0FD',$D02BC)
        elseif VH=="xueji" then
            call MJ_USE_SKILL(ZX7,m5,'A32X',$D02BC)
        elseif VH=="xulingdao" then
            call EWG(ZX7,m5)
        elseif VH=="atuosi" then
            call DRG(ZX7,m5)
        elseif VH=="foujue" then
            // call NHX(ZX7, m5,'h0GW', "fj_exec", 5000, false, "")
            call fj_exec(ZX7,m5)
        elseif VH=="sanshi" then
            call JINGHUA(ZX7,m5,'AIpg')   
        elseif VH=="shj" then
            call JINGHUA(ZX7,m5,'A4DT')
        endif
    endif
endif
set n=n+1
endloop
call WR7(g)
set g=null
set m5=null
endfunction
//火焰爆轰 物品多重
function E2D takes nothing returns boolean
local integer r
local unit ZX7=GetTriggerUnit()
local unit IH7=GetSpellTargetUnit()
local integer skill=B287_GetSpellAbilityId()
if SuijiMulticastTemplate_IsRandomCaster(ZX7) then
if IH7!=null and WQ7(IH7)==false and SuijiMulticastTemplate_IsFireblastSkill(skill) then
call HYBH(ZX7,IH7,skill,true)
if ISPH(ZX7)==false then
set r=EUD(ZX7)
if r>1 and((LoadInteger(L7,(GetHandleId(IH7)),((4322))))==1)==false then
call E5D(r)
endif
endif
elseif IH7!=null and ISPH(ZX7)==false and WQ7(IH7)==false and SuijiMulticastTemplate_IsItemSkill(skill) then
set r=EUD(ZX7)
if r>1 then
call MUL_ITEM(r,ZX7,IH7,skill)
endif
endif
set ZX7=null
set IH7=null
return false
endif
if WQ7(GetSpellTargetUnit())==false and (B287_GetSpellAbilityId()=='A04W' or B287_GetSpellAbilityId()=='A08D' or B287_GetSpellAbilityId()=='A08A' or B287_GetSpellAbilityId()=='A089' or B287_GetSpellAbilityId()=='A2KQ') then
call HYBH(ZX7,GetSpellTargetUnit(),B287_GetSpellAbilityId(),true)
endif
if (B287_GetUnitAbilityLevel(ZX7,'A088')>0 or (ISLABIKE(ZX7) and ISPH(ZX7)==false)) and WQ7(GetSpellTargetUnit())==false and (B287_GetSpellAbilityId()=='A04W' or B287_GetSpellAbilityId()=='A08D' or B287_GetSpellAbilityId()=='A08A' or B287_GetSpellAbilityId()=='A089' or B287_GetSpellAbilityId()=='A2KQ') then
set r=EUD(ZX7)
if r>1 and((LoadInteger(L7,(GetHandleId((GetSpellTargetUnit()))),((4322))))==1)==false then
call E5D(r)
endif
endif
if B287_GetUnitAbilityLevel(ZX7,'A088')>0 and ISPH(ZX7)==false and WQ7(IH7)==false and(skill=='A02O' or skill=='A08Y' or skill=='A08Z' or skill=='A090' or skill=='A092' or skill=='AChx' or skill=='A0FD' or skill=='A32X' or skill=='A1QD' or skill=='A2EA' or skill=='A4DN' or skill=='AIpg' or skill=='A4DT')then
set r=EUD(ZX7)
if r>1 then
call MUL_ITEM(r,ZX7,IH7,skill)
endif
endif
set ZX7=null
set IH7=null
return false
endfunction
function FA8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function E2D))
set t=CreateTrigger()
call TriggerRegisterPlayerChatEvent(t,Z7[1],"-st",true)
call TriggerRegisterPlayerChatEvent(t,Z7[2],"-st",true)
call TriggerRegisterPlayerChatEvent(t,Z7[3],"-st",true)
call TriggerRegisterPlayerChatEvent(t,Z7[4],"-st",true)
call TriggerRegisterPlayerChatEvent(t,Z7[5],"-st",true)
call TriggerRegisterPlayerChatEvent(t,A7[1],"-st",true)
call TriggerRegisterPlayerChatEvent(t,A7[2],"-st",true)
call TriggerRegisterPlayerChatEvent(t,A7[3],"-st",true)
call TriggerRegisterPlayerChatEvent(t,A7[4],"-st",true)
call TriggerRegisterPlayerChatEvent(t,A7[5],"-st",true)
call TriggerAddCondition(t,Condition(function E_D))
set t=null
endfunction
function SET_HQJJ2 takes unit ZX7,integer skill returns nothing
    if skill=='A04P' then
        if MHAbility_GetCastpoint(ZX7,skill)!=1.7 then
            call MHAbility_SetCastpoint(ZX7,skill,1.7)
        endif
    else
        if MHAbility_GetCastpoint(ZX7,skill)!=.3 then
            call MHAbility_SetCastpoint(ZX7,skill,.3)
        endif     
    endif
endfunction
function SET_HQJJ takes nothing returns boolean
if IsUnitIllusion(GetTriggerUnit())==false and (B287_GetLearnedSkill()=='A04P' or B287_GetLearnedSkill()=='A1AU') then
call SET_HQJJ2(GetTriggerUnit(),B287_GetLearnedSkill())
endif
return false
endfunction
function HQJJ_ALL takes nothing returns nothing
	local unit ZX7 = U22
	local unit IH7 = W22
	local integer h = GetHandleId(GetTriggeringTrigger())
	local integer level = LoadInteger(TABLE_HY, h, 10)
	local real d
	local group g = WS7()
	local unit u
	call GroupEnumUnitsInRange(g, GetUnitX(IH7), GetUnitY(IH7), 225, Condition(function DJX))
	set d =205.+150.* level
	loop
		set u = FirstOfGroup(g)
	exitwhen u == null
        if GetPlayerController(GetOwningPlayer(u))==MAP_CONTROL_COMPUTER and GetRandomInt(1,2)==1 then
            call AI_ITEM_RENJIA(u)
        endif
		call B67(ZX7, u, 1, d)
		call CommonUnitAddStun(u, 2, false)
        call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\Mortar\\MortarMissile.mdl", GetUnitX(u), GetUnitY(u)))
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\CannonTowerMissile\\CannonTowerMissile.mdl", u, "origin"))
		call GroupRemoveUnit(g, u)
	endloop
    call LINGXIA(ZX7,IH7)
	call WR7(g)
	set g = null
	set ZX7 = null
	set IH7 = null
endfunction
function HQJJ_DT takes nothing returns nothing
	local unit ZX7 = U22
	local unit IH7 = W22
	local integer h = GetHandleId(GetTriggeringTrigger())
	local integer level = LoadInteger(TABLE_HY, h, 10)
	local real d
    if GetPlayerController(GetOwningPlayer(IH7))==MAP_CONTROL_COMPUTER then
        call AI_ITEM_RENJIA(IH7)
    endif
	set d =205.+150.* level
    call B67(ZX7, IH7, 1, d)
    call CommonUnitAddStun(IH7, 0.01, false)
    call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\Mortar\\MortarMissile.mdl", GetUnitX(IH7), GetUnitY(IH7)))
    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\CannonTowerMissile\\CannonTowerMissile.mdl", IH7, "origin"))
    call LINGXIA(ZX7,IH7)
	set ZX7 = null
	set IH7 = null
endfunction
function HQJJ takes nothing returns nothing
	local unit ZX7 = GetTriggerUnit()
	local unit IH7 = GetSpellTargetUnit()
    local integer skill=B287_GetSpellAbilityId()
	local trigger t
	local integer h
    call SET_HQJJ2(ZX7,skill)
    if skill=='A04P' then
        call SetUnitAnimation(ZX7,"spell throw")
        set t=NHX(ZX7, IH7,'n12F', "HQJJ_DT",2500, true, "")
    else
        set t=NHX(ZX7, IH7,'n12F', "HQJJ_ALL",2500, true, "")
    endif
    set h=GetHandleId(t)
	call SaveInteger(TABLE_HY, h, 10, B287_GetUnitAbilityLevel(ZX7, skill))
	set t = null
	set ZX7 = null
	set IH7 = null
endfunction
function E5GG takes nothing returns boolean
if (B287_GetSpellAbilityId()=='A04P' or B287_GetSpellAbilityId()=='A1AU') and WQ7(GetSpellTargetUnit())==false then
call HQJJ()
endif
return false
endfunction
function G98 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_CHANNEL)
call TriggerAddCondition(t,Condition(function E5G))
set t=CreateTrigger()
